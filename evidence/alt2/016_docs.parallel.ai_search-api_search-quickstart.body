995d\"},\"feedback\":\"$undefined\",\"entitlements\":{\"AI_CHAT\":{\"status\":\"ENABLED\"},\"REMOVE_BRANDING\":{\"status\":\"ENABLED\"},\"WEB_MCP\":{\"status\":\"ENABLED\"},\"NARRATION\":{\"status\":\"ENABLED\"}},\"buildId\":\"6ad116920a413398c972995d\",\"clientVersion\":\"0.0.3883\",\"preview\":\"$undefined\",\"searchFilterCounts\":[{\"language\":\"default\",\"tag\":\"Documentation\",\"count\":117},{\"language\":\"default\",\"tag\":\"Web Agents\",\"count\":46},{\"language\":\"default\",\"tag\":\"API Reference\",\"count\":37},{\"language\":\"default\",\"tag\":\"Features\",\"count\":24},{\"language\":\"default\",\"tag\":\"FindAll\",\"count\":22},{\"language\":\"default\",\"tag\":\"Developer Tools\",\"count\":18},{\"language\":\"default\",\"tag\":\"Task\",\"count\":18},{\"language\":\"default\",\"tag\":\"Web Tools\",\"count\":15},{\"language\":\"default\",\"tag\":\"Additional Resources\",\"count\":14},{\"language\":\"default\",\"tag\":\"Platform Integrations\",\"count\":13}],\"searchSettings\":\"$undefined\",\"disableKonamiCode\":\"$undefined\"},\"children\":[\"$\",\"$L2b\",null,{\"value\":{\"docsConfig\":{\"theme\":\"mint\",\"$schema\":\"https://mintlify.com/docs.json\",\"name\":\"Parallel\",\"description\":\"Parallel's web APIs (Search, Extract, Task/Deep Research, Responses, FindAll, and Monitor) give AI agents and developers high-quality, low-latency access to the web for research, content extraction, entity discovery, and continuous monitoring. For Search and Extract, use /v1/search and /v1/extract for all new integrations and agent tool calls; use /v1beta/search and /v1beta/extract only when maintaining an existing integration that already uses them. The request bodies changed too: on /v1/extract, full_content, fetch_policy and excerpt_settings go inside advanced_settings, and sending the v1beta top-level excerpts, full_content and fetch_policy to /v1/extract returns a 422. Do not substitute /v1 for the documented FindAll or Ingest endpoint paths.\",\"colors\":{\"primary\":\"#FB631B\",\"light\":\"#fcfcfa\",\"dark\":\"#1d1b16\"},\"logo\":{\"light\":\"https://mintcdn.com/parallel-6fabab31-mtje7p526we/ODrEI5O3l6nnvEZD/logo/wordmark_light.svg?fit=max\u0026auto=format\u0026n=ODrEI5O3l6nnvEZD\u0026q=85\u0026s=955d1146a212bea2279ca4ee6916b8ae\",\"dark\":\"https://mintcdn.com/parallel-6fabab31-mtje7p526we/ODrEI5O3l6nnvEZD/logo/wordmark_dark.svg?fit=max\u0026auto=format\u0026n=ODrEI5O3l6nnvEZD\u0026q=85\u0026s=0039edb690a1759b9276a8691e19bf84\"},\"favicon\":\"https://mintcdn.com/parallel-6fabab31-mtje7p526we/dsxqJ8pzmudWCd39/favicon.svg?fit=max\u0026auto=format\u0026n=dsxqJ8pzmudWCd39\u0026q=85\u0026s=41982ed7e9fa034a1be0b73fb7294e48\",\"api\":{\"playground\":{\"display\":\"interactive\"},\"examples\":{\"defaults\":\"required\",\"languages\":[\"python\",\"typescript\",\"java\",\"curl\"]}},\"appearance\":\"$1a:2:props:children:1:props:appearance\",\"navbar\":{\"primary\":{\"type\":\"button\",\"label\":\"API Playground\",\"href\":\"https://platform.parallel.ai\"}},\"footer\":{\"socials\":{\"x\":\"https://x.com/p0\",\"github\":\"https://github.com/parallel-web/parallel-cookbook\",\"linkedin\":\"https://www.linkedin.com/company/parallel-web/about\"},\"links\":[{\"header\":\"Privacy\",\"items\":[{\"label\":\"Cookie preferences\",\"href\":\"#cookie-preferences\"}]}]},\"styling\":{\"eyebrows\":\"section\",\"codeblocks\":\"system\",\"latex\":true},\"contextual\":{\"options\":[\"copy\",\"view\",\"chatgpt\",\"claude\"],\"display\":\"header\"},\"navigation\":{\"global\":{\"anchors\":[{\"anchor\":\"Get API Key\",\"icon\":\"key\",\"href\":\"https://platform.parallel.ai\"},{\"anchor\":\"OpenAPI Spec\",\"icon\":\"file-code\",\"href\":\"https://docs.parallel.ai/public-openapi.json\"},{\"anchor\":\"Python SDK\",\"icon\":\"python\",\"href\":\"https://pypi.org/project/parallel-web/\"},{\"anchor\":\"TypeScript SDK\",\"icon\":\"js\",\"href\":\"https://www.npmjs.com/package/parallel-web\"}]},\"pages\":[]}},\"docsNavWithMetadata\":\"$undefined\",\"anonym