<span class="line"><span style="color:#0A3069;--shiki-dark:#CE9178">  &quot;name&quot;: &quot;web_search&quot;,</span></span>
<span class="line"><span style="color:#0A3069;--shiki-dark:#CE9178">  &quot;description&quot;: &quot;Search the web and return the most relevant pages.&quot;,</span></span>
<span class="line"><span style="color:#0A3069;--shiki-dark:#CE9178">  &quot;parameters&quot;: { &quot;type&quot;: &quot;object&quot;, &quot;properties&quot;: { &quot;query&quot;: { &quot;type&quot;: &quot;string&quot; } }, &quot;required&quot;: [&quot;query&quot;] }</span></span>
<span class="line"><span style="color:#0A3069;--shiki-dark:#CE9178">}}]&#x27;</span></span>
<span class="line"><span style="color:#1F2328;--shiki-dark:#9CDCFE">ASSISTANT</span><span style="color:#CF222E;--shiki-dark:#D4D4D4">=</span><span style="color:#0A3069;--shiki-dark:#CE9178">&quot;$(</span><span style="color:#953800;--shiki-dark:#DCDCAA">curl</span><span style="color:#0550AE;--shiki-dark:#569CD6"> -s</span><span style="color:#0A3069;--shiki-dark:#CE9178"> &quot;https://api.openai.com/v1/chat/completions&quot; </span><span style="color:#CF222E;--shiki-dark:#D7BA7D">\</span></span>
<span class="line"><span style="color:#0550AE;--shiki-dark:#569CD6">  -H</span><span style="color:#0A3069;--shiki-dark:#CE9178"> &quot;Content-Type: application/json&quot; </span><span style="color:#CF222E;--shiki-dark:#D7BA7D">\</span></span>
