<span class="line"><span style="color:#1F2328;--shiki-dark:#9CDCFE">USER_MSG</span><span style="color:#CF222E;--shiki-dark:#D4D4D4">=</span><span style="color:#0A3069;--shiki-dark:#CE9178">&#x27;{ &quot;role&quot;: &quot;user&quot;, &quot;content&quot;: &quot;What&#x27;</span><span style="color:#CF222E;--shiki-dark:#D7BA7D">\&#x27;</span><span style="color:#0A3069;--shiki-dark:#CE9178">&#x27;s the latest on AI chips?&quot; }&#x27;</span></span>
