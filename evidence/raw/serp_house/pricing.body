<script>
    $(document).ready(function () {

        $(window).on('beforeunload', function () {
            $("#currency-toggle").prop("checked", false);
            $("#plan-type-toggle").prop("checked", false);
        });

        $('#currency-toggle, #plan-type-toggle').on('change', function () {
            let isCurrencyChecked = $("#currency-toggle").is(":checked");
            let currency = isCurrencyChecked ? 'INR' : 'USD';
            let isPlanTypeChecked = $("#plan-type-toggle").is(":checked");
            let plan_type = isPlanTypeChecked ? 'yearly' : 'monthly';

            $('#usd-heading').toggleClass('text-primary', !isCurrencyChecked).toggleClass('text-primary-dark', isCurrencyChecked);
            $('#inr-heading').toggleClass('text-primary', isCurrencyChecked).toggleClass('text-primary-dark', !isCurrencyChecked);

            $('#monthly-heading').toggleClass('text-primary', !isPlanTypeChecked).toggleClass('text-primary-dark', isPlanTypeChecked);
            $('#yearly-heading').toggleClass('text-primary', isPlanTypeChecked).toggleClass('text-primary-dark', !isPlanTypeChecked);

            $.ajax({
                url: 'pricing',
                data: {
                    currency: currency,
                    plan_type: plan_type,
                },
                type: 'GET',
                success: function (response) {
                    $('#pricing_partial').html(response);
                },
                error: function (xhr, status, error) {
                    console.log("Error: " + error);
                }
            });
        });
    });
</script>
