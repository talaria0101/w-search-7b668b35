        }

        function encodeTouch(touch) {
            var value = { v: 1 };
            for (var key in touch) {
                value[key] = touch[key];
            }
            var encoded = encodeURIComponent(JSON.stringify(value));
            if (encoded.length <= TOUCH_COOKIE_BUDGET) return encoded;
            // Over budget: the full referrer goes first, the host stays; then every
            // click id but the first, which is the one the conversion is filed under.
            delete value.referrer;
            encoded = encodeURIComponent(JSON.stringify(value));
            if (encoded.length <= TOUCH_COOKIE_BUDGET) return encoded;
            var keptClickId = false;
            for (var i = 0; i < CLICK_ID_KEYS.length; i++) {
                if (!value[CLICK_ID_KEYS[i]]) continue;
                if (keptClickId) delete value[CLICK_ID_KEYS[i]];
                keptClickId = true;
            }
            encoded = encodeURIComponent(JSON.stringify(value));
            return encoded.length <= TOUCH_COOKIE_BUDGET ? encoded : null;
        }

        // Once per document load, after consent: a new external touch replaces the
        // stored one, anything else rewrites the stored one unchanged so its 90 days
        // start again.
        function writeTouchCookie() {
            var touch = visit.external ? visit.touch : readStoredTouch();
            var encoded = touch ? encodeTouch(touch) : null;
            if (!encoded) return;
            document.cookie =
                TOUCH_KEY + "=" + encoded + "; path=/; domain=.keenable.ai; samesite=lax; secure; max-age=" + TOUCH_MAX_AGE;
        }

        function pick(touch, keys) {
            var out = {};
            if (!touch) return out;
            for (var i = 0; i < keys.length; i++) {
                if (touch[keys[i]]) out[keys[i]] = touch[keys[i]];
            }
            return out;
        }

        // UTM and click ids of the current touch, for the event beacon and the
        // dataLayer — the same keys the touch itself is made of, minus the referrer.
        function touchParams() {
            return pick(currentTouch(), UTM_KEYS.concat(CLICK_ID_KEYS));
        }

        function legacyAttribution() {
            return pick(currentTouch(), LEGACY_ATTR_KEYS);
        }

        // Nothing is read from it any more; a tab from before the change just loses it.
        try {
            window.sessionStorage.removeItem(LEGACY_ATTR_KEY);
        } catch (e) {
            // Storage blocked, so there is nothing to remove.
        }

        // Both of these are held until consent: minting the ref writes a cookie, and
        // so does storing the touch. Held rather than dropped because the touch only
        // exists in this page's query and referrer, which routing takes away.
        var ref = "";
        function currentRef() {
            if (!ref) ref = getOrCreateRef();
            return ref;
        }
        whenConsented(function () {
            currentRef();
            writeTouchCookie();
        });

        // Fire-and-forget beacon so the event survives ad and script blockers, which
        // the dataLayer path does not. One access-log row per event.
        function reportEvent(name, params) {
            if (isAutomated()) return;
            whenConsented(function () {
                sendEventBeacon(name, params);
            });
        }

        function sendEventBeacon(name, params) {
            var query = new URLSearchParams({ ref: currentRef() });
            var attr = touchParams();
            for (var key in attr) {
                query.set(key, attr[key]);
            }
            // Mirrors the GA4 User-ID as `uid`, like track.ts. Reserved like ref:
            // absent from SAFE_PARAM_KEYS, so no event param can spoof it.
            var uid = analyticsUserId();
            if (uid) query.set("uid", uid);
            for (var i = 0; i < SAFE_PARAM_KEYS.length; i++) {
                var safeKey = SAFE_PARAM_KEYS[i];
                var value = params[safeKey];
                if (value == null) continue;
                var str = String(value);
                if (str.length <= MAX_PARAM_LEN) query.set(safeKey, str);
            }
            var url = BEACON_ORIGIN + BEACON_PREFIX + encodeURIComponent(name) + "?" + query.toString();
            try {
                // sendBeacon survives the page unloading right after a CTA click, and
                // runs in no-cors mode, so the cross-origin hop needs no CORS headers.
                if (navigator.sendBeacon && navigator.sendBeacon(url)) return;
            } catch (e) {
                // fall through to fetch
            }
            try {
                fetch(url, { method: "POST", keepalive: true, mode: "no-cors" })["catch"](function () {});
            } catch (e) {
                // Analytics is best-effort; never surface errors to the visitor.
            }
        }

        // POST the click identifiers + ref to the tracking service so the backend can
        // later join an offline activation (by IP and/or ref) to this click — the other
        // half of the ads pipeline, alongside the beacon above. Once per session.
        //
        // fetch, not sendBeacon: the hop is cross-origin and the service needs a JSON
        // content type, which makes it a preflighted request — sendBeacon cannot
        // preflight, so the browser would drop it. api.keenable.ai already allows both
        // marketing origins.
        function reportLanding() {
            if (isAutomated()) return;
            whenConsented(sendLandingReport);
        }

        function sendLandingReport() {
            try {
                if (window.sessionStorage.getItem(LANDING_REPORTED_KEY)) return;
                window.sessionStorage.setItem(LANDING_REPORTED_KEY, "1");
            } catch (e) {
                // Storage blocked — we may report twice; the server dedupes by ref.
            }
            var payload = { ref: currentRef(), page: window.location.pathname, user_agent: navigator.userAgent };
            var attr = legacyAttribution();
            for (var key in attr) {
                payload[key] = attr[key];
            }
            // Origin and path only, as everywhere else the referrer goes: its query
            // is where search terms and tokens travel.
            var landingReferrer = strippedReferrer(LANDING_REFERRER);
            if (landingReferrer) payload.referrer = landingReferrer;
            try {
                fetch(LANDING_ENDPOINT, {
                    method: "POST",
                    headers: { "Content-Type": "application/json" },
                    body: JSON.stringify(payload),
                    keepalive: true,
                })["catch"](function () {});
            } catch (e) {
                // Attribution is best-effort; never surface errors to the visitor.
            }
        }

        // Push a named custom event onto the dataLayer, tagged with UTM and the ref.
        // The container's GA4 tag fires on {{Event}}, so the name is all it needs.
        function trackEvent(name, params) {
            // `isLive` here as well as around the block below: the contact form runs
            // on the preview and reports its own success through this.
            if (isAutomated() || !isLive) return;
            whenConsented(function () {
                pushTrackedEvent(name, params);
            });
        }

        function pushTrackedEvent(name, params) {
            params = params || {};
            var payload = {};
            var attr = touchParams();
            for (var i = 0; i < UTM_KEYS.length; i++) {
                if (attr[UTM_KEYS[i]]) payload[UTM_KEYS[i]] = attr[UTM_KEYS[i]];
            }
            payload.ref = currentRef();
            for (var key in params) {
                if (params[key] != null) payload[key] = params[key];
            }
            var uid = analyticsUserId();
            if (uid) payload.user_id = uid;
            // Last, so a caller-supplied param can clobber neither the custom-event
            // name triggers fire on nor the identity the event is attributed to.
            payload.event = name;
            window.dataLayer = window.dataLayer || [];
            window.dataLayer.push(payload);
            reportEvent(name, params);
        }

        function normalizePath(path) {
            return path.replace(/\/+$/, "") || "/";
        }

        // The CMS slug of a blog post, or null for anything else. Validated against a
        // strict pattern because it reaches an access log verbatim.
        function blogSlug(path) {
            var match = normalizePath(path).match(/^\/blog\/([^\/]+)$/);
            if (!match) return null;
            var slug = match[1].toLowerCase();
            return SLUG_PATTERN.test(slug) ? slug : null;
        }

        function currentPost() {
            return blogSlug(window.location.pathname);
        }

        // Which link of a fixed set was taken. A closed set, never free-form: the
        // value is logged verbatim.
        function ctaTarget(path) {
            var normalized = normalizePath(path);
            if (normalized === "/signup") return "signup";
            if (normalized === "/login") return "login";
            if (normalized === "/contact") return "contact";
            if (normalized === "/console" || normalized.indexOf("/console/") === 0) return "console";
            return "other";
        }

        function isOurHost(hostname) {
            return OUR_HOSTS.indexOf(hostname) !== -1;
        }

        var lastTrackedPath = null;

        // Enhanced measurement already sends page_view on Framer's client-side
        // routing; these are our own names, the ones the funnel in BigQuery and the
        // existing GA4 reports are built on.
        function ampWrite(key, value) {
            document.cookie =
                key + "=" + value + "; path=/; domain=.keenable.ai; samesite=lax; secure; max-age=" + AMP_MAX_AGE;
        }

        // Cookie only, as in the app: localStorage is per-origin, so a copy kept
        // here is exactly what cannot travel to the app host, and a stale one there
        // would split a visit from its sign-in. Rewritten once per document load so
        // Safari's cap on script cookies counts from the latest visit.
        var deviceCookieRefreshed = false;
        function ampDeviceId() {
            var existing = readCookie(AMP_DEVICE_KEY);
            if (existing) {
                if (!deviceCookieRefreshed) ampWrite(AMP_DEVICE_KEY, existing);
                deviceCookieRefreshed = true;
                return existing;
            }
            deviceCookieRefreshed = true;
            var bytes = new Uint8Array(16);
            window.crypto.getRandomValues(bytes);
            // RFC 4122 version 4, the shape Amplitude's own SDK produces.
            bytes[6] = (bytes[6] & 0x0f) | 0x40;
            bytes[8] = (bytes[8] & 0x3f) | 0x80;
            var id = "";
            for (var i = 0; i < bytes.length; i++) {
                id += (bytes[i] + 0x100).toString(16).slice(1);
                if (i === 3 || i === 5 || i === 7 || i === 9) id += "-";
            }
            ampWrite(AMP_DEVICE_KEY, id);
            return id;
        }

        // Amplitude identifies a session by the timestamp it started at and groups
        // every event carrying that number into one, so the boundary is ours to
        // draw: the session continues while events keep arriving, and a gap longer
        // than the idle window starts a new one. Kept in the cookie rather than a
        // variable so a visit that crosses to the app host stays one session.
        function ampSessionId(now) {
            // `|| NaN`: an absent cookie reads as null, and Number(null) is 0,
            // which is finite — with only the last-seen cookie left, that 0 went
            // out as a live session id.
            var start = Number(readCookie(AMP_SESSION_KEY)) || NaN;
            var seen = Number(readCookie(AMP_SEEN_KEY)) || NaN;
            // isFinite on both: an absent cookie reads as NaN, and so does anything
            // a curious visitor types into their own jar. Without this a corrupt
            // value makes every comparison false, the session never expires, and
            // its id stays NaN forever.
            var expired = !isFinite(start) || !isFinite(seen) || now - seen > AMP_IDLE_MS;
            var current = expired ? now : start;
            if (expired) ampWrite(AMP_SESSION_KEY, String(current));
            ampWrite(AMP_SEEN_KEY, String(now));
            return current;
        }

        // A batch the relay answered with 429 or a 5xx is not ingested unless it is
        // sent again, so it is — the same body, which the insert_id on every event
        // makes safe to repeat. Any other answer, or no answer at all, ends it.
        var AMP_RETRY_DELAYS_MS = [1000, 2000, 4000];
        var ampSeq = 0;
        function postToAmplitude(body, attempt) {
            try {
                window
                    .fetch(AMP_ENDPOINT, {
                        method: "POST",
                        headers: { "Content-Type": "application/json" },
                        body: body,
                        keepalive: true,
                    })
                    .then(function (response) {
                        var status = response.status;
                        if ((status !== 429 && status < 500) || attempt >= AMP_RETRY_DELAYS_MS.length) return;
                        var delay = AMP_RETRY_DELAYS_MS[attempt] * (0.8 + Math.random() * 0.4);
                        // Asked when the timer fires: a withdrawal during the
                        // backoff drops the retry, body and identity with it.
                        window.setTimeout(function () {
                            if (consentState !== "denied") postToAmplitude(body, attempt + 1);
                        }, delay);
                    })
                    ["catch"](function () {
                        // Fire and forget: a failed measurement must never be
                        // visible to the person reading the page.
                    });
            } catch (e) {
                // Same.
            }
        }

        // The user-property operations for an external touch (acquisition contract
        // §2): the touch's fields set, every touch field it lacks unset so an old
        // utm_term never sits next to a new utm_source, and initial_* set once.
        function touchIdentify(touch, base, seq) {
            var set = {};
            var unset = {};
            var setOnce = {};
            var keys = TOUCH_KEYS.concat(["landing_path"]);
            for (var i = 0; i < keys.length; i++) {
                var key = keys[i];
                if (touch[key]) {
                    set[key] = touch[key];
                    setOnce["initial_" + key] = touch[key];
                } else {
                    unset[key] = "-";
                    // The first touch locks its empty fields too (Amplitude SDK), so a
                    // later visit cannot fill one and mix two sources.
                    setOnce["initial_" + key] = "EMPTY";
                }
            }
            var identify = {
                event_type: "$identify",
                time: base.time - 1,
                device_id: base.device_id,
                ip: "$remote",
                insert_id: base.device_id + "-" + (base.time - 1) + "-" + seq + "-$identify",
                user_properties: { $set: set, $unset: unset, $setOnce: setOnce },
            };
            if (base.user_id) identify.user_id = base.user_id;
            return identify;
        }

        // One page view, to Amplitude and nowhere else.
        //
        // Amplitude counts no page views of its own, so without this its funnel
        // cannot start at the visit — every other event we send is something a
        // person did after arriving. It does not go on the dataLayer: GA4 records
        // a view for every route by itself and its tag fires on any event name, so
        // a copy there would double every page. The app sends the identical event
        // from its router, and the shared device id makes the two halves one
        // person.
        //
        // The document's first view of an external touch goes with a $identify
        // ahead of it, in the same request: Amplitude stamps user properties on an
        // event as they stand when it arrives, so the touch has to land first or
        // this view keeps no source for good.
        var firstPageView = true;
        function ampPageView(path) {
            if (isAutomated() || !isLive) return;
            // When the page was viewed, not when consent arrived: a view held
            // behind the banner would otherwise be dated to the click on "Allow".
            var now = Date.now();
            var withIdentify = firstPageView && visit.external;
            firstPageView = false;
            whenConsented(function () {
                var properties = { path: path, ref: currentRef(), source: "browser", host: host };
                // This hit's own campaign params, or, on a hit without any, the
                // touch the visit is attributed to.
                var attr = paramsFrom(window.location.search);
                if (!hasAny(attr)) attr = touchParams();
                for (var key in attr) {
                    properties[key] = attr[key];
                }
                var event = {
                    event_type: "page_view",
                    time: now,
                    device_id: ampDeviceId(),
                    session_id: ampSessionId(now),
                    platform: "Web",
                    // Amplitude locates the visitor from the IP of this request.
                    ip: "$remote",
                    // Amplitude parses OS, browser and device type out of this.
                    user_agent: navigator.userAgent,
                    event_properties: properties,
                };
                // A per-page sequence, so two page views in one millisecond stay two.
                ampSeq += 1;
                var seq = ampSeq;
                event.insert_id = event.device_id + "-" + now + "-" + seq + "-page_view";
                // Only if they have signed in before. Most visitors here have not,
                // and an event carrying a device id alone is what Amplitude expects.
                var uid = readCookie(UID_KEY);
                if (uid) event.user_id = uid;
                var events = withIdentify ? [touchIdentify(visit.touch, event, seq), event] : [event];
                postToAmplitude(JSON.stringify({ api_key: AMP_PROJECT_ID, events: events }), 0);
            });
        }

        function trackPage() {
            var path = normalizePath(window.location.pathname);
            if (path === lastTrackedPath) return;
            lastTrackedPath = path;
            ampPageView(path);
            var slug = blogSlug(path);
            if (slug) {
                trackEvent("blog_post_view", { post: slug });
            } else if (path === "/blog") {
                trackEvent("blog_page_view");
            }
        }

        // Framer swaps the URL before it renders, so read the path on the next tick —
        // otherwise the event carries the previous one.
        function trackPageSoon() {
            window.setTimeout(trackPage, 0);
        }

        function hookHistory() {
            var names = ["pushState", "replaceState"];
            for (var i = 0; i < names.length; i++) {
                (function (name) {
                    var original = window.history[name];
                    if (typeof original !== "function") return;
                    window.history[name] = function () {
                        var result = original.apply(this, arguments);
                        trackPageSoon();
                        return result;
                    };
                })(names[i]);
            }
            window.addEventListener("popstate", trackPageSoon);
        }

        // The params a link to the app host carries the touch in, most useful first,
        // so a long touch that hits the budget loses the least telling ones: the
        // source and the paying click id before the rest. Host and path only for
        // where it came from — never a full referrer, never anything typed.
        function linkParams() {
            // This visit's outside touch only: a stored one is already in the shared
            // .keenable.ai cookie, and copied onto a link it would reach the app as a
            // fresh outside touch (acquisition contract §3).
            var touch = visit.external ? visit.touch : null;
            if (!touch) return [];
            var pairs = [];
            var push = function (key, value) {
                if (value) pairs.push([key, value]);
            };
            push("utm_source", touch.utm_source);
            push("utm_medium", touch.utm_medium);
            push("utm_campaign", touch.utm_campaign);
            // The first click id present is the one a conversion gets filed under;
            // any others go last.
            var rest = [];
            var firstClickId = true;
            for (var i = 0; i < CLICK_ID_KEYS.length; i++) {
                var clickId = touch[CLICK_ID_KEYS[i]];
                if (!clickId) continue;
                (firstClickId ? pairs : rest).push([CLICK_ID_KEYS[i], clickId]);
                firstClickId = false;
            }
            push("kt_ref", touch.referring_domain);
            push("kt_lp", touch.landing_path);
            push("utm_id", touch.utm_id);
            push("utm_term", touch.utm_term);
            push("utm_content", touch.utm_content);
            return pairs.concat(rest);
        }

        // Framer links are static markup, so the app host never sees the touch
        // unless it is appended at click time. Stores nothing, so it needs no
        // consent: the params ride the link and the app decides what to keep.
        function decorate(anchor, url) {
            var pairs = linkParams();
            var added = 0;
            for (var i = 0; i < pairs.length; i++) {
                var key = pairs[i][0];
                var value = pairs[i][1];
                // Never clobber a value the link already carries.
                if (url.searchParams.has(key)) continue;
                var cost = encodeURIComponent(key).length + encodeURIComponent(value).length + 2;
                if (added + cost > LINK_PARAM_BUDGET) continue;
                url.searchParams.set(key, value);
                added += cost;
            }
            anchor.href = url.toString();
        }

        function onClick(event) {
            var target = event.target;
            var anchor = target && target.closest ? target.closest("a[href]") : null;
            if (!anchor) return;
            var url;
            try {
                url = new URL(anchor.href, window.location.href);
            } catch (e) {
                return;
            }
            if (url.hostname === APP_HOST) {
                decorate(anchor, url);
                trackEvent("cta_click", { target: ctaTarget(url.pathname) });
                return;
            }
            if (isOurHost(url.hostname)) {
                var slug = blogSlug(url.pathname);
                if (slug) {
                    trackEvent("blog_click", { post: slug });
                } else if (ctaTarget(url.pathname) !== "other") {
                    trackEvent("cta_click", { target: ctaTarget(url.pathname) });
                }
                return;
            }
            // Anything off our domains, counted only from inside a post — that is the
            // question blog_outbound exists to answer. Clicks to docs.keenable.ai from
            // elsewhere are already covered by the container's own link-click trigger.
            var post = currentPost();
            if (post) trackEvent("blog_outbound", { post: post });
        }

        // `play` does not bubble, so capture it. Once per element: a pause/resume is
        // the same view, and the event exists to count views.
        var playedVideos = typeof WeakSet === "function" ? new WeakSet() : null;
        function onPlay(event) {
            var node = event.target;
            if (!node || node.tagName !== "VIDEO") return;
            var post = currentPost();
            if (!post) return;
            if (playedVideos) {
                if (playedVideos.has(node)) return;
                playedVideos.add(node);
            }
            trackEvent("blog_video_play", { post: post });
        }

        if (isLive) {
            reportLanding();
            document.addEventListener("click", onClick, true);
            // A middle-click opens a new tab without firing `click`.
            document.addEventListener("auxclick", onClick, true);
            document.addEventListener("play", onPlay, true);
            hookHistory();

            // Seed the GA4 User-ID before GTM boots, so the very first page_view of a
            // returning visit already carries it.
            var seedUid = analyticsUserId();
            if (seedUid) {
                window.dataLayer = window.dataLayer || [];
                window.dataLayer.push({ user_id: seedUid });
            }

            // All on-page tags (GA4 G-6R3BHM01DE, Google Ads AW-18255703782, …) live in
            // the GTM-N5DD89FK container, managed by the marketing agency. Its GA4 event
            // tag fires on {{Event}}, so any name pushed above reaches GA4 under that name
            // with no container change.
            window.dataLayer = window.dataLayer || [];
            window.dataLayer.push({ "gtm.start": Date.now(), event: "gtm.js" });
            var script = document.createElement("script");
            script.async = true;
            script.src = "https://www.googletagmanager.com/gtm.js?id=GTM-N5DD89FK";
            var firstScript = document.getElementsByTagName("script")[0];
            if (firstScript && firstScript.parentNode) {
                firstScript.parentNode.insertBefore(script, firstScript);
            } else {
                document.head.appendChild(script);
            }

            // HubSpot's tracking script, for one thing only: the `hubspotutk` cookie.
            // Their original-source attribution is built from that cookie and nothing
            // else, so a contact form submitted without it is filed in the CRM as
            // Direct traffic however much campaign data the payload carries. The form
            // posts to api.keenable.ai/v1/contact, which reads the cookie's value out of
            // the submission and hands it to the Forms API.
            //
            // `hubspotutk` is per-domain, so the apex has to set its own — the app host
            // sets its copy from the bundle (loadHubSpotTracking in keenable-landing).
            // Same portal id on both sides, or the two halves write to different portals.
            //
            // Region-suffixed host: portal 149044588 lives in HubSpot's EU data centre,
            // and js.hs-scripts.com answers 307 with no script for it. Loaded on an idle
            // callback because their loader pulls a large analytics chain behind it, and
            // the cookie is not needed until somebody submits a form.
            //
            // Only with statistics consent, like everything else here: the script is
            // HubSpot analytics in full, every page view sent to them, not just the
            // cookie. A decline erases its cookies (see eraseAnalytics).
            var loadHubSpot = function () {
                if (document.getElementById("hs-script-loader")) return;
                var hs = document.createElement("script");
                hs.id = "hs-script-loader";
                hs.async = true;
                hs.defer = true;
                hs.src = "https://js-eu1.hs-scripts.com/149044588.js";
                document.head.appendChild(hs);
            };
            whenConsented(function () {
                // Lifts a doNotTrack left by an earlier withdrawal; a no-op otherwise.
                window._hsq = window._hsq || [];
                window._hsq.push(["doNotTrack", { track: true }]);
                if (typeof window.requestIdleCallback === "function") {
                    window.requestIdleCallback(loadHubSpot);
                } else {
                    window.setTimeout(loadHubSpot, 0);
                }
            });

            // The first page of the visit. Deferred like the routed ones so the DOM and
            // the container are up before the first event goes out.
            trackPageSoon();
        }

        // ------------------------------------------------------------------- //
        // Contact form
        //
        // /contact is Framer's own input elements sitting in a plain frame: no form
        // container, no submit binding, no destination. Framer's own submission
        // would collect the message inside Framer, and the message has to reach
        // support@ and the CRM with the visit's attribution attached — so the
        // submit is ours.
        //
        // Same endpoint, same validation and the same wording as the app's contact
        // page (widgets/ui/ContactPage in keenable-landing): an address one form
        // accepts must not be one the other refuses, and support should not have to
        // tell from the mail which half of the site it came from.
        //
        // Registered after the analytics handlers, and last in the file, so the
        // order of the capture-phase click listeners does not depend on which host
        // this is running on.
        var CONTACT_ENDPOINT =
            (isLive ? "https://api.keenable.ai" : "https://api-test.keenable.ai") + "/bff/v1/contact";
        var CONTACT_FIELDS = ["firstName", "lastName", "email", "message"];
        // The loosest useful check, copied from shared/helpers/isValidEmail: catch
        // the typo that makes a reply impossible, leave RFC 5322 to the mail server.
        var EMAIL_PATTERN = /^[^\s@]+@[^\s@]+\.[^\s@]+$/;
        var CONTACT_TEXT = {
            required: "All fields are required.",
            email: "Please enter a valid email address.",
            rate: "You\u2019ve sent too many messages. Please wait a minute and try again.",
            generic: "Something went wrong. Please try again.",
            sending: "Sending\u2026",
            sent: "Message sent! We'll get back to you soon."
        };
        var CONTACT_STATUS_ID = "keenable-contact-status";
        var HTTP_TOO_MANY_REQUESTS = 429;
        var MAX_SUBJECT_LEN = 120;
        var contactSending = false;
        var contactSent = false;

        // Found through the DOM rather than by Framer node id: the published class
        // names are content hashes that change with every build. Named layers do
        // survive as `data-framer-name`, which is why the frame carries a name — the
        // climb below is the fallback for the day that name is lost in a merge,
        // which this project's link variables have already managed once.
        function contactRoot() {
            var named = document.querySelector('[data-framer-name="contact_form"]');
            if (named) return named;
            var node = document.querySelector("textarea");
            while (node && node !== document.body) {
                if (node.querySelectorAll("input").length >= 3) return node;
                node = node.parentElement;
            }
            return null;
        }

        function contactFields(root) {
            var found = {};
            var complete = true;
            for (var i = 0; i < CONTACT_FIELDS.length; i++) {
                var node = root.querySelector('[name="' + CONTACT_FIELDS[i] + '"]');
                if (!node) complete = false;
                found[CONTACT_FIELDS[i]] = node;
            }
            if (complete) return found;
            // Framer names every new input "Name", so until the canvas gives them
            // distinct ones their order is the only thing telling them apart. A
            // fallback, never the mechanism: reading the address out of "the third
            // input" mails the wrong person the day somebody reorders the rows.
            var inputs = root.querySelectorAll("input");
            var area = root.querySelector("textarea");
            if (inputs.length < 3 || !area) return null;
            return { firstName: inputs[0], lastName: inputs[1], email: inputs[2], message: area };
        }

        function contactStatus(root) {
            var existing = document.getElementById(CONTACT_STATUS_ID);
            if (existing) return existing;
            var node = document.createElement("div");
            node.id = CONTACT_STATUS_ID;
            // Announced: this is the only place a refusal surfaces, and without it a
            // screen reader never learns the message was not sent.
            node.setAttribute("role", "status");
            node.setAttribute("aria-live", "polite");
            node.style.font = "inherit";
            node.style.fontSize = "14px";
            node.style.lineHeight = "1.4";
            node.style.marginTop = "12px";
            root.appendChild(node);
            return node;
        }

        // Announcing "All fields are required" without saying which field leaves a
        // screen-reader user to hunt. aria-describedby points at the same status
        // node, so the message is read as the field's own description.
        function markContactInvalid(nodes, invalidKeys) {
            for (var i = 0; i < CONTACT_FIELDS.length; i++) {
                var key = CONTACT_FIELDS[i];
                var node = nodes[key];
                if (!node) continue;
                if (invalidKeys.indexOf(key) === -1) {
                    node.removeAttribute("aria-invalid");
                    node.removeAttribute("aria-describedby");
                } else {
                    node.setAttribute("aria-invalid", "true");
                    node.setAttribute("aria-describedby", CONTACT_STATUS_ID);
                }
            }
        }

        function showContactStatus(root, message, isError) {
            var node = contactStatus(root);
            node.textContent = message;
            // The page has a light and a dark theme, so success inherits the theme's
            // own text colour; the red is legible on either ground.
            node.style.color = isError ? "#e5484d" : "";
        }

        // The send button is the marketing `button` component, which renders an
        // anchor — the one in the form is the only anchor with no href, because there
        // is nowhere for it to go.
        function contactControl(node) {
            var control = node && node.closest ? node.closest("a, button") : null;
            if (!control || control.getAttribute("href")) return null;
            return control;
        }

        function contactCaption(control) {
            // The component nests its caption in a rich-text paragraph.
            return control ? control.querySelector("p") || control : null;
        }

        // What the app's form sends (services/contact.ts): `ref` joins the lead to
        // the click that paid for it even when the HubSpot cookie is missing, which
        // an ad blocker makes routine, and `hutk` is what makes HubSpot's own
        // original-source attribution work at all. Only the keys we have — an empty
        // CRM property reads as "we know this is blank", which is a different fact.
        function contactAttribution() {
            var out = { ref: ref, page_uri: window.location.href };
            var hutk = readCookie("hubspotutk");
            if (hutk) out.hutk = hutk;
            if (document.title) out.page_name = document.title;
            var attr = legacyAttribution();
            for (var key in attr) {
                out[key] = attr[key];
            }
            return out;
        }

        function contactBody(values) {
            var body = new FormData();
            body.append("first_name", values.firstName);
            body.append("last_name", values.lastName);
            body.append("email", values.email);
            body.append("message", values.message);
            // A deep link can carry the topic — the same two names the app's page
            // reads, so one link works against either half of the site.
            var query = new URLSearchParams(window.location.search);
            var subject = query.get("subject") || query.get("request");
            if (subject) body.append("subject", subject.slice(0, MAX_SUBJECT_LEN));
            if (!isLive) {
                // The support mail renders `context` under its own labels, so a test
                // from the preview says so in the mail rather than arriving as a lead
                // nobody can place.
                body.append("context", JSON.stringify({ "Sent from": "Framer preview (test)" }));
            }
            body.append("attribution", JSON.stringify(contactAttribution()));
            return body;
        }

        // Once it is sent the form is done: leaving the filled fields on screen
        // invites a second copy of the same message.
        function hideContactForm(root, control) {
            var labels = root.querySelectorAll("label");
            for (var i = 0; i < labels.length; i++) {
                labels[i].style.display = "none";
            }
            if (!control) return;
            var box = control.parentElement && control.parentElement !== root ? control.parentElement : control;
            box.style.display = "none";
        }

        function submitContact(root, control) {
            if (contactSending || contactSent) return;
            var nodes = contactFields(root);
            if (!nodes) return;
            var values = {};
            for (var i = 0; i < CONTACT_FIELDS.length; i++) {
                values[CONTACT_FIELDS[i]] = String(nodes[CONTACT_FIELDS[i]].value || "").trim();
            }
            var blank = CONTACT_FIELDS.filter(function (key) {
                return !values[key];
            });
            if (blank.length) {
                markContactInvalid(nodes, blank);
                showContactStatus(root, CONTACT_TEXT.required, true);
                return;
            }
            if (!EMAIL_PATTERN.test(values.email)) {
                markContactInvalid(nodes, ["email"]);
                showContactStatus(root, CONTACT_TEXT.email, true);
                return;
            }
            markContactInvalid(nodes, []);

            contactSending = true;
            var caption = contactCaption(control);
            var original = caption ? caption.textContent : null;
            if (caption) caption.textContent = CONTACT_TEXT.sending;
            if (control) {
                control.style.pointerEvents = "none";
                control.style.opacity = "0.6";
            }
            showContactStatus(root, "", false);

            var restore = function () {
                contactSending = false;
                if (caption && original !== null) caption.textContent = original;
                if (control) {
                    control.style.pointerEvents = "";
                    control.style.opacity = "";
                }
            };

            fetch(CONTACT_ENDPOINT, { method: "POST", body: contactBody(values) })
                .then(function (response) {
                    if (response.status === HTTP_TOO_MANY_REQUESTS) throw new Error(CONTACT_TEXT.rate);
                    return response
                        .json()
                        ["catch"](function () {
                            return null;
                        })
                        .then(function (data) {
                            if (!response.ok) {
                                throw new Error((data && (data.message || data.error)) || CONTACT_TEXT.generic);
                            }
                            // Older backends report a failed send as 200 {success:false}.
                            if (data && data.success === false) {
                                throw new Error(data.message || CONTACT_TEXT.generic);
                            }
                        });
                })
                .then(function () {
                    restore();
                    contactSent = true;
                    trackEvent("contact_sent");
                    showContactStatus(root, CONTACT_TEXT.sent, false);
                    hideContactForm(root, control);
                })
                ["catch"](function (error) {
                    restore();
                    showContactStatus(root, (error && error.message) || CONTACT_TEXT.generic, true);
                });
        }

        function onContactClick(event) {
            var control = contactControl(event.target);
            if (!control) return;
            var root = contactRoot();
            if (!root || !root.contains(control)) return;
            event.preventDefault();
            submitContact(root, control);
        }

        // There is no form element, so Enter in a field would otherwise do nothing,
        // which is not how a form behaves. Enter in the message box stays a newline.
        function onContactKeydown(event) {
            if (event.key !== "Enter" || event.shiftKey) return;
            var node = event.target;
            if (!node || node.tagName !== "INPUT") return;
            var root = contactRoot();
            if (!root || !root.contains(node)) return;
            event.preventDefault();
            submitContact(root, contactControl(root.querySelector("a:not([href])")));
        }

        // The control is an anchor with no href carrying tabindex="0": focusable,
        // announced as a link to nowhere, and deaf to Enter because a browser
        // fires no click for an anchor it cannot follow. role="button" fixes the
        // announcement; onContactActivate fixes the keyboard.
        function markContactControl() {
            var root = contactRoot();
            var control = root ? root.querySelector("a:not([href])") : null;
            if (control && control.getAttribute("role") !== "button") {
                control.setAttribute("role", "button");
            }
        }

        function onContactActivate(event) {
            if (event.key !== "Enter" && event.key !== " ") return;
            var control = contactControl(event.target);
            if (!control) return;
            var root = contactRoot();
            if (!root || !root.contains(control)) return;
            event.preventDefault();
            submitContact(root, control);
        }

        document.addEventListener("click", onContactClick, true);
        document.addEventListener("keydown", onContactActivate, true);
        document.addEventListener("keydown", onContactKeydown, true);
        // Breakpoint variants mount after first paint, so once is not enough and
        // an observer is more than this needs.
        markContactControl();
        document.addEventListener("DOMContentLoaded", markContactControl);
        setTimeout(markContactControl, 1200);
    })();
</script>

