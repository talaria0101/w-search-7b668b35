    <!-- Snippet: WBUg11SY3 -->
 <script>
    // Keenable: "Cookie settings" in the footer reopens the Cookiebot dialog, so anyone can
    // change or withdraw a cookie choice — outside the EU no banner ever offered one. The
    // footer link points at https://keenable.ai/#cookie-settings, which is harmless if this
    // never runs; when it does, the click opens the dialog instead. Same action as
    // CookieSettingsButton in the keenable-landing app. Marker: keenable-cookie-settings.
    (function () {
        function cookieSettingsLink(target) {
            var link = target && target.closest ? target.closest("a[href]") : null;
            return link && /#cookie-settings$/.test(link.getAttribute("href") || "") ? link : null;
        }
        document.addEventListener(
            "click",
            function (event) {
                if (!cookieSettingsLink(event.target)) return;
                event.preventDefault();
                event.stopPropagation();
                if (window.Cookiebot && typeof window.Cookiebot.renew === "function") {
                    window.Cookiebot.renew();
                }
            },
            true
        );
    })();
</script>
<!-- SnippetEnd: WBUg11SY3 -->

