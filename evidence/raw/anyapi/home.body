w-10 rounded-full" src="data:image/svg+xml;base64," alt="Website Screenshot API"/></div><div class="flex-1 min-w-0"><a title="Website Screenshot API" class="focus:outline-none" href="/marketplace/website-screenshot-api"><span class="absolute inset-0" aria-hidden="true"></span><p class="text-sm font-medium text-gray-900">Website Screenshot</p><p class="text-sm text-gray-500 truncate">Transform any URL to an image</p></a></div></div><div class="relative rounded-lg border border-gray-300 bg-white px-6 py-5 shadow-sm flex items-center space-x-3 hover:border-gray-400 focus-within:ring-2 focus-within:ring-offset-2 focus-within:ring-blue-500"><div class="flex-shrink-0"><img class="h-10 w-10 rounded-full" src="data:image/svg+xml;base64," alt="Sentiment Analysis API"/></div><div class="flex-1 min-w-0"><a title="Sentiment Analysis API" class="focus:outline-none" href="/marketplace/sentiment-analysis-api"><span class="absolute inset-0" aria-hidden="true"></span><p class="text-sm font-medium text-gray-900">Sentiment Analysis</p><p class="text-sm text-gray-500 truncate">Perform sentiment analysis on a sentence, paragraph or a single word</p></a></div></div><div class="relative rounded-lg border border-gray-300 bg-white px-6 py-5 shadow-sm flex items-center space-x-3 hover:border-gray-400 focus-within:ring-2 focus-within:ring-offset-2 focus-within:ring-blue-500"><div class="flex-shrink-0"><img class="h-10 w-10 rounded-full" src="data:image/svg+xml;base64," alt="VAT Number Validation &amp; EU rates API"/></div><div class="flex-1 min-w-0"><a title="VAT Number Validation &amp; EU rates API" class="focus:outline-none" href="/marketplace/vat-number-validation-api"><span class="absolute inset-0" aria-hidden="true"></span><p class="text-sm font-medium text-gray-900">VAT Number Validation &amp; EU rates</p><p class="text-sm text-gray-500 truncate">Simplify compliance with our VAT Number Validation API – seamless verification for accurate business transactions</p></a></div></div></div></d