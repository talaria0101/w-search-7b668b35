full bg-blue-600 border border-blue-500 rounded-md py-2 font-semibold text-white text-center hover:bg-blue-700">Buy Pro</button></div><div class="pt-6 pb-8 px-6"><ul role="list" class="space-y-4"><li class="flex space-x-3"><svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true" data-slot="icon" class="flex-shrink-0 h-5 w-5 text-green-500"><path fill-rule="evenodd" d="M10 18a8 8 0 1 0 0-16 8 8 0 0 0 0 16Zm3.857-9.809a.75.75 0 0 0-1.214-.882l-3.483 4.79-1.88-1.88a.75.75 0 1 0-1.06 1.061l2.5 2.5a.75.75 0 0 0 1.137-.089l4-5.5Z" clip-rule="evenodd"></path></svg><span class="text-sm text-gray-600">Starter features, plus:</span></li><li class="flex space-x-3"><svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true" data-slot="icon" class="flex-shrink-0 h-5 w-5 text-green-500"><path fill-rule="evenodd" d="M10 18a8 8 0 1 0 0-16 8 8 0 0 0 0 16Zm3.857-9.809a.75.75 0 0 0-1.214-.882l-3.483 4.79-1.88-1.88a.75.75 0 1 0-1.06 1.061l2.5 2.5a.75.75 0 0 0 1.137-.089l4-5.5Z" clip-rule="evenodd"></path></svg><span class="text-sm text-gray-600">Priority Support</span></li><li class="flex space-x-3"><svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true" data-slot="icon" class="flex-shrink-0 h-5 w-5 text-green-500"><path fill-rule="evenodd" d="M10 18a8 8 0 1 0 0-16 8 8 0 0 0 0 16Zm3.857-9.809a.75.75 0 0 0-1.214-.882l-3.483 4.79-1.88-1.88a.75.75 0 1 0-1.06 1.061l2.5 2.5a.75.75 0 0 0 1.137-.089l4-5.5Z" clip-rule="evenodd"></path></svg><span class="text-sm text-gray-600">API Logs</span></li></ul></div></div><div class="border rounded-lg shadow-md divide-y divide-gray-200 border-gray-400"><div class="p-6 relative"><h2 class="text-2xl leading-6 font-medium text-gray-900">Business<span class="ml-2 inline-flex px-3 rounded-full text-sm font-semibold bg-green-100 text-green-600">Save 30%</span></h2><p class="mt-4 text-sm text-gray-500">A complete backend solution</p><p class="mt-8"><span class="text-4xl font-extrabold text-gray-900">$84.99</span> <span class="text-base font-medium text-gray-500">/mo</span></p><div class="pt-5 pb-2"><ul role="list" class="space-y-4"><li class="flex space-x-3"><span class="text-sm text-gray-600"><b>300,000</b> <!-- -->requests/month</span></li><li class="flex space-x-3"><span class="text-sm text-gray-600"><b>Unlimited</b> <!-- -->requests/second</span></li></ul></div><button type="button" class="mt-8 block w-full bg-blue-600 border border-blue-500 rounded-md py-2 font-semibold text-white text-center hover:bg-blue-700">Buy Business</button></div><div class="pt-6 pb-8 px-6"><ul role="list" class="space-y-4"><li class="flex space-x-3"><svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true" data-slot="icon" class="flex-shrink-0 h-5 w-5 text-green-500"><path fill-rule="evenodd" d="M10 18a8 8 0 1 0 0-16 8 8 0 0 0 0 16Zm3.857-9.809a.75.75 0 0 0-1.214-.882l-3.483 4.79-1.88-1.88a.75.75 0 1 0-1.06 1.061l2.5 2.5a.75.75 0 0 0 1.137-.089l4-5.5Z" clip-rule="evenodd"></path></svg><span class="text-sm text-gray-600">Pro features, plus:</span></li><li class="flex space-x-3"><svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true" data-slot="icon" class="flex-shrink-0 h-5 w-5 text-green-500"><path fill-rule="evenodd" d="M10 18a8 8 0 1 0 0-16 8 8 0 0 0 0 16Zm3.857-9.809a.75.75 0 0 0-1.214-.882l-3.483 4.79-1.88-1.88a.75.75 0 1 0-1.06 1.061l2.5 2.5a.75.75 0 0 0 1.137-.089l4-5.5Z" clip-rule="evenodd"></path></svg><span class="text-sm text-gray-600">Dedicated support &amp; SLAs</span></li><li class="flex space-x-3"><svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true" data-slot="icon" class="flex-shrink-0 h-5 w-5 text-green-500"><path fill-rule="evenodd" d="M10 18a8 8 0 1 0 0-16 8 8 0 0 0 0 16Zm3.857-9.809a.75.75 0 0 0-1.214-.882l-3.483 4.79-1.88-1.88a.75.75 0 1 0-1.06 1.061l2.5 2.5a.75.75 0 0 0 1.137-.089l4-5.5Z" clip-rule="evenodd"></path></svg><span class="text-sm text-gray-600">Email and Phone support</span></li></ul></div></div></div></div></div><div class="bg-white"><div class="mx-auto max-w-7xl divide-y-2 divide-gray-200 py-4 px-4 sm:py-8 sm:px-6 lg:px-8"><h2 class="text-3xl font-bold tracking-tight text-gray-900">Frequently asked questions</h2><div class="mt-6 pt-10"><dl class="space-y-10 md:grid md:grid-cols-2 md:gap-x-8 md:gap-y-12 md:space-y-0"><div><dt class="text-lg font-medium leading-6 text-gray-900">What are the different pricing plans available?</dt><dd class="mt-2 text-base text-gray-500">We offer a variety of pricing plans to fit the needs of different types of users. Our plans range from a free tier for small usage to larger, more comprehensive plans for heavy users.</dd></div><div><dt class="text-lg font-medium leading-6 text-gray-900">Is there a free trial or a free tier?</dt><dd class="mt-2 text-base text-gray-500">Yes, we offer a free tier that allows you to try out AnyAPI with a limited number of API calls. This is a great way to get a feel for our service and see if it meets your needs before committing to a paid plan!</dd></div><div><dt class="text-lg font-medium leading-6 text-gray-900">How do I upgrade or downgrade my plan?</dt><dd class="mt-2 text-base text-gray-500">You can easily upgrade or downgrade your plan at any time from your account settings. Simply select the new plan that you would like to switch to, and your billing will be adjusted accordingly.</dd></div><div><dt class="text-lg font-medium leading-6 text-gray-900">Can I pay annually or do I have to pay monthly?</dt><dd class="mt-2 text-base text-gray-500">You can choose to pay either monthly or annually, whichever is most convenient for you. If you choose to pay annually, you will receive a 30% discount on your total cost.</dd></div><div><dt class="text-lg font-medium leading-6 text-gray-900">Is there a discount for paying annually?</dt><dd class="mt-2 text-base text-gray-500">Yes! we offer a 30% discounted rate for users who choose to pay annually. This can be a cost-effective option if you plan on using AnyAPI for an extended period of time.</dd></div><div><dt class="text-lg font-medium leading-6 text-gray-900">Is there a limit to the number of API calls I can make?</dt><dd class="mt-2 text-base text-gray-500">Yes, the number of API calls that you are allowed to make is limited based on your pricing plan. Our Business plan support unlimited API calls.</dd></div><div><dt class="text-lg font-medium leading-6 text-gray-900">Do you offer volume discounts for large usage?</dt><dd class="mt-2 text-base text-gray-500">Yes, we offer volume discounts for users who need a high volume of API calls. Contact us team to discuss your specific usage needs and we will work with you to create a customized plan that meets your needs at a discounted rate.</dd></div><div><dt class="text-lg font-medium leading-6 text-gray-900">Is there a money-back guarantee if I&#x27;m not satisfied with the service?</dt><dd class="mt-2 text-base text-gray-500">Yes. We offer a 14-days money-back guarantee for our paid plans. Contact us in under 14 days of your purchase to get a full refund.</dd></div></dl></div></div></div><div class="bg-white"><div class="max-w-7xl mx-auto py-16 px-5 xl:px-0"><div class="bg-blue-700 rounded-lg shadow-xl overflow-hidden lg:grid lg:grid-cols-2 lg:gap-4"><div class="pt-10 pb-12 px-6 sm:pt-16 sm:px-16 lg:py-16 lg:pr-0 xl:py-20 xl:px-20"><div class="lg:self-center"><h2 class="text-3xl font-extrabold text-white sm:text-4xl"><span class="block">Ready to dive in?</span><span class="block">Create your API key for free!</span></h2><p class="mt-4 text-lg leading-6 text-blue-200">Create your API key and integrate it with your app within minutes</p><a class="mt-8 bg-white border border-transparent rounded-md shadow px-5 py-3 inline-flex items-center text-base font-medium text-blue-600 hover:bg-blue-50" href="/login">Get your API Key</a></div></div><div class="-mt-6 aspect-w-5 aspect-h-3 md:aspect-w-2 md:aspect-h-1"><img alt="Discover AnyAPI" loading="lazy" width="0" height="0" decoding="async" data-nimg="1" class="transform translate-x-0 translate-y-0 rounded-md object-cover object-left-top sm:translate-x-0 lg:translate-y-6" style="color:transparent" src="/launch.svg"/></div></div></div></div><footer class="bg-white" aria-labelledby="footer-heading"><h2 id="footer-heading" class="sr-only">Footer</h2><div class="max-w-7xl mx-auto py-12 px-4 sm:px-6 lg:py-16 lg:px-8"><div class="xl:grid xl:grid-cols-3 xl:gap-8"><div class="space-y-8 xl:col-span-1"><img alt="AnyAPI" loading="lazy" width="40" height="40" decoding="async" data-nimg="1" class="h-10" style="color:transparent" src="/logo.svg"/><p class="text-gray-600 text-base">The easiest way to automate routine workflows</p><div class="flex space-x-6"><a href="https://twitter.com/anyapi_io" title="Twitter" target="_blank" rel="noreferrer" class="text-gray-400 hover:text-gray-500"><span class="sr-only">Twitter</span><svg fill="currentColor" viewBox="0 0 24 24" class="h-6 w-6" aria-hidden="true"><path d="M8.29 20.251c7.547 0 11.675-6.253 11.675-11.675 0-.178 0-.355-.012-.53A8.348 8.348 0 0022 5.92a8.19 8.19 0 01-2.357.646 4.118 4.118 0 001.804-2.27 8.224 8.224 0 01-2.605.996 4.107 4.107 0 00-6.993 3.743 11.65 11.65 0 01-8.457-4.287 4.106 4.106 0 001.27 5.477A4.072 4.072 0 012.8 9.713v.052a4.105 4.105 0 003.292 4.022 4.095 4.095 0 01-1.853.07 4.108 4.108 0 003.834 2.85A8.233 8.233 0 012 18.407a11.616 11.616 0 006.29 1.84"></path></svg></a></div></div><div class="mt-12 grid grid-cols-2 gap-8 xl:mt-0 xl:col-span-2"><div class="md:grid md:grid-cols-2 md:gap-8"><div><h3 class="text-sm font-semibold text-gray-600 tracking-wider uppercase">Resources</h3><ul role="list" class="mt-4 space-y-4"><li><a class="text-base text-gray-500 hover:text-gray-900" href="/whyAnyAPI">Why AnyAPI?</a></li><li><a class="text-base text-gray-500 hover:text-gray-900" href="/blog">Blog</a