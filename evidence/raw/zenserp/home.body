<main  class="mt-16 mx-auto max-w-6xl sm:mt-24">
    <div class="items-center flex flex-wrap">
        <div class="mobile-res w-full md:w-5/12 mr-auto px-4 md:px-6 md:px-0">
            <h1 class="text-4xl font-semibold text-center md:text-left text-white sm:text-4xl md:text-4xl">
                Fast, Accurate Search Data Built for Developers
            </h1>
            <p class="mt-3 max-w-md mx-auto text-gray-500 text-center md:text-left sm:text-lg md:mt-5 md:text-xl md:max-w-2xl">
                Zenserp lets you fetch live Google search results through a fast and stable SERP API.
            </p>
            <div class="mt-5 sm:flex justify-center  md:justify-start md:mt-8">
                <div class="rounded-sm shadow">
                    <a href="https://app.zenserp.com/register?plan=free" class="w-full uppercase flex rounded items-center justify-center px-6 py-3 border border-transparent text-sm font-medium text-white bg-blue-700 hover:bg-blue-800">
                        Get Your API Key
                    </a>
                </div>
