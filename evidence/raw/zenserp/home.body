                    <a href="/pricing-plans" class="w-full uppercase flex rounded items-center justify-center px-6 py-3 border border-transparent text-sm font-medium text-darkblue-600 bg-white hover:bg-gray-50">
                        View Pricing
                    </a>
                </div>
            </div>
