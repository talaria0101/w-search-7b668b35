<script id="zsp-pricing-js-after">
window.zspPricing={"plans":[{"k":"small","q":25000,"m":49.99},{"k":"medium","q":100000,"m":149.99},{"k":"large","q":250000,"m":299.99},{"k":"premium","q":500000,"m":499.99},{"k":"enterprise","q":1000000,"m":899}],"discount":0.2,"i18n":{"monthly":"Billed monthly","yearly":"billed yearly","save":"save","showCmp":"Compare all features","hideCmp":"Hide feature comparison"}};(function(){
  var cfg=window.zspPricing,root=document.querySelector('.zsp');
  if(!cfg||!root)return;
  var fmt=function(n){return '$'+(n%1===0?n.toLocaleString('en-US'):n.toLocaleString('en-US',{minimumFractionDigits:2,maximumFractionDigits:2}));};
  var r2=function(n){return Math.round(n*100)/100;};
  var period='mo';

  function renderPrices(){
    cfg.plans.forEach(function(p){
      var card=root.querySelector('.zsp-card[data-plan="'+p.k+'"]');
      if(!card)return;
      var monthly=period==='yr'?r2(p.m*(1-cfg.discount)):p.m;
      card.querySelector('[data-price]').textContent=fmt(monthly);
      var billed=card.querySelector('[data-billed]');
      if(period==='yr'){
        var yearly=r2(monthly*12),saved=r2((p.m-monthly)*12);
        billed.innerHTML=fmt(yearly)+' '+cfg.i18n.yearly+' &middot; <span class="zsp-sv">'+cfg.i18n.save+' '+fmt(saved)+'</span>';
      }else{
        billed.textContent=cfg.i18n.monthly;
      }
      var btn=card.querySelector('.zsp-btn[data-href-mo]');
      if(btn)btn.setAttribute('href',btn.getAttribute(period==='yr'?'data-href-yr':'data-href-mo'));
      var t=root.querySelector('[data-cpk-t="'+p.k+'"]');
      if(t)t.textContent='$'+(monthly/(p.q/1000)).toFixed(2);
    });
  }

  var btns=root.querySelectorAll('.zsp-billing button');
  btns.forEach(function(b){
    b.addEventListener('click',function(){
      period=b.getAttribute('data-period');
      btns.forEach(function(x){x.setAttribute('aria-pressed',x===b?'true':'false');});
      renderPrices();
    });
  });

  var cb=root.querySelector('#zsp-cmp-btn'),cmp=root.querySelector('#zsp-cmp');
  if(cb&&cmp){
    cb.addEventListener('click',function(){
      var open=cmp.hasAttribute('hidden');
      if(open){cmp.removeAttribute('hidden');}else{cmp.setAttribute('hidden','');}
      cb.setAttribute('aria-expanded',open?'true':'false');
      cb.querySelector('.zsp-cmp-lbl').textContent=open?cfg.i18n.hideCmp:cfg.i18n.showCmp;
    });
  }
})();
//# sourceURL=zsp-pricing-js-after
</script>
<script>
document.addEventListener('DOMContentLoaded', function () {

    var openBtn1  = document.getElementById('openMobileMenuCustom');
    var closeBtn1 = document.getElementById('closeMobileMenuCustom');
    var menu1     = document.getElementById('mobileMenuCustom');

    if (!openBtn1 || !closeBtn1 || !menu1) {
        return;
    }

    function toggleMenuCustom() {
        menu1.classList.toggle('hidden');
        menu1.classList.add('z-20');
    }

    openBtn1.addEventListener('click', toggleMenuCustom);
    closeBtn1.addEventListener('click', toggleMenuCustom);
    
    try {
    document.getElementById("openFlyoutCustom").addEventListener("click", (function() {
        document.getElementById("flyoutMenuCustom").classList.contains("hidden") ? document.getElementById("flyoutMenuCustom").classList.remove("hidden") : document.getElementById("flyoutMenuCustom").classList.add("hidden")
    }))
} catch (e) {}

});    
</script>
