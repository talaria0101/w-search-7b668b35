<link data-minify="1" rel='stylesheet' id='style-css' href='https://zenserp.com/wp-content/cache/min/1/wp-content/themes/saasindustries/public/css/style.css?ver=1790680505' media='all' />
<style id="zsp-pricing-inline-css">
.zsp{
  --zsp-ink:#00264c;--zsp-ink-2:#0b3563;--zsp-text:#111827;--zsp-muted:#5b6477;--zsp-faint:#8a93a6;
  --zsp-line:#e3e7ef;--zsp-bg:#f6f8fb;--zsp-card:#fff;--zsp-blue:#2b6cb0;--zsp-blue-soft:#ebf4ff;
  --zsp-cta:#2d3748;--zsp-cta-hover:#1a202c;--zsp-ai:#0052CC;--zsp-ai-soft:#e6eefa;--zsp-ok:#16a34a;
  --zsp-radius:14px;
  --zsp-font:system-ui,-apple-system,BlinkMacSystemFont,"Segoe UI",Roboto,Helvetica,Arial,sans-serif;
  font-family:var(--zsp-font);background:var(--zsp-bg);color:var(--zsp-text);line-height:1.5;
  -webkit-font-smoothing:antialiased;
}
.zsp *,.zsp *::before,.zsp *::after{box-sizing:border-box}
.zsp h1,.zsp h2,.zsp h3,.zsp p,.zsp ul,.zsp li,.zsp table{margin:0;padding:0}
.zsp a{color:inherit}
.zsp img{max-width:100%}
.zsp button{font:inherit}
.zsp :focus-visible{outline:2px solid var(--zsp-blue);outline-offset:2px;border-radius:6px}
.zsp .zsp-container{max-width:1200px;margin:0 auto;padding:0 24px}
.zsp .zsp-sr-only{position:absolute;width:1px;height:1px;overflow:hidden;clip:rect(0 0 0 0);white-space:nowrap}
.zsp .zsp-sprite{position:absolute;width:0;height:0;overflow:hidden}

/* Hero */
.zsp .zsp-hero{background:var(--zsp-ink);color:#fff;padding:100px 0 128px;text-align:center;position:relative;overflow:hidden}
.zsp .zsp-hero::before{content:"";position:absolute;inset:0;background:radial-gradient(600px 260px at 50% 0%,rgba(43,108,176,.45),transparent 70%);pointer-events:none}
.zsp .zsp-hero .zsp-container{position:relative}
.zsp .zsp-hero h1{font-family:var(--zsp-font);color:#fff;font-size:clamp(30px,4.4vw,46px);font-weight:700;letter-spacing:-1px;line-height:1.1;margin-bottom:16px}
.zsp .zsp-hero p{max-width:760px;margin:0 auto;color:#b9c1d3;font-size:16.5px}
.zsp .zsp-one-line{display:block}
@media (min-width:760px){.zsp .zsp-one-line{white-space:nowrap}}
.zsp .zsp-billing{display:inline-flex;margin-top:32px;background:var(--zsp-ink-2);border:1px solid rgba(255,255,255,.1);border-radius:12px;padding:4px}
.zsp .zsp-billing button{border:0;background:none;color:#b9c1d3;font-size:14px;font-weight:500;padding:9px 18px;border-radius:9px;cursor:pointer;display:flex;align-items:center;gap:8px;box-shadow:none}
.zsp .zsp-billing button[aria-pressed="true"]{background:#fff;color:var(--zsp-ink)}
.zsp .zsp-save{font-size:11.5px;font-weight:600;color:#fff;background:var(--zsp-ok);padding:1px 7px;border-radius:8px}

/* Plans */
.zsp .zsp-plans{margin-top:-84px;position:relative}
.zsp .zsp-plans>.zsp-container{max-width:1340px}
.zsp .zsp-cards{display:grid;grid-template-columns:repeat(6,1fr);gap:12px;align-items:stretch}
.zsp .zsp-card{background:var(--zsp-card);border:1px solid var(--zsp-line);border-radius:var(--zsp-radius);padding:22px 16px 20px;display:flex;flex-direction:column;position:relative;box-shadow:0 1px 2px rgba(10,15,28,.04);transition:box-shadow .2s,border-color .2s}
.zsp .zsp-card.zsp-pop{border-color:var(--zsp-blue);box-shadow:inset 0 0 0 1px var(--zsp-blue),0 1px 2px rgba(10,15,28,.04)}
.zsp .zsp-tag{position:absolute;top:-11px;left:16px;font-size:11.5px;font-weight:600;padding:2px 10px;border-radius:20px;background:var(--zsp-blue);color:#fff}
.zsp .zsp-tag.zsp-tag-dark{background:var(--zsp-ink);border: 1px solid var(--zsp-ink-2);}
.zsp .zsp-card h3{font-family:var(--zsp-font);color:var(--zsp-text);font-size:16px;font-weight:600;line-height:24px}
.zsp .zsp-desc{font-size:13px;color:var(--zsp-muted);margin-top:2px;min-height:40px;line-height:20px}
.zsp .zsp-price{display:flex;align-items:baseline;gap:4px;margin-top:16px}
.zsp .zsp-amt{font-size:28px;font-weight:700;letter-spacing:-1px;line-height:1}
.zsp .zsp-per{font-size:13px;color:var(--zsp-muted)}
.zsp .zsp-billed{font-size:12px;color:var(--zsp-muted);margin-top:6px;min-height:36px;line-height:18px}
.zsp .zsp-sv{color:var(--zsp-text);font-weight:600}
.zsp .zsp-vol{margin-top:16px;padding:10px 12px;background:var(--zsp-bg);border-radius:10px}
.zsp .zsp-vol b{display:block;font-size:15px;font-weight:600}
.zsp .zsp-btn{display:block;width:100%;text-align:center;font-size:14px;font-weight:600;line-height:20px;padding:8px 0;border-radius:6px;text-decoration:none;border:1px solid var(--zsp-cta);color:#fff;background:var(--zsp-cta);margin:16px 0 18px;transition:background .15s}
.zsp .zsp-btn:hover,.zsp .zsp-btn:focus{background:var(--zsp-cta-hover);border-color:var(--zsp-cta-hover);color:#fff}
.zsp .zsp-grp-lbl{font-size:12px;font-weight:600;color:var(--zsp-faint);margin:0 0 8px}
.zsp .zsp-grp-lbl.zsp-ai{color:var(--zsp-ai);display:flex;align-items:center;gap:6px}
.zsp .zsp-feat{list-style:none;font-size:13px;color:#2b3345}
.zsp .zsp-feat li{display:flex;gap:8px;align-items:flex-start;margin-bottom:7px;line-height:1.4}
.zsp .zsp-feat li::before{content:none}
.zsp .zsp-feat .zsp-ic{flex-shrink:0;width:16px;height:16px;margin-top:1px;color:var(--zsp-ok)}
.zsp .zsp-feat li.zsp-no,.zsp .zsp-feat li.zsp-no .zsp-ic{color:var(--zsp-faint)}
.zsp .zsp-feat li.zsp-ai-f .zsp-ic{color:var(--zsp-ai)}
.zsp .zsp-new{font-size:10.5px;font-weight:600;color:var(--zsp-ai);background:var(--zsp-ai-soft);padding:0 6px;border-radius:6px;margin-left:4px;white-space:nowrap}
.zsp .zsp-cred{font-size:11.5px;color:var(--zsp-muted)}
.zsp .zsp-core{margin-bottom:14px}
.zsp .zsp-ai-box{margin-top:auto;padding-top:14px;border-top:1px solid var(--zsp-line)}
@media (min-width:1241px){
  @supports (grid-template-rows:subgrid){
    .zsp .zsp-cards{grid-template-rows:repeat(8,auto);row-gap:0}
    .zsp .zsp-card{display:grid;grid-row:span 8;grid-template-rows:subgrid;row-gap:0}
    .zsp .zsp-card>.zsp-ai-box{margin-top:0;align-self:start}
  }
}
.zsp .zsp-plan-notes{display:flex;justify-content:center;gap:22px;flex-wrap:wrap;margin-top:20px;font-size:13px;color:var(--zsp-muted)}
.zsp .zsp-plan-notes span{display:flex;align-items:center;gap:6px}
.zsp .zsp-plan-notes .zsp-ok{color:var(--zsp-ok)}
.zsp .zsp-plan-notes .zsp-spark{color:var(--zsp-ai)}

/* Compare table */
.zsp .zsp-compare{margin-top:48px}
.zsp .zsp-compare-toggle{display:flex;align-items:center;gap:10px;margin:0 auto;background:none;border:1px solid #cfd5e1;border-radius:10px;padding:10px 18px;font-size:14px;font-weight:600;cursor:pointer;color:var(--zsp-text);box-shadow:none}
.zsp .zsp-compare-toggle:hover{border-color:var(--zsp-text);background:none;color:var(--zsp-text)}
.zsp .zsp-compare-toggle svg{transition:transform .2s}
.zsp .zsp-compare-toggle[aria-expanded="true"] svg{transform:rotate(180deg)}
.zsp .zsp-tbl-wrap{overflow-x:auto;margin-top:20px;background:var(--zsp-card);border:1px solid var(--zsp-line);border-radius:var(--zsp-radius)}
.zsp .zsp-tbl-wrap[hidden]{display:none}
.zsp .zsp-table{width:100%;border-collapse:collapse;border:0;font-size:13.5px;min-width:820px;background:transparent}
.zsp .zsp-table th,.zsp .zsp-table td{padding:11px 14px;text-align:center;border:0;border-bottom:1px solid var(--zsp-line);vertical-align:middle}
.zsp .zsp-table th:first-child,.zsp .zsp-table td:first-child{text-align:left;position:sticky;left:0;background:var(--zsp-card);min-width:210px}
.zsp .zsp-table thead th{font-size:14px;font-weight:600;background:var(--zsp-card);color:var(--zsp-text)}
.zsp .zsp-table thead th.zsp-pop-col{color:var(--zsp-blue)}
.zsp .zsp-table tr.zsp-sec td{background:var(--zsp-bg);font-size:12px;font-weight:600;color:var(--zsp-faint);text-align:left;padding:9px 14px}
.zsp .zsp-table tr.zsp-sec.zsp-ai td{color:var(--zsp-ai)}
.zsp .zsp-y{color:var(--zsp-ok)}
.zsp .zsp-y.zsp-ai{color:var(--zsp-ai)}
.zsp .zsp-n{color:#c5cbd6}
.zsp .zsp-table tbody tr:last-child td{border-bottom:0}

/* Need more */
.zsp .zsp-more{margin:48px 0 72px;background:var(--zsp-ink);color:#fff;border-radius:var(--zsp-radius);padding:28px 32px;display:flex;align-items:center;justify-content:space-between;gap:24px;flex-wrap:wrap}
.zsp .zsp-more h2{font-family:var(--zsp-font);color:#fff;font-size:20px;font-weight:600;line-height:1.3}
.zsp .zsp-more p{font-size:14.5px;color:#b9c1d3;margin-top:4px}
.zsp .zsp-more a{font-size:14px;font-weight:600;padding:10px 18px;border-radius:10px;background:#fff;color:var(--zsp-ink);text-decoration:none}
.zsp .zsp-more a:hover{background:var(--zsp-blue-soft)}

/* Logos */
.zsp .zsp-logos{padding-bottom:64px}
.zsp .zsp-logos .zsp-row{display:flex;flex-wrap:wrap;justify-content:center;align-items:center;gap:44px;opacity:.5;filter:grayscale(1)}
.zsp .zsp-logos img{height:28px;width:auto}

/* Why Zenserp */
.zsp .zsp-why{background:var(--zsp-bg);padding:72px 0;border-top:1px solid var(--zsp-line)}
.zsp .zsp-why .zsp-container{display:grid;grid-template-columns:1fr 2fr;gap:48px;align-items:start}
.zsp .zsp-eyebrow{font-size:13px;font-weight:600;letter-spacing:.06em;text-transform:uppercase;color:var(--zsp-blue);margin-bottom:10px}
.zsp .zsp-why h2,.zsp .zsp-faq h2,.zsp .zsp-talk h2{font-family:var(--zsp-font);color:var(--zsp-text);font-size:clamp(24px,3vw,30px);font-weight:700;letter-spacing:-.5px;line-height:1.2}
.zsp .zsp-why-intro p{font-size:15.5px;color:#2b3345;margin-top:16px}
.zsp .zsp-why-grid{display:grid;grid-template-columns:1fr 1fr;gap:36px 40px}
.zsp .zsp-why-item{display:flex;gap:14px}
.zsp .zsp-why-item svg{flex-shrink:0;width:22px;height:22px;color:var(--zsp-blue);margin-top:1px}
.zsp .zsp-why-item h3{font-family:var(--zsp-font);color:var(--zsp-text);font-size:16px;font-weight:600;line-height:1.4}
.zsp .zsp-why-item p{font-size:14px;color:var(--zsp-muted);margin-top:6px;line-height:1.55}

/* FAQ */
.zsp .zsp-faq{background:#fff;padding:72px 0}
.zsp .zsp-faq h2{text-align:center;margin-bottom:40px}
.zsp .zsp-faq-cols{display:grid;grid-template-columns:1fr 1fr;gap:0 48px;align-items:start}
.zsp .zsp-faq details{border-bottom:1px solid var(--zsp-line)}
.zsp .zsp-faq summary{list-style:none;cursor:pointer;display:flex;justify-content:space-between;align-items:center;gap:16px;padding:16px 0;font-size:15.5px;font-weight:600;color:var(--zsp-text)}
.zsp .zsp-faq summary::-webkit-details-marker{display:none}
.zsp .zsp-faq summary::marker{content:""}
.zsp .zsp-faq summary svg{flex-shrink:0;color:var(--zsp-faint);transition:transform .2s}
.zsp .zsp-faq details[open] summary svg{transform:rotate(180deg)}
.zsp .zsp-faq summary:hover{color:var(--zsp-blue)}
.zsp .zsp-faq-a{padding:0 32px 18px 0;font-size:14.5px;color:var(--zsp-muted);line-height:1.65}
.zsp .zsp-faq-a a{color:var(--zsp-blue);text-decoration:underline}

/* Still have questions */
.zsp .zsp-talk{background:var(--zsp-bg);padding:64px 0;border-top:1px solid var(--zsp-line)}
.zsp .zsp-talk .zsp-container{display:flex;justify-content:space-between;align-items:center;gap:32px;flex-wrap:wrap}
.zsp .zsp-talk-text{max-width:560px}
.zsp .zsp-talk-text p{font-size:15.5px;color:var(--zsp-muted);margin-top:14px;line-height:1.6}
.zsp .zsp-talk-cta{display:flex;flex-direction:column;align-items:flex-start;gap:14px}
.zsp .zsp-talk-mail{display:flex;align-items:center;gap:8px;font-size:15px;font-weight:500;color:var(--zsp-blue);text-decoration:none}
.zsp .zsp-talk-mail:hover{text-decoration:underline}
.zsp .zsp-talk-btn{font-size:14px;font-weight:600;padding:11px 20px;border-radius:6px;background:var(--zsp-blue);color:#fff;text-decoration:none;text-transform:uppercase;letter-spacing:.02em}
.zsp .zsp-talk-btn:hover,.zsp .zsp-talk-btn:focus{background:#245a93;color:#fff}

@media (max-width:900px){
  .zsp .zsp-why .zsp-container{grid-template-columns:1fr;gap:32px}
  .zsp .zsp-faq-cols{grid-template-columns:1fr}
}
@media (max-width:620px){
  .zsp .zsp-why-grid{grid-template-columns:1fr;gap:28px}
  .zsp .zsp-why,.zsp .zsp-faq{padding:56px 0}
}

/* Responsive */
@media (max-width:1240px){
  .zsp .zsp-cards{display:flex;overflow-x:auto;scroll-snap-type:x mandatory;padding:14px 4px 10px;margin:0 -4px;gap:14px}
  .zsp .zsp-card{flex:0 0 250px;scroll-snap-align:start}
}
@media (max-width:620px){
  .zsp .zsp-container{padding:0 16px}
  .zsp .zsp-cards{display:grid;grid-template-columns:1fr;overflow:visible;padding:0;margin:0}
  .zsp .zsp-card{flex:none}
  .zsp .zsp-card+.zsp-card{margin-top:6px}
  .zsp .zsp-more{padding:24px}
}
@media (prefers-reduced-motion:reduce){.zsp *{transition:none!important}}
/*# sourceURL=zsp-pricing-inline-css */
</style>
<link rel="https://api.w.org/" href="https://zenserp.com/wp-json/" /><link rel="alternate" title="JSON" type="application/json" href="https://zenserp.com/wp-json/wp/v2/pages/7482" /><link rel="EditURI" type="application/rsd+xml" title="RSD" href="https://zenserp.com/xmlrpc.php?rsd" />
<meta name="generator" content="WordPress 7.1" />
