<script>
    document.documentElement.setAttribute("data-theme", "dark");
</script>
<script>
/* the cloud banner's state before the first paint: big (default) · small (after close) · off (after
   "don't show this again"); a signed-in cloud user (the c4_sess sign-in marker cookie on .crawl4ai.com) gets small */
(function(){try{var v=JSON.parse(localStorage.getItem("c4-cloud-banner")||"null");var s=(v&&v.version===1)?v.state:"big";
if(s==="big"&&/(^|; )c4_sess=1(;|$)/.test(document.cookie))s="small";document.documentElement.setAttribute("data-c4b",s);}
catch(e){document.documentElement.setAttribute("data-c4b","big");}})();
</script>
