    <div class="fromdocs" data-fromdocs hidden><span class="tagpill" data-fd-tag>from the docs</span> <b data-fd-title>You know the library. This is the same crawler, hosted.</b> <span data-fd-text>No browsers, no proxies, no cookies to babysit: one key with free credits every month, and it works in Claude Code, Codex, OpenCode and Cursor. Always open source, forever.</span> <button class="getk" data-key>Get a key + <span data-credit="monthly">1,000</span> free credits a month →</button></div>
    <script>/* one welcome per source: the ref of this visit, else the first-touch cookie. Keys: the ref's first word (docs-banner → docs, gh-about → gh). */
(function(){try{var W={docs:["from the docs","You know the library. This is the same crawler, hosted.","No browsers, no proxies, no cookies to babysit: one key with free credits every month, and it works in Claude Code, Codex, OpenCode and Cursor. Always open source, forever."],
readme:["from the repo","You already run Crawl4AI. Now let it run for you.","The same crawler you starred, hosted: no browsers, no proxies, no cookies to babysit. One key with free credits every month, and your agent is on the web. The library stays open source, forever."],
gh:["from GitHub","You already run Crawl4AI. Now let it run for you.","The same crawler you starred, hosted: no browsers, no proxies, no cookies to babysit. One key with free credits every month, and your agent is on the web. The library stays open source, forever."],
pip:["from pip","You just installed Crawl4AI. This is the hosted one.","Same engine, no browsers to run and no proxies to buy. One key with free credits every month, and it works in Claude Code, Codex, OpenCode and Cursor. The library stays open source, forever."],
discord:["from Discord","Hello from the community. Crawl4AI Cloud is live.","The same crawler, hosted: no browsers, no proxies, no cookies to babysit. One key with free credits every month, and your agent is on the web. The library stays open source, forever."],
x:["from X","Crawl4AI Cloud is live.","The open-source crawler with 82k stars, hosted: no browsers, no proxies, no cookies to babysit. One key with free credits every month, and your agent is on the web."]};
