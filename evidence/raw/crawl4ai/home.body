<div id="toast" role="status" aria-live="polite"></div>
<script>
/* ---------- device fingerprint: window.c4fp() -> 16 hex characters, or "" ----------
   A 64-bit FNV-1a hash of stable device traits (screen, timezone, languages, platform, cores,
   memory, a canvas drawing, the WebGL renderer, five font widths). Our own code, no network call.
   Kept in memory only, never in localStorage or a cookie. "" under Do Not Track or Global Privacy
   Control, the same rule as the beacon's anonymous id. Each trait is read in its own try, so the
   function never throws. It is computed once, in idle time after load or at the first call. */
(function(){
  var cached=null;
  function isTrackingRefused(){try{return navigator.doNotTrack=="1"||navigator.doNotTrack=="yes"||!!(navigator.globalPrivacyControl||window.globalPrivacyControl);}catch(e){return true;}}
  /** Reads one trait; a trait the browser refuses becomes "". */
  function read(f){try{var v=f();return v==null?"":String(v);}catch(e){return "";}}
  /** 64-bit FNV-1a over the UTF-16 code units, done in four 16-bit parts (old Safari has no BigInt).
      The prime 0x100000001b3 is 2^40 + 0x1b3, so the multiply is h*0x1b3 plus h shifted 40 bits. */
  function fnv1a64(s){
    var h0=0x2325,h1=0x8422,h2=0x9ce4,h3=0xcbf2; /* offset basis 0xcbf29ce484222325, low part first */
    function eat(b){
      h0^=b;
      var t0=h0*0x1b3,t1=h1*0x1b3,t2=h2*0x1b3+h0*0x100,t3=h3*0x1b3+h1*0x100;
      t1+=t0>>>16;h0=t0&0xffff;t2+=t1>>>16;h1=t1&0xffff;t3+=t2>>>16;h2=t2&0xffff;h3=t3&0xffff;
    }
    for(var i=0;i<s.length;i++){var c=s.charCodeAt(i);eat(c&0xff);if(c>0xff)eat(c>>>8);}
    function hex(x){return ("000"+x.toString(16)).slice(-4);}
    return hex(h3)+hex(h2)+hex(h1)+hex(h0);
  }
  /** Collects the traits, one per line, and hashes them. */
  function compute(){
    var s=screen,n=navigator,traits=[
      read(function(){return s.width+"x"+s.height+"x"+s.colorDepth;}),
      read(function(){return window.devicePixelRatio;}),
      read(function(){return Intl.DateTimeFormat().resolvedOptions().timeZone;}),
      read(function(){return (n.languages||[n.language]).join(",");}),
      read(function(){return n.platform;}),
      read(function(){return n.hardwareConcurrency;}),
      read(function(){return n.deviceMemory;}),
      read(function(){ /* the same text and shapes render to slightly different pixels per GPU, driver and font stack */
        var c=document.createElement("canvas");c.width=220;c.height=30;var x=c.getContext("2d");
        x.textBaseline="top";x.font="14px Arial";x.fillStyle="#f60";x.fillRect(120,1,60,20);
        x.fillStyle="#069";x.fillText("Crawl4AI fp é中",2,15);x.fillStyle="rgba(102,204,0,0.7)";x.fillText("Crawl4AI fp",4,17);
        return c.toDataURL();
      }),
      read(function(){
        var g=document.createElement("canvas").getContext("webgl")||document.createElement("canvas").getContext("experimental-webgl");
        var d=g&&g.getExtension("WEBGL_debug_renderer_info");return d?g.getParameter(d.UNMASKED_RENDERER_WEBGL):"";
      }),
      read(function(){ /* width of one string in five fonts; a font that is not installed falls back to monospace */
        var x=document.createElement("canvas").getContext("2d");
        return ["Segoe UI","Helvetica Neue","Ubuntu","Roboto","Menlo"].map(function(f){
          x.font="16px '"+f+"',monospace";return Math.round(x.measureText("mmmmmmmmmmlli10WQ").width*10);}).join(",");
      })
    ];
    return fnv1a64(traits.join("\n"));
  }
  window.c4fp=function(){
    if(isTrackingRefused())return "";
    if(cached===null){try{cached=compute();}catch(e){cached="";}}
    return cached;
  };
  /* compute ahead in idle time, so a click never waits for the canvas and WebGL reads */
  if(!isTrackingRefused()){
    var warm=function(){window.c4fp();};
    addEventListener("load",function(){if(window.requestIdleCallback)requestIdleCallback(warm,{timeout:3000});else setTimeout(warm,1500);});
  }
})();
</script>
<script>
/* ---- first-party beacon (telemetry plan P1): batches to ONE sendBeacon on page-leave;
   anon id only; honors DNT/GPC; fail-open - analytics must never break the page ---- */
(function(){
"use strict";
try{
  if(navigator.doNotTrack=="1"||navigator.doNotTrack=="yes"||navigator.globalPrivacyControl||window.globalPrivacyControl){window.c4t=function(){};return;}
  /* a link from the docs banner carries that page's anonymous id (aid): a browser with no id of its own adopts it,
     so the banner click and this visit are one visitor; a browser that has one sends the docs id on the pageview instead */
  var da=(location.search.match(/[?&]aid=([a-f0-9]{16})/)||[])[1]||"";
  var a;try{a=localStorage.getItem("c4a");if(!a){a=da||Array.from(crypto.getRandomValues(new Uint8Array(8))).map(function(b){return b.toString(16).padStart(2,"0");}).join("");localStorage.setItem("c4a",a);}}catch(e){a=Math.random().toString(16).slice(2,18);}
  var q=[];
  function flush(){
    // Loop so a page that queued >25 events flushes ALL of them (one splice dropped the tail).
    while(q.length){
      var body=JSON.stringify({a:a,e:q.splice(0,25),now:Date.now()}); /* now + each t: the server works out the real click time */
      if(navigator.sendBeacon){navigator.sendBeacon("/v1/t",new Blob([body],{type:"application/json"}));}
      else{try{fetch("/v1/t",{method:"POST",headers:{"content-type":"application/json"},body:body,keepalive:true});}catch(e){break;}}
    }
  }
  // Tag every event with its page so the funnel can separate landing prospects from dashboard
  // (already-converted) users — same anon id + origin on both pages otherwise mixes them.
  window.c4t=function(n,p){p=p||{};p.pg="landing";q.push({n:n,p:p,t:Date.now()});if(q.length>=20)flush();};
  addEventListener("pagehide",flush);
  document.addEventListener("visibilitychange",function(){if(document.visibilityState==="hidden")flush();});
  c4t("pageview",{path:location.pathname,ref:(document.referrer.split("/")[2]||""),w:innerWidth,
    src:(document.cookie.match(/(?:^|;\s*)c4_src=([^;]*)/)||[])[1]||"",daid:(da&&da!==a)?da:"",
    th:document.documentElement.getAttribute("data-theme")||"dark"});
  if(new URLSearchParams(location.search).get("verified"))c4t("verified_landing",{});
  /* scroll depth: passive, one event per bucket per visit */
  var seen={};
  addEventListener("scroll",function(){
    var h=document.documentElement,d=Math.round(100*(h.scrollTop+innerHeight)/h.scrollHeight);
    [25,50,75,100].forEach(function(m){if(d>=m&&!seen[m]){seen[m]=1;c4t("scroll_depth",{d:String(m)});}});
  },{passive:true});
  /* sections: seen once each at 40% visible */
  if("IntersectionObserver" in window){
    var io=new IntersectionObserver(function(es){es.forEach(function(en){
      if(en.isIntersecting){c4t("section_seen",{s:en.target.id});io.unobserve(en.target);}});},{threshold:.4});
    ["playground","features","agents","self-host","pricing","philosophy"].forEach(function(id){
      var el=document.getElementById(id);if(el)io.observe(el);});
  }
  /* delegated CTA clicks - passive capture, never blocks the real handler */
  document.addEventListener("click",function(e){
    var t=e.target.closest("[data-key],[data-run],[data-copycmd],[data-tokreveal],.tabbar a,.starbtn,[data-estimate]");
    if(!t)return;
    var id=t.getAttribute("data-nav")||(t.hasAttribute("data-key")?"get_key":t.hasAttribute("data-run")?"run":t.hasAttribute("data-estimate")?"estimate"
      :t.hasAttribute("data-copycmd")?"copy_cmd":t.hasAttribute("data-tokreveal")?"reveal_key"
      :((""+t.className).indexOf("starbtn")>-1?"star":"cta"));
    c4t("cta_click",{id:id});
  },true);
}catch(e){window.c4t=window.c4t||function(){};}
})();
</script>
<script>
(function(){
  "use strict";
  var reduce=matchMedia("(prefers-reduced-motion:reduce)").matches,cur="scrape",keyRevealed=false;
  var DEFAULT_INSTR="the key fields on this page";
  function instr(){var I=document.querySelector("[data-instr]");var x=I&&I.value.trim();return x||DEFAULT_INSTR;}

/* key-pass.js - shared by every page that runs on the visitor's key: the key store
   (signed-in session first, else the 7-day pass in localStorage), toast/copy helpers, and the
   mint popup. A page provides three hooks, all optional: onKeyChange() (repaint commands),
   copyCommandWith(key) (what to copy when the popup was opened by a Copy), runNow() (the
   pending run after minting). The pending* flags below are the page's to set before openPop(). */
  var pendingRun=false,pendingCopy=false,pendingTmpl=null;
  var SYNC_GRACE=180e3; /* a fresh key can take ~1 min to reach every region's gate */
  /* ---------- pass key (signed-in session first, else the 7-day pass in localStorage) ---------- */
  var sessionKey=null; /* set at boot from /v1/me when a session cookie is live */
  var passMem=null;    /* in-memory fallback: private-mode / locked-down browsers throw on setItem;
                          the key must still work for THIS session even if it can't be persisted */
  function loadKey(){
    try{var s=JSON.parse(localStorage.getItem("c4pass"));if(s&&s.k&&Date.now()<s.exp)return s;}catch(e){}
    if(passMem&&Date.now()<passMem.exp)return passMem;
    return null;
  }
  function saveKey(k,hours){
    var rec={k:k,exp:Date.now()+(hours||168)*36e5,t:Date.now()};
    passMem=rec;
    try{localStorage.setItem("c4pass",JSON.stringify(rec));}catch(e){} /* persistence is best-effort */
  }
  function keyIsYoung(){if(sessionKey)return false;var s=loadKey();return !!(s&&s.t&&Date.now()-s.t<SYNC_GRACE);}
  function dropKey(){sessionKey=null;passMem=null;try{localStorage.removeItem("c4pass");}catch(e){}}
  function tk(){if(sessionKey)return sessionKey;var s=loadKey();return s?s.k:"sk_live_•••••••••••";}
  function hasKey(){return !!(sessionKey||loadKey());}
  /* the key is long and clutters the command - show it MASKED (prefix…suffix); the eye/tap reveals + copies the full one */
  function maskKey(k){return (k&&k.length>=16)?(k.slice(0,12)+"…"+k.slice(-4)):"sk_live_…";}
  function esc(s){return String(s).replace(/[<>&"]/g,function(c){return {'<':'&lt;','>':'&gt;','&':'&amp;','"':'&quot;'}[c];});}
  function toast(h){var t=document.getElementById("toast");t.innerHTML=h;t.classList.add("show");clearTimeout(t._h);t._h=setTimeout(function(){t.classList.remove("show");},2600);}
  function cp(x){if(navigator.clipboard)navigator.clipboard.writeText(x).catch(function(){});}
  function cpT(x,okHtml){
    if(!navigator.clipboard){toast("Copy blocked - select it manually");return;}
    navigator.clipboard.writeText(x).then(function(){toast(okHtml);})
      .catch(function(){toast("Copy blocked by the browser - select it manually");});
  }
  /* ---------- mint popup: email -> your key ---------- */
  var POP=document.getElementById("mintpop"),CARD=document.querySelector("[data-mintcard]");
  function refreshKeyUI(){document.querySelectorAll("[data-kt]").forEach(function(e){e.textContent=hasKey()?maskKey(tk()):"sk_live_…";});if(typeof onKeyChange==="function")onKeyChange();}
  function closePop(){
    POP.classList.remove("open");
    pendingRun=false;pendingCopy=false;pendingTmpl=null; /* a dismissed popup must not leave a surprise armed */
  }
  POP.addEventListener("click",function(e){if(e.target===POP)closePop();});
  document.addEventListener("keydown",function(e){if(e.key==="Escape")closePop();});
  function openPop(){
    if(hasKey()){cpT(tk(),"Key <b>copied</b>");return;}
    if(window.c4t)c4t("mint_open",{});
    CARD.innerHTML='<button class="mintx" data-x aria-label="close">✕</button>'
      +'<p class="mt"># Your API key</p>'
      +'<p class="mb">Drop your email and the key appears <b>right here</b> (your inbox gets a copy). It starts as a 7-day pass - <b>verify the email and it\'s yours for good</b>, free.</p>'
      +'<p class="mseats" data-mseats style="display:none"></p>'
      +'<div class="mintform"><input type="email" data-email placeholder="you@work.email" autocomplete="email" inputmode="email" autocapitalize="none" autocorrect="off" spellcheck="false" aria-label="email for your key"><button data-mint>Mint my key</button></div>'
      +'<p style="font-size:11.5px;color:var(--muted);margin:8px 0 0">By continuing you agree to our <a href="/legal/#terms" style="color:var(--cyan)">Terms</a> &amp; <a href="/legal/#privacy" style="color:var(--cyan)">Privacy</a>.</p>';
    CARD.querySelector("[data-x]").addEventListener("click",closePop);
    if(typeof paintSeats==="function")paintSeats();   /* fill the seats line if we already know the count */
    var E=CARD.querySelector("[data-email]"),B=CARD.querySelector("[data-mint]");
    function showErr(html){
      var el=CARD.querySelector(".minterr");
      if(!el){el=document.createElement("p");el.className="minterr";CARD.appendChild(el);}
      el.innerHTML="# "+html;
    }
    /* the beacon's anonymous visitor id, so the account links to the visit that led to it; none under
       Do Not Track or Global Privacy Control, the same rule as the beacon */
    function visitorId(){try{if(navigator.doNotTrack=="1"||navigator.doNotTrack=="yes"||navigator.globalPrivacyControl||window.globalPrivacyControl)return "";return localStorage.getItem("c4a")||"";}catch(e){return "";}}
    function mint(){
      if(B.disabled)return; /* Enter pressed twice fast must not fire two mints */
      var em=E.value.trim();
      if(!/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(em)){showErr("That email doesn't look right");E.focus();return;}
      B.disabled=true;B.textContent="Minting…";
      fetch("/v1/signup/token",{method:"POST",headers:{"content-type":"application/json"},body:JSON.stringify({email:em,a:visitorId(),fp:window.c4fp?c4fp():""})})
        .then(function(r){return r.json().then(function(j){return {s:r.status,j:j};}).catch(function(){return {s:r.status,j:null};});})
        .then(function(x){
          if(x.j===null){ /* server returned non-JSON (e.g. a 5xx/gateway page) - honest status, not "network" */
            showErr(x.s>=500?"the sign-up service hiccuped ("+x.s+") - try again in a moment":"couldn't read the response ("+x.s+")");
            B.disabled=false;B.textContent="Mint my key";return;
          }
          if(x.s===403&&x.j.error==="closed"){ /* sign-ups closed until launch: say so, no retry */
            showErr(x.j.note||"Sign-ups open at launch.");
            B.disabled=true;B.textContent="Closed until launch";return;
          }
          if(x.s===200&&x.j.sent){ /* an address that already has a key: it went to the inbox, never to the page */
            CARD.innerHTML='<button class="mintx" data-x aria-label="close">✕</button>'
              +'<p class="mt"># This email already has a key</p>'
              +'<p class="mb">We sent it to <b>'+esc(x.j.inbox_hint||"that inbox")+'</b>, with the link to verify. Check your mail, then paste the key here.</p>'
              +'<button class="mintdone" data-done>OK</button>';
            CARD.querySelector("[data-done]").addEventListener("click",closePop);
            CARD.querySelector("[data-x]").addEventListener("click",closePop);
          }else if(x.s===200&&x.j.api_key){
            if(window.c4t)c4t("mint_done",{fp:window.c4fp?c4fp():""});
            saveKey(x.j.api_key,x.j.expires_in_hours);refreshKeyUI();
            var copied;
            if(pendingCopy){pendingCopy=false;cp(typeof copyCommandWith==="function"?copyCommandWith(x.j.api_key):x.j.api_key);copied="Full command copied - paste it in your terminal";}
            else if(pendingTmpl){cp(pendingTmpl.replace(/TOKEN/g,x.j.api_key));pendingTmpl=null;copied="Command copied with your new key";}
            else{cp(x.j.api_key);copied="Copied, and in your inbox";}
            var days=Math.max(1,Math.round((x.j.expires_in_hours||168)/24));
            /* ONE copy for every case (new / existing) so the popup - like the API
               response - never reveals whether this email already had an account */
            var claim='This key lasts <b>'+days+' days</b>. <b>New here?</b> Check your inbox for a link to verify - that keeps it for good, free, and opens your <a href="/dashboard/">console</a>.';
            CARD.innerHTML='<p class="mt"># here\'s your key <span style="color:var(--dim)">('+copied+')</span></p>'
              +'<code class="mintkey" data-ckey title="click to copy">'+esc(x.j.api_key)+'</code>'
              +'<div class="mintkeyrow"><button data-ckey>Copy key</button></div>'
              +'<p class="mb">'+claim+' (The key can take ~a minute to reach your nearest edge.)</p>'
              +'<button class="mintdone" data-done>OK, done'+(pendingRun?' - run it ▶':'')+'</button>';
            CARD.querySelector("[data-done]").addEventListener("click",function(){
              var willRun=pendingRun; /* closePop() clears pendingRun - capture it first */
              closePop();
              if(willRun&&typeof runNow==="function")runNow();
            });
            CARD.querySelectorAll("[data-ckey]").forEach(function(el){el.addEventListener("click",function(){cp(x.j.api_key);toast("Key <b>copied</b>");});});
          }else if(x.s===409){
            CARD.innerHTML='<button class="mintx" data-x aria-label="close">✕</button>'
              +'<p class="mt"># That email may already have an account</p>'
              +'<p class="mb">If it\'s yours, we can <b>email you your key</b>, or <b>sign in</b> and see it in the dashboard. Otherwise try another email.</p>'
              +'<div class="mintalt"><button data-resend style="color:var(--on);background:var(--cyan);border:0;font-weight:600">Email me my key</button><a href="/v1/auth/github/start">Sign in with GitHub</a><a href="/v1/auth/google/start">With Google</a><button data-retry>Try another email</button></div>';
            CARD.querySelector("[data-x]").addEventListener("click",closePop);
            CARD.querySelector("[data-retry]").addEventListener("click",function(){closePop();openPop();});
            CARD.querySelector("[data-resend]").addEventListener("click",function(){
              var rb=CARD.querySelector("[data-resend]");rb.disabled=true;rb.textContent="Sending…";
              fetch("/v1/signup/token",{method:"POST",headers:{"content-type":"application/json"},body:JSON.stringify({email:em,resend:true})})
                .then(function(r){return r.json();})
                .then(function(j){
                  CARD.innerHTML='<p class="mt"># on its way</p>'
                    +'<p class="mb">'+esc(j.note||"If that email has an account, its key is on the way - check the inbox.")+' The mail has your key ready to copy'
                    +' (and the verify link if you haven\'t verified yet).</p>'
                    +'<button class="mintdone" data-done>ok</button>';
                  CARD.querySelector("[data-done]").addEventListener("click",closePop);
                })
                .catch(function(){rb.disabled=false;rb.textContent="Email me my key";toast("Network hiccup - try again");});
            });
          }else{
            showErr(esc((x.j&&(x.j.error||x.j.note))||"Couldn't mint a key - try again in a bit"));
            B.disabled=false;B.textContent="Mint my key";
          }
        })
        .catch(function(){showErr("Network hiccup - try again");B.disabled=false;B.textContent="Mint my key";});
    }
    B.addEventListener("click",mint);
    E.addEventListener("keydown",function(e){if(e.key==="Enter"){e.preventDefault();mint();}});
    POP.classList.add("open");
    try{E.focus({preventScroll:true});}catch(e){E.focus();}
  }
  function keyAction(e){e.preventDefault();openPop();}
  function wireKeyButtons(scope){(scope||document).querySelectorAll("[data-key]").forEach(function(b){b.addEventListener("click",keyAction);});}
  wireKeyButtons();

  /* normalize like Run does, so display/copy/run NEVER disagree */
  /* the tabs that take a query, not a URL */
  function isQueryTab(tab){return tab==="search"||tab==="answer"||tab==="serp";}
  function normUrl(tab,v){return isQueryTab(tab)?v:(/^https?:\/\//i.test(v)?v:"https://"+v);}
  /* single-quote-safe for pasting into a shell: ' -> '\'' */
  function shq(x){return x.replace(/'/g,"'\\''");}
  function payload(obj){return shq(JSON.stringify(obj));}
  function host(u){return u.replace(/^https?:\/\//,'').replace(/\/.*$/,'');}

  /* ---------- tabs ---------- */
  /* on phones, break each -H onto its own indented line so the wrapped command
     reads as clean multi-line instead of a second header spilling mid-line */
  function hbrk(){return matchMedia("(max-width:680px)").matches?' \\\n    ':' ';}
  var TAB={
    scrape:{m:"POST",p:"/scrape",verb:"scrape",ph:"https://a-url-to-crawl.com",def:"https://news.ycombinator.com",
      cmd:function(t,v){return '<span class="p">$</span> curl -s api.crawl4ai.com<span class="fl">/scrape</span> \\\n    -H <span class="str">"Authorization: Bearer </span>'+t+'<span class="str">"</span>'+hbrk()+'-H <span class="str">"Content-Type: application/json"</span> \\\n    -d <span class="str">\''+esc(payload({url:normUrl("scrape",v)}))+'\'</span>';},
      copy:function(t,v){return 'curl -s https://api.crawl4ai.com/scrape -H "Authorization: Bearer '+t+'" -H "Content-Type: application/json" -d \''+payload({url:normUrl("scrape",v)})+'\'';}},
    extract:{m:"POST",p:"/extract",verb:"extract",ph:"https://a-url-to-extract-from.com",def:"https://news.ycombinator.com",
      cmd:function(t,v){return '<span class="p">$</span> curl -s api.crawl4ai.com<span class="fl">/extract</span> \\\n    -H <span class="str">"Authorization: Bearer </span>'+t+'<span class="str">"</span>'+hbrk()+'-H <span class="str">"Content-Type: application/json"</span> \\\n    -d <span class="str">\''+esc(payload({url:normUrl("extract",v),instruction:instr()}))+'\'</span>';},
      copy:function(t,v){return 'curl -s https://api.crawl4ai.com/extract -H "Authorization: Bearer '+t+'" -H "Content-Type: application/json" -d \''+payload({url:normUrl("extract",v),instruction:instr()})+'\'';}},
    search:{m:"GET",p:"/search",verb:"search",ph:"your search query",def:"rust web crawler",
      cmd:function(t,v){return '<span class="p">$</span> curl -s <span class="str">"api.crawl4ai.com<span class="fl">/search</span>?q='+esc(v).replace(/ /g,'+')+'"</span> \\\n    -H <span class="str">"Authorization: Bearer </span>'+t+'<span class="str">"</span>';},
      copy:function(t,v){return 'curl -s "https://api.crawl4ai.com/search?q='+encodeURIComponent(v)+'" -H "Authorization: Bearer '+t+'"';}},
    serp:{m:"GET",p:"/serp",verb:"serp",ph:"a query to rank-track",def:"best crm software",
      cmd:function(t,v){return '<span class="p">$</span> curl -s <span class="str">"api.crawl4ai.com<span class="fl">/serp</span>?q='+esc(v).replace(/ /g,'+')+'<span class="fl">&amp;country=us</span>"</span> \\\n    -H <span class="str">"Authorization: Bearer </span>'+t+'<span class="str">"</span>';},
      copy:function(t,v){return 'curl -s "https://api.crawl4ai.com/serp?q='+encodeURIComponent(v)+'&country=us" -H "Authorization: Bearer '+t+'"';}},
    answer:{m:"GET",p:"/answer",verb:"answer",ph:"ask a question",def:"why is the sky blue",
      cmd:function(t,v){return '<span class="p">$</span> curl -s <span class="str">"api.crawl4ai.com<span class="fl">/answer</span>?q='+esc(v).replace(/ /g,'+')+'<span class="fl">'+esc(deepParam())+'</span>"</span> \\\n    -H <span class="str">"Authorization: Bearer </span>'+t+'<span class="str">"</span>';},
      copy:function(t,v){return 'curl -s "https://api.crawl4ai.com/answer?q='+encodeURIComponent(v)+deepParam()+'" -H "Authorization: Bearer '+t+'"';}}};

  var C=document.querySelector("[data-cmd]"),O=document.querySelector("[data-out]"),M=document.querySelector("[data-method]"),P=document.querySelector("[data-path]"),K=document.querySelector("[data-ok]"),VB=document.querySelector("[data-verb]"),T=document.querySelector("[data-target]");
  var EYE='<svg viewBox="0 0 24 24" width="12" height="12" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M1 12s4-7 11-7 11 7 11 7-4 7-11 7S1 12 1 12z"/><circle cx="12" cy="12" r="3"/></svg>';
  function tokH(){
    if(!hasKey())
      return '<span class="tok tokbtn" data-reveal title="get your key" role="button" tabindex="0">sk_live_••••••••••• '+EYE+'</span>';
    return keyRevealed
      ?'<span class="tok tokbtn" data-tokcopy title="your key - click to copy" role="button" tabindex="0">'+esc(tk())+'</span>'
      :'<span class="tok tokbtn" data-tokreveal title="tap to reveal + copy your key" role="button" tabindex="0">'+esc(maskKey(tk()))+' '+EYE+'</span>';
  }
  function val(){return (T.value.trim()||TAB[cur].def);}
  /* public deep toggle (answer tab): deep=1 (Google's answer else crawl+generate) / deep=0 (Google's answer only). Default on. */
  function deepParam(){if(cur!=="answer")return "";var c=document.querySelector("[data-deep]");return (c&&!c.checked)?"&deep=0":"&deep=1";}
  function rd(){C.innerHTML=TAB[cur].cmd(tokH(),val());}
  function onKeyChange(){rd();}                              /* key-pass.js hook */
  function copyCommandWith(k){return TAB[cur].copy(k,val());} /* key-pass.js hook */
  function tokAct(e){
    if(e.target.closest("[data-reveal]")){openPop();}
    else if(e.target.closest("[data-tokreveal]")){keyRevealed=true;rd();cpT(tk(),"Key <b>revealed + copied</b>");}
    else if(e.target.closest("[data-tokcopy]")){cpT(tk(),"Key <b>copied</b>");}
  }
  C.addEventListener("click",tokAct);
  C.addEventListener("keydown",function(e){
    if((e.key==="Enter"||e.key===" ")&&e.target.closest(".tokbtn")){e.preventDefault();tokAct(e);}
  });
  function pick(n){cur=n;document.querySelectorAll(".ft").forEach(function(t){t.setAttribute("aria-selected",String(t.dataset.tab===n));});
    M.textContent=TAB[n].m;P.textContent=TAB[n].p;VB.textContent=TAB[n].verb;T.placeholder=TAB[n].ph;T.value=TAB[n].def;rd();
    O.innerHTML='<span class="ph"># Hit Run to '+n+' - real output renders here</span>';K.classList.remove("show");}
  document.querySelectorAll(".ft").forEach(function(t){t.addEventListener("click",function(){pick(t.dataset.tab);});});
  T.addEventListener("input",rd);
  (function(){var DC=document.querySelector("[data-deep]");if(DC)DC.addEventListener("change",rd);})(); /* deep toggle updates the curl preview live */
  var EGS={
    scrape:[{u:"news.ycombinator.com"},{u:"github.com/trending"},{u:"en.wikipedia.org/wiki/Web_scraping"}],
    extract:[
      {u:"news.ycombinator.com",i:"the top story titles and their points"},
      {u:"books.toscrape.com",i:"each book title and its price"},
      {u:"github.com/trending",i:"the trending repo names and star counts"}
    ],
    search:[{u:"rust web crawler"},{u:"llm agents framework"},{u:"open source vector databases"}],
    answer:[{u:"why is the sky blue"},{u:"how do vaccines work"},{u:"best beaches in bali with no waves"}],
    serp:[{u:"best crm software"},{u:"plumber austin tx"},{u:"rust vs go"}]
  };
  function paintEgs(n){
    var el=document.querySelector("[data-egs]");if(!el)return;
    var II=document.querySelector("[data-instr]");
    el.innerHTML=EGS[n].map(function(x,i){return '<button type="button" class="'+(i===0?"on":"")+'" title="try this one">'+esc(x.u)+'</button>';}).join("");
    el.querySelectorAll("button").forEach(function(b,i){b.addEventListener("click",function(){
      var eg=EGS[n][i];
      T.value=eg.u;
      if(II&&eg.i)II.value=eg.i; /* extract: fill a matching instruction so one click = ready to Run */
      el.querySelectorAll("button").forEach(function(x){x.classList.remove("on");});
      b.classList.add("on"); /* the picked example is the lit one */
      rd();T.focus();
    });});
  }
  (function(){var IR=document.querySelector("[data-instrrow]"),II=document.querySelector("[data-instr]");
    if(II){II.addEventListener("input",rd);II.addEventListener("keydown",function(e){if(e.key==="Enter"){e.preventDefault();runNow();}});}
    var _pick=pick;pick=function(n){
      _pick(n);
      if(IR)IR.classList.toggle("on",n==="extract");
      var DR=document.querySelector("[data-deeprow]");if(DR)DR.classList.toggle("on",n==="answer");
      /* extract needs a URL AND an instruction to run - prefill one that matches the
         default URL (news.ycombinator.com) so the tab lands ready, not half-empty */
      if(n==="extract"&&II&&!II.value.trim()){II.value="the top story titles and their points";rd();}
      paintEgs(n);
    };})();
  T.addEventListener("keydown",function(e){if(e.key==="Enter"){e.preventDefault();runNow();}});



  document.querySelector("[data-copycmd]").addEventListener("click",function(){
    if(!hasKey()){pendingCopy=true;openPop();return;}
    cpT(TAB[cur].copy(tk(),val()),"Command <b>copied</b> - paste it in your terminal");
  });
  document.querySelectorAll("[data-copy]").forEach(function(b){b.addEventListener("click",function(){cp(b.getAttribute("data-copy"));var o=b.textContent;b.textContent="Copied";setTimeout(function(){b.textContent=o;},1200);});});
  document.querySelectorAll("[data-tmpl]").forEach(function(b){b.addEventListener("click",function(){
    if(!hasKey()){pendingTmpl=b.getAttribute("data-tmpl");openPop();return;}
    cp(b.getAttribute("data-tmpl").replace(/TOKEN/g,tk()));
    var o=b.textContent;b.textContent="Copied";setTimeout(function(){b.textContent=o;},1200);
    var blk=b.closest("[data-agent-block]");c4t("agent_copy",{client:blk?blk.getAttribute("data-agent-block"):(b.closest("[data-setup]")?"setup":"env")});
  });});
  /* the credit numbers: one object at the top of #pricing fills every span */
  (function(){
    /* fill every [data-credit] from C: "monthly" = credits, "monthly$" = dollars, "plans.starter.usd" = a plan's number,
       "limits.starter.concurrent" = a path, "monthSearches"/"monthPages" = what the free month buys,
       "costPage"/"costSearch"/... = credits per request from the live price table (only once it has arrived) */
    function fill(C){
      var usd=C.usd||0.001, n=function(x){return Math.round(x).toLocaleString();};
      var derived={monthSearches:C.search?C.monthly/C.search:null, monthPages:C.scrape?C.monthly/C.scrape:null};
      /* the cost line: scrape base x the effort level's multiplier; the fallback object has no levels, so the
         placeholder text stays until /v1/prices answers. toFixed(3) drops float noise (0.2*3 = 0.6000000000000001) */
      if(C.levels){
        var mult=function(name){var l=C.levels.filter(function(x){return x.name===name;})[0];return l&&C.scrape!=null?+(C.scrape*l.mult).toFixed(3):null;};
        derived.costPage=mult("light"); derived.costArchive=mult("instant"); derived.costBrowser=mult("heavy"); derived.costHard=mult("hard");
        derived.costSearch=C.search;
        /* the comparison: per 1,000 calls at the Starter plan's own credit price */
        var st=C.plans&&C.plans.starter;
        if(st&&st.credits&&st.usd){var per=st.usd/st.credits*1000;
          derived.cmpPage=derived.costPage*per; derived.cmpBrowser=derived.costBrowser*per; derived.cmpHard=derived.costHard*per; derived.cmpSearch=C.search*per;
          derived.cmpStarterPages=derived.costPage?st.credits/derived.costPage:null;}
      }
      /* a [data-if] line shows only while its fact holds: today only a monthly credit */
      var show={monthly:C.monthly>0};
      document.querySelectorAll("[data-if]").forEach(function(el){el.hidden=!show[el.getAttribute("data-if")];});
      document.querySelectorAll("[data-credit]").forEach(function(el){
        var k=el.getAttribute("data-credit"),v=null,m;
        if((m=k.match(/^(\w+)\$$/)))v=C[m[1]]!=null?+(C[m[1]]*usd).toFixed(2):null;
        else if(k.indexOf(".")>0)v=k.split(".").reduce(function(o,p){return o&&o[p];},C);
        else v=k in derived?derived[k]:C[k];
        if(v!=null&&isFinite(v))el.textContent=el.hasAttribute("data-money")?(+v).toFixed(2):v%1===0?n(v):String(v);
      });
    }
    /* the plan prices for the chosen billing: yearly (the default) shows the price a month, a twelfth of the
       yearly price, and the yearly total under it; monthly shows the monthly price. A plan with no yearly
       price shows its monthly price in both. */
    var billing="year";
    function money(x){return x%1===0?String(x):x.toFixed(2);}
    function drawBilling(){
      var plans=(window.CREDIT||{}).plans||{};
      document.querySelectorAll("[data-bill]").forEach(function(b){b.classList.toggle("on",b.getAttribute("data-bill")===billing);});
      document.querySelectorAll("[data-plan-amt]").forEach(function(el){
        var p=plans[el.getAttribute("data-plan-amt")];if(!p||!p.usd)return;
        var yearly=billing==="year"&&p.usd_year>0;
        el.innerHTML=yearly?'$'+money(Math.round(p.usd_year/12*100)/100)+'<small> a month</small><span class="billed">billed $'+p.usd_year.toLocaleString()+' a year</span>'
                           :'$'+p.usd+'<small> a month</small>';
      });
    }
    document.querySelectorAll("[data-bill]").forEach(function(b){b.addEventListener("click",function(){billing=b.getAttribute("data-bill");drawBilling();});});
    /* Start carries the chosen billing to the dashboard's plans (?bill=month; yearly is its default too) */
    document.querySelectorAll("[data-start-link]").forEach(function(a){a.addEventListener("click",function(){a.href="/dashboard/"+(billing==="month"?"?bill=month":"")+"#billing";});});
    fill(window.CREDIT||{});drawBilling();
    fetch("/v1/prices").then(function(r){return r.ok?r.json():null;}).then(function(P){
      if(!P||!P.credit)return;
      /* keep the live numbers on window.CREDIT too: the playground's out-of-credit message reads them */
      window.CREDIT={monthly:+P.credit.monthly, guest:+P.credit.guest, usd:P.usd_per_credit,
            search:+(P.base||{}).search, scrape:+(P.base||{}).scrape,
            plans:(P.plans||[]).reduce(function(o,p){o[p.name]=p;return o;},{}), limits:P.limits||{}, levels:P.levels||[]};
      fill(window.CREDIT);drawBilling();
    }).catch(function(){});
  })();
  /* the client picker: only changes which paste block shows (a page cannot install anything) */
  document.querySelectorAll("[data-agent]").forEach(function(b){b.addEventListener("click",function(){
    var c=b.getAttribute("data-agent");
    document.querySelectorAll("[data-agent]").forEach(function(x){x.setAttribute("aria-selected",x===b);});
    document.querySelectorAll("[data-agent-block]").forEach(function(x){x.hidden=x.getAttribute("data-agent-block")!==c;});
    c4t("client_picked",{client:c});
  });});
  /* ---------- Enterprise contact form (#4): saves the lead + emails the team ---------- */
  var ENTPOP=document.getElementById("entpop"),ENTCARD=document.querySelector("[data-entcard]");
  function closeEnt(){ENTPOP.classList.remove("open");}
  ENTPOP.addEventListener("click",function(e){if(e.target===ENTPOP)closeEnt();});
  document.addEventListener("keydown",function(e){if(e.key==="Escape")closeEnt();});
  function openEnt(){
    ENTCARD.innerHTML='<button class="mintx" data-x aria-label="close">✕</button>'
      +'<p class="mt"># Talk to us about Enterprise</p>'
      +'<p class="mb">Volume, dedicated regions, SLA, private archive. Tell us a little and we\'ll be in touch.</p>'
      +'<div class="entf">'
      +'<input data-f="name" placeholder="Your name" autocomplete="name">'
      +'<input data-f="company" placeholder="Company" autocomplete="organization">'
      +'<input data-f="email" type="email" placeholder="Work email *" autocomplete="email" inputmode="email" autocapitalize="none" autocorrect="off" spellcheck="false">'
      +'<input data-f="volume" placeholder="Expected volume (e.g. 1M pages/mo)">'
      +'<textarea data-f="use_case" placeholder="What are you building?"></textarea>'
      +'<button class="entsend" data-entsend>Send &rarr;</button>'
      +'</div>';
    ENTCARD.querySelector("[data-x]").addEventListener("click",closeEnt);
    var B=ENTCARD.querySelector("[data-entsend]");
    function showErr(m){var el=ENTCARD.querySelector(".enterr");if(!el){el=document.createElement("p");el.className="enterr";ENTCARD.querySelector(".entf").appendChild(el);}el.textContent="# "+m;}
    function val(f){var el=ENTCARD.querySelector('[data-f="'+f+'"]');return el?el.value.trim():"";}
    function send(){
      if(B.disabled)return;
      var email=val("email");
      if(!/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(email)){showErr("Please add a valid work email");return;}
      B.disabled=true;B.textContent="Sending…";
      fetch("/v1/enterprise",{method:"POST",headers:{"content-type":"application/json"},body:JSON.stringify({name:val("name"),company:val("company"),email:email,volume:val("volume"),use_case:val("use_case")})})
        .then(function(r){return r.ok?r.json():r.json().then(function(j){throw new Error((j&&j.error)||"failed");});})
        .then(function(){closeEnt();toast("Thanks — <b>we'll be in touch</b> 💚");})
        .catch(function(e){B.disabled=false;B.textContent="Send →";showErr(e.message||"Network hiccup - try again");});
    }
    B.addEventListener("click",send);
    ENTPOP.classList.add("open");
    var fn=ENTCARD.querySelector('[data-f="name"]');if(fn)fn.focus();
  }
  document.querySelectorAll("[data-entform],[data-contact]").forEach(function(b){b.addEventListener("click",function(e){e.preventDefault();openEnt();});});

  /* ---------- run: the real thing ---------- */
  function fail(status,j){
    var m;
    if(status===402&&j&&j.error==="no_credit"){m='<b>You are out of credits</b> (balance '+esc(j.balance)+'). '+(function(C){var u=C.usd||0.001,go=(j.actions&&j.actions.subscribe)?'<a class="cta" href="'+esc(j.actions.subscribe)+'" target="_blank" rel="noopener">Start a plan →</a>':'<a class="cta" href="/dashboard/#billing">'+((j.actions&&j.actions.extra_credits)?'Add extra credits →':'See the plans →')+'</a>';return go+(C.monthly>0&&!(j.actions&&j.actions.extra_credits)?' Or wait: '+Number(C.monthly).toLocaleString()+' free credits on the 1st, no card.':'');})(window.CREDIT||{});}
    else if(status===402&&j&&j.error==="plan_cap"){m='<b>Your plan\'s monthly allowance is used</b>. '+esc(j.message||"")+' <a class="cta" href="/dashboard/#billing">See the plans →</a>';}
    else if(status===402&&j&&j.error==="spend_cap"){m='<b>Your monthly spend cap is reached</b> ('+esc(j.cap_left)+' left under it). Your balance is fine; only the cap you set stops this run. <a class="cta" href="/dashboard/#billing">Turn it off in Billing →</a> It resets on the 1st.';}
    else if(status===402){dropKey();refreshKeyUI();m='Your 7-day pass expired - <a href="#" data-key>mint a fresh one</a> or verify the email we sent';}
    else if(status===401){
      dropKey();refreshKeyUI();
      /* the key may have been ROTATED by a verify - if this browser is signed
         in, heal from the session ONCE. Guard against a loop: if the healed
         key ALSO 401s we must not re-heal to the same dead key forever. */
      if(!healed){
        healed=true;
        fetch("/v1/me").then(function(r){return r.ok?r.json():null;}).then(function(j){
          var k=null;(j&&j.keys||[]).forEach(function(x){if(x.status==="active"&&x.key)k=x.key;});
          if(k){sessionKey=k;refreshKeyUI();toast("Your key was rotated - picked up the <b>new one</b> from your account");runNow();}
        }).catch(function(){});
      }
      m='That key is no longer valid - <a href="#" data-key>mint a fresh one</a>';
    }
    else if(status===429&&j&&j.actions&&(j.actions.subscribe||j.actions.plans)){m='<b>'+esc(j.message)+'</b> '+(j.actions.subscribe?'<a class="cta" href="'+esc(j.actions.subscribe)+'" target="_blank" rel="noopener">Start a plan →</a> or ':'')+'<a class="cta" href="/dashboard/#billing">see the plans →</a>';}
    else if(status===429){m=(j&&j.message)?esc(j.message):"Rate limited - play keys are tiny on purpose; verify your email for real limits";}
    else{m=esc((j&&(j.error||j.reason))||("request failed ("+status+")"));}
    O.innerHTML='<pre><span class="err"># '+m+'</span></pre>';
    wireKeyButtons(O);
  }
  /* a just-minted key can 401 while it syncs to the nearest region - wait, don't drop it */
  function syncWait(retryFn){
    var s=loadKey(),left=Math.ceil((SYNC_GRACE-(Date.now()-(s&&s.t||0)))/1000);
    if(left<=4){
      O.innerHTML='<pre><span class="err"># The key is taking unusually long to sync - give it a minute, then hit Run again</span></pre>';
      return;
    }
    O.innerHTML='<span class="ph"># Your key is brand new - syncing it to your nearest edge (usually under a minute) <span class="tok">retrying…</span></span>';
    setTimeout(retryFn,4000);
  }
  function render(tab,j,v,totalMs,share){
    lastShare=share||null;
    var head='<span class="s">✓ 200</span> · <span class="n">'+(j.ms||"?")+'ms</span> server · '+Math.round(totalMs)+'ms round trip';
    var body="";
    if(tab==="scrape"){
      var md=j.markdown||"";
      body='<span class="h"># '+esc(host(v))+'</span>\n'+head+' · '+(md.length/1024).toFixed(1)+' KB Markdown · engine: '+esc(j.engine||"auto")+'\n\n'+esc(md.slice(0,1500))+(md.length>1500?"\n<span class=\"ph\">… ("+((md.length-1500)/1024).toFixed(1)+" KB more)</span>":"");
    }else if(tab==="extract"){
      var empty=j.data==null||(Array.isArray(j.data)&&j.data.length===0);
      var data=empty?'<span class="ph"># No records matched - try a more specific instruction</span>':esc(JSON.stringify(j.data,null,1).slice(0,1500))+(JSON.stringify(j.data,null,1).length>1500?"\n<span class=\"ph\">…</span>":"");
      body='<span class="h"># '+esc(host(v))+' → typed JSON</span>\n'+head+' · '+esc(j.model||"llm")+' · '+((j.usage&&j.usage.total_tokens)||0)+' tok\n\n'+data;
    }else if(tab==="answer"){
      var a=j.answer||{};
      if(!j.answered||!a.text){
        body='<span class="h"># "'+esc(v)+'" → answer</span>\n'+head+'\n\n<span class="ph"># '+esc(j.note||"No direct answer yet - try the search tab for links.")+'</span>';
      }else{
        var at=esc(a.text).replace(/\*\*(\S(?:[^*\n]*\S)?)\*\*/g,'<b>$1</b>');
        at=at.split('\n').map(function(L){var mm=L.match(/^\s*[*-]\s+(.*)$/);return mm?'  • '+mm[1]:L;}).join('\n');
        var src=(a.sources||[]).slice(0,3).map(function(x){var u=String(x.url||"");return /^https?:\/\//i.test(u)?'<a class="k" href="'+esc(u)+'" target="_blank" rel="noopener nofollow">'+esc(x.title||host(u))+'</a>':esc(x.title||"");}).filter(Boolean).join(" · ");
        body='<span class="h"># "'+esc(v)+'" → answer</span>\n'+head+' · experimental\n\n'+at+(src?'\n\n<span class="s">sources: '+src+'</span>':'');
      }
    }else{
      var rs=(j.results||[]).slice(0,6).map(function(r,i){
        var url=String(r.url||""),title=esc(r.title||"(untitled)");
        var safe=/^https?:\/\//i.test(url); /* ONLY http(s) becomes a clickable link - never javascript:/data: */
        var head=safe?'<a class="k" href="'+esc(url)+'" target="_blank" rel="noopener nofollow">'+title+'</a>':'<span class="k">'+title+'</span>';
        return (i+1)+'. '+head+'\n   <span class="s">'+esc(url)+'</span>';
      }).join("\n");
      var what=tab==="serp"?'serp (beta) · '+(j.results||[]).length+' results · '+((j.blocks||[]).length)+' blocks':(j.n||0)+' results';
      body='<span class="h"># "'+esc(v)+'" → '+what+'</span>\n'+head+'\n\n'+rs;
    }
    if(window.c4t)c4t("playground_ok",{s:tab,ms:j.ms||0,rtt:Math.round(totalMs)});
    lastOut=tab==="scrape"?(j.markdown||""):tab==="extract"?JSON.stringify(j.data,null,2):tab==="answer"?JSON.stringify({answered:!!j.answered,answer:j.answer||null},null,2):JSON.stringify(j.results||[],null,2);
    O.innerHTML='<pre>'+body+(reduce?'':'<span class="caret"></span>')+'</pre>'
      +'<div class="rr"><button class="cpy" data-copyout>Copy full output</button>'
      +(lastShare?'<button class="cpy" data-share>↗ Share result</button>':'')
      +'</div>';
    K.textContent="✓ 200 OK · "+(j.ms||"?")+"ms";K.classList.add("show");
  }
  var lastOut="",lastShare=null;
  var SHAREPOP=document.getElementById("sharepop"),SHARECARD=document.querySelector("[data-sharecard]");
  function closeShare(){SHAREPOP.classList.remove("open");}
  SHAREPOP.addEventListener("click",function(e){if(e.target===SHAREPOP)closeShare();});
  document.addEventListener("keydown",function(e){if(e.key==="Escape")closeShare();});
  function doShare(){
    if(!lastShare)return;
    var url=location.origin+"/s/"+lastShare, e=encodeURIComponent, txt="I ran this on Crawl4AI Cloud - try it yourself:";
    SHARECARD.innerHTML='<button class="mintx" data-x aria-label="close">✕</button>'
      +'<p class="mt"># Share this result</p>'
      +'<img class="sharethumb" src="/s/'+lastShare+'/card.png" alt="share card preview" loading="lazy">'
      +'<div class="sharerow"><input readonly data-shareurl value="'+url+'"><button class="scopy" data-scopy>Copy</button></div>'
      +'<div class="sharebtns">'
      +'<a href="https://twitter.com/intent/tweet?text='+e(txt)+'&url='+e(url)+'" target="_blank" rel="noopener">𝕏 Post</a>'
      +'<a href="https://www.linkedin.com/sharing/share-offsite/?url='+e(url)+'" target="_blank" rel="noopener">LinkedIn</a>'
      +'<a href="https://api.whatsapp.com/send?text='+e(txt+" "+url)+'" target="_blank" rel="noopener">WhatsApp</a>'
      +(navigator.share?'<a href="#" data-snative>More…</a>':'')
      +'</div>'
      +'<p class="sharenote">Anyone who opens it lands in the playground, pre-filled with this - one Run from their own result.</p>';
    SHARECARD.querySelector("[data-x]").addEventListener("click",closeShare);
    SHARECARD.querySelector("[data-scopy]").addEventListener("click",function(){cpT(url,"Link <b>copied</b>");});
    var inp=SHARECARD.querySelector("[data-shareurl]");inp.addEventListener("focus",function(){inp.select();});
    var nat=SHARECARD.querySelector("[data-snative]");
    if(nat)nat.addEventListener("click",function(ev){ev.preventDefault();navigator.share({title:"Crawl4AI Cloud",text:txt,url:url}).catch(function(){});});
    SHAREPOP.classList.add("open");
  }
  O.addEventListener("click",function(e){
    if(e.target.closest("[data-copyout]"))cpT(lastOut,"Output <b>copied</b> - the full thing, not the preview");
    else if(e.target.closest("[data-share]"))doShare();
  });
  var runSeq=0,running=false,healed=false;
  function setRunning(on){
    running=on;
    var B=document.querySelector("[data-run]");
    B.disabled=on;B.textContent=on?"… Running":"▶ Run";
  }
  /* cheap client-side sanity so junk never burns a request (the gate gets
     its own validation later - this is the friendly first line) */
  function checkTarget(tab,raw){
    if(isQueryTab(tab))return null;
    var m=raw.match(/^([a-z][a-z0-9+.-]*):\/\//i);
    if(m&&!/^https?$/i.test(m[1]))return "only http(s) URLs here - "+m[1]+":// isn't crawlable";
    var u=normUrl(tab,raw);
    var ok=true;try{var p=new URL(u);ok=!!p.hostname&&p.hostname.indexOf(".")>0;}catch(e){ok=false;}
    if(!ok||/\s/.test(raw.trim()))return 'that doesn\'t look like a URL - fix it, or ask the <b>search</b> tab instead';
    return null;
  }
  function estimateNow(){ /* the same request shape as Run, priced before it runs (needs a key, like Run) */
    if(!hasKey()){openPop();return;}
    var v=val(),tab=cur,bad=checkTarget(tab,v),line=document.querySelector("[data-est]");
    if(bad){line.hidden=false;line.textContent="# "+bad;return;}
    v=normUrl(tab,v);line.hidden=false;line.textContent="estimating…";
    var body=(isQueryTab(tab))?{endpoint:tab}:{endpoint:tab,url:v};
    fetch("/v1/estimate",{method:"POST",headers:{authorization:"Bearer "+tk(),"content-type":"application/json"},body:JSON.stringify(body)})
      .then(function(r){return r.json().catch(function(){return {};}).then(function(j){return {s:r.status,j:j};});})
      .then(function(x){line.textContent=x.s===200&&x.j.text?"≈ "+x.j.text:"estimate unavailable"+(x.j&&x.j.error?" · "+x.j.error:"");})
      .catch(function(){line.textContent="estimate unavailable";});
  }
  function runNow(){
    if(running)return; /* a double-click must not burn quota twice */
    if(!hasKey()){pendingRun=true;openPop();return;}
    var v=val(),tab=cur,t0=performance.now(),seq=++runSeq;
    var bad=checkTarget(tab,v);
    if(bad){O.innerHTML='<pre><span class="err"># '+bad+'</span></pre>';K.classList.remove("show");return;}
    v=normUrl(tab,v);
    setRunning(true);
    if(window.c4t)c4t("playground_run",{s:tab,fp:window.c4fp?c4fp():""});
    O.innerHTML='<span class="ph">running <span class="tok">'+esc(v)+'</span> …'+(tab==="extract"?' <span class="ph">(the LLM takes a few seconds)</span>':'')+'</span>';
    K.classList.remove("show");
    var req=(isQueryTab(tab))
      ?fetch("/"+tab+"?q="+encodeURIComponent(v)+(tab==="answer"?deepParam():""),{headers:{authorization:"Bearer "+tk()}})
      :fetch("/"+tab,{method:"POST",headers:{authorization:"Bearer "+tk(),"content-type":"application/json"},body:JSON.stringify(tab==="extract"?{url:v,instruction:instr()}:{url:v})});
    req.then(function(r){var _sh=r.headers.get("x-share"); return r.json().then(function(j){return {s:r.status,j:j,sh:_sh};}).catch(function(){return {s:r.status,j:null,sh:_sh};});})
      .then(function(x){
        setRunning(false);
        if(seq!==runSeq)return; /* a newer run took over */
        if(cur!==tab){K.classList.remove("show");return;} /* user switched tabs mid-run: never mislabel output */
        if(x.s===200&&x.j&&x.j.ok!==false){healed=false;render(tab,x.j,v,performance.now()-t0,x.sh);}
        else if(x.s===401&&keyIsYoung()){syncWait(runNow);}
        else{fail(x.s,x.j);}
      })
      .catch(function(){
        setRunning(false);
        if(seq!==runSeq||cur!==tab)return;
        O.innerHTML='<pre><span class="err"># Network error - is your connection up?</span></pre>';
      });
  }
  document.querySelector("[data-run]").addEventListener("click",runNow);
  var _eb=document.querySelector("[data-estimate]");if(_eb)_eb.addEventListener("click",estimateNow);

  /* ---------- live badges ---------- */
  var sn=document.getElementById("stars"),pn=document.getElementById("pip");
  fetch("/v1/meta/badges").then(function(r){return r.json();}).then(function(j){
    if(j.pip_downloads_month)pn.textContent=(j.pip_downloads_month/1e6).toFixed(1)+"M / mo";
    if(!j.github_stars)return;
    var tg=j.github_stars;
    if(reduce){sn.textContent=tg.toLocaleString();return;}
    var c=Math.max(0,tg-214),iv=setInterval(function(){c+=Math.ceil((tg-c)/6);if(c>=tg){c=tg;clearInterval(iv);}sn.textContent=c.toLocaleString();},90);
  }).catch(function(){});

  /* ---------- launch-wave scarcity: prominent top strip + a line inside the mint modal.
     Seats OFF (default) -> SEATS.seats_left is null -> nothing renders (feature invisible). ---------- */
  var SEATS=null;
  function paintSeats(){
    if(!SEATS)return;
    if(SEATS.closed){ /* sign-ups closed until launch: one honest line, no seat counting */
      var cs=document.querySelector("[data-seatstrip]");
      if(cs){cs.className="seatstrip closed";cs.innerHTML='<span class="sdot"></span>Sign-ups open at launch';cs.style.display="inline-flex";}
      var cm=document.querySelector("[data-mseats]");
      if(cm){cm.innerHTML='&rarr; Sign-ups open at launch';cm.style.display="block";}
      return;
    }
    var off=(SEATS.seats_left==null), open=SEATS.open&&SEATS.seats_left>0;
    var n=off?"":SEATS.seats_left.toLocaleString();
    var strip=document.querySelector("[data-seatstrip]");
    if(strip){
      if(off){strip.style.display="none";}
      else{
        strip.className="seatstrip"+(open?"":" closed");
        strip.innerHTML='<span class="sdot"></span>'+(open?'<b>'+n+'</b>&nbsp;Free seats left':'Free seats are full &mdash; grab a token, we\'ll email you when one opens');
        strip.style.display="inline-flex";
      }
    }
    var ms=document.querySelector("[data-mseats]");   /* exists only while the mint modal is open */
    if(ms){
      if(off){ms.style.display="none";}
      else{ms.innerHTML=open?'&rarr; '+n+' Free seats left right now':'&rarr; Seats are full &mdash; your token works today, we\'ll email you the moment one opens';ms.style.display="block";}
    }
  }
  fetch("/v1/meta/seats").then(function(r){return r.json();}).then(function(j){SEATS=j;paintSeats();}).catch(function(){});
  /* sent back here by a sign-in attempt while sign-ups are closed */
  if(new URLSearchParams(location.search).get("closed")==="1"&&typeof toast==="function")toast("Sign-ups open at launch");

  /* deep link from a shared result (#5): /?svc=search&q=… lands the playground pre-filled
     on that service + query, one Run away from the shared result. Falls back to scrape. */
  (function(){
    var qs=new URLSearchParams(location.search), svc=qs.get("svc"), q=qs.get("q");
    var ok=svc&&["scrape","extract","search","answer"].indexOf(svc)>=0;
    pick(ok?svc:"scrape");
    if(q){T.value=q;rd();}
    if(ok||q){O.innerHTML='<span class="ph"># Shared result - hit <b>Run</b> (grab a free key) to see it yourself</span>';}
  })();
  refreshKeyUI();
  /* land with the caret already in the URL bar (desktop only - avoids popping the mobile keyboard
     and hiding the Run button); the field is prefilled so the very first Run returns something real */
  if(!matchMedia("(pointer:coarse)").matches){try{T.focus({preventScroll:true});T.setSelectionRange(T.value.length,T.value.length);}catch(e){}}

  /* signed-in visitors get their real key in the playground automatically,
     plus a visible way back to their console (U: the landing had none) */
  fetch("/v1/me").then(function(r){return r.ok?r.json():null;}).then(function(j){
    if(!j||!j.email)return;
    var k=null;
    (j.keys||[]).forEach(function(x){if(x.status==="active"&&x.key)k=x.key;});
    if(k){sessionKey=k;refreshKeyUI();}
    var sc=document.querySelector("[data-sess]");
    sc.innerHTML='<span style="color:var(--teal)">●</span> signed in as <b>'+esc(j.email)+'</b> · <a href="/dashboard/">console →</a>';
    sc.classList.add("on");
    /* signed in -> the right cluster becomes the session line; drop the Sign in / Get a key doors */
    document.querySelectorAll(".tabr .signin,.tabr .getk").forEach(function(e){e.style.display="none";});
    var ad=document.querySelector("[data-adot]");if(ad)ad.classList.add("on"); /* app-bar signed-in dot */
    /* signed in -> the app-bar CTA becomes the console link (mobile drops the long
       "signed in as ..." line, so this is the way back to the dashboard) */
    var gk=document.querySelector(".appbar .getk");
    if(gk){var nb=gk.cloneNode(false);nb.removeAttribute("data-key");nb.textContent="Console →";
      nb.addEventListener("click",function(){location.href="/dashboard/";});
      gk.parentNode.replaceChild(nb,gk);}
    /* signed in -> the bottom-bar action copies the existing key, so label it honestly */
    var bk=document.querySelector(".tabbar a.key");
    if(bk&&bk.lastChild)bk.lastChild.textContent="Copy key";
  }).catch(function(){});

  /* standing key status under the playground (the keyline left a gap) */
  function paintLive(){
    var el=document.querySelector(".live");if(!el)return;
    var st=loadKey();
    if(sessionKey){el.textContent="Live · your account key";}
    else if(st){var h=Math.max(1,Math.round((st.exp-Date.now())/36e5));el.textContent="Live · pass key active · ~"+h+"h left · verify for a permanent key";}
    else{el.textContent="Live · play limits";}
  }
  var _refreshKeyUI=refreshKeyUI;refreshKeyUI=function(){_refreshKeyUI();paintLive();};
  paintLive();

  /* a used/expired sign-in link lands here with ?verify=expired - explain it */
  (function(){
    if(new URLSearchParams(location.search).get("verify")!=="expired")return;
    history.replaceState(null,"","/");
    if(hasKey()){
      toast("That sign-in link was already <b>used or expired</b> - your key here still works");
      return;
    }
    openPop();
    var el=document.createElement("p");el.className="minterr";
    el.textContent="# that sign-in link was already used or expired - mint again, or use \"email me my key\" if you have an account";
    CARD.appendChild(el);
  })();

  /* popup: focus restore + a simple trap (U8) */
  (function(){
    var lastFocus=null;
    var _open=openPop;openPop=function(){lastFocus=document.activeElement;_open();};
    var _close=closePop;closePop=function(){_close();if(lastFocus&&lastFocus.focus)lastFocus.focus();};
    document.addEventListener("keydown",function(e){
      if(e.key!=="Tab"||!POP.classList.contains("open"))return;
      var f=POP.querySelectorAll("input,button,a[href]");if(!f.length)return;
      var first=f[0],last=f[f.length-1];
      if(e.shiftKey&&document.activeElement===first){e.preventDefault();last.focus();}
      else if(!e.shiftKey&&document.activeElement===last){e.preventDefault();first.focus();}
    });
  })();
})();

/* ---------- theme toggle (light / dark; persists, updates theme-color) ---------- */
(function(){
  var root=document.documentElement,tc=document.querySelector('meta[name="theme-color"]');
  function sync(){var l=root.getAttribute("data-theme")==="light";
    document.querySelectorAll("[data-themetog]").forEach(function(b){b.textContent=l?"☾":"☀";});
    if(tc)tc.setAttribute("content",l?"#f6f7f9":"#070708");}
  document.querySelectorAll("[data-themetog]").forEach(function(b){b.addEventListener("click",function(){
    var next=root.getAttribute("data-theme")==="light"?"dark":"light";
    root.setAttribute("data-theme",next);try{localStorage.setItem("c4theme",next);}catch(e){}sync();
  });});
  sync();
})();
/* the service switch: GET /v1/meta/services names the services the fleet switched off, each with a
   note. Hide their surfaces ([data-service=name]), show their notes ([data-service-off=name], the text
   into its [data-note]), and fold a docs section (the [data-service-section=name] heading and every
   sibling up to the next heading of the same tag). A service the body does not name stays as it is.
   The cookie rides along: a signed-in account on a service's private list gets it answered as on. */
(function(){
  fetch("/v1/meta/services",{credentials:"same-origin"}).then(function(r){return r.ok?r.json():{};}).then(function(flags){
    Object.keys(flags||{}).forEach(function(name){
      var f=flags[name]; if(!f||f.on!==false)return;
      var all=function(sel){return Array.prototype.slice.call(document.querySelectorAll(sel));};
      all('[data-service="'+name+'"]').forEach(function(el){el.style.display="none";});
      all('[data-service-off="'+name+'"]').forEach(function(el){el.hidden=false;var n=el.querySelector("[data-note]");if(n)n.textContent=f.note||"";});
      all('[data-service-section="'+name+'"]').forEach(function(h){
        var el=h; while(el){var next=el.nextElementSibling; el.style.display="none"; if(!next||next.tagName===h.tagName)break; el=next;}
      });
    });
  }).catch(function(){});
})();

/* ---------- mobile bottom tab bar: smooth scroll + scroll-spy ---------- */
(function(){
  var bar=document.querySelector(".tabbar");if(!bar)return;
  var APP=60; /* offset under the fixed app-bar */
  function go(id){
    if(id==="top"){scrollTo({top:0,behavior:"smooth"});return;}
    var el=document.getElementById(id);if(!el)return;
    scrollTo({top:el.getBoundingClientRect().top+scrollY-APP,behavior:"smooth"});
  }
  var links={};
  bar.querySelectorAll("a[data-nav]").forEach(function(a){
    if(a.hasAttribute("data-page"))return;   // a tab that is another page: let the link work
    links[a.getAttribute("data-nav")]=a;
    a.addEventListener("click",function(e){e.preventDefault();go(a.getAttribute("data-nav"));});
  });
  function setCur(k){
    for(var n in links)links[n].removeAttribute("aria-current");
    if(links[k])links[k].setAttribute("aria-current","true");
  }
  if("IntersectionObserver" in window){
    var io=new IntersectionObserver(function(es){
      es.forEach(function(en){if(en.isIntersecting&&scrollY>=120)setCur(en.target.id);});
    },{rootMargin:"-45% 0px -50% 0px"});
    ["playground","pricing"].forEach(function(id){var el=document.getElementById(id);if(el)io.observe(el);});
  }
  addEventListener("scroll",function(){if(scrollY<120)setCur("top");},{passive:true});
  setCur("top");
})();
</script>
</body>
</html>
