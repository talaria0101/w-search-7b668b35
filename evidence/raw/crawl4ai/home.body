<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<meta name="theme-color" content="#070708">
<meta name="color-scheme" content="dark">
<title>Crawl4AI - README</title>
<meta name="description" content="Crawl4AI, the #1 open-source LLM-friendly web crawler, now cloud-hosted. Turn any URL into clean Markdown, typed JSON, or search results. Free to self-host, hosted so you skip the ops.">
<link rel="canonical" href="https://api.crawl4ai.com/">
<meta property="og:type" content="website">
<meta property="og:site_name" content="Crawl4AI">
<meta property="og:title" content="Crawl4AI - the open-source crawler, now hosted">
<meta property="og:description" content="Turn any URL into clean Markdown, typed JSON, or search results. Free to self-host, hosted so you skip the ops.">
<meta property="og:url" content="https://api.crawl4ai.com/">
<meta name="twitter:card" content="summary">
<meta name="twitter:title" content="Crawl4AI - the open-source crawler, now hosted">
<meta name="twitter:description" content="Turn any URL into clean Markdown, typed JSON, or search results. The library is free forever; hosted means zero setup.">
<link rel="icon" type="image/svg+xml" href="/assets/logo.cc61ca8c.svg">
<link rel="preload" as="font" type="font/woff2" crossorigin href="/assets/DankMono-W500.33075101.woff2">
<link rel="preload" as="font" type="font/woff2" crossorigin href="/assets/DankMono-W700.53051ed7.woff2">
<script>/* set the theme before first paint (no flash): stored choice, else the OS setting */
(function(){try{var t=localStorage.getItem("c4theme")||"dark";document.documentElement.setAttribute("data-theme",t);}catch(e){}})();
/* first-touch attribution: stash a ?ref= slug in the c4_src cookie so signup records where the user came from (never overwrite) */
(function(){try{var m=location.search.match(/[?&]ref=([a-zA-Z0-9_-]{1,40})/);if(m&&!/(^|;\s*)c4_src=/.test(document.cookie))document.cookie="c4_src="+m[1]+"; Path=/; Max-Age="+(90*86400)+"; SameSite=Lax"+(location.protocol==="https:"?"; Secure":"");
/* the ad click id (Google: gclid, and the iOS forms gbraid / wbraid): first touch, 90 days, never overwritten; read at signup for the conversion report */
var g=location.search.match(/[?&](gclid|gbraid|wbraid)=([A-Za-z0-9_-]{1,120})/);if(g&&!/(^|;\s*)c4_gclid=/.test(document.cookie))document.cookie="c4_gclid="+g[2]+"; Path=/; Max-Age="+(90*86400)+"; SameSite=Lax"+(location.protocol==="https:"?"; Secure":"");}catch(e){}})();</script>
<style>
/* Dank Mono, thickened from its regular drawing: normal text uses the 500 file, bold the 700 file; 300 is the original regular, 800 extra bold */
@font-face{font-family:"dm";font-weight:300;font-style:normal;font-display:swap;src:url(/assets/DankMono-Regular.0ca792d9.woff2) format("woff2")}
@font-face{font-family:"dm";font-weight:400;font-style:normal;font-display:swap;src:url(/assets/DankMono-W500.33075101.woff2) format("woff2")}
@font-face{font-family:"dm";font-weight:700;font-style:normal;font-display:swap;src:url(/assets/DankMono-W700.53051ed7.woff2) format("woff2")}
@font-face{font-family:"dm";font-weight:800;font-style:normal;font-display:swap;src:url(/assets/DankMono-W800.9725284f.woff2) format("woff2")}
@font-face{font-family:"dm";font-weight:400;font-style:italic;font-display:swap;src:url(/assets/DankMono-Italic-W500.ea5d2192.woff2) format("woff2")}
@font-face{font-family:"dm";font-weight:700;font-style:italic;font-display:swap;src:url(/assets/DankMono-Italic-W700.aebc2076.woff2) format("woff2")}
.mark{height:.86em;width:.86em;vertical-align:-.08em;margin-right:.12em}

  :root{
    --bg:#070708;--surf:#0d0d10;--code:#0a0a0c;--line:rgba(233,233,237,.10);--cyl:rgba(74,230,229,.20);--hair:rgba(233,233,237,.06);
    --text:#e8e9ed;--muted:#a3abba;--dim:#8b857a;--cyan:#4AE6E5;--teal:#09b5a5;--mag:#f380f5;--pink:#ff3c74;--star:#fed500;--on:#052220;
    --mono:"dm",ui-monospace,"SF Mono","JetBrains Mono","Menlo","Monaco","Liberation Mono",monospace;
    --sans:"dm",-apple-system,BlinkMacSystemFont,"Segoe UI",system-ui,sans-serif;}

  /* ===== light theme (warm): the whole page goes light, code/panels included ===== */
  :root[data-theme="light"]{
    --bg:#f4efe6;--surf:#fffdf8;--code:#efe9dd;--line:rgba(64,52,38,.15);--cyl:rgba(8,145,156,.34);--hair:rgba(64,52,38,.08);
    --text:#2b2620;--muted:#61584c;--dim:#968c7c;--cyan:#08919c;--teal:#0a8578;--mag:#b8279b;--pink:#d81b55;--star:#9a6b06;--on:#ffffff;}
  :root[data-theme="light"] body{background-image:radial-gradient(900px 480px at 88% -12%,rgba(8,145,156,.07),transparent 60%);font-weight:700}
  :root[data-theme="light"] .shield,:root[data-theme="light"] .shield .k,:root[data-theme="light"] .shield .v{font-weight:400}  /* keep the badges at normal weight */
  /* white / emphasis text needs a warm-dark ink on the light page */
  :root[data-theme="light"] h1,:root[data-theme="light"] h2,:root[data-theme="light"] blockquote b,
  :root[data-theme="light"] ul.md li b,:root[data-theme="light"] .path h3,:root[data-theme="light"] .quip b,
  :root[data-theme="light"] .prow .tier,:root[data-theme="light"] .tfield .target,
  :root[data-theme="light"] .mintform input,:root[data-theme="light"] .rec .meta b{color:#2b2620}
  :root[data-theme="light"] .prow .amt[style]{color:#2b2620!important}  /* beats the inline color:#fff */
  /* app-shell bars go light */
  :root[data-theme="light"] .appbar{background:rgba(255,253,248,.85);border-bottom-color:var(--line)}
  :root[data-theme="light"] .appbar .brand{color:#2b2620}
  :root[data-theme="light"] .tabbar{background:rgba(255,253,248,.92);border-top-color:var(--line)}
  /* code + terminal panels: light surfaces, darkened syntax colors so they read on cream */
  :root[data-theme="light"] .tfield{background:#faf6ee}
  :root[data-theme="light"] .out{background:#faf6ee}  /* lighter than the fence so the result panel separates */
  :root[data-theme="light"] .out pre{color:#2b2620}
  :root[data-theme="light"] .out .k{color:#0a6cb0}
  :root[data-theme="light"] .out .s,:root[data-theme="light"] .cmd .str{color:#1a7f37}
  :root[data-theme="light"] .out::-webkit-scrollbar-thumb{background:rgba(0,0,0,.22);border-color:#efe9dd}
  :root[data-theme="light"] .prow:first-child{background:#e9e1d3;color:var(--dim)}
  /* theme toggle button */
  .themetog{font-family:var(--mono);font-size:13px;color:var(--muted);background:transparent;border:1px solid var(--line);border-radius:8px;padding:5px 9px;cursor:pointer;line-height:1;flex:none;align-self:center}
  .themetog:hover{color:var(--text);border-color:var(--cyl)}
  .tabrow .sess{margin-left:auto;align-self:center}   /* signed-in status sits at the far top-right */

  *{box-sizing:border-box}
  body{margin:0;background:var(--bg);color:var(--text);font-family:var(--sans);font-size:16px;line-height:1.65;-webkit-font-smoothing:antialiased;
    background-image:radial-gradient(900px 480px at 88% -12%,rgba(74,230,229,.10),transparent 60%);}
  ::selection{background:var(--cyan);color:var(--on)}
  a{color:var(--cyan);text-decoration:none}a:hover{text-decoration:underline}
  .doc{max-width:860px;margin:0 auto;padding:34px 22px 70px}
  .tabrow{display:flex;align-items:flex-end;justify-content:space-between;gap:10px;flex-wrap:wrap}
  .filetab{display:flex;align-items:center;gap:9px;font-family:var(--mono);font-size:12.5px;color:var(--muted);
    border:1px solid var(--line);border-bottom:0;border-radius:10px 10px 0 0;padding:9px 13px;background:var(--surf);width:max-content}
  .filetab .dot{width:9px;height:9px;border-radius:50%;background:var(--cyan)}
  /* top-bar doors: left = open-source origin, right = the hosted product */
  .tabl{display:flex;align-items:flex-end;gap:16px}
  .tabr{display:flex;align-items:center;gap:14px;align-self:center;margin-bottom:3px}
  @property --ossang{syntax:"<angle>";initial-value:0deg;inherits:false}
  /* rotating-gold-border pill: outer = the animated border, inner = the fill that flips gold on hover */
  .oss{align-self:center;display:inline-block;padding:1.5px;border-radius:11px;text-decoration:none;
    background:conic-gradient(from var(--ossang),#7a5c12,var(--star) 90deg,#7a5c12 180deg,#3a2e12 270deg,#7a5c12);
    animation:ossspin 5s linear infinite}
  .oss:hover{text-decoration:none}
  .ossin{display:block;border-radius:9.5px;padding:2px 13px;background:var(--bg);color:var(--text);text-decoration:none;
    font-family:var(--mono);font-size:12.5px;font-weight:600;white-space:nowrap;transition:background-color .2s ease,color .2s ease}
  .oss:hover .ossin{background:var(--star);color:var(--on)}
  .oss .s{color:var(--star);transition:color .2s ease}
  .oss:hover .s{color:var(--on)}
  .oss .ossdim{color:var(--muted);font-weight:400;transition:color .2s ease}
  .oss:hover .ossdim{color:var(--on);opacity:.65}
  @keyframes ossspin{to{--ossang:360deg}}
  @media(prefers-reduced-motion:reduce){.oss{animation:none}}
  .signin{font-family:var(--mono);font-size:12.5px;color:var(--muted);text-decoration:none;white-space:nowrap}
  .signin:hover{color:var(--text)}
  .tabr .getk.deskk{display:inline-block;font-family:var(--mono);font-size:12px;font-weight:600;color:var(--on);
    background:var(--cyan);border:0;border-radius:8px;padding:7px 14px;cursor:pointer;line-height:1}
  .tabr .getk.deskk:hover{filter:brightness(1.06)}
  .sheet{position:relative;border:1px solid var(--line);border-radius:0 12px 12px 12px;background:linear-gradient(180deg,rgba(255,255,255,.015),transparent 240px);padding:30px 30px 34px}
  @media(max-width:620px){.sheet{padding:22px 18px}}
  .eyebrow{display:flex;align-items:center;gap:9px;flex-wrap:wrap;font-family:var(--mono);font-size:13.5px;color:var(--cyan);margin:0 0 12px}
  .tagpill{font-family:var(--mono);font-size:10.5px;letter-spacing:.1em;color:var(--on);background:var(--cyan);border-radius:5px;padding:2px 7px;font-weight:700}
  .ebshort{display:none}  /* mobile-only short eyebrow (see the app-shell media block) */
  h1{font-family:var(--mono);font-size:clamp(26px,5vw,36px);margin:0;color:#fff;letter-spacing:-.02em;font-weight:700}
  h1 .cloud{color:var(--cyan);font-weight:500}
  h1 .h1sub{display:none}   /* the phone shows it between the two title lines (recipes.css) */
  .sub{color:var(--muted);font-size:16px;margin:8px 0 0}
  /* launch-wave scarcity — subtle text line (no fill; a small pulsing dot + the count) */
  .seatstrip{display:inline-flex;align-items:center;gap:8px;margin:12px 0 0;font-family:var(--mono);font-size:13px;color:var(--muted)}
  .seatstrip b{font-weight:700;color:var(--cyan)}
  .seatstrip .sdot{width:7px;height:7px;border-radius:50%;background:var(--cyan);animation:seatpulse 1.8s ease-in-out infinite}
  .seatstrip.closed .sdot{background:var(--dim);animation:none}
  @keyframes seatpulse{0%,100%{opacity:.3}50%{opacity:1}}
  @media (prefers-reduced-motion:reduce){.seatstrip .sdot{animation:none}}
  .mseats{margin:10px 0 0;font-family:var(--mono);font-size:12.5px;font-weight:600;color:var(--cyan)}
  /* authentic proof: the real Trendshift #1 card (their SVG, inlined) + shields.io-shaped badges */
  .proof{display:flex;flex-wrap:wrap;align-items:center;gap:10px 12px;margin:18px 0 0}
  .trend{position:absolute;top:20px;right:26px;z-index:3;line-height:0;transition:transform .15s}
  .trend:hover{transform:translateY(-2px)}
  .trend svg{width:176px;height:auto;display:block;filter:drop-shadow(0 5px 18px rgba(74,14,153,.45))}
  @media(max-width:760px){.trend{position:static;top:auto;right:auto}.trend svg{width:190px}}
  .badges{display:flex;flex-wrap:wrap;gap:8px;margin:15px 0 0}
  .shield{display:inline-flex;height:20px;border-radius:4px;overflow:hidden;text-decoration:none;white-space:nowrap;
    font-family:Verdana,Geneva,"DejaVu Sans",sans-serif;font-size:11px;line-height:20px}
  .shield .k{background:#555;color:#fff;padding:0 7px}
  .shield .v{color:#fff;padding:0 7px}
  .shield.blue .v{background:#007ec6}.shield.green .v{background:#4c1}
  .shield.discord .v{background:#5865f2}.shield.gold .v{background:#dfb317}
  a.b:hover{text-decoration:none;border-color:var(--cyl)}
  blockquote{border-left:3px solid var(--teal);margin:22px 0 0;padding:2px 0 2px 16px;color:var(--text)}
  blockquote b{color:#fff}
  h2{font-family:var(--mono);font-size:18px;color:#fff;margin:36px 0 0;padding-top:22px;border-top:1px solid var(--hair);font-weight:650;display:flex;gap:9px;align-items:baseline;flex-wrap:wrap}
  h2 .h{color:var(--teal);font-weight:400}
  h2 .tag{font-family:var(--sans);font-size:13px;color:var(--dim);font-weight:400;white-space:nowrap}
  p{margin:12px 0 0}.lead{color:var(--muted)}
  .fence{margin:16px 0 0;border:1px solid var(--line);border-radius:11px;overflow:hidden;background:var(--code);font-family:var(--mono)}
  .fbar{display:flex;align-items:center;gap:8px;padding:8px 11px;border-bottom:1px solid var(--hair)}
  .fromdocs{display:flex;flex-wrap:wrap;align-items:center;gap:8px 12px;font-family:var(--mono);font-size:13px;line-height:1.5;color:var(--text);background:rgba(217,164,65,.10);border:1px solid rgba(217,164,65,.45);border-radius:10px;padding:12px 14px;margin:0 0 16px}
  .fromdocs[hidden]{display:none}.fromdocs .tagpill{background:#d9a441;color:#1a1200}.fromdocs b{color:var(--text)}.fromdocs .getk{margin-left:auto;background:#d9a441;border-color:#d9a441;color:#1a1200}
  .agtabs{display:flex;gap:2px;flex-wrap:wrap;margin:0 0 4px}
  .at{font-family:var(--mono);font-size:12px;color:var(--dim);background:transparent;border:0;padding:5px 10px;border-radius:6px;cursor:pointer}
  .at[aria-selected=true]{color:var(--cyan);background:rgba(74,230,229,.10);box-shadow:inset 0 0 0 1px var(--cyl)}
  .rec[hidden]{display:none}
  .connected{font-family:var(--mono);font-size:12px;color:#d9a441;padding:4px 0 8px}.connected[hidden]{display:none}
  .ftabs{display:flex;gap:2px}
  .ft{font-family:var(--mono);font-size:12px;color:var(--dim);background:transparent;border:0;padding:5px 10px;border-radius:6px;cursor:pointer}
  .ft[aria-selected=true]{color:var(--cyan);background:rgba(74,230,229,.10);box-shadow:inset 0 0 0 1px var(--cyl)}
  .ep{margin-left:auto;font-size:11px;color:var(--dim)}.ep .m{color:var(--teal)}
  .fbody{padding:13px 14px}
  .targetrow{display:flex;align-items:center;gap:10px;background:transparent;border:0;padding:2px 0;margin-bottom:12px}
  .targetrow .verb{font-family:var(--mono);font-size:12.5px;color:var(--muted);flex:none}
  .targetrow .verb span{color:var(--mag)}
  .tfield{flex:1;min-width:0;display:flex;align-items:center;gap:8px;background:#0a0a0c;border:1px solid var(--cyl);border-radius:8px;padding:8px 10px;cursor:text;transition:border-color .15s,box-shadow .15s}
  .tfield.pulse{animation:pulseGlow 2.2s ease .5s 1 both}
  @keyframes pulseGlow{0%,100%{box-shadow:0 0 0 0 rgba(74,230,229,0)}35%{box-shadow:0 0 0 3px rgba(74,230,229,.18)}}
  .tfield:hover{border-color:var(--cyan)}
  .tfield:focus-within{border-color:var(--cyan);box-shadow:0 0 0 3px rgba(74,230,229,.14);animation:none}
  .tfield .target{flex:1;min-width:0;background:transparent;border:0;outline:none;color:#fff;font-family:var(--mono);font-size:12.8px;caret-color:var(--cyan)}
  .tfield .target::placeholder{color:var(--dim)}
  .pen{flex:none;font-family:var(--mono);font-size:11px;color:var(--dim);border:1px solid var(--line);border-radius:5px;padding:2px 6px;transition:.15s}
  .tfield:focus-within .pen{color:var(--cyan);border-color:var(--cyl);background:rgba(74,230,229,.08)}
  .pen .peni::before{content:"✎"}
  .pen .peni{font-style:normal}
  .pen::after{content:" edit"}
  .tfield:focus-within .pen::after{content:" run"}
  .tfield:focus-within .pen .peni::before{content:"↵"}
  .targetrow .run{flex:none;margin:0}
  @keyframes runPulse{0%,100%{box-shadow:0 0 0 0 rgba(74,230,229,0)}50%{box-shadow:0 0 0 5px rgba(74,230,229,.16)}}
  .targetrow .run[data-run]{animation:runPulse 2.4s ease-in-out infinite}
  .targetrow .run[data-run]:hover{animation:none;box-shadow:0 0 0 3px rgba(74,230,229,.3)}
  .live{font-family:var(--mono);font-size:11px;color:var(--teal)}
  .cmd{margin:0;white-space:pre-wrap;word-break:break-word;font-size:12.7px;line-height:1.6;opacity:.85}
  .cmd .p{color:var(--cyan)}.cmd .fl{color:var(--mag)}.cmd .str{color:#bdf3c0}.cmd .tok{color:var(--cyan);background:rgba(74,230,229,.1);border-radius:4px;padding:0 3px}
  .rr{display:flex;gap:9px;align-items:center;margin-top:12px;flex-wrap:wrap}
  .run.est{margin-left:6px;background:transparent;color:#d9a441;border:1px solid rgba(217,164,65,.5)}
  .estline{font-family:var(--mono);font-size:12px;color:#d9a441;padding:2px 0 6px 2px}
  .run{font-family:var(--mono);font-size:12px;font-weight:600;color:var(--on);background:var(--cyan);border:0;border-radius:7px;padding:7px 13px;cursor:pointer}
  .run:active{transform:translateY(1px)}
  .cpy{font-family:var(--mono);font-size:11.5px;color:var(--muted);background:transparent;border:1px solid var(--line);border-radius:7px;padding:7px 11px;cursor:pointer}
  .cpy:hover{color:var(--text);border-color:var(--cyl)}
  .rr .ok{margin-left:auto;font-size:11px;color:var(--teal);opacity:0;transition:.3s}.rr .ok.show{opacity:1}
  .out{margin-top:12px;min-height:120px;max-height:360px;overflow:auto;padding:12px;background:#131315;border-radius:8px;
    scrollbar-width:thin;scrollbar-color:rgba(255,255,255,.2) transparent}
  .out::-webkit-scrollbar{width:9px;height:9px}
  .out::-webkit-scrollbar-track{background:transparent}
  .out::-webkit-scrollbar-thumb{background:rgba(255,255,255,.17);border-radius:8px;border:2px solid #131315}
  .out::-webkit-scrollbar-thumb:hover{background:rgba(255,255,255,.32)}
  .out pre{margin:0;white-space:pre-wrap;word-break:break-word;font-size:12.3px;line-height:1.55;color:#d5d7dd}
  .out .rr{margin-top:11px}
  .out .k{color:#8fd6ff}.out .s{color:#bdf3c0}.out .n{color:var(--mag)}.out .h{color:var(--cyan)}.out .err{color:var(--pink)}
  .out .caret{display:inline-block;width:7px;height:13px;background:var(--cyan);vertical-align:-2px;animation:bl 1s steps(1) infinite}
  @keyframes bl{50%{opacity:0}}.ph{color:var(--dim)}
  .tokbtn{cursor:pointer;border:0;font:inherit;display:inline-flex;align-items:center;gap:5px;line-height:inherit}
  .tokbtn svg{opacity:.75}
  .tokbtn:hover{background:rgba(74,230,229,.22)}
  #mintpop,#entpop,#sharepop{position:fixed;inset:0;display:none;align-items:center;justify-content:center;background:rgba(7,7,8,.65);backdrop-filter:blur(3px);z-index:50;padding:20px}
  #mintpop.open,#entpop.open,#sharepop.open{display:flex}
  .sharecard{background:var(--surf);border:1px solid var(--cyl);border-radius:14px;padding:20px;max-width:520px;width:100%;font-family:var(--mono);box-shadow:0 18px 60px rgba(0,0,0,.55);max-height:90vh;overflow:auto}
  .sharecard .mt{font-size:13px;color:var(--teal);margin:0 0 12px}
  .sharethumb{width:100%;border-radius:10px;border:1px solid var(--line);display:block;margin:0 0 14px;background:#0a0b0d;aspect-ratio:1200/630}
  .sharerow{display:flex;gap:8px;margin:0 0 12px}
  .sharerow input{flex:1;min-width:0;background:transparent;border:1px solid var(--line);border-radius:8px;color:var(--text);font-family:var(--mono);font-size:12.5px;padding:10px 11px;outline:none}
  .sharerow input:focus{border-color:var(--cyan)}
  .sharerow .scopy{border:0;background:var(--cyan);color:var(--on);font-weight:600;font-size:12.5px;padding:10px 16px;border-radius:8px;cursor:pointer;white-space:nowrap}
  .sharebtns{display:flex;flex-wrap:wrap;gap:8px}
  .sharebtns a{flex:1;min-width:96px;text-align:center;text-decoration:none;border:1px solid var(--line);border-radius:8px;padding:9px 10px;color:var(--text);font-size:12.5px}
  .sharebtns a:hover{border-color:var(--cyl);color:var(--cyan)}
  .sharenote{font-size:12px;color:var(--muted);margin:13px 0 0;line-height:1.5}
  .entcard{background:var(--surf);border:1px solid var(--cyl);border-radius:13px;padding:22px 22px 20px;max-width:460px;width:100%;font-family:var(--mono);box-shadow:0 18px 60px rgba(0,0,0,.55);max-height:88vh;overflow:auto}
  .entcard .mt{font-size:13px;color:var(--teal);margin:0 0 8px}
  .entcard .mb{font-size:13px;color:var(--muted);line-height:1.6;margin:0 0 14px}
  .entf{display:flex;flex-direction:column;gap:9px}
  .entf input,.entf textarea{background:transparent;border:1px solid var(--line);border-radius:8px;color:var(--text);font-family:var(--mono);font-size:13px;padding:10px 12px;outline:none;width:100%;box-sizing:border-box}
  .entf input:focus,.entf textarea:focus{border-color:var(--cyan)}
  .entf textarea{resize:vertical;min-height:64px}
  .entf .entsend{border:0;background:var(--cyan);color:var(--on);font-weight:600;font-size:13px;padding:11px 14px;border-radius:8px;cursor:pointer;margin-top:2px}
  .entf .entsend:disabled{opacity:.6;cursor:default}
  .enterr{color:var(--pink);font-size:12px;margin:2px 0 0}
  .mintcard{background:var(--surf);border:1px solid var(--cyl);border-radius:13px;padding:22px 22px 20px;max-width:460px;width:100%;font-family:var(--mono);box-shadow:0 18px 60px rgba(0,0,0,.55),0 0 0 4px rgba(74,230,229,.05)}
  .mintcard .mt{font-size:13px;color:var(--teal);margin:0 0 8px}
  .mintcard .mb{font-size:13.5px;color:var(--muted);line-height:1.7;margin:0 0 14px}
  .mintcard .mb b{color:var(--text)}
  .mintform{display:flex;border:1px solid var(--cyan);border-radius:9px;overflow:hidden;animation:mintGlow 1.6s ease infinite}
  @keyframes mintGlow{0%,100%{box-shadow:0 0 0 0 rgba(74,230,229,.10)}50%{box-shadow:0 0 0 4px rgba(74,230,229,.22)}}
  .mintform input{flex:1;min-width:0;background:transparent;border:0;outline:none;color:#fff;font-family:var(--mono);font-size:13px;padding:11px 13px;caret-color:var(--cyan)}
  .mintform input::placeholder{color:var(--dim)}
  .mintform button{border:0;background:var(--cyan);color:var(--on);font-family:var(--mono);font-size:12.5px;font-weight:600;padding:11px 14px;cursor:pointer;white-space:nowrap}
  .mintkey{display:block;background:var(--code);border:1px solid var(--cyl);border-radius:9px;padding:11px 13px;color:var(--cyan);font-size:12.5px;word-break:break-all;margin:0 0 8px;cursor:pointer}.mintkeyrow{display:flex;gap:8px;margin:0 0 14px}.mintkeyrow button{font-family:var(--mono);font-size:11.5px;color:var(--cyan);background:rgba(74,230,229,.08);border:1px solid var(--cyl);border-radius:7px;padding:6px 11px;cursor:pointer}
  .mintdone{width:100%;border:0;background:var(--cyan);color:var(--on);font-family:var(--mono);font-size:13px;font-weight:600;border-radius:9px;padding:11px;cursor:pointer}
  .mintx{float:right;border:0;background:transparent;color:var(--dim);font-family:var(--mono);font-size:15px;cursor:pointer;margin:-6px -6px 0 0;padding:6px}
  .mintx:hover{color:var(--text)}
  .minterr{font-size:12.5px;color:var(--pink);margin:10px 0 0;line-height:1.6}
  .mintalt{display:flex;gap:9px;margin-top:14px;flex-wrap:wrap}
  .mintalt a{font-size:12px;font-weight:600;color:var(--on);background:var(--cyan);border-radius:8px;padding:9px 13px;text-decoration:none}
  .mintalt button{font-size:12px;color:var(--text);background:transparent;border:1px solid var(--line);border-radius:8px;padding:9px 13px;cursor:pointer;font-family:var(--mono)}
  .mintalt button:hover{border-color:var(--cyl)}
  .note{color:var(--dim);font-size:13.5px;font-family:var(--mono)}
  ul.md{list-style:none;padding:0;margin:14px 0 0;display:flex;flex-direction:column;gap:9px}
  ul.md li{position:relative;padding-left:17px;font-size:15px}ul.md li b{color:#fff;font-family:var(--mono);font-size:13.5px}
  ul.md li::before{content:"-";color:var(--teal);position:absolute;left:0;top:0}
  .recs{display:flex;flex-direction:column;gap:9px;margin-top:14px}
  .rec{display:grid;grid-template-columns:1fr;background:var(--code);border:1px solid var(--line);border-radius:10px;overflow:hidden}
  @media(min-width:640px){.rec{grid-template-columns:172px 1fr}}
  .rec .meta{padding:11px 14px;border-bottom:1px solid var(--hair);font-family:var(--mono)}
  @media(min-width:640px){.rec .meta{border-bottom:0;border-right:1px solid var(--hair)}}
  .rec .meta b{display:block;font-size:13px;color:#fff}.rec .meta span{font-size:11.5px;color:var(--dim)}
  .rec .meta .soon{display:inline-block;margin-left:6px;font-size:9.5px;letter-spacing:.08em;color:var(--mag);border:1px solid rgba(243,128,245,.35);border-radius:4px;padding:0 5px;vertical-align:1px}
  .rec .line{display:flex;align-items:center;gap:10px;padding:10px 12px;min-width:0}
  .rec .body{display:flex;flex-direction:column;gap:2px;padding:8px 0 4px;min-width:0}
  .rec .body .line{padding:4px 12px 6px}
  .rec .body .agtabs{padding:0 10px}
  .rec .where{font-family:var(--mono);font-size:11.5px;color:var(--dim);padding:4px 12px 0}
  .rec .line code{font-family:var(--mono);font-size:12.3px;color:var(--text);white-space:nowrap;overflow-x:auto;flex:1;min-width:0}
  .rec .line code .p{color:var(--cyan)}.rec .line code .a{color:var(--teal)}.rec .line code .tok{color:var(--cyan)}
  .rec .cp{flex:none;font-family:var(--mono);font-size:11px;color:var(--cyan);background:rgba(74,230,229,.08);border:1px solid var(--cyl);border-radius:6px;padding:5px 9px;cursor:pointer}
  .rec .cp:hover{background:rgba(74,230,229,.16)}
  .paths{display:grid;grid-template-columns:1fr;gap:12px;margin-top:14px}
  @media(min-width:640px){.paths{grid-template-columns:1fr 1fr}}
  .path{border:1px solid var(--line);border-radius:11px;padding:16px;background:var(--surf)}
  .path.hosted{border-color:var(--cyl);box-shadow:inset 0 0 0 1px rgba(74,230,229,.06)}
  .path .pt{font-family:var(--mono);font-size:12.5px;color:var(--teal);letter-spacing:.04em}
  .path.hosted .pt{color:var(--cyan)}
  .path h3{font-family:var(--mono);font-size:16px;color:#fff;margin:8px 0 0;font-weight:650}
  .path p{margin:9px 0 0;font-size:14.5px;color:var(--muted)}
  .path .pact{margin-top:13px}
  .path .pill{font-family:var(--mono);font-size:12px;color:var(--on);background:var(--cyan);border:0;border-radius:8px;padding:8px 13px;cursor:pointer;font-weight:600;text-decoration:none;display:inline-block}
  .path .ghost{font-family:var(--mono);font-size:12px;color:var(--text);border:1px solid var(--line);border-radius:8px;padding:8px 13px;text-decoration:none;display:inline-block}
  .quip{margin-top:14px;font-family:var(--mono);font-size:13px;color:var(--muted);border-left:3px solid var(--cyan);padding-left:14px}
  .quip b{color:#fff}
  .ptab{margin-top:14px;border:1px solid var(--line);border-radius:11px;overflow:hidden;font-family:var(--mono);font-size:13px}
  .prow{display:grid;grid-template-columns:1.1fr 1fr 1.5fr;gap:0;border-top:1px solid var(--hair)}
  .prow:first-child{border-top:0;background:#131317;color:var(--dim);font-size:11.5px;letter-spacing:.06em;text-transform:uppercase}
  .prow>div{padding:11px 14px;min-width:0;overflow-x:auto;white-space:nowrap}
  .prow.free .tier{color:var(--cyan)}.prow .tier{color:#fff}
  .prow .amt{color:var(--star)}.prow.credit .tier{color:#d9a441}.prow.credit .amt{color:#d9a441}.prow.soon .amt{color:var(--mag)}.prow .amt small{color:var(--muted)}
  .prow .for{color:var(--muted);white-space:normal}
  .prow .cta{display:inline-block;color:var(--on);background:var(--cyan);border-radius:6px;padding:4px 10px;font-size:11.5px;cursor:pointer;font-weight:600}
  .prow .cta.ln{background:transparent;color:var(--cyan);border:1px solid var(--cyl)}
  .logos{display:flex;flex-wrap:wrap;gap:10px;margin-top:14px}
  .logos .logo{font-family:var(--mono);font-size:12.5px;color:var(--muted);border:1px dashed var(--line);border-radius:8px;padding:10px 16px}
  .phil{margin-top:16px;background:var(--code);border:1px solid var(--hair);border-left:3px solid var(--mag);border-radius:0 10px 10px 0;padding:14px 16px;font-family:var(--mono);font-size:13px;color:var(--text);line-height:1.7}
  .phil .c{color:var(--dim)}.phil .cy{color:var(--cyan)}
  footer{margin-top:30px;border-top:1px solid var(--hair);padding-top:16px;display:flex;flex-wrap:wrap;gap:14px;justify-content:space-between;font-family:var(--mono);font-size:12.5px;color:var(--dim)}
  footer a{color:var(--muted)}
  #toast{position:fixed;left:50%;bottom:22px;transform:translateX(-50%) translateY(16px);opacity:0;background:#fff;color:#070708;font-family:var(--mono);font-size:13px;padding:10px 15px;border-radius:9px;pointer-events:none;transition:.2s;z-index:60}#toast.show{opacity:1;transform:translateX(-50%)}#toast b{color:var(--teal)}
  .fbar{flex-wrap:wrap}
  .run:disabled{opacity:.55;cursor:progress;transform:none}
  .sess{font-family:var(--mono);font-size:12.5px;color:var(--muted);padding:5px 2px;display:none;align-items:center;gap:7px;white-space:nowrap;max-width:100%;overflow:hidden;text-overflow:ellipsis;margin-bottom:2px}
  .sess.on{display:inline-flex}
  .sess b{color:var(--text)}.sess a{color:var(--cyan);text-decoration:none}
  .run:disabled{animation:none}
  .instr-row{display:none;align-items:center;gap:10px;margin:-4px 0 12px;flex-wrap:wrap}
  .instr-row .tfield{min-width:0}
  .runghost{visibility:hidden;pointer-events:none}
  .egs{display:flex;gap:7px;flex-wrap:wrap;margin:-4px 0 12px}
  .egs button{font-family:var(--mono);font-size:11px;color:var(--muted);background:transparent;border:1px dashed var(--line);border-radius:14px;padding:3px 10px;cursor:pointer}
  .egs button:hover{color:var(--cyan);border-color:var(--cyl)}
  .instr-row.on{display:flex}
  .deep-row{display:none;align-items:center;gap:8px;margin:-4px 0 12px;font-family:var(--mono);font-size:12.5px;color:var(--muted)}
  .deep-row.on{display:flex}
  .deep-row label{display:inline-flex;align-items:center;gap:8px;cursor:pointer;color:var(--muted)}
  .deep-row input{accent-color:var(--cyan);width:14px;height:14px;cursor:pointer}
  .deep-row .dhint{color:var(--muted)}
  .xtag{display:inline-block;font-size:9px;letter-spacing:.08em;text-transform:uppercase;color:#f5a300;border:1px solid #f5a300;border-radius:3px;padding:0 4px;margin-left:5px;vertical-align:middle;opacity:.85}
  .ft .xtag{font-size:8px;padding:0 3px}
  .instr-row .verb2{font-family:var(--mono);font-size:12.5px;color:var(--muted);flex:none}
  h2 .anch{opacity:0;font-weight:400;color:var(--dim);font-size:14px;text-decoration:none;transition:opacity .15s}
  h2:hover .anch{opacity:1}
  h2 .anch:hover{color:var(--cyan)}
  .soonchip{flex:none;font-family:var(--mono);font-size:11px;color:var(--dim);border:1px dashed var(--line);border-radius:6px;padding:5px 9px;cursor:default}
:focus-visible{outline:2px solid var(--cyan);outline-offset:2px;border-radius:6px}
  @media(prefers-reduced-motion:reduce){*{animation-duration:.001ms!important;transition-duration:.001ms!important}}

  /* ===================== mobile app-shell =====================
     Inert above 680px (desktop pays zero bytes of layout change).
     Below it the page becomes a native-feeling app: a fixed top
     app-bar + a bottom tab bar, content scrolling between them,
     and the card sections turn into horizontal swipe rails. */
  .appbar,.tabbar{display:none}
  @media(max-width:680px){
    /* --- fixed top app-bar --- */
    .appbar{display:flex;position:fixed;top:0;left:0;right:0;z-index:40;align-items:center;gap:10px;
      height:calc(52px + env(safe-area-inset-top));padding:env(safe-area-inset-top) 15px 0;
      background:rgba(7,7,8,.82);backdrop-filter:blur(12px);-webkit-backdrop-filter:blur(12px);border-bottom:1px solid var(--hair)}
    .appbar .brand{display:flex;align-items:center;gap:8px;font-family:var(--mono);font-weight:700;font-size:15px;color:#fff}
    .appbar .brand .mark{height:18px;width:18px;margin:0}
    .appbar .adot{width:7px;height:7px;border-radius:50%;background:var(--teal);display:none}
    .appbar .adot.on{display:inline-block}
    .appbar .themetog{margin-left:auto;font-size:14px;padding:6px 9px}
    .appbar .getk{margin-left:8px;font-family:var(--mono);font-size:12px;font-weight:600;color:var(--on);
      background:var(--cyan);border:0;border-radius:8px;padding:8px 13px;cursor:pointer}
    /* --- fixed bottom tab bar --- */
    .tabbar{display:flex;position:fixed;left:0;right:0;bottom:0;z-index:40;
      padding:0 6px env(safe-area-inset-bottom);height:calc(58px + env(safe-area-inset-bottom));
      background:rgba(7,7,8,.9);backdrop-filter:blur(12px);-webkit-backdrop-filter:blur(12px);border-top:1px solid var(--hair)}
    .tabbar a{flex:1;display:flex;flex-direction:column;align-items:center;justify-content:center;gap:3px;
      font-family:var(--mono);font-size:10px;color:var(--dim);text-decoration:none;padding-top:8px;min-width:0}
    .tabbar a:hover{text-decoration:none}
    .tabbar a .ic{font-size:16px;line-height:1}
    .tabbar a[aria-current=true]{color:var(--cyan)}
    .tabbar a.key{color:var(--cyan)}
    /* --- clear the fixed chrome --- */
    body{padding-top:calc(52px + env(safe-area-inset-top));padding-bottom:calc(58px + env(safe-area-inset-bottom))}
    .doc{padding:14px 15px 26px}
    .tabrow .filetab{display:none}      /* the app-bar replaces the README tab chrome */
    .tabrow .themetog{display:none}     /* the app-bar carries the theme toggle on mobile */
    .sheet{border:0;border-radius:0;padding:4px 0 0;background:none}
    .trend{position:static;top:auto;right:auto}
    /* --- hero text shape --- */
    .tabrow .sess,.tabrow .sess.on{display:none}  /* app-bar dot shows signed-in; drop the long line */
    .tabrow .oss,.tabrow .signin,.tabrow .getk{display:none}  /* desktop-only doors; the app-bar carries Get-a-key on mobile */
    .eyebrow{font-size:12px;margin:0 0 10px;flex-wrap:nowrap}
    .ebfull{display:none}.ebshort{display:inline}  /* short teaser fits without orphan-wrapping */
    h1{font-size:24px;line-height:1.16}
    h1 .cloud{display:block;margin-top:1px}       /* "now available on Cloud" as its own clean line */
    .sub{font-size:14.5px}
    /* hero proof: WRAP so every badge is visible - no hidden horizontal scroll */
    .proof{flex-wrap:wrap;gap:9px 10px;margin-top:16px}
    .shield.hide-m{display:none}                  /* drop the long python-versions badge on phones */
    /* the logo strip stays a swipe row */
    .logos{flex-wrap:nowrap;overflow-x:auto;-webkit-overflow-scrolling:touch;scrollbar-width:none;padding-bottom:2px}
    .logos>*{flex:none}
    .logos::-webkit-scrollbar,.recs::-webkit-scrollbar,.paths::-webkit-scrollbar,
    .ptab::-webkit-scrollbar,.egs::-webkit-scrollbar{display:none}
    /* --- playground: a full-width, thumb-reach Run --- */
    .targetrow{flex-wrap:wrap}
    .targetrow .verb{order:1}
    .targetrow .tfield{order:2;flex-basis:100%}
    .targetrow .run{order:3;width:100%;margin-top:9px;padding:12px;font-size:13px}
    /* iOS zooms any input under 16px on focus - pin them to 16px on mobile so it never does */
    .tfield .target,.mintform input,.minterr,#mintpop input{font-size:16px}
    /* example chips: one swipe row (not a wrapped clump); the active one is lit */
    .egs{flex-wrap:nowrap;overflow-x:auto;-webkit-overflow-scrolling:touch;scrollbar-width:none;margin:-2px 0 12px;padding:2px 0}
    .egs button{flex:none}
    .egs button.on{color:var(--cyan);border-style:solid;border-color:var(--cyl);background:rgba(74,230,229,.08)}
    /* curl command: compact so the long token wraps tidily instead of sprawling */
    .cmd{font-size:11px;line-height:1.75}
    .fbody{padding:12px}
    .ep{font-size:10px}
    /* ===== horizontal scroll cards (the native pattern) ===== */
    .recs,.paths{display:flex;flex-direction:row;flex-wrap:nowrap;overflow-x:auto;gap:12px;
      scroll-snap-type:x mandatory;-webkit-overflow-scrolling:touch;scrollbar-width:none;
      margin:14px 0 0;padding:2px 0 4px}  /* sit in the 15px content inset - first card lines up with the text */
    .recs .rec,.paths .path{flex:0 0 84%;scroll-snap-align:start;grid-template-columns:1fr}
    .paths .path{display:flex;flex-direction:column}
    /* pricing table -> swipeable tier cards */
    .ptab{border:0;overflow:visible;display:flex;flex-wrap:nowrap;overflow-x:auto;gap:12px;
      scroll-snap-type:x mandatory;-webkit-overflow-scrolling:touch;scrollbar-width:none;
      border-radius:0;margin:14px 0 0;padding:2px 0 4px}
    .ptab .prow:first-child{display:none}     /* the table header row is meaningless as a card */
    .ptab .prow{display:flex;flex-direction:column;gap:9px;flex:0 0 80%;scroll-snap-align:start;
      border:1px solid var(--line);border-radius:12px;background:var(--surf);padding:16px}
    .ptab .prow.free{border-color:var(--cyl);box-shadow:inset 0 0 0 1px rgba(74,230,229,.06)}
    .ptab .prow>div{padding:0;white-space:normal;overflow:visible}
    .ptab .prow .tier{font-size:15px}
    .ptab .prow .amt{font-size:20px}
    .ptab .prow .for{font-size:12.5px}
  }
.ghnote{margin-top:14px;font-family:var(--mono);font-size:13px;color:var(--muted);border-left:3px solid #4493f8;padding:2px 0 2px 14px}
.ghnote .t{color:#4493f8;font-weight:600;margin-bottom:4px}
:root[data-theme="light"] .ghnote{border-left-color:#0969da}:root[data-theme="light"] .ghnote .t{color:#0969da}
[data-if][hidden]{display:none!important}
.tryline{margin:14px 0 0;font-family:var(--mono);font-size:13px;color:var(--muted)}.tryline b{color:var(--cyan)}
.ptab .prow{grid-template-columns:150px minmax(0,1.3fr) minmax(0,1.7fr)}
.bill{display:inline-flex;margin:16px 0 0;border:1px solid var(--line);border-radius:9px;overflow:hidden;font-family:var(--mono);font-size:13px}
.bill button{background:none;border:0;color:var(--muted);padding:7px 14px;cursor:pointer;font:inherit}.bill button.on{background:var(--hair);color:#fff}
.bill button b{color:var(--cyan);font-weight:600}:root[data-theme="light"] .bill button.on{color:#111}
.amt .billed{display:block;font-size:12px;color:var(--muted);font-weight:400;margin-top:2px}
@media (max-width:640px){.ptab .prow{grid-template-columns:96px minmax(0,1fr) minmax(0,1.2fr)}}
.costline b{color:var(--cyan);font-weight:600}
.cmph{margin:22px 0 0;font-family:var(--mono);font-size:14px;color:#fff;font-weight:700}.cmph small{color:var(--muted);font-weight:400;font-size:12px;margin-left:8px}
.cmp{margin-top:10px;border:1px solid var(--line);border-radius:11px;overflow:hidden;font-family:var(--mono);font-size:13px}
.crow{display:grid;grid-template-columns:minmax(0,1.6fr) repeat(3,minmax(0,1fr));border-top:1px solid var(--hair)}.crow:first-child{border-top:0}
.crow>div{padding:9px 12px}.crow.h{color:var(--muted);font-size:12px}.crow .who small,.crow small{display:block;color:var(--muted);font-size:11.5px}
.crow.us{background:rgba(74,230,229,.05)}.crow.us>div{color:var(--cyan)}.crow .na{color:var(--muted)}
.cmpnote{margin:8px 0 0;font-family:var(--mono);font-size:12.5px;color:var(--muted)}.cmpnote b{color:var(--cyan);font-weight:600}
@media (max-width:640px){.crow{grid-template-columns:minmax(0,1.25fr) repeat(3,minmax(0,1fr));font-size:12px}.crow>div{padding:8px}}
.costline{display:block;margin-top:10px;font-family:var(--mono);font-size:12.5px;color:var(--muted);background:var(--code);border:1px solid var(--line);border-radius:8px;padding:9px 12px;overflow-x:auto;white-space:nowrap}
</style>
</head>
<body>
<noscript><div style="font-family:monospace;color:#f5a300;background:#0d0d10;border:1px solid rgba(233,233,237,.1);border-radius:9px;padding:10px 14px;max-width:820px;margin:20px auto 0">the playground needs JavaScript - the docs at <a style="color:#4AE6E5" href="https://docs.crawl4ai.com">docs.crawl4ai.com</a> work without it</div></noscript>
