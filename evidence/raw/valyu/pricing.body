 py-5"><span class="text-[14px] font-medium text-[#17141A]">Best for</span></td><td class="border-l border-[#F1EFF3] px-5 py-5 text-center"><span class="text-[14px] text-[#54525c]">RAG pipelines, agent tool calls</span></td><td class="border-l border-[#F1EFF3] px-5 py-5 text-center"><span class="text-[14px] text-[#54525c]">Web content fetching, content ingestion</span></td><td class="border-l border-[#F1EFF3] px-5 py-5 text-center"><span class="text-[14px] text-[#54525c]">Chat apps, question answering</span></td><td class="border-l border-[#F1EFF3] px-5 py-5 text-center"><span class="text-[14px] text-[#54525c]">Deep research, comprehensive analysis</span></td></tr><tr class="border-b border-[#F1EFF3] transition-colors hover:bg-[#FBFAFB]"><td class="px-5 py-5"><span class="text-[14px] font-medium text-[#17141A]">Latency</span></td><td class="border-l border-[#F1EFF3] px-5 py-5 text-center"><span class="text-[14px] text-[#54525c]">&lt; 3s, synchronous</span></td><td class="border-l border-[#F1EFF3] px-5 py-5 text-center"><span class="text-[14px] text-[#54525c]">&lt; 1-3s, synchronous,  &lt;5-8s synchronous with headless browsing</span></td><td class="border-l border-[#F1EFF3] px-5 py-5 text-center"><span class="text-[14px] text-[#54525c]">&lt; 5s, synchronous</span></td><td class="border-l border-[#F1EFF3] px-5 py-5 text-center"><span class="text-[14px] text-[#54525c]">5-180 min, asynchronous</span></td></tr><tr class="border-b border-[#F1EFF3] transition-colors hover:bg-[#FBFAFB]"><td class="px-5 py-5"><span class="text-[14px] font-medium text-[#17141A]">Pricing</span></td><td class="border-l border-[#F1EFF3] px-5 py-5 text-center"><span class="text-[14px] text-[#54525c]">Per retrieval (CPM) $0.50–$30 by source</span></td><td class="border-l border-[#F1EFF3] px-5 py-5 text-center"><span class="text-[14px] text-[#54525c]">Per successful URL $0.001 + AI</span></td><td class="border-l border-[#F1EFF3] px-5 py-5 text-center"><span class="text-[14px] text-[#54525c]">Search costs + $12/M tokens</span></td><td class="border-l border-[#F1EFF3] px-5 py-5 text-center"><span class="text-[14px] text-[#54525c]">Fixed per task $0.10–$15</span></td></tr></tbody></table></div></div></section></div></section><section class="section-wrapper w-full" data-cta-location="v2FeatureRow" data-cta-block-type="v2FeatureRow" data-cta-block-index="2"><div class="section-container relative w-full border-x !border-0 !border-t-0 !border-b-0 !border-l-0 !border-r-0"><div class="v2-scope bg-white"><div class="mx-auto grid max-w-[1360px] grid-cols-1 items-center gap-12 px-5 py-16 sm:px-10 lg:grid-cols-2 lg:gap-24 lg:py-[104px]"><div><div class="mb-4 text-[12px] font-semibold leading-none text-[#7D4A6F]" style="font-family:var(--font-v2-mono), ui-monospace, monospace;letter-spacing:.16em">PUBLISHER LICENSING AND USAGE</div><h2 class="m-0 mb-4 font-medium text-[#17141A]" style="font-family:var(--font-v2-serif), Georgia, serif;font-size:clamp(28px, 2.9vw, 36px);line-height:1.06;letter-spacing:-0.015em">Content Owners</h2><p class="m-0 max-w-[480px] whitespace-pre-line text-[16px] leading-[1.6] text-[#54525c]">This page reflects what developers pay for our search infrastructure. If you&#x27;re a publisher or data provider, your content is licensed accordingly with full usage tracking and revenue share.</p></div><div><div class="w-full"><div class="mb-4 text-[12px] font-semibold leading-none text-[#7D4A6F]" style="font-family:var(--font-v2-mono), ui-monospace, monospace;letter-spacing:.16em">INCLUDED DATASETS</div><div class="flex flex-col gap-[10px]"><div class="flex h-full items-center gap-3 p-3" style="background:#F3ECF2;border:1.5px solid #5E3454"><span class="h-9 w-9 flex-none" style="background:#5E3454"><span class="flex h-full w-full items-center justify-center text-[13px] leading-none text-[#C7E04A]">✓</span></span><span class="min-w-0 flex-1"><span class="block truncate text-[13.5px] font-semibold leading-tight text-[#17141A]">Your data</span><span class="mt-[3px] block truncate text-[10px] font-medium leading-tight text-[#8C8A93]" style="font-family:var(--font-v2-mono), ui-monospace, monospace;letter-spacing:.06em">CUSTOM DATASETS</span></span><span class="h-[10px] w-[10px] flex-none" style="background:#C7E04A;border:none"></span></div><div class="grid grid-cols-1 gap-[10px] sm:grid-cols-2"><div class="flex h-full items-center gap-3 p-3" style="background:#fff;border:1px solid #E7E5EA"><span class="h-9 w-9 flex-none" style="background:#F1EFF3"></span><span class="min-w-0 flex-1"><span class="block truncate text-[13.5px] font-semibold leading-tight text-[#17141A]">Research &amp; Academic</span><span class="mt-[3px] block truncate text-[10px] font-medium leading-tight text-[#8C8A93]" style="font-family:var(--font-v2-mono), ui-monospace, monospace;letter-spacing:.06em">SCIENTIFIC PAPERS</span></span><span class="h-[10px] w-[10px] flex-none" style="background:transparent;border:1px solid #D9D5DF"></span></div><div class="flex h-full items-center gap-3 p-3" style="background:#fff;border:1px solid #E7E5EA"><span class="h-9 w-9 flex-none" style="background:#F1EFF3"></span><span class="min-w-0 flex-1"><span class="block truncate text-[13.5px] font-semibold leading-tight text-[#17141A]">Healthcare &amp; Medical</span><span class="mt-[3px] block truncate text-[10px] font-medium leading-tight text-[#8C8A93]" style="font-family:var(--font-v2-mono), ui-monospace, monospace;letter-spacing:.06em">MEDICAL RESEARCH</span></span><span class="h-[10px] w-[10px] flex-none" style="background:transparent;border:1px solid #D9D5DF"></span></div><div class="flex h-full items-center gap-3 p-3" style="background:#fff;border:1px solid #E7E5EA"><span class="h-9 w-9 flex-none" style="background:#F1EFF3"></span><span class="min-w-0 flex-1"><span class="block truncate text-[13.5px] font-semibold leading-tight text-[#17141A]">Patents &amp; IP</span><span class="mt-[3px] block truncate text-[10px] font-medium leading-tight text-[#8C8A93]" style="font-f