pace, monospace\",\"letterSpacing\":\".06em\"},\"children\":\"SCIENTIFIC PAPERS\"}]]}],[\"$\",\"span\",null,{\"className\":\"h-[10px] w-[10px] flex-none\",\"style\":{\"background\":\"transparent\",\"border\":\"1px solid #D9D5DF\"}}]]}],[\"$\",\"div\",\"Healthcare \u0026 Medical\",{\"className\":\"flex h-full items-center gap-3 p-3\",\"style\":{\"background\":\"#fff\",\"border\":\"1px solid #E7E5EA\"},\"children\":[[\"$\",\"span\",null,{\"className\":\"h-9 w-9 flex-none\",\"style\":{\"background\":\"#F1EFF3\"},\"children\":\"$undefined\"}],[\"$\",\"span\",null,{\"className\":\"min-w-0 flex-1\",\"children\":[[\"$\",\"span\",null,{\"className\":\"block truncate text-[13.5px] font-semibold leading-tight text-[#17141A]\",\"children\":\"Healthcare \u0026 Medical\"}],[\"$\",\"span\",null,{\"className\":\"mt-[3px] block truncate text-[10px] font-medium leading-tight text-[#8C8A93]\",\"style\":{\"fontFamily\":\"var(--font-v2-mono), ui-monospace, monospace\",\"letterSpacing\":\".06em\"},\"children\":\"MEDICAL RESEARCH\"}]]}],\"$L8a\"]}],\"$L8b\",\"$L8c\",\"$L8d\",\"$L8e\",\"$L8f\",\"$L90\"]}]]}]]}]}]]}]}]}]}]\n65:[\"$\",\"section\",\"3\",{\"id\":\"$undefined\",\"ref\":\"$undefined\",\"className\":\"section-wrapper w-full\",\"data-cta-location\":\"v2Faq\",\"data-cta-block-type\":\"v2Faq\",\"data-cta-block-index\":3,\"children\":[\"$\",\"div\",null,{\"className\":\"section-container relative w-full border-x !border-0 !border-t-0 !border-b-0 !border-l-0 !border-r-0\",\"children\":[\"$\",\"$L91\",null,{\"blockType\":\"v2Faq\",\"layout\":\"split\",\"eyebrow\":\"FAQ\",\"heading\":\"FAQs\",\"hideTopBorder\":false,\"faqs\":[{\"question\":\"What happens if I use more than my monthly credits?\",\"answer\":\"Once your monthly credits are used, requests draw on any top-up credits you have. When your balance hits zero, new requests are paused until you add credits, so you never get a surprise overage bill. We email you at 80% and 95% of your monthly credits, and you can turn on auto top-up to keep requests running.\",\"id\":\"6a4bcc94c1d8fb2c4299ed96\"},{\"question\":\"Can I switch plans mid-month?\",\"answer\":\"Yes. Upgrade anytime and we'll prorate the difference. Downgrade takes effect next billing cycle.\",\"id\":\"6a4bcc94c1d8fb2c4299ed97\"},{\"question\":\"Why do different data sources cost different amounts?\",\"answer\":\"Some data is free to access. Some we pay to license. Web and arXiv are cheap. SEC filings and patents cost more. Proprietary journals and premium databases cost the most. You pay for what you use — we're not hiding expensive sources behind a flat rate.\",\"id\":\"6a4bcc94c1d8fb2c4299ed98\"},{\"question\":\"How does Search API pricing work?\",\"answer\":\"Per retrieval, priced by source type. Open sources like arXiv and PubMed are $0.50 per 1k. Web is $1.50 per 1k. Financial data is $8 per 1k. Proprietary databases run $30-50 per 1k. You can set a max price to cap what you spend per query.\",\"id\":\"6a4bcc94c1d8fb2c4299ed99\"},{\"question\":\"How does Answer API pricing work?\",\"answer\":\"Two meters running. First, you pay for the search data (same rates as Search API). Second, you pay for the AI processing — $12 per million tokens. A typical query costs a few cents.\",\"id\":\"6a4bcc94c1d8fb2c4299ed9a\"},{\"question\":\"How does DeepResearch pricing work?\",\"answer\":\"Fixed price per task. Fast is $0.10, Standard is $0.50, Heavy is $2.50, Max is $15. Optional tools add a small surcharge: screenshots $0.05 per URL, code execution $0.10 per run, deliverables $0.10 each after the first (first deliverable and charts are free). Every response returns the exact cost with a per-tool breakdown.\",\"id\":\"6a4bcc94c1d8fb2c4299ed9b\"},{\"question\":\"What happens when I run out of credits?\",\"answer\":\"New requests return a 402 insufficient_credits error until you top up, turn on auto top-up or move to a plan. We don't bill overage, so there are no surprise invoices. Auto top-up charges your saved card a fixed amount (from $10) whenever your balance drops below a threshold you set.\",\"id\":\"6a4bcc94c1d8fb2c4299ed9c\"}],\"id\":\"6a4bcc94c1d8fb2c4299ed9d\",\"disableInnerContainer\":true}]}]}]\n52:null\n"])</script><script>self.__next_f.push([1,"66:[\"$\",\"span\",null,{\"className\":\"text-[13px] leading-[1.5] text-[#54525c]\",\"children\":\"BioRxiv\"}]\n67:[\"$\",\"span\",null,{\"className\":\"mt-[3px] inline-flex h-[14px] w-[14px] flex-none items-center justify-center bg-[#17141A] text-[8px] leading-none text-[#C7E04A]\",\"children\":\"✓\"}]\n68:[\"$\",\"span\",null,{\"className\":\"text-[13px] leading-[1.5] text-[#54525c]\",\"children\":\"Market Movers\"}]\n69:[\"$\",\"li\",\"6973c2add9fe7deab4c4571e\",{\"className\":\"flex items-start gap-[9px]\",\"children\":[[\"$\",\"span\",null,{\"className\":\"mt-[3px] inline-flex h-[14px] w-[14px] flex-none items-center justify-center bg-[#17141A] text-[8px] leading-none text-[#C7E04A]\",\"children\":\"✓\"}],[\"$\",\"span\",null,{\"className\":\"text-[13px] leading-[1.5] text-[#54525c]\",\"children\":\"BLS\"}]]}]\n6a:[\"$\",\"li\",\"6973c2aed9fe7deab4c45720\",{\"className\":\"flex items-start gap-[9px]\",\"children\":[[\"$\",\"span\",null,{\"className\":\"mt-[3px] inline-flex h-[14px] w-[14px] flex-none items-center justify-center bg-[#17141A] text-[8px] leading-none text-[#C7E04A]\",\"children\":\"✓\"}],[\"$\",\"span\",null,{\"className\":\"text-[13px] leading-[1.5] text-[#54525c]\",\"children\":\"World Bank\"}]]}]\n6b:[\"$\",\"div\",null,{\"className\":\"mt-auto pt-7\",\"children\":[\"$\",\"$L42\",null,{\"href\":\"https://platform.valyu.ai/\",\"className\":\"block whitespace-nowrap bg-[#5E3454] px-5 py-3 text-center text-[14px] font-semibold text-white transition-colors hover:bg-[#4d2a45]\",\"data-cta-location\":\"pricing_plan\",\"data-cta-label\":\"Get Started\",\"data-cta-plan\":\"Comfortably Pro\",\"children\":\"Get Started\"}]}]\n6c:[\"$\",\"span\",null,{\"className\":\"mt-[3px] inline-flex h-[14px] w-[14px] flex-none items-center justify