0\",\"style\":{\"background\":\"linear-gradient(to top, rgba(15,13,18,.88) 0%, rgba(15,13,18,.45) 34%, rgba(15,13,18,0) 62%)\"}}],[\"$\",\"div\",null,{\"className\":\"absolute bottom-0 left-0 right-0 p-6 sm:p-8\",\"children\":[[\"$\",\"div\",null,{\"className\":\"mb-3 font-medium text-white\",\"style\":{\"fontFamily\":\"var(--font-v2-serif), Georgia, serif\",\"fontSize\":\"clamp(18px, 1.8vw, 24px)\",\"letterSpacing\":\"-0.02em\"},\"children\":\"Finance\"}],[\"$\",\"p\",null,{\"className\":\"m-0 max-w-[420px] text-[13.5px] leading-[1.55] text-white/[.82]\",\"children\":\"Company filings, earnings, market data, economic indicators, prediction markets and financial reporting.\"}],[\"$\",\"$L3e\",null,{\"href\":\"/finance\",\"className\":\"mt-5 inline-flex items-center gap-[9px] text-white/[.72] transition-colors hover:text-white\",\"children\":[[\"$\",\"svg\",null,{\"width\":\"17\",\"height\":\"17\",\"viewBox\":\"0 0 17 17\",\"fill\":\"none\",\"children\":[[\"$\",\"path\",null,{\"d\":\"M3 3v6.5h9\",\"stroke\":\"currentColor\",\"strokeWidth\":\"1.4\"}],[\"$\",\"path\",null,{\"d\":\"M9.5 6.5 12.5 9.5 9.5 12.5\",\"stroke\":\"currentColor\",\"strokeWidth\":\"1.4\",\"strokeLinecap\":\"round\",\"strokeLinejoin\":\"round\"}]]}],[\"$\",\"span\",null,{\"className\":\"text-[13.5px] font-medium\",\"children\":\"Learn more\"}]]}]]}]]}],[\"$\",\"div\",null,{\"className\":\"mt-5 flex flex-wrap gap-2\",\"children\":[[\"$\",\"span\",\"6a4bb898f35e1e8ec3cc9ab6\",{\"className\":\"border border-[#17141A]/[.28] px-[10px] py-[6px] text-[12px] font-medium text-[#17141A]\",\"children\":\"Investment research\"}],[\"$\",\"span\",\"6a4bb898f35e1e8ec3cc9ab7\",{\"className\":\"border border-[#17141A]/[.28] px-[10px] py-[6px] text-[12px] font-medium text-[#17141A]\",\"children\":\"Financial modelling\"}],[\"$\",\"span\",\"6a4bb898f35e1e8ec3cc9ab8\",{\"className\":\"border border-[#17141A]/[.28] px-[10px] py-[6px] text-[12px] font-medium text-[#17141A]\",\"children\":\"Due diligence\"}],[\"$\",\"span\",\"6a4bb898f35e1e8ec3cc9ab9\",{\"className\":\"border border-[#17141A]/[.28] px-[10px] py-[6px] text-[12px] font-medium text-[#17141A]\",\"children\":\"Market monitoring\"}],[\"$\",\"span\",\"6a4bb898f35e1e8ec3cc9aba\",{\"className\":\"border border-[#17141A]/[.28] px-[10px] py-[6px] text-[12px] font-medium text-[#17141A]\",\"children\":\"Macro analysis\"}]]}]]}],[\"$\",\"div\",\"6a4bb898f35e1e8ec3cc9ac1\",{\"children\":[[\"$\",\"div\",null,{\"className\":\"relative h-[420px] overflow-hidden bg-[#17141A] lg:h-[540px]\",\"children\":[\"$L7c\",\"$L7d\",\"$L7e\"]}],\"$L7f\"]}]]}]]}]}]}]}]\n5a:[\"$\",\"section\",\"6\",{\"id\":\"$undefined\",\"ref\":\"$undefined\",\"className\":\"section-wrapper w-full\",\"data-cta-location\":\"v2Benchmarks\",\"data-cta-block-type\":\"v2Benchmarks\",\"data-cta-block-index\":6,\"children\":[\"$\",\"div\",null,{\"className\":\"section-container relative w-full border-x !border-0 !border-t-0 !border-b-0 !border-l-0 !border-r-0\",\"children\":[\"$\",\"$L80\",null,{\"blockType\":\"v2Benchmarks\",\"heading\":\"State-of-the-art across research benchmarks.\",\"style\":\"default\",\"accent\":\"plum\",\"hideTopBorder\":false,\"readMoreLabel\":\"Read more →\",\"readMoreLink\":\"/blogs/benchmarking-search-apis-for-ai-agents\",\"benchmarks\":[{\"name\":\"DRACO\",\"readMoreLink\":\"https://github.com/valyuAI/valyu-benchmarks\",\"displayType\":\"dracoChart\",\"about\":\"Long-form research evaluation measuring accuracy against cost across leading deep-research systems.\",\"sections\":[{\"title\":\"About the benchmark\",\"text\":\"DRACO is Perplexity's open expert-rubric benchmark of 100 long-form deep research tasks across 10 professional knowledge-work domains, including finance, medicine, academic research, law, and technology. Each output is graded by a per-criterion judge against a domain-expert rubric. We ran every commercially available deep research API end-to-end against the same 100 questions.\\nEvery search and research API was tested on its highest publicly-available compute tier. Parallel (Ultra8x), You(.)com Research (exhaustive), Tavily (pro), Exa (deep-reasoning), and Perplexity Deep Research (Opus 4.6). Valyu was run on Heavy mode; we offer a higher Max tier but did not use it here, since Max is more expensive per task than the field.\",\"id\":\"6a4cf5ba905dd22c8afe3f31\"},{\"title\":\"Evaluation\",\"text\":\"Valyu DeepResearch achieved 72.7% accuracy on the DRACO long-form research benchmark, outperforming Perplexity Deep Research (70.5%), Claude Opus 4.6 (59.8%), Gemini Deep Research (59.0%), and OpenAI Deep Research o3 (52.1%), while operating at less than half the cost of the next-best system.\",\"id\":\"6a4cf5ba905dd22c8afe3f32\"}],\"caption\":\"accuracy on long-form research · cost per 1k requests\",\"rows\":[{\"name\":\"Valyu DeepResearch\",\"value\":72.7,\"cost\":\"$$2,500\",\"id\":\"6a4cf5456c442225fcaed46c\"},{\"name\":\"Perplexity DR (Opus 4.6)\",\"value\":70.5,\"cost\":\"$$5,500\",\"id\":\"6a4cf5456c442225fcaed46d\"},{\"name\":\"Claude Opus 4.6 (web+code)\",\"value\":59.8,\"cost\":\"$$5,500\",\"id\":\"6a4cf5456c442225fcaed46e\"},{\"name\":\"Gemini Deep Research\",\"value\":59,\"cost\":\"$$4,500\",\"id\":\"6a4cf5456c442225fcaed46f\"},{\"name\":\"OpenAI DR (o3)\",\"value\":52.1,\"cost\":\"$$3,500\",\"id\":\"6a4cf5456c442225fcaed470\"}],\"id\":\"6a4cf5456c442225fcaed471\"},{\"name\":\"FreshQA\",\"readMoreLink\":\"/blogs/benchmarking-search-apis-for-ai-agents\",\"displayType\":\"bars\",\"about\":\"600 time-sensitive questions testing how well APIs handle recent and evolving information.\",\"sections\":[{\"title\":\"About the benchmark\",\"text\":\"FreshQA is updated roughly every week, contains 600 time-sensitive questions that assess how effectively APIs handle recent and evolving information. The benchmark is critical for use cases such as news summarization, event tracking, and trend monitoring. Our evaluation used the Aug 27th test set, the most recent release available at the time of testing.\",\"id\":\"6a4cf6d95e1d583c80b90ad1\"},{\"title\":\"Evaluation\",\"text\":\"FreshQA was evaluated by comparing four search solutions (Valyu, Parallel, Google, Exa) on time-sensitive queries. Valyu achieved the highest performance at 79.0% accuracy, significantly outperforming others.\",\"id\":\"6a4cf6d95e1d583c80b90ad2\"}],\"caption\":\"accuracy on time-sensitive questions\",\"rows\":[{\"name\":\"Valyu\",\"value\":79,\"id\":\"6a4cf5456c442225fcaed472\"},{\"name\":\"Parallel\",\"value\":52,\"id\":\"6a4cf5456c442225fcaed473\"},{\"name\":\"Google\",\"value\":39,\"id\":\"6a4cf5456c442225fcaed474\"},{\"name\":\"Exa\",\"value\":24,\"id\":\"6a4cf5456c442225fcaed475\"}],\"id\":\"6a4cf5456c442225fcaed476\"},{\"name\":\"SimpleQA\",\"readMoreLink\":\"/blogs/benchmarking-search-apis-for-ai-agents\",\"displayType\":\"bars\",\"about\":\"4,326 factual questions from OpenAI measuring retrieval precision on straightforward queries.\",\"sections\":[{\"title\":\"About the benchmark\",\"text\":\"SimpleQA, created by OpenAI, includes 4,326 factual questions designed to measure retrieval precision on straightforward, unambiguous queries. The benchmark serves as the baseline for evaluating general-purpose search quality and factual accuracy, covering diverse topics from science and technology to TV shows and video games.\",\"id\":\"6a4cf6d95e1d583c80b90ad3\"},{\"title\":\"Evaluation\",\"text\":\"Valyu achieved 94% accuracy on SimpleQA, outperforming other search APIs.\",\"id\":\"6a4cf6d95e1d583c80b90ad4\"}],\"caption\":\"retrieval precision on factual questions\",\"rows\":[{\"name\":\"Valyu\",\"value\":94,\"id\":\"6a4cf5456c442225fcaed477\"},{\"name\":\"Parallel\",\"value\":93,\"id\":\"6a4cf5456c442225fcaed478\"},{\"name\":\"Exa\",\"value\":91,\"id\":\"6a4cf5456c442225fcaed479\"},{\"name\":\"Google\",\"value\":38,\"id\":\"6a4cf5456c442225fcaed47a\"}],\"id\":\"6a4cf5456c442225fcaed47b\"},{\"name\":\"Finance\",\"readMoreLink\":\"/blogs/benchmarking-search-apis-for-ai-agents\",\"displayType\":\"bars\",\"about\":\"Analyst-style questions over filings, market data and reporting, simulating real financial research.\",\"sections\":[{\"title\":\"About the benchmark\",\"text\":\"The Financial Benchmark assesses API performance through 120 queries distributed across seven datasets covering critical financial domains. The benchmark simulates real-world financial information retrieval scenarios across regulatory, academic, and market-specific contexts.\",\"id\":\"6a4cf6d95e1d583c80b90ad5\"},{\"title\":\"Distribution\",\"text\":\"The 120 queries span seven financial datasets: SEC Filings, References, Financial news and reports, Stocks, Forex, Insider Transactions and Crypto.\",\"id\":\"6a4cf6d95e1d583c80b90ad6\"},{\"title\":\"Evaluation\",\"text\":\"Valyu achieved 72.5% overall accuracy, significantly outperforming Exa (62.5%) and Google (55%) on financial queries\",\"id\":\"6a4cf6d95e1d583c80b90ad7\"}],\"caption\":\"accuracy on financial research questions\",\"rows\":[{\"name\":\"Valyu\",\"value\":70,\"id\":\"6a4cf5456c442225fcaed47c\"},{\"name\":\"Parallel\",\"value\":50,\"id\":\"6a4cf5456c442225fcaed47d\"},{\"name\":\"Exa\",\"value\":47,\"id\":\"6a4cf5456c442225fcaed47e\"},{\"name\":\"Google\",\"value\":41,\"id\":\"6a4cf5456c442225fcaed47f\"}],\"id\":\"6a4cf5456c442225fcaed480\"},{\"name\":\"Economics\",\"readMoreLink\":\"/blogs/benchmarking-search-apis-for-ai-agents\",\"displayType\":\"bars\",\"about\":\"100 of the hardest analyst-style questions drawn from World Bank, BLS and FRED data sources.\",\"sections\":[{\"title\":\"About the benchmark\",\"text\":\"The Economics Benchmark evaluates search performance through 100 of the hardest analyst-style questions curated from authoritative economic data sources. The benchmark draws from World Bank Indicators, Bureau of Labor Statistics (BLS), and Federal Reserve Economic Data (FRED), covering GDP, inflation, employment, productivity, and monetary policy to simulate authentic economic research workflows used in policy analysis and macroeconomic forecasting.\",\"id\":\"6a4cf6d95e1d583c80b90ad8\"},{\"title\":\"Distribution\",\"text\":\"The 100 questions are sourced from: World Bank Indicators (50 questions), BLS (25 questions), and FRED (25 questions), representing the most challenging queries from each dataset.\",\"id\":\"6a4cf6d95e1d583c80b90ad9\"},{\"title\":\"Evaluation\",\"text\":\"Valyu achieved 72.6% overall accuracy, substantially outperforming Parallel (52%), Exa (44.7%), and Google (42.7%) on complex economic queries.\",\"id\":\"6a4cf6d95e1d583c80b90ada\"}],\"caption\":\"accuracy on economic research questions\",\"rows\":[{\"name\":\"Valyu\",\"value\":73,\"id\":\"6a4cf5456c442225fcaed481\"},{\"name\":\"Parallel\",\"value\":52,\"id\":\"6a4cf5456c442225fcaed482\"},{\"name\":\"Exa\",\"value\":45,\"id\":\"6a4cf5456c442225fcaed483\"},{\"name\":\"Google\",\"value\":43,\"id\":\"6a4cf5456c442225fcaed484\"}],\"id\":\"6a4cf5456c442225fcaed485\"},{\"name\":\"MedAgent\",\"readMoreLink\":\"/blogs/benchmarking-search-apis-for-ai-agents\",\"displayType\":\"bars\",\"about\":\"482 challenging questions curated from 10 leading medical benchmarks across clinical knowledge and reasoning.\",\"sections\":[{\"title\":\"About the benchmark\",\"text\":\"MedAgent is a collection of the most difficult questions curated from 10 leading medical benchmarks. The benchmark comprises 482 challenging questions spanning clinical knowledge, drug information, and medical reasoning, designed to test the limits of medical AI capabilities. It includes specialized datasets from Clinical Trials and Drug Labels alongside questions from established medical benchmarks including MMLU, MEDQA, and others.\",\"id\":\"6a4cf6d95e1d583c80b90adb\"},{\"title\":\"Distribution\",\"text\":\"The 482 questions are sourced from: MMLU (50), MEDQA (50), MMLU-PRO (50), MEDEXQA (50), PUBMEDQA (50), MEDMCQA (50), MEDBULLETS (50), AFRIMEDQA (32), MEDXPERTQA-U (50), MEDXPERTQA-R (50).\",\"id\":\"6a4cf6d95e1d583c80b90adc\"},{\"title\":\"Evaluation\",\"text\":\"MedAgent was evaluated by comparing four different search solutions (Valyu, Google, Exa, Parallel) with Valyu with the highest performance of 48.1%. 47.76% overall accuracy with particularly strong results on Clinical Trials and Drug Labels (87.5% each).\",\"id\":\"6a4cf6d95e1d583c80b90add\"}],\"caption\":\"accuracy on hard medical questions\",\"rows\":[{\"name\":\"Valyu\",\"value\":48,\"id\":\"6a4cf5456c442225fcaed486\"},{\"name\":\"Google\",\"value\":45,\"id\":\"6a4cf5456c442225fcaed487\"},{\"name\":\"Exa\",\"value\":44,\"id\":\"6a4cf5456c442225fcaed488\"},{\"name\":\"Parallel\",\"value\":42,\"id\":\"6a4cf5456c442225fcaed489\"}],\"id\":\"6a4cf5456c442225fcaed48a\"},{\"name\":\"ScholarQA\",\"readMoreLink\":\"/blogs/benchmarking-search-apis-for-ai-agents\",\"displayType\":\"bars\",\"about\":\"Leading benchmark for scientific-literature synthesis, published in Nature (Feb 2026).\",\"sections\":[{\"title\":\"About the benchmark\",\"text\":\"ScholarQA is the leading benchmark for evaluating how well AI systems synthesize scientific literature. Published in Nature in February 2026, it was developed by researchers at the University of Washington, Allen Institute for AI, Meta, and Carnegie Mellon.\",\"id\":\"6a4cf6d95e1d583c80b90ade\"},{\"title\":\"Distribution\",\"text\":\"The benchmark comprises 218 expert-annotated questions across two evaluation suites:\\nScholarQA-Multi (108 questions) - multi-domain questions spanning CS (NLP, HCI), Biology (bioimaging, genetics), and Physics (astrophysics, photonics, biophysics), evaluated using the Prometheus open-source LLM judgeScholarQA-CS (110 questions) - computer science questions evaluated against expert-written rubric criteria using GPT-4o as judge\",\"id\":\"6a4cf6d95e1d583c80b90adf\"},{\"title\":\"Evaluation\",\"text\":\"Valyu DeepResearch achieved #1 on both ScholarQA benchmarks. 74.5% vs 57.7% on CS (29% relative improvement), and 4.56 vs 4.51 on Multi - beating OpenScholar, Perplexity, GPT-4o, and PaperQA2.\\nThis was with our fast mode, our lowest cost tier, consuming 2x less compute than our standard mode, 20x less compute than Heavy, and 40x less compute than Max.\",\"id\":\"6a4cf6d95e1d583c80b90ae0\"}],\"caption\":\"accuracy on scientific-literature synthesis\",\"rows\":[{\"name\":\"Valyu\",\"value\":91.2,\"id\":\"6a4cf5456c442225fcaed48b\"},{\"name\":\"OpenScholar\",\"value\":90.2,\"id\":\"6a4cf5456c442225fcaed48c\"},{\"name\":\"Perplexity Pro\",\"value\":83,\"id\":\"6a4cf5456c442225fcaed48d\"},{\"name\":\"PaperQA2\",\"value\":76.4,\"id\":\"6a4cf5456c442225fcaed48e\"}],\"id\":\"6a4cf5456c442225fcaed48f\"}],\"id\":\"6a4cf5456c442225fcaed490\",\"disableInnerContainer\":true}]}]}]\n5b:[\"$\",\"section\",\"7\",{\"id\":\"$undefined\",\"ref\":\"$undefined\",\"className\":\"section-wrapper w-full\",\"data-cta-location\":\"v2Production\",\"data-cta-block-type\":\"v2Production\",\"data-cta-block-index\":7,\"children\":[\"$\",\"div\",null,{\"className\":\"section-container relative w-full border-x !border-0 !border-t-0 !border-b-0 !border-l-0 !border-r-0\",\"children\":[\"$\",\"div\",null,{\"className\":\"v2-scope border-t border-[#E7E5EA] bg-[#FBFAFB] text-[#17141A]\",\"children\":[\"$\",\"div\",null,{\"className\":\"mx-auto max-w-[1360px]\",\"children\":[[\"$\",\"div\",null,{\"className\":\"flex flex-col items-start justify-between gap-8 px-5 pb-[54px] pt-16 sm:px-[46px] lg:flex-row lg:items-end lg:gap-10 lg:pt-[104px]\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"m-0 font-medium\",\"style\":{\"fontFamily\":\"var(--font-v2-serif), Georgia, serif\",\"fontSize\":\"clamp(28px, 2.9vw, 36px)\",\"lineHeight\":1.02,\"letterSpacing\":\"-0.02em\"},\"children\":\"Built for production AI.\"}],[\"$\",\"$L3e\",null,{\"href\":\"/contact\",\"className\":\"flex-none whitespace-nowrap bg-[#5E3454] px-[25px] py-[15px] text-[15px] font-semibold text-white transition-colors hover:bg-[#4d2a45]\",\"children\":\"Talk to us about enterprise deployment\"}]]}],[