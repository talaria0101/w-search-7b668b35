" data-cta-location="v2ProductSplit" data-cta-block-type="v2ProductSplit" data-cta-block-index="4"><div class="section-container relative w-full border-x !border-0 !border-t-0 !border-b-0 !border-l-0 !border-r-0"><div class="v2-scope bg-white text-[#17141A]"><div class="mx-auto max-w-[1360px] border-x border-[#E7E5EA]"><div class="px-5 pb-[54px] pt-16 sm:px-[46px] lg:pt-[100px]"><h2 class="m-0 font-medium" style="font-family:var(--font-v2-serif), Georgia, serif;font-size:clamp(28px, 2.9vw, 36px);line-height:1.02;letter-spacing:-0.02em">One API for search and deep research.</h2></div><div class="grid grid-cols-1 border-t border-[#E7E5EA] lg:grid-cols-2"><div class="flex flex-col overflow-hidden border-b border-[#E7E5EA] lg:border-b-0 lg:border-r"><div class="px-5 pt-10 sm:px-[46px] sm:pt-[46px]"><div class="mb-[14px] text-[12px] font-semibold leading-none text-[#5E3454]" style="font-family:var(--font-v2-mono), ui-monospace, monospace;letter-spacing:.14em">SEARCH API</div><div class="mb-[14px] text-[24px] font-semibold leading-[1.1] tracking-[-0.022em] sm:text-[30px]">Any source, structured in real time.</div><p class="m-0 max-w-[460px] text-[16px] leading-[1.55] text-[#54525c]">Retrieve relevant sources, full content and structured data across the open web, financial, academic, medical and proprietary sources.</p><a target="_blank" rel="noopener noreferrer" class="mt-5 block text-[14px] font-semibold text-[#5E3454] hover:underline" href="https://platform.valyu.ai/playground/search">Try Search →</a></div><div class="mt-10 flex min-h-0 flex-1 items-center justify-center overflow-hidden px-5 pb-10 sm:px-[46px] sm:pb-[46px]"><div class="relative aspect-[2/1] w-full max-w-[640px]"><div class="grid h-full w-full gap-[5px]" style="grid-template-columns:repeat(20,1fr);grid-template-rows:repeat(10,1fr)"></div><div class="absolute left-1/2 top-1/2 w-[80%] max-w-[300px] -translate-x-1/2 -translate-y-1/2 rounded-[9px] border-[1.5px] border-[#5E3454] bg-white px-[15px] py-3 shadow-[0_12px_30px_-12px_rgba(23,20,26,0.3)]"><span class="text-[14.5px] font-semibold tracking-[-0.01em] text-[#17141A]">Pull AstraZeneca&#x27;s FY2024 revenue<span class="v2-caret font-normal text-[#5E3454]">|</span></span></div></div></div></div><div class="flex flex-col overflow-hidden"><div class="px-5 pt-10 sm:px-[46px] sm:pt-[46px]"><div class="mb-[14px] text-[12px] font-semibold leading-none text-[#5E3454]" style="font-family:var(--font-v2-mono), ui-monospace, monospace;letter-spacing:.14em">DEEP RESEARCH API</div><div class="mb-[14px] text-[24px] font-semibold leading-[1.1] tracking-[-0.022em] sm:text-[30px]">Cited answers over all your data.</div><p class="m-0 max-w-[460px] text-[16px] leading-[1.55] text-[#54525c]">Plan the investigation, read the material and synthesise evidence into reports, sheets and structured data — every figure traced to its source.</p><a target="_blank" rel="noopener noreferrer" class="mt-5 block text-[14px] font-semibold text-[#5E3454] hover:underline" href="https://platform.valyu.ai/playground/deepresearch">Try Deep Research →</a></div><div class="mt-6 overflow-visible px-5 lg:mt-14"><div class="cursor-pointer"><svg viewBox="74 -26 412 452" width="100%" height="460" preserveAspectRatio="xMidYMid meet" fill="none" style="display:block;overflow:visible;font-family:var(--font-v2-mono), ui-monospace, monospace"><defs><linearGradient id="v2drGL" x1="0" y1="0" x2="0.3" y2="1"><stop offset="0" stop-color="#C7E04A"></stop><stop offset="1" stop-color="#5E3454"></stop></linearGradient><linearGradient id="v2drGR" x1="0" y1="0" x2="0.5" y2="1"><stop offset="0" stop-color="#5E3454"></stop><stop offset="1" stop-color="#C7E04A"></stop></linearGradient></defs><g style="transition:transform .55s cubic-bezier(.2,.7,.3,1);transform:translateY(0)"><polygon points="130,161 280,236 280,244 130,169" fill="#F5F4F7" stroke="#17141A" stroke-width="1.3" stroke-linejoin="round"></polygon><polygon points="280,236 430,161 430,169 280,244" fill="#ECEAEF" stroke="