 stroke-width="1.5"></rect><g fill="#5E3454"><rect x="70" y="134" width="80" height="6"></rect><rect x="70" y="148" width="58" height="6"></rect></g><g fill="#E7E3EB"><rect x="56" y="96" width="150" height="7"></rect><rect x="56" y="80" width="120" height="7"></rect></g></g></g><g style="transition:transform .55s cubic-bezier(.2,.7,.3,1);transform:translateY(0)"><polygon points="130,145 280,220 280,228 130,153" fill="#F5F4F7" stroke="#17141A" stroke-width="1.4" stroke-linejoin="round"></polygon><polygon points="280,220 430,145 430,153 280,228" fill="#ECEAEF" stroke="#17141A" stroke-width="1.4" stroke-linejoin="round"></polygon><polygon points="280,70 430,145 280,220 130,145" fill="#fff" stroke="#17141A" stroke-width="1.4" stroke-linejoin="round"></polygon><g transform="matrix(0.5,-0.25,-0.5,-0.25,280,220)"><circle cx="212" cy="206" r="30" fill="none" stroke="#E7E3EB" stroke-width="11"></circle><path d="M212 176 A30 30 0 0 1 240 222" fill="none" stroke="#5E3454" stroke-width="11"></path><path d="M212 176 A30 30 0 0 0 183 190" fill="none" stroke="#C7E04A" stroke-width="11"></path><rect x="56" y="236" width="120" height="11" rx="3" fill="#DEDAE4"></rect><g fill="#E7E3EB"><rect x="56" y="212" width="104" height="7"></rect><rect x="56" y="198" width="80" height="7"></rect></g><rect x="126" y="70" width="124" height="86" rx="5" fill="#fff" stroke="#DEDAE4" stroke-width="2"></rect><g stroke="#EBE8EE" stroke-width="2"><line x1="126" y1="98" x2="250" y2="98"></line><line x1="126" y1="127" x2="250" y2="127"></line><line x1="188" y1="70" x2="188" y2="156"></line></g><g fill="#E7E3EB"><rect x="138" y="80" width="34" height="6"></rect><rect x="200" y="80" width="34" height="6"></rect><rect x="138" y="109" width="34" height="6"></rect><rect x="200" y="109" width="34" height="6"></rect><rect x="138" y="138" width="34" height="6"></rect><rect x="200" y="138" width="34" height="6"></rect></g><g fill="#E7E3EB"><rect x="56" y="150" width="52" height="7"></rect><rect x="56" y="136" width="40" height="7"></rect></g></g></g><g style="transition:opacity .45s ease;opacity:0"><g transform="translate(300,66)"><rect x="0" y="0" width="130" height="26" rx="6" fill="#EFEDF1"></rect><text x="65" y="17.5" font-size="12" fill="#8b8792" text-anchor="middle" style="font-family:var(--font-v2-mono), ui-monospace, monospace">[ REPORT ]</text></g><g transform="translate(300,150)"><rect x="0" y="0" width="168" height="28" rx="6" fill="#F59E0B"></rect><text x="84" y="18.5" font-size="12" fill="#fff" font-weight="700" text-anchor="middle" style="font-family:var(--font-v2-mono), ui-monospace, monospace">[ STRUCTURED DATA ]</text></g><g transform="translate(300,236)"><rect x="0" y="0" width="128" height="26" rx="6" fill="#EFEDF1"></rect><text x="64" y="17.5" font-size="12" fill="#8b8792" text-anchor="middle" style="font-family:var(--font-v2-mono), ui-monospace, monospace">[ SOURCES ]</text></g></g></svg></div></div></div></div></div></div></div></section><section class="section-wrapper w-full" data-cta-location="v2DomainCoverage" data-cta-block-type="v2DomainCoverage" data-cta-block-index="5"><div class="section-container relative w-full border-x !border-0 !border-t-0 !border-b-0 !border-l-0 !border-r-0"><div class="v2-scope border-t border-[#E7E5EA] bg-[#FBFAFB]"><div class="mx-auto max-w-[1360px] px-5 py-20 sm:px-10 lg:py-[150px]"><h2 class="m-0 mb-[18px] font-medium text-[#17141A]" style="font-family:var(--font-v2-serif), Georgia, serif;font-size:clamp(28px, 2.9vw, 36px);line-height:1.02;letter-spacing:-0.02em">Deep coverage for finance and scientific R&amp;D.</h2><div class="mb-[52px] flex flex-col items-start gap-6 lg:flex-row lg:items-end lg:justify-between lg:gap-12"><p class="m-0 max-w-[680px] whitespace-pre-line text-[18px] leading-[1.5] text-[#54525c]">Broad web search combined with the specialist sources high-value research depends on.</p></div><div class="grid grid-cols-1 gap-6 lg:grid-cols-2"><div><div class="relative h-[420px] overflow-hidden bg-[#17141A] lg:h-[540px]"><img src="https://4ealzrotsszllxtz.public.blob.vercel-storage.com/landing-v2-finance.jpg" alt="Finance — market data and reporting" loading="lazy" decoding="async" class="absolute inset-0 h-full w-full object-cover"/><div class="absolute inset-0" style="background:linear-gradient(to top, rgba(15,13,18,.88) 0%, rgba(15,13,18,.45) 34%, rgba(15,13,18,0) 62%)"></div><div class="absolute bottom-0 left-0 right-0 p-6 sm:p-8"><div class="mb-3 font-medium text-white" style="font-family:var(--font-v2-serif), Georgia, serif;font-size:clamp(18px, 1.8vw, 24px);letter-spacing:-0.02em">Finance</div><p class="m-0 max-w-[420px] text-[13.5px] leading-[1.55] text-white/[.82]">Company filings, earnings, market data, economic indicators, prediction markets and financial reporting.</p><a class="mt-5 inline-flex items-center gap-[9px] text-white/[.72] transition-colors hover:text-white" href="/finance"><svg width="17" height="17" viewBox="0 0 17 17" fill="none"><path d="M3 3v6.5h9" stroke="currentColor" stroke-width="1.4"></path><path d="M9.5 6.5 12.5 9.5 9.5 12.5" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"></path></svg><span class="text-[13.5px] font-medium">Learn more</span></a></div></div><div class="mt-5 flex flex-wrap gap-2"><span class="border border-[#17141A]/[.28] px-[10px] py-[6px] text-[12px] font-medium text-[#17141A]">Investment research</span><span class="border border-[#17141A]/[.28] px-[10px] py-[6px] text-[12px] font-medium text-[#17141A]">Financial modelling</span><span class="border border-[#17141A]/[.28] px-[10px] py-[6px] text-[12px] font-medium text-[#17141A]">Due diligence</span><span class="border border-[#17141A]/[.28] px-[10px] py-[6px] text-[12px] font-medium text-[#17141A]">Market monitoring</span><span class="border border-[#17141A]/[.28] px-[10px] py-[6px] text-[12px] font-medium text-[#17141A]">Macro analysis</span></div></div><div><div class="relative h-[420px] overflow-hidden bg-[#17141A] lg:h-[540px]"><img src="https://4ealzrotsszllxtz.public.blob.vercel-storage.com/landing-v2-lifesci.jpg" alt="Life sciences and R&amp;D" loading="lazy" decoding="async" class="absolute inset-0 h-full w-full object-cover"/><div class="absolute inset-0" style="background:linear-gradient(to top, rgba(10,20,12,.88) 0%, rgba(10,20,12,.42) 34%, rgba(10,20,12,0) 62%)"></div><div class="absolute bottom-0 left-0 right-0 p-6 sm:p-8"><div class="mb-3 font-medium text-white" style="font-family:var(--font-v2-serif), Georgia, serif;font-size:clamp(18px, 1.8vw, 24px);letter-spacing:-0.02em">Life Sciences &amp; R&amp;D</div><p class="m-0 max-w-[420px] text-[13.5px] leading-[1.55] text-white/[.82]">Scientific papers, preprints, compounds, protein structures, clinical trials, patents, reactions and regulatory information.</p><a class="mt-5 inline-flex items-center gap-[9px] text-white/[.72] transition-colors hover:text-white" href="/sciences"><svg width="17" height="17" viewBox="0 0 17 17" fill="none"><path d="M3 3v6.5h9" stroke="currentColor" stroke-width="1.4"></path><path d="M9.5 6.5 12.5 9.5 9.5 12.5" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"></path></svg><span class="text-[13.5px] font-medium">Learn more</span></a></div></div><div class="mt-5 flex flex-wrap gap-2"><span class="border border-[#17141A]/[.28] px-[10px] py-[6px] text-[12px] font-medium text-[#17141A]">Literature reviews</span><span class="border border-[#17141A]/[.28] px-[10px] py-[6px] text-[12px] font-medium text-[#17141A]">Drug &amp; target research</span><span class="border border-[#17141A]/[.28] px-[10px] py-[6px] text-[12px] font-medium text-[#17141A]">Clinical-trial analysis</span><span class="border border-[#17141A]/[.28] px-[10px] py-[6px] text-[12px] font-medium text-[#17141A]">Patent / FTO research</span><span class="border border-[#17141A]/[.28] px-[10px] py-[6px] text-[12px] font-medium text-[#17141A]">Regulatory monitoring</span></div></div></div></div></div></div></section><section class="section-wrapper w-full" data-cta-location="v2Benchmarks" data-cta-block-type="v2Benchmarks" data-cta-block-index="6"><div class="section-container relative w-full border-x !border-0 !border-t-0 !border-b-0 !border-l-0 !border-r-0"><div class="v2-scope bg-white text-[#17141A] border-t border-[#E7E5EA]"><div class="mx-auto max-w-[1360px] px-5 py-20 sm:px-10 lg:py-[150px]"><h2 class="m-0 mb-9 font-medium" style="font-family:var(--font-v2-serif), Georgia, serif;font-size:clamp(28px, 2.9vw, 36px);line-height:1.03;letter-spacing:-0.015em">State-of-the-art across research benchmarks.</h2><div class="mb-12 flex flex-wrap gap-[6px]"><button type="button" class="cursor-pointer whitespace-nowrap px-[17px] py-[10px] text-[13.5px] font-semibold transition-colors" style="background:#5E3454;color:#fff">DRACO</button><button type="button" class="cursor-pointer whitespace-nowrap px-[17px] py-[10px] text-[13.5px] font-semibold transition-colors" style="background:#fff;color:#54525c;border:1px solid #E7E5EA">FreshQA</button><button type="button" class="cursor-pointer whitespace-nowrap px-[17px] py-[10px] text-[13.5px] font-semibold transition-colors" style="background:#fff;color:#54525c;border:1px solid #E7E5EA">SimpleQA</button><button type="button" class="cursor-pointer whitespace-nowrap px-[17px] py-[10px] text-[13.5px] font-semibold transition-colors" style="background:#fff;color:#54525c;border:1px solid #E7E5EA">Finance</button><button type="button" class="cursor-pointer whitespace-nowrap px-[17px] py-[10px] text-[13.5px] font-semibold transition-colors" style="background:#fff;color:#54525c;border:1px solid #E7E5EA">Economics</button><button type="button" class="cursor-pointer whitespace-nowrap px-[17px] py-[10px] text-[13.5px] font-semibold transition-colors" style="background:#fff;color:#54525c;border:1px solid #E7E5EA">MedAgent</button><button type="button" class="cursor-pointer whitespace-nowrap px-[17px] py-[10px] text-[13.5px] font-semibold transition-colors" style="background:#fff;color:#54525c;border:1px solid #E7E5EA">ScholarQA</button></div><div class="flex flex-col-reverse items-start gap-12 lg:flex-row lg:gap-[72px]"><div class="w-full flex-none lg:w-[360px]"><div class="mb-5 text-[30px] font-semibold tracking-[-0.02em]">DRACO</div><div class="mb-7"><div class="border-b border-[#E2DEE5] first:border-t"><button type="button" class="flex w-full items-center justify-between gap-4 py-[14px] text-left text-[15px] font-semibold tracking-[-0.01em] transition-colors" style="color:#17141A">About the benchmark<span class="flex-none text-[17px] font-normal leading-none" style="color:#5E3454">−</span></button><p class="m-0 pb-4 text-[14px] leading-[1.6] text-[#54525c]">DRACO is Perplexity&#x27;s open expert-rubric benchmark of 100 long-form deep research tasks across 10 professional knowledge-work domains, including finance, medicine, academic research, law, and technology. Each output is graded by a per-criterion judge against a domain-expert rubric. We ran every commercially available deep research API end-to-end against the same 100 questions.
Every search and research API was tested on its highest publicly-available compute tier. Parallel (Ultra8x), You(.)com Research (exhaustive), Tavily (pro), Exa (deep-reasoning), and Perplexity Deep Research (Opus 4.6). Valyu was run on Heavy mode; we offer a higher Max tier but did not use it here, since Max is more expensive per task than the field.</p></div><div class="border-b border-[#E2DEE5] first:border-t"><button type="button" class="flex w-full items-center justify-between gap-4 py-[14px] text-left text-[15px] font-semibold tracking-[-0.01em] transition-colors" style="color:#54525c">Evaluation<span class="flex-none text-[17px] font-normal leading-none" style="color:#b3aeb8">+</span></button></div></div><a target="_blank" rel="noopener noreferrer" class="text-[14px] font-semibold text-[#5E3454] hover:underline" href="https://github.com/valyuAI/valyu-benchmarks">Read more →</a></div><div class="w-full flex-1"><div class="mt-8 h-[420px] w-full sm:h-[460px] lg:mt-14 lg:h-[500px]"><div class="h-full md:hidden"><div class="w-full h-full flex flex-col bg-white"><div class="flex flex-1 min-h-0 gap-3"><div class="flex items-center justify-center select-none"><span class="text-[10px] uppercase tracking-[0.25em] text-neutral-400 font-medium whitespace-nowrap" style="writing-mode:vertical-rl;transform:rotate(180deg);font-family:&quot;Neue Montreal&quot;, &quot;Inter&quot;, system-ui, sans-serif">Accuracy (%)</span></div><div class="flex-1 relative overflow-hidden" style="background-image:radial-gradient(circle, rgba(0,0,0,0.18) 0.9px, transparent 0.9px);background-size:16px 16px;background-position:8px 8px"><div class="absolute z-10" style="left:79.93133362240124%;top:12.166666666666657%;transform:translate(-50%, -50%);width:8px;height:8px;border-radius:50%;background-color:#5E3454"></div><div class="absolute z-20" style="left:calc(79.93133362240124% + 0px);top:calc(12.166666666666657% - 14px);transform:translate(-50%, -100%)"><div class="inline-flex items-center rounde