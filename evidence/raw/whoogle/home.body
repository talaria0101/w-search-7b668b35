oad — 24 Jul 2026"},{"level":2,"text":"Features","anchor":"features","htmlText":"Features"},{"level":2,"text":"Install","anchor":"install","htmlText":"Install"},{"level":3,"text":"Supported Platforms","anchor":"supported-platforms","htmlText":"Supported Platforms"},{"level":3,"text":"Heroku Quick Deploy","anchor":"heroku-quick-deploy","htmlText":"Heroku Quick Deploy"},{"level":3,"text":"Render","anchor":"render","htmlText":"Render"},{"level":3,"text":"Repl.it","anchor":"replit","htmlText":"Repl.it"},{"level":3,"text":"Fly.io","anchor":"flyio","htmlText":"Fly.io"},{"level":4,"text":"Install the CLI: https://fly.io/docs/hands-on/installing/","anchor":"install-the-cli-httpsflyiodocshands-oninstalling","htmlText":"Install the CLI: https://fly.io/docs/hands-on/installing/"},{"level":4,"text":"Deploy the app","anchor":"deploy-the-app","htmlText":"Deploy the app"},{"level":3,"text":"Koyeb","anchor":"koyeb","htmlText":"Koyeb"},{"level":3,"text":"RepoCloud","anchor":"repocloud","htmlText":"RepoCloud"},{"level":3,"text":"pipx","anchor":"pipx","htmlText":"pipx"},{"level":3,"text":"pip","anchor":"pip","htmlText":"pip"},{"level":3,"text":"Manual","anchor":"manual","htmlText":"Manual"},{"level":4,"text":"Dependencies","anchor":"dependencies","htmlText":"Dependencies"},{"level":4,"text":"Install","anchor":"install-1","htmlText":"Install"},{"level":4,"text":"systemd Configuration","anchor":"systemd-configuration","htmlText":"systemd Configuration"},{"level":4,"text":"Tor Configuration optional","anchor":"tor-configuration-optional","htmlText":"Tor Configuration optional"},{"level":3,"text":"Manual (Docker)","anchor":"manual-docker","htmlText":"Manual (Docker)"},{"level":4,"text":"Docker CLI","anchor":"docker-cli","htmlText":"Docker CLI"},{"level":4,"text":"Using Heroku CLI","anchor":"using-heroku-cli","htmlText":"Using Heroku CLI"},{"level":3,"text":"Arch Linux \u0026 Arch-based Distributions","anchor":"arch-linux--arch-based-distributions","htmlText":"Arch Linux \u0026amp; Arch-ba