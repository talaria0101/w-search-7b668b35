  <script id="brd_js_inline_before">
      function err_report(d, t, data){
          var a = d.createElement(t), m = d.getElementsByTagName(t)[0];
          a.async = 1;
          let p = ['href='+encodeURIComponent(d.location.href)];
          if (!data.file || data.file == 'undefined' || !data.line ||
              data.line == 'undefined' || !data.col || data.col == 'undefined')
          {
              return;
          }
          for (let i in data)
              p.push(i+'='+encodeURIComponent(data[i]));
          let base_url = '';
          a.src = base_url+'/web_api/errjs?wp=1&'+p.join('&');
          m.parentNode.insertBefore(a, m);

      }
      function err_dbg(d, t, data){
          if (!data || !data.identifier)
              return;
          var a = d.createElement(t), m = d.getElementsByTagName(t)[0];
          a.async = 1;
          let p = ['href='+encodeURIComponent(d.location.href)];
          var script_url = '/wp-content/libs/splide.min.js';
          fetch(script_url)
              .then(function(r) { return r.text(); })
              .then(function(content) {
                  var error_data = {
                      message: 'Splide not loaded for ' + data.identifier,
                      file: 'content-testimonials.php',
                      line: '195',
                      col: '19',
                      unique_id: data.identifier,
                      script_content: content.substring(0, 400),
                      script_size: content.length,
                      err: 'Script fetched but Splide undefined - '+
                          ' possible wrong content or corrupted file'
                  };
                  for (let i in error_data)
                      p.push(i+'='+encodeURIComponent(error_data[i]));
                  let base_url = '';
                  a.src = base_url+'/web_api/errjs?wp_dbg=1&'+p.join('&');
                  m.parentNode.insertBefore(a, m);
              })
              .catch(function(e) {
                  var error_data = {
                      message: 'Splide fetch failed for ' + data.identifier,
                      file: 'content-testimonials.php',
                      line: '212',
                      col: '38',
                      unique_id: data.identifier,
                      fetch_error: e.toString(),
                      err: 'Fetch failed - network error, 404,'+
                          ' or blocked: ' + e.toString()
                  };
                  for (let i in error_data)
                      p.push(i+'='+encodeURIComponent(error_data[i]));
                  let base_url = '';
                  a.src = base_url+'/web_api/errjs?wp_dbg=1&'+p.join('&');
                  m.parentNode.insertBefore(a, m);
              });
      }
      (function (){
          var prev_error_handler = window.onerror, sent = false;
          window.onerror = function(message, file, line, col, err){
              if (!sent)
              {
                  sent = true;
                  err_report(document, 'script', {message: message, file: file,
                      line: line, col: col, err: err});
              }
              if (prev_error_handler)
                  prev_error_handler.apply(window, arguments);
          };
          window.addEventListener('unhandledrejection', function(ev){
              var reason = ev.reason||{};
              window.onerror(reason.message+'\n'+reason.stack);
          });
      })();
      const brd_config = {"is_cn":false};
  </script>
