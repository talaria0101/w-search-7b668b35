-stone-900 cursor-pointer"><span class="sr-only">GitHub</span><svg fill="currentColor" viewBox="0 0 24 24" class="w-6 h-6" aria-hidden="true"><path fill-rule="evenodd" d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.531 1.032 1.531 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0022 12.017C22 6.484 17.522 2 12 2z" clip-rule="evenodd"></path></svg></a></div></div><div class="grid grid-cols-2 gap-8 mt-12 xl:col-span-2 xl:mt-0"><div class="md:grid md:grid-cols-2 md:gap-8"><div><h3 class="text-base font-medium text-stone-900">APIs</h3><ul role="list" class="mt-4 space-y-2"><li><a href="/google-search-api" class="text-sm text-stone-500 hover:text-stone-900 cursor-pointer">Google Search API</a></li><li><a href="/bing-search-api" class="text-sm text-stone-500 hover:text-stone-900 cursor-pointer">Bing Search API</a></li><li><a href="/google-news-api" class="text-sm text-stone-500 hover:text-stone-900 cursor-pointer">Google News API</a></li><li><a href="/google-video-api" class="text-sm text-stone-500 hover:text-stone-900 cursor-pointer">Google Video API</a></li><li><a href="/google-images-api" class="text-sm text-stone-500 hover:text-stone-900 cursor-pointer">Google Images API</a></li><li><a href="/google-jobs-api" class="text-sm text-stone-500 hover:text-stone-900 cursor-pointer">Google Jobs API</a></li><li><a href="/google-scholar-api" class="text-sm text-stone-500 hover:text-stone-900 cursor-pointer">Google Scholar API</a></li><li><a href="/google-product-api" class="text-sm text-stone-500 hover:text-stone-900 cursor-pointer">Google Product API</a></li><li><a href="/google-maps-api" class="text-sm text-stone-500 hover:text-stone-900 cursor-pointer">Google Maps API</a></li><li><a href="/reddit-api" class="text-sm text-stone-500 hover:text-stone-900 cursor-pointer">Reddit API</a></li><li><a href="/ebay-api" class="text-sm text-stone-500 hover:text-stone-900 cursor-pointer">eBay Search API</a></li><li><a href="/web-scraping-api" class="text-sm text-stone-500 hover:text-stone-900 cursor-pointer">Web Scraping API</a></li></ul></div><div class="mt-12 md:mt-0"><h3 class="text-base font-medium text-stone-900">Support</h3><ul role="list" class="mt-4 space-y-2"><li><a href="/mcp" class="text-sm text-stone-500 hover:text-stone-900 cursor-pointer">MCP Server</a></li><li><a href="/pricing" class="text-sm text-stone-500 hover:text-stone-900 cursor-pointer">Pricing</a></li><li><a href="/docs" class="text-sm text-stone-500 hover:text-stone-900 cursor-pointer">Documentation</a></li><li><a href="/support" class="text-sm text-stone-500 hover:text-stone-900 cursor-pointer">Support</a></li><li><a href="/search-operators" class="text-sm text-stone-500 hover:text-stone-900 cursor-pointer">Search Operators</a></li><li><a href="/google-custom-search-api-alternative" class="text-sm text-stone-500 hover:text-stone-900 cursor-pointer">Custom Search Migration</a></li><li><a href="https://app.serply.io/status" class="text-sm text-stone-500 hover:text-stone-900 cursor-pointer">API Status</a></li></ul></div></div><div class="md:grid md:grid-cols-2 md:gap-8"><div><h3 class="text-sm font-medium text-stone-900">Company</h3><ul role="list" class="mt-4 space-y-2"><li><a href="/blog" class="text-sm text-stone-500 hover:text-stone-900 cursor-pointer">Blog</a></li></ul></div><div class="mt-12 md:mt-0"><h3 class="text-sm font-medium text-stone-900">Legal</h3><ul role="list" class="mt-4 space-y-2"><li><a href="/privacy" class="text-sm text-stone-500 hover:text-stone-900 cursor-pointer">Privacy</a></li><li><a href="/terms" class="text-sm text-stone-500 hover:text-stone-900 cursor-pointer">Terms</a></li><li><a href="/refund-policy" class="text-sm text-stone-500 hover:text-stone-900 cursor-pointer">Refunds</a></li></ul></div></div></div></div><div class="pt-8 mt-12 border-t border-stone-200"><p class="text-sm text-stone-600 xl:text-center">Copyright © <!-- -->2026<!-- --> Serply, Inc. All rights reserved.</p></div></div></footer><!--astro:end--></astro-island></div></body></html>