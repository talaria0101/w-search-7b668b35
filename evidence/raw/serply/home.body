quot;:[0,&quot;import requests\n\nresponse = requests.get(\n    \&quot;https://api.serply.io/v1/search/?q=google+search+api\&quot;,\n    headers={\n        \&quot;X-Api-Key\&quot;: \&quot;YOUR_API_KEY\&quot;,\n        \&quot;X-Proxy-Location\&quot;: \&quot;US\&quot;,\n        \&quot;X-User-Agent\&quot;: \&quot;desktop\&quot;,\n    },\n    timeout=30,\n)\nresponse.raise_for_status()\n\nfor result in response.json()[\&quot;results\&quot;]:\n    print(result[\&quot;title\&quot;], result[\&quot;link\&quot;])&quot;]}],[0,{&quot;label&quot;:[0,&quot;JavaScript&quot;],&quot;language&quot;:[0,&quot;javascript&quot;],&quot;code&quot;:[0,&quot;const response = await fetch(\n  \&quot;https://api.serply.io/v1/search/?q=google+search+api\&quot;,\n  {\n    headers: {\n      \&quot;X-Api-Key\&quot;: \&quot;YOUR_API_KEY\&quot;,\n      \&quot;X-Proxy-Location\&quot;: \&quot;US\&quot;,\n      \&quot;X-User-Agent\&quot;: \&quot;desktop\&quot;,\n    },\n  }\n)\n\nif (!response.ok) throw new Error(`Serply ${response.status}`)\n\nconst { results } = await response.json()\nresults.forEach((r) =&gt; console.log(r.title, r.link))&quot;]}],[0,{&quot;label&quot;:[0,&quot;Ruby&quot;],&quot;language&quot;:[0,&quot;ruby&quot;],&quot;code&quot;:[0,&quot;require \&quot;net/http\&quot;\nrequire \&quot;json\&quot;\n\nuri = URI(\&quot;https://api.serply.io/v1/search/?q=google+search+api\&quot;)\nrequest = Net::HTTP::Get.new(uri)\nrequest[\&quot;X-Api-Key\&quot;] = \&quot;YOUR_API_KEY\&quot;\nrequest[\&quot;X-Proxy-Location\&quot;] = \&quot;US\&quot;\nrequest[\&quot;X-User-Agent\&quot;] = \&quot;desktop\&quot;\n\nresponse = Net::HTTP.start(uri.hostname, uri.port, use_ssl: true) do |http|\n  http.request(request)\nend\n\nJSON.parse(response.body)[\&quot;results\&quot;].each do |result|\n  puts \&quot;#{result[\&quot;title\&quot;]} #{result[\&quot;link\&quot;]}\&quot;\nend&quot;]}]]],&quot;data-astro-cid-lcdefpme&quot;:[0,true]}" ssr client="idle" opts="{&quot;name&quot;:&quot;TabbedCodeExamples&quot;,&quot;value&quot;:true}" await-children><div class="w-full"><div dir="ltr" data-orientation="horizontal"><div class="rounded-lg overflow-hidden" style="box-shadow:0 4px 14px 0 rgb(0 0 0 / 10%)"><div role="tablist" aria-orientation="horizontal" class="flex space-x-1 bg-stone-100 p-1" tabindex="-1" data-orientation="horizontal" style="outline:none"><button type="button" role="tab" aria-selected="true" aria-controls="radix-:r9R2:-content-0" data-state="active" id="radix-:r9R2:-trigger-0" class="px-4 py-2 text-sm font-medium rounded-md transition-all duration-200 focus:outline-none focus:ring-2 focus:ring-brand focus:ring-offset-2 bg-white text-stone-900 shadow-sm" tabindex="-1" data-orientation="horizontal" data-radix-collection-item="">cURL</button><button type="button" role="tab" aria-selected="false" aria-controls="radix-:r9R2:-content-1" data-state="inactive" id="radix-:r9R2:-trigger-1" class="px-4 py-2 text-sm font-medium rounded-md transition-all duration-200 focus:outline-none focus:ring-2 focus:ring-brand focus:ring-offset-2 text-stone-600 hover:text-stone-900 hover:bg-white/50" tabindex="-1" data-orientation="horizontal" data-radix-collection-item="">Python</button><button type="button" role="tab" aria-selected="false" aria-controls="radix-:r9R2:-content-2" data-state="inactive" id="radix-:r9R2:-trigger-2" class="px-4 py-2 text-sm font-medium rounded-md transition-all duration-200 focus:outline-none focus:ring-2 focus:ring-brand focus:ring-offset-2 text-stone-600 hover:text-stone-900 hover:bg-white/50" tabindex="-1" data-orientation="horizontal" data-radix-collection-item="">JavaScript</button><button type="button" role="tab" aria-selected="false" aria-controls="radix-:r9R2:-content-3" data-state="inactive" id="radix-:r9R2:-trigger-3" class="px-4 py-2 text-sm font-medium rounded-md transition-all duration-200 focus:outline-none focus:ring-2 focus:ring-brand focus:ring-offset-2 text-stone-600 hover:text-stone-900 hover:bg-white/50" tabindex="-1" data-orientation="horizontal" data-radix-collection-item="">Ruby</button></div><div data-state="active" data-orientation="horizontal" role="tabpanel" aria-labelledby="radix-:r9R2:-trigger-0" id="radix-:r9R2:-content-0" tabindex="0" class="relative" style="animation-duration:0s"><button class="absolute right-3 top-3 z-10 bg-stone-700 border border-stone-600 w-8 h-8 rounded flex items-center justify-center hover:bg-stone-600 transition-colors" title="Copy to clipboard"><svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true" data-slot="icon" class="h-4 w-4 text-stone-400"><path fill-rule="evenodd" d="M15.988 3.012A2.25 2.25 0 0 1 18 5.25v6.5A2.25 2.25 0 0 1 15.75 14H13.5v-3.379a3 3 0 0 0-.879-2.121l-3.12-3.121a3 3 0 0 0-1.402-.791 2.252 2.252 0 0 1 1.913-1.576A2.25 2.25 0 0 1 12.25 1h1.5a2.25 2.25 0 0 1 2.238 2.012ZM11.5 3.25a.75.75 0 0 1 .75-.75h1.5a.75.75 0 0 1 .75.75v.25h-3v-.25Z" clip-rule="evenodd"></path><path d="M3.5 6A1.5 1.5 0 0 0 2 7.5v9A1.5 1.5 0 0 0 3.5 18h7a1.5 1.5 0 0 0 1.5-1.5v-5.879a1.5 1.5 0 0 0-.44-1.06L8.44 6.439A1.5 1.5 0 0 0 7.378 6H3.5Z"></path></svg></button><div class="overflow-x-auto bg-stone-800 rounded-b-lg"><pre class="p-4 text-sm text-stone-100 language-bash"><code class="language-bash"><span class="token function">curl</span> <span class="token parameter variable">-X</span> GET <span class="token string">&quot;https://api.serply.io/v1/search/?q=google+search+api&quot;</span> <span class="token punctuation">\</span>
  <span class="token parameter variable">-H</span> <span class="token string">&quot;X-Api-Key: YOUR_API_KEY&quot;</span> <span class="token punctuation">\</span>
  <span class="token parameter variable">-H</span> <span class="token string">&quot;X-Proxy-Location: US&quot;</span> <span class="token punctuation">\</span>
  <span class="token parameter variable">-H</span> <span class="token string">&quot;X-User-Agent: desktop&quot;</span></code></pre></div></div><div data-state="inactive" data-orientation="horizontal" role="tabpanel" aria-labelledby="radix-:r9R2:-trigger-1" id="radix-:r9R2:-content-1" tabindex="0" class="relative hidden"><button class="absolute right-3 top-3 z-10 bg-stone-700 border border-stone-600 w-8 h-8 rounded flex items-center justify-center hover:bg-stone-600 transition-colors" title="Copy to clipboard"><svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true" data-slot="icon" class="h-4 w-4 text-stone-400"><path fill-rule="evenodd" d="M15.988 3.012A2.25 2.25 0 0 1 18 5.25v6.5A2.25 2.25 0 0 1 15.75 14H13.5v-3.379a3 3 0 0 0-.879-2.121l-3.12-3.121a3 3 0 0 0-1.402-.791 2.252 2.252 0 0 1 1.913-1.576A2.25 2.25 0 0 1 12.25 1h1.5a2.25 2.25 0 0 1 2.238 2.012ZM11.5 3.25a.75.75 0 0 1 .75-.75h1.5a.75.75 0 0 1 .75.75v.25h-3v-.25Z" clip-rule="evenodd"></path><path d="M3.5 6A1.5 1.5 0 0 0 2 7.5v9A1.5 1.5 0 0 0 3.5 18h7a1.5 1.5 0 0 0 1.5-1.5v-5.879a1.5 1.5 0 0 0-.44-1.06L8.44 6.439A1.5 1.5 0 0 0 7.378 6H3.5Z"></path></svg></button><div class="overflow-x-auto bg-stone-800 rounded-b-lg"><pre class="p-4 text-sm text-stone-100 language-python"><code class="language-python"><span class="token keyword">import</span> requests

response <span class="token operator">=</span> requests<span class="token punctuation">.</span>get<span class="token punctuation">(</span>
    <span class="token string">&quot;https://api.serply.io/v1/search/?q=google+search+api&quot;</span><span class="token punctuation">,</span>
    headers<span class="token operator">=</span><span class="token punctuation">{</span>
        <span class="token string">&quot;X-Api-Key&quot;</span><span class="token punctuation">:</span> <span class="token string">&quot;YOUR_API_KEY&quot;</span><span class="token punctuation">,</span>
        <span class="token string">&quot;X-Proxy-Location&quot;</span><span class="token punctuation">:</span> <span class="token string">&quot;US&quot;</span><span class="token punctuation">,</span>
        <span class="token string">&quot;X-User-Agent&quot;</span><span class="token punctuation">:</span> <span class="token string">&quot;desktop&quot;</span><span class="token punctuation">,</span>
    <span class="token punctuation">}</span><span class="token punctuation">,</span>
    timeout<span class="token operator">=</span><span class="token number">30</span><span class="token punctuation">,</span>
<span class="token punctuation">)</span>
response<span class="token punctuation">.</span>raise_for_status<span class="token punctuation">(</span><span class="token punctuation">)</span>

<span class="token keyword">for</span> result <span class="token keyword">in</span> response<span class="token punctuation">.</span>json<span class="token punctuation">(</span><span class="token punctuation">)</span><span class="token punctuation">[</span><span class="token string">&quot;results&quot;</span><span class="token punctuation">]</span><span class="token punctuation">:</span>
    <span class="token keyword">print</span><span class="token punctuation">(</span>result<span class="token punctuation">[</span><span class="token string">&quot;title&quot;</span><span class="token punctuation">]</span><span class="token punctuation">,</span> result<span class="token punctuation">[</span><span class="token string">&quot;link&quot;</span><span class="token punctuation">]</span><span class="token punctuation">)</span></code></pre></div></div><div data-state="inactive" data-orientation="horizontal" role="tabpanel" aria-labelledby="radix-:r9R2:-trigger-2" id="radix-:r9R2:-content-2" tabindex="0" class="relative hidden"><button class="absolute right-3 top-3 z-10 bg-stone-700 border border-stone-600 w-8 h-8 rounded flex items-center justify-center hover:bg-stone-600 transition-colors" title="Copy to clipboard"><svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true" data-slot="icon" class="h-4 w-4 text-stone-400"><path fill-rule="evenodd" d="M15.988 3.012A2.25 2.25 0 0 1 18 5.25v6.5A2.25 2.25 0 0 1 15.75 14H13.5v-3.379a3 3 0 0 0-.879-2.121l-3.12-3.121a3 3 0 0 0-1.402-.791 2.252 2.252 0 0 1 1.913-1.576A2.25 2.25 0 0 1 12.25 1h1.5a2.25 2.25 0 0 1 2.238 2.012ZM11.5 3.25a.75.75 0 0 1 .75-.75h1.5a.75.75 0 0 1 .75.75v.25h-3v-.25Z" clip-rule="evenodd"></path><path d="M3.5 6A1.5 1.5 0 0 0 2 7.5v9A1.5 1.5 0 0 0 3.5 18h7a1.5 1.5 0 0 0 1.5-1.5v-5.879a1.5 1.5 0 0 0-.44-1.06L8.44 6.439A1.5 1.5 0 0 0 7.378 6H3.5Z"></path></svg></button><div class="overflow-x-auto bg-stone-800 rounded-b-lg"><pre class="p-4 text-sm text-stone-100 language-javascript"><code class="language-javascript"><span class="token keyword">const</span> response <span class="token operator">=</span> <span class="token keyword">await</span> <span class="token function">fetch</span><span class="token punctuation">(</span>
  <span class="token string">&quot;https://api.serply.io/v1/search/?q=google+search+api&quot;</span><span class="token punctuation">,</span>
  <span class="token punctuation">{</span>
    <span class="token literal-property property">headers</span><span class="token operator">:</span> <span class="token punctuation">{</span>
      <span class="token string-property property">&quot;X-Api-Key&quot;</span><span class="token operator">:</span> <span class="token string">&quot;YOUR_API_KEY&quot;</span><span class="token punctuation">,</span>
      <span class="token string-property property">&quot;X-Proxy-Location&quot;</span><span class="token operator">:</span> <span class="token string">&quot;US&quot;</span><span class="token punctuation">,</span>
      <span class="token string-property property">&quot;X-User-Agent&quot;</span><span class="token operator">:</span> <span class="token string">&quot;desktop&quot;</span><span class="token punctuation">,</span>
    <span class="token punctuation">}</span><span class="token punctuation">,</span>
  <span class="token punctuation">}</span>
<span class="token punctuation">)</span>

<span class="token keyword">if</span> <span class="token punctuation">(</span><span class="token operator">!</span>response<span class="token punctuation">.</span>ok<span class="token punctuation">)</span> <span class="token keyword">throw</span> <span class="token keyword">new</span> <span class="token class-name">Error</span><span class="token punctuation">(</span><span class="token template-string"><span class="token template-punctuation string">`</span><span class="token string">Serply </span><span class="token interpolation"><span class="token interpolation-punctuation punctuation">${</span>response<span class="token punctuation">.</span>status<span class="token interpolation-punctuation punctuation">}</span></span><span class="token template-punctuation string">`</span></span><span class="token punctuation">)</span>

<span class="token keyword">const</span> <span class="token punctuation">{</span> results <span class="token punctuation">}</span> <span class="token operator">=</span> <span class="token keyword">await</span> response<span class="token punctuation">.</span><span class="token function">json</span><span class="token punctuation">(</span><span class="token punctuation">)</span>
results<span class="token punctuation">.</span><span class="token function">forEach</span><span class="token punctuation">(</span><span class="token punctuation">(</span><span class="token parameter">r</span><span class="token punctuation">)</span> <span class="token operator">=&gt;</span> console<span class="token punctuation">.</span><span class="token function">log</span><span class="token punctuation">(</span>r<span class="token punctuation">.</span>title<span class="token punctuation">,</span> r<span class="token punctuation">.</span>link<span class="token punctuation">)</span><span class="token punctuation">)</span></code></pre></div></div><div data-state="inactive" data-orientation="horizontal" role="tabpanel" aria-labelledby="radix-:r9R2:-trigger-3" id="radix-:r9R2:-content-3" tabindex="0" class="relative hidden"><button class="absolute right-3 top-3 z-10 bg-stone-700 border border-stone-600 w-8 h-8 rounded flex items-center justify-center hover:bg-stone-600 transition-colors" title="Copy to clipboard"><svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true" data-slot="icon" class="h-4 w-4 text-stone-400"><path fill-rule="evenodd" d="M15.988 3.012A2.25 2.25 0 0 1 18 5.25v6.5A2.25 2.25 0 0 1 15.75 14H13.5v-3.379a3 3 0 0 0-.879-2.121l-3.12-3.121a3 3 0 0 0-1.402-.791 2.252 2.252 0 0 1 1.913-1.576A2.25 2.25 0 0 1 12.25 1h1.5a2.25 2.25 0 0 1 2.238 2.012ZM11.5 3.25a.75.75 0 0 1 .75-.75h1.5a.75.75 0 0 1 .75.75v.25h-3v-.25Z" clip-rule="evenodd"></path><path d="M3.5 6A1.5 1.5 0 0 0 2 7.5v9A1.5 1.5 0 0 0 3.5 18h7a1.5 1.5 0 0 0 1.5-1.5v-5.879a1.5 1.5 0 0 0-.44-1.06L8.44 6.439A1.5 1.5 0 0 0 7.378 6H3.5Z"></path></svg></button><div class="overflow-x-auto bg-stone-800 rounded-b-lg"><pre class="p-4 text-sm text-stone-100 language-ruby"><code class="language-ruby"><span class="token keyword">require</span> <span class="token string-literal"><span class="token string">&quot;net/http&quot;</span></span>
<span class="token keyword">require</span> <span class="token string-literal"><span class="token string">&quot;json&quot;</span></span>

uri <span class="token operator">=</span> <span class="token constant">URI</span><span class="token punctuation">(</span><span class="token string-literal"><span class="token string">&quot;https://api.serply.io/v1/search/?q=google+search+api&quot;</span></span><span class="token punctuation">)</span>
request <span class="token operator">=</span> Net<span class="token double-colon punctuation">::</span><span class="token constant">HTTP</span><span class="token double-colon punctuation">::</span><span class="token class-name">Get</span><span class="token punctuation">.</span><span class="token keyword">new</span><span class="token punctuation">(</span>uri<span class="token punctuation">)</span>
request<span class="token punctuation">[</span><span class="token string-literal"><span class="token string">&quot;X-Api-Key&quot;</span></span><span class="token punctuation">]</span> <span class="token operator">=</span> <span class="token string-literal"><span class="token string">&quot;YOUR_API_KEY&quot;</span></span>
request<span class="token punctuation">[</span><span class="token string-literal"><span class="token string">&quot;X-Proxy-Location&quot;</span></span><span class="token punctuation">]</span> <span class="token operator">=</span> <span class="token string-literal"><span class="token string">&quot;US&quot;</span></span>
request<span class="token punctuation">[</span><span class="token string-literal"><span class="token string">&quot;X-User-Agent&quot;</span></span><span class="token punctuation">]</span> <span class="token operator">=</span> <span class="token string-literal"><span class="token string">&quot;desktop&quot;</span></span>

response <span class="token operator">=</span> Net<span class="token double-colon punctuation">::</span><span class="token constant">HTTP</span><span class="token punctuation">.</span>start<span class="token punctuation">(</span>uri<span class="token punctuation">.</span>hostname<span class="token punctuation">,</span> uri<span class="token punctuation">.</span>port<span class="token punctuation">,</span> <span class="token symbol">use_ssl</span><span class="token operator">:</span> <span class="token boolean">true</span><span class="token punctuation">)</span> <span class="token keyword">do</span> <span class="token operator">|</span>http<span class="token operator">|</span>
  http<span class="token punctuation">.</span>request<span class="token punctuation">(</span>request<span class="token punctuation">)</span>
<span class="token keyword">end</span>

<span class="token constant">JSON</span><span class="token punctuation">.</span>parse<span class="token punctuation">(</span>response<span class="token punctuation">.</span>body<span class="token punctuation">)</span><span class="token punctuation">[</span><span class="token string-literal"><span class="token string">&quot;results&quot;</span></span><span class="token punctuation">]</span><span class="token punctuation">.</span><span class="token keyword">each</span> <span class="token keyword">do</span> <span class="token operator">|</span>result<span class="token operator">|</span>
  puts <span class="token string-literal"><span class="token string">&quot;</span><span class="token interpolation"><span class="token delimiter punctuation">#{</span><span class="token content">result<span class="token punctuation">[</span><span class="token string-literal"><span class="token string">&quot;title&quot;</span></span><span class="token punctuation">]</span></span><span class="token delimiter punctuation">}</span></span><span class="token string"> </span><span class="token interpolation"><span class="token delimiter punctuation">#{</span><span class="token content">result<span class="token punctuation">[</span><span class="token string-literal"><span class="token string">&quot;link&quot;</span></span><span class="token punctuation">]</span></span><span class="token delimiter punctuation">}</span></span><span class="token string">&quot;</span></span>
<span class="token keyword">end</span></code></pre></div></div></div></div></div><!--astro:end--></astro-island></div></section><section class="my-16 sm:my-24" aria-labelledby="mcp-heading" data-astro-cid-lcdefpme><div class="mx-auto max-w-3xl text-center" data-astro-cid-lcdefpme><p class="font-mono text-xs uppercase tracking-widest text-brand-ink" data-astro-cid-lcdefpme>Model Context Protocol</p><h2 id="mcp-heading" class="mt-3 text-3xl font-bold tracking-tight text-stone-900 sm:text-4xl" data-astro-cid-lcdefpme>Give your agents live search results</h2><p class="mt-4 text-lg leading-relaxed text-stone-600" data-astro-cid-lcdefpme>We host the MCP server. Point any client at<code class="rounded bg-stone-100 px-1.5 py-0.5 font-mono text-base text-stone-900" data-astro-cid-lcdefpme>api.serply.io/mcp</code>with your API key and Claude, Cursor, or anything else that speaks MCP gets fourteen tools for searching the live web, reading Reddit discussion, and pulling pages back as markdown. Nothing to deploy, nothing to keep running.</p><div class="mt-6 inline-flex flex-wrap items-center justify-center gap-x-3 gap-y-2 rounded-full border border-stone-200 bg-white px-4 py-2" data-astro-cid-lcdefpme><span class="font-mono text-xs uppercase tracking-widest text-brand-ink" data-astro-cid-lcdefpme>Hosted</span><span aria-hidden="true" class="h-3 w-px bg-stone-200" data-astro-cid-lcdefpme></span><code class="font-mono text-sm text-stone-900" data-astro-cid-lcdefpme>https://api.serply.io/mcp</code></div><p class="mt-4 text-sm" data-astro-cid-lcdefpme><a href="/mcp" class="font-medium text-brand-ink underline underline-offset-2" data-astro-cid-lcdefpme>Read the MCP server docs →</a></p></div><div class="mx-auto mt-10 max-w-4xl" data-astro-cid-lcdefpme><astro-island uid="2cxeup" prefix="r10" component-url="/_astro/TabbedCodeExamples.DHl22W4O.js" component-export="default" renderer-url="/_astro/client.BsxOgvle.js" props="{&quot;examples&quot;:[1,[[0,{&quot;label&quot;:[0,&quot;Claude Code&quot;],&quot;language&quot;:[0,&quot;bash&quot;],&quot;code&quot;:[0,&quot;claude mcp add --transport http serply https://api.serply.io/mcp \\\n  --header \&quot;X-Api-Key: YOUR_API_KEY\&quot;\n\n# That is the whole install. Nothing to deploy, nothing to keep running.\n# Then just ask:\n#\n#   &gt; What shipped in the httpx changelog this month?&quot;]}],[0,{&quot;label&quot;:[0,&quot;Any MCP client&quot;],&quot;language&quot;:[0,&quot;bash&quot;],&quot;code&quot;:[0,&quot;# Claude Desktop, Cursor, Windsurf - anything that speaks stdio.\n# mcp-remote bridges our HTTP server into a stdio client.\n\n{\n  \&quot;mcpServers\&quot;: {\n    \&quot;serply\&quot;: {\n      \&quot;command\&quot;: \&quot;npx\&quot;,\n      \&quot;args\&quot;: [\n        \&quot;-y\&quot;, \&quot;mcp-remote\&quot;, \&quot;https://api.serply.io/mcp\&quot;,\n        \&quot;--header\&quot;, \&quot;X-Api-Key:YOUR_API_KEY\&quot;\n      ]\n    }\n  }\n}&quot;]}],[0,{&quot;label&quot;:[0,&quot;Use it&quot;],&quot;language&quot;:[0,&quot;bash&quot;],&quot;code&quot;:[0,&quot;&gt; Which Python HTTP libraries shipped a release this month?\n\n  google_search(query: \&quot;python http library release August 2026\&quot;)\n  -&gt; 10 results\n\n  scrape_url(url: \&quot;https://github.com/encode/httpx/releases\&quot;,\n             response_type: \&quot;markdown\&quot;)\n  -&gt; 4.1 kB of markdown\n\n  Three releases landed this month: httpx 0.29.0 on the 3rd,\n  aiohttp 3.13.2 on the 9th, and requests 2.33.0 on the 11th.&quot;]}],[0,{&quot;label&quot;:[0,&quot;Or roll your own&quot;],&quot;language&quot;:[0,&quot;javascript&quot;],&quot;code&quot;:[0,&quot;import { McpServer } from \&quot;@modelcontextprotocol/server\&quot;\nimport { StdioServerTransport } from \&quot;@modelcontextprotocol/server/stdio\&quot;\nimport * as z from \&quot;zod/v4\&quot;\n\nconst KEY = process.env.SERPLY_API_KEY\nconst headers = { \&quot;X-Api-Key\&quot;: KEY, \&quot;X-Proxy-Location\&quot;: \&quot;US\&quot; }\n\nconst server = new McpServer({ name: \&quot;serply\&quot;, version: \&quot;1.0.0\&quot; })\n\nserver.registerTool(\n  \&quot;search\&quot;,\n  {\n    description: \&quot;Search Google and return live results as JSON\&quot;,\n    inputSchema: z.object({ query: z.string() }),\n  },\n  async ({ query }) =&gt; {\n    const url = `https://api.serply.io/v1/search/?q=${encodeURIComponent(query)}`\n    const { results } = await fetch(url, { headers }).then((r) =&gt; r.json())\n    return { content: [{ type: \&quot;text\&quot;, text: JSON.stringify(results, null, 2) }] }\n  }\n)\n\nserver.registerTool(\n  \&quot;fetch_markdown\&quot;,\n  {\n    description: \&quot;Fetch any URL and return it as markdown the model can read\&quot;,\n    inputSchema: z.object({ url: z.string() }),\n  },\n  async ({ url }) =&gt; {\n    const res = await fetch(\&quot;https://api.serply.io/v1/request\&quot;, {\n      method: \&quot;POST\&quot;,\n      headers: { ...headers, \&quot;Content-Type\&quot;: \&quot;application/json\&quot; },\n      body: JSON.stringify({ url, response_type: \&quot;markdown\&quot; }),\n    })\n    const { content } = await res.json()\n    return { content: [{ type: \&quot;text\&quot;, text: content }] }\n  }\n)\n\nawait server.connect(new StdioServerTransport())\n\n// Register with: claude mcp add serply -- node /path/to/server.js&quot;]}]]],&quot;data-astro-cid-lcdefpme&quot;:[0,true]}" ssr client="visible" opts="{&quot;name&quot;:&quot;TabbedCodeExamples&quot;,&quot;value&quot;:true}" await-children><div class="w-full"><div dir="ltr" data-orientation="horizontal"><div class="rounded-lg overflow-hidden" style="box-shadow:0 4px 14px 0 rgb(0 0 0 / 10%)"><div role="tablist" aria-orientation="horizontal" class="flex space-x-1 bg-stone-100 p-1" tabindex="-1" data-orientation="horizontal" style="outline:none"><button type="button" role="tab" aria-selected="true" aria-controls="radix-:r10R2:-content-0" data-state="active" id="radix-:r10R2:-trigger-0" class="px-4 py-2 text-sm font-medium rounded-md transition-all duration-200 focus:outline-none focus:ring-2 focus:ring-brand focus:ring-offset-2 bg-white text-stone-900 shadow-sm" tabindex="-1" data-orientation="horizontal" data-radix-collection-item="">Claude Code</button><button type="button" role="tab" aria-selected="false" aria-controls="radix-:r10R2:-content-1" data-state="inactive" id="radix-:r10R2:-trigger-1" class="px-4 py-2 text-sm font-medium rounded-md transition-all duration-200 focus:outline-none focus:ring-2 focus:ring-brand focus:ring-offset-2 text-stone-600 hover:text-stone-900 hover:bg-white/50" tabindex="-1" data-orientation="horizontal" data-radix-collection-item="">Any MCP client</button><button type="button" role="tab" aria-selected="false" aria-controls="radix-:r10R2:-content-2" data-state="inactive" id="radix-:r10R2:-trigger-2" class="px-4 py-2 text-sm font-medium rounded-md transition-all duration-200 focus:outline-none focus:ring-2 focus:ring-brand focus:ring-offset-2 text-stone-600 hover:text-stone-900 hover:bg-white/50" tabindex="-1" data-orientation="horizontal" data-radix-collection-item="">Use it</button><button type="button" role="tab" aria-selected="false" aria-controls="radix-:r10R2:-content-3" data-state="inactive" id="radix-:r10R2:-trigger-3" class="px-4 py-2 text-sm font-medium rounded-md transition-all duration-200 focus:outline-none focus:ring-2 focus:ring-brand focus:ring-offset-2 text-stone-600 hover:text-stone-900 hover:bg-white/50" tabindex="-1" data-orientation="horizontal" data-radix-collection-item="">Or roll your own</button></div><div data-state="active" data-orientation="horizontal" role="tabpanel" aria-labelledby="radix-:r10R2:-trigger-0" id="radix-:r10R2:-content-0" tabindex="0" class="relative" style="animation-duration:0s"><button class="absolute right-3 top-3 z-10 bg-stone-700 border border-stone-600 w-8 h-8 rounded flex items-center justify-center hover:bg-stone-600 transition-colors" title="Copy to clipboard"><svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true" data-slot="icon" class="h-4 w-4 text-stone-400"><path fill-rule="evenodd" d="M15.988 3.012A2.25 2.25 0 0 1 18 5.25v6.5A2.25 2.25 0 0 1 15.75 14H13.5v-3.379a3 3 0 0 0-.879-2.121l-3.12-3.121a3 3 0 0 0-1.402-.791 2.252 2.252 0 0 1 1.913-1.576A2.25 2.25 0 0 1 12.25 1h1.5a2.25 2.25 0 0 1 2.238 2.012ZM11.5 3.25a.75.75 0 0 1 .75-.75h1.5a.75.75 0 0 1 .75.75v.25h-3v-.25Z" clip-rule="evenodd"></path><path d="M3.5 6A1.5 1.5 0 0 0 2 7.5v9A1.5 1.5 0 0 0 3.5 18h7a1.5 1.5 0 0 0 1.5-1.5v-5.879a1.5 1.5 0 0 0-.44-1.06L8.44 6.439A1.5 1.5 0 0 0 7.378 6H3.5Z"></path></svg></button><div class="overflow-x-auto bg-stone-800 rounded-b-lg"><pre class="p-4 text-sm text-stone-100 language-bash"><code class="language-bash">claude mcp <span class="token function">add</span> <span class="token parameter variable">--transport</span> http serply https://api.serply.io/mcp <span class="token punctuation">\</span>
  <span class="token parameter variable">--header</span> <span class="token string">&quot;X-Api-Key: YOUR_API_KEY&quot;</span>

<span class="token comment"># That is the whole install. Nothing to deploy, nothing to keep running.</span>
<span class="token comment"># Then just ask:</span>
<span class="token comment">#</span>
<span class="token comment">#   &gt; What shipped in the httpx changelog this month?</span></code></pre></div></div><div data-state="inactive" data-orientation="horizontal" role="tabpanel" aria-labelledby="radix-:r10R2:-trigger-1" id="radix-:r10R2:-content-1" tabindex="0" class="relative hidden"><button class="absolute right-3 top-3 z-10 bg-stone-700 border border-stone-600 w-8 h-8 rounded flex items-center justify-center hover:bg-stone-600 transition-colors" title="Copy to clipboard"><svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true" data-slot="icon" class="h-4 w-4 text-stone-400"><path fill-rule="evenodd" d="M15.988 3.012A2.25 2.25 0 0 1 18 5.25v6.5A2.25 2.25 0 0 1 15.75 14H13.5v-3.379a3 3 0 0 0-.879-2.121l-3.12-3.121a3 3 0 0 0-1.402-.791 2.252 2.252 0 0 1 1.913-1.576A2.25 2.25 0 0 1 12.25 1h1.5a2.25 2.25 0 0 1 2.238 2.012ZM11.5 3.25a.75.75 0 0 1 .75-.75h1.5a.75.75 0 0 1 .75.75v.25h-3v-.25Z" clip-rule="evenodd"></path><path d="M3.5 6A1.5 1.5 0 0 0 2 7.5v9A1.5 1.5 0 0 0 3.5 18h7a1.5 1.5 0 0 0 1.5-1.5v-5.879a1.5 1.5 0 0 0-.44-1.06L8.44 6.439A1.5 1.5 0 0 0 7.378 6H3.5Z"></path></svg></button><div class="overflow-x-auto bg-stone-800 rounded-b-lg"><pre class="p-4 text-sm text-stone-100 language-bash"><code class="language-bash"><span class="token comment"># Claude Desktop, Cursor, Windsurf - anything that speaks stdio.</span>
<span class="token comment"># mcp-remote bridges our HTTP server into a stdio client.</span>

<span class="token punctuation">{</span>
  <span class="token string">&quot;mcpServers&quot;</span><span class="token builtin class-name">:</span> <span class="token punctuation">{</span>
    <span class="token string">&quot;serply&quot;</span><span class="token builtin class-name">:</span> <span class="token punctuation">{</span>
      <span class="token string">&quot;command&quot;</span><span class="token builtin class-name">:</span> <span class="token string">&quot;npx&quot;</span>,
      <span class="token string">&quot;args&quot;</span><span class="token builtin class-name">:</span> <span class="token punctuation">[</span>
        <span class="token string">&quot;-y&quot;</span>, <span class="token string">&quot;mcp-remote&quot;</span>, <span class="token string">&quot;https://api.serply.io/mcp&quot;</span>,
        <span class="token string">&quot;--header&quot;</span>, <span class="token string">&quot;X-Api-Key:YOUR_API_KEY&quot;</span>
      <span class="token punctuation">]</span>
    <span class="token punctuation">}</span>
  <span class="token punctuation">}</span>
<span class="token punctuation">}</span></code></pre></div></div><div data-state="inactive" data-orientation="horizontal" role="tabpanel" aria-labelledby="radix-:r10R2:-trigger-2" id="radix-:r10R2:-content-2" tabindex="0" class="relative hidden"><button class="absolute right-3 top-3 z-10 bg-stone-700 border border-stone-600 w-8 h-8 rounded flex items-center justify-center hover:bg-stone-600 transition-colors" title="Copy to clipboard"><svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true" data-slot="icon" class="h-4 w-4 text-stone-400"><path fill-rule="evenodd" d="M15.988 3.012A2.25 2.25 0 0 1 18 5.25v6.5A2.25 2.25 0 0 1 15.75 14H13.5v-3.379a3 3 0 0 0-.879-2.121l-3.12-3.121a3 3 0 0 0-1.402-.791 2.252 2.252 0 0 1 1.913-1.576A2.25 2.25 0 0 1 12.25 1h1.5a2.25 2.25 0 0 1 2.238 2.012ZM11.5 3.25a.75.75 0 0 1 .75-.75h1.5a.75.75 0 0 1 .75.75v.25h-3v-.25Z" clip-rule="evenodd"></path><path d="M3.5 6A1.5 1.5 0 0 0 2 7.5v9A1.5 1.5 0 0 0 3.5 18h7a1.5 1.5 0 0 0 1.5-1.5v-5.879a1.5 1.5 0 0 0-.44-1.06L8.44 6.439A1.5 1.5 0 0 0 7.378 6H3.5Z"></path></svg></button><div class="overflow-x-auto bg-stone-800 rounded-b-lg"><pre class="p-4 text-sm text-stone-100 language-bash"><code class="language-bash"><span class="token operator">&gt;</span> Which Python HTTP libraries shipped a release this month?

  google_search<span class="token punctuation">(</span>query: <span class="token string">&quot;python http library release August 2026&quot;</span><span class="token punctuation">)</span>
  -<span class="token operator">&gt;</span> <span class="token number">10</span> results

  scrape_url<span class="token punctuation">(</span>url: <span class="token string">&quot;https://github.com/encode/httpx/releases&quot;</span>,
             response_type: <span class="token string">&quot;markdown&quot;</span><span class="token punctuation">)</span>
  -<span class="token operator">&gt;</span> <span class="token number">4.1</span> kB of markdown

  Three releases landed this month: httpx <span class="token number">0.29</span>.0 on the 3rd,
  aiohttp <span class="token number">3.13</span>.2 on the 9th, and requests <span class="token number">2.33</span>.0 on the 11th.</code></pre></div></div><div data-state="inactive" data-orientation="horizontal" role="tabpanel" aria-labelledby="radix-:r10R2:-trigger-3" id="radix-:r10R2:-content-3" tabindex="0" class="relative hidden"><button class="absolute right-3 top-3 z-10 bg-stone-700 border border-stone-600 w-8 h-8 rounded flex items-center justify-center hover:bg-stone-600 transition-colors" title="Copy to clipboard"><svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true" data-slot="icon" class="h-4 w-4 text-stone-400"><path fill-rule="evenodd" d="M15.988 3.012A2.25 2.25 0 0 1 18 5.25v6.5A2.25 2.25 0 0 1 15.75 14H13.5v-3.379a3 3 0 0 0-.879-2.121l-3.12-3.121a3 3 0 0 0-1.402-.791 2.252 2.252 0 0 1 1.913-1.576A2.25 2.25 0 0 1 12.25 1h1.5a2.25 2.25 0 0 1 2.238 2.012ZM11.5 3.25a.75.75 0 0 1 .75-.75h1.5a.75.75 0 0 1 .75.75v.25h-3v-.25Z" clip-rule="evenodd"></path><path d="M3.5 6A1.5 1.5 0 0 0 2 7.5v9A1.5 1.5 0 0 0 3.5 18h7a1.5 1.5 0 0 0 1.5-1.5v-5.879a1.5 1.5 0 0 0-.44-1.06L8.44 6.439A1.5 1.5 0 0 0 7.378 6H3.5Z"></path></svg></button><div class="overflow-x-auto bg-stone-800 rounded-b-lg"><pre class="p-4 text-sm text-stone-100 language-javascript"><code class="language-javascript"><span class="token keyword">import</span> <span class="token punctuation">{</span> McpServer <span class="token punctuation">}</span> <span class="token keyword">from</span> <span class="token string">&quot;@modelcontextprotocol/server&quot;</span>
<span class="token keyword">import</span> <span class="token punctuation">{</span> StdioServerTransport <span class="token punctuation">}</span> <span class="token keyword">from</span> <span class="token string">&quot;@modelcontextprotocol/server/stdio&quot;</span>
<span class="token keyword">import</span> <span class="token operator">*</span> <span class="token keyword">as</span> z <span class="token keyword">from</span> <span class="token string">&quot;zod/v4&quot;</span>

<span class="token keyword">const</span> <span class="token constant">KEY</span> <span class="token operator">=</span> process<span class="token punctuation">.</span>env<span class="token punctuation">.</span><span class="token constant">SERPLY_API_KEY</span>
<span class="token keyword">const</span> headers <span class="token operator">=</span> <span class="token punctuation">{</span> <span class="token string-property property">&quot;X-Api-Key&quot;</span><span class="token operator">:</span> <span class="token constant">KEY</span><span class="token punctuation">,</span> <span class="token string-property property">&quot;X-Proxy-Location&quot;</span><span class="token operator">:</span> <span class="token string">&quot;US&quot;</span> <span class="token punctuation">}</span>

<span class="token keyword">const</span> server <span class="token operator">=</span> <span class="token keyword">new</span> <span class="token class-name">McpServer</span><span class="token punctuation">(</span><span class="token punctuation">{</span> <span class="token literal-property property">name</span><span class="token operator">:</span> <span class="token string">&quot;serply&quot;</span><span class="token punctuation">,</span> <span class="token literal-property property">version</span><span class="token operator">:</span> <span class="token string">&quot;1.0.0&quot;</span> <span class="token punctuation">}</span><span class="token punctuation">)</span>

server<span class="token punctuation">.</span><span class="token function">registerTool</span><span class="token punctuation">(</span>
  <span class="token string">&quot;search&quot;</span><span class="token punctuation">,</span>
  <span class="token punctuation">{</span>
    <span class="token literal-property property">description</span><span class="token operator">:</span> <span class="token string">&quot;Search Google and return live results as JSON&quot;</span><span class="token punctuation">,</span>
    <span class="token literal-property property">inputSchema</span><span class="token operator">:</span> z<span class="token punctuation">.</span><span class="token function">object</span><span class="token punctuation">(</span><span class="token punctuation">{</span> <span class="token literal-property property">query</span><span class="token operator">:</span> z<span class="token punctuation">.</span><span class="token function">string</span><span class="token punctuation">(</span><span class="token punctuation">)</span> <span class="token punctuation">}</span><span class="token punctuation">)</span><span class="token punctuation">,</span>
  <span class="token punctuation">}</span><span class="token punctuation">,</span>
  <span class="token keyword">async</span> <span class="token punctuation">(</span><span class="token parameter"><span class="token punctuation">{</span> query <span class="token punctuation">}</span></span><span class="token punctuation">)</span> <span class="token operator">=&gt;</span> <span class="token punctuation">{</span>
    <span class="token keyword">const</span> url <span class="token operator">=</span> <span class="token template-string"><span class="token template-punctuation string">`</span><span class="token string">https://api.serply.io/v1/search/?q=</span><span class="token interpolation"><span class="token interpolation-punctuation punctuation">${</span><span class="token function">encodeURIComponent</span><span class="token punctuation">(</span>query<span class="token punctuation">)</span><span class="token interpolation-punctuation punctuation">}</span></span><span class="token template-punctuation string">`</span></span>
    <span class="token keyword">const</span> <span class="token punctuation">{</span> results <span class="token punctuation">}</span> <span class="token operator">=</span> <span class="token keyword">await</span> <span class="token function">fetch</span><span class="token punctuation">(</span>url<span class="token punctuation">,</span> <span class="token punctuation">{</span> headers <span class="token punctuation">}</span><span class="token punctuation">)</span><span class="token punctuation">.</span><span class="token function">then</span><span class="token punctuation">(</span><span class="token punctuation">(</span><span class="token parameter">r</span><span class="token punctuation">)</span> <span class="token operator">=&gt;</span> r<span class="token punctuation">.</span><span class="token function">json</span><span class="token punctuation">(</span><span class="token punctuation">)</span><span class="token punctuation">)</span>
    <span class="token keyword">return</span> <span class="token punctuation">{</span> <span class="token literal-property property">content</span><span class="token operator">:</span> <span class="token punctuation">[</span><span class="token punctuation">{</span> <span class="token literal-property property">type</span><span class="token operator">:</span> <span class="token string">&quot;text&quot;</span><span class="token punctuation">,</span> <span class="token literal-property property">text</span><span class="token operator">:</span> <span class="token constant">JSON</span><span class="token punctuation">.</span><span class="token function">stringify</span><span class="token punctuation">(</span>results<span class="token punctuation">,</span> <span class="token keyword">null</span><span class="token punctuation">,</span> <span class="token number">2</span><span class="token punctuation">)</span> <span class="token punctuation">}</span><span class="token punctuation">]</span> <span class="token punctuation">}</span>
  <span class="token punctuation">}</span>
<span class="token punctuation">)</span>

server<span class="token punctuation">.</span><span class="token function">registerTool</span><span class="token punctuation">(</span>
  <span class="token string">&quot;fetch_markdown&quot;</span><span class="token punctuation">,</span>
  <span class="token punctuation">{</span>
    <span class="token literal-property property">description</span><span class="token operator">:</span> <span class="token string">&quot;Fetch any URL and return it as markdown the model can read&quot;</span><span class="token punctuation">,</span>
    <span class="token literal-property property">inputSchema</span><span class="token operator">:</span> z<span class="token punctuation">.</span><span class="token function">object</span><span class="token punctuation">(</span><span class="token punctuation">{</span> <span class="token literal-property property">url</span><span class="token operator">:</span> z<span class="token punctuation">.</span><span class="token function">string</span><span class="token punctuation">(</span><span class="token punctuation">)</span> <span class="token punctuation">}</span><span class="token punctuation">)</span><span class="token punctuation">,</span>
  <span class="token punctuation">}</span><span class="token punctuation">,</span>
  <span class="token keyword">async</span> <span class="token punctuation">(</span><span class="token parameter"><span class="token punctuation">{</span> url <span class="token punctuation">}</span></span><span class="token punctuation">)</span> <span class="token operator">=&gt;</span> <span class="token punctuation">{</span>
    <span class="token keyword">const</span> res <span class="token operator">=</span> <span class="token keyword">await</span> <span class="token function">fetch</span><span class="token punctuation">(</span><span class="token string">&quot;https://api.serply.io/v1/request&quot;</span><span class="token punctuation">,</span> <span class="token punctuation">{</span>
      <span class="token literal-property property">method</span><span class="token operator">:</span> <span class="token string">&quot;POST&quot;</span><span class="token punctuation">,</span>
      <span class="token literal-property property">headers</span><span class="token operator">:</span> <span class="token punctuation">{</span> <span class="token operator">...</span>headers<span class="token punctuation">,</span> <span class="token string-property property">&quot;Content-Type&quot;</span><span class="token operator">:</span> <span class="token string">&quot;application/json&quot;</span> <span class="token punctuation">}</span><span class="token punctuation">,</span>
      <span class="token literal-property property">body</span><span class="token operator">:</span> <span class="token constant">JSON</span><span class="token punctuation">.</span><span class="token function">stringify</span><span class="token punctuation">(</span><span class="token punctuation">{</span> url<span class="token punctuation">,</span> <span class="token literal-property property">response_type</span><span class="token operator">:</span> <span class="token string">&quot;markdown&quot;</span> <span class="token punctuation">}</span><span class="token punctuation">)</span><span class="token punctuation">,</span>
    <span class="token punctuation">}</span><span class="token punctuation">)</span>
    <span class="token keyword">const</span> <span class="token punctuation">{</span> content <span class="token punctuation">}</span> <span class="token operator">=</span> <span class="token keyword">await</span> res<span class="token punctuation">.</span><span class="token function">json</span><span class="token punctuation">(</span><span class="token punctuation">)</span>
    <span class="token keyword">return</span> <span class="token punctuation">{</span> <span class="token literal-property property">content</span><span class="token operator">:</span> <span class="token punctuation">[</span><span class="token punctuation">{</span> <span class="token literal-property property">type</span><span class="token operator">:</span> <span class="token string">&quot;text&quot;</span><span class="token punctuation">,</span> <span class="token literal-property property">text</span><span class="token operator">:</span> content <span class="token punctuation">}</span><span class="token punctuation">]</span> <span class="token punctuation">}</span>
  <span class="token punctuation">}</span>
<span class="token punctuation">)</span>

<span class="token keyword">await</span> server<span class="token punctuation">.</span><span class="token function">connect</span><span class="token punctuation">(</span><span class="token keyword">new</span> <span class="token class-name">StdioServerTransport</span><span class="token punctuation">(</span><span class="token punctuation">)</span><span class="token punctuation">)</span>

<span class="token comment">// Register with: claude mcp add serply -- node /path/to/server.js</span></code></pre></div></div></div></div></div><!--astro:end--></astro-island></div><div class="mx-auto mt-12 max-w-5xl" data-astro-cid-lcdefpme><h3 class="text-center text-lg font-semibold text-stone-900" data-astro-cid-lcdefpme>Fourteen tools, live on the hosted server</h3><div class="mt-6 grid gap-4 sm:grid-cols-2" data-astro-cid-lcdefpme><div class="rounded-xl border border-stone-200 bg-white p-5" data-astro-cid-lcdefpme><code class="font-mono text-sm font-semibold text-stone-900" data-astro-cid-lcdefpme>google_search</code><p class="mt-1.5 font-mono text-[11px] leading-relaxed text-stone-500" data-astro-cid-lcdefpme>query, num, start, proxy_location, device</p><p class="mt-2.5 text-sm leading-relaxed text-stone-600" data-astro-cid-lcdefpme>Organic Google results. The default reach for anything factual or recent.</p></div><div class="rounded-xl border border-stone-200 bg-white p-5" data-astro-cid-lcdefpme><code class="font-mono text-sm font-semibold text-stone-900" data-astro-cid-lcdefpme>bing_search</code><p class="mt-1.5 font-mono text-[11px] leading-relaxed text-stone-500" data-astro-cid-lcdefpme>query, proxy_location, device</p><p class="mt-2.5 text-sm leading-relaxed text-stone-600" data-astro-cid-lcdefpme>A second index, plus ads and shopping ads Google does not return.</p></div><div class="rounded-xl border border-stone-200 bg-white p-5" data-astro-cid-lcdefpme><code class="font-mono text-sm font-semibold text-stone-900" data-astro-cid-lcdefpme>google_news_search</code><p class="mt-1.5 font-mono text-[11px] leading-relaxed text-stone-500" data-astro-cid-lcdefpme>query, ceid, proxy_location, device</p><p class="mt-2.5 text-sm leading-relaxed text-stone-600" data-astro-cid-lcdefpme>News coverage with publisher and date. ceid picks the country edition.</p></div><div class="rounded-xl border border-stone-200 bg-white p-5" data-astro-cid-lcdefpme><code class="font-mono text-sm font-semibold text-stone-900" data-astro-cid-lcdefpme>scrape_url</code><p class="mt-1.5 font-mono text-[11px] leading-relaxed text-stone-500" data-astro-cid-lcdefpme>url, response_type</p><p class="mt-2.5 text-sm leading-relaxed text-stone-600" data-astro-cid-lcdefpme>Read any public page. Ask for markdown and the nav bars never reach the model.</p></div><div class="rounded-xl border border-stone-200 bg-white p-5" data-astro-cid-lcdefpme><code class="font-mono text-sm font-semibold text-stone-900" data-astro-cid-lcdefpme>google_scholar_search</code><p class="mt-1.5 font-mono text-[11px] leading-relaxed text-stone-500" data-astro-cid-lcdefpme>query, num, proxy_location, device</p><p class="mt-2.5 text-sm leading-relaxed text-stone-600" data-astro-cid-lcdefpme>Peer-reviewed papers and citations, for agents doing literature work.</p></div><div class="rounded-xl border border-stone-200 bg-white p-5" data-astro-cid-lcdefpme><code class="font-mono text-sm font-semibold text-stone-900" data-astro-cid-lcdefpme>google_video_search</code><p class="mt-1.5 font-mono text-[11px] leading-relaxed text-stone-500" data-astro-cid-lcdefpme>query, num, proxy_location, device</p><p class="mt-2.5 text-sm leading-relaxed text-stone-600" data-astro-cid-lcdefpme>Video results - tutorials, demos, news clips.</p></div><div class="rounded-xl border border-stone-200 bg-white p-5" data-astro-cid-lcdefpme><code class="font-mono text-sm font-semibold text-stone-900" data-astro-cid-lcdefpme>google_jobs_search</code><p class="mt-1.5 font-mono text-[11px] leading-relaxed text-stone-500" data-astro-cid-lcdefpme>query, proxy_location, device</p><p class="mt-2.5 text-sm leading-relaxed text-stone-600" data-astro-cid-lcdefpme>Postings from Google&#39;s jobs index, which aggregates LinkedIn and Indeed.</p></div><div class="rounded-xl border border-stone-200 bg-white p-5" data-astro-cid-lcdefpme><code class="font-mono text-sm font-semibold text-stone-900" data-astro-cid-lcdefpme>amazon_product_search</code><p class="mt-1.5 font-mono text-[11px] leading-relaxed text-stone-500" data-astro-cid-lcdefpme>query, proxy_location, device</p><p class="mt-2.5 text-sm leading-relaxed text-stone-600" data-astro-cid-lcdefpme>Product listings with prices and availability, via Google Shopping.</p></div><div class="rounded-xl border border-stone-200 bg-white p-5" data-astro-cid-lcdefpme><code class="font-mono text-sm font-semibold text-stone-900" data-astro-cid-lcdefpme>google_maps_search</code><p class="mt-1.5 font-mono text-[11px] leading-relaxed text-stone-500" data-astro-cid-lcdefpme>query, num, hl, gl</p><p class="mt-2.5 text-sm leading-relaxed text-stone-600" data-astro-cid-lcdefpme>Local businesses with address, coordinates, rating, phone, and hours. Put the location in the query.</p></div><div class="rounded-xl border border-stone-200 bg-white p-5" data-astro-cid-lcdefpme><code class="font-mono text-sm font-semibold text-stone-900" data-astro-cid-lcdefpme>reddit_subreddit_posts</code><p class="mt-1.5 font-mono text-[11px] leading-relaxed text-stone-500" data-astro-cid-lcdefpme>subreddit, limit, sort, t, after</p><p class="mt-2.5 text-sm leading-relaxed text-stone-600" data-astro-cid-lcdefpme>A subreddit listing, rendered. Takes r/python or python either way.</p></div><div class="rounded-xl border border-stone-200 bg-white p-5" data-astro-cid-lcdefpme><code class="font-mono text-sm font-semibold text-stone-900" data-astro-cid-lcdefpme>reddit_subreddit_about</code><p class="mt-1.5 font-mono text-[11px] leading-relaxed text-stone-500" data-astro-cid-lcdefpme>subreddit</p><p class="mt-2.5 text-sm leading-relaxed text-stone-600" data-astro-cid-lcdefpme>Subscriber count, description, and rules - enough to judge whether a community is worth reading.</p></div><div class="rounded-xl border border-stone-200 bg-white p-5" data-astro-cid-lcdefpme><code class="font-mono text-sm font-semibold text-stone-900" data-astro-cid-lcdefpme>reddit_user_posts</code><p class="mt-1.5 font-mono text-[11px] leading-relaxed text-stone-500" data-astro-cid-lcdefpme>username, limit, sort, t, after</p><p class="mt-2.5 text-sm leading-relaxed text-stone-600" data-astro-cid-lcdefpme>One account&#39;s history, for checking whether a strong opinion comes from a real participant.</p></div><div class="rounded-xl border border-stone-200 bg-white p-5" data-astro-cid-lcdefpme><code class="font-mono text-sm font-semibold text-stone-900" data-astro-cid-lcdefpme>reddit_post</code><p class="mt-1.5 font-mono text-[11px] leading-relaxed text-stone-500" data-astro-cid-lcdefpme>post_id, with_comments, sort, max_depth</p><p class="mt-2.5 text-sm leading-relaxed text-stone-600" data-astro-cid-lcdefpme>A single post with its body. Add with_comments for the thread underneath.</p></div><div class="rounded-xl border border-stone-200 bg-white p-5" data-astro-cid-lcdefpme><code class="font-mono text-sm font-semibold text-stone-900" data-astro-cid-lcdefpme>reddit_post_comments</code><p class="mt-1.5 font-mono text-[11px] leading-relaxed text-stone-500" data-astro-cid-lcdefpme>post_id, sort, max_depth</p><p class="mt-2.5 text-sm leading-relaxed text-stone-600" data-astro-cid-lcdefpme>The comment tree with scores, nested to the depth you ask for.</p></div></div></div><div class="mx-auto mt-8 grid max-w-5xl gap-4 sm:grid-cols-3" data-astro-cid-lcdefpme><div class="rounded-xl border border-stone-200 bg-white p-5" data-astro-cid-lcdefpme><p class="font-mono text-xs uppercase tracking-widest text-stone-600" data-astro-cid-lcdefpme>Real time</p><p class="mt-2 text-sm leading-relaxed text-stone-600" data-astro-cid-lcdefpme>Every call hits the live index. An agent asking about this morning gets this morning, not a training cutoff.</p></div><div class="rounded-xl border border-stone-200 bg-white p-5" data-astro-cid-lcdefpme><p class="font-mono text-xs uppercase tracking-widest text-stone-600" data-astro-cid-lcdefpme>Markdown</p><p class="mt-2 text-sm leading-relaxed text-stone-600" data-astro-cid-lcdefpme>Pages come back as prose, headings, and links. No nav bars or script tags eating the context window.</p></div><div class="rounded-xl border border-stone-200 bg-white p-5" data-astro-cid-lcdefpme><p class="font-mono text-xs uppercase tracking-widest text-stone-600" data-astro-cid-lcdefpme>Your own key</p><p class="mt-2 text-sm leading-relaxed text-stone-600" data-astro-cid-lcdefpme>Calls bill against the same credits as the REST API, at the same rate. The free 2,500 work here too.</p></div></div></section><section class="my-16 sm:my-24" aria-labelledby="endpoints-heading" data-astro-cid-lcdefpme><div class="mx-auto max-w-3xl text-center" data-astro-cid-lcdefpme><p class="font-mono text-xs uppercase tracking-widest text-brand-ink" data-astro-cid-lcdefpme>Endpoints</p><h2 id="endpoints-heading" class="mt-3 text-3xl font-bold tracking-tight text-stone-900 sm:text-4xl" data-astro-cid-lcdefpme>Twelve endpoints, one API key</h2><p class="mt-4 text-lg text-stone-600" data-astro-cid-lcdefpme>Same authentication, same response conventions, same location and device headers across all of them.</p></div><div class="mt-10 grid gap-4 sm:grid-cols-2 lg:grid-cols-3" data-astro-cid-lcdefpme><a href="/google-search-api" class="group flex flex-col rounded-xl border border-stone-200 bg-white p-5 transition hover:border-brand-line hover:shadow-md" data-astro-cid-lcdefpme><h3 class="font-semibold text-stone-900 group-hover:text-brand-ink" data-astro-cid-lcdefpme>Google Search</h3><code class="mt-2 block font-mono text-xs text-stone-500" data-astro-cid-lcdefpme>GET /v1/search</code><p class="mt-3 flex-1 text-sm leading-relaxed text-stone-600" data-astro-cid-lcdefpme>Organic results as title, link, and description, with the answer box when Google shows one.</p><code class="mt-4 block truncate border-t border-stone-100 pt-3 font-mono text-[11px] text-stone-500" data-astro-cid-lcdefpme>results[] · total · answer</code></a><a href="/google-news-api" class="group flex flex-col rounded-xl border border-stone-200 bg-white p-5 transition hover:border-brand-line hover:shadow-md" data-astro-cid-lcdefpme><h3 class="font-semibold text-stone-900 group-hover:text-brand-ink" data-astro-cid-lcdefpme>Google News</h3><code class="mt-2 block font-mono text-xs text-stone-500" data-astro-cid-lcdefpme>GET /v1/news</code><p class="mt-3 flex-1 text-sm leading-relaxed text-stone-600" data-astro-cid-lcdefpme>Articles with publisher, publication date, and summary, plus the entities behind the story.</p><code class="mt-4 block truncate border-t border-stone-100 pt-3 font-mono text-[11px] text-stone-500" data-astro-cid-lcdefpme>feed.entries[] · entities[]</code></a><a href="/google-maps-api" class="group flex flex-col rounded-xl border border-stone-200 bg-white p-5 transition hover:border-brand-line hover:shadow-md" data-astro-cid-lcdefpme><h3 class="font-semibold text-stone-900 group-hover:text-brand-ink" data-astro-cid-lcdefpme>Google Maps</h3><code class="mt-2 block font-mono text-xs text-stone-500" data-astro-cid-lcdefpme>GET /v1/maps/search</code><p class="mt-3 flex-1 text-sm leading-relaxed text-stone-600" data-astro-cid-lcdefpme>Local listings with website, address, coordinates, star rating, and review count.</p><code class="mt-4 block truncate border-t border-stone-100 pt-3 font-mono text-[11px] text-stone-500" data-astro-cid-lcdefpme>places[] · lat/long · rating</code></a><a href="/google-images-api" class="group flex flex-col rounded-xl border border-stone-200 bg-white p-5 transition hover:border-brand-line hover:shadow-md" data-astro-cid-lcdefpme><h3 class="font-semibold text-stone-900 group-hover:text-brand-ink" data-astro-cid-lcdefpme>Google Images</h3><code class="mt-2 block font-mono text-xs text-stone-500" data-astro-cid-lcdefpme>GET /v1/image</code><p class="mt-3 flex-1 text-sm leading-relaxed text-stone-600" data-astro-cid-lcdefpme>Images with their source page, dimensions, file size, and a thumbnail URL.</p><code class="mt-4 block truncate border-t border-stone-100 pt-3 font-mono text-[11px] text-stone-500" data-astro-cid-lcdefpme>image_results[] · original_image · thumbnails</code></a><a href="/google-jobs-api" class="group flex flex-col rounded-xl border border-stone-200 bg-white p-5 transition hover:border-brand-line hover:shadow-md" data-astro-cid-lcdefpme><h3 class="font-semibold text-stone-900 group-hover:text-brand-ink" data-astro-cid-lcdefpme>Google Jobs</h3><code class="mt-2 block font-mono text-xs text-stone-500" data-astro-cid-lcdefpme>GET /v1/job/search</code><p class="mt-3 flex-1 text-sm leading-relaxed text-stone-600" data-astro-cid-lcdefpme>Postings with employer, highlights, perks, remote and hybrid flags, and an apply link.</p><code class="mt-4 block truncate border-t border-stone-100 pt-3 font-mono text-[11px] text-stone-500" data-astro-cid-lcdefpme>jobs[] · employer · is_remote</code></a><a href="/google-scholar-api" class="group flex flex-col rounded-xl border border-stone-200 bg-white p-5 transition hover:border-brand-line hover:shadow-md" data-astro-cid-lcdefpme><h3 class="font-semibold text-stone-900 group-hover:text-brand-ink" data-astro-cid-lcdefpme>Google Scholar</h3><code class="mt-2 block font-mono text-xs text-stone-500" data-astro-cid-lcdefpme>GET /v1/scholar</code><p class="mt-3 flex-1 text-sm leading-relaxed text-stone-600" data-astro-cid-lcdefpme>Academic papers with title, link, and abstract, geo-targeted like any other search.</p><code class="mt-4 block truncate border-t border-stone-100 pt-3 font-mono text-[11px] text-stone-500" data-astro-cid-lcdefpme>results[] · total</code></a><a href="/google-product-api" class="group flex flex-col rounded-xl border border-stone-200 bg-white p-5 transition hover:border-brand-line hover:shadow-md" data-astro-cid-lcdefpme><h3 class="font-semibold text-stone-900 group-hover:text-brand-ink" data-astro-cid-lcdefpme>Product Search</h3><code class="mt-2 block font-mono text-xs text-stone-500" data-astro-cid-lcdefpme>GET /v1/product/search</code><p class="mt-3 flex-1 text-sm leading-relaxed text-stone-600" data-astro-cid-lcdefpme>Amazon listings with price, ASIN, star rating, review count, and Prime and bestseller flags.</p><code class="mt-4 block truncate border-t border-stone-100 pt-3 font-mono text-[11px] text-stone-500" data-astro-cid-lcdefpme>price · rating_stars · prime</code></a><a href="/ebay-api" class="group flex flex-col rounded-xl border border-stone-200 bg-white p-5 transition hover:border-brand-line hover:shadow-md" data-astro-cid-lcdefpme><h3 class="font-semibold text-stone-900 group-hover:text-brand-ink" data-astro-cid-lcdefpme>eBay Search</h3><code class="mt-2 block font-mono text-xs text-stone-500" data-astro-cid-lcdefpme>GET /v1/ebay/search/{query}</code><p class="mt-3 flex-1 text-sm leading-relaxed text-stone-600" data-astro-cid-lcdefpme>eBay listings with price, condition, seller feedback, and delivery details for each result.</p><code class="mt-4 block truncate border-t border-stone-100 pt-3 font-mono text-[11px] text-stone-500" data-astro-cid-lcdefpme>price · condition · seller</code></a><a href="/google-video-api" class="group flex flex-col rounded-xl border border-stone-200 bg-white p-5 transition hover:border-brand-line hover:shadow-md" data-astro-cid-lcdefpme><h3 class="font-semibold text-stone-900 group-hover:text-brand-ink" data-astro-cid-lcdefpme>Google Video</h3><code class="mt-2 block font-mono text-xs text-stone-500" data-astro-cid-lcdefpme>GET /v1/video</code><p class="mt-3 flex-1 text-sm leading-relaxed text-stone-600" data-astro-cid-lcdefpme>Video results with title, link, and description, in the same shape as web search.</p><code class="mt-4 block truncate border-t border-stone-100 pt-3 font-mono text-[11px] text-stone-500" data-astro-cid-lcdefpme>results[] · total · answer</code></a><a href="/bing-search-api" class="group flex flex-col rounded-xl border border-stone-200 bg-white p-5 transition hover:border-brand-line hover:shadow-md" data-astro-cid-lcdefpme><h3 class="font-semibold text-stone-900 group-hover:text-brand-ink" data-astro-cid-lcdefpme>Bing Search</h3><code class="mt-2 block font-mono text-xs text-stone-500" data-astro-cid-lcdefpme>GET /v1/b/search</code><p class="mt-3 flex-1 text-sm leading-relaxed text-stone-600" data-astro-cid-lcdefpme>Bing organic results alongside text ads and shopping ads, each with its own position.</p><code class="mt-4 block truncate border-t border-stone-100 pt-3 font-mono text-[11px] text-stone-500" data-astro-cid-lcdefpme>results[] · ads[] · shoppingAds[]</code></a><a href="/reddit-api" class="group flex flex-col rounded-xl border border-stone-200 bg-white p-5 transition hover:border-brand-line hover:shadow-md" data-astro-cid-lcdefpme><h3 class="font-semibold text-stone-900 group-hover:text-brand-ink" data-astro-cid-lcdefpme>Reddit</h3><code class="mt-2 block font-mono text-xs text-stone-500" data-astro-cid-lcdefpme>GET /v1/reddit/subreddit/{subreddit}</code><p class="mt-3 flex-1 text-sm leading-relaxed text-stone-600" data-astro-cid-lcdefpme>Subreddit listings, subreddit metadata, user post history, single posts, and comment threads in Reddit&#39;s own JSON shape.</p><code class="mt-4 block truncate border-t border-stone-100 pt-3 font-mono text-[11px] text-stone-500" data-astro-cid-lcdefpme>kind · data.after · data.children[]</code></a><a href="/web-scraping-api" class="group flex flex-col rounded-xl border border-stone-200 bg-white p-5 transition hover:border-brand-line hover:shadow-md" data-astro-cid-lcdefpme><h3 class="font-semibold text-stone-900 group-hover:text-brand-ink" data-astro-cid-lcdefpme>Page Fetch</h3><code class="mt-2 block font-mono text-xs text-stone-500" data-astro-cid-lcdefpme>GET /v1/request</code><p class="mt-3 flex-1 text-sm leading-relaxed text-stone-600" data-astro-cid-lcdefpme>Any URL returned as raw HTML or as markdown, with CAPTCHAs handled on the way.</p><code class="mt-4 block truncate border-t border-stone-100 pt-3 font-mono text-[11px] text-stone-500" data-astro-cid-lcdefpme>content · url · response_type</code></a></div></section><section class="my-16 rounded-2xl border border-stone-200 bg-stone-50 px-6 py-12 sm:my-24 sm:px-10 sm:py-14" aria-labelledby="why-heading" data-astro-cid-lcdefpme><div class="mx-auto max-w-3xl text-center" data-astro-cid-lcdefpme><h2 id="why-heading" class="text-3xl font-bold tracking-tight text-stone-900 sm:text-4xl" data-astro-cid-lcdefpme>The hard part, already solved</h2><p class="mt-4 text-lg text-stone-600" data-astro-cid-lcdefpme>Scraping search is easy to prototype and miserable to operate. That gap is the whole product.</p></div><div class="mx-auto mt-10 grid max-w-5xl gap-8 sm:grid-cols-4" data-astro-cid-lcdefpme><div class="text-center" data-astro-cid-lcdefpme><div class="text-4xl font-bold tracking-tight text-brand" data-astro-cid-lcdefpme>~900ms</div><div class="mt-2 font-semibold text-stone-900" data-astro-cid-lcdefpme>Average response</div><p class="mt-2 text-sm leading-relaxed text-stone-600" data-astro-cid-lcdefpme>Fast enough to sit in a request path instead of a background job.</p></div><div class="text-center" data-astro-cid-lcdefpme><div class="text-4xl font-bold tracking-tight text-brand" data-astro-cid-lcdefpme>Zero</div><div class="mt-2 font-semibold text-stone-900" data-astro-cid-lcdefpme>CAPTCHAs to solve</div><p class="mt-2 text-sm leading-relaxed text-stone-600" data-astro-cid-lcdefpme>Proxy rotation and challenge handling happen before you see a response.</p></div><div class="text-center" data-astro-cid-lcdefpme><div class="text-4xl font-bold tracking-tight text-brand" data-astro-cid-lcdefpme>14</div><div class="mt-2 font-semibold text-stone-900" data-astro-cid-lcdefpme>Countries</div><p class="mt-2 text-sm leading-relaxed text-stone-600" data-astro-cid-lcdefpme>Search as the US, UK, Germany, Japan, India, Brazil and more, on desktop or mobile.</p></div><div class="text-center" data-astro-cid-lcdefpme><div class="text-4xl font-bold tracking-tight text-brand" data-astro-cid-lcdefpme>4 yrs</div><div class="mt-2 font-semibold text-stone-900" data-astro-cid-lcdefpme>Of service</div><p class="mt-2 text-sm leading-relaxed text-stone-600" data-astro-cid-lcdefpme>Run continuously since launch, with support that answers in hours.</p></div></div></section><section class="my-16 sm:my-24" aria-labelledby="usecases-heading" data-astro-cid-lcdefpme><div class="mx-auto max-w-3xl text-center" data-astro-cid-lcdefpme><p class="font-mono text-xs uppercase tracking-widest text-brand-ink" data-astro-cid-lcdefpme>Use cases</p><h2 id="usecases-heading" class="mt-3 text-3xl font-bold tracking-tight text-stone-900 sm:text-4xl" data-astro-cid-lcdefpme>What people build with it</h2></div><div class="mt-12" data-astro-cid-lcdefpme><div class="mx-auto max-w-3xl border-l-2 border-brand pl-5" data-astro-cid-lcdefpme><h3 class="text-xl font-semibold text-stone-900" data-astro-cid-lcdefpme>AI applications</h3><p class="mt-1 leading-relaxed text-stone-600" data-astro-cid-lcdefpme>A model is only as current as what you hand it. These are the jobs that need live search behind them.</p></div><div class="mt-8 grid gap-6 sm:grid-cols-2 lg:grid-cols-3" data-astro-cid-lcdefpme><div class="rounded-xl border border-stone-200 bg-white p-6" data-astro-cid-lcdefpme><h4 class="font-semibold text-stone-900" data-astro-cid-lcdefpme>Retrieval and grounding</h4><p class="mt-3 text-sm leading-relaxed text-stone-600" data-astro-cid-lcdefpme>Fetch current sources at query time so an answer rests on this week&#39;s web rather than a training cutoff. Results arrive as fields, so your retrieval step starts at ranking rather than at an HTML parser.</p></div><div class="rounded-xl border border-stone-200 bg-white p-6" data-astro-cid-lcdefpme><h4 class="font-semibold text-stone-900" data-astro-cid-lcdefpme>Agent tool calls</h4><p class="mt-3 text-sm leading-relaxed text-stone-600" data-astro-cid-lcdefpme>A search tool an agent can call in a loop. One key, a stable schema, and latency low enough that a multi-step plan does not stall waiting on its own research.</p></div><div class="rounded-xl border border-stone-200 bg-white p-6" data-astro-cid-lcdefpme><h4 class="font-semibold text-stone-900" data-astro-cid-lcdefpme>Deep research pipelines</h4><p class="mt-3 text-sm leading-relaxed text-stone-600" data-astro-cid-lcdefpme>Search for the sources, then send each link through /v1/request with response_type set to markdown. What comes back is already in the format a model reads best - no boilerplate stripping in between.</p></div><div class="rounded-xl border border-stone-200 bg-white p-6" data-astro-cid-lcdefpme><h4 class="font-semibold text-stone-900" data-astro-cid-lcdefpme>Answer engines with citations</h4><p class="mt-3 text-sm leading-relaxed text-stone-600" data-astro-cid-lcdefpme>Every result carries the URL it came from, so an answer can show its work. That is the difference between a chatbot and something a user is willing to act on.</p></div><div class="rounded-xl border border-stone-200 bg-white p-6" data-astro-cid-lcdefpme><h4 class="font-semibold text-stone-900" data-astro-cid-lcdefpme>Evaluation and benchmark data</h4><p class="mt-3 text-sm leading-relaxed text-stone-600" data-astro-cid-lcdefpme>Collect real SERPs on a schedule to test retrieval quality, measure drift, or build a fixture set that reflects what your users actually see.</p></div><div class="rounded-xl border border-stone-200 bg-white p-6" data-astro-cid-lcdefpme><h4 class="font-semibold text-stone-900" data-astro-cid-lcdefpme>Migrating off a retired API</h4><p class="mt-3 text-sm leading-relaxed text-stone-600" data-astro-cid-lcdefpme>Microsoft retired the Bing Search APIs on 11 August 2025 and pointed developers at a full platform rather than an endpoint. /v1/b/search still returns Bing organic results, text ads, and shopping ads as JSON.</p></div></div></div><div class="mt-12" data-astro-cid-lcdefpme><div class="mx-auto max-w-3xl border-l-2 border-brand pl-5" data-astro-cid-lcdefpme><h3 class="text-xl font-semibold text-stone-900" data-astro-cid-lcdefpme>Search and market data</h3><p class="mt-1 leading-relaxed text-stone-600" data-astro-cid-lcdefpme>The long-standing work: knowing where you rank, what competitors are doing, and what things cost.</p></div><div class="mt-8 grid gap-6 sm:grid-cols-2 lg:grid-cols-3" data-astro-cid-lcdefpme><div class="rounded-xl border border-stone-200 bg-white p-6" data-astro-cid-lcdefpme><h4 class="font-semibold text-stone-900" data-astro-cid-lcdefpme>Rank tracking</h4><p class="mt-3 text-sm leading-relaxed text-stone-600" data-astro-cid-lcdefpme>Query from any of fourteen countries as desktop or mobile, and read positions back as data. Both matter - mobile and desktop SERPs disagree often enough that tracking one and reporting both is simply wrong.</p></div><div class="rounded-xl border border-stone-200 bg-white p-6" data-astro-cid-lcdefpme><h4 class="font-semibold text-stone-900" data-astro-cid-lcdefpme>Ad and competitor monitoring</h4><p class="mt-3 text-sm leading-relaxed text-stone-600" data-astro-cid-lcdefpme>Bing search returns ads and shopping ads separately from organic results, each with advertiser, price, and position, so you can watch who is bidding against you and what they charge.</p></div><div class="rounded-xl border border-stone-200 bg-white p-6" data-astro-cid-lcdefpme><h4 class="font-semibold text-stone-900" data-astro-cid-lcdefpme>Local SEO and reviews</h4><p class="mt-3 text-sm leading-relaxed text-stone-600" data-astro-cid-lcdefpme>Maps returns rating, review count, and a review URL per place, with coordinates. Enough to track a location&#39;s standing over time or to audit a multi-branch footprint.</p></div><div class="rounded-xl border border-stone-200 bg-white p-6" data-astro-cid-lcdefpme><h4 class="font-semibold text-stone-900" data-astro-cid-lcdefpme>Lead and company enrichment</h4><p class="mt-3 text-sm leading-relaxed text-stone-600" data-astro-cid-lcdefpme>Resolve a business to its website, bare domain, full address, and coordinates from a name and a city, using live search rather than a directory that went stale two years ago.</p></div><div class="rounded-xl border border-stone-200 bg-white p-6" data-astro-cid-lcdefpme><h4 class="font-semibold text-stone-900" data-astro-cid-lcdefpme>Price and product monitoring</h4><p class="mt-3 text-sm leading-relaxed text-stone-600" data-astro-cid-lcdefpme>Track price, rating, review count, and Prime or bestseller status on Amazon listings without maintaining a scraper that breaks every time the page changes.</p></div><div class="rounded-xl border border-stone-200 bg-white p-6" data-astro-cid-lcdefpme><h4 class="font-semibold text-stone-900" data-astro-cid-lcdefpme>Labour market and academic research</h4><p class="mt-3 text-sm leading-relaxed text-stone-600" data-astro-cid-lcdefpme>Jobs returns employer, perks, and remote or hybrid flags; Scholar returns papers and abstracts. Same key, same headers, same response conventions as everything else.</p></div></div></div></section><section class="my-16 sm:my-24" aria-labelledby="faq-heading" data-astro-cid-lcdefpme><div class="mx-auto max-w-3xl text-center" data-astro-cid-lcdefpme><p class="font-mono text-xs uppercase tracking-widest text-brand-ink" data-astro-cid-lcdefpme>FAQ</p><h2 id="faq-heading" class="mt-3 text-3xl font-bold tracking-tight text-stone-900 sm:text-4xl" data-astro-cid-lcdefpme>Common questions</h2></div><div class="mx-auto mt-10 max-w-3xl divide-y divide-stone-200 border-y border-stone-200" data-astro-cid-lcdefpme><details class="group py-5" data-astro-cid-lcdefpme><summary class="flex cursor-pointer items-center justify-between gap-4 font-semibold text-stone-900 marker:content-['']" data-astro-cid-lcdefpme>What do I get back?<svg class="h-5 w-5 flex-none text-stone-400 transition group-open:rotate-45" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" aria-hidden="true" data-astro-cid-lcdefpme><path stroke-linecap="round" stroke-linejoin="round" d="M12 4.5v15m7.5-7.5h-15" data-astro-cid-lcdefpme></path></svg></summary><p class="mt-3 pr-9 leading-relaxed text-stone-600" data-astro-cid-lcdefpme>JSON. Results arrive parsed into fields such as title, link, and description, so you are reading a response rather than writing selectors against a page that changes. Page Fetch can also return markdown instead of HTML.</p></details><details class="group py-5" data-astro-cid-lcdefpme><summary class="flex cursor-pointer items-center justify-between gap-4 font-semibold text-stone-900 marker:content-['']" data-astro-cid-lcdefpme>Do I have to deal with proxies or CAPTCHAs?<svg class="h-5 w-5 flex-none text-stone-400 transition group-open:rotate-45" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" aria-hidden="true" data-astro-cid-lcdefpme><path stroke-linecap="round" stroke-linejoin="round" d="M12 4.5v15m7.5-7.5h-15" data-astro-cid-lcdefpme></path></svg></summary><p class="mt-3 pr-9 leading-relaxed text-stone-600" data-astro-cid-lcdefpme>No. Proxy rotation, retries, and CAPTCHA handling happen behind the endpoint. That is the part that breaks when you build search scraping yourself, and it is the part you are handing over.</p></details><details class="group py-5" data-astro-cid-lcdefpme><summary class="flex cursor-pointer items-center justify-between gap-4 font-semibold text-stone-900 marker:content-['']" data-astro-cid-lcdefpme>Can I use this from an MCP client?<svg class="h-5 w-5 flex-none text-stone-400 transition group-open:rotate-45" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" aria-hidden="true" data-astro-cid-lcdefpme><path stroke-linecap="round" stroke-linejoin="round" d="M12 4.5v15m7.5-7.5h-15" data-astro-cid-lcdefpme></path></svg></summary><p class="mt-3 pr-9 leading-relaxed text-stone-600" data-astro-cid-lcdefpme>Yes. We host one at https://api.serply.io/mcp: add it to Claude, Cursor, or any MCP-compatible client with your API key and the model can search and fetch pages as tool calls. Each tool call costs one credit, the same as a REST request. If you would rather run your own, the server on this page is about thirty lines.</p></details><details class="group py-5" data-astro-cid-lcdefpme><summary class="flex cursor-pointer items-center justify-between gap-4 font-semibold text-stone-900 marker:content-['']" data-astro-cid-lcdefpme>Why does markdown matter for an AI pipeline?<svg class="h-5 w-5 flex-none text-stone-400 transition group-open:rotate-45" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" aria-hidden="true" data-astro-cid-lcdefpme><path stroke-linecap="round" stroke-linejoin="round" d="M12 4.5v15m7.5-7.5h-15" data-astro-cid-lcdefpme></path></svg></summary><p class="mt-3 pr-9 leading-relaxed text-stone-600" data-astro-cid-lcdefpme>HTML spends most of its tokens on navigation, scripts, and styling that a model has to read and discard. Markdown keeps the headings, links, and prose and drops the rest, so more of the context window goes to the content you actually retrieved.</p></details><details class="group py-5" data-astro-cid-lcdefpme><summary class="flex cursor-pointer items-center justify-between gap-4 font-semibold text-stone-900 marker:content-['']" data-astro-cid-lcdefpme>Can I search as a specific country or device?<svg class="h-5 w-5 flex-none text-stone-400 transition group-open:rotate-45" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" aria-hidden="true" data-astro-cid-lcdefpme><path stroke-linecap="round" stroke-linejoin="round" d="M12 4.5v15m7.5-7.5h-15" data-astro-cid-lcdefpme></path></svg></summary><p class="mt-3 pr-9 leading-relaxed text-stone-600" data-astro-cid-lcdefpme>Yes. X-Proxy-Location takes any of fourteen countries including the US, UK, Germany, Japan, India, Brazil, and Australia, and X-User-Agent switches between desktop and mobile. Results differ between the two, so rank tracking needs both to be explicit.</p></details><details class="group py-5" data-astro-cid-lcdefpme><summary class="flex cursor-pointer items-center justify-between gap-4 font-semibold text-stone-900 marker:content-['']" data-astro-cid-lcdefpme>What replaced the Bing Search API?<svg class="h-5 w-5 flex-none text-stone-400 transition group-open:rotate-45" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" aria-hidden="true" data-astro-cid-lcdefpme><path stroke-linecap="round" stroke-linejoin="round" d="M12 4.5v15m7.5-7.5h-15" data-astro-cid-lcdefpme></path></svg></summary><p class="mt-3 pr-9 leading-relaxed text-stone-600" data-astro-cid-lcdefpme>Microsoft retired the Bing Search APIs on 11 August 2025 and directed developers to a wider Azure platform rather than a drop-in endpoint. Serply&#39;s /v1/b/search returns Bing organic results, text ads, and shopping ads as JSON over the same key and headers as every other endpoint here.</p></details><details class="group py-5" data-astro-cid-lcdefpme><summary class="flex cursor-pointer items-center justify-between gap-4 font-semibold text-stone-900 marker:content-['']" data-astro-cid-lcdefpme>Can this replace the Google Custom Search JSON API?<svg class="h-5 w-5 flex-none text-stone-400 transition group-open:rotate-45" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" aria-hidden="true" data-astro-cid-lcdefpme><path stroke-linecap="round" stroke-linejoin="round" d="M12 4.5v15m7.5-7.5h-15" data-astro-cid-lcdefpme></path></svg></summary><p class="mt-3 pr-9 leading-relaxed text-stone-600" data-astro-cid-lcdefpme>Yes. Google has closed the Custom Search JSON API to new customers and ends it on January 1, 2027. Serply returns Google results as JSON with no search engine ID, so most migrations are a new URL, a header for the key, and a few renamed fields.</p><a href="/google-custom-search-api-alternative" class="mt-2 inline-block font-medium text-brand-ink underline underline-offset-2" data-astro-cid-lcdefpme>See the migration guide →</a></details><details class="group py-5" data-astro-cid-lcdefpme><summary class="flex cursor-pointer items-center justify-between gap-4 font-semibold text-stone-900 marker:content-['']" data-astro-cid-lcdefpme>Is there a free tier?<svg class="h-5 w-5 flex-none text-stone-400 transition group-open:rotate-45" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" aria-hidden="true" data-astro-cid-lcdefpme><path stroke-linecap="round" stroke-linejoin="round" d="M12 4.5v15m7.5-7.5h-15" data-astro-cid-lcdefpme></path></svg></summary><p class="mt-3 pr-9 leading-relaxed text-stone-600" data-astro-cid-lcdefpme>Yes. Every new account gets 2,500 free credits with no card, good for 30 days. One credit is one successful request on any endpoint, MCP included, and cached responses are free. After that, prepaid packs start at $5 and those credits never expire.</p></details><details class="group py-5" data-astro-cid-lcdefpme><summary class="flex cursor-pointer items-center justify-between gap-4 font-semibold text-stone-900 marker:content-['']" data-astro-cid-lcdefpme>Which languages are supported?<svg class="h-5 w-5 flex-none text-stone-400 transition group-open:rotate-45" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" aria-hidden="true" data-astro-cid-lcdefpme><path stroke-linecap="round" stroke-linejoin="round" d="M12 4.5v15m7.5-7.5h-15" data-astro-cid-lcdefpme></path></svg></summary><p class="mt-3 pr-9 leading-relaxed text-stone-600" data-astro-cid-lcdefpme>Any language that can make an HTTP request. It is a REST API with a header for the key, so cURL, Python, JavaScript, Go, Ruby, and PHP all work with no SDK required.</p></details><details class="group py-5" data-astro-cid-lcdefpme><summary class="flex cursor-pointer items-center justify-between gap-4 font-semibold text-stone-900 marker:content-['']" data-astro-cid-lcdefpme>How is this different from running my own scraper?<svg class="h-5 w-5 flex-none text-stone-400 transition group-open:rotate-45" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" aria-hidden="true" data-astro-cid-lcdefpme><path stroke-linecap="round" stroke-linejoin="round" d="M12 4.5v15m7.5-7.5h-15" data-astro-cid-lcdefpme></path></svg></summary><p class="mt-3 pr-9 leading-relaxed text-stone-600" data-astro-cid-lcdefpme>A scraper is cheap to write and expensive to keep alive. Layouts change, IPs get blocked, and CAPTCHAs appear at the worst time. Here that maintenance is the product.</p></details></div></section><section class="my-16 sm:my-24" data-astro-cid-lcdefpme><div class="mx-auto max-w-3xl rounded-2xl bg-stone-900 px-6 py-12 text-center sm:px-10 sm:py-14" data-astro-cid-lcdefpme><h2 class="text-3xl font-bold tracking-tight text-white sm:text-4xl" data-astro-cid-lcdefpme>Start with 2,500 free credits</h2><p class="mx-auto mt-4 max-w-xl text-lg leading-relaxed text-stone-300" data-astro-cid-lcdefpme>Create a key and make your first call before deciding anything. No card, no sales call.</p><div class="mt-8 flex flex-col items-center justify-center gap-3 sm:flex-row" data-astro-cid-lcdefpme><a href="https://app.serply.io/users/sign_up?source=home" class="group inline-flex items-center justify-center rounded-lg text-sm font-semibold transition-colors focus:outline-none focus-visible:outline-2 focus-visible:outline-offset-2 bg-brand-surface text-white hover:bg-brand-surface-hover active:bg-brand-surface-hover active:text-white focus-visible:outline-brand px-6 py-3 sm:text-lg" data-astro-cid-lcdefpme="true"><span data-astro-cid-lcdefpme>Get your free API key</span></a><a href="/pricing" class="inline-flex items-center rounded-lg border border-stone-700 px-6 py-3 font-medium text-stone-200 transition hover:border-stone-500 hover:text-white sm:text-lg" data-astro-cid-lcdefpme>See pricing</a></div></div></section></div></main><astro-island uid="xdmDF" prefix="r15" component-url="/_astro/footer.BzPmL51q.js" component-export="default" renderer-url="/_astro/client.BsxOgvle.js" props="{}" ssr client="visible" opts="{&quot;name&quot;:&quot;Footer&quot;,&quot;value&quot;:true}" await-children><footer class="py-12 bg-stone-50" aria-labelledby="footer-heading"><h2 id="footer-heading" class="sr-only">Footer</h2><div class="mx-auto max-w-6xl px-4 sm:px-6 lg:px-8"><div class="xl:grid xl:grid-cols-3 xl:gap-8"><div class="space-y-8 xl:col-span-1"><svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 276.24 85.63" class="w-auto h-10"><path fill="#231f20" d="M75.23 50.89c.23 1.32.86 2.43 1.89 3.35s2.41 1.37 4.12 1.37 3.08-.44 4.08-1.33c1-.89 1.5-1.88 1.5-2.96 0-.92-.5-1.63-1.5-2.15s-2.25-.99-3.74-1.42c-1.49-.43-3.11-.87-4.85-1.33-1.75-.46-3.37-1.13-4.85-2.02-1.49-.89-2.74-2.03-3.74-3.44-1-1.4-1.5-3.25-1.5-5.54 0-1.6.33-3.13.99-4.6.66-1.46 1.62-2.73 2.88-3.82 1.26-1.09 2.75-1.96 4.47-2.62 1.72-.66 3.66-.99 5.84-.99 4.75 0 8.4 1.15 10.95 3.44 2.55 2.29 4.05 5.15 4.51 8.59h-9.45c-.23-.86-.85-1.72-1.85-2.58-1-.86-2.25-1.29-3.74-1.29s-2.65.37-3.48 1.12c-.83.75-1.25 1.66-1.25 2.75 0 .92.5 1.63 1.5 2.15s2.25.99 3.74 1.42c1.49.43 3.11.89 4.85 1.37 1.75.49 3.36 1.19 4.85 2.1 1.49.92 2.73 2.11 3.74 3.57 1 1.46 1.5 3.37 1.5 5.71 0 1.6-.34 3.13-1.03 4.6a11.4 11.4 0 0 1-2.92 3.82c-1.26 1.09-2.79 1.96-4.6 2.62-1.8.66-3.82.99-6.06.99-5.15 0-9.06-1.17-11.73-3.52-2.66-2.35-4.2-5.47-4.6-9.36h9.45ZM139.23 51.32c-.52 1.49-1.3 2.98-2.36 4.47a18.725 18.725 0 0 1-3.87 3.99c-1.52 1.17-3.24 2.13-5.15 2.88-1.92.74-3.99 1.12-6.23 1.12-2.69 0-5.23-.53-7.6-1.59-2.38-1.06-4.47-2.5-6.27-4.34-1.8-1.83-3.24-3.96-4.29-6.4-1.06-2.43-1.59-5.05-1.59-7.86s.53-5.43 1.59-7.86c1.06-2.43 2.49-4.57 4.29-6.4 1.8-1.83 3.89-3.28 6.27-4.34 2.38-1.06 4.91-1.59 7.6-1.59s5.01.49 7.3 1.46 4.29 2.35 6.01 4.12c1.72 1.78 3.08 3.91 4.08 6.4s1.5 5.23 1.5 8.2c0 .46-.03.9-.09 1.33-.06.43-.12.85-.17 1.25-.06.46-.12.89-.17 1.29h-27.49c.46 1.95 1.43 3.58 2.92 4.9 1.49 1.32 3.52 1.98 6.1 1.98 1.32 0 2.42-.14 3.31-.43.89-.29 1.65-.63 2.28-1.03.69-.46 1.26-.97 1.72-1.55h10.31Zm-17.6