<!DOCTYPE html><html class="h-full scroll-smooth bg-white antialiased [font-feature-settings:'ss01']" lang="en"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width, initial-scale=1.0"><meta name="generator" content="Astro v7.3.3"><!-- Primary Meta Tags --><title>Google Search API for AI Agents - Serply.io</title><meta name="title" content="Google Search API for AI Agents - Serply.io"><meta name="description" content="Real-time Google search, news, and maps as clean JSON or markdown. One REST API for agents, RAG, and MCP servers. Free tier, no credit card required."><meta name="robots" content="index, follow"><meta name="language" content="English"><meta name="author" content="Serply, Inc."><link rel="canonical" href="https://serply.io"><!-- Favicons --><link rel="icon" type="image/x-icon" href="/favicon/favicon.ico"><link rel="icon" type="image/png" sizes="16x16" href="/favicon/favicon-16x16.png"><link rel="icon" type="image/png" sizes="32x32" href="/favicon/favicon-32x32.png"><link rel="apple-touch-icon" sizes="180x180" href="/favicon/apple-touch-icon.png"><link rel="manifest" href="/favicon/site.webmanifest"><meta name="theme-color" content="#f03e2f"><!-- Open Graph / Facebook --><meta property="og:type" content="website"><meta property="og:url" content="https://serply.io"><meta property="og:title" content="Google Search API for AI Agents - Serply.io"><meta property="og:description" content="Real-time Google search, news, and maps as clean JSON or markdown. One REST API for agents, RAG, and MCP servers. Free tier, no credit card required."><meta property="og:image" content="https://serply.io/google-search-api-serp.png"><meta property="og:image:width" content="1200"><meta property="og:image:height" content="630"><meta property="og:image:alt" content="Google Search API for AI Agents - Serply.io"><meta property="og:site_name" content="Serply.io"><meta property="og:locale" content="en_US"><!-- Twitter --><meta name="twitter:card" content="summary_large_image"><meta name="twitter:url" content="https://serply.io"><meta name="twitter:title" content="Google Search API for AI Agents - Serply.io"><meta name="twitter:description" content="Real-time Google search, news, and maps as clean JSON or markdown. One REST API for agents, RAG, and MCP servers. Free tier, no credit card required."><meta name="twitter:image" content="https://serply.io/google-search-api-serp.png"><meta name="twitter:image:alt" content="Google Search API for AI Agents - Serply.io"><meta name="twitter:site" content="@serply_io"><meta name="twitter:creator" content="@serply_io"><!-- Additional SEO --><meta name="format-detection" content="telephone=no"><!-- Polyfill process for @stoplight/elements --><script>if (typeof process === 'undefined') { window.process = { env: {} }; }</script><link rel="preload" href="/fonts/inter-latin-var.woff2" as="font" type="font/woff2" crossorigin="anonymous"><script>
        window.dataLayer = window.dataLayer || [];
        window.dataLayer.push({'gtm.start': new Date().getTime(), event: 'gtm.js'});
        (function(w,d,s,i){
          function load(){
