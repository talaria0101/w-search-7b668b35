r-1 md:hidden"><div class="md:hidden"><div data-headlessui-state=""><button class="relative z-10 flex h-8 w-8 items-center justify-center [&amp;:not(:focus-visible)]:focus:outline-none cursor-pointer" aria-label="Toggle Navigation" type="button" aria-expanded="false" data-headlessui-state=""><svg aria-hidden="true" class="h-3.5 w-3.5 overflow-visible stroke-stone-700" fill="none" stroke-width="2" stroke-linecap="round"><path d="M0 1H14M0 7H14M0 13H14" class="origin-center transition"></path><path d="M2 2L12 12M12 2L2 12" class="origin-center transition scale-90 opacity-0"></path></svg></button></div><div hidden="" style="position:fixed;top:1px;left:1px;width:1px;height:0;padding:0;margin:-1px;overflow:hidden;clip:rect(0, 0, 0, 0);white-space:nowrap;border-width:0;display:none"></div></div></div></div></nav></div></header><!--astro:end--></astro-island><main class="mb-auto"><div class="mx-auto max-w-6xl px-4 sm:px-6 lg:px-8" data-astro-cid-lcdefpme="true"><div class="relative pt-14 pb-8 sm:pt-20 sm:pb-12" data-astro-cid-lcdefpme><div class="mx-auto max-w-3xl text-center" data-astro-cid-lcdefpme><div class="mb-6 inline-flex items-center rounded-full border border-brand-line bg-brand-tint px-4 py-1.5 text-sm font-medium text-brand-ink" data-astro-cid-lcdefpme><span class="mr-2 inline-block h-1.5 w-1.5 rounded-full bg-brand" data-astro-cid-lcdefpme></span>Search infrastructure for AI applications</div><h1 class="text-4xl font-bold leading-[1.1] tracking-tight text-stone-900 sm:text-6xl" data-astro-cid-lcdefpme>Google search results, <br class="hidden sm:block" data-astro-cid-lcdefpme>as clean <span class="rotator text-brand" aria-hidden="true" data-astro-cid-lcdefpme><span class="rotator-sizer" data-astro-cid-lcdefpme>markdown</span><span class="rotator-word" data-astro-cid-lcdefpme>JSON</span><span class="rotator-word" data-astro-cid-lcdefpme>markdown</span><span class="rotator-word" data-astro-cid-lcdefpme>MCP</span></span><span class="sr-only" data-astro-cid-lcdefpme>JSON, markdown, or MCP</span></h1><p class="mx-auto mt-6 max-w-2xl text-lg leading-relaxed text-stone-600 sm:text-xl" data-astro-cid-lcdefpme>One REST API for Google search, news, maps, scholar, and more. Take results as structured JSON, or take any page as markdown an agent can read. Proxies, retries, and CAPTCHAs are handled on our side.</p><div class="mt-9 flex flex-col items-center justify-center gap-3 sm:flex-row" data-astro-cid-lcdefpme><a href="https://app.serply.io/users/sign_up?source=home" class="group inline-flex items-center justify-center rounded-lg text-sm font-semibold transition-colors focus:outline-none focus-visible:outline-2 focus-visible:outline-offset-2 bg-brand-surface text-white hover:bg-brand-surface-hover active:bg-brand-surface-hover active:text-white focus-visible:outline-brand px-6 py-3 sm:text-lg" data-astro-cid-lcdefpme="true"><span data-astro-cid-lcdefpme>Get your free API key</span></a><a href="/docs" class="inline-flex items-center rounded-lg border border-stone-300 bg-white px-6 py-3 font-medium text-stone-700 transition hover:border-stone-400 hover:text-stone-900 sm:text-lg" data-astro-cid-lcdefpme>Read the docs</a></div><p class="mt-5 font-mono text-sm text-stone-500" data-astro-cid-lcdefpme>2,500 free credits, no card &middot; ~900 ms average &middot; 14 countries</p><p class="mt-3 text-sm" data-astro-cid-lcdefpme><a href="#try" class="font-medium text-brand-ink underline underline-offset-2" data-astro-cid-lcdefpme>Or try a live search first, no signup</a></p></div></div><section id="try" class="my-16 scroll-mt-24 sm:my-24" aria-labelledby="try-heading" data-astro-cid-lcdefpme><div class="mx-auto mb-8 max-w-3xl text-center" data-astro-cid-lcdefpme><p class="font-mono text-xs uppercase tracking-widest text-brand-ink" data-astro-cid-lcdefpme>Try it</p><h2 id="try-heading" class="mt-3 text-3xl font-bold tracking-tight text-stone-900 sm:text-4xl" data-astro-cid-lcdefpme>See exactly what the API returns</h2><p class="mt-4 text-lg tex