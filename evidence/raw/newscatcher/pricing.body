<!-- Apply body.banner-open BEFORE first paint. The footer script only adds
     it on DOMContentLoaded (~4s on slow loads), so the global banner-open
     padding rules kicked in late and pushed every page's hero down ~78px
     after render (visible jump / CLS). This observer adds the class the
     instant <body> + .banner exist during parsing, so layout is correct
     from the first frame; the footer script still handles open/close. -->
<script>
(function () {
  new MutationObserver(function (m, o) {
    var body = document.body;
    if (!body) return;
    var banner = document.querySelector('.banner');
    if (banner) {
      if (!banner.classList.contains('is-closed')) {
        body.classList.add('banner-open');
      }
      o.disconnect();
    } else if (document.readyState !== 'loading') {
      o.disconnect();
    }
  }).observe(document.documentElement, { childList: true, subtree: true });
})();
</script>
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/intl-tel-input@25.3.2/build/css/intlTelInput.css">

<style>
/* ================================================================
   Pricing table: section headings  (added 2026-08-04)
   ================================================================
   "Events search" / "Events monitoring" come from a CMS field (Group
   label) filled only on the first row of each group. The element is a
   direct child of the row, so `grid-column: 1 / -1` lets it span the
   whole table width and read as a section heading rather than a second
   line stuck to the row name. The 16px side padding matches
   .pricing-table__cell so the heading lines up with the row labels.
   ================================================================ */

.pricing-table__group {
  grid-column: 1 / -1;
  padding: 30px 16px 14px;
  font-weight: 500;
  color: #0A0C14;
}

.pricing-table__group:empty { display: none; }

.pricing-table__body.is--desktop .pricing-table__row:has(.pricing-table__group:not(:empty)) {
  border-top: 1px solid #c9cbd6;
}

.pricing-table__body.is--desktop .pricing-table__row:has(.pricing-table__group:not(:empty)):first-child {
  border-top: none;
}


/* ================================================================
   Search mode tooltip  (added 2026-08-04)
   ================================================================
   Mirrors the "Search Mode Comparison" popover in the CatchAll billing
   UI. The content is product-level (what Lite and Base are), identical
   for every plan, so one shared tooltip is wired to every "Lite & Base"
   cell. Enterprise reads "Deep search" and gets no trigger, matching the
   platform. Values come from the platform UI, 2026-08-04.
   ================================================================ */

.smt-trigger {
  font: inherit;
  color: inherit;
  background: none;
  border: 0;
  padding: 0;
  cursor: help;
  text-decoration: underline;
  text-decoration-style: dotted;
  text-decoration-color: #b9bdcc;
  text-underline-offset: 3px;
}

.smt-trigger:hover,
.smt-trigger:focus-visible { text-decoration-color: #0A0C14; }

.smt {
  position: absolute;
  z-index: 60;
  width: 300px;
  padding: 14px 16px 13px;
  background-color: #ffffff;
  border: 1px solid #e2e3e9;
  border-radius: 4px;
  box-shadow: 0 12px 32px rgba(12, 18, 45, .12);
  font-family: Ppneuemontreal, Arial, sans-serif;
  text-align: left;
}

.smt[hidden] { display: none; }

.smt-title { font-size: 13px; font-weight: 500; color: #0A0C14; }
.smt-sub { font-size: 11px; color: #6F7790; margin-bottom: 11px; }

.smt-grid {
  display: grid;
  grid-template-columns: 1fr auto auto;
  column-gap: 14px;
  row-gap: 7px;
  align-items: baseline;
}

.smt-h {
  font-family: Ppneuemontrealmono, Arial, sans-serif;
  font-size: 10px;
  letter-spacing: .06em;
  text-transform: uppercase;
  color: #6F7790;
}

.smt-h + .smt-h, .smt-v { text-align: right; }
.smt-k { font-size: 12px; color: #6F7790; }
.smt-v { font-size: 12px; color: #0A0C14; }
.smt-off { color: #9aa0b4; }
.smt-on { color: #1a7f4b; }


/* ================================================================
   MOBILE: one card per plan  (added 2026-08-04)
   ================================================================
   Desktop shows four plan columns side by side above a shared feature
   table. On mobile the SAME content is re-stacked so each plan's header
   sits directly on top of its own feature list: one plan, one card, one
   screen.

   Why display:contents rather than moving elements: the four plan headers
   are four renders of ONE collection-list template, and the four feature
   lists live in four separate tab panes elsewhere in the DOM. Neither can
   be physically interleaved. Setting every wrapper between them and
   .pricing-table to display:contents lifts all eight into the same flex
   container, and `order` then interleaves them. Nothing is duplicated and
   every value stays CMS-bound.
   ================================================================ */
@media screen and (max-width: 767px) {

  .pricing-table { display: flex; flex-direction: column; gap: 0; }

  .pricing-table > .pricing-table__row,
  .pricing-table > .pricing-table__row > div,
  .pricing-table > .pricing-table__row .pricing-table__sub-row {
    display: contents;
  }

  .pricing-table__body.is--mobile,
  .pricing-table__body.is--mobile .faq-tabs,
  .pricing-table__body.is--mobile .faq-tabs__content {
    display: contents !important;
  }

  .pricing-table__body.is--mobile .faq-tabs__content-pane {
    display: block !important;
    opacity: 1 !important;
  }

  .pricing-table__cell.is--header:nth-child(1) { order: 1; }
  .pricing-table__body.is--mobile .faq-tabs__content-pane:nth-child(1) { order: 2; }
  .pricing-table__cell.is--header:nth-child(2) { order: 3; }
  .pricing-table__body.is--mobile .faq-tabs__content-pane:nth-child(2) { order: 4; }
  .pricing-table__cell.is--header:nth-child(3) { order: 5; }
  .pricing-table__body.is--mobile .faq-tabs__content-pane:nth-child(3) { order: 6; }
  .pricing-table__cell.is--header:nth-child(4) { order: 7; }
  .pricing-table__body.is--mobile .faq-tabs__content-pane:nth-child(4) { order: 8; }

  .pricing-table__cell.is--header {
    border: 1px solid #eeeef2;
    border-bottom: 0;
    border-radius: 4px 4px 0 0;
    padding: 20px 20px 16px;
    grid-row-gap: 12px;
    row-gap: 12px;
  }

  .pricing-table__body.is--mobile .faq-tabs__content-pane {
    border: 1px solid #eeeef2;
    border-top: 0;
    border-radius: 0 0 4px 4px;
    padding: 0 20px 10px;
    margin-bottom: 16px;
  }

  .pricing-table__cell.is--header .pricing-table__header-top {
    flex-direction: row;
    align-items: flex-start;
    justify-content: space-between;
    column-gap: 16px;
    grid-row-gap: 0px;
    row-gap: 0px;
    width: 100%;
  }

  .pricing-table__cell.is--header .pricing-table__top-content {
    align-items: flex-end;
    text-align: right;
    grid-row-gap: 2px;
    row-gap: 2px;
    flex-shrink: 0;
  }

  .pricing-table__cell.is--header .pricing-table__top-price { justify-content: flex-end; }

  .pricing-table__body.is--mobile .pricing-table__group {
    padding: 26px 16px 10px;
    border-top: 1px solid #c9cbd6;
  }

  .pricing-table__body.is--mobile .pricing-table__row:first-child .pricing-table__group {
    padding-top: 14px;
    border-top: 0;
  }

  .pricing-table__body.is--mobile .pricing-table__row:has(.pricing-table__group:not(:empty)) {
    border-top: 0;
  }

  /* The product tab follows you down the page. The site navbar is
     position:fixed and 69px tall, or 153px while the promo banner is open
     (body.banner-open), so the tab pins below it rather than at 0. */
  .faq-tabs__menu.is--pricing {
    position: sticky;
    top: 69px;
    z-index: 20;
    background-color: #ffffff;
    border-bottom: 1px solid #eeeef2;
  }

  body.banner-open .faq-tabs__menu.is--pricing { top: 153px; }

  .smt { width: min(300px, calc(100vw - 32px)); }
}


/* ---- News API card (added 2026-08-04) ----
   Replaces the contact form on the News API tab. The mono font cannot be set
   via the Webflow style API (the font installer rejects it), so it lives here. */
.napi-note { font-family: Ppneuemontrealmono, Arial, sans-serif; }

@media screen and (max-width: 767px) {
  .napi { padding: 48px 20px; }
  .napi-title { font-size: 28px; margin-bottom: 22px; }
  .napi-pills { margin-bottom: 36px; }
  .napi-actions a { width: 100%; text-align: center; }
}
</style>

<script>
/* Search mode tooltip — wires every "Lite & Base" cell in the pricing table
   to one shared popover. Runs on both the desktop table and the four mobile
   per-plan cards. Hover and keyboard focus on pointer devices, tap on touch. */
document.addEventListener('DOMContentLoaded', function () {
  var LABEL = 'Lite & Base';
  var cells = document.querySelectorAll('.pricing-table .pricing-table__cell .p-l');
  var targets = [];
  Array.prototype.forEach.call(cells, function (el) {
    if (el.textContent.trim() === LABEL && !el.querySelector('.smt-trigger')) targets.push(el);
  });
  if (!targets.length) return;

  var tip = document.createElement('div');
  tip.className = 'smt';
  tip.id = 'search-mode-tip';
  tip.setAttribute('role', 'tooltip');
  tip.hidden = true;
  tip.innerHTML =
    '<div class="smt-title">Search mode comparison</div>' +
    '<div class="smt-sub">Lite vs. Base — features and costs.</div>' +
    '<div class="smt-grid">' +
      '<div class="smt-h">Feature</div><div class="smt-h">Lite</div><div class="smt-h">Base</div>' +
      '<div class="smt-k">Speed</div><div class="smt-v">~1 min</div><div class="smt-v">~15 mins</div>' +
      '<div class="smt-k">Enrichments</div><div class="smt-v smt-off">Unavailable</div><div class="smt-v smt-on">Available</div>' +
      '<div class="smt-k">Monitors</div><div class="smt-v smt-off">Unavailable</div><div class="smt-v smt-on">Available</div>' +
      '<div class="smt-k">Credits</div><div class="smt-v">100 / run</div><div class="smt-v">10 / valid record</div>' +
    '</div>';
  document.body.appendChild(tip);

  var open = null;

  function place(btn) {
    tip.hidden = false;
    var r = btn.getBoundingClientRect();
    var t = tip.getBoundingClientRect();
    var left = r.left + r.width / 2 - t.width / 2 + window.pageXOffset;
    left = Math.max(12, Math.min(left, window.pageXOffset + document.documentElement.clientWidth - t.width - 12));
    var top = r.top + window.pageYOffset - t.height - 10;
    if (r.top - t.height - 10 < 0) top = r.bottom + window.pageYOffset + 10;
    tip.style.left = Math.round(left) + 'px';
    tip.style.top = Math.round(top) + 'px';
  }

  function show(btn) { open = btn; btn.setAttribute('aria-expanded', 'true'); place(btn); }
  function hide() { if (open) open.setAttribute('aria-expanded', 'false'); open = null; tip.hidden = true; }

  targets.forEach(function (el) {
    var btn = document.createElement('button');
    btn.type = 'button';
    btn.className = 'smt-trigger';
    btn.textContent = el.textContent.trim();
    btn.setAttribute('aria-describedby', 'search-mode-tip');
    btn.setAttribute('aria-expanded', 'false');
    el.textContent = '';
    el.appendChild(btn);

    btn.addEventListener('mouseenter', function () { show(btn); });
    btn.addEventListener('mouseleave', function () { if (open === btn) hide(); });
    btn.addEventListener('focus', function () { show(btn); });
    btn.addEventListener('blur', function () { if (open === btn) hide(); });
    btn.addEventListener('click', function (e) {
      e.preventDefault();
      e.stopPropagation();
      if (open === btn) { hide(); } else { show(btn); }
    });
  });

  document.addEventListener('click', hide);
  document.addEventListener('keydown', function (e) { if (e.key === 'Escape') hide(); });
  window.addEventListener('scroll', function () { if (open) place(open); }, { passive: true });
  window.addEventListener('resize', hide);
});
</script><script src="https://cdn.prod.website-files.com/68836ccb0e22570e2e820207%2F689e5ba67671442434f3ca35%2F6a34d9cf642434b67c34296e%2Fcatchallherofix-1.0.0-1781855946631.js" type="text/javascript"></script><script src="https://cdn.prod.website-files.com/68836ccb0e22570e2e820207%2F689e5ba67671442434f3ca35%2F6a390f4fcbee5c9f8b832595%2Fcatchallcritical-1.0.0-1782134075730.js" type="text/javascript"></script></head><body><div class="page-wrapper"><div class="style-guide-utilities"><div class="style-guide__global-styles w-embed"><style>
  body {
    font-smoothing: antialiased;
    -webkit-font-smoothing: antialiased;
    -moz-osx-font-smoothing: grayscale;
  }

	.hidden{
  	display: none;
  }

  .w-nav-overlay{
    display: none !important;
    pointer-events: none !important;
  }

  /* Snippet gets rid of top margin on first element in any rich text*/
  .w-richtext>:first-child {
    margin-top: 0;
  }

  /* Snippet gets rid of bottom margin on last element in any rich text*/
  .w-richtext>:last-child, .w-richtext ol li:last-child, .w-richtext ul li:last-child {
    margin-bottom: 0;
  }

  /* Snippet makes all link elements listed below to inherit color from their parent */
  .w-nav-link,
  .w-dropdown-btn,
  .w-dropdown-toggle,
  .w-dropdown-link
  {
  color: inherit;
  }
  
  /*Reset selects, buttons, and links styles*/
  .w-input, .w-select, a {
    color: inherit;
    text-decoration: inherit;
    font-size: inherit;
  }

  input {
    border-radius: 0;
    -webkit-appearance: none;
  }
  
  /* Reset Chrome autofill background and text color */
  input:-webkit-autofill,
  input:-webkit-autofill:hover,
  input:-webkit-autofill:focus,
  textarea:-webkit-autofill,
  textarea:-webkit-autofill:hover,
  textarea:-webkit-autofill:focus,
  select:-webkit-autofill,
  select:-webkit-autofill:hover,
  select:-webkit-autofill:focus {
    -webkit-box-shadow: 0 0 0px 1000px #fff inset !important; /* background */
    -webkit-text-fill-color: #000 !important; /* text color */
    transition: background-color 5000s ease-in-out 0s; /* prevents yellow flash */
  }
  
  .video-cover{
  	object-fit: cover;
 	}


  .section.bg-gradient{
  	background: linear-gradient(180deg, rgba(246, 248, 251, 0.00) -11.86%, #F6F8FB 79.9%);
  }

/* Navbar */
	.nav-overlay{
  	background: linear-gradient(180deg, #FFF 33.87%, rgba(255, 255, 255, 0.81) 54.3%, rgba(255, 255, 255, 0.52) 68.82%, rgba(255, 255, 255, 0.00) 100%);
		backdrop-filter: blur(0px);
  }
  
  .navbar.is--scrolled .nav-overlay, .navbar.nav-scrolled .nav-overlay, .navbar.is--open .nav-overlay{
  	opacity: 1;
  }
  
  .navbar.nav-scrolled .banner-space{
  	height: 0rem;
  }

  .navbar-menu__button-line {
    transform: translateY(0) rotateZ(0);
  }

  .navbar.is--open .navbar-menu__button-line.is--top {
    animation: top-line-open 0.3s forwards;
  }

  .navbar:not(.is--open) .navbar-menu__button-line.is--top {
    animation: top-line-close 0.3s forwards;
  }

  .navbar.is--open .navbar-menu__button-line.is--bottom {
    animation: bottom-line-open 0.3s forwards;
  }

  .navbar:not(.is--open) .navbar-menu__button-line.is--bottom {
    animation: bottom-line-close 0.3s forwards;
  }
  
  .navbar:not(.is--banner-closed) .navbar-dropdown{
  	inset: 6.17rem 1rem auto auto;
    max-height: calc(100vh - 7.67rem);
  }
  
  .banner.is-closed {
    display: none;
  }

  /*.nav-scrolled .banner {
    display: none;
  }

   .navbar.is--scrolled .banner {
    display: none;
  }

  .navbar:has(.navbar-dropdown.is-active) .banner {
   display: none; 
  }*/

  @keyframes top-line-open {
    0% {
      transform: translateY(0) rotateZ(0);
      width: 1.1875rem;
    }
    50% {
      transform: translateY(3px) rotateZ(0);
      width: 1.5rem;
    }
    100% {
      transform: translateY(3px) rotateZ(45deg);
      width: 1.5rem;
    }
  }

  @keyframes top-line-close {
    0% {
      transform: translateY(3px) rotateZ(45deg);
      width: 1.5rem;
    }
    50% {
      transform: translateY(3px) rotateZ(0deg);
      width: 1.5rem;
    }
    100% {
      transform: translateY(0) rotateZ(0deg);
      width: 1.1875rem;
    }
  }

  @keyframes bottom-line-open {
    0% {
      transform: translateY(0) rotateZ(0);
    }
    50% {
      transform: translateY(-3px) rotateZ(0);
    }
    100% {
      transform: translateY(-3px) rotateZ(-45deg);
    }
  }

  @keyframes bottom-line-close {
    0% {
      transform: translateY(-3px) rotateZ(-45deg);
    }
    50% {
      transform: translateY(-3px) rotateZ(0deg);
    }
    100% {
      transform: translateY(0) rotateZ(0deg);
    }
  }
  
  @media screen and (min-width: 991px){
  	.navbar.is--scrolled .nav-menu{
  		opacity: 0;
      pointer-events: none;
  	}
  }

  @media screen and (max-width: 991px){
    .navbar-link__icon {
      display: inline-block;
      transition: transform 0.3s ease;
      transform: rotate(0deg);
    }

    .nav-menu__list-item.is-expanded .navbar-link__icon {
      transform: rotate(180deg);
    }
  }

  /* Splide Slider */
  .splide__arrow{
    background: transparent !important;
    border: 0 !important;
    border-radius: 0% !important;
    height: auto !important;
    opacity: 1 !important;
    position: static !important;
    transform: translateY(0%) !important;
    width: auto !important;
    z-index: 0 !important;
  }

  .industries-slider .splide__track{
    overflow: visible !important;
  }
	/*
  .industry-slide__content{
    background: linear-gradient(180deg, rgba(246, 248, 251, 0.00) -16.78%, #F6F8FB 114.4%);
  }
  */

  /* Grid */
  .home-benefits__grid-item:last-child {
    border-right: 1px solid #e7e7f1;
  }

  @media (min-width: 480px) and (max-width: 991px){
    .home-benefits__grid-item:nth-child(4){
      border-right: 1px solid #e7e7f1;
    }
  }

  /* Tab FAQ */
  .faq-tabs::before,
  .faq-tabs::after{
    display: none;
  }

/*
