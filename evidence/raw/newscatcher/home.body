<!-- Apply body.banner-open BEFORE first paint. The footer script only adds
     it on DOMContentLoaded (~4s on slow loads), so the global banner-open
     padding rules kicked in late and pushed every page's hero down ~78px
     after render (visible jump / CLS). This observer adds the class the
     instant <body> + .banner exist during parsing, so layout is correct
     from the first frame; the footer script still handles open/close. -->
<script>
(function () {
  new MutationObserver(function (m, o) {
    var body = document.body;
    if (!body) return;
    var banner = document.querySelector('.banner');
    if (banner) {
      if (!banner.classList.contains('is-closed')) {
        body.classList.add('banner-open');
      }
      o.disconnect();
    } else if (document.readyState !== 'loading') {
      o.disconnect();
    }
  }).observe(document.documentElement, { childList: true, subtree: true });
})();
</script>
