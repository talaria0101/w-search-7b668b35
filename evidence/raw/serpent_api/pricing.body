  <script src="/js/banner-rotator.aca9b99a86b9ead6dc11f92694cb59c0dc7b0bc6641aea97b435fe9a745d4dff.js" defer></script>
  <script>
    // Sub-tab switching (per platform). The SERP and AI tabs have no sub-tabs: pricing is
    // identical across every engine and every model, so the pills had nothing to switch.
    function switchSubTab(cat, key, btn) {
      var group = btn.parentElement;
      group.querySelectorAll('.sub-tab').forEach(function(b) { b.classList.remove('active'); });
      btn.classList.add('active');

      if (cat === 'social') {
        document.querySelectorAll('tr[data-platform]').forEach(function(tr) {
          tr.classList.toggle('hidden', !(key === 'all' || tr.dataset.platform === key));
        });
      }
    }

    // Tab switching
    function switchTab(tabId) {
      // Deactivate all tabs and content
      document.querySelectorAll('.category-tab').forEach(function(tab) {
        tab.classList.remove('active');
        tab.setAttribute('aria-selected', 'false');
      });
      document.querySelectorAll('.tab-content').forEach(function(content) {
        content.classList.remove('active');
      });

      // Activate selected tab and content
      var btn = document.getElementById('tab-btn-' + tabId);
      var content = document.getElementById('tab-' + tabId);
      if (btn) {
        btn.classList.add('active');
        btn.setAttribute('aria-selected', 'true');
      }
      if (content) {
        content.classList.add('active');
      }
    }

    // FAQ toggle
    function toggleFaq(button) {
      var item = button.closest('.faq-item');
      var isOpen = item.classList.contains('open');

      // Close all FAQs
      document.querySelectorAll('.faq-item').forEach(function(faq) {
        faq.classList.remove('open');
        faq.querySelector('.faq-question').setAttribute('aria-expanded', 'false');
      });

      // Open clicked one (if it was closed)
      if (!isOpen) {
        item.classList.add('open');
        button.setAttribute('aria-expanded', 'true');
      }
    }
  </script>
