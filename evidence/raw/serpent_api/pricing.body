  <!-- Structured Data - SoftwareApplication with AggregateOffer
       lowPrice and highPrice span the category rate cards below in dollars per 1,000
       category-specific billable units: $0.01 for News/YouTube at Scale or Enterprise,
       up to $75.00 for the Maps Deep premium band at Default. One request can use more
       than one unit: Deep Web bills per requested page, and some other categories use
       parameter-dependent bands or multipliers. The description must name that distinction.
       offerCount counts the 33 priced product rows, not the number of tiers. Recheck these
       bounds and the count whenever a category or billing unit changes. -->
  <script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "SoftwareApplication",
    "name": "Serpent API",
    "image": "https://apiserpent.com/og-image.png",
    "description": "SERP API with category-based pricing across all engines (Google, Bing, Yahoo, DuckDuckGo, Brave). Web search from $0.03/1K units on Enterprise after one $1,000 deposit.",
    "url": "https://apiserpent.com/pricing",
    "applicationCategory": "DeveloperApplication",
    "operatingSystem": "Any",
    "offers": {
      "@type": "AggregateOffer",
      "lowPrice": "0.01",
      "highPrice": "75.00",
      "priceCurrency": "USD",
      "offerCount": "33",
      "description": "Prices are US dollars per 1,000 category-specific billable units. Quick Web normally uses one unit per request; Deep Web uses one unit per requested page. Other categories can have parameter-dependent bands or multipliers. News and YouTube are $0.01 per 1,000 units at Scale or Enterprise; Google Maps Deep premium band is $75.00 per 1,000 premium-band units at Default."
    },
    "provider": {
      "@type": "Organization",
      "@id": "https://apiserpent.com/#organization",
      "name": "Serpent API",
      "url": "https://apiserpent.com"
    }
  }
  </script>

  <!-- Structured Data - BreadcrumbList -->
  <script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [
      {
        "@type": "ListItem",
        "position": 1,
        "name": "Home",
        "item": "https://apiserpent.com/"
      },
      {
        "@type": "ListItem",
        "position": 2,
        "name": "Pricing",
        "item": "https://apiserpent.com/pricing"
      }
    ],
    "provider": {
      "@type": "Organization",
      "@id": "https://apiserpent.com/#organization",
      "name": "Serpent API",
      "url": "https://apiserpent.com"
    }
  }
  </script>

  <!-- Structured Data - FAQPage -->
  <script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    "mainEntity": [
      {
        "@type": "Question",
        "name": "How does billing work?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "Serpent API uses a pay-as-you-go credit system. Deposit funds into your account and credits are deducted per API call based on the engine and endpoint used. No subscriptions or recurring charges. Your deposited credits never expire (promotional bonus credits expire 30 days after they're granted — see below)."
        }
      },
      {
        "@type": "Question",
        "name": "What's the minimum deposit?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "For new users, the minimum to get started is $10. Once your lifetime deposits reach $50, the minimum for any further top-up is $100 — so established accounts add credits in larger blocks. New Web credit uses $0.30/1K on Growth after one $100 deposit, $0.10/1K on Scale after one $500 deposit, or $0.03/1K on Enterprise after one $1,000 deposit, so the larger minimum lines up with the tier thresholds. Refunded or charged-back amounts don't count toward your tier."
        }
      },
      {
        "@type": "Question",
        "name": "How do pricing tiers work?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "A single qualifying $100 deposit earns Growth pricing for new credit, $500 earns Scale, and $1,000 earns Enterprise. Existing credit keeps its old price schedule. Refunded or charged-back amounts do not count toward qualification. Concurrency, minute/hour limits and queue priority follow live spendable balance, independently of the price schedule. Daily allowance is at least 10,000 requests/day for every account, including free accounts, or 100,000/day after verified total net deposits of $500; higher balance bands keep their higher daily limits. Goodwill and bonus credit do not count; refunds and chargebacks reduce qualifying deposits. Reviewed custom daily allocations take precedence. Bonus credit adds spendable balance but does not count as a qualifying deposit."
        }
      },
      {
        "@type": "Question",
        "name": "What payment methods do you accept?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "We accept all major credit and debit cards (Visa, Mastercard, American Express) through our secure payment partner Dodo Payments. All transactions are SSL encrypted and processed securely."
        }
      },
      {
        "@type": "Question",
        "name": "Do credits expire?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "Your deposited credits never expire — once added, they stay in your account until used, with no monthly fees or maintenance charges. Promotional bonus credits (for example the extra credits from a coupon match or bonus offer) expire 30 days after they're granted. Only that bonus portion expires — your deposited balance always remains. When you make API calls, spending draws from your bonus credits first, so they're used before they lapse. Your billing dashboard shows your deposit and bonus balances separately, along with the bonus expiry date."
        }
      },
      {
        "@type": "Question",
        "name": "What happens if a search fails?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "Every response we could not complete is refunded automatically to your account. One exception: a 404 for a resource that genuinely does not exist is an answer, and that call is charged."
        }
      },
      {
        "@type": "Question",
        "name": "Can I get a refund?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "Because credits are delivered instantly, purchases are generally non-refundable. We make exceptions for technical failures, duplicate charges, unauthorized transactions, or service discontinuation. Separately, requests we could not complete are refunded automatically; a 404 for a resource that does not exist is an answer and is charged. Submit refund requests within 7 days of purchase via info@apiserpent.com. See the full Refund Policy."
        }
      },
      {
        "@type": "Question",
        "name": "What does Enterprise include?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "Enterprise is the published $1,000 single-deposit tier: $0.03 per 1,000 Web units on new credit, with Scale rates on non-Web categories. Standard Enterprise concurrency and minute/hour limits apply when spendable balance reaches $1,000. Daily allowance is at least 10,000 requests/day for every account, including free accounts, or 100,000/day after verified total net deposits of $500; higher balance bands keep their higher daily limits. Goodwill and bonus credit do not count; refunds and chargebacks reduce qualifying deposits. Reviewed custom daily allocations take precedence. Negotiated pricing and custom limits are available separately; contact us at info@apiserpent.com."
        }
      }
    ]
  }
  </script>

  <style>
    * { margin: 0; padding: 0; box-sizing: border-box; }

    body {
      font-family: 'Inter', -apple-system, BlinkMacSystemFont, sans-serif;
      background: var(--bg-primary);
      color: var(--text-primary);
      line-height: 1.6;
    }

    a { color: var(--text-primary); text-decoration: none; }
    .accent { color: var(--accent); }

    /* Navigation */
    .navbar {
      padding: 1.5rem 2rem;
      position: fixed;
      top: 0;
      left: 0;
      right: 0;
      z-index: 9999;
      background: var(--navbar-bg);
      -webkit-backdrop-filter: blur(10px);
      backdrop-filter: blur(10px);
      border-bottom: 1px solid var(--border);
    }

    .nav-container {
      max-width: 1200px;
      margin: 0 auto;
      display: flex;
      justify-content: space-between;
      align-items: center;
    }

    .nav-brand {
      font-size: 1.5rem;
      font-weight: 700;
      color: var(--accent);
      display: flex;
      align-items: center;
      gap: 0.6rem;
    }

    .nav-brand .brand-api {
      color: var(--accent);
      margin-left: 0.15rem;
    }

    .infinity-serpent {
      display: inline-flex;
      align-items: center;
      flex-shrink: 0;
    }

    .infinity-serpent svg {
      width: 48px;
      height: 20px;
    }

    .nav-links {
      display: flex;
      gap: 2.5rem;
      list-style: none;
    }

    .nav-links a {
      color: var(--text-secondary);
      font-weight: 500;
      transition: color 0.2s, border-color 0.2s;
      padding: 0.4rem 0;
      border-bottom: 2px solid transparent;
    }

    .nav-links a:hover, .nav-links a.active {
      color: var(--accent);
      border-bottom-color: var(--accent);
    }

    .nav-buttons {
      display: flex;
      gap: 1rem;
    }

    /* Launch banner + hero — reserve space to prevent font-load CLS on mobile.
       Floors are the measured natural heights, so they reserve space without
       adding dead band. (This rule previously targeted `.launch-banner`, a
       class no element carries, so it never applied.) */
    .launch-urgency-banner { min-height: 50px; box-sizing: border-box; }
    @media (max-width: 768px) {
      .launch-urgency-banner { min-height: 92px; }
    }
    @media (max-width: 480px) {
      .launch-urgency-banner { min-height: 103px; }
    }

    /* Hero Section */
    .pricing-hero {
      padding: 10rem 2rem 4rem;
      text-align: center;
      background: linear-gradient(180deg, var(--bg-secondary) 0%, var(--bg-primary) 100%);
      border-bottom: 1px solid var(--border);
      min-height: 380px;
    }

    .pricing-hero h1 {
      font-size: 3rem;
      font-weight: 800;
      margin-bottom: 1rem;
      line-height: 1.2;
    }

    .pricing-hero p {
      color: var(--text-secondary);
      font-size: 1.2rem;
      max-width: 650px;
      margin: 0 auto 2rem;
    }

    /* Breadcrumb */
    .breadcrumb { max-width: 1200px; margin: 0 auto; padding: 1.5rem 2rem 0; font-size: 0.875rem; }
    .breadcrumb a { color: var(--text-secondary); }
    .breadcrumb a:hover { color: var(--accent); }
    .breadcrumb span { color: var(--text-muted); margin: 0 0.5rem; }

    /* Category Tabs */
    .category-tabs {
      display: flex;
      justify-content: center;
      gap: 0.5rem;
      max-width: 700px;
      margin: 0 auto 3rem;
      background: var(--bg-secondary);
      border-radius: 12px;
      padding: 0.35rem;
      border: 1px solid var(--border);
    }

    .category-tab {
      padding: 0.75rem 1.5rem;
      background: none;
      border: none;
      color: var(--text-secondary);
      cursor: pointer;
      font-weight: 600;
      font-size: 0.95rem;
      border-radius: 8px;
      transition: all 0.25s ease;
      flex: 1;
      font-family: inherit;
    }

    .category-tab:hover {
      color: var(--text-primary);
    }

    .category-tab.active {
      background: var(--accent);
      color: #ffffff;
      box-shadow: 0 2px 8px var(--accent-glow);
    }

    /* Tab Content */
    .tab-content {
      display: none;
      animation: tabFadeIn 0.3s ease;
    }

    .tab-content.active {
      display: block;
    }

    /* Sub-tabs (per engine / per LLM / per platform) */
    .sub-tabs {
      display: flex;
      gap: 0.5rem;
      flex-wrap: wrap;
      justify-content: center;
      margin: 1.5rem auto 1.25rem;
      max-width: 760px;
    }
    .sub-tab {
      display: inline-flex;
      align-items: center;
      gap: 0.5rem;
      padding: 0.5rem 0.95rem;
      border: 1px solid var(--border);
      border-radius: 9999px;
      background: var(--bg-card);
      color: var(--text-secondary);
      font-size: 0.85rem;
      font-weight: 600;
      cursor: pointer;
      transition: border-color 0.2s, color 0.2s, background 0.2s;
      font-family: inherit;
    }
    .sub-tab img {
      width: 18px;
      height: 18px;
      object-fit: contain;
    }
    .sub-tab:hover { border-color: var(--accent); color: var(--text-primary); }
    .sub-tab.active {
      border-color: var(--accent);
      color: var(--accent);
      background: transparent;
    }
    /* Per-row hide for the platform sub-tabs on the Social table (the only sub-tabs left: SERP
       and AI price identically across every engine and model, so those pills were removed). */
    .pricing-table tr[data-platform].hidden { display: none; }

    @keyframes tabFadeIn {
      from { opacity: 0; transform: translateY(8px); }
      to { opacity: 1; transform: translateY(0); }
    }

    /* Pricing Tables Section */
    .pricing-section {
      max-width: 1000px;
      margin: 0 auto;
      padding: 0 2rem 4rem;
    }

    .pricing-table-wrapper {
      overflow-x: auto;
      -webkit-overflow-scrolling: touch;
      border-radius: 16px;
      border: 1px solid var(--border);
      background: var(--bg-card);
      box-shadow: var(--card-shadow);
    }

    table.pricing-table {
      display: table;
      width: 100%;
      border-collapse: collapse;
      table-layout: auto;
      grid-template-columns: none;
      gap: 0;
      margin: 0;
    }

    /* Scale column highlight */
    .scale-col {
      background: rgba(13, 148, 136, 0.06);
    }

    [data-theme=dark] .scale-col {
      background: rgba(20, 184, 166, 0.08);
    }

    .pricing-table thead th.scale-col {
      color: var(--accent);
    }

    .pricing-table td.scale-col strong {
      color: var(--accent);
    }

    /* Engine name rowspan vertical alignment */
    .pricing-table td[rowspan] {
      vertical-align: middle;
    }

    table.pricing-table thead {
      display: table-header-group;
    }

    table.pricing-table tbody {
      display: table-row-group;
    }

    table.pricing-table tr {
      display: table-row;
    }

    table.pricing-table th,
    table.pricing-table td {
      display: table-cell;
    }

    .pricing-table thead th {
      background: var(--bg-secondary);
      padding: 1rem 1.25rem;
      text-align: left;
      font-weight: 600;
      font-size: 0.85rem;
      text-transform: uppercase;
      letter-spacing: 0.05em;
      color: var(--text-secondary);
      border-bottom: 1px solid var(--border);
    }

    /* SERP table: 5 columns - engine wider, rest equal */
    .pricing-table thead th:first-child {
      width: 25%;
    }

    .pricing-table thead th:first-child {
      border-top-left-radius: 16px;
    }

    .pricing-table thead th:last-child {
      border-top-right-radius: 16px;
    }

    .pricing-table tbody td {
      padding: 1rem 1.25rem;
      border-bottom: 1px solid var(--border);
      font-size: 0.95rem;
    }

    .pricing-table tbody tr:last-child td {
      border-bottom: none;
    }

    .pricing-table tbody tr:hover td {
      background: var(--bg-card-hover);
    }

    .pricing-table .engine-name {
      font-weight: 600;
      color: var(--text-primary);
    }

    .pricing-table .engine-name .row-logos {
      display: inline-flex;
      align-items: center;
      gap: 0.4rem;
      vertical-align: middle;
      margin-right: 0.5rem;
    }
    .pricing-table .engine-name .row-logos img {
      width: 20px;
      height: 20px;
      object-fit: contain;
    }
    @media (max-width: 640px) {
      .pricing-table-wrapper {
        overflow-x: auto;
        -webkit-overflow-scrolling: touch;
        position: relative;
      }
      /* Give the table a real min-width so the wrapper's overflow-x:auto
         actually scrolls instead of crushing 5 columns to unreadable,
         left-clipped slivers on a 412px phone. */
      table.pricing-table {
        min-width: 560px;
        width: max-content;
      }
      .pricing-table thead th,
      .pricing-table tbody td {
        padding: 0.75rem 0.85rem;
        font-size: 0.85rem;
        white-space: nowrap;
      }
      .pricing-table thead th:first-child,
      .pricing-table tbody td:first-child {
        position: sticky;
        left: 0;
        z-index: 1;
        background: var(--bg-card);
      }
      .pricing-table thead th:first-child { background: var(--bg-secondary); }
      .pricing-table .engine-name .row-logos img { width: 16px; height: 16px; }
      .pricing-table .engine-name .row-logos { gap: 0.25rem; }
    }

    .pricing-table .price-cell {
      font-weight: 600;
      color: var(--accent);
    }

    .pricing-table .na-cell {
      color: var(--text-muted);
      font-style: italic;
    }

    .pricing-table .highlight-row td {
      background: var(--accent-dim);
    }

    .pricing-table .highlight-row:hover td {
      background: rgba(13, 148, 136, 0.12);
    }

    /* Table Notes */
    .table-notes {
      margin-top: 1.25rem;
      display: flex;
      flex-direction: column;
      gap: 0.5rem;
    }

    .table-note {
      position: relative;
      padding-left: 1.75rem;
      color: var(--text-secondary);
      font-size: 0.875rem;
      line-height: 1.55;
    }

    .table-note svg {
      position: absolute;
      left: 0;
      top: 4px;
      color: var(--accent);
    }

    /* Volume Discount Tiers */
    .tiers-section {
      max-width: 1200px;
      margin: 0 auto;
      padding: 4rem 2rem;
    }

    .tiers-section h2 {
      text-align: center;
      font-size: 2rem;
      font-weight: 800;
      margin-bottom: 0.75rem;
    }

    .tiers-section .section-subtitle {
      text-align: center;
      color: var(--text-secondary);
      font-size: 1.1rem;
      margin-bottom: 3rem;
    }

    .tiers-grid {
      display: grid;
      grid-template-columns: repeat(4, minmax(0, 1fr));
      gap: 1.5rem;
    }

    .tier-card {
      background: var(--bg-card);
      border: 1px solid var(--border);
      border-radius: 16px;
      padding: 2rem;
      position: relative;
      display: flex;
      flex-direction: column;
      transition: all 0.3s ease;
    }

    .tier-card:hover {
      border-color: var(--accent);
      transform: translateY(-4px);
      box-shadow: 0 12px 40px rgba(0, 0, 0, 0.12);
    }

    .tier-card.featured {
      border-color: var(--accent);
      box-shadow: 0 0 30px var(--accent-glow);
    }

    .tier-badge {
      position: absolute;
      top: -12px;
      left: 50%;
      transform: translateX(-50%);
      background: var(--accent);
      color: #ffffff;
      padding: 0.25rem 1rem;
      border-radius: 9999px;
      font-size: 0.75rem;
      font-weight: 600;
      text-transform: uppercase;
      white-space: nowrap;
    }

    .tier-badge.custom-badge {
      background: #6366f1;
    }

    .tier-name {
      font-size: 1.35rem;
      font-weight: 700;
      margin-bottom: 0.5rem;
    }

    .tier-price {
      font-size: 1.75rem;
      font-weight: 800;
      color: var(--accent);
      margin-bottom: 0.25rem;
      line-height: 1.25;
    }

    .tier-price span {
      font-size: 0.9rem;
      font-weight: 500;
      color: var(--text-secondary);
    }

    .tier-desc {
      color: var(--text-secondary);
      font-size: 0.9rem;
      margin-bottom: 1.5rem;
      line-height: 1.5;
      min-height: 4.1rem;
    }

    .tier-features {
      list-style: none;
      margin-bottom: 1.5rem;
      flex: 1;
    }

    .tier-features li {
      padding: 0.4rem 0;
      color: var(--text-secondary);
      font-size: 0.9rem;
      display: flex;
      align-items: flex-start;
      gap: 0.5rem;
    }

    .tier-features li svg {
      flex-shrink: 0;
      margin-top: 0.15rem;
      color: var(--success);
    }

    .tier-cta {
      width: 100%;
      height: 3.25rem;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      box-sizing: border-box;
      font-size: 0.95rem;
      margin-top: auto;
    }

    /* Features Grid */
    .features-section {
      background: var(--bg-secondary);
      padding: 4rem 2rem;
      border-top: 1px solid var(--border);
      border-bottom: 1px solid var(--border);
    }

    .features-section h2 {
      text-align: center;
      font-size: 2rem;
      font-weight: 800;
      margin-bottom: 0.75rem;
    }

    .features-section .section-subtitle {
      text-align: center;
      color: var(--text-secondary);
      font-size: 1.1rem;
      margin-bottom: 3rem;
    }

    .features-grid {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 1.5rem;
      max-width: 1000px;
      margin: 0 auto;
    }

    .feature-card {
      background: var(--bg-card);
      border: 1px solid var(--border);
      border-radius: 16px;
      padding: 2rem;
      text-align: center;
      transition: border-color 0.3s ease;
      min-height: 260px;
      display: flex;
      flex-direction: column;
      align-items: center;
    }
    .feature-card p {
      flex-grow: 1;
    }

    .feature-card:hover {
      border-color: var(--accent);
    }

    .feature-icon {
      width: 48px;
      height: 48px;
      background: var(--accent-dim);
      border-radius: 12px;
      display: flex;
      align-items: center;
      justify-content: center;
      margin: 0 auto 1rem;
      color: var(--accent);
    }

    .feature-card h3 {
      font-size: 1.1rem;
      font-weight: 600;
      margin-bottom: 0.5rem;
    }

    .feature-card p {
      color: var(--text-secondary);
      font-size: 0.9rem;
      line-height: 1.6;
    }

    /* FAQ Section */
    .faq-section {
      max-width: 800px;
      margin: 0 auto;
      padding: 4rem 2rem;
    }

    .faq-section h2 {
      text-align: center;
      font-size: 2rem;
      font-weight: 800;
      margin-bottom: 0.75rem;
    }

    .faq-section .section-subtitle {
      text-align: center;
      color: var(--text-secondary);
      font-size: 1.1rem;
      margin-bottom: 2.5rem;
    }

    .faq-item {
      border: 1px solid var(--border);
      border-radius: 12px;
      margin-bottom: 0.75rem;
      overflow: hidden;
      background: var(--bg-card);
      transition: border-color 0.2s ease;
    }

    .faq-item:hover {
      border-color: var(--accent);
    }

    .faq-question {
      width: 100%;
      padding: 1.25rem 1.5rem;
      background: none;
      border: none;
      color: var(--text-primary);
      font-size: 1rem;
      font-weight: 600;
      text-align: left;
      cursor: pointer;
      display: flex;
      justify-content: space-between;
      align-items: center;
      gap: 1rem;
      font-family: inherit;
      transition: color 0.2s;
    }

    .faq-question:hover {
      color: var(--accent);
    }

    .faq-question svg {
      flex-shrink: 0;
      transition: transform 0.3s ease;
      color: var(--text-muted);
    }

    .faq-item.open .faq-question svg {
      transform: rotate(180deg);
      color: var(--accent);
    }

    .faq-answer {
      max-height: 0;
      overflow: hidden;
      transition: max-height 0.3s ease, padding 0.3s ease;
    }

    .faq-item.open .faq-answer {
      max-height: 300px;
    }

    .faq-answer-inner {
      padding: 0 1.5rem 1.25rem;
      color: var(--text-secondary);
      font-size: 0.95rem;
      line-height: 1.7;
    }

    /* CTA Section */
    .cta-section {
      text-align: center;
      padding: 5rem 2rem;
      background: linear-gradient(180deg, var(--bg-primary) 0%, var(--bg-secondary) 100%);
      border-top: 1px solid var(--border);
    }

    .cta-section h2 {
      font-size: 2.25rem;
      font-weight: 800;
      margin-bottom: 1rem;
    }

    .cta-section p {
      color: var(--text-secondary);
      font-size: 1.15rem;
      max-width: 500px;
      margin: 0 auto 2rem;
    }

    .cta-buttons {
      display: flex;
      gap: 1rem;
      justify-content: center;
    }

    /* Footer */
    .footer {
      padding: 4rem 2rem;
      border-top: 1px solid var(--border);
    }

    .footer-container {
      max-width: 1200px;
      margin: 0 auto;
      display: grid;
      grid-template-columns: 2fr 1fr 1fr 1fr;
      gap: 4rem;
    }

    .footer-brand {
      font-size: 1.25rem;
      font-weight: 700;
      margin-bottom: 1rem;
      display: flex;
      align-items: center;
      gap: 0.5rem;
    }

    .footer-desc {
      color: var(--text-secondary);
      font-size: 0.9rem;
      margin-bottom: 1rem;
    }

    .footer-email {
      color: var(--accent);
      font-size: 0.9rem;
    }

    .footer-title {
      font-weight: 600;
      margin-bottom: 1.5rem;
    }

    .footer-links {
      list-style: none;
    }

    .footer-links li {
      margin-bottom: 0.75rem;
    }

    .footer-links a {
      color: var(--text-secondary);
      font-size: 0.9rem;
      transition: color 0.2s;
    }

    .footer-links a:hover {
      color: var(--accent);
    }

    .footer-bottom {
      max-width: 1200px;
      margin: 3rem auto 0;
      padding-top: 2rem;
      border-top: 1px solid var(--border);
      text-align: center;
      color: var(--text-muted);
      font-size: 0.85rem;
    }

    /* Google / Yahoo Brand Colors */
    .google-brand { font-family: 'Product Sans', 'Google Sans', Arial, sans-serif; font-weight: 400; letter-spacing: -0.5px; }
    .google-brand .g1 { color: #4285F4; }
    .google-brand .o1 { color: #EA4335; }
    .google-brand .o2 { color: #FBBC05; }
    .google-brand .g2 { color: #4285F4; }
    .google-brand .l { color: #34A853; }
    .google-brand .e { color: #EA4335; }
    .yahoo-brand { font-family: 'Helvetica Neue', Helvetica, Arial, sans-serif; font-weight: 700; color: #6001D2; letter-spacing: -1px; }

    /* Responsive */
    @media (max-width: 1024px) {
      .tiers-grid {
        grid-template-columns: repeat(2, 1fr);
      }
    }

    @media (max-width: 768px) {
      .pricing-hero {
        padding: 7rem 1rem 3rem;
      }

      .pricing-hero h1 {
        font-size: 2rem;
      }

      .pricing-hero p {
        font-size: 1rem;
      }

      .category-tabs {
        flex-direction: column;
        margin: 0 1rem 2rem;
        max-width: 100%;
      }

      .category-tab {
        padding: 0.65rem 1rem;
      }

      .pricing-section {
        padding: 0 1rem 3rem;
      }

      .pricing-table-wrapper {
        border-radius: 12px;
      }

      .tiers-grid {
        grid-template-columns: 1fr;
        max-width: 400px;
        margin: 0 auto;
      }

      .features-grid {
        grid-template-columns: 1fr;
        padding: 0 1rem;
      }

      .cta-buttons {
        flex-direction: column;
        align-items: center;
      }

      .cta-buttons .btn {
        width: 100%;
        max-width: 300px;
      }

      .footer-container {
        grid-template-columns: 1fr;
        text-align: center;
        gap: 2rem;
      }

      .footer-brand {
        justify-content: center;
      }

      .nav-links {
        display: none;
      }
    }
  
    .skip-link { position: absolute; top: -40px; left: 0; background: var(--accent); color: #fff; padding: 8px 16px; z-index: 10000; font-size: 14px; text-decoration: none; border-radius: 0 0 4px 0; transition: top 0.2s; }
    .skip-link:focus { top: 0; }
  </style>
</head>
<body>
  <a href="#main-content" class="skip-link">Skip to main content</a>
  <!-- Google Tag Manager (noscript) -->
  <noscript><iframe src="https://www.googletagmanager.com/ns.html?id=GTM-KR35XQV5"
  height="0" width="0" style="display:none;visibility:hidden"></iframe></noscript>

  <!-- Navigation -->
  <nav class="navbar" role="navigation" aria-label="Main navigation">
    <div class="nav-container">
      <a href="/" class="nav-brand" aria-label="Serpent API Home">
        <span class="infinity-serpent">
          <svg viewBox="0 0 48 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round">
            <path d="M12 12c0-4.4 3.6-8 8-8s8 3.6 8 8-3.6 8-8 8c-2.5 0-4.7-1.1-6.2-2.9" style="stroke: var(--accent);"/>
            <path d="M36 12c0 4.4-3.6 8-8 8s-8-3.6-8-8 3.6-8 8-8c2.5 0 4.7 1.1 6.2 2.9" style="stroke: var(--accent);"/>
          </svg>
        </span>
        Serpent<span class="brand-api">API</span>
      </a>
      <ul class="nav-links" id="navLinks"></ul>
      <div class="nav-buttons" id="navButtons"></div>
      <!-- Mobile Menu Button -->
      <button class="mobile-menu-btn" id="mobileMenuBtn" aria-label="Toggle menu">
        <svg class="hamburger-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor">
          <line x1="3" y1="6" x2="21" y2="6"></line>
          <line x1="3" y1="12" x2="21" y2="12"></line>
          <line x1="3" y1="18" x2="21" y2="18"></line>
        </svg>
        <svg class="close-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor">
          <line x1="18" y1="6" x2="6" y2="18"></line>
          <line x1="6" y1="6" x2="18" y2="18"></line>
        </svg>
      </button>
    </div>
  </nav>

  <!-- Mobile Menu -->
  <div class="mobile-menu" id="mobileMenu">
    <ul class="mobile-menu-links"></ul>
    <div class="mobile-menu-buttons" id="mobileMenuButtons"></div>
  </div>

  <!-- Documentation update notice -->
    <div class="launch-urgency-banner" role="note" aria-label="Documentation update">
      <div class="launch-urgency-inner launch-slide is-active">
        <span>Our API documentation has just been updated</span>
        <a href="/docs" class="launch-urgency-cta">See what&rsquo;s new &rarr;</a>
      </div>
    </div>

  <!-- Hero Section -->
  <header class="pricing-hero">
    <h1><span class="accent">Deposit Once</span>, Unlock a Web Tier</h1>
    <p>From <strong>$0.03 per 1,000 Web billing units</strong> at the Enterprise tier after one qualifying $1,000 deposit on eligible new credit. That is <strong>$0.00003 per one-unit Quick Web call</strong>; Deep Search bills one unit per requested page. No subscription. Free to start on eligible endpoints.</p>
    <a href="/login" class="btn btn-primary btn-lg">Try for Free</a>
  </header>

  <main id="main-content">

    <nav class="breadcrumb" aria-label="Breadcrumb">
      <a href="/">Home</a> <span>/</span> <strong>Pricing</strong>
    </nav>

    <!-- Promo offer scope -->
    <aside role="note" aria-label="Promotional pricing terms" style="max-width: 920px; margin: 0 auto 2rem; padding: 1rem 1.25rem; background: rgba(13,148,136,0.08); border-left: 4px solid #0f8378; border-radius: 6px; font-size: 0.95rem; line-height: 1.55; min-height: 100px;">
      <strong style="color:#0f8378;">How pricing works:</strong>
      New deposits follow the current schedule: Web is $0.30/1K on Growth ($100), $0.10/1K on Scale ($500), or $0.03/1K on Enterprise after one $1,000 deposit on eligible new credit. The Enterprise rate equals $0.00003 per one-unit Quick Web call; Deep Search bills one unit per requested page. Existing credit keeps its old price schedule; bonuses spend first, then old deposited credit, then new deposited credit. A call that exceeds the old remainder uses the new rate and applies that remainder toward it. Refunded or charged-back amounts don't count toward your tier.
    </aside>

    <!-- Category Tabs -->
    <section class="pricing-section" aria-label="Pricing categories">
      <div class="category-tabs" role="tablist" aria-label="Pricing categories">
        <button class="category-tab active" role="tab" aria-selected="true" aria-controls="tab-serp" id="tab-btn-serp" onclick="switchTab('serp')">SERP APIs</button>
        <button class="category-tab" role="tab" aria-selected="false" aria-controls="tab-ai" id="tab-btn-ai" onclick="switchTab('ai')">AI Mentions &amp; Overviews</button>
        <button class="category-tab" role="tab" aria-selected="false" aria-controls="tab-maps" id="tab-btn-maps" onclick="switchTab('maps')">Google Maps</button>
        <button class="category-tab" role="tab" aria-selected="false" aria-controls="tab-social" id="tab-btn-social" onclick="switchTab('social')">Social &amp; Ecommerce APIs</button>
      </div>

      <!-- SERP APIs Tab -->
      <div class="tab-content active" id="tab-serp" role="tabpanel" aria-labelledby="tab-btn-serp">
        <p class="text-muted" style="text-align:center;font-size:0.78rem;margin:0 auto 1rem;max-width:640px;">Same Web category rate across all 5 engines — Google, Bing, Yahoo, DuckDuckGo and Brave.</p>
        <div class="pricing-table-wrapper">
          <table class="pricing-table">
            <thead>
              <tr>
                <th>Endpoint</th>
                <th>Default</th>
                <th>Growth<br><small style="font-weight:400;text-transform:none;letter-spacing:0">Web $0.30/1K · one $100 deposit</small></th>
                <th class="scale-col">Scale<br><small style="font-weight:400;text-transform:none;letter-spacing:0">Web $0.10/1K · one $500 deposit</small></th>
                <th>Enterprise<br><small style="font-weight:400;text-transform:none;letter-spacing:0">Web $0.03/1K · one $1,000 deposit</small></th>
              </tr>
            </thead>
            <tbody>
              <tr>
                <td class="engine-name">
                  <strong>Google SERP &mdash; Deep Search</strong><br><small style="color:var(--text-muted);font-weight:400;"><code>/api/search</code> · 1 query returns up to 10 pages (~100 results with PAA · AIO · Featured Snippets) · <strong>billed per page requested</strong>: a 1-page call is 1 unit and a 10-page call is 10, at every tier and every balance</small>
                </td>
                <td class="price-cell">$0.60<br><small style="color:var(--text-muted);font-weight:400;">/1K Pages</small></td>
                <td class="price-cell">$0.30<br><small style="color:var(--text-muted);font-weight:400;">/1K Pages</small></td>
                <td class="price-cell scale-col"><strong>$0.10</strong><br><small style="color:var(--text-muted);font-weight:400;">/1K Pages</small></td>
                <td class="price-cell">$0.03<br><small style="color:var(--text-muted);font-weight:400;">/1K Pages</small></td>
              </tr>
              <tr>
                <td class="engine-name">
                  <strong>Google SERP &mdash; Quick Search</strong><br><small style="color:var(--text-muted);font-weight:400;"><code>/api/search/quick</code> · Same flat price · organic-only on Google; other engines return their own blocks · 1 query returns up to 100 organic results, best-effort at the high end · always one charge per call</small>
                </td>
                <td class="price-cell">$0.60<br><small style="color:var(--text-muted);font-weight:400;">/1K Requests</small></td>
                <td class="price-cell">$0.30<br><small style="color:var(--text-muted);font-weight:400;">/1K Requests</small></td>
                <td class="price-cell scale-col"><strong>$0.10</strong><br><small style="color:var(--text-muted);font-weight:400;">/1K Requests</small></td>
                <td class="price-cell">$0.03<br><small style="color:var(--text-muted);font-weight:400;">/1K Requests</small></td>
              </tr>
              <tr>
                <td class="engine-name">
                  <strong>News Search</strong><br><small style="color:var(--text-muted);font-weight:400;">Per 1K Search Queries · All engines</small>
                </td>
                <td class="price-cell">$0.20<br><small style="color:var(--text-muted);font-weight:400;">/1K Queries</small></td>
                <td class="price-cell">$0.02<br><small style="color:var(--text-muted);font-weight:400;">/1K Queries</small></td>
                <td class="price-cell scale-col"><strong>$0.01</strong><br><small style="color:var(--text-muted);font-weight:400;">/1K Queries</small></td>
                <td class="price-cell">$0.01<br><small style="color:var(--text-muted);font-weight:400;">/1K Queries</small></td>
              </tr>
              <tr>
                <td class="engine-name">
                  <strong>Image Search</strong><br><small style="color:var(--text-muted);font-weight:400;">Per 1K Search Queries · All engines · Standard discount</small>
                </td>
                <td class="price-cell">$0.35<br><small style="color:var(--text-muted);font-weight:400;">/1K Queries</small></td>
                <td class="price-cell">$0.32<br><small style="color:var(--text-muted);font-weight:400;">/1K Queries</small></td>
                <td class="price-cell scale-col"><strong>$0.25</strong><br><small style="color:var(--text-muted);font-weight:400;">/1K Queries</small></td>
                <td class="price-cell">$0.25<br><small style="color:var(--text-muted);font-weight:400;">/1K Queries</small></td>
              </tr>
              <tr>
                <td class="engine-name">
                  <strong>Video Search</strong><br><small style="color:var(--text-muted);font-weight:400;">Per 1K Search Queries · All engines · Standard discount</small>
                </td>
                <td class="price-cell">$0.10<br><small style="color:var(--text-muted);font-weight:400;">/1K Queries</small></td>
                <td class="price-cell">$0.09<br><small style="color:var(--text-muted);font-weight:400;">/1K Queries</small></td>
                <td class="price-cell scale-col"><strong>$0.07</strong><br><small style="color:var(--text-muted);font-weight:400;">/1K Queries</small></td>
                <td class="price-cell">$0.07<br><small style="color:var(--text-muted);font-weight:400;">/1K Queries</small></td>
              </tr>
            </tbody>
          </table>
        </div>
        <div class="table-notes">
          <div class="table-note">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-with="2" stroke-width="2"><circle cx="12" cy="12" r="10"/><path d="M12 16v-4"/><path d="M12 8h.01"/></svg>
            <strong>One Web search price, whichever engine you ask for &mdash; Google, Bing, Yahoo, DuckDuckGo or Brave.</strong> The rate below is the Web category rate; setting <code>engine=</code> never changes what you pay. Quick Search is billed one published Web category unit per request whatever your tier or balance. On Deep Search, one published Web category unit is charged per page requested, up to 10 pages, at every tier and every balance. For new credit, Scale Web search is <strong>$0.10/1K units</strong> and Enterprise is <strong>$0.03/1K units</strong>.
          </div>
          <div class="table-note">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/><polyline points="22 4 12 14.01 9 11.01"/></svg>
            Failed requests (server errors) are automatically refunded
          </div>
          <div class="table-note">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/><polyline points="22 4 12 14.01 9 11.01"/></svg>
            <strong>Empty responses are refunded automatically when the search could not be completed.</strong> If we ran out of time, or could not complete the search for another reason on our side, its credits are returned to your account. <strong>A search that completes and genuinely has no matches is a delivered result and is charged</strong> &mdash; &ldquo;there is nothing here&rdquo; is a real answer to a real question. A response that is short of what you asked for is also a delivered response and is charged normally.
          </div>
          <div class="table-note">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 2L2 7l10 5 10-5-10-5z"/><path d="M2 17l10 5 10-5"/><path d="M2 12l10 5 10-5"/></svg>
            free calls for every new account
          </div>
          <div class="table-note">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><path d="M12 16v-4"/><path d="M12 8h.01"/></svg>
            The largest single qualifying deposit sets the tier for new credit: $100 Growth, $500 Scale, or $1,000 Enterprise. Existing credit keeps its old price schedule as your balance spends down. Refunded or charged-back amounts don't count toward your tier. Concurrency, minute/hour limits and queue priority follow your live balance. Daily allowance is at least 10,000 requests/day for every account, including free accounts, or 100,000/day after verified total net deposits of $500; higher balance bands keep their higher daily limits. Goodwill and bonus credit do not count; refunds and chargebacks reduce qualifying deposits. Reviewed custom daily allocations take precedence. News retains its existing discount ladder; Images and Videos retain their 10% (Growth) / 30% (Scale and Enterprise) discount.
          </div>
        </div>
      </div>

      <!-- AI Mentions & Overviews Tab -->
      <div class="tab-content" id="tab-ai" role="tabpanel" aria-labelledby="tab-btn-ai">
        <p class="text-muted" style="text-align:center;font-size:0.78rem;margin:0 auto 1rem;max-width:640px;">Same rate for every model — Claude, ChatGPT, Gemini and Perplexity.</p>
        <div class="pricing-table-wrapper">
          <table class="pricing-table">
            <thead>
              <tr>
                <th>Endpoint</th>
                <th>Default</th>
                <th>Growth<br><small style="font-weight:400;text-transform:none;letter-spacing:0">10× off · one-time $100 deposit</small></th>
                <th class="scale-col">Scale / Enterprise<br><small style="font-weight:400;text-transform:none;letter-spacing:0">Same non-Web rates · $500 / $1,000 deposit</small></th>
              </tr>
            </thead>
            <tbody>
              <tr>
                <td class="engine-name">
                  <strong>AI Ranking — Single LLM</strong><br><small style="color:var(--text-muted);font-weight:400;">Per 1K Search Queries · Claude · ChatGPT · Gemini · Perplexity</small>
                </td>
                <td class="price-cell">$20.00<br><small style="color:var(--text-muted);font-weight:400;">/1K Queries</small></td>
                <td class="price-cell">$2.00<br><small style="color:var(--text-muted);font-weight:400;">/1K Queries</small></td>
                <td class="price-cell scale-col"><strong>$1.00</strong><br><small style="color:var(--text-muted);font-weight:400;">/1K Queries</small></td>
              </tr>
              <tr>
                <td class="engine-name">
                  <strong>AI Ranking — All 4 Combined</strong><br><small style="color:var(--text-muted);font-weight:400;">Per 1K Search Queries · Single call across all LLMs</small>
                </td>
                <td class="price-cell">$40.00<br><small style="color:var(--text-muted);font-weight:400;">/1K Queries</small></td>
                <td class="price-cell">$4.00<br><small style="color:var(--text-muted);font-weight:400;">/1K Queries</small></td>
