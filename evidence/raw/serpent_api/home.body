  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&family=Product+Sans:wght@400&display=optional" rel="stylesheet">
  <link rel="stylesheet" href="/css/styles.5ca31bfc902a39280550b9bec00e417fc8d2635cd1ed1ae97dc8dd9927046c7a.css">
  <link rel="stylesheet" href="/css/mobile.18348652644ddfcfecd0cc7af1cca858e9f8edd78c5094ffb957f3f578c8c921.css">
  <style>
    /* Google Brand Colors */
    .google-brand { font-family: 'Product Sans', 'Google Sans', Arial, sans-serif; font-weight: 400; letter-spacing: -0.5px; }
    .google-brand .g1 { color: #4285F4; }
    .google-brand .o1 { color: #EA4335; }
    .google-brand .o2 { color: #FBBC05; }
    .google-brand .g2 { color: #4285F4; }
    .google-brand .l { color: #34A853; }
    .google-brand .e { color: #EA4335; }

    /* Yahoo! Brand */
    .yahoo-brand { font-family: 'Helvetica Neue', Helvetica, Arial, sans-serif; font-weight: 700; color: #6001D2; letter-spacing: -1px; }

    /* Infinity Serpent Logo */
    .infinity-serpent {
      display: inline-flex;
      align-items: center;
      flex-shrink: 0;
    }
    .infinity-serpent svg {
      width: 48px;
      height: 20px;
    }
    .nav-brand .brand-api {
      color: var(--accent);
      margin-left: 0.15rem;
    }

    * { margin: 0; padding: 0; box-sizing: border-box; }

    body {
      font-family: 'Inter', -apple-system, BlinkMacSystemFont, sans-serif;
      background: var(--bg-primary);
      color: var(--text-primary);
      line-height: 1.6;
      overflow-x: hidden;
    }

    a { color: var(--text-primary); text-decoration: none; }

    .accent { color: var(--accent); }

    /* Snake Background Animation */
    .snake-bg {
      position: fixed;
      top: 0;
      left: 0;
      width: 100%;
      height: 100%;
      pointer-events: none;
      z-index: 0;
      overflow: hidden;
    }

    .snake-path {
      position: absolute;
      width: 300px;
      height: 300px;
      opacity: 0.04;
      animation: snakeFloat 20s ease-in-out infinite;
    }

    .snake-path:nth-child(1) { top: 10%; left: -5%; animation-delay: 0s; }
    .snake-path:nth-child(2) { top: 40%; right: -10%; animation-delay: -5s; transform: scaleX(-1); }
    .snake-path:nth-child(3) { bottom: 20%; left: 20%; animation-delay: -10s; }

    @keyframes snakeFloat {
      0%, 100% { transform: translateX(0) translateY(0) rotate(0deg); opacity: 0.04; }
      25% { transform: translateX(50px) translateY(-30px) rotate(5deg); opacity: 0.06; }
      50% { transform: translateX(100px) translateY(0) rotate(-5deg); opacity: 0.04; }
      75% { transform: translateX(50px) translateY(30px) rotate(5deg); opacity: 0.06; }
    }

    .snake-svg {
      width: 100%;
      height: 100%;
      fill: var(--accent);
    }

    /* Content wrapper */
    .content-wrapper {
      position: relative;
      z-index: 1;
    }

    /* Navigation */
    .navbar {
      padding: 1.5rem 2rem;
      position: fixed;
      top: 0;
      left: 0;
      right: 0;
      z-index: 9999;
      background: var(--navbar-bg);
      -webkit-backdrop-filter: blur(10px);
      backdrop-filter: blur(10px);
      border-bottom: 1px solid var(--border);
    }

    .nav-container {
      max-width: 1200px;
      margin: 0 auto;
      display: flex;
      justify-content: space-between;
      align-items: center;
    }

    .nav-brand {
      font-size: 1.5rem;
      font-weight: 700;
      color: var(--accent);
      display: flex;
      align-items: center;
      gap: 0.6rem;
    }

    .nav-brand svg {
      color: var(--accent);
    }

    .nav-links {
      display: flex;
      gap: 2.5rem;
      list-style: none;
    }

    .nav-links a {
      color: var(--text-secondary);
      font-weight: 500;
      transition: color 0.2s, border-color 0.2s;
      padding: 0.4rem 0;
      border-bottom: 2px solid transparent;
    }

    .nav-links a:hover {
      color: var(--accent);
      border-bottom-color: var(--accent);
    }

    .nav-buttons {
      display: flex;
      gap: 1rem;
    }

    .btn-lg {
      padding: 0.9rem 2rem;
      font-size: 1rem;
    }

    /* Hero */
    .hero {
      min-height: 100vh;
      display: flex;
      align-items: center;
      justify-content: center;
      text-align: center;
      padding: 8rem 2rem 1.5rem;
    }

    .hero-content {
      max-width: 1000px;
    }

    .hero-badge {
      display: inline-block;
      padding: 0.4rem 1rem;
      background: var(--accent-glow);
      border: 1px solid var(--accent);
      border-radius: 100px;
      font-size: 0.85rem;
      color: var(--accent);
      margin-bottom: 2rem;
    }

    .hero-title {
      font-size: 3.5rem;
      font-weight: 800;
      line-height: 1.1;
      margin-bottom: 1.5rem;
      letter-spacing: -0.02em;
      max-width: 980px;
      margin-left: auto;
      margin-right: auto;
    }
    .hero-title .nowrap { white-space: nowrap; }

    .hero-subtitle {
      font-size: 1.25rem;
      color: var(--text-secondary);
      max-width: 600px;
      margin: 0 auto 2.5rem;
      line-height: 1.7;
    }

    .hero-logo-groups {
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 2.5rem;
      margin: 0.5rem auto 1rem;
      flex-wrap: wrap;
    }

    .logo-group {
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: 0.75rem;
    }

    .logo-group-label {
      font-size: 0.7rem;
      font-weight: 700;
      letter-spacing: 0.12em;
      text-transform: uppercase;
      color: var(--text-muted);
    }

    .logo-group-row {
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 1.5rem;
      height: 48px;
    }

    .logo-group-divider {
      width: 1px;
      height: 56px;
      background: var(--border);
    }

    .hero-logo {
      display: flex;
      align-items: center;
      justify-content: center;
      opacity: 0.95;
      transition: opacity 0.2s, transform 0.2s;
    }

    .hero-logo:hover {
      opacity: 1;
      transform: translateY(-2px);
    }

    .hero-logo img {
      height: 40px;
      width: auto;
      min-width: 40px;
      max-width: 64px;
      object-fit: contain;
    }

    @media (max-width: 720px) {
      .logo-group-divider { display: none; }
      .hero-logo-groups { gap: 1.5rem; }
      .logo-group-row { gap: 1rem; height: 36px; }
      .hero-logo img { height: 30px; min-width: 30px; }
    }

    .sr-only {
      position: absolute;
      width: 1px;
      height: 1px;
      padding: 0;
      margin: -1px;
      overflow: hidden;
      clip: rect(0, 0, 0, 0);
      white-space: nowrap;
      border: 0;
    }

    .hero-buttons {
      display: flex;
      gap: 1rem;
      justify-content: center;
      margin-bottom: 4rem;
    }

    .hero-stats {
      display: grid;
      grid-template-columns: repeat(4, 1fr);
      gap: 1rem;
      margin-top: 3rem;
      padding-top: 3rem;
      border-top: 1px solid var(--border);
    }

    .stat {
      display: flex;
      flex-direction: column;
      justify-content: center;
      align-items: center;
      text-align: center;
      padding: 1.25rem 1rem;
      background: var(--bg-card);
      border: 1px solid var(--border);
      border-radius: 12px;
      min-height: 130px;
      transition: border-color 0.2s, transform 0.2s;
    }

    .stat:hover {
      border-color: var(--accent);
      transform: translateY(-2px);
    }

    .stat-value {
      font-size: 1.4rem;
      font-weight: 800;
      color: var(--accent);
      line-height: 1.2;
      letter-spacing: -0.01em;
      display: flex;
      align-items: center;
      justify-content: center;
      min-height: 2.6rem;
    }

    .stat-label {
      color: var(--text-secondary);
      font-size: 0.82rem;
      font-weight: 500;
      margin-top: 0.5rem;
      line-height: 1.3;
    }

    @media (max-width: 900px) {
      .hero-stats { grid-template-columns: 1fr 1fr; gap: 0.75rem; margin-top: 2rem; padding-top: 2rem; }
      .stat {
        min-height: 110px;
        height: 110px;
        padding: 1rem 0.75rem;
        justify-content: center;
      }
      .stat-value {
        font-size: 1.1rem;
        min-height: 0;
        line-height: 1.2;
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
        max-width: 100%;
      }
      .stat-label {
        font-size: 0.72rem;
        line-height: 1.3;
        margin-top: 0.4rem;
      }
    }

    .stat-label {
      font-size: 0.9rem;
      color: var(--text-secondary);
      margin-top: 0.25rem;
    }


    /* Features */
    .features {
      padding: 8rem 2rem;
    }

    .section-header {
      text-align: center;
      max-width: 600px;
      margin: 0 auto 4rem;
    }

    .section-header h2 {
      font-size: 2.5rem;
      font-weight: 700;
      margin-bottom: 1rem;
    }

    .section-header p {
      color: var(--text-secondary);
      font-size: 1.1rem;
    }

    .features-grid {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 2rem;
      max-width: 1100px;
      margin: 0 auto;
    }

    .feature-card {
      padding: 2rem;
      background: var(--bg-card);
      border: 1px solid var(--border);
      border-radius: 12px;
      transition: all 0.2s;
    }

    .feature-card:hover {
      border-color: var(--accent);
    }

    .feature-icon {
      width: 48px;
      height: 48px;
      margin-bottom: 1.5rem;
      color: var(--accent);
    }

    .feature-card h3 {
      font-size: 1.25rem;
      font-weight: 600;
      margin-bottom: 0.75rem;
    }

    .feature-card p {
      color: var(--text-secondary);
      font-size: 0.95rem;
      line-height: 1.6;
    }

    /* Service cards — flex layout for CTA alignment */
    .service-card {
      display: flex;
      flex-direction: column;
      transition: transform 0.2s, border-color 0.2s;
    }

    .service-card:hover {
      transform: translateY(-4px);
    }

    .service-card p {
      flex: 1;
    }

    .service-card-cta {
      color: var(--accent);
      font-size: 0.85rem;
      font-weight: 600;
      margin-top: auto;
      padding-top: 1rem;
      display: inline-block;
    }

    /* How it works */
    .how-it-works {
      padding: 8rem 2rem;
      background: var(--bg-secondary);
    }

    .steps {
      display: flex;
      justify-content: center;
      gap: 4rem;
      max-width: 1000px;
      margin: 0 auto;
    }

    .step {
      flex: 1;
      text-align: center;
      max-width: 280px;
    }

    .step-number {
      width: 56px;
      height: 56px;
      border: 2px solid var(--accent);
      border-radius: 50%;
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 1.25rem;
      font-weight: 700;
      margin: 0 auto 1.5rem;
      color: var(--accent);
    }

    .step h3 {
      font-size: 1.25rem;
      font-weight: 600;
      margin-bottom: 0.75rem;
    }

    .step p {
      color: var(--text-secondary);
      font-size: 0.95rem;
    }

    /* Pricing */
    .pricing {
      padding: 8rem 2rem;
    }

    .pricing-grid {
      display: flex;
      flex-wrap: wrap;
      justify-content: center;
      gap: 1.5rem;
      max-width: 1200px;
      margin: 0 auto;
    }

    .pricing-card {
      flex: 0 1 calc(33.333% - 1.5rem);
      min-width: 260px;
      padding: 2.5rem;
      background: var(--bg-card);
      border: 1px solid var(--border);
      border-radius: 16px;
      text-align: center;
    }

    .pricing-card.featured {
      border-color: var(--accent);
      position: relative;
    }

    .pricing-card.featured::before {
      content: 'Popular';
      position: absolute;
      top: -12px;
      left: 50%;
      transform: translateX(-50%);
      background: var(--accent);
      color: #ffffff;
      padding: 0.25rem 1rem;
      border-radius: 100px;
      font-size: 0.75rem;
      font-weight: 600;
    }

    .pricing-name {
      font-size: 1.1rem;
      font-weight: 600;
      margin-bottom: 1rem;
    }

    .pricing-price {
      font-size: 3rem;
      font-weight: 800;
      margin-bottom: 0.25rem;
    }

    .pricing-card.featured .pricing-price {
      color: var(--accent);
    }

    .pricing-price span {
      font-size: 1rem;
      font-weight: 400;
      color: var(--text-secondary);
    }

    .pricing-desc {
      color: var(--text-secondary);
      font-size: 0.9rem;
      margin-bottom: 2rem;
    }

    .pricing-features {
      list-style: none;
      margin-bottom: 2rem;
      text-align: left;
    }

    .pricing-features li {
      padding: 0.6rem 0;
      color: var(--text-secondary);
      font-size: 0.9rem;
      display: flex;
      align-items: center;
      gap: 0.75rem;
    }

    .pricing-features li::before {
      content: none;
    }

    .pricing-features li svg {
      width: 16px;
      height: 16px;
      color: var(--accent);
      flex-shrink: 0;
    }

    .pricing-card .btn {
      width: 100%;
    }

    /* FAQ */
    .faq-section {
      background: var(--bg-secondary);
      padding: 6rem 2rem;
    }

    .faq-container {
      max-width: 800px;
      margin: 0 auto;
    }

    .faq-container h2 {
      text-align: center;
      font-size: 2rem;
      margin-bottom: 2rem;
    }

    .faq-item {
      background: var(--bg-card);
      border: 1px solid var(--border);
      border-radius: 8px;
      margin-bottom: 1rem;
      overflow: hidden;
    }

    .faq-question {
      padding: 1.25rem;
      cursor: pointer;
      display: flex;
      justify-content: space-between;
      align-items: center;
      font-weight: 600;
      background: none;
      border: none;
      width: 100%;
      text-align: left;
      font-family: inherit;
      font-size: inherit;
      color: inherit;
    }

    .faq-question:hover {
      background: var(--bg-secondary);
    }

    .faq-answer {
      padding: 0 1.25rem 1.25rem;
      color: var(--text-secondary);
      display: none;
    }

    .faq-item.active .faq-answer {
      display: block;
    }

    .faq-item.active .faq-question svg {
      transform: rotate(180deg);
    }

    /* CTA */
    .cta {
      padding: 8rem 2rem;
      text-align: center;
      background: var(--bg-secondary);
    }

    .cta h2 {
      font-size: 2.5rem;
      font-weight: 700;
      margin-bottom: 1rem;
    }

    .cta p {
      color: var(--text-secondary);
      font-size: 1.1rem;
      margin-bottom: 2rem;
    }

    /* Footer */
    .footer {
      padding: 4rem 2rem;
      border-top: 1px solid var(--border);
    }

    .footer-container {
      max-width: 1200px;
      margin: 0 auto;
      display: grid;
      grid-template-columns: 2fr 1fr 1fr 1fr;
      gap: 4rem;
    }

    .footer-brand {
      font-size: 1.25rem;
      font-weight: 700;
      margin-bottom: 1rem;
      display: flex;
      align-items: center;
      gap: 0.5rem;
    }

    .footer-brand svg {
      color: var(--accent);
    }

    .footer-desc {
      color: var(--text-secondary);
      font-size: 0.9rem;
      margin-bottom: 1rem;
    }

    .footer-email {
      color: var(--accent);
      font-size: 0.9rem;
    }

    .footer-title {
      font-weight: 600;
      margin-bottom: 1.5rem;
    }

    .footer-links {
      list-style: none;
    }

    .footer-links li {
      margin-bottom: 0.75rem;
    }

    .footer-links a {
      color: var(--text-secondary);
      font-size: 0.9rem;
      transition: color 0.2s;
    }

    .footer-links a:hover {
      color: var(--accent);
    }

    .footer-bottom {
      max-width: 1200px;
      margin: 3rem auto 0;
      padding-top: 2rem;
      border-top: 1px solid var(--border);
      text-align: center;
      color: var(--text-muted);
      font-size: 0.85rem;
    }

    /* Mobile Menu Button - hidden by default */
    .mobile-menu-btn {
      display: none;
      background: none;
      border: none;
      cursor: pointer;
      padding: 0.5rem;
      z-index: 1001;
    }

    .mobile-menu-btn svg {
      width: 24px;
      height: 24px;
      stroke: var(--text-primary);
      stroke-width: 2;
      stroke-linecap: round;
    }

    .mobile-menu-btn .close-icon {
      display: none;
    }

    .mobile-menu-btn.active .hamburger-icon {
      display: none;
    }

    .mobile-menu-btn.active .close-icon {
      display: block;
    }

    /* Mobile Menu */
    .mobile-menu {
      display: none;
      position: fixed;
      top: 70px;
      left: 0;
      right: 0;
      bottom: 0;
      background: var(--bg-primary);
      z-index: 1000;
      padding: 2rem;
      overflow-y: auto;
      transform: translateY(-100%);
      transition: transform 0.3s ease;
    }

    .mobile-menu.active {
      transform: translateY(0);
    }

    .mobile-menu-links {
      list-style: none;
      padding: 0;
      margin: 0;
    }

    .mobile-menu-links li {
      border-bottom: 1px solid var(--border);
    }

    .mobile-menu-links a {
      display: block;
      padding: 1.25rem 0;
      font-size: 1.1rem;
      font-weight: 500;
      color: var(--text-primary);
      transition: color 0.2s;
    }

    .mobile-menu-links a:hover {
      color: var(--accent);
    }

    .mobile-menu-buttons {
      margin-top: 2rem;
      display: flex;
      flex-direction: column;
      gap: 1rem;
    }

    .mobile-menu-buttons .btn {
      width: 100%;
      text-align: center;
      padding: 1rem;
      font-size: 1rem;
    }

    /* Responsive */
    @media (max-width: 1100px) {
      .pricing-card {
        flex: 0 1 calc(50% - 1.5rem);
      }
    }

    @media (max-width: 900px) {
      .features-grid {
        grid-template-columns: 1fr;
        max-width: 400px;
      }

      #pixel-position-spotlight > div {
        grid-template-columns: 1fr !important;
        padding: 1.75rem !important;
      }

      .steps {
        flex-direction: column;
        align-items: center;
        gap: 3rem;
      }

      .hero-title {
        font-size: 2.5rem;
      }

      .hero-stats {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 1.5rem;
      }

      .nav-links {
        display: none !important;
      }

      .nav-buttons {
        display: none !important;
      }

      .nav-user {
        display: none !important;
      }

      .mobile-menu-btn {
        display: flex !important;
        align-items: center;
        justify-content: center;
      }

      .mobile-menu {
        display: block;
      }

      /* Ensure navbar content is visible on mobile - consistent with mobile.css */
      .navbar {
        display: flex !important;
        visibility: visible !important;
        opacity: 1 !important;
        padding: 0.75rem 1rem !important;
        min-height: 60px !important;
        position: fixed !important;
        top: 0 !important;
        left: 0 !important;
        right: 0 !important;
        z-index: 9999 !important;
        background: var(--navbar-bg) !important;
      }

      .nav-container {
        display: flex !important;
        justify-content: space-between !important;
        align-items: center !important;
        width: 100%;
        height: 100%;
      }

      .nav-brand {
        display: flex !important;
        align-items: center !important;
        font-size: 1.2rem !important;
        color: var(--accent) !important;
        gap: 0.5rem;
        white-space: nowrap;
      }

      .nav-brand .infinity-serpent {
        display: inline-flex !important;
        flex-shrink: 0;
      }

      .nav-brand .infinity-serpent svg {
        width: 32px !important;
        height: 14px !important;
      }

      .footer-container {
        grid-template-columns: 1fr;
        text-align: center;
        gap: 2rem;
      }

      .footer-brand {
        justify-content: center;
      }

      .form-row {
        grid-template-columns: 1fr;
      }

      .search-input-wrap {
        flex-direction: column;
      }

      .api-info {
        flex-direction: column;
        align-items: flex-start;
      }

      /* Services cards — stack on mobile instead of 3-col */
      .features-grid[style*="repeat(3"] {
        grid-template-columns: 1fr !important;
        max-width: 400px !important;
      }

      /* Reduce excessive section padding on mobile */
      .how-it-works {
        padding: 4rem 1.5rem !important;
      }

      .features {
        padding: 4rem 1.5rem;
      }

      .pricing {
        padding: 4rem 1rem;
      }

      .section-header h2 {
        font-size: 1.75rem;
      }

      /* Pricing cards — stack vertically, no horizontal scroll */
      .pricing-grid {
        flex-direction: column;
        align-items: center;
      }

      .pricing-card {
        flex: none !important;
        width: 100%;
        max-width: 340px;
        padding: 2rem 1.5rem;
      }

      /* Remove the ✓ pseudo-element since SVG icons already present */
      .pricing-features li::before {
        content: none !important;
      }

      /* Hero buttons stack on small screens */
      .hero-buttons {
        flex-direction: column;
        align-items: center;
        gap: 0.75rem;
        margin-bottom: 2.5rem;
      }

      .hero-buttons .btn {
        width: 100%;
        max-width: 300px;
      }

      /* Compact stat values */
      .stat-value {
        font-size: 2rem;
      }

      /* CTA section */
      .cta-section {
        padding: 4rem 1.5rem;
      }

      /* FAQ section */
      .faq-section {
        padding: 4rem 1.5rem;
      }
    }
  
    .skip-link { position: absolute; top: -40px; left: 0; background: var(--accent); color: #fff; padding: 8px 16px; z-index: 10000; font-size: 14px; text-decoration: none; border-radius: 0 0 4px 0; transition: top 0.2s; }
    .skip-link:focus { top: 0; }

    /* Trust / Social Proof Section */
    .trust-section {
      padding: 6rem 2rem 4rem;
    }

    /* Stats Bar */
    .trust-stats-bar {
      max-width: 900px;
      margin: 0 auto 3rem;
      background: var(--bg-card);
      border: 1px solid var(--border);
      border-radius: 12px;
      padding: 2rem 1.5rem;
    }

    .trust-stats-inner {
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 2rem;
    }

    .trust-stat {
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: 0.25rem;
      flex: 1;
    }

    .trust-stat-value {
      font-size: 2rem;
      font-weight: 800;
      color: var(--accent);
      letter-spacing: -0.02em;
    }

    .trust-stat-label {
      font-size: 0.85rem;
      color: var(--text-secondary);
      font-weight: 500;
    }

    .trust-stat-divider {
      width: 1px;
      height: 40px;
      background: var(--border);
      flex-shrink: 0;
    }

    /* Trust Badges */
    .trust-badges {
      display: flex;
      justify-content: center;
      gap: 2.5rem;
      max-width: 800px;
      margin: 0 auto 4rem;
      flex-wrap: wrap;
    }

    .trust-badge {
      display: flex;
      align-items: center;
      gap: 0.5rem;
      color: var(--text-secondary);
      font-size: 0.9rem;
      font-weight: 500;
    }

    .trust-badge svg {
      color: var(--accent);
      flex-shrink: 0;
    }

    /* Comparison Callout */
    .trust-comparison {
      max-width: 600px;
      margin: 0 auto 4rem;
      text-align: center;
    }

    .trust-comparison-inner {
      background: var(--bg-card);
      border: 1px solid var(--border);
      border-radius: 12px;
      padding: 2.5rem 2rem;
    }

    .trust-comparison-label {
      font-size: 1.1rem;
      font-weight: 700;
      margin-bottom: 1.5rem;
      color: var(--text-primary);
    }

    .trust-comparison-boxes {
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 1.5rem;
    }

    .trust-comparison-box {
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: 0.25rem;
      padding: 1.25rem 2rem;
      border-radius: 8px;
      min-width: 140px;
    }

    .trust-comparison-them {
      background: var(--bg-secondary);
      border: 1px solid var(--border);
    }

    .trust-comparison-us {
      background: var(--accent-glow);
      border: 1px solid var(--accent);
    }

    .trust-comparison-name {
      font-size: 0.85rem;
      font-weight: 600;
      color: var(--text-secondary);
    }

    .trust-comparison-us .trust-comparison-name {
      color: var(--accent);
    }

    .trust-comparison-price {
      font-size: 1.75rem;
      font-weight: 800;
      color: var(--text-primary);
    }

    .trust-comparison-us .trust-comparison-price {
      color: var(--accent);
    }

    .trust-comparison-price span {
      font-size: 0.85rem;
      font-weight: 400;
      color: var(--text-secondary);
    }

    .trust-comparison-vs {
      font-size: 0.85rem;
      font-weight: 600;
      color: var(--text-muted);
      text-transform: uppercase;
      letter-spacing: 0.05em;
    }

    .trust-comparison-note {
      margin-top: 1rem;
      font-size: 0.85rem;
      color: var(--text-secondary);
    }

    /* Developer workload examples */
    .trust-developers {
      max-width: 1120px;
      margin: 0 auto;
    }

    /* Developer workload examples — auto-sliding card rail (single row, even compact cards) */
    .workflow-rail {
      position: relative;
      max-width: 1120px;
      margin: 0 auto;
      display: flex;
      overflow-x: auto;
      scroll-snap-type: x mandatory;
      -webkit-overflow-scrolling: touch;
      scrollbar-width: none;
      padding: 6px 0 14px;
    }
    .workflow-rail::-webkit-scrollbar { display: none; }

    .workflow-card {
      flex: 0 0 25%;
      min-width: 0;
      scroll-snap-align: start;
      background: var(--bg-card);
      border: 1px solid var(--border);
      border-radius: 12px;
      padding: 1.05rem 1rem;
      display: flex;
      flex-direction: column;
      gap: 0.55rem;
      transition: border-color 0.2s, transform 0.2s, box-shadow 0.2s;
    }

    .workflow-card:hover {
      border-color: var(--accent);
      transform: translateY(-2px);
      box-shadow: 0 8px 24px rgba(13, 148, 136, 0.08);
    }

    .workflow-icon {
      width: 34px;
      height: 34px;
      border-radius: 9px;
      background: var(--accent-glow);
      display: flex;
      align-items: center;
      justify-content: center;
      color: var(--accent);
      flex-shrink: 0;
    }

    .workflow-icon svg {
      width: 18px;
      height: 18px;
    }

    .workflow-title {
      font-size: 0.9rem;
      font-weight: 700;
      color: var(--text-primary);
      line-height: 1.25;
    }

    .workflow-subtitle {
      font-size: 0.66rem;
      color: var(--text-muted);
      font-weight: 500;
      text-transform: uppercase;
      letter-spacing: 0.05em;
    }

    .workflow-quote {
      font-size: 0.8rem;
      color: var(--text-secondary);
      line-height: 1.55;
      flex-grow: 1;
      margin: 0;
    }

    .workflow-link {
      font-size: 0.8rem;
      font-weight: 600;
      color: var(--accent);
      text-decoration: none;
      display: inline-flex;
      align-items: center;
      gap: 0.25rem;
      margin-top: 0.1rem;
    }

    .workflow-link:hover { text-decoration: underline; }

    .workflow-rail-dots {
      display: flex;
      gap: 0.5rem;
      justify-content: center;
      margin-top: 0.6rem;
    }

    .workflow-rail-dot {
      width: 8px;
      height: 8px;
      border-radius: 50%;
      background: var(--border);
      cursor: pointer;
      border: none;
      padding: 0;
      transition: background 0.2s, width 0.2s;
    }

    .workflow-rail-dot.active { background: var(--accent); width: 22px; border-radius: 4px; }

    @media (max-width: 1000px) {
      .workflow-card { flex-basis: 33.333%; }
    }
    @media (max-width: 720px) {
      .workflow-card { flex-basis: 50%; }
    }
    @media (max-width: 480px) {
      .workflow-card { flex-basis: 100%; }
    }

    /* Trust section responsive */
    @media (max-width: 900px) {
      .trust-section {
        padding: 4rem 1.5rem 3rem;
      }

      .trust-stats-inner {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 1.5rem;
      }

      .trust-stat-divider {
        display: none;
      }

      .trust-badges {
        gap: 1.5rem;
      }

      .trust-comparison-boxes {
        flex-direction: column;
        gap: 0.75rem;
      }

      .trust-comparison-vs {
        margin: 0;
      }

      .trust-developer-grid {
        grid-template-columns: 1fr;
        max-width: 400px;
        margin: 0 auto;
      }
    }

    /* --- Hero deck (C) --- */
    .hero-deck {
      font-size: 1.2rem;
      line-height: 1.65;
      color: var(--text-secondary);
      max-width: 58ch;
      margin: -0.5rem auto 2rem;
      text-wrap: balance;
    }

    /* --- Verified comparison + SERP blocks (C) --- */
    .compare-section, .blocks-section {
      padding: 5rem 2rem;
    }
    .blocks-section { background: var(--bg-secondary); }
    .compare-inner, .blocks-inner { max-width: 1000px; margin: 0 auto; }
    .verified-stamp {
      display: inline-block;
      font-size: 0.75rem;
      font-weight: 600;
      letter-spacing: 0.03em;
      text-transform: uppercase;
      color: var(--accent);
      background: var(--accent-dim);
      border-radius: 999px;
      padding: 0.15rem 0.6rem;
      white-space: nowrap;
    }
    .table-scroll { overflow-x: auto; -webkit-overflow-scrolling: touch; margin: 2rem 0 0.75rem; }
    .table-scroll:focus-visible { outline: 2px solid var(--accent); outline-offset: 3px; }
    .table-hint { display: none; font-size: 0.78rem; color: var(--text-muted); margin: 1.5rem 0 -1.25rem; }
    .comparison-table { width: 100%; border-collapse: collapse; min-width: 640px; }
    .comparison-table th, .comparison-table td {
      padding: 0.9rem 1rem; text-align: left; border-bottom: 1px solid var(--border);
      vertical-align: top;
    }
    .comparison-table thead th {
      color: var(--text-secondary); font-weight: 600; font-size: 0.75rem;
      text-transform: uppercase; letter-spacing: 0.05em; background: var(--bg-secondary);
    }
    .blocks-section .comparison-table thead th { background: var(--bg-card); }
    .comparison-table tbody th { font-weight: 600; font-size: 0.92rem; }
    .comparison-table td { font-size: 0.92rem; color: var(--text-secondary); }
    .comparison-table .highlight-row { background: var(--accent-dim); }
    .comparison-table .highlight-row th, .comparison-table .highlight-row td { color: var(--text-primary); font-weight: 600; }
    .comparison-table .price-good { color: var(--accent); font-weight: 700; }
    .comparison-table .price-bad { color: var(--text-muted); }
    .comparison-table code { font-size: 0.82rem; }
    .row-note { display: block; font-size: 0.75rem; color: var(--text-muted); font-weight: 400; }
    .compare-sources { font-size: 0.8rem; color: var(--text-muted); line-height: 1.7; }
    .compare-sources a { color: var(--text-secondary); }
    .compare-prose { margin-top: 3rem; }
    .compare-prose h3 { font-size: 1.25rem; margin: 2rem 0 0.6rem; }
    .compare-prose h3:first-child { margin-top: 0; }
    .compare-prose p { color: var(--text-secondary); margin-bottom: 1rem; max-width: 68ch; }
    .visually-hidden {
      position: absolute; width: 1px; height: 1px; padding: 0; margin: -1px;
      overflow: hidden; clip: rect(0 0 0 0); white-space: nowrap; border: 0;
    }

    /* --- Volume calculator (C) --- */
    .calc {
      max-width: 760px; margin: 3.5rem auto 0; padding: 2rem;
      background: var(--bg-card); border: 1px solid var(--border); border-radius: 12px;
      text-align: left;
    }
    .calc-title { font-size: 1.35rem; margin-bottom: 0.4rem; }
    .calc-sub { color: var(--text-secondary); font-size: 0.92rem; margin-bottom: 1.5rem; }
    .calc-controls { display: grid; grid-template-columns: 1fr 1fr; gap: 1.5rem; align-items: start; }
    .calc-field label { display: block; font-size: 0.9rem; font-weight: 600; margin-bottom: 0.5rem; }
    .calc-field input[type="range"] { width: 100%; accent-color: var(--accent); }
    .calc-field output { color: var(--accent); font-variant-numeric: tabular-nums; }
    .calc-tiers { border: 0; padding: 0; margin: 0; }
    .calc-tiers legend { font-size: 0.9rem; font-weight: 600; margin-bottom: 0.5rem; padding: 0; }
    .calc-tiers label { font-weight: 400; font-size: 0.9rem; margin-bottom: 0.35rem; cursor: pointer; }
    .calc-tiers input { accent-color: var(--accent); margin-right: 0.4rem; }
    .calc-out { margin-top: 1.75rem; border-top: 1px solid var(--border); padding-top: 1.25rem; }
    .calc-row { display: flex; justify-content: space-between; align-items: baseline; padding: 0.5rem 0; }
    .calc-row-us { font-weight: 700; }
    .calc-row-us .calc-price { color: var(--accent); font-size: 1.4rem; }
    .calc-name { font-size: 0.95rem; }
    .calc-rate { color: var(--text-muted); font-size: 0.8rem; font-weight: 400; }
    .calc-price { font-variant-numeric: tabular-nums; }
    .calc-saving { margin-top: 0.9rem; font-weight: 600; color: var(--accent); }
    .calc-caveat { margin-top: 0.6rem; font-size: 0.82rem; color: var(--text-secondary); }
    .calc-note { margin-top: 1.25rem; font-size: 0.78rem; color: var(--text-muted); line-height: 1.6; }

    /* --- PAA answers (C) --- */
    .answers-section { padding: 5rem 2rem; }
    .answers-container { max-width: 800px; margin: 0 auto; }
    .answers-container h2 { text-align: center; font-size: 2rem; margin-bottom: 2rem; }
    .answers-section .faq-item { padding: 1.5rem; }
    .answers-section .faq-question {
      display: block; padding: 0; cursor: default; font-size: 1.1rem;
      font-weight: 700; margin-bottom: 0.6rem;
    }
    .answers-section .faq-question:hover { background: none; }
    .answers-section .faq-answer { display: block; padding: 0; }
    .answers-section .faq-answer p { margin-bottom: 0.85rem; }
    .answers-section .faq-answer p:last-child { margin-bottom: 0; }
    .answers-updated { text-align: center; font-size: 0.8rem; color: var(--text-muted); margin-top: 2rem; }

    @media (max-width: 720px) {
      .compare-section, .blocks-section, .answers-section { padding: 3.5rem 1.25rem; }
      .table-hint { display: block; }
      .calc { padding: 1.25rem; }
      .calc-controls { grid-template-columns: 1fr; gap: 1.25rem; }
      .hero-deck { font-size: 1.05rem; }
    }
  </style>
</head>
<body>
  <a href="#main-content" class="skip-link">Skip to main content</a>
  <!-- Google Tag Manager (noscript) -->
