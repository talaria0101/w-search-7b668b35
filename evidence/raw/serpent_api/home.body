      <!-- Volume -> cost calculator -->
      <div class="calc" id="calc">
        <h3 class="calc-title">Compare usage and funding</h3>
        <p class="calc-sub">Move the slider. Serpent shows metered credit use, Serper shows credit allocated from a prepaid pack, and SerpApi shows a monthly plan bill. The upfront amounts appear alongside the rates.</p>

        <div class="calc-controls">
          <div class="calc-field">
            <label for="calcVolume">Web searches per month: <output id="calcVolumeOut">50,000</output></label>
            <input type="range" id="calcVolume" min="0" max="11" value="5" step="1">
          </div>
          <fieldset class="calc-field calc-tiers">
            <legend>Your Serpent tier</legend>
            <label><input type="radio" name="calcTier" value="default"> Default &mdash; no deposit</label>
            <label><input type="radio" name="calcTier" value="tier1" checked> Growth &mdash; $100 once</label>
            <label><input type="radio" name="calcTier" value="tier2"> Scale &mdash; $500 once</label>
            <label><input type="radio" name="calcTier" value="tier3"> Enterprise &mdash; $1,000 once</label>
          </fieldset>
        </div>

        <div class="calc-out">
          <div class="calc-row calc-row-us">
            <span class="calc-name">Serpent API <span class="calc-rate">metered credit use</span></span>
            <span class="calc-price" id="calcUs">$15.00</span>
          </div>
          <div class="calc-row">
            <span class="calc-name">Serper <span class="calc-rate" id="calcSerperPlan">Standard pack, $375 upfront</span></span>
            <span class="calc-price" id="calcSerper">$37.50</span>
          </div>
          <div class="calc-row">
            <span class="calc-name">SerpApi <span class="calc-rate" id="calcSerpapiPlan">Searcher monthly plan, 100,000 searches</span></span>
            <span class="calc-price" id="calcSerpapi">$725.00</span>
          </div>
          <p class="calc-saving" role="status" aria-live="polite" id="calcSaving">Serpent credit use $15.00; SerpApi monthly bill $725.00. Upfront funding differs.</p>
        </div>
        <p class="calc-note">Serpent web rates: $0.60 per 1,000 units on Default, $0.30 on Growth, $0.10 on Scale, and $0.03 on Enterprise. Quick Search is one unit per call however deep the call, up to 100 organic results in a single charge; Deep Search bills one unit per page requested, up to 10 pages, at every tier and every balance. Serpent's figure is credit use after the qualifying deposit shown above; that deposit remains spendable. SerpApi's figure is the smallest whole monthly plan bill that covers your volume. Serper's figure is allocated credit use at the rate of an illustrative pack chosen to cover six months of searches (or repeated top packs at higher volumes), while the label shows that purchase upfront. A different pack combination may require less upfront cash. These figures answer different cash-flow questions. Rival pricing read 10 September 2026 &mdash; SerpApi from <a href="https://serpapi.com/pricing" rel="nofollow noopener" target="_blank">their pricing page</a>, Serper from its <a href="https://serper.dev/" rel="nofollow noopener" target="_blank">public homepage</a>, checked 6 October 2026.</p>
      </div>
    </section>
    <script>
      /* Volume -> cost calculator.
         Serpent web rates come from the same table the API bills from
         (user.service.js CATEGORY_PRICES x TIER_DISCOUNTS): $0.60 / $0.30 / $0.10 / $0.03 per 1,000.
         Rivals are priced on the plan/pack a buyer would actually be on at the chosen volume —
         a single "cheapest published rate" would overstate SerpApi below 54M searches and
         understate Serper below 12.5M credits. Read 20 Aug 2026:
           SerpApi  — serpapi.com/pricing (subscription: you pay the plan price)
           Serper   — serper.dev (public prepaid packs, valid 6 months; checked 6 Oct 2026) */
      (function () {
        var VOLUMES = [1000, 2500, 5000, 10000, 25000, 50000,
                       100000, 250000, 500000, 1000000, 2500000, 5000000];
        var US = { 'default': 0.60, tier1: 0.30, tier2: 0.10, tier3: 0.03 };
        // [searches included, monthly price, plan name]
        var SERPAPI = [[1000, 25, 'Starter'], [5000, 75, 'Developer'], [15000, 150, 'Production'],
                       [30000, 275, 'Big Data'], [100000, 725, 'Searcher'], [250000, 1475, 'Volume'],
                       [500000, 2750, 'Infrastructure'], [1000000, 3750, 'Cloud 1M'],
                       [2000000, 5675, 'Cloud 2M'], [3000000, 7600, 'Cloud 3M'],
                       [4000000, 9550, 'Cloud 4M'], [5000000, 11475, 'Cloud 5M']];
        // [credits in pack, per-1K rate, pack name] — a pack is valid for 6 months.
        var SERPER = [[50000, 1.00, 'Starter'], [500000, 0.75, 'Standard'],
                      [2500000, 0.50, 'Scale'], [12500000, 0.30, 'Ultimate']];

        var slider = document.getElementById('calcVolume');
        if (!slider) return;
        var volOut = document.getElementById('calcVolumeOut');
        var outUs = document.getElementById('calcUs');
        var outSerper = document.getElementById('calcSerper');
        var outSerperPlan = document.getElementById('calcSerperPlan');
        var outSerpapi = document.getElementById('calcSerpapi');
        var outSerpapiPlan = document.getElementById('calcSerpapiPlan');
        var outSaving = document.getElementById('calcSaving');
        var tiers = document.querySelectorAll('input[name="calcTier"]');
        var savingTimer = null;

        function money(n) {
          return '$' + n.toLocaleString('en-US', { minimumFractionDigits: 2, maximumFractionDigits: 2 });
        }
        function tier() {
          for (var i = 0; i < tiers.length; i++) if (tiers[i].checked) return tiers[i].value;
          return 'tier1';
        }
        function serpapiPlan(vol) {
          for (var i = 0; i < SERPAPI.length; i++) if (vol <= SERPAPI[i][0]) return SERPAPI[i];
          return SERPAPI[SERPAPI.length - 1];   // above the published ladder: quote the top plan
        }
        function serperPack(vol) {
          var sixMonths = vol * 6;
          for (var i = 0; i < SERPER.length; i++) if (sixMonths <= SERPER[i][0]) return SERPER[i];
          return SERPER[SERPER.length - 1];     // above the largest pack: buy several at that rate
        }
        function render() {
          var vol = VOLUMES[Math.max(0, Math.min(VOLUMES.length - 1, Number(slider.value)))];
          var us = vol / 1000 * US[tier()];
          var pack = serperPack(vol);
          var serper = vol / 1000 * pack[1];
          var packCount = Math.ceil(vol * 6 / pack[0]);
          var packCash = packCount * pack[0] / 1000 * pack[1];
          var plan = serpapiPlan(vol);
          var serpapi = plan[1];

          volOut.textContent = vol.toLocaleString('en-US');
          slider.setAttribute('aria-valuetext', vol.toLocaleString('en-US') + ' searches per month');
          outUs.textContent = money(us);
          outSerper.textContent = money(serper);
          outSerperPlan.textContent = pack[2] + (packCount > 1 ? ' packs, ' : ' pack, ') + money(packCash) + ' upfront';
          outSerpapi.textContent = money(serpapi);
          outSerpapiPlan.textContent = plan[2] + ' monthly plan, ' + plan[0].toLocaleString('en-US') + ' searches';

          // The live region is on the saving line only, and is debounced — updating it on every
          // slider tick makes a screen reader read four lines per pixel of drag.
          clearTimeout(savingTimer);
          savingTimer = setTimeout(function () {
            outSaving.textContent = 'Serpent credit use ' + money(us) + '; SerpApi monthly bill ' + money(serpapi) + '. Upfront funding differs.';
          }, 250);
        }
        slider.addEventListener('input', render);
        for (var i = 0; i < tiers.length; i++) tiers[i].addEventListener('change', render);
        render();
      })();
    </script>

    <!-- Direct answers to the questions Google shows for this query -->
    <section class="answers-section" id="answers">
      <div class="answers-container">
        <h2>SERP API Questions, Answered Straight</h2>

        <article class="faq-item">
          <h3 class="faq-question">Can I use SERP API for free?</h3>
          <div class="faq-answer">
            <p>Yes, up to a point. Serpent API gives every new account free calls shared across every endpoint, with no credit card. Serper gives 2,500 free queries, Bright Data 5,000 a month, Oxylabs 2,000 results, SerpApi 250 searches a month and Scrapingdog 200 credits, which is about 40 Google searches. No SERP API is free forever at production volume, because every provider pays real infrastructure cost on each request. Free tiers are for evaluation, so the question that matters is what the first paid call costs.</p>
            <p>For context on the paid side: at our Scale rate, Bright Data's entire 5,000-search monthly free tier would cost you 50 cents on Scale, or 15 cents on Enterprise.</p>
          </div>
        </article>

        <article class="faq-item">
          <h3 class="faq-question">Which API is the cheapest?</h3>
          <div class="faq-answer">
            <p class="compare-sources">By published rates read on 10 September 2026, Serpent API is the cheapest SERP API at $0.03 per 1,000 calls on the Enterprise tier, reached with one $1,000 deposit. Ranked by the best rate each vendor publishes, the rest run Scrapingdog $0.14, Serper $0.30, Oxylabs $0.50, DataForSEO $0.60, Bright Data $1.30 and SerpApi $1.96. Those floors are not equally reachable, though. Oxylabs' $0.50 sits on a quote-only Custom+ tier, Serper's $0.30 needs a $3,750 credit purchase and SerpApi's $1.96 a $106,050 plan, so compare entry prices too if you are not yet at that volume.</p>
          </div>
        </article>

        <article class="faq-item">
          <h3 class="faq-question">How expensive is SERP API?</h3>
          <div class="faq-answer">
            <p>It depends on the vendor and the unit. Entry prices across the six providers we track run from $0.60 to $25.00 per 1,000 searches. Serpent API starts at $0.60 per 1,000 Web units on Default. Paid credit starts with a $10 minimum deposit; after lifetime deposits reach $50, further top-ups have a $100 minimum. The Web rate drops to $0.30 after a one-time $100 deposit and to $0.10 after a one-time $500 deposit, or $0.03 after a one-time $1,000 Enterprise deposit. Existing credit keeps its original price schedule, while new deposits use the current schedule; deposited credit does not expire. Refunded or charged-back amounts don't count toward your tier. Watch the unit as well as the price: on Deep Search a page of 10 results is the unit, so 100 results costs ten times a single-page call.</p>
            <p>A worked example at one million single-page searches a month. That is $100 on our Scale tier or $30 on our Enterprise tier; for 10-page Deep requests targeting up to 100 results each, it is $1,000 on Scale or $300 on Enterprise. Serper's largest pack rate allocates $300 of credit use per month after a $3,750 pack purchase; SerpApi's Cloud 1M monthly plan bills $3,750.</p>
          </div>
        </article>

        <article class="faq-item">
          <h3 class="faq-question">Is there a free version of Serper?</h3>
          <div class="faq-answer">
            <p>Serper offers 2,500 free queries with no credit card required, which is one of the larger free tiers in this category. After that it sells prepaid credit packs running from about $1.00 per 1,000 queries down to $0.30 per 1,000 on the 12.5 million credit pack, and credits expire six months after purchase. Serper publishes no AI Overview endpoint. If you need AI Overview data or a rate below $0.30, free tier size is not the number to compare on.</p>
          </div>
        </article>

        <p class="answers-updated">Prices and free tiers on this page were last verified on <time datetime="2026-09-10">10 September 2026</time>.</p>
      </div>
    </section>

    <!-- FAQ -->
    <section class="faq-section" id="faq">
      <div class="faq-container">
        <h2>Frequently Asked Questions</h2>

        <article class="faq-item">
          <button class="faq-question" type="button" aria-expanded="false" onclick="toggleFaq(this)">
            <span>What is Serpent API?</span>
            <svg aria-hidden="true" width="16" height="16" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/>
            </svg>
          </button>
          <div class="faq-answer">
            <p>Serpent API provides search results from Google, Bing, Yahoo, DuckDuckGo and Brave, AI mention tracking across ChatGPT, Claude, Gemini and Perplexity, plus YouTube, Instagram and LinkedIn data APIs. All in one platform with simple JSON responses.</p>
          </div>
        </article>

        <article class="faq-item">
          <button class="faq-question" type="button" aria-expanded="false" onclick="toggleFaq(this)">
            <span>Is Serpent API free?</span>
            <svg aria-hidden="true" width="16" height="16" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/>
            </svg>
          </button>
          <div class="faq-answer">
            <p>Every new account gets shared free calls on eligible endpoints. No credit card required. After that, web is $0.60/1K Web units Default, $0.30/1K units with one $100 deposit, or $0.10/1K units with a one-time $500 deposit, or $0.03/1K units with a one-time $1,000 Enterprise deposit (20× off) — with one Web unit per Quick call and one per requested Deep page.</p>
          </div>
        </article>

        <article class="faq-item">
          <button class="faq-question" type="button" aria-expanded="false" onclick="toggleFaq(this)">
            <span>How much does Serpent API cost?</span>
            <svg aria-hidden="true" width="16" height="16" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/>
            </svg>
          </button>
          <div class="faq-answer">
            <p>Pay-as-you-go pricing. Web requests are $0.60/1K Default, $0.30/1K with one $100 deposit, or $0.10/1K with a one-time $500 deposit, or $0.03/1K with a one-time $1,000 Enterprise deposit. News is $0.20/$0.02/$0.01 per 1K, Images are $0.35/$0.32/$0.25 per 1K, and Videos are $0.10/$0.09/$0.07 per 1K. New accounts get shared free calls on eligible endpoints.</p>
          </div>
        </article>

        <article class="faq-item">
          <button class="faq-question" type="button" aria-expanded="false" onclick="toggleFaq(this)">
            <span>Which search engines are supported?</span>
            <svg aria-hidden="true" width="16" height="16" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/>
            </svg>
          </button>
          <div class="faq-answer">
            <p>Serpent API supports five search engines: Google (default), Bing, Yahoo, DuckDuckGo, and Brave. You can choose which search engine to use for each API request using a simple <code>engine</code> parameter. Access web, news, and image search results from all five search engines through a single unified API.</p>
          </div>
        </article>

        <article class="faq-item">
          <button class="faq-question" type="button" aria-expanded="false" onclick="toggleFaq(this)">
            <span>How do I get started?</span>
            <svg aria-hidden="true" width="16" height="16" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/>
            </svg>
          </button>
          <div class="faq-answer">
            <p>Getting started is easy: 1) Sign up with your Google account, 2) Get your API key from the dashboard, 3) Start making API requests. You will receive shared free calls on eligible endpoints upon registration -- no credit card required.</p>
          </div>
        </article>

        <article class="faq-item">
          <button class="faq-question" type="button" aria-expanded="false" onclick="toggleFaq(this)">
            <span>How many search results can I get per query?</span>
            <svg aria-hidden="true" width="16" height="16" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/>
            </svg>
          </button>
          <div class="faq-answer">
            <p>Serpent API returns up to 100 organic search results per query, along with related searches, People Also Ask questions, and featured snippets when available.</p>
          </div>
        </article>
      </div>
    </section>

