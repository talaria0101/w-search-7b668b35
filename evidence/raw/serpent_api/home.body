    </section>
    <style>
/* ── showcase tokens, scoped to the band so :root keeps the site palette ── */
.serp-showcase-band{
  --json-bg:#f8fafc; --json-gutter:#eef2f6;
  --j-key:#0f766e; --j-str:#9a3412; --j-num:#1d4ed8; --j-bool:#7c3aed; --j-null:#9ca3af; --j-punct:#9ca3af;
  --hl-bg:rgba(13,148,136,0.14); --hl-ring:rgba(13,148,136,0.45); --hl-bar:#0f8378;
  --shadow-lg:0 24px 60px -24px rgba(15,23,42,0.28), 0 2px 8px rgba(15,23,42,0.06);
  --dw:1041; --dh:800; --fit:1;
  /* vendor font stacks — honest fallbacks, zero network requests */
  --f-gs:'Google Sans','Google Sans Text','Product Sans',Roboto,Arial,sans-serif;
  --f-ar:Arial,'Helvetica Neue',Helvetica,sans-serif;
  --f-ps:'pplxSerif',Georgia,'Times New Roman',serif;
  --f-pp:'FK Grotesk','Inter',-apple-system,'Segoe UI',sans-serif;
  --f-og:'Söhne','Segoe UI',ui-sans-serif,system-ui,-apple-system,sans-serif;
  --f-cl:'Styrene B','Copernicus',ui-sans-serif,system-ui,-apple-system,sans-serif;
  --f-ig:-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,Helvetica,Arial,sans-serif;
  /* ── Google ── */
  --g-bg:#ffffff; --g-text:#0a0a0a; --g-text2:#56595e; --g-link:#0b57d0; --g-visit:#681da8;
  --g-border:#e1e3e8; --g-chip:#f0f2f5; --g-green:#188038; --g-sk:#e3e6ea; --g-tabsel:#0b57d0;
  /* ── Google Maps ── */
  --m-panel:#ffffff; --m-land:#eceae4; --m-water:#a3ccff; --m-park:#c6e3c4;
  --m-road:#ffffff; --m-casing:#dedad2; --m-block:#f7f6f3; --m-pin:#ea4335;
  /* ── Perplexity ── */
  --p-bg:#fcfcf9; --p-text:#13343b; --p-text2:#64645f; --p-border:#e8e8e3; --p-accent:#20808d; --p-sk:#e7e7e1;
  /* ── ChatGPT ── */
  --o-bg:#ffffff; --o-text:#0d0d0d; --o-text2:#5d5d5d; --o-border:#e5e5e5; --o-accent:#0d8f6f; --o-sk:#ececec;
  /* ── Claude ── */
  --c-bg:#faf9f5; --c-text:#141413; --c-text2:#6b6a65; --c-border:#e5e3dc; --c-accent:#c96442; --c-sk:#eceae1;
  /* ── Instagram ── */
  --i-bg:#ffffff; --i-text:#000000; --i-text2:#737373; --i-border:#dbdbdb; --i-blue:#0095f6;
  --i-link:#00376b; --i-sk:#efefef;
}
[data-theme="dark"] .serp-showcase-band{
  --json-bg:#080808; --json-gutter:#111111;
  --j-key:#2dd4bf; --j-str:#f0b072; --j-num:#8ab4f8; --j-bool:#c4a1ff; --j-null:#555555; --j-punct:#555555;
  --hl-bg:rgba(20,184,166,0.18); --hl-ring:rgba(20,184,166,0.55); --hl-bar:#2dd4bf;
  --shadow-lg:0 24px 60px -30px rgba(0,0,0,0.9);
  --g-bg:#1f1f1f; --g-text:#e8e8e8; --g-text2:#9e9e9e; --g-link:#99c3ff; --g-visit:#c58af9;
  --g-border:#3c4043; --g-chip:#2d2f31; --g-green:#6dd58c; --g-sk:#3a3d40; --g-tabsel:#8ab4f8;
  --m-panel:#232426; --m-land:#1f2022; --m-water:#17263c; --m-park:#1e2b21;
  --m-road:#3c4043; --m-casing:#4a4d50; --m-block:#2a2b2d; --m-pin:#f28b82;
  --p-bg:#191a1a; --p-text:#e8e8e6; --p-text2:#8f9192; --p-border:#2b2c2c; --p-accent:#20b8cd; --p-sk:#2f3131;
  --o-bg:#212121; --o-text:#ececec; --o-text2:#9b9b9b; --o-border:#333333; --o-accent:#3ec8a0; --o-sk:#333333;
  --c-bg:#262624; --c-text:#f0eee6; --c-text2:#9a9890; --c-border:#3a3937; --c-accent:#e08a68; --c-sk:#37362f;
  --i-bg:#000000; --i-text:#f5f5f5; --i-text2:#a8a8a8; --i-border:#262626; --i-blue:#0095f6;
  --i-link:#e0f1ff; --i-sk:#1f1f1f;
}
.serp-showcase-band{padding:2rem 0 3.5rem;background:var(--bg-secondary)}
.ssb-inner{max-width:1440px;margin:0 auto;padding:0 1.5rem}
.ssb-h{font-size:clamp(1.5rem,3vw,2.1rem);line-height:1.2;letter-spacing:-0.02em;text-align:center}
.ssb-deck{margin:0.75rem auto 0;max-width:62ch;text-align:center;color:var(--text-secondary);
  font-size:1rem;line-height:1.6;text-wrap:balance}
.serp-showcase-band .showcase{margin-top:1.75rem}
.serp-showcase-band :focus-visible{outline:2px solid var(--accent);outline-offset:2px;border-radius:6px}
.serp-showcase-band *{box-sizing:border-box}

/* ── showcase shell (Serpent-branded, ships as-is) ─────────────── */
.showcase{margin-top:32px;background:var(--bg-card);border:1px solid var(--border);
  border-radius:22px;box-shadow:var(--shadow-lg);overflow:hidden}
.sc-tabs{display:flex;gap:4px;overflow-x:auto;padding:10px 12px;border-bottom:1px solid var(--border);
  background:linear-gradient(180deg,var(--bg-secondary),var(--bg-card));scrollbar-width:none}
.sc-tabs::-webkit-scrollbar{display:none}
.sc-tab{flex:0 0 auto;display:inline-flex;align-items:center;gap:8px;height:34px;padding:0 13px;
  border:1px solid transparent;border-radius:999px;background:none;color:var(--text-secondary);
  font:inherit;font-size:13px;font-weight:500;cursor:pointer;white-space:nowrap;transition:all .18s}
.sc-tab:hover{color:var(--text-primary);background:var(--bg-card-hover)}
.sc-tab[aria-current="true"]{color:var(--accent);background:var(--accent-dim);border-color:var(--accent-glow)}
.sc-tab .ep{font-family:'Monaco','Menlo',monospace;font-size:11px;opacity:.72}
.sc-tab img{width:15px;height:15px;object-fit:contain;flex:0 0 15px}

.sc-stage{position:relative}
.slide{display:grid;grid-template-columns:minmax(0,1.55fr) minmax(0,1fr);min-height:0}
.slide + .slide{border-top:1px solid var(--border)}
.sc-stage.js-on{display:grid}
.sc-stage.js-on .slide{grid-area:1/1;opacity:0;visibility:hidden;pointer-events:none;
  transition:opacity .42s ease}
.sc-stage.js-on .slide + .slide{border-top:0}
.sc-stage.js-on .slide.is-active{opacity:1;visibility:visible;pointer-events:auto}
.sc-stage.js-on .slide.is-active .pane-serp>*{animation:rise .5s cubic-bezier(.2,.7,.3,1) both}
@keyframes rise{from{opacity:0;transform:translateY(10px)}to{opacity:1;transform:none}}
.pane{min-width:0;min-height:0}
.pane-serp{padding:24px 24px 20px;border-right:1px solid var(--border);background:var(--bg-secondary)}
.pane-json{background:var(--json-bg);display:flex;flex-direction:column;min-height:0}

/* ── the shared frame ──────────────────────────────────────────────
   .sc-viewport is fluid; .frame is a fixed 1041 × --dh design canvas
   scaled by `zoom`. zoom (not transform:scale) because it affects
   layout — so hit-testing, scrolling and getBoundingClientRect (the
   sync engine) all keep working at spec-accurate CSS values.        */
.sc-viewport{width:100%;overflow-x:auto;overflow-y:hidden;border-radius:14px;
  scrollbar-width:thin;scrollbar-color:var(--border-light) transparent;
  box-shadow:0 1px 2px rgba(15,23,42,.08),0 10px 30px -18px rgba(15,23,42,.35)}
[data-theme="dark"] .sc-viewport{box-shadow:0 1px 2px rgba(0,0,0,.6),0 10px 30px -18px rgba(0,0,0,.9)}
.sc-viewport::-webkit-scrollbar{height:8px}
.sc-viewport::-webkit-scrollbar-thumb{background:var(--border-light);border-radius:99px;
  border:2px solid transparent;background-clip:content-box}
.sc-viewport::-webkit-scrollbar-track{background:transparent}
.frame{width:calc(var(--dw) * 1px);height:calc(var(--dh) * 1px);zoom:var(--fit);
  overflow:hidden;position:relative;display:flex;flex-direction:column}

/* skeleton bars: soft, static, content-shaped. No shimmer — a shimmer
   reads as "still loading"; these mean "text lives in the JSON". */
.sk{display:block;border-radius:5px;background:var(--sk,#e3e6ea);height:10px;margin:7px 0}
.sk.w95{width:95%}.sk.w88{width:88%}.sk.w76{width:76%}.sk.w64{width:64%}.sk.w52{width:52%}
.sk.w42{width:42%}.sk.w34{width:34%}.sk.w26{width:26%}
.skw{display:inline-block;vertical-align:middle;border-radius:5px;background:var(--sk,#e3e6ea);height:9px}

/* ═══ GOOGLE ═══════════════════════════════════════════════════════ */
.g{background:var(--g-bg);color:var(--g-text);font-family:var(--f-ar);--sk:var(--g-sk);
  height:100%;display:flex;flex-direction:column}
.g-top{display:flex;align-items:center;padding:16px 20px 0 0}
.g-logo{width:160px;padding-left:28px;display:flex;align-items:center}
.g-logo img{width:30px;height:30px}
.g-box{width:861px;height:52px;border:1px solid var(--g-border);border-radius:26px;display:flex;
  align-items:center;gap:14px;padding:0 20px;box-shadow:0 1px 6px rgba(32,33,36,.06)}
[data-theme="dark"] .g-box{box-shadow:none;background:#2d2f31;border-color:#2d2f31}
.g-q{font-family:var(--f-ar);font-size:16px;color:var(--g-text);flex:1;white-space:nowrap;overflow:hidden}
.g-tabs{display:flex;align-items:stretch;gap:32px;height:48px;padding-left:160px;margin-top:14px;
  border-bottom:1px solid var(--g-border)}
.g-tab{display:flex;align-items:center;font-family:var(--f-gs);font-size:14px;font-weight:500;
  line-height:1;color:var(--g-text2);border-bottom:3px solid transparent;white-space:nowrap}
.g-tab svg{flex:0 0 16px;width:16px;height:16px}
.g-tab.on{color:var(--g-tabsel);border-bottom-color:var(--g-tabsel)}
.g-tab.aim{gap:6px}
.g-body{flex:1;padding:18px 20px 0 160px;overflow:hidden}
.g-col{width:652px}

.aio{margin-bottom:16px}
.aio-h{display:flex;align-items:center;gap:9px;font-family:var(--f-gs);font-size:14px;font-weight:500;
  color:var(--g-text);margin-bottom:12px}
.aio-t{font-family:var(--f-gs);font-size:16px;line-height:24px;color:var(--g-text)}
.aio-t b{font-weight:600}
.aio-src{margin-top:12px}
.aio-lab{font-family:var(--f-gs);font-size:12px;font-weight:500;color:var(--g-text2);margin-bottom:9px}
.chips{display:flex;flex-wrap:wrap;gap:8px}
.chip{display:inline-flex;align-items:center;gap:7px;height:30px;padding:0 12px 0 8px;
  border:1px solid var(--g-border);border-radius:999px;font-family:var(--f-ar);font-size:12px;
  color:var(--g-text2);cursor:pointer}
.chip:hover{border-color:var(--g-text2)}
.aio-more{display:inline-flex;align-items:center;gap:8px;height:34px;padding:0 16px;margin-top:10px;
  border:1px solid var(--g-border);border-radius:999px;font-family:var(--f-gs);font-size:14px;
  color:var(--g-link);cursor:pointer}
.g-rule{height:1px;background:var(--g-border);margin:0 0 16px}

.res{margin-bottom:16px}
.res-head{display:flex;align-items:center;gap:12px;margin-bottom:4px}
.res-site{font-family:var(--f-gs);font-size:14px;line-height:20px;color:var(--g-text)}
.res-cite{font-family:var(--f-ar);font-size:12px;line-height:18px;color:var(--g-text2)}
.res-title{display:block;font-family:var(--f-gs);font-size:22px;line-height:28px;font-weight:400;
  color:var(--g-link);letter-spacing:0;margin-bottom:4px;cursor:pointer;max-width:600px}
.res-title:hover{text-decoration:underline}
.res-snip{max-width:600px}
.rel-h{font-family:var(--f-gs);font-size:20px;line-height:28px;font-weight:400;color:var(--g-text);margin:0 0 10px}
.rel{display:grid;grid-template-columns:repeat(2,294px);gap:8px}
.rel-c{display:flex;align-items:center;gap:14px;width:294px;height:60px;padding:12px 16px;
  border:1px solid var(--g-border);border-radius:999px;font-family:var(--f-ar);font-size:14px;
  line-height:20px;color:var(--g-text);cursor:pointer}
.rel-c b{font-weight:700}
.rel-c:hover{background:var(--g-chip)}

/* circular favicons for third-party result sources. Deliberately an
   abstraction (initial on a colour disc), never a redrawn vendor mark. */
.fav{display:inline-flex;align-items:center;justify-content:center;border-radius:50%;color:#fff;
  font-family:var(--f-ar);font-weight:700;flex:0 0 auto;letter-spacing:-.02em}
.f26{width:26px;height:26px;font-size:12px}
.f16{width:16px;height:16px;font-size:8px}
.f14{width:14px;height:14px;font-size:7px}
.favbox{width:28px;height:28px;border:1px solid var(--g-border);border-radius:50%;display:flex;
  align-items:center;justify-content:center;flex:0 0 28px}
.mag{flex:0 0 18px;width:18px;height:18px;position:relative;opacity:.6}
.mag::before{content:"";position:absolute;left:1px;top:1px;width:12px;height:12px;border-radius:50%;
  border:2px solid currentColor}
.mag::after{content:"";position:absolute;right:1px;bottom:1px;width:7px;height:2px;background:currentColor;
  transform:rotate(45deg);border-radius:2px}

/* ═══ GOOGLE MAPS ══════════════════════════════════════════════════ */
.m{display:flex;height:100%;background:var(--m-panel);color:var(--g-text);font-family:var(--f-gs);--sk:var(--g-sk)}
.m-panel{width:408px;flex:0 0 408px;display:flex;flex-direction:column;border-right:1px solid var(--g-border);
  background:var(--m-panel);z-index:2}
.m-search{padding:12px 12px 10px;display:flex;align-items:center;gap:12px}
.m-box{flex:1;height:44px;border-radius:8px;background:var(--m-panel);display:flex;align-items:center;gap:12px;
  padding:0 14px;box-shadow:0 1px 4px rgba(32,33,36,.28)}
[data-theme="dark"] .m-box{box-shadow:none;background:#303134}
.m-box img{width:20px;height:20px}
.m-q{font-family:var(--f-ar);font-size:15px;color:var(--g-text);flex:1;white-space:nowrap;overflow:hidden}
.m-filters{display:flex;gap:8px;padding:0 12px 12px;border-bottom:1px solid var(--g-border)}
.m-f{height:30px;padding:0 13px;border:1px solid var(--g-border);border-radius:999px;display:flex;
  align-items:center;font-size:13px;color:var(--g-text2)}
.m-list{flex:1;overflow:hidden}
.m-card{display:flex;gap:14px;padding:15px 16px;border-bottom:1px solid var(--g-border);cursor:pointer}
.m-card:hover{background:var(--g-chip)}
.m-b{flex:1;min-width:0}
.m-name{font-family:var(--f-gs);font-size:16px;line-height:22px;color:var(--g-link);margin-bottom:2px}
.m-rate{display:flex;align-items:center;gap:5px;font-family:var(--f-ar);font-size:13px;line-height:20px;color:var(--g-text2)}
.m-meta{font-family:var(--f-ar);font-size:13px;line-height:20px;color:var(--g-text2);margin-top:1px}
.m-open{color:var(--g-green)}
.m-attrs{display:flex;flex-wrap:wrap;gap:6px;margin-top:9px}
.m-attr{font-family:'Monaco','Menlo',monospace;font-size:10px;line-height:1;padding:5px 8px;
  border:1px solid var(--g-border);border-radius:6px;color:var(--g-text2)}
.m-thumb{width:84px;height:84px;flex:0 0 84px;border-radius:10px;overflow:hidden;position:relative;
  border:1px solid var(--g-border)}
.m-canvas{flex:1;position:relative;overflow:hidden;background:var(--m-land)}
.m-canvas .road{position:absolute;background:var(--m-road);box-shadow:0 0 0 1px var(--m-casing)}
.m-canvas .park{position:absolute;background:var(--m-park);border-radius:10px}
.m-canvas .water{position:absolute;background:var(--m-water)}
.m-canvas .blk{position:absolute;background:var(--m-block);border-radius:2px}
.m-canvas .diag{position:absolute;background:var(--m-road);box-shadow:0 0 0 1px var(--m-casing);
  transform-origin:0 0}
.pin{position:absolute;width:26px;height:26px;border-radius:50% 50% 50% 2px;background:var(--m-pin);
  transform:rotate(-45deg) translate(-50%,-50%);transform-origin:top left;
  display:flex;align-items:center;justify-content:center;box-shadow:0 3px 8px rgba(0,0,0,.3);cursor:pointer}
.pin span{transform:rotate(45deg);color:#fff;font-family:var(--f-gs);font-size:12px;font-weight:700;line-height:1}
.pin:hover,.pin.hl-left{z-index:5}
.m-counts{position:absolute;left:16px;bottom:16px;display:flex;gap:8px}
.m-count{font-family:'Monaco','Menlo',monospace;font-size:11px;padding:6px 10px;border-radius:8px;
  background:var(--m-panel);color:var(--g-text2);box-shadow:0 1px 4px rgba(32,33,36,.28)}
.m-count b{color:var(--g-text);font-weight:700}

/* ═══ AI ANSWERS — three stacked full-width engine rows ════════════ */
.airank{height:100%;display:flex;flex-direction:column;background:var(--bg-secondary);
  font-family:var(--f-pp);--sk:var(--border)}
.ai-bar{display:flex;align-items:center;gap:14px;padding:0 26px;height:78px;flex:0 0 78px;
  border-bottom:1px solid var(--border);background:var(--bg-card)}
.ai-kw{display:flex;align-items:center;gap:10px;font-size:15px;font-weight:600;color:var(--text-primary)}
.ai-kw .mag{color:var(--text-muted)}
.ai-dom{font-family:'Monaco','Menlo',monospace;font-size:12px;color:var(--text-secondary);
  border:1px solid var(--border);border-radius:999px;padding:5px 11px}
.ai-spacer{flex:1}
.ai-score{display:flex;align-items:center;gap:10px}
.ai-score .lab{font-size:10.5px;letter-spacing:.09em;text-transform:uppercase;font-weight:700;color:var(--text-muted)}
.meter{width:120px;height:6px;border-radius:999px;background:var(--border);overflow:hidden}
.meter i{display:block;height:100%;border-radius:999px;background:linear-gradient(90deg,var(--accent),var(--accent-light))}
.ai-score .val{font-family:'Monaco','Menlo',monospace;font-size:14px;font-weight:700;color:var(--accent)}
.ai-rows{flex:1;display:flex;flex-direction:column;gap:1px;background:var(--border);overflow:hidden}
.ai-row{flex:1;padding:18px 26px;display:flex;flex-direction:column;min-height:0}
.ai-rh{display:flex;align-items:center;gap:10px;margin-bottom:11px}
.ai-rh img{width:20px;height:20px;object-fit:contain;flex:0 0 20px}
.ai-name{font-size:14.5px;font-weight:600}
.ai-model{font-family:'Monaco','Menlo',monospace;font-size:11px;padding:3px 8px;border-radius:6px}
.ai-rh .rspacer{flex:1}
.ai-hit{display:inline-flex;align-items:center;gap:6px;font-size:11.5px;font-weight:600;
  padding:4px 10px;border-radius:999px}
.ai-lat{font-family:'Monaco','Menlo',monospace;font-size:11px}
.ai-txt{font-size:16px;line-height:26px;flex:1;min-height:0}
.ai-cits{display:flex;flex-wrap:wrap;gap:7px;margin-top:11px}
.cit{display:inline-flex;align-items:center;gap:6px;height:26px;padding:0 10px 0 7px;border-radius:999px;
  font-size:11.5px;cursor:pointer}

.ai-row.p{background:var(--p-bg);color:var(--p-text);--sk:var(--p-sk)}
.ai-row.p .ai-name{font-family:var(--f-pp)}
.ai-row.p .ai-txt{font-family:var(--f-ps);font-weight:370;color:var(--p-text)}
.ai-row.p .ai-model{background:rgba(32,128,141,.10);color:var(--p-accent)}
.ai-row.p .cit{border:1px solid var(--p-border);color:var(--p-text2)}
.ai-row.p .ai-hit{background:rgba(32,128,141,.12);color:var(--p-accent)}
.ai-row.p .ai-lat{color:var(--p-text2)}

.ai-row.o{background:var(--o-bg);color:var(--o-text);--sk:var(--o-sk)}
.ai-row.o .ai-name,.ai-row.o .ai-txt{font-family:var(--f-og)}
.ai-row.o .ai-txt{line-height:28px;font-size:15.5px}
.ai-row.o .ai-model{background:rgba(13,143,111,.10);color:var(--o-accent)}
.ai-row.o .cit{border:1px solid var(--o-border);color:var(--o-text2)}
.ai-row.o .ai-hit{background:rgba(13,143,111,.12);color:var(--o-accent)}
.ai-row.o .ai-lat{color:var(--o-text2)}

.ai-row.c{background:var(--c-bg);color:var(--c-text);--sk:var(--c-sk)}
.ai-row.c .ai-name,.ai-row.c .ai-txt{font-family:var(--f-cl)}
.ai-row.c .ai-model{background:rgba(201,100,66,.10);color:var(--c-accent)}
.ai-row.c .cit{border:1px solid var(--c-border);color:var(--c-text2)}
.ai-row.c .ai-hit{background:rgba(201,100,66,.12);color:var(--c-accent)}
.ai-row.c .ai-lat{color:var(--c-text2)}
/* the Anthropic mark is solid #191919 — invert it, and only it, on dark */
[data-theme="dark"] .ai-row.c .ai-rh img{filter:invert(1)}

/* ═══ INSTAGRAM ════════════════════════════════════════════════════ */
.ig{height:100%;background:var(--i-bg);color:var(--i-text);font-family:var(--f-ig);--sk:var(--i-sk);
  display:flex;flex-direction:column;position:relative}
.ig-top{height:56px;flex:0 0 56px;border-bottom:1px solid var(--i-border);display:flex;align-items:center;
  gap:20px;padding:0 53px}
.ig-top img.mark{width:26px;height:26px}
.ig-top .word{font-size:19px;font-weight:600;letter-spacing:-.01em}
.ig-search{width:268px;height:36px;border-radius:8px;background:var(--i-sk);display:flex;align-items:center;
  gap:10px;padding:0 14px;font-size:14px;color:var(--i-text2)}
.ig-top .sp{flex:1}
.ig-heart-o{width:22px;height:20px;position:relative;opacity:.85}
.ig-heart-o::before,.ig-heart-o::after{content:"";position:absolute;top:1px;width:11px;height:16px;
  border:2px solid var(--i-text);border-radius:11px 11px 0 0;border-bottom:0}
.ig-heart-o::before{left:11px;transform:rotate(45deg);transform-origin:0 100%}
.ig-heart-o::after{left:11px;transform:rotate(-45deg);transform-origin:100% 100%}
.ig-avatar-o{width:24px;height:24px;border-radius:50%;overflow:hidden;position:relative;
  box-shadow:0 0 0 1.5px var(--i-border)}
.ig-main{padding:26px 53px 0;flex:1;min-height:0}
.ig-head{display:flex;gap:56px;padding-bottom:22px}
.ig-av{width:120px;height:120px;flex:0 0 120px;border-radius:50%;overflow:hidden;position:relative;
  box-shadow:0 0 0 3px var(--i-bg),0 0 0 5px #d62976}
.ig-hb{flex:1;min-width:0;padding-top:4px}
.ig-hrow{display:flex;align-items:center;gap:14px;margin-bottom:16px}
.ig-user{font-size:20px;font-weight:400;letter-spacing:.2px}
.ig-verif{width:17px;height:17px;border-radius:50%;background:var(--i-blue);display:inline-flex;
  align-items:center;justify-content:center;color:#fff;font-size:10px;line-height:1;font-weight:700}
.ig-btn{height:32px;padding:0 17px;border-radius:8px;background:var(--i-sk);color:var(--i-text);
  font-size:14px;font-weight:600;display:inline-flex;align-items:center}
.ig-btn.pri{background:var(--i-blue);color:#fff}
.ig-stats{display:flex;gap:40px;margin-bottom:14px;font-size:16px}
.ig-stat b{font-weight:600}
.ig-stat span{color:var(--i-text)}
.ig-full{font-size:14px;font-weight:600;line-height:20px}
.ig-bio{font-size:14px;line-height:20px;max-width:420px;margin-top:2px}
.ig-cat{font-size:14px;line-height:20px;color:var(--i-text2)}
.ig-tabs{display:flex;justify-content:center;gap:60px;border-top:1px solid var(--i-border);height:46px;
  flex:0 0 46px;align-items:flex-start}
.ig-tab{font-size:12px;font-weight:600;letter-spacing:.09em;text-transform:uppercase;color:var(--i-text2);
  display:flex;align-items:center;gap:7px;padding-top:16px;border-top:1px solid transparent;margin-top:-1px}
.ig-tab.on{color:var(--i-text);border-top-color:var(--i-text)}
.ig-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:4px;margin-top:20px}
.ig-cell{aspect-ratio:1/1;position:relative;overflow:hidden;background:var(--i-sk);cursor:pointer}
.ig-badge{position:absolute;right:9px;top:9px;width:18px;height:18px;opacity:.95}
.ig-badge.carousel{border:2px solid #fff;border-radius:4px}
.ig-badge.video{border-left:12px solid #fff;border-top:8px solid transparent;border-bottom:8px solid transparent;
  width:0;height:0;right:11px}

/* post-detail card — Instagram's own post modal, floated so the grid
   behind it stays visible. Shows the include_post_details group. */
.ig-detail{position:absolute;right:38px;top:400px;width:420px;border-radius:14px;overflow:hidden;
  background:var(--i-bg);border:1px solid var(--i-border);
  box-shadow:0 24px 60px -16px rgba(0,0,0,.45);display:flex;z-index:3}
[data-theme="dark"] .ig-detail{box-shadow:0 24px 60px -12px rgba(0,0,0,.95)}
.ig-dimg{width:168px;flex:0 0 168px;position:relative;background:var(--i-sk)}
.ig-dbody{flex:1;min-width:0;padding:13px 14px}
.ig-drow{display:flex;align-items:center;gap:9px;padding-bottom:10px;border-bottom:1px solid var(--i-border)}
.ig-drow .fav{font-family:var(--f-ig)}
.ig-dname{font-size:13px;font-weight:600}
.ig-dcap{font-size:13px;line-height:19px;margin-top:10px}
.ig-dacts{display:flex;gap:14px;margin-top:12px;align-items:center}
.ig-heart{width:19px;height:19px;position:relative}
.ig-heart::before,.ig-heart::after{content:"";position:absolute;top:2px;width:9px;height:14px;
  border-radius:9px 9px 0 0;background:#ed4956}
.ig-heart::before{left:9px;transform:rotate(45deg);transform-origin:0 100%}
.ig-heart::after{left:9px;transform:rotate(-45deg);transform-origin:100% 100%}
.ig-bub{width:18px;height:15px;border:2px solid var(--i-text);border-radius:5px}
.ig-dnums{font-size:13px;font-weight:600;margin-top:10px}
.ig-dmeta{font-size:10.5px;letter-spacing:.02em;text-transform:uppercase;color:var(--i-text2);margin-top:7px}
.ig-dfields{display:flex;flex-wrap:wrap;gap:5px;margin-top:10px}
.ig-df{font-family:'Monaco','Menlo',monospace;font-size:10px;line-height:1;padding:5px 7px;border-radius:5px;
  background:var(--i-sk);color:var(--i-text2)}

/* derived group — explicitly OURS, not an Instagram surface */
.ig-derived{margin:0;flex:0 0 auto;border-top:1px solid var(--border);background:var(--bg-secondary);
  padding:12px 53px;display:flex;align-items:center;gap:14px;font-family:'Inter',sans-serif;color:var(--text-primary)}
.ig-dlab{font-size:10.5px;letter-spacing:.09em;text-transform:uppercase;font-weight:700;color:var(--accent);
  background:var(--accent-dim);padding:5px 10px;border-radius:999px;white-space:nowrap}
.ig-dgrid{display:flex;gap:10px;flex:1}
.ig-dcell{flex:1;border:1px solid var(--border);border-radius:10px;padding:8px 12px;background:var(--bg-card)}
.ig-dk{display:block;font-family:'Monaco','Menlo',monospace;font-size:10px;color:var(--text-secondary);
  white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
.ig-dv{display:block;font-size:15px;font-weight:700;line-height:20px;margin-top:2px}

/* real photographs — see PHOTOS below. A placeholder is a defect
   (internal/docs/CONTENT-PLAYBOOK.md §10), and an abstract blob inside a replica
   of Instagram or Google Maps is the tell that gives a mockup away. */
.ph{position:absolute;inset:0;width:100%;height:100%;object-fit:cover;display:block}
.stars{letter-spacing:-.5px;font-size:12px}

/* ── caption + attribution, OUTSIDE the frame ─────────────────── */
.cap{display:flex;align-items:center;gap:9px;flex-wrap:wrap;margin-top:14px;font-size:12.5px;color:var(--text-muted)}
.cap code{font-family:'Monaco','Menlo',monospace;font-size:12px;color:var(--accent);background:var(--accent-dim);
  padding:2px 7px;border-radius:6px}
.cap .sep{opacity:.5}
.swipe{margin-top:9px;font-size:12px;color:var(--text-secondary)}
.hint{margin-top:8px;font-size:12px;color:var(--text-muted);display:flex;align-items:center;gap:7px;flex-wrap:wrap}
.hint .kbd{font-family:'Monaco','Menlo',monospace;font-size:10.5px;border:1px solid var(--border);
  border-radius:5px;padding:1px 5px;color:var(--text-secondary)}
.kbhint{display:inline-flex;align-items:center;gap:7px}
.tm{max-width:1440px;margin:14px auto 0;font-size:11.5px;line-height:18px;color:var(--text-muted)}

/* ── JSON pane ───────────────────────────────────────────────── */
.json-head{display:flex;align-items:center;gap:10px;padding:14px 18px;border-bottom:1px solid var(--border);
  background:var(--json-gutter);flex-wrap:wrap}
.verb{font-family:'Monaco','Menlo',monospace;font-size:10.5px;font-weight:700;letter-spacing:.06em;
  color:var(--accent);background:var(--accent-dim);padding:3px 7px;border-radius:5px}
.req{font-family:'Monaco','Menlo',monospace;font-size:11.5px;color:var(--text-secondary);word-break:break-all;flex:1;min-width:0}
.ok{display:inline-flex;align-items:center;gap:6px;font-size:11px;font-family:'Monaco','Menlo',monospace;color:var(--success)}
.ok::before{content:"";width:6px;height:6px;border-radius:50%;background:var(--success);box-shadow:0 0 0 3px rgba(34,197,94,.16)}
.json-body{flex:1;overflow:auto;padding:14px 0 22px;min-height:0;scrollbar-width:thin;
  scrollbar-color:var(--border-light) transparent;scroll-behavior:smooth}
.json-body::-webkit-scrollbar{width:9px}
.json-body::-webkit-scrollbar-thumb{background:var(--border-light);border-radius:99px;border:3px solid transparent;background-clip:content-box}
.json-body::-webkit-scrollbar-track{background:transparent}
.jl{display:block;font-family:'Monaco','Menlo',monospace;font-size:11.5px;line-height:19px;
  padding:1px 18px 1px 16px;border-left:2px solid transparent;white-space:pre-wrap;word-break:break-word;
  color:var(--text-secondary);transition:background .12s,border-color .12s}
.jl:hover{background:var(--bg-card-hover)}
.jl .k{color:var(--j-key)}.jl .s{color:var(--j-str)}.jl .n{color:var(--j-num)}
.jl .b{color:var(--j-bool)}.jl .z{color:var(--j-null)}.jl .p{color:var(--j-punct)}
.jl .skw{background:var(--j-str);opacity:.35;height:8px;border-radius:4px}
.jl.hl-json{background:var(--hl-bg);border-left-color:var(--hl-bar)}
.json-foot{padding:10px 18px;border-top:1px solid var(--border);font-family:'Monaco','Menlo',monospace;
  font-size:11px;color:var(--text-muted);display:flex;gap:16px;flex-wrap:wrap;background:var(--json-gutter)}

.hl-left{background:var(--hl-bg)!important;box-shadow:0 0 0 3px var(--hl-bg),0 0 0 4px var(--hl-ring);
  border-radius:6px;position:relative;z-index:4}

/* ── controls ─────────────────────────────────────────────────── */
.sc-foot{display:none;align-items:center;gap:14px;}
.js-showcase .sc-foot{display:flex;align-items:center;gap:14px;padding:12px 16px;border-top:1px solid var(--border);
  background:var(--bg-card);flex-wrap:wrap}
.ctl{width:34px;height:34px;border-radius:50%;border:1px solid var(--border);background:var(--bg-card);
  color:var(--text-secondary);cursor:pointer;display:inline-flex;align-items:center;justify-content:center;
  transition:all .15s;flex:0 0 auto;font-size:0}
.ctl:hover{border-color:var(--accent);color:var(--accent)}
.ar{width:8px;height:8px;border-top:1.8px solid currentColor;border-right:1.8px solid currentColor}
.ar.l{transform:rotate(-135deg) translate(-1px,-1px)}
.ar.r{transform:rotate(45deg) translate(-1px,-1px)}
.pp{position:relative;width:11px;height:12px}
.pp.pause::before,.pp.pause::after{content:"";position:absolute;top:0;width:3.4px;height:12px;background:currentColor;border-radius:1px}
.pp.pause::before{left:0}.pp.pause::after{right:0}
.pp.play::before{content:"";position:absolute;left:2px;top:0;border-left:9px solid currentColor;
  border-top:6px solid transparent;border-bottom:6px solid transparent}
.dots{display:flex;gap:7px;align-items:center}
.dot{width:8px;height:8px;border-radius:50%;border:0;padding:0;background:var(--border-light);cursor:pointer;transition:all .2s}
.dot[aria-current="true"]{background:var(--accent);width:22px;border-radius:999px}
.prog{flex:1;min-width:80px;height:3px;border-radius:999px;background:var(--border);overflow:hidden}
.prog i{display:block;height:100%;width:0;background:linear-gradient(90deg,var(--accent),var(--accent-light))}
.sc-foot .status{font-size:11.5px;color:var(--text-muted);font-family:'Monaco','Menlo',monospace;white-space:nowrap}
.sr{position:absolute;width:1px;height:1px;overflow:hidden;clip:rect(0 0 0 0);white-space:nowrap}

/* ── responsive: stack the panes, frame keeps its aspect ─────── */
@media (max-width:1279px){
  .slide{grid-template-columns:minmax(0,1fr);grid-template-rows:auto auto}
  .pane-serp{border-right:0;border-bottom:1px solid var(--border);padding:18px 16px 16px}
  .json-body{max-height:340px}
}
@media (max-width:560px){
  .wrap{padding:24px 14px 56px}
  .sc-tab .ep{display:none}
  .kbhint{display:none}   /* no arrow keys on a touch device */
  .pane-serp{padding:14px 12px 12px}
}
@media (prefers-reduced-motion:reduce){
  *{animation:none!important;transition:none!important}
  .json-body{scroll-behavior:auto}
}
    </style>
    <script>
    (function(){
  "use strict";
  /* The slides are server-rendered into the markup above — this script only wires up
     behaviour. Everything that BUILT that markup (sample payloads, the four surface
     renderers, the JSON printer) is build-time only and deliberately not shipped.
     Regenerate with: python3 sprints/prototypes/port-showcase-to-index.py */
  const SLIDES = [
    { caption: "Google web search with an AI Overview", gutter: 150 },
    { caption: "Three AI assistants answered and cited, side by side", gutter: 0 },
    { caption: "Google Maps places with full business detail", gutter: 0 },
    { caption: "Instagram profile, recent posts and post detail", gutter: 0 }
  ];

  /* ═══ bind ═════════════════════════════════════════════════════════ */
  const stage = document.getElementById("sxStage");
  const showcaseRoot = document.getElementById("serpShowcase");
  const tabsEl = document.getElementById("sxTabs");
  const dotsEl = document.getElementById("sxDots");
  const statusEl = document.getElementById("sxStatus");
  const liveEl = document.getElementById("sxLive");

  if (typeof renderBrandLogos === "function") renderBrandLogos(showcaseRoot);

  /* `js-on` swaps the stage from "four readable sections in normal flow" (what a
     crawler and a no-JS visitor get) to the overlapping carousel. It runs during
     parse, immediately after the markup, so a browser never paints the stacked
     state. Removing it must never hide the content — that is the whole point. */
  stage.classList.add("js-on");
  showcaseRoot.classList.add("js-showcase");
  const slideEls = Array.from(stage.children);
  const tabEls = Array.from(tabsEl.children);
  const dotEls = Array.from(dotsEl.children);
  tabEls.forEach((t, i) => t.addEventListener("click", () => go(i, true)));
  dotEls.forEach((d, i) => d.addEventListener("click", () => go(i, true)));

  /* ═══════════════════════════════════════════════════════════════════
     shared-frame fit. One design canvas (--dw × --dh) for all slides;
     --fit scales it into whatever width the pane happens to be. Measured
     on the viewport, which is width:100% of a minmax(0,…fr) grid track,
     so the child's zoom can never feed back into the measurement.
     ═══════════════════════════════════════════════════════════════════ */
  const band = document.querySelector(".serp-showcase-band");
  const DW = 1041, MIN_FIT = 0.62;
  let scrolledOnce = false;
  const viewports = Array.from(document.querySelectorAll(".sc-viewport"));
  const split = window.matchMedia("(min-width:1280px)");
  function fitFrames(){
    const w = viewports[0] ? viewports[0].clientWidth : 0;
    if (!w) return;
    /* Never scale below MIN_FIT: a 22px Google title at 0.32 is unreadable, which
       is exactly the flaw the JPG slideshow had on mobile. Under that width the
       frame keeps its size and scrolls sideways inside the viewport instead. */
    const fit = Math.max(MIN_FIT, Math.min(1, w / DW));
    band.style.setProperty("--fit", String(fit));
    const scrollable = DW * fit > w + 1;
    viewports.forEach(v => {
      v.setAttribute("tabindex", scrollable ? "0" : "-1");
      if (scrollable) v.setAttribute("role", "region");
      else v.removeAttribute("role");
    });
    document.querySelectorAll(".swipe").forEach(el => { el.hidden = !scrollable; });
    /* park the scroll on the content column, not on Google's empty left gutter */
    if (scrollable && !scrolledOnce){
      scrolledOnce = true;
      viewports.forEach((v,i) => { v.scrollLeft = (SLIDES[i].gutter || 0) * fit; });
    }
    /* Lock the stage to the LEFT pane's height. Without this the JSON pane —
       which is a full response and hundreds of lines long — sets the row height
       and leaves the frame stranded at the top of a very tall empty column. */
    if (!split.matches){ stage.style.height = ""; return; }
    const pane = stage.querySelector(".pane-serp");
    const stack = stage.querySelector(".serp-stack");
    if (!pane || !stack) return;
    const cs = getComputedStyle(pane);
    stage.style.height = Math.ceil(stack.offsetHeight + parseFloat(cs.paddingTop) + parseFloat(cs.paddingBottom)) + "px";
  }
  if (window.ResizeObserver && viewports[0]){
    new ResizeObserver(fitFrames).observe(viewports[0]);
  }
  window.addEventListener("resize", fitFrames);
  split.addEventListener("change", fitFrames);
  fitFrames();

  /* ═══ two-way field ↔ key sync ═════════════════════════════════════ */
  function clearHL(slide){
    slide.querySelectorAll(".hl-left").forEach(e => e.classList.remove("hl-left"));
    slide.querySelectorAll(".hl-json").forEach(e => e.classList.remove("hl-json"));
  }
  function underPath(p, base){
    return p === base || p.indexOf(base + ".") === 0 || p.indexOf(base + "[") === 0;
  }
  function resolveLeft(slide, p){
    let q = p;
    while (q){
      if (slide.querySelector('[data-f="' + q + '"]')) return q;
      const n = q.replace(/(\.[^.\[\]]+|\[\d+\])$/, "");
      if (n === q) return null;
      q = n;
    }
    return null;
  }
  function intoView(el, pane){
    if (!el || !pane) return;
    const er = el.getBoundingClientRect(), pr = pane.getBoundingClientRect();
    if (er.top < pr.top + 8) pane.scrollTop += er.top - pr.top - 40;
    else if (er.bottom > pr.bottom - 8) pane.scrollTop += er.bottom - pr.bottom + 40;
  }
  function highlight(slide, leftPath, jsonPath, scrollJson){
    clearHL(slide);
    if (leftPath){
      slide.querySelectorAll('[data-f="' + leftPath + '"]').forEach(e => e.classList.add("hl-left"));
    }
    if (jsonPath){
      let first = null;
      slide.querySelectorAll(".jl").forEach(e => {
        if (underPath(e.getAttribute("data-p"), jsonPath)){
          e.classList.add("hl-json");
          if (!first) first = e;
        }
      });
      if (first && scrollJson) intoView(first, first.parentElement);
    }
  }
  stage.addEventListener("mouseover", e => {
    const slide = e.target.closest(".slide"); if (!slide) return;
    const l = e.target.closest("[data-f]");
    if (l && slide.contains(l)) return highlight(slide, l.getAttribute("data-f"), l.getAttribute("data-f"), true);
    const j = e.target.closest(".jl");
    if (j){
      const p = j.getAttribute("data-p");
      const t = resolveLeft(slide, p);
      highlight(slide, t, t || p, false);
    }
  });
  stage.addEventListener("mouseleave", () => slideEls.forEach(clearHL));
  stage.addEventListener("focusin", e => {
    const slide = e.target.closest(".slide"); if (!slide) return;
    const l = e.target.closest("[data-f]");
    if (l) return highlight(slide, l.getAttribute("data-f"), l.getAttribute("data-f"), true);
    const j = e.target.closest(".jl");
    if (j){
      const p = j.getAttribute("data-p");
      const t = resolveLeft(slide, p);
      highlight(slide, t, t || p, false);
    }
  });

  /* ═══ carousel — MANUAL ONLY ═══════════════════════════════════════════
     Auto-advance removed 2026-09-04 (owner decision). Nothing on this band moves
     by itself any more, so WCAG 2.2.2 (Pause, Stop, Hide) no longer applies and the
     play/pause control it required is gone with it — along with the progress bar,
     which only ever visualised the autoplay timer. Tabs, arrows, dots and the arrow
     keys are now the only ways to change slide. Do not reintroduce a timer here
     without also reintroducing a visible pause control.
     ══════════════════════════════════════════════════════════════════════ */
  const showcase = showcaseRoot;
  let idx = 0;

  function go(n, userAction){
    idx = (n + SLIDES.length) % SLIDES.length;
    slideEls.forEach((el, i) => {
      const on = i === idx;
      el.classList.toggle("is-active", on);
      el.setAttribute("aria-hidden", on ? "false" : "true");
      if (on) el.removeAttribute("inert"); else el.setAttribute("inert","");
      if (!on) clearHL(el);
      const jb = el.querySelector(".json-body");
      if (jb) jb.scrollTop = 0;
    });
    tabEls.forEach((t,i) => t.setAttribute("aria-current", i === idx ? "true" : "false"));
    dotEls.forEach((d,i) => d.setAttribute("aria-current", i === idx ? "true" : "false"));
    statusEl.textContent = (idx+1) + " / " + SLIDES.length;
    if (userAction){
      liveEl.textContent = "Slide " + (idx+1) + " of " + SLIDES.length + ": " + SLIDES[idx].caption;
      tabEls[idx].scrollIntoView({ block:"nearest", inline:"nearest" });
    }
  }
  /* ── Auto-advance ────────────────────────────────────────────────────────────
     OWNER DECISION 2026-09-09, superseding the 2026-09-04 removal. The ‹ › buttons are
     gone; the tabs, the dots and the arrow keys remain as manual controls.

     ⚠️ WCAG 2.2.2 (Pause, Stop, Hide) applies again the moment a timer exists, and the
     note left on the 2026-09-04 removal said re-adding one means re-adding a way to stop
     it. There is no visible pause button (the owner asked for FEWER controls, not the same
     number), so the mechanism is threefold and covers every input mode:
       · pointer users  — pauses on hover anywhere over the carousel
       · keyboard users — pauses on focusin, i.e. the whole time they are inside it
       · motion-sensitive users — prefers-reduced-motion stops it advancing at all
     Miss any one of those and some visitor has moving content they cannot stop.

     `go()` wraps on its own (`idx = (n + SLIDES.length) % SLIDES.length`), so no bounds
     check belongs here. It is called WITHOUT `userAction`: that flag announces the slide
     on the live region and scrolls the tab strip, which is right for a click and wrong
     for a timer — announcing every few seconds would talk over a screen-reader user. */
  const AUTO_MS = 6000;
  const reduceMotion = window.matchMedia("(prefers-reduced-motion: reduce)");
  let paused = false;
  ["mouseenter", "focusin"].forEach(ev => showcase.addEventListener(ev, () => { paused = true; }));
  ["mouseleave", "focusout"].forEach(ev => showcase.addEventListener(ev, () => { paused = false; }));
  setInterval(() => { if (!paused && !reduceMotion.matches) go(idx + 1); }, AUTO_MS);
  showcase.addEventListener("keydown", e => {
    if (e.key === "ArrowRight"){ go(idx + 1, true); e.preventDefault(); }
    else if (e.key === "ArrowLeft"){ go(idx - 1, true); e.preventDefault(); }
    else if (e.key === "Home"){ go(0, true); e.preventDefault(); }
    else if (e.key === "End"){ go(SLIDES.length - 1, true); e.preventDefault(); }
  });

  go(0);
    })();
    </script>


    <!-- Features -->
    <section class="features" id="features">
      <div class="section-header">
