        <path d="M 5 50 Q 15 30, 25 50 Q 35 70, 45 50 Q 55 30, 65 50 Q 75 70, 85 50 Q 90 40, 95 50 L 95 55 Q 88 45, 82 55 Q 72 75, 62 55 Q 52 35, 42 55 Q 32 75, 22 55 Q 12 35, 5 55 Z"/>
      </svg>
    </div>
  </div>

  <!-- Navigation - OUTSIDE content-wrapper for proper fixed positioning on mobile -->
  <nav class="navbar" role="navigation" aria-label="Main navigation">
    <div class="nav-container">
      <a href="/" class="nav-brand" aria-label="Serpent API Home">
        <span class="infinity-serpent">
          <svg viewBox="0 0 48 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
            <path d="M12 12c0-4.4 3.6-8 8-8s8 3.6 8 8-3.6 8-8 8c-2.5 0-4.7-1.1-6.2-2.9" style="stroke: var(--accent);"/>
            <path d="M36 12c0 4.4-3.6 8-8 8s-8-3.6-8-8 3.6-8 8-8c2.5 0 4.7 1.1 6.2 2.9" style="stroke: var(--accent);"/>
          </svg>
        </span>
        Serpent<span class="brand-api">API</span>
      </a>
      <ul class="nav-links" id="navLinks"></ul>
      <div class="nav-buttons" id="navButtons">
        <a href="/login" class="btn btn-outline" onclick="if(window.openAuthModal){openAuthModal();return false;}">Sign In</a>
        <a href="/login" class="btn btn-primary" onclick="if(window.openAuthModal){openAuthModal();return false;}">Get Started</a>
      </div>
      <!-- Mobile Menu Button -->
      <button class="mobile-menu-btn" id="mobileMenuBtn" aria-label="Toggle menu">
        <svg class="hamburger-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor">
          <line x1="3" y1="6" x2="21" y2="6"></line>
          <line x1="3" y1="12" x2="21" y2="12"></line>
          <line x1="3" y1="18" x2="21" y2="18"></line>
        </svg>
        <svg class="close-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor">
          <line x1="18" y1="6" x2="6" y2="18"></line>
          <line x1="6" y1="6" x2="18" y2="18"></line>
        </svg>
      </button>
    </div>
  </nav>

  <!-- Mobile Menu -->
  <div class="mobile-menu" id="mobileMenu">
    <ul class="mobile-menu-links" id="mobileMenuLinks"></ul>
    <div class="mobile-menu-buttons" id="mobileMenuButtons">
      <a href="/login" class="btn btn-outline" onclick="if(window.openAuthModal){openAuthModal();return false;}">Sign In</a>
      <a href="/login" class="btn btn-primary" onclick="if(window.openAuthModal){openAuthModal();return false;}">Get Started</a>
    </div>
  </div>

  <main id="main-content" class="content-wrapper">
    <!-- Documentation update notice -->
    <div class="launch-urgency-banner" role="note" aria-label="Documentation update">
      <div class="launch-urgency-inner launch-slide is-active">
        <span>Our API documentation has just been updated</span>
        <a href="/docs" class="launch-urgency-cta">See what&rsquo;s new &rarr;</a>
      </div>
    </div>

    <!-- Hero -->
    <section class="hero">
      <div class="hero-content">
        <h1 class="hero-title">The Cheapest <span class="accent">SERP API</span> in the World</h1>
        <p class="hero-subtitle hero-deck">Search results from five engines, delivered as JSON. From $0.03 per 1000 API calls. No subscription. Start with 10 free searches.</p>
        <div class="hero-logo-groups" aria-label="Supported search engines and AI models">
          <div class="logo-group" aria-label="Search engines">
            <span class="logo-group-label">Search Engines</span>
            <div class="logo-group-row">
              <div class="hero-logo"><img data-brand="google" alt="Google" width="40" height="40"></div>
              <div class="hero-logo"><img data-brand="bing" alt="Bing" loading="lazy" width="40" height="40"></div>
              <div class="hero-logo"><img data-brand="yahoo" alt="Yahoo" loading="lazy" width="40" height="40"></div>
              <div class="hero-logo"><img data-brand="duckduckgo" alt="DuckDuckGo" loading="lazy" width="40" height="40"></div>
              <div class="hero-logo"><img data-brand="brave" alt="Brave" loading="lazy" width="40" height="40"></div>
            </div>
          </div>
          <div class="logo-group-divider" aria-hidden="true"></div>
          <div class="logo-group" aria-label="AI models">
            <span class="logo-group-label">AI Models</span>
            <div class="logo-group-row">
              <div class="hero-logo"><img data-brand="anthropic" alt="Claude" loading="lazy" width="40" height="40"></div>
              <div class="hero-logo"><img data-brand="openai" alt="ChatGPT" loading="lazy" width="40" height="40"></div>
              <div class="hero-logo"><img data-brand="gemini" alt="Gemini" loading="lazy" width="40" height="40"></div>
              <div class="hero-logo"><img data-brand="perplexity" alt="Perplexity" loading="lazy" width="40" height="40"></div>
            </div>
          </div>
        </div>
        <div class="hero-buttons">
          <a href="/login" data-auth-href="/playground" class="btn btn-primary btn-lg auth-aware-cta" onclick="if(window.openAuthModal&&!(typeof isLoggedIn==='function'&&isLoggedIn())){openAuthModal(function(){window.location.href='/playground';});return false;}">Try for Free</a>
          <a href="/docs" class="btn btn-outline btn-lg">Documentation</a>
        </div>
        <div class="hero-stats">
          <div class="stat">
            <div class="stat-value">$0.03/1K</div>
            <div class="stat-label">Google SERP API calls</div>
          </div>
          <div class="stat">
            <div class="stat-value">Free to start</div>
            <div class="stat-label">No card required</div>
          </div>
          <div class="stat">
            <div class="stat-value">112</div>
            <div class="stat-label">Countries</div>
          </div>
          <div class="stat">
            <div class="stat-value">All blocks</div>
            <div class="stat-label">AIO + Rich SERP</div>
          </div>
        </div>
      </div>
    </section>

    <!-- ═══ Homepage SERP / AI showcase ═══════════════════════════════════
         Four hand-built replicas of the surfaces we parse, each paired with the real
         response. Replaced the four static JPGs on 2026-08-20: the JPGs were
         light-theme inside a theme-aware card, letterboxed their baked-in text below
         legibility on mobile, auto-rotated every 3s with no way to pause (WCAG 2.2.2),
         and put every word of that content out of reach of a crawler.

         2026-09-04: auto-advance REMOVED (owner) — nothing moved on its own, so WCAG
         2.2.2 did not apply and no play/pause control was needed. SUPERSEDED BELOW.

         2026-09-09: the ‹ › buttons are REMOVED and auto-advance is BACK (owner). The
         manual controls are now the tabs, the dots and the arrow keys. A timer exists
         again, so WCAG 2.2.2 applies again — and the note left in 2026-09-04 said that
         means re-adding a way to stop it. There is deliberately no visible pause button
         (the point of the change was fewer controls, not the same number), so the
         mechanism is threefold, one for each input mode, and all three are VERIFIED in
         a real browser:
           · pointer  — pauses on hover                    (measured: stayed on slide 1)
           · keyboard — pauses on focusin, the whole visit  (measured: stayed on slide 3)
           · reduced motion — never advances at all         (measured: 0 after 9s, dots
             still work)
         Remove any one of those and some visitor has moving content they cannot stop.
         The timer is in the prototype's script block, not here.

         THIS MARKUP IS GENERATED — do not hand-edit. Source of truth is
         sprints/prototypes/showcase-prototype-v2.html; regenerate with
         `python3 sprints/prototypes/port-showcase-to-index.py`.
         ══════════════════════════════════════════════════════════════════════ -->
    <section class="serp-showcase-band">
      <div class="ssb-inner">
        <h2 class="ssb-h">1 API Call In, Whole SERP Data Out</h2>
        <p class="ssb-deck">Hover anything on the left to find the field it lands in on the right.
        Google, three AI assistants, Google Maps and Instagram &mdash; the same JSON shape every time.</p>

        <section class="showcase" id="serpShowcase" role="region" aria-roledescription="carousel"
                 aria-label="Serpent API result showcase" tabindex="0">
          <div class="sc-tabs" id="sxTabs"><button type="button" class="sc-tab"><img data-brand="google" alt="" width="15" height="15">Google <span class="ep">/api/search</span></button><button type="button" class="sc-tab"><img data-brand="perplexity" alt="" width="15" height="15">AI answers <span class="ep">/api/ai/rank</span></button><button type="button" class="sc-tab"><img data-brand="google" alt="" width="15" height="15">Google Maps <span class="ep">/api/maps/search</span></button><button type="button" class="sc-tab"><img data-brand="instagram" alt="" width="15" height="15">Instagram <span class="ep">/api/social/instagram/profile</span></button></div>
          <div class="sc-stage" id="sxStage"><div class="slide" role="group" aria-roledescription="slide" aria-label="1 of 4: Google web search with an AI Overview"><div class="pane pane-serp"><div class="serp-stack"><div class="sc-viewport" aria-label="Google web search with an AI Overview — scrollable"><div class="frame"><div class="g"><div class="g-top"><span class="g-logo"><img data-brand="google" alt="Google" width="30" height="30"></span><span class="g-box"><span class="g-q" data-f="query" tabindex="0">best crm software for small business</span><span class="mag" aria-hidden="true"></span></span></div><div class="g-tabs" aria-hidden="true"><span class="g-tab aim"><svg width="18" height="18" viewBox="0 0 24 24" aria-hidden="true"><defs><linearGradient id="aiog" x1="0" y1="0" x2="1" y2="1"><stop offset="0%" stop-color="#4285F4"></stop><stop offset="50%" stop-color="#9b72cb"></stop><stop offset="100%" stop-color="#d96570"></stop></linearGradient></defs><path fill="url(#aiog)" d="M12 2l1.9 5.6L19.5 9.5 13.9 11.4 12 17l-1.9-5.6L4.5 9.5l5.6-1.9z"></path><path fill="url(#aiog)" d="M18.5 15l.9 2.6 2.6.9-2.6.9-.9 2.6-.9-2.6-2.6-.9 2.6-.9z"></path></svg>AI Mode</span><span class="g-tab on">All</span><span class="g-tab">Images</span><span class="g-tab">Forums</span><span class="g-tab">Videos</span><span class="g-tab">News</span><span class="g-tab">Shopping</span><span class="g-tab">More</span><span class="g-tab">Tools</span></div><div class="g-body"><div class="g-col"><div class="aio"><div class="aio-h"><svg width="18" height="18" viewBox="0 0 24 24" aria-hidden="true"><defs><linearGradient id="aiog" x1="0" y1="0" x2="1" y2="1"><stop offset="0%" stop-color="#4285F4"></stop><stop offset="50%" stop-color="#9b72cb"></stop><stop offset="100%" stop-color="#d96570"></stop></linearGradient></defs><path fill="url(#aiog)" d="M12 2l1.9 5.6L19.5 9.5 13.9 11.4 12 17l-1.9-5.6L4.5 9.5l5.6-1.9z"></path><path fill="url(#aiog)" d="M18.5 15l.9 2.6 2.6.9-2.6.9-.9 2.6-.9-2.6-2.6-.9 2.6-.9z"></path></svg>AI Overview</div><div class="aio-t" data-f="results.aiOverview.text" tabindex="0">For a small team the three CRMs that come up most often are HubSpot, Zoho CRM and Pipedrive.<span class="sk w95"></span><span class="sk w88"></span><span class="sk w52"></span></div><div class="aio-src"><div class="aio-lab">Sources</div><div class="chips"><span class="chip" data-f="results.aiOverview.sources[0]" tabindex="0"><span class="fav f16" style="background:linear-gradient(135deg,hsl(58,58%,52%),hsl(92,56%,42%))" aria-hidden="true">H</span>hubspot.com</span><span class="chip" data-f="results.aiOverview.sources[1]" tabindex="0"><span class="fav f16" style="background:linear-gradient(135deg,hsl(183,58%,52%),hsl(217,56%,42%))" aria-hidden="true">Z</span>zoho.com</span><span class="chip" data-f="results.aiOverview.sources[2]" tabindex="0"><span class="fav f16" style="background:linear-gradient(135deg,hsl(103,58%,52%),hsl(137,56%,42%))" aria-hidden="true">P</span>pipedrive.com</span><span class="chip" data-f="results.aiOverview.sources[3]" tabindex="0"><span class="fav f16" style="background:linear-gradient(135deg,hsl(278,58%,52%),hsl(312,56%,42%))" aria-hidden="true">G</span>g2.com</span></div></div><span class="aio-more" aria-hidden="true">Show more <span class="ar" style="border-color:currentColor;transform:rotate(135deg) translate(-2px,-2px)"></span></span></div><div class="g-rule"></div><div class="res"><div class="res-head"><span class="favbox"><span class="fav f26" style="background:linear-gradient(135deg,hsl(58,58%,52%),hsl(92,56%,42%))" aria-hidden="true">H</span></span><span><span class="res-site">HubSpot</span><br><span class="res-cite" data-f="results.organic[0].displayedUrl" tabindex="0">hubspot.com › products › crm</span></span></div><a class="res-title" data-f="results.organic[0].title" tabindex="0">HubSpot CRM: Free CRM Software for Small Businesses</a><div class="res-snip" data-f="results.organic[0].snippet" tabindex="0"><span class="sk w95"></span><span class="sk w42"></span></div></div><div class="res"><div class="res-head"><span class="favbox"><span class="fav f26" style="background:linear-gradient(135deg,hsl(183,58%,52%),hsl(217,56%,42%))" aria-hidden="true">Z</span></span><span><span class="res-site">Zoho</span><br><span class="res-cite" data-f="results.organic[1].displayedUrl" tabindex="0">zoho.com › crm</span></span></div><a class="res-title" data-f="results.organic[1].title" tabindex="0">Zoho CRM — Sales CRM Software Built for Small Teams</a><div class="res-snip" data-f="results.organic[1].snippet" tabindex="0"><span class="sk w95"></span><span class="sk w42"></span></div></div><div class="rel-h">Related searches</div><div class="rel"><span class="rel-c" data-f="results.relatedSearches[0].query" tabindex="0"><span class="mag" aria-hidden="true"></span>free crm for small business</span><span class="rel-c" data-f="results.relatedSearches[1].query" tabindex="0"><span class="mag" aria-hidden="true"></span>hubspot vs pipedrive pricing</span></div></div></div></div></div></div><p class="swipe" hidden="">Scroll the panel sideways to see the full page.</p><p class="cap">Google web search with an AI Overview <span class="sep">·</span> parsed by <code>/api/search</code></p><p class="hint"><span class="kbd">hover</span> any element to jump to its field <span class="sep">·</span> grey bars are text that lives in the JSON <span class="kbhint"><span class="sep">·</span> <span class="kbd">←</span><span class="kbd">→</span> to change slide</span></p></div></div><div class="pane pane-json"><div class="json-head"><span class="verb">GET</span><span class="req">/api/search?q=best+crm+software+for+small+business&amp;engine=google&amp;country=us&amp;include_aio=true</span><span class="ok">200 OK</span></div><div class="json-body"><span class="jl" data-p="" style="padding-left:16px"><span class="p">{</span></span><span class="jl" data-p="success" style="padding-left:30px"><span class="k">"success"</span><span class="p">: </span><