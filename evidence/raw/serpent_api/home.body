    "<span style="color: var(--accent);">pixel_box</span>": { "<span style="color: var(--accent);">x</span>": <span style="color: #ec4899;">125</span>, "<span style="color: var(--accent);">y</span>": <span style="color: #ec4899;">210</span>, "<span style="color: var(--accent);">w</span>": <span style="color: #ec4899;">1100</span>, "<span style="color: var(--accent);">h</span>": <span style="color: #ec4899;">428</span> }
  }
}</pre>
