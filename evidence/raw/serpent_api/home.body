          <div class="sc-foot">
            <div class="dots" id="sxDots" role="group" aria-label="Choose slide"><button type="button" class="dot" aria-label="Slide 1: Google web search with an AI Overview"></button><button type="button" class="dot" aria-label="Slide 2: Three AI assistants answered and cited, side by side"></button><button type="button" class="dot" aria-label="Slide 3: Google Maps places with full business detail"></button><button type="button" class="dot" aria-label="Slide 4: Instagram profile, recent posts and post detail"></button></div>
            <span class="status" id="sxStatus">1 / 4</span>
