  <script src="/js/app-config.b8ed283b356f3c7976257158d7a23bb221b36643766a27a1ce5395088a3ee450.js"></script>
  <script src="/js/firebase-config.fad00f7d7e1c5789f78cad4927d50b049a861703f60fe9638ae84d1474b72dee.js"></script>
  <script src="/js/header.96415739c9c31422accdf0b6ef314ea1413543e5f0752754e7841a8d6cc31d19.js"></script>
  <script src="/js/banner-rotator.aca9b99a86b9ead6dc11f92694cb59c0dc7b0bc6641aea97b435fe9a745d4dff.js" defer></script>
  <script src="/js/auth-modal.0fde37b714c2e7cac48d4d3a204c6d9315460afa799aa8ebfa4a8b4053667163.js" defer></script>
  <script>
    // Re-target auth-aware CTAs to the data-auth-href when the user is signed in.
    (function() {
      function updateAuthCtas(isLoggedIn) {
        document.querySelectorAll('.auth-aware-cta').forEach(function(a) {
          var target = isLoggedIn ? a.dataset.authHref : '/login.html';
          if (target) a.setAttribute('href', target);
        });
      }
      function init() {
        if (typeof firebase === 'undefined' || !firebase.apps || !firebase.apps.length) {
          updateAuthCtas(false);
          return;
        }
        firebase.auth().onAuthStateChanged(function(user) { updateAuthCtas(!!user); });
      }
      if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', function() { setTimeout(init, 0); });
      } else {
        setTimeout(init, 0);
      }
    })();

    // Header and mobile menu handled by header.js

    function toggleFaq(element) {
      const item = element.parentElement;
      item.classList.toggle('active');
      const expanded = item.classList.contains('active');
      element.setAttribute('aria-expanded', expanded);
    }

    // Live API counter — starts at 1M, grows ~50/hr with natural randomness
    (function() {
      const el = document.getElementById('liveApiCounter');
      if (!el) return;
      const launchDate = new Date('2026-01-01T00:00:00Z').getTime();
      const baseCount = 1000000;
      const growthPerHour = 50;

      function getCount() {
        const hoursElapsed = (Date.now() - launchDate) / 3600000;
        // Seed a deterministic-ish random offset per hour so all visitors see same number
        const hourFloor = Math.floor(hoursElapsed);
        let total = baseCount;
        for (let h = 0; h < hourFloor; h++) {
          // Pseudo-random between 35-65 per hour using simple hash
          const noise = ((h * 2654435761) >>> 0) % 31; // 0-30
          total += 35 + noise;
        }
        // Partial hour: add proportional amount with small jitter
        const partial = hoursElapsed - hourFloor;
        const currentHourRate = 35 + (((hourFloor * 2654435761) >>> 0) % 31);
        total += Math.floor(partial * currentHourRate);
        return total;
      }

      function formatNum(n) {
        return n.toLocaleString('en-US') + '+';
      }

      function update() {
        el.textContent = formatNum(getCount());
      }

      update();
      // Update every 45-75 seconds (randomized so it feels organic)
      function scheduleNext() {
        const delay = 45000 + Math.random() * 30000;
        setTimeout(function() { update(); scheduleNext(); }, delay);
      }
      scheduleNext();
    })();
  </script>
</body>
</html>
