4 4h12"></path></svg><div class="_1up9hfz1e o71fut8 o71fut28 o71fut9k"><div class="_1up9hfz1f o71fut8 o71fut7s o71fut9k"><span class="_1up9hfz1h _1gg5qfz7 _1up9hfz1g o71fut2h3 o71fut2jk">Research</span><span class="_1up9hfz1j _1gg5qfz7 _1up9hfz1i o71fut2h1 o71fut2jk">Exhaustive</span></div><p class="_1up9hfz1l _1gg5qfz7 _1up9hfz1k o71fut2h2">High-stakes questions where claims get verified across dozens of sources.</p></div></div><div class="_1up9hfz1o _1up9hfz1n _1up9hfz1m o71fut8 o71fut2g o71fut2ew o71fut1s8"><div class="_1up9hfz1q _1up9hfz1p o71fut1rk o71fut1sk o71fut1zc o71fut20c o71fut1cw o71fut1ko o71fut8 o71fut28 o71fut9c o71fut2fe o71fut6o o71fut6k o71fut6w"><p class="_1up9hfz1u _1gg5qfzh _1up9hfz1t o71fut2h1 o71futg o71fut4">Latency</p><p class="_1up9hfz1w _1gg5qfz7 _1up9hfz1v o71fut2h2">Under 5min</p></div><div class="_1up9hfz1s _1up9hfz1r o71fut1rk o71fut1sk o71fut1zc o71fut20c o71fut1cw o71fut1ko o71fut8 o71fut28 o71fut9c o71fut2fe o71fut6o o71fut6k o71fut6w"><p class="_1up9hfz1u _1gg5qfzh _1up9hfz1t o71fut2h1 o71futg o71fut4">Price</p><div class="_1up9hfz1y _1up9hfz1x o71fut8 o71futg0 o71fut2jk"><p class="_1up9hfz20 _1gg5qfz3 _1up9hfz1z o71fut2h1">$450</p><p class="_1up9hfz22 _1gg5qfzh _1up9hfz21 o71fut2h2">/1k calls</p></div></div></div></div><div class="_1up9hfz1a _1up9hfz19 o71fut8 o71fut28 o71fut24 o71fut2ew o71fut7g" id="api-research-frontier"><div class="_1up9hfz1c _1up9hfz1b o71fut1cw o71fut1ko o71fut8 o71futgg o71fut7k o71fut2ew o71fut2fe o71fut1s8 o71fut1tg o71fut200 o71fut20c o71fut6s o71fut70"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-corner-down-right _1up9hfz1d o71fut6w o71fut280 o71fut2k9 o71futh4 o71fut2h1" aria-hidden="true"><path d="m15 10 5 5-5 5"></path><path d="M4 4v7a4 4 0 0 0 4 4h12"></path></svg><div class="_1up9hfz1e o71fut8 o71fut28 o71fut9k"><div class="_1up9hfz1f o71fut8 o71fut7s o71fut9k"><span class="_1up9hfz1h _1gg5qfz7 _1up9hfz1g o71fut2h3 o71fut2jk">Research</span><span class="_1up9hfz1j _1gg5qfz7 _1up9hfz1i o71fut2h1 o71fut2jk">Frontier</span></div><p class="_1up9hfz1l _1gg5qfz7 _1up9hfz1k o71fut2h2">Research too long to finish inside a request. Background mode only.</p></div></div><div class="_1up9hfz1o _1up9hfz1n _1up9hfz1m o71fut8 o71fut2g o71fut2ew o71fut1s8"><div class="_1up9hfz1q _1up9hfz1p o71fut1rk o71fut1sk o71fut1zc o71fut20c o71fut1cw o71fut1ko o71fut8 o71fut28 o71fut9c o71fut2fe o71fut6o o71fut6k o71fut6w"><p class="_1up9hfz1u _1gg5qfzh _1up9hfz1t o71fut2h1 o71futg o71fut4">Latency</p><p class="_1up9hfz1w _1gg5qfz7 _1up9hfz1v o71fut2h2">~5min</p></div><div class="_1up9hfz1s _1up9hfz1r o71fut1rk o71fut1sk o71fut1zc o71fut20c o71fut1cw o71fut1ko o71fut8 o71fut28 o71fut9c o71fut2fe o71fut6o o71fut6k o71fut6w"><p class="_1up9hfz1u _1gg5qfzh _1up9hfz1t o71fut2h1 o71futg o71fut4">Price</p><div class="_1up9hfz1y _1up9hfz1x o71fut8 o71futg0 o71fut2jk"><p class="_1up9hfz20 _1gg5qfz3 _1up9hfz1z o71fut2h1">$1,200</p><p class="_1up9hfz22 _1gg5qfzh _1up9hfz21 o71fut2h2">/1k calls</p></div></div></div></div></div><div class="_1up9hfzm _1up9hfzl o71fut8 o71fut28 o71fut2ew" id="api-finance-research-api"><div class="_1up9hfzw _1up9hfzv o71fut8 o71fut28 o71fut24 o71fut2ew o71fut7g"><div class="_1up9hfzy _1up9hfzx o71fut1s8 o71fut1sk o71fut200 o71fut20c o71fut1cw o71fut1ko o71fut8 o71fut28 o71fut9k o71fut2ew o71fut2fe o71fut6s o71fut70"><div class="_1up9hfzz o71fut8 o71fut9k o71fut7s"><a href="https://you.com/docs/guides/finance-research" class="_1up9hfz11 _1up9hfz10 o71fut8 o71fut7s o71fut9k o71fut2h1" aria-label="Finance Research API documentation"><span class="_1up9hfz16 _1gg5qfz5 _1up9hfz15 o71fut2h1 o71fut2jk">Finance Research API</span><span class="_1up9hfz12 o71fut8 o71fut5k o71fut7s o71fut2fm o71fut288 o71fut2ka o71fut2ir"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-arrow-up-right _1up9hfz14 _1up9hfz13 o71fut280 o71fut2k9 o71fut2hh" aria-hidden="true"><path d="M7 7h10v10"></path><path d="M7 17 17 7"></path></svg></span></a></div><p class="_1up9hfz18 _1gg5qfz7 _1up9hfz17 o71fut2h2">The Research engine tuned for financial questions, at the same price and latency. Use it for company, market, and competitive analysis that needs grounded numbers.</p></div><div class="_1up9hfz1n _1up9hfz1m o71fut8 o71fut2g o71fut2ew o71fut1s8"><div class="_1up9hfz1q _1up9hfz1p o71fut1rk o71fut1sk o71fut1zc o71fut20c o71fut1cw o71fut1ko o71fut8 o71fut28 o71fut9c o71fut2fe o71fut6o o71fut6k o71fut6w"></div><div class="_1up9hfz1s _1up9hfz1r o71fut1rk o71fut1sk o71fut1zc o71fut20c o71fut1cw o71fut1ko o71fut8 o71fut28 o71fut9c o71fut2fe o71fut6o o71fut6k o71fut6w"></div></div></div><div class="_1up9hfz1a _1up9hfz19 o71fut8 o71fut28 o71fut24 o71fut2ew o71fut7g" id="api-finance-research-deep"><div class="_1up9hfz1c _1up9hfz1b o71fut1cw o71fut1ko o71fut8 o71futgg o71fut7k o71fut2ew o71fut2fe o71fut1s8 o71fut1tg o71fut200 o71fut20c o71fut6s o71fut70"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-corner-down-right _1up9hfz1d o71fut6w o71fut280 o71fut2k9 o71futh4 o71fut2h1" aria-hidden="true"><path d="m15 10 5 5-5 5"></path><path d="M4 4v7a4 4 0 0 0 4 4h12"></path></svg><div class="_1up9hfz1e o71fut8 o71fut28 o71fut9k"><div class="_1up9hfz1f o71fut8 o71fut7s o71fut9k"><span class="_1up9hfz1h _1gg5qfz7 _1up9hfz1g o71fut2h3 o71fut2jk">Finance Research</span><span class="_1up9hfz1j _1gg5qfz7 _1up9hfz1i o71fut2h1 o71fut2jk">Deep</span></div><p class="_1up9hfz1l _1gg5qfz7 _1up9hfz1k o71fut2h2">Earnings summaries, competitive benchmarking, and multi-quarter trends.</p></div></div><div class="_1up9hfz1o _1up9hfz1n _1up9hfz1m o71fut8 o71fut2g o71fut2ew o71fut1s8"><div class="_1up9hfz1q _1up9hfz1p o71fut1rk o71fut1sk o71fut1zc o71fut20c o71fut1cw o71fut1ko o71fut8 o71fut28 o71fut9c o71fut2fe o71fut6o o71fut6k o71fut6w"><p class="_1up9hfz1u _1gg5qfzh _1up9hfz1t o71fut2h1 o71futg o71fut4">Latency</p><p class="_1up9hfz1w _1gg5qfz7 _1up9hfz1v o71fut2h2">Under 2 min</p></div><div class="_1up9hfz1s _1up9hfz1r o71fut1rk o71fut1sk o71fut1zc o71fut20c o71fut1cw o71fut1ko o71fut8 o71fut28 o71fut9c o71fut2fe o71fut6o o71fut6k o71fut6w"><p class="_1up9hfz1u _1gg5qfzh _1up9hfz1t o71fut2h1 o71futg o71fut4">Price</p><div class="_1up9hfz1y _1up9hfz1x o71fut8 o71futg0 o71fut2jk"><p class="_1up9hfz20 _1gg5qfz3 _1up9hfz1z o71fut2h1">$110</p><p class="_1up9hfz22 _1gg5qfzh _1up9hfz21 o71fut2h2">/1k calls</p></div></div></div></div><div class="_1up9hfz1a _1up9hfz19 o71fut8 o71fut28 o71fut24 o71fut2ew o71fut7g" id="api-finance-research-exhaustive"><div class="_1up9hfz1c _1up9hfz1b o71fut1cw o71fut1ko o71fut8 o71futgg o71fut7k o71fut2ew o71fut2fe o71fut1s8 o71fut1tg o71fut200 o71fut20c o71fut6s o71fut70"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-corner-down-right _1up9hfz1d o71fut6w o71fut280 o71fut2k9 o71futh4 o71fut2h1" aria-hidden="true"><path d="m15 10 5 5-5 5"></path><path d="M4 4v7a4 4 0 0 0 4 4h12"></path></svg><div class="_1up9hfz1e o71fut8 o71fut28 o71fut9k"><div class="_1up9hfz1f o71fut8 o71fut7s o71fut9k"><span class="_1up9hfz1h _1gg5qfz7 _1up9hfz1g o71fut2h3 o71fut2jk">Finance Research</span><span class="_1up9hfz1j _1gg5qfz7 _1up9hfz1i o71fut2h1 o71fut2jk">Exhaustive</span></div><p class="_1up9hfz1l _1gg5qfz7 _1up9hfz1k o71fut2h2">Full 10-K analysis, due diligence, and cross-market research.</p></div></div><div class="_1up9hfz1o _1up9hfz1n _1up9hfz1m o71fut8 o71fut2g o71fut2ew o71fut1s8"><div class="_1up9hfz1q _1up9hfz1p o71fut1rk o71fut1sk o71fut1zc o71fut20c o71fut1cw o71fut1ko o71fut8 o71fut28 o71fut9c o71fut2fe o71fut6o o71fut6k o71fut6w"><p class="_1up9hfz1u _1gg5qfzh _1up9hfz1t o71fut2h1 o71futg o71fut4">Latency</p><p class="_1up9hfz1w _1gg5qfz7 _1up9hfz1v o71fut2h2">Under 5 min</p></div><div class="_1up9hfz1s _1up9hfz1r o71fut1rk o71fut1sk o71fut1zc o71fut20c o71fut1cw o71fut1ko o71fut8 o71fut28 o71fut9c o71fut2fe o71fut6o o71fut6k o71fut6w"><p class="_1up9hfz1u _1gg5qfzh _1up9hfz1t o71fut2h1 o71futg o71fut4">Price</p><div class="_1up9hfz1y _1up9hfz1x o71fut8 o71futg0 o71fut2jk"><p class="_1up9hfz20 _1gg5qfz3 _1up9hfz1z o71fut2h1">$500</p><p class="_1up9hfz22 _1gg5qfzh _1up9hfz21 o71fut2h2">/1k calls</p></div></div></div></div></div></div></div></div></div></div></section><section id="pricing-decide" class="_89at7l1 _89at7l0 o71fut1mo o71fut1n6 o71fut1ng" aria-labelledby="pricing-decide-headline"><div class="_89at7l3 _89at7l2 o71fut8 o71fut28"><div class="_89at7l5 _89at7l4 o71fut1co o71fut1kg o71fut1s8 o71fut200 o71fut8 o71fut28 o71fut23 o71futa8 o71fut7f o71fut2ib"><div class="_89at7l7 _89at7l6 o71fut1d4 o71fut1dw o71fut1kw o71fut1lo o71fut1so o71fut1tg o71fut20g o71fut218 o71fut8 o71fut28 o71futaw o71fut70"><div class="_89at7l8 o71fut8 o71fut28 o71fut9k"><h2 class="_89at7la _1gg5qfz3 _89at7l9 o71fut2h1" id="pricing-decide-headline">Decide what to build, then find API.</h2><p class="_89at7lc _1gg5qfz7 _89at7lb o71fut2h2">Pick what you&#x27;re building. We&#x27;ll point you to the endpoint that fits, what it costs, and when to reach for something else.</p></div><div class="_89at7ld o71fut8 o71fut3 o71fut28 o71fut2ew"><button type="button" tabindex="0" id="base-ui-_R_15inpfd5sqdb_" role="combobox" aria-expanded="false" aria-haspopup="listbox" class="_1jj8zf3 _1jj8zf8 _1jj8zf5 _1rcd22i9 _89at7lf _89at7le o71fut1s8 o71fut200 o71fut1cw o71fut1ko o71fut8 o71futgg o71fut7s o71fut68 o71fut2ew o71fut2fe o71fut2i4 o71fut2hk o71fut2i9"><span class="_1k4s8h10">Feed LLM live web content</span>