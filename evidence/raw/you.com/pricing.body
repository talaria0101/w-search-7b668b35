MDhl\"}]\nf:[\"$\",\"script\",\"script-3\",{\"src\":\"/_next/static/chunks/1l2h7la5h-bhm.js\",\"async\":true,\"nonce\":\"ODM4OTM0MTUtNzE2Ni00ZDRiLWI0ZGMtMmVjMmY1ZTIxMDhl\"}]\n10:[\"$\",\"script\",\"script-4\",{\"src\":\"/_next/static/chunks/1ahl_t2lpm9c2.js\",\"async\":true,\"nonce\":\"ODM4OTM0MTUtNzE2Ni00ZDRiLWI0ZGMtMmVjMmY1ZTIxMDhl\"}]\n12:[\"$\",\"$1\",\"c\",{\"children\":[null,[\"$\",\"$L20\",null,{\"parallelRouterKey\":\"children\",\"error\":\"$undefined\",\"errorStyles\":\"$undefined\",\"errorScripts\":\"$undefined\",\"template\":[\"$\",\"$L21\",null,{}],\"templateStyles\":\"$undefined\",\"templateScripts\":\"$undefined\",\"notFound\":\"$undefined\",\"forbidden\":\"$undefined\",\"unauthorized\":\"$undefined\"}]]}]\n22:Td22,[{\"@context\":\"https://schema.org\",\"@type\":\"BreadcrumbList\",\"itemListElement\":[{\"@type\":\"ListItem\",\"position\":1,\"name\":\"Home\",\"item\":\"https://you.com/\"},{\"@type\":\"ListItem\",\"position\":2,\"name\":\"Pricing\",\"item\":\"https://you.com/pricing\"}]},{\"@context\":\"https://schema.org\",\"@type\":\"FAQPage\",\"mainEntity\":[{\"@type\":\"Question\",\"name\":\"What counts as a billable call?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"One request to an endpoint is one billable call, whatever it returns. A Web Search call returning 1 result and one returning 100 cost the same. Contents is billed per page returned.\"}},{\"@type\":\"Question\",\"name\":\"Do I need a credit card to start?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"No. You get $100 in API credit when you sign up, no credit card required. You only need to add a payment method when you're ready to upgrade to a paid plan or your free credits run out.\"}},{\"@type\":\"Question\",\"name\":\"Do credits expire?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"Free signup credits are valid for 60 days. Credits purchased on a paid plan do not expire as long as your account is active.\"}},{\"@type\":\"Question\",\"name\":\"What happens if I run out of credits mid-run?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"If you run out of credits, your API calls will return a 402 Payment Required response. You can add credits at any time from your dashboard to resume immediately. Enterprise plans can set up auto-recharge to avoid interruptions.\"}},{\"@type\":\"Question\",\"name\":\"Are there rate limits?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"Yes. Free tier includes 100 queries per day with a default rate limit. Paid plans offer higher QPS limits, and enterprise plans support custom QPS limits tailored to your workload.\"}},{\"@type\":\"Question\",\"name\":\"How do the Research effort tiers differ, and which should I use?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"Lite handles simple factual lookups in a single pass. Standard balances depth and speed for most production research. Deep cross-references several sources for complex questions. Exhaustive verifies claims across dozens of sources for high-stakes work. Frontier is for research too long to finish inside a request and runs in background mode only. Start with Lite and scale up as your use case demands more depth.\"}},{\"@type\":\"Question\",\"name\":\"Is the MCP server billed separately?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"No. The MCP server uses the same API keys and credits as the REST API. Calls made through the MCP server are billed at the same rate as direct API calls.\"}},{\"@type\":\"Question\",\"name\":\"Do you offer volume or annual discounts?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"Yes. For usage above 1M calls per month, contact sales for custom pricing. Enterprise plans include negotiated rates, custom QPS limits, and dedicated support.\"}},{\"@type\":\"Question\",\"name\":\"Can I get a DPA? Is there zero data retention?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"Yes. Zero Data Retention (ZDR) is available on enterprise plans. All queries and responses are automatically purged and never stored. Contact sales to enable ZDR for your account.\"}},{\"@type\":\"Question\",\"name\":\"Is there anything for startups?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"Yes. We offer extended free credits for eligible early-stage startups. Contact sales with your company details to apply.\"}}]}]13:[\"$\",\"$1\",\"c\",{\"children\":[[[\"$\",\"script\",null,{\"type\":\"application/ld+json\",\"dangerouslySetInnerHTML\":{\"__html\":\"$22\"}}],\"$L23\",\"$L24\",\"$L25\",\"$L26\",\"$L27\",\"$L28\",\"$L29\"],[\"$L2a\",\"$L2b\",\"$L2c\",\"$L2d\",\"$L2e\",\"$L2f\",\"$L30\",\"$L31\",\"$L32\",\"$L33\",\"$L34\",\"$L35\",\"$L36\",\"$L37\"],\"$L38\"]}]\n15:[\"$\",\"$1\",\"h\",{\"children\":[null,[\"$\",\"$L39\",null,{\"children\":\"$L3a\"}],[\"$\",\"div\",null,{\"hidden\":true,\"children\":[\"$\",\"$L3b\",null,{\"children\":[\"$\",\"$3c\",null,{\"name\":\"Next.Metadata\",\"children\":\"$L3d\"}]}]}],[\"$\",\"meta\",null,{\"name\":\"next-size-adjust\",\"content\":\"\"}]]}]\n17:[\"$\",\"link\",\"0\",{\"rel\":\"stylesheet\",\"href\":\"/_next/static/chunks/21lpvxuoy1o4f.css\",\"precedence\":\"next\",\"crossOrigin\":\"$undefined\",\"nonce\":\"ODM4OTM0MTUtNzE2Ni00ZDRiLWI0ZGMtMmVjMmY1ZTIxMDhl\"}]\n18:[\"$\",\"link\",\"1\",{\"rel\":\"stylesheet\",\"href\":\"/_next/static/chunks/2_4nqhbcx7qkp.css\",\"precedence\":\"next\",\"crossOrigin\":\"$undefined\",\"nonce\":\"ODM4OTM0MTUtNzE2Ni00ZDRiLWI0ZGMtMmVjMmY1ZTIxMDhl\"}]\n19:[\"$\",\"link\",\"2\",{\"rel\":\"stylesheet\",\"href\":\"/_next/static/chunks/11e_7as77d06o.css\",\"precedence\":\"next\",\"crossOrigin\":\"$undefined\",\"nonce\":\"ODM4OTM0MTUtNzE2Ni00ZDRiLWI0ZGMtMmVjMmY1ZTIxMDhl\"}]\n1a:[\"$\",\"link\",\"3\",{\"rel\":\"stylesheet\",\"href\":\"/_next/static/chunks/1cflfeorcddqp.css\",\"precedence\":\"next\",\"crossOrigin\":\"$undefined\",\"nonce\":\"ODM4OTM0MTUtNzE2Ni00ZDRiLWI0ZGMtMmVjMmY1ZTIxMDhl\"}]\n1b:[\"$\",\"link\",\"4\",{\"rel\":\"stylesheet\",\"href\":\"/_next/static/chunks/41igz5_sxvw7h.css\",\"pre