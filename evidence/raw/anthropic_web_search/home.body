"72\",{\"level\":3,\"slug\":\"max-uses\",\"children\":[\"Max uses\"]}]\n9f:[\"$\",\"p\",\"74\",{\"children\":[\"The \",[\"$\",\"code\",\"1\",{\"children\":[\"max_uses\"]}],\" parameter limits the number of searches performed. If Claude attempts more searches than allowed, the \",[\"$\",\"code\",\"3\",{\"children\":[\"web_search_tool_result\"]}],\" is an error with the \",[\"$\",\"code\",\"5\",{\"children\":[\"max_uses_exceeded\"]}],\" error code.\"]}]\na0:[\"$\",\"p\",\"76\",{\"children\":[\"Simple factual queries typically use 1–3 searches; comparative or multientity research can use 10 or more. For guidance on choosing a value, see \",[\"$\",\"$L80\",\"1\",{\"href\":\"/docs/en/agents-and-tools/tool-use/server-tools\",\"untracked\":false,\"children\":[\"Server tools\"]}],\".\"]}]\na1:[\"$\",\"$Ld8\",\"78\",{\"level\":3,\"slug\":\"domain-filtering\",\"children\":[\"Domain filtering\"]}]\na2:[\"$\",\"p\",\"80\",{\"children\":[\"Provide \",[\"$\",\"code\",\"1\",{\"children\":[\"allowed_domains\"]}],\" or \",[\"$\",\"code\",\"3\",{\"children\":[\"blocked_domains\"]}],\", not both. If a request includes both, the API returns a 400 error. Entries are bare domains with an optional path, for example \",[\"$\",\"code\",\"5\",{\"children\":[\"example.com\"]}],\" or \",[\"$\",\"code\",\"7\",{\"children\":[\"example.com/blog\"]}],\", without a scheme.\"]}]\na3:[\"$\",\"p\",\"83\",{\"children\":[\"For the full domain filtering rules, see \",[\"$\",\"$L80\",\"1\",{\"href\":\"/docs/en/agents-and-tools/tool-use/server-tools#domain-filtering\",\"untracked\":false,\"children\":[\"Domain filtering\"]}],\" in the Server tools guide.\"]}]\na4:[\"$\",\"p\",\"85\",{\"children\":[\"On \",[\"$\",\"$L80\",\"1\",{\"href\":\"/docs/en/managed-agents/overview\",\"untracked\":false,\"children\":[\"Claude Managed Agents\"]}],\", set these fields on the \",[\"$\",\"code\",\"3\",{\"children\":[\"web_search\"]}],\" entry of the agent toolset; see \",[\"$\",\"$L80\",\"5\",{\"href\":\"/docs/en/managed-agents/tools-web-restrictions\",\"untracked\":false,\"children\":[\"Restrict web search and web fetch domains\"]}],\".\"]}]\na5:[\"$\",\"$Ld8\",\"87\",{\"level\":3,\"slug\":\"localization\",\"children\":[\"Localization\"]}]\na6:[\"$\",\"p\",\"89\",{\"children\":[\"The \",[\"$\",\"code\",\"1\",{\"children\":[\"user_location\"]}],\" parameter allows you to localize search results based on a user's location. Provide at least one of \",[\"$\",\"code\",\"3\",{\"children\":[\"city\"]}],\", \",[\"$\",\"code\",\"5\",{\"children\":[\"region\"]}],\", \",[\"$\",\"code\",\"7\",{\"children\":[\"country\"]}],\", or \",[\"$\",\"code\",\"9\",{\"children\":[\"timezone\"]}],\".\"]}]\na7:[\"$\",\"ul\",\"91\",{\"children\":[\"\\n\",[\"$\",\"li\",\"1\",{\"children\":[[\"$\",\"code\",\"0\",{\"children\":[\"type\"]}],\": The type of location (must be \",[\"$\",\"code\",\"2\",{\"children\":[\"approximate\"]}],\")\"]}],\"\\n\",[\"$\",\"li\",\"3\",{\"children\":[[\"$\",\"code\",\"0\",{\"children\":[\"city\"]}],\": The city name\"]}],\"\\n\",[\"$\",\"li\",\"5\",{\"children\":[[\"$\",\"code\",\"0\",{\"children\":[\"region\"]}],\": The region or state\"]}],\"\\n\",[\"$\",\"li\",\"7\",{\"children\":[[\"$\",\"code\",\"0\",{\"children\":[\"country\"]}],\": The two-letter \",[\"$\",\"$L80\",\"2\",{\"href\":\"https://en.wikipedia.org/wiki/ISO_3166-1_alpha-2\",\"untracked\":false,\"child3d:o8d0,ren\":[\"ISO 3166-1 alpha-2\"]}],\" country code. The API rejects unsupported country codes with a 400 error.\"]}],\"\\n\",[\"$\",\"li\",\"9\",{\"children\":[[\"$\",\"code\",\"0\",{\"children\":[\"timezone\"]}],\": The \",[\"$\",\"$L80\",\"2\",{\"href\":\"https://en.wikipedia.org/wiki/List_of_tz_database_time_zones\",\"untracked\":false,\"children\":[\"IANA timezone ID\"]}],\".\"]}],\"\\n\"]}]\na8:[\"$\",\"p\",\"93\",{\"children\":[\"On Claude Managed Agents, the \",[\"$\",\"code\",\"1\",{\"children\":[\"web_search\"]}],\" entry of the agent toolset accepts a \",[\"$\",\"code\",\"3\",{\"children\":[\"user_location\"]}],\" object with the same fields. The API rejects an unsupported \",[\"$\",\"code\",\"5\",{\"children\":[\"country\"]}],\" code with a 400 error when you create or update the agent, or when you create or update a session that supplies the setting. See the \",[\"$\",\"$L80\",\"7\",{\"href\":\"/docs/en/managed-agents/tools-web-restrictions#settings\",\"untracked\":false,\"children\":[\"web tool settings\"]}],\".\"]}]\na9:[\"$\",\"$Ld8\",\"95\",{\"level\":3,\"slug\":\"response-inclusion\",\"children\":[\"Response inclusion\"]}]\naa:[\"$\",\"$L7f\",\"97\",{\"variant\":\"muted\",\"id\":\"$undefined\",\"icon\":\"$undefined\",\"className\":\"prose-block [.prose_\u0026]:text-prose print:break-inside-avoid print:[:is(h2,h3,h4)+\u0026]:break-after-avoid\",\"children\":[[\"$\",\"p\",\"0\",{\"children\":[\"Requires \",[\"$\",\"code\",\"1\",{\"children\":[\"web_search_20260318\"]}],\" or later.\"]}]]}]\nab:[\"$\",\"p\",\"99\",{\"children\":[\"The \",[\"$\",\"code\",\"1\",{\"children\":[\"response_inclusion\"]}],\" parameter controls how search result blocks appear in the API response when the result was consumed by a completed \",[\"$\",\"$L80\",\"3\",{\"href\":\"/docs/en/agents-and-tools/tool-use/code-execution-tool\",\"untracked\":false,\"children\":[\"code execution\"]}],\" call in the same turn. Set \",[\"$\",\"code\",\"5\",{\"children\":[\"\\\"response_inclusion\\\": \\\"excluded\\\"\"]}],\" to drop those nested \",[\"$\",\"code\",\"7\",{\"children\":[\"server_tool_use\"]}],\" and result block pairs entirely from the response, reducing output token costs for agentic workflows that don't need to echo raw search content back to the client. The default is \",[\"$\",\"code\",\"9\",{\"children\":[\"\\\"full\\\"\"]}],\". Results from direct calls, or from code execution calls that paused before completing, are always returned in full so they can be sent back on the next turn.\"]}]\nee:T6b0,3d:o6b0,\u003cpre class=\"shiki shiki-themes github-light-default dark-plus\" styl