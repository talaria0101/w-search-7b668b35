a 400 \",[\"$\",\"code\",\"3\",{\"children\":[\"invalid_request_error\"]}],\" that says web search is not enabled, rather than an \",[\"$\",\"$Ld4\",\"5\",{\"href\":\"#errors\",\"untracked\":false,\"children\":[\"error code\"]}],\" inside a search result.\"]}]]}]\neb:[\"$\",\"p\",\"58\",{\"children\":[\"These organization-level settings in the Claude Console apply to Messages API requests only. \",[\"$\",\"$Ld4\",\"1\",{\"href\":\"/docs/en/managed-agents/overview\",\"untracked\":false,\"children\":[\"Claude Managed Agents\"]}],\" sessions use the per-tool \",[\"$\",\"code\",\"3\",{\"children\":[\"allowed_domains\"]}],\" and \",[\"$\",\"code\",\"5\",{\"children\":[\"blocked_domains\"]}],\" lists on the agent toolset instead; see \",[\"$\",\"$Ld4\",\"7\",{\"href\":\"/docs/en/managed-agents/tools-web-restrictions\",\"untracked\":false,\"children\":[\"Restrict web search and web fetch domains\"]}],\". For a session in a cloud environment with \",[\"$\",\"code\",\"9\",{\"children\":[\"limited\"]}],\" networking, the environment's \",[\"$\",\"code\",\"11\",{\"children\":[\"allowed_hosts\"]}],\" also applies to \",[\"$\",\"code\",\"13\",{\"children\":[\"web_search\"]}],\" and \",[\"$\",\"code\",\"15\",{\"children\":[\"web_fetch\"]}],\"; see \",[\"$\",\"$Ld4\",\"17\",{\"href\":\"/docs/en/managed-agents/environments#networking\",\"untracked\":false,\"children\":[\"Networking\"]}],\". The per-tool lists restrict these tools further, within the hosts that \",[\"$\",\"code\",\"19\",{\"children\":[\"allowed_hosts\"]}],\" allows.\"]}]\nec:[\"$\",\"p\",\"60\",{\"children\":[\"Provide the web search tool in your API request:\"]}]\n13b:T11b1,\u003cpre class=\"shiki shiki-themes github-light-default dark-plus\" style=\"--shiki-light:#1f2328;--shiki-dark:#f3f7f6;--shiki-light-bg:transparent;--shiki-dark-bg:transparent\"\u003e\u003ccode\u003e\u003cspan class=\"line\"\u003e\u003cspan style=\"--shiki-light:#953800;--shiki-dark:#DCDCAA\"\u003ecurl\u003c/span\u003e\u003cspan style=\"--shik