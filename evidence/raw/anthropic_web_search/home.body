hildren\":[\"too_many_requests\"]}],\": Rate limit exceeded\"]}],\"\\n\",[\"$\",\"li\",\"3\",{\"children\":[[\"$\",\"code\",\"0\",{\"children\":[\"invalid_tool_input\"]}],\": Invalid search query parameter\"]}],\"\\n\",[\"$\",\"li\",\"5\",{\"children\":[[\"$\",\"code\",\"0\",{\"children\":[\"max_uses_exceeded\"]}],\": Maximum web search tool uses exceeded\"]}],\"\\n\",[\"$\",\"li\",\"7\",{\"children\":[[\"$\",\"code\",\"0\",{\"children\":[\"query_too_long\"]}],\": Query exceeds maximum length\"]}],\"\\n\",[\"$\",\"li\",\"9\",{\"children\":[[\"$\",\"code\",\"0\",{\"children\":[\"request_too_large\"]}],\": The search request is too large, typically because of a long domain filter list\"]}],\"\\n\",[\"$\",\"li\",\"11\",{\"children\":[[\"$\",\"code\",\"0\",{\"children\":[\"unavailable\"]}],\": An internal error occurred\"]}],\"\\n\"]}]\nc0:[\"$\",\"$Ld8\",\"141\",{\"level\":3,\"slug\":\"pause-turn-stop-reason\",\"children\":[[\"$\",\"code\",\"0\",{\"children\":[\"pause_turn\"]}],\" stop reason\"]}]\nc1:[\"$\",\"p\",\"143\",{\"children\":[\"The API can pause a long-running search turn and return \",[\"$\",\"code\",\"1\",{\"children\":[\"stop_reason: \\\"pause_turn\\\"\"]}],\". To continue, send the paused assistant message back unchanged in a new request.\"]}]\nc2:[\"$\",\"p\",\"145\",{\"children\":[\"If Claude calls web search and one of your client tools in the same group of parallel tool calls, the API returns \",[\"$\",\"code\",\"1\",{\"children\":[\"stop_reason: \\\"tool_use\\\"\"]}],\" instead and does not run the search yet. To continue, return the client tool results, and the API runs the search in the next request. See \",[\"$\",\"$L80\",\"3\",{\"href\":\"/docs/en/agents-and-tools/tool-use/server-tools#mixing-server-tools-and-client-tools-in-one-turn\",\"untracked\":false,\"children\":[\"Mixing server tools and client tools in one turn\"]}],\".\"]}]\nc3:[\"$\",\"p\",\"148\",{\"children\":[\"For the server-side loop and \",[\"$\",\"code\",\"1\",{\"children\":[\"pause_turn\"]}],\" handling, see \",[\"$\",\"$L80\",\"3\",{\"href\":\"/docs/en/agents-and-tools/tool-use/server-tools#the-server-side-loop-and-pause-turn\",\"untracked\":false,\"children\":[\"The server-side loop and pause_turn\"]}],\" in the Server tools guide.\"]}]\nc4:[\"$\",\"$Ld8\",\"150\",{\"level\":2,\"slug\":\"prompt-caching\",\"children\":[\"Prompt caching\"]}]\nc5:[\"$\",\"p\",\"153\",{\"children\":[\"To cache tool definitions across turns, see \",[\"$\",\"$L80\",\"1\",{\"href\":\"/docs/en/agents-and-tools/tool-use/tool-use-with-prompt-caching\",\"untracked\":false,\"children\":[\"Tool use with prompt caching\"]}],\".\"]}]\nc6:[\"$\",\"$Ld8\",\"155\",{\"level\":2,\"slug\":\"streaming\",\"children\":[\"Streaming\"]}]\nc7:[\"$\",\"p\",\"157\",{\"children\":[\"With streaming enabled, you'll receive search events as part of the stream. There will be a pause while the search runs:\"]}]\nf1:T26e4,3d:o26e4,\u003cpre class=\"shiki shiki-themes github-light-default dark-plus\" style=\"--shiki-light:#1f2328;--shiki-dark:#f3f7f6;--shiki-light-bg:transparent;--shiki-dark-bg:transparent\"\u003e\u003ccode\u003e\u003cspan class=\"line\"\u003e\u003cspan style=\"--shiki-light:#1F2328;--shiki-dark:#f3f7f6\"\u003eevent: message_start\u003c/span\u003e\u003c/span\u003e\n\u003cspan class=\"line\"\u003e\u003cspan style=\"--shiki-light:#1F2328;--shiki-dark:#f3f7f6\"\u003edata: {\u003c/span\u003e\u003cspan style=\"--shiki-light:#116329;--shiki-dark:#9CDCFE\"\u003e\"type\"\u003c/span\u003e\u003cspan style=\"--shiki-light:#1F2328;--shiki-dark:#f3f7f6\"\u003e: \u003c/span\u003e\u003cspan style=\"--shiki-light:#0A3069;--shiki-dark:#CE9178\"\u003e\"message_start\"\u003c/span\u003e\u003cspan style=\"--shiki-light:#1F2328;--shiki-dark:#f3f7f6\"\u003e, \u003c/span\u003e\u003cspan style=\"--shiki-light:#116329;--shiki-dark:#9CDCFE\"\u003e\"message\"\u003c/span\u003e\u003cspan style=\"--shiki-light:#1F2328;--shiki-dark:#f3f7f6\"\u003e: {\u003c/span\u003e\u003cspan style=\"--shiki-light:#1163