:[\"content\"]}],\" list, not an error.\"]}]\n112:[\"$\",\"p\",\"137\",{\"children\":[\"These are the possible error codes:\"]}]\n113:[\"$\",\"ul\",\"139\",{\"children\":[\"\\n\",[\"$\",\"li\",\"1\",{\"children\":[[\"$\",\"code\",\"0\",{\"children\":[\"too_many_requests\"]}],\": Rate limit exceeded\"]}],\"\\n\",[\"$\",\"li\",\"3\",{\"children\":[[\"$\",\"code\",\"0\",{\"children\":[\"invalid_tool_input\"]}],\": Invalid search query parameter\"]}],\"\\n\",[\"$\",\"li\",\"5\",{\"children\":[[\"$\",\"code\",\"0\",{\"children\":[\"max_uses_exceeded\"]}],\": Maximum web search tool uses exceeded\"]}],\"\\n\",[\"$\",\"li\",\"7\",{\"children\":[[\"$\",\"code\",\"0\",{\"children\":[\"query_too_long\"]}],\": Query exceeds maximum length\"]}],\"\\n\",[\"$\",\"li\",\"9\",{\"children\":[[\"$\",\"code\",\"0\",{\"children\":[\"request_too_large\"]}],\": The search request is too large, typically because of a long domain filter list\"]}],\"\\n\",[\"$\",\"li\",\"11\",{\"children\":[[\"$\",\"code\",\"0\",{\"children\":[\"unavailable\"]}],\": An internal error occurred\"]}],\"\\n\"]}]\n114:[\"$\",\"$L12f\",\"141\",{\"level\":3,\"slug\":\"pause-turn-stop-reason\",\"children\":[[\"$\",\"code\",\"0\",{\"children\":[\"pause_turn\"]}],\" stop reason\"]}]\n115:[\"$\",\"p\",\"143\",{\"children\":[\"The API can pause a long-running search turn and return \",[\"$\",\"code\",\"1\",{\"children\":[\"stop_reason: \\\"pause_turn\\\"\"]}],\". To continue, send the paused assistant message back unchanged in a new request.\"]}]\n116:[\"$\",\"p\",\"145\",{\"children\":[\"If Claude calls web search and one of your client tools in the same group of parallel tool calls, the API returns \",[\"$\",\"code\",\"1\",{\"children\":[\"stop_reason: \\\"tool_use\\\"\"]}],\" instead and does not run the search yet. To continue, return the client tool results, and the API runs the search in the next request. See \",[\"$\",\"$Ld4\",\"3\",{\"href\":\"/docs/en/agents-and-tools/tool-use/server-tools#mixing-server-tools-