<span class="line"><span style="--shiki-light:#116329;--shiki-dark:#9CDCFE">  "type"</span><span style="--shiki-light:#1F2328;--shiki-dark:#f3f7f6">: </span><span style="--shiki-light:#0A3069;--shiki-dark:#CE9178">"web_search_20250305"</span><span style="--shiki-light:#1F2328;--shiki-dark:#f3f7f6">,</span></span>
<span class="line"><span style="--shiki-light:#116329;--shiki-dark:#9CDCFE">  "name"</span><span style="--shiki-light:#1F2328;--shiki-dark:#f3f7f6">: </span><span style="--shiki-light:#0A3069;--shiki-dark:#CE9178">"web_search"</span><span style="--shiki-light:#1F2328;--shiki-dark:#f3f7f6">,</span></span>
<span class="line"></span>
<span class="line"><span style="--shiki-light:#6E7781;--shiki-dark:#6A9955">  // Optional: Limit the number of searches per request</span></span>
<span class="line"><span style="--shiki-light:#116329;--shiki-dark:#9CDCFE">  "max_uses"</span><span style="--shiki-light:#1F2328;--shiki-dark:#f3f7f6">: </span><span style="--shiki-light:#0550AE;--shiki-dark:#B5CEA8">5</span><span style="--shiki-light:#1F2328;--shiki-dark:#f3f7f6">,</span></span>
<span class="line"></span>
<span class="line"><span style="--shiki-light:#6E7781;--shiki-dark:#6A9955">  // Optional: Only include results from these domains.</span></span>
<span class="line"><span style="--shiki-light:#6E7781;--shiki-dark:#6A9955">  // Use allowed_domains or blocked_domains, not both.</span></span>
<span class="line"><span style="--shiki-light:#116329;--shiki-dark:#9CDCFE">  "allowed_domains"</span><span style="--shiki-light:#1F2328;--shiki-dark:#f3f7f6">: [</span><span style="--shiki-light:#0A3069;--shiki-dark:#CE9178">"example.com"</span><span style="--shiki-light:#1F2328;--shiki-dark:#f3f7f6">, </span><span style="--shiki-light:#0A3069;--shiki-dark:#CE9178">"trusteddomain.org"</span><span style="--shiki-light:#1F2328;--shiki-dark:#f3f7f6">],</span></span>
<span class="line"></span>
<span class="line"><span style="--shiki-light:#6E7781;--shiki-dark:#6A9955">  // Optional: Never include results from these domains</span></span>
<span class="line"><span style="--shiki-light:#116329;--shiki-dark:#9CDCFE">  "blocked_domains"</span><span style="--shiki-light:#1F2328;--shiki-dark:#f3f7f6">: [</span><span style="--shiki-light:#0A3069;--shiki-dark:#CE9178">"untrustedsource.com"</span><span style="--shiki-light:#1F2328;--shiki-dark:#f3f7f6">],</span></span>
