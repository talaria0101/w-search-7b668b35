cell pricingTable-cell--text"><span>250+</span></td></tr><tr style="--accent-color:var(--color-pale-lime)"><th class="pricingTable-cell pricingTable-cell--text" scope="row"><span>Browser hours</span></th><td class="pricingTable-cell pricingTable-cell--text"><span>1</span></td><td class="pricingTable-cell pricingTable-cell--text"><span>100</span><span><span> then $0.12/browser hr</span></span></td><td class="pricingTable-cell pricingTable-cell--text"><span>500</span><span><span> then $0.10/browser hr</span></span></td><td class="pricingTable-cell pricingTable-cell--text"><span>Usage-based</span></td></tr><tr style="--accent-color:var(--color-pale-lime)"><th class="pricingTable-cell pricingTable-cell--text" scope="row"><span>Agent runs</span></th><td class="pricingTable-cell pricingTable-cell--text"><span>3</span></td><td class="pricingTable-cell pricingTable-cell--text"><span>15</span></td><td class="pricingTable-cell pricingTable-cell--text"><span>50</span></td><td class="pricingTable-cell pricingTable-cell--text"><span>Custom</span></td></tr><tr style="--accent-color:var(--color-pale-lime)"><th class="pricingTable-cell pricingTable-cell--text" scope="row"><span>Search API</span></th><td class="pricingTable-cell pricingTable-cell--text"><span>1,000</span></td><td class="pricingTable-cell pricingTable-cell--text"><span>1,000</span><span><span>- $1/1k for Parallel Fast</span><span><br/>- $5/1k for Parallel Advanced</span><span><br/>- $7/1k for Exa</span></span></td><td class="pricingTable-cell pricingTable-cell--text"><span>1,000</span><span><span>- $1/1k for Parallel Fast</span><span><br/>- $5/1k for Parallel Advanced</span><span><br/>- $7/1k for Exa</span></span></td><td class="pricingTable-cell pricingTable-cell--text"><span>Usage-based</span></td></tr><tr style="--accent-color:var(--color-pale-lime)"><th class="pricingTable-cell pricingTable-cell--text" scope="row"><span>Search RPS</span><span><span>(per project)</span></span></th><td class="pricingTable-cell pricingTable-cell--text"><span>2</span></td><td class="pricingTable-cell pricingTable-cell--text"><span>2</span></td><td class="pricingTable-cell pricingTable-cell--text"><span>2</span></td><td class="pricingTable-cell pricingTable-cell--text"><span>Custom</span></td></tr><tr style="--accent-color:var(--color-pale-lime)"><th class="pricingTable-cell pricingTable-cell--text" scope="row"><span>Fetch API</span></th><td class="pricingTable-cell pricingTable-cell--text"><span>1,000</span></td><td class="pricingTable-cell pricingTable-cell--text"><span>1,000</span><span><span>- $1/1k calls</span><span><br/>- $4/1k w/ Proxies</span><span><br/>- $4/1k w/ Extract</span><span><br/>- $7/1k w/ Proxies + Extract</span></span></td><td class="pricingTable-cell pricingTable-cell--text"><span>10,000</span><span><span>- $0.5/1k calls</span><span><br/>- $4/1k w/ Proxies</span><span><br/>- $4/1k w/ Extract</span><span><br/>- $7/1k w/ Proxies + Extract</span></span></td><td class="pricingTable-cell pricingTable-cell--text"><span>Usage-based</span></td></tr><tr style="--accent-color:var(--color-pale-lime)"><th class="pricingTable-cell pricingTable-cell--text" scope="row"><span>Fetch RPS</span><span><span>(per project)</span></span></th><td class="pricingTable-cell pricingTable-cell--text"><span>5</span></td><td class="pricingTable-cell pricingTable-cell--text"><span>5</span></td><td class="pricingTable-cell pricingTable-cell--text"><span>5</span></td><td class="pricingTable-cell pricingTable-cell--text"><span>Custom</span></td></tr><tr><th class="type-heading-4" scope="rowgroup">Capabilities</th></tr><tr style="--accent-color:var(--color-extra-pale-magenta)"><th class="pricingTable-cell pricingTable-cell--text" scope="row"><span>Runtime: Browserbase Functions</span></th><td class="pricingTable-cell pricingTable-cell--text"><span class="is-visually-hidden">Yes</span><svg aria-hidden="true" class="material-symbols-outlined" fill="currentColor" focusable="false" height="24" viewBox="0 -960 960 