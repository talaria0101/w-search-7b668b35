ite_name" content="Browserbase"/><meta property="og:image" content="https://cdn.sanity.io/images/yd6zslid/production/150f4783739729cce34cd1a71ecbd63e0a4de5a9-1824x960.png?rect=0,4,1824,953&amp;w=1200&amp;h=627&amp;fit=crop"/><meta property="og:image:width" content="1200"/><meta property="og:image:height" content="627"/><meta property="og:type" content="website"/><meta name="twitter:card" content="summary_large_image"/><meta name="twitter:title" content="Browserbase"/><meta name="twitter:description" content="Give your agents access to the whole web."/><meta name="twitter:image" content="https://cdn.sanity.io/images/yd6zslid/production/150f4783739729cce34cd1a71ecbd63e0a4de5a9-1824x960.png?rect=0,4,1824,953&amp;w=1200&amp;h=627&amp;fit=crop"/><meta name="twitter:image:width" content="1200"/><meta name="twitter:image:height" content="627"/><link rel="icon" href="/favicon.ico" sizes="any"/><link rel="icon" href="/favicon.svg" type="image/svg+xml"/><link rel="apple-touch-icon" href="/apple-touch-icon.png"/><link rel="preload" as="image" href="/website-assets/homepage/hero-loopA-designer-desktop-poster.webp" media="(min-width: 961px)" fetchPriority="high"/><link rel="preload" as="image" href="/website-assets/homepage/hero-loopA-designer-mobile-poster.webp" media="(max-width: 960px)" fetchPriority="high"/><script src="/website-assets/_next/static/immutable/chunks/0c0hxoamwjsbw.js" noModule=""></script></head><body><div hidden=""><!--$--><!--/$--></div><!--$?--><template id="B:0"></template><!--/$--><!--$?--><template id="B:2"></template><!--/$--><!--$--><!--&--><!--$--><!--$?--><template id="B:3"></template><noscript><div class="body theme-light"><main id="main" class="type-body wrapper"><section class="section headline"><div class="grid"><div class="textLockUp textLockUp--center headline__textLockUp"><div class="textLockUp__content"><p class="textLockUp__eyebrow type-eyebrow-plain">Browserbase</p><h1 class="textLockUp__title u-wordbreak type-heading-1">Give your agents access to the whole web.</h1><p class="textLockUp__subhead type-subhead-2">Browserbase makes the web as reliable and programmable as APIs</p></div></div></div></section><section class="section headline theme-dark"><div class="grid"><div class="textLockUp headline__textLockUp"><div class="textLockUp__content"><h2 class="textLockUp__title u-wordbreak type-heading-2">The complete platform to run agents that use the web like humans.</h2><p class="textLockUp__body type-body-3">Browserbase is the complete platform to build and deploy agents that browse and interact with the web like humans. One API key gives agents everything they need: browsers at the center that navigate, fill forms, and act where APIs can&#x27;t, plus Search and Fetch for fast, token-efficient web context, and Agent Identity to get past anti-bot systems, CAPTCHAs, and authentication walls, with best-in-class observability (rich logs, live view, and session replay) and scalable, secure, SOC-2 Type II infrastructure underneath. Browserbase runs 35m+ browser sessions a month across 10,000 customers, including Ramp, Microsoft, and Lovable.</p><nav aria-label="Browserbase product resources"><ul><li><a href="/browsers/">Browsers</a></li><li><a href="/stagehand/">Stagehand®</a></li><li><a href="/templates/">Templates</a></li><li><a href="https://docs.browserbase.com/">Docs</a></li></ul></nav></div></div></div></section></main></div></noscript><!--/$--><!--/$--><!--$--><!--/$--><!--/&--><!--/$--><script>requestAnimationFrame(function(){$RT=performance.now()});</script><script src="/website-assets/_next/static/immutable/chunks/1w-om0dabnuzh.js" id="_R_" async=""></script><div hidden id="S:3"><div class="body theme-light"><header class="nav" role="banner"><a class="skip-link" href="#main">Skip to content</a><div class="nav__container"><a class="nav__branding" href="/"><div class="nav__branding__wordmark"><svg fill="none" viewBox="0 0 255 50" xmlns="http://www.w3.org/2000/svg"><path d="M41 9.002H7.5v31H41z" fill="v