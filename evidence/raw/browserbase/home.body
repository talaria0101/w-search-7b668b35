g="lazy" autoPlay="" data-video-autoplay="" loop="" muted="" playsInline="" preload="metadata"></video></div></figure><div class="feature__content | stack"><div class="textLockUp textLockUp--left feature__textLockUp"><div class="textLockUp__content"><h3 class="textLockUp__title u-wordbreak "><span>Search API</span></h3><div class="textLockUp__body stack text "><p>Web search, built for agents. Let your Agent quickly find relevant websites based on a single query.</p></div><div class="textLockUp__cta"><div class="feature__cta"><a class="btn btn--compact" href="/sign-up"><span class="btn__text">Try for free</span></a></div></div></div></div></div></div></fk-scroll-reveal></section></li><li style="--index:1"><section class="section feature feature--right feature--wide"><fk-scroll-reveal><div class="grid feature--content-center"><figure class="feature__media feature__media--right feature--video"><div class="frame"><video src="https://cdn.sanity.io/files/yd6zslid/production/5fe7eb597c5442c8a11f0b5a39667fa6dc8eeec1.mp4" loading="lazy" autoPlay="" data-video-autoplay="" loop="" muted="" playsInline="" preload="metadata"></video></div></figure><div class="feature__content | stack"><div class="textLockUp textLockUp--left feature__textLockUp"><div class="textLockUp__content"><h3 class="textLockUp__title u-wordbreak "><span>Fetch API</span></h3><div class="textLockUp__body stack text "><p>Quickly fetch web context for your agent by converting any URL into HTML, JSON or markdown</p></div><div class="textLockUp__cta"><div class="feature__cta"><a class="btn btn--compact" href="/sign-up"><span class="btn__text">Try for free</span></a></div></div></div></div></div></div></fk-scroll-reveal></section></li><li style="--index:2"><section class="section feature feature--right feature--wide"><fk-scroll-reveal><div class="grid feature--content-center"><figure class="feature__media feature__media--right feature--video"><div class="frame"><video src="https://cdn.sanity.io/files/yd6zslid/production/e094ff16525b73ce8d73264da3be1eb47946c0b4.mp4" loading="lazy" autoPlay="" data-video-autoplay="" loop="" muted="" playsInline="" preload="metadata"></video></div></figure><div class="feature__content | stack"><div class="textLockUp textLockUp--left feature__textLockUp"><div class="textLockUp__content"><h3 class="textLockUp__title u-wordbreak "><span>Browser-as-a-Service</span></h3><div class="textLockUp__body stack text "><p>Give your agent a real browser to use the web like a human. Navigating interactive website and performing complex actions, without interruptions.</p></div><div class="textLockUp__cta"><div class="feature__cta"><a class="btn btn--compact" href="/sign-up"><span class="btn__text">Try for free</span></a></div></div></div></div></div></div></fk-scroll-reveal></section></li></ul></div></section><div aria-hidden="true"><div class="divider"><div class="divider-flex"><div class="divider__item"></div><div class="divider__item"></div><div class="divider__item"></div><div class="divider__item"></div><div class="divider__item"></div><div class="divider__item"></div><div class="divider__item"></div><div class="divider__item"></div><div class="divider__item"></div><div class="divider__item"></div><div class="divider__item"></div><div class="divider__item"></div><div class="divider__item"></div></div><div class="divider-grid"><div class="divider__line" style="--divider-column:10;--divider-column-md:5;--divider-column-sm:3;--divider-inline-align:end;--divider-block-align:end;--divider-color:var(--color-primary-director-blue)"></div><div class="divider__square" style="--divider-column:2;--divider-column-md:1;--divider-column-sm:1;--divider-inline-align:end;--divider-block-align:start;--divider-color:var(--color-primary-navy)"></div></div></div></div><section class="spotlight"><div class="grid"><div class="spotlight__content grid"><div class="spotlight__text"><div class="spotlight__header"><div class="textLockUp textLockUp--left spotlight__textLockUp u-accent-bg--primary-yellow" data-style-variant="heading-2"><div class="textLockUp__content"><h2 class="textLockUp__title u-wordbreak type-heading-2" style="--color-split-words-bg:var(--color-primary-yellow)"><span class="is-visually-hidden">Use the whole web like it’s an API.</span><fk-split-words aria-hidden="true" data-align="left"><span>Use</span><span>the</span><span>whole</span><span>web</span><span>like</span><span>it’s</span><span>an</span><span>API.</span></fk-split-words></h2><div class="textLockUp__body stack text type-body-3"><p>The browser is the web’s native interface.</p><p>Now your agents can use it seamlessly to deliver new possibilities.</p></div></div></div></div><div class="spotlight__list type-chip u-accent-bg--pale-blue"><h3 class="spotlight__list-title"><span>Your <span class="u-accent">BRIDGE</span> between <span class="u-accent">AI</span> and the <span class="u-accent">DIGITAL WORLD</span></span></h3><ul class="spotlight__items"><li class="spotlight__item"><p>Handles auth, flows, dynamic content</p></li><li class="spotlight__item"><p>Mirrors human interaction</p></li><li class="spotlight__item"><p>Adjusts to updates and changes</p></li><li class="spotlight__item"><p>Navigates unpredictable UI</p></li><li class="spotlight__item"><p>Works everywhere</p></li></ul></div></div><figure class="spotlight__media"><img alt="Illustration of a desktop computer." loading="lazy" width="1828" height="826" decoding="async" data-nimg="1" style="color:transparent" srcSet="https://cdn.sanity.io/images/yd6zslid/production/7a9e5efa5fdbc5e2f6eb0beaace67c9fd2e732e9-1828x826.png?fm=webp&amp;h=723&amp;w=1600&amp;auto=format&amp;fit=min&amp;q=75 1x" src="https://cdn.sanity.io/images/yd6zslid/production/7a9e5efa5fdbc5e2f6eb0beaace67c9fd2e732e9-1828x826.png?fm=webp&amp;h=723&amp;w=1600&amp;auto=format&amp;fit=min&amp;q=75"/></figure></div><div class="spotlight__dividers grid" aria-hidden="true"><div class="spotlight-divider-left"><div class="spotlight-divider-bottom"></div></div></div></div></section><section class="multicardV2 section" data-card-type="cardStandard"><div class="multicardV2__container | grid"><div class="textLockUp textLockUp--left multicard__textLockUp u-accent-fg--primary-browserbase-red" data-style-variant="heading-2"><div class="textLockUp__content"><h2 class="textLockUp__title u-wordbreak type-heading-2"><span>Anything <span class="u-accent">you can do</span> in a browser, your agent can too.</span></h2><div class="textLockUp__subhead type-subhead-2"><p>Automate what’s tedious. Accelerate what’s ambitious.</p></div></div></div><div class="multicardV2__cards grid grid--4up"><article class="cardStandard"><div class="cardStandard__media frame"><img alt="" loading="lazy" width="294" height="270" decoding="async" data-nimg="1" style="color:transparent" sizes="(min-width: 960px) 25vw, (min-width: 481px) 50vw, 100vw" srcSet="https://cdn.sanity.io/images/yd6zslid/production/1387d9957e8fec87004b2d79e94a94875bf0923e-294x270.svg?auto=format&amp;h=88&amp;w=96&amp;fit=min&amp;q=75 96w, https://cdn.sanity.io/images/yd6zslid/production/1387d9957e8fec87004b2d79e94a94875bf0923e-294x270.svg?auto=format&amp;h=118&amp;w=128&amp;fit=min&amp;q=75 128w, https://cdn.sanity.io/images/yd6zslid/production/1387d9957e8fec87004b2d79e94a94875bf0923e-294x270.svg?auto=format&amp;h=235&amp;w=256&amp;fit=min&amp;q=75 256w, https://cdn.sanity.io/images/yd6zslid/production/1387d9957e8fec87004b2d79e94a94875bf0923e-294x270.svg?auto=format&amp;h=294&amp;w=320&amp;fit=min&amp;q=75 320w, https://cdn.sanity.io/images/yd6zslid/production/1387d9957e8fec87004b2d79e94a94875bf0923e-294x270.svg?auto=format&amp;h=353&amp;w=384&amp;fit=min&amp;q=75 384w, https://cdn.sanity.io/images/yd6zslid/production/1387d9957e8fec87004b2d79e94a94875bf0923e-294x270.svg?auto=format&amp;h=442&amp;w=481&amp;fit=min&amp;q=75 481w, https://cdn.sanity.io/images/yd6zslid/production/1387d9957e8fec87004b2d79e94a94875bf0923e-294x270.svg?auto=format&amp;h=551&amp;w=600&amp;fit=min&amp;q=75 600w, https://cdn.sanity.io/images/yd6zslid/production/1387d9957e8fec87004b2d79e94a94875bf0923e-294x270.svg?auto=format&amp;h=588&amp;w=640&amp;fit=min&amp;q=75 640w, https://cdn.sanity.io/images/yd6zslid/production/1387d9957e8fec87004b2d79e94a94875bf0923e-294x270.svg?auto=format&amp;h=882&amp;w=960&amp;fit=min&amp;q=75 960w, https://cdn.sanity.io/images/yd6zslid/production/1387d9957e8fec87004b2d79e94a94875bf0923e-294x270.svg?auto=format&amp;h=1029&amp;w=1120&amp;fit=min&amp;q=75 1120w, https://cdn.sanity.io/images/yd6zslid/production/1387d9957e8fec87004b2d79e94a94875bf0923e-294x270.svg?auto=format&amp;h=1176&amp;w=1280&amp;fit=min&amp;q=75 1280w, https://cdn.sanity.io/images/yd6zslid/production/1387d9957e8fec87004b2d79e94a94875bf0923e-294x270.svg?auto=format&amp;h=1469&amp;w=1600&amp;fit=min&amp;q=75 1600w" src="https://cdn.sanity.io/images/yd6zslid/production/1387d9957e8fec87004b2d79e94a94875bf0923e-294x270.svg?auto=format&amp;h=1469&amp;w=1600&amp;fit=min&amp;q=75"/></div><div class="cardStandard__textLockup"><h3 class="cardStandard__title type-subhead-3">Build agents that never sleep</h3><p class="cardStandard__body type-body-3-tight">Send your agent to search, organize, and act on data while you do literally anything else.</p><a class="btn btn--compact cardStandard__cta" href="/templates/getting-started-with-browserbase"><span class="btn__text">Get started</span></a></div></article><article class="cardStandard"><div class="cardStandard__media frame"><img alt="" loading="lazy" width="294" height="270" decoding="async" data-nimg="1" style="color:transparent" sizes="(min-width: 960px) 25vw, (min-width: 481px) 50vw, 100vw" srcSet="https://cdn.sanity.io/images/yd6zslid/production/f9e28933bbf6e765d03217896c44fb18d587fc9b-294x270.svg?auto=format&amp;h=88&amp;w=96&amp;fit=min&amp;q=75 96w, https://cdn.sanity.io/images/yd6zslid/production/f9e28933bbf6e765d03217896c44fb18d587fc9b-294x270.svg?auto=format&amp;h=118&amp;w=128&amp;fit=min&amp;q=75 128w, https://cdn.sanity.io/images/yd6zslid/production/f9e28933bbf6e765d03217896c44fb18d587fc9b-294x270.svg?auto=format&amp;h=235&amp;w=256&amp;fit=min&amp;q=75 256w, https://cdn.sanity.io/images/yd6zslid/production/f9e28933bbf6e765d03217896c44fb18d587fc9b-294x270.svg?auto=format&amp;h=294&amp;w=320&amp;fit=min&amp;q=75 320w, https://cdn.sanity.io/images/yd6zslid/production/f9e28933bbf6e765d03217896c44fb18d587fc9b-294x270.svg?auto=format&amp;h=353&amp;w=384&amp;fit=min&amp;q=75 384w, https://cdn.sanity.io/images/yd6zslid/production/f9e28933bbf6e765d03217896c44fb18d587fc9b-294x270.svg?auto=format&amp;h=442&amp;w=481&amp;fit=min&amp;q=75 481w, https://cdn.sanity.io/images/yd6zslid/production/f9e28933bbf6e765d03217896c44fb18d587fc9b-294x270.svg?auto=format&amp;h=551&amp;w=600&amp;fit=min&amp;q=75 600w, https://cdn.sanity.io/images/yd6zslid/production/f9e28933bbf6e765d03217896c44fb18d587fc9b-294x270.svg?auto=format&amp;h=588&amp;w=640&amp;fit=min&amp;q=75 640w, https://cdn.sanity.io/images/yd6zslid/production/f9e28933bbf6e765d03217896c44fb18d587fc9b-294x270.svg?auto=format&amp;h=882&amp;w=960&amp;fit=min&amp;q=75 960w, https://cdn.sanity.io/images/yd6zslid/production/f9e28933bbf6e765d03217896c44fb18d587fc9b-294x270.svg?auto=format&amp;h=1029&amp;w=1120&amp;fit=min&amp;q=75 1120w, https://cdn.sanity.io/images/yd6zslid/production/f9e28933bbf6e765d03217896c44fb18d587fc9b-294x270.svg?auto=format&amp;h=1176&amp;w=1280&amp;fit=min&amp;q=75 1280w, https://cdn.sanity.io/images/yd6zslid/production/f9e28933bbf6e765d03217896c44fb18d587fc9b-294x270.svg?auto=format&amp;h=1469&amp;w=1600&amp;fit=min&amp;q=75 1600w" src="https://cdn.sanity.io/images/yd6zslid/production/f9e28933bbf6e765d03217896c44fb18d587fc9b-294x270.svg?auto=format&amp;h=1469&amp;w=1600&amp;fit=min&amp;q=75"/></div><div class="cardStandard__textLockup"><h3 class="cardStandard__title type-subhead-3">Access the 85% APIs can’t reach</h3><p class="cardStandard__body type-body-3-tight">Your agent logs in, navigates, and pulls data from any website, login walls included.</p><a class="btn btn--compact cardStandard__cta" href="/templates/context"><span class="btn__text">Get started</span></a></div></article><article class="cardStandard"><div class="cardStandard__media frame"><img alt="" loading="lazy" width="294" height="270" decoding="async" data-nimg="1" style="color:transparent" sizes="(min-width: 960px) 25vw, (min-width: 481px) 50vw, 100vw" srcSet="https://cdn.sanity.io/images/yd6zslid/production/65e380f2c56a56472c2c8d6d3d927a22758b43ce-294x270.svg?auto=format&amp;h=88&amp;w=96&amp;fit=min&amp;q=75 96w, https://cdn.sanity.io/images/yd6zslid/production/65e380f2c56a56472c2c8d6d3d927a22758b43ce-294x270.svg?auto=format&amp;h=118&amp;w=128&amp;fit=min&amp;q=75 128w, https://cdn.sanity.io/images/yd6zslid/production/65e380f2c56a56472c2c8d6d3d927a22758b43ce-294x270.svg?auto=format&amp;h=235&amp;w=256&amp;fit=min&amp;q=75 256w, https://cdn.sanity.io/images/yd6zslid/production/65e380f2c56a56472c2c8d6d3d927a22758b43ce-294x270.svg?auto=format&amp;h=294&amp;w=320&amp;fit=min&amp;q=75 320w, https://cdn.sanity.io/images/yd6zslid/production/65e380f2c56a56472c2c8d6d3d927a22758b43ce-294x270.svg?auto=format&amp;h=353&amp;w=384&amp;fit=min&amp;q=75 384w, https://cdn.sanity.io/images/yd6zslid/production/65e380f2c56a56472c2c8d6d3d927a22758b43ce-294x270.svg?auto=format&amp;h=442&amp;w=481&amp;fit=min&amp;q=75 481w, https://cdn.sanity.io/images/yd6zslid/production/65e380f2c56a56472c2c8d6d3d927a22758b43ce-294x270.svg?auto=format&amp;h=551&amp;w=600&amp;fit=min&amp;q=75 600w, https://cdn.sanity.io/images/yd6zslid/production/65e380f2c56a56472c2c8d6d3d927a22758b43ce-294x270.svg?auto=format&amp;h=588&amp;w=640&amp;fit=min&amp;q=75 640w, https://cdn.sanity.io/images/yd6zslid/production/65e380f2c56a56472c2c8d6d3d927a22758b43ce-294x270.svg?auto=format&amp;h=882&amp;w=960&amp;fit=min&amp;q=75 960w, https://cdn.sanity.io/images/yd6zslid/production/65e380f2c56a56472c2c8d6d3d927a22758b43ce-294x270.svg?auto=format&amp;h=1029&amp;w=1120&amp;fit=min&amp;q=75 1120w, https://cdn.sanity.io/images/yd6zslid/production/65e380f2c56a56472c2c8d6d3d927a22758b43ce-294x270.svg?auto=format&amp;h=1176&amp;w=1280&amp;fit=min&amp;q=75 1280w, https://cdn.sanity.io/images/yd6zslid/production/65e380f2c56a56472c2c8d6d3d927a22758b43ce-294x270.svg?auto=format&amp;h=1469&amp;w=1600&amp;fit=min&amp;q=75 1600w" src="https://cdn.sanity.io/images/yd6zslid/production/65e380f2c56a56472c2c8d6d3d927a22758b43ce-294x270.svg?auto=format&amp;h=1469&amp;w=1600&amp;fit=min&amp;q=75"/></div><div class="cardStandard__textLockup"><h3 class="cardStandard__title type-subhead-3">Catch broken flows before your users do</h3><p class="cardStandard__body type-body-3-tight">Run agents that click through your product continuously and alert you the moment something breaks.</p><a class="btn btn--compact cardStandard__cta" href="/templates/website-link-tester"><span class="btn__text">Get started</span></a></div></article><article class="cardStandard"><div class="cardStandard__media frame"><img alt="" loading="lazy" width="294" height="270" decoding="async" data-nimg="1" style="color:transparent" sizes="(min-width: 960px) 25vw, (min-width: 481px) 50vw, 100vw" srcSet="https://cdn.sanity.io/images/yd6zslid/production/8db248e94e5fa27044b5f945c74385eda19a6586-294x270.svg?auto=format&amp;h=88&amp;w=96&amp;fit=min&amp;q=75 96w, https://cdn.sanity.io/images/yd6zslid/production/8db248e94e5fa27044b5f945c74385eda19a6586-294x270.svg?auto=format&amp;h=118&amp;w=128&amp;fit=min&amp;q=75 128w, https://cdn.sanity.io/images/yd6zslid/production/8db248e94e5fa27044b5f945c74385eda19a6586-294x270.svg?auto=format&amp;h=235&amp;w=256&amp;fit=min&amp;q=75 256w, https://cdn.sanity.io/images/yd6zslid/production/8db248e94e5fa27044b5f945c74385eda19a6586-294x270.svg?auto=format&amp;h=294&amp;w=320&amp;fit=min&amp;q=75 320w, https://cdn.sanity.io/images/yd6zslid/production/8db248e94e5fa27044b5f945c74385eda19a6586-294x270.svg?auto=format&amp;h=353&amp;w=384&amp;fit=min&amp;q=75 384w, https://cdn.sanity.io/images/yd6zslid/production/8db248e94e5fa27044b5f945c74385eda19a6586-294x270.svg?auto=format&amp;h=442&amp;w=481&amp;fit=min&amp;q=75 481w, https://cdn.sanity.io/images/yd6zslid/production/8db248e94e5fa27044b5f945c74385eda19a6586-294x270.svg?auto=format&amp;h=551&amp;w=600&amp;fit=min&amp;q=75 600w, https://cdn.sanity.io/images/yd6zslid/production/8db248e94e5fa27044b5f945c74385eda19a6586-294x270.svg?auto=format&amp;h=588&amp;w=640&amp;fit=min&amp;q=75 640w, https://cdn.sanity.io/images/yd6zslid/production/8db248e94e5fa27044b5f945c74385eda19a6586-294x270.svg?auto=format&amp;h=882&amp;w=960&amp;fit=min&amp;q=75 960w, https://cdn.sanity.io/images/yd6zslid/production/8db248e94e5fa27044b5f945c74385eda19a6586-294x270.svg?auto=format&amp;h=1029&amp;w=1120&amp;fit=min&amp;q=75 1120w, https://cdn.sanity.io/images/yd6zslid/production/8db248e94e5fa27044b5f945c74385eda19a6586-294x270.svg?auto=format&amp;h=1176&amp;w=1280&amp;fit=min&amp;q=75 1280w, https://cdn.sanity.io/images/yd6zslid/production/8db248e94e5fa27044b5f945c74385eda19a6586-294x270.svg?auto=format&amp;h=1469&amp;w=1600&amp;fit=min&amp;q=75 1600w" src="https://cdn.sanity.io/images/yd6zslid/production/8db248e94e5fa27044b5f945c74385eda19a6586-294x270.svg?auto=format&amp;h=1469&amp;w=1600&amp;fit=min&amp;q=75"/></div><div class="cardStandard__textLockup"><h3 class="cardStandard__title type-subhead-3">Research at a scale no human could</h3><p class="cardStandard__body type-body-3-tight">Spin up thousands of concurrent browser sessions and return answers immediately</p><a class="btn btn--compact cardStandard__cta" href="/templates/google-trends-keywords"><span class="btn__text">Get started</span></a></div></article><article class="cardStandard"><div class="cardStandard__media frame"><img alt="" loading="lazy" width="294" height="270" decoding="async" data-nimg="1" style="color:transparent" sizes="(min-width: 960px) 25vw, (min-width: 481px) 50vw, 100vw" srcSet="https://cdn.sanity.io/images/yd6zslid/production/9351bd32a3db6b18fcd869c49a6aa52481f8b1f3-294x270.svg?auto=format&amp;h=88&amp;w=96&amp;fit=min&amp;q=75 96w, https://cdn.sanity.io/images/yd6zslid/production/9351bd32a3db6b18fcd869c49a6aa52481f8b1f3-294x270.svg?auto=format&amp;h=118&amp;w=128&amp;fit=min&amp;q=75 128w, https://cdn.sanity.io/images/yd6zslid/production/9351bd32a3db6b18fcd869c49a6aa52481f8b1f3-294x270.svg?auto=format&amp;h=235&amp;w=256&amp;fit=min&amp;q=75 256w, https://cdn.sanity.io/images/yd6zslid/production/9351bd32a3db6b18fcd869c49a6aa52481f8b1f3-294x270.svg?auto=format&amp;h=294&amp;w=320&amp;fit=min&amp;q=75 320w, https://cdn.sanity.io/images/yd6zslid/production/9351bd32a3db6b18fcd869c49a6aa52481f8b1f3-294x270.svg?auto=format&amp;h=353&amp;w=384&amp;fit=min&amp;q=75 384w, https://cdn.sanity.io/images/yd6zslid/production/9351bd32a3db6b18fcd869c49a6aa52481f8b1f3-294x270.svg?auto=format&amp;h=442&amp;w=481&amp;fit=min&amp;q=75 481w, https://cdn.sanity.io/images/yd6zslid/production/9351bd32a3db6b18fcd869c49a6aa52481f8b1f3-294x270.svg?auto=format&amp;h=551&amp;w=600&amp;fit=min&amp;q=75 600w, https://cdn.sanity.io/images/yd6zslid/production/9351bd32a3db6b18fcd869c49a6aa52481f8b1f3-294x270.svg?auto=format&amp;h=588&amp;w=640&amp;fit=min&amp;q=75 640w, https://cdn.sanity.io/images/yd6zslid/production/9351bd32a3db6b18fcd869c49a6aa52481f8b1f3-294x270.svg?auto=format&amp;h=882&amp;w=960&amp;fit=min&amp;q=75 960w, https://cdn.sanity.io/images/yd6zslid/production/9351bd32a3db6b18fcd869c49a6aa52481f8b1f3-294x270.svg?auto=format&amp;h=1029&amp;w=1120&amp;fit=min&amp;q=75 1120w, https://cdn.sanity.io/images/yd6zslid/production/9351bd32a3db6b18fcd869c49a6aa52481f8b1f3-294x270.svg?auto=format&amp;h=1176&amp;w=1280&amp;fit=min&amp;q=75 1280w, https://cdn.sanity.io/images/yd6zslid/production/9351bd32a3db6b18fcd869c49a6aa52481f8b1f3-294x270.svg?auto=format&amp;h=1469&amp;w=1600&amp;fit=min&amp;q=75 1600w" src="https://cdn.sanity.io/images/yd6zslid/production/9351bd32a3db6b18fcd869c49a6aa52481f8b1f3-294x270.svg?auto=format&amp;h=1469&amp;w=1600&amp;fit=min&amp;q=75"/></div><div class="cardStandard__textLockup"><h3 class="cardStandard__title type-subhead-3">Unblock agents that get stuck</h3><p class="cardStandard__body type-body-3-tight">When your workflow requires a form, a CAPTCHA, or a login prompt, it’s handled.</p><a class="btn btn--compact cardStandard__cta" href="/templates/manual-mfa-with-contexts"><span class="btn__text">Get started</span></a></div></article><article class="cardStandard"><div class="cardStandard__media frame"><img alt="" loading="lazy" width="294" height="270" decoding="async" data-nimg="1" style="color:transparent" sizes="(min-width: 960px) 25vw, (min-width: 481px) 50vw, 100vw" srcSet="https://cdn.sanity.io/images/yd6zslid/production/7027c661401322c4f48e36637ebdc53fd758ce2b-294x270.svg?auto=format&amp;h=88&amp;w=96&amp;fit=min&amp;q=75 96w, https://cdn.sanity.io/images/yd6zslid/production/7027c661401322c4f48e36637ebdc53fd758ce2b-294x270.svg?auto=format&amp;h=118&amp;w=128&amp;fit=min&amp;q=75 128w, https://cdn.sanity.io/images/yd6zslid/production/7027c661401322c4f48e36637ebdc53fd758ce2b-294x270.svg?auto=format&amp;h=235&amp;w=256&amp;fit=min&amp;q=75 256w, https://cdn.sanity.io/images/yd6zslid/production/7027c661401322c4f48e36637ebdc53fd758ce2b-294x270.svg?auto=format&amp;h=294&amp;w=320&amp;fit=min&amp;q=75 320w, https://cdn.sanity.io/images/yd6zslid/production/7027c661401322c4f48e36637ebdc53fd758ce2b-294x270.svg?auto=format&amp;h=353&amp;w=384&amp;fit=min&amp;q=75 384w, https://cdn.sanity.io/images/yd6zslid/production/7027c661401322c4f48e36637ebdc53fd758ce2b-294x270.svg?auto=format&amp;h=442&amp;w=481&amp;fit=min&amp;q=75 481w, https://cdn.sanity.io/images/yd6zslid/production/7027c661401322c4f48e36637ebdc53fd758ce2b-294x270.svg?auto=format&amp;h=551&amp;w=600&amp;fit=min&amp;q=75 600w, https://cdn.sanity.io/images/yd6zslid/production/7027c661401322c4f48e36637ebdc53fd758ce2b-294x270.svg?auto=format&amp;h=588&amp;w=640&amp;fit=min&amp;q=75 640w, https://cdn.sanity.io/images/yd6zslid/production/7027c661401322c4f48e36637ebdc53fd758ce2b-294x270.svg?auto=format&amp;h=882&amp;w=960&amp;fit=min&amp;q=75 960w, https://cdn.sanity.io/images/yd6zslid/production/7027c661401322c4f48e36637ebdc53fd758ce2b-294x270.svg?auto=format&amp;h=1029&amp;w=1120&amp;fit=min&amp;q=75 1120w, https://cdn.sanity.io/images/yd6zslid/production/7027c661401322c4f48e36637ebdc53fd758ce2b-294x270.svg?auto=format&amp;h=1176&amp;w=1280&amp;fit=min&amp;q=75 1280w, https://cdn.sanity.io/images/yd6zslid/production/7027c661401322c4f48e36637ebdc53fd758ce2b-294x270.svg?auto=format&amp;h=1469&amp;w=1600&amp;fit=min&amp;q=75 1600w" src="https://cdn.sanity.io/images/yd6zslid/production/7027c661401322c4f48e36637ebdc53fd758ce2b-294x270.svg?auto=format&amp;h=1469&amp;w=1600&amp;fit=min&amp;q=75"/></div><div class="cardStandard__textLockup"><h3 class="cardStandard__title type-subhead-3">Let agents fill in the blanks</h3><p class="cardStandard__body type-body-3-tight">Job applications, vendor portals, government forms. Agents that act on the web, not just read it.</p><a class="btn btn--compact cardStandard__cta" href="/templates/dynamic-form-filling"><span class="btn__text">Get started</span></a></div></article><article class="cardStandard"><div class="cardStandard__media frame"><img alt="" loading="lazy" width="294" height="270" decoding="async" data-nimg="1" style="color:transparent" sizes="(min-width: 960px) 25vw, (min-width: 481px) 50vw, 100vw" srcSet="https://cdn.sanity.io/images/yd6zslid/production/409d712dc4004c36a5a7e39ed8bf7d18c1231e00-294x270.svg?auto=format&amp;h=88&amp;w=96&amp;fit=min&amp;q=75 96w, https://cdn.sanity.io/images/yd6zslid/production/409d712dc4004c36a5a7e39ed8bf7d18c1231e00-294x270.svg?auto=format&amp;h=118&amp;w=128&amp;fit=min&amp;q=75 128w, https://cdn.sanity.io/images/yd6zslid/production/409d712dc4004c36a5a7e39ed8bf7d18c1231e00-294x270.svg?auto=format&amp;h=235&amp;w=256&amp;fit=min&amp;q=75 256w, https://cdn.sanity.io/images/yd6zslid/production/409d712dc4004c36a5a7e39ed8bf7d18c1231e00-294x270.svg?auto=format&amp;h=294&amp;w=320&amp;fit=min&amp;q=75 320w, https://cdn.sanity.io/images/yd6zslid/production/409d712dc4004c36a5a7e39ed8bf7d18c1231e00-294x270.svg?auto=format&amp;h=353&amp;w=384&amp;fit=min&amp;q=75 384w, https://cdn.sanity.io/images/yd6zslid/production/409d712dc4004c36a5a7e39ed8bf7d18c1231e00-294x270.svg?auto=format&amp;h=442&amp;w=481&amp;fit=min&amp;q=75 481w, https://cdn.sanity.io/images/yd6zslid/production/409d712dc4004c36a5a7e39ed8bf7d18c1231e00-294x270.svg?auto=format&amp;h=551&amp;w=600&amp;fit=min&amp;q=75 600w, https://cdn.sanity.io/images/yd6zslid/production/409d712dc4004c36a5a7e39ed8bf7d18c1231e00-294x270.svg?auto=format&amp;h=588&amp;w=640&amp;fit=min&amp;q=75 640w, https://cdn.sanity.io/images/yd6zslid/production/409d712dc4004c36a5a7e39ed8bf7d18c1231e00-294x270.svg?auto=format&amp;h=882&amp;w=960&amp;fit=min&amp;q=75 960w, https://cdn.sanity.io/images/yd6zslid/production/409d712dc4004c36a5a7e39ed8bf7d18c1231e00-294x270.svg?auto=format&amp;h=1029&amp;w=1120&amp;fit=min&amp;q=75 1120w, https://cdn.sanity.io/images/yd6zslid/production/409d712dc4004c36a5a7e39ed8bf7d18c1231e00-294x270.svg?auto=format&amp;h=1176&amp;w=1280&amp;fit=min&amp;q=75 1280w, https://cdn.sanity.io/images/yd6zslid/production/409d712dc4004c36a5a7e39ed8bf7d18c1231e00-294x270.svg?auto=format&amp;h=1469&amp;w=1600&amp;fit=min&amp;q=75 1600w" src="https://cdn.sanity.io/images/yd6zslid/production/409d712dc4004c36a5a7e39ed8bf7d18c1231e00-294x270.svg?auto=format&amp;h=1469&amp;w=1600&amp;fit=min&amp;q=75"/></div><div class="cardStandard__textLockup"><h3 class="cardStandard__title type-subhead-3">Watch the whole web at once</h3><p class="cardStandard__body type-body-3-tight">Track prices, job listings, product changes, and competitor moves as they happen.</p><a class="btn btn--compact cardStandard__cta" href="/templates/gift-finder"><span class="btn__text">Get started</span></a></div></article><article class="cardStandard"><div class="cardStandard__media frame"><img alt="" loading="lazy" width="294" height="270" decoding="async" data-nimg="1" style="color:transparent" sizes="(min-width: 960px) 25vw, (min-width: 481px) 50vw, 100vw" srcSet="https://cdn.sanity.io/images/yd6zslid/production/1bdc0ece6d87ecd4253c0f82bd35bbb5d9691434-294x270.svg?auto=format&amp;h=88&amp;w=96&amp;fit=min&amp;q=75 96w, https://cdn.sanity.io/images/yd6zslid/production/1bdc0ece6d87ecd4253c0f82bd35bbb5d9691434-294x270.svg?auto=format&amp;h=118&amp;w=128&amp;fit=min&amp;q=75 128w, https://cdn.sanity.io/images/yd6zslid/production/1bdc0ece6d87ecd4253c0f82bd35bbb5d9691434-294x270.svg?auto=format&amp;h=235&amp;w=256&amp;fit=min&amp;q=75 256w, https://cdn.sanity.io/images/yd6zslid/production/1bdc0ece6d87ecd4253c0f82bd35bbb5d9691434-294x270.svg?auto=format&amp;h=294&amp;w=320&amp;fit=min&amp;q=75 320w, https://cdn.sanity.io/images/yd6zslid/production/1bdc0ece6d87ecd4253c0f82bd35bbb5d9691434-294x270.svg?auto=format&amp;h=353&amp;w=384&amp;fit=min&amp;q=75 384w, https://cdn.sanity.io/images/yd6zslid/production/1bdc0ece6d87ecd4253c0f82bd35bbb5d9691434-294x270.svg?auto=format&amp;h=442&amp;w=481&amp;fit=min&amp;q=75 481w, https://cdn.sanity.io/images/yd6zslid/production/1bdc0ece6d87ecd4253c0f82bd35bbb5d9691434-294x270.svg?auto=format&amp;h=551&amp;w=600&amp;fit=min&amp;q=75 600w, https://cdn.sanity.io/images/yd6zslid/production/1bdc0ece6d87ecd4253c0f82bd35bbb5d9691434-294x270.svg?auto=format&amp;h=588&amp;w=640&amp;fit=min&amp;q=75 640w, https://cdn.sanity.io/images/yd6zslid/production/1bdc0ece6d87ecd4253c0f82bd35bbb5d9691434-294x270.svg?auto=format&amp;h=882&amp;w=960&amp;fit=min&amp;q=75 960w, https://cdn.sanity.io/images/yd6zslid/production/1bdc0ece6d87ecd4253c0f82bd35bbb5d9691434-294x270.svg?auto=format&amp;h=1029&amp;w=1120&amp;fit=min&amp;q=75 1120w, https://cdn.sanity.io/images/yd6zslid/production/1bdc0ece6d87ecd4253c0f82bd35bbb5d9691434-294x270.svg?auto=format&amp;h=1176&amp;w=1280&amp;fit=min&amp;q=75 1280w, https://cdn.sanity.io/images/yd6zslid/production/1bdc0ece6d87ecd4253c0f82bd35bbb5d9691434-294x270.svg?auto=format&amp;h=1469&amp;w=1600&amp;fit=min&amp;q=75 1600w" src="https://cdn.sanity.io/images/yd6zslid/production/1bdc0ece6d87ecd4253c0f82bd35bbb5d9691434-294x270.svg?auto=format&amp;h=1469&amp;w=1600&amp;fit=min&amp;q=75"/></div><div class="cardStandard__textLockup"><h3 class="cardStandard__title type-subhead-3">Move data at agent speed</h3><p class="cardStandard__body type-body-3-tight">Upload files, trigger downloads, and process records across hundreds of sites in parallel.</p><a class="btn btn--compact cardStandard__cta" href="/templates/download-financial-statements"><span class="btn__text">Get started</span></a></div></article></div></div></section><section class="section ecosystemMap" id="ecosystem-map"><div class="ecosystemMap__container | grid"><div class="textLockUp textLockUp--left ecosystemMap__textLockUp" data-style-variant="heading-2"><div class="textLockUp__content"><h2 class="textLockUp__title u-wordbreak type-heading-2"><span>Anything you can do in a browser, your agent can too.</span></h2></div></div><div class="ecosystemMap__stage"><div class="ecosystemMap__canvas"><svg aria-hidden="true" class="ecosystemMap__wires" viewBox="0 0 1320 605"><rect class="ecosystemMap__gridCell" height="56" width="56" x="-88" y="53"></rect><rect class="ecosystemMap__gridCell" height="56" width="56" x="-88" y="389"></rect><rect class="ecosystemMap__gridCell" height="56" width="56" x="-32" y="-3"></rect><rect class="ecosystemMap__gridCell" height="56" width="56" x="-32" y="165"></rect><rect class="ecosystemMap__gridCell" height="56" width="56" x="-32" y="221"></rect><rect class="ecosystemMap__gridCell" height="56" width="56" x="-32" y="333"></rect><rect class="ecosystemMap__gridCell" height="56" width="56" x="-32" y="557"></rect><rect class="ecosystemMap__gridCell" height="56" width="56" x="24" y="165"></rect><rect class="ecosystemMap__gridCell" height="56" wid