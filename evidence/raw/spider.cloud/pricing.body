und border-0 disabled:pointer-events-none font-medium gap-2 h-[62px] hover:bg-foreground/90 justify-center text-background text-xs tracking-[0.14em] w-full disabled:opacity-40 duration-200 ease-app focus-visible:bg-foreground/90 motion-reduce:transition-none px-5" type=button>Sign up to top up $25</button></div></div></div></div></div><div class="ease-app motion-reduce:transition-none focus-visible:outline-none col-start-1 duration-[280ms] focus-visible:ring-2 focus-visible:ring-offset-2 focus-visible:ring-ring ring-offset-background row-start-1 transition-[opacity,transform]" role=tabpanel data-orientation=horizontal style=opacity:0;transform:translateX(12px);pointer-events:none tabindex=0 aria-labelledby=radix-_r7R_0_-trigger-unlimited data-plan-panel=unlimited data-state=inactive id=radix-_r7R_0_-content-unlimited inert><h2 class=sr-only>Unlimited plan pricing</h2><div class=""><div class="flex justify-center items-baseline flex-wrap gap-x-3.5 gap-y-1 pb-8 pt-8 px-3 sm:px-6"><span class="text-foreground [font-optical-sizing:auto] font-[500] font-display block h-[64px] leading-[64px] lg:text-[4rem] sm:text-[3.5rem] tabular-nums text-[2.75rem] tracking-[-0.04em]">$350</span><span class="text-muted-foreground font-mono tabular-nums flex items-baseline justify-center flex-wrap gap-x-2 sm:text-base text-[14px] whitespace-nowrap"><span>/mo</span><span aria-hidden=true>·</span><span>25<!-- --> concurrent</span><span aria-hidden=true>·</span><span>$14<!-- --> each</span></span></div><div class="flex border-y border-[hsl(var(--md-rule)/0.6)]" role=group aria-label=Concurrency><button class="text-muted-foreground hover:text-foreground transition-colors font-mono cursor-pointer flex justify-center text-xs flex-1 gap-[5px] h-[46px] items-baseline leading-[46px] min-w-0 sm:tracking-[0.14em] tabular-nums tracking-[0.02em] focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-foreground/40 focus-visible:ring-offset-2 focus-visible:ring-offset-background" type=button aria-label="2 concurrency, $40 per month" aria-pressed=false>2</button><button class="text-muted-foreground hover:text-foreground transition-colors font-mono cursor-pointer flex justify-center text-xs flex-1 gap-[5px] h-[46px] items-baseline leading-[46px] min-w-0 sm:tracking-[0.14em] tabular-nums tracking-[0.02em] border-[hsl(var(--md-rule)/0.6)] border-l focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-foreground/40 focus-visible:ring-offset-2 focus-visible:ring-offset-background" type=button aria-label="10 concurrency, $170 per month" aria-pressed=false>10</button><button class="flex font-mono cursor-pointer justify-center transition-colors text-xs flex-1 gap-[5px] h-[46px] items-baseline leading-[46px] min-w-0 sm:tracking-[0.14em] tabular-nums tracking-[0.02em] border-[hsl(var(--md-rule)/0.6)] border-l focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-foreground/40 focus-visible:ring-offset-2 focus-visible:ring-offset-background bg-foreground text-background" type=button aria-label="25 concurrency, $350 per month" aria-pressed=true>25</button><button class="text-muted-foreground hover:text-foreground transition-colors font-mono cursor-pointer flex justify-center text-xs flex-1 gap-[5px] h-[46px] items-baseline leading-[46px] min-w-0 sm:tracking-[0.14em] tabular-nums tracking-[0.02em] border-[hsl(var(--md-rule)/0.6)] border-l focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-foreground/40 focus-visible:ring-offset-2 focus-visible:ring-offset-background" type=button aria-label="50 concurrency, $650 per month" aria-pressed=false>50</button><button class="text-muted-foreground hover:text-foreground transition-colors font-mono cursor-pointer flex justify-center text-xs flex-1 gap-[5px] h-[46px] items-baseline leading-[46px] min-w-0 sm:tracking-[0.14em] tabular-nums tracking-[0.02em] border-[hsl(var(--md-rule)/0.6)] border-l focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-foreground/40 focus-visible:ring-offset-2 focus-visible:ring-offset-background" type=button>Custom</button></div><div class=""><button class="items-center inline-flex transition-colors no-underline font-mono gap-2 uppercase bg-foreground disabled:opacity-60 focus-visible:ring-2 focus-visible:ring-foreground/40 focus-visible:ring-offset-2 focus-visible:ring-offset-background hover:bg-foreground/90 justify-center text-background tracking-[0.14em] border-0 border-foreground cursor-pointer disabled:pointer-events-none focus-visible:outline-none font-medium h-[62px] hover:border-foreground/90 px-7 sm:w-full text-xs w-full" type=button aria-label="Start Unlimited at 25 concurrency, $350 per month">Start Unlimited · $350/mo</button></div></div></div></div></div></div><div class="" data-plan-block=payg><p class="text-muted-foreground font-mono uppercase tracking-[0.14em] text-xs pt-8 text-center">Need volume pricing or custom scraping?<!-- --> <button class="text-foreground cursor-pointer decoration-foreground/40 font-sans hover:decoration-foreground normal-case tracking-normal transition-colors underline underline-offset-4" type=button aria-expanded=false aria-haspopup=dialog data-state=closed>Talk to sales</button></p><h3 class=sr-only>Pricing details</h3><div class=pt-8><div class=pt-4><button class="text-muted-foreground hover:text-foreground transition-colors items-center group justify-center cursor-pointer flex font-mono gap-3 py-3 text-2xs tracking-[0.14em] uppercase w-full" type=button aria-expanded=false><span class="bg-[hsl(var(--md-rule))] flex-1 group-hover:bg-[hsl(var(--md-rule))] h-px transition-colors"></span><span class="items-center inline-flex shrink-0 gap-2">Pricing details<span class="inline-block duration-200 text-xs transition-transform" aria-hidden=true>⌄</span></span><span class="bg-[hsl(var(--md-rule))] flex-1 group-hover:bg-[hsl(var(--md-rule))] h-px transition-colors"></span></button></div></div></div><div class=hidden data-plan-block=unlimited inert><p class="text-muted-foreground font-mono uppercase tracking-[0.14em] text-xs pt-8 text-center">Need more than 1,500 concurrent?<!-- --> <button class="text-foreground cursor-pointer decoration-foreground/40 font-sans hover:decoration-foreground normal-case tracking-normal transition-colors underline underline-offset-4" type=button aria-expanded=false aria-haspopup=dialog data-state=closed>Talk to sales</button></p></div></div><!--astro:end--></astro-island></section><section aria-label="AI Studio add-on" class="mx-auto max-w-3xl pb-2 pt-10 scroll-mt-28" id=ai-studio><div class="items-center flex justify-between px-5 border border-[hsl(var(--md-rule))] flex-wrap gap-x-4 gap-y-3 py-4"><div class="items-center flex flex-wrap gap-x-3 gap-y-2 min-w-0"><h2 class="text-foreground font-mono font-normal text-[14px]">AI Studio</h2><span class="text-muted-foreground items-center inline-flex font-mono uppercase text-2xs border border-[hsl(var(--md-rule))] px-1.5 py-0.5 tracking-[0.14em]">Alpha</span><p class="text-muted-foreground leading-relaxed text-sm">Natural-language endpoints on your existing key</p></div><div class="items-center flex gap-3.5 shrink-0"><span class="text-muted-foreground font-mono tabular-nums text-xs">from $6/mo</span> <a class="text-foreground font-mono text-2xs transition-colors uppercase decoration-foreground/40 hover:decoration-foreground tracking-[0.14em] underline underline-offset-4" href=/ai/pricing/ data-analytics=plans>View AI Studio plans</a></div></div></section><section aria-label="Frequently asked questions" class="mx-auto max-w-3xl pt-10 pb-16"><h2 class=sr-only>Frequently asked questions</h2><div class="bg-background con-tick pt-2"><span class="con-tab text-muted-foreground!" aria-hidden=true>questions</span><details class=group data-faq-q="How does billing work?"><summary class="items-center flex cursor-pointer font-mono gap-3 justify-between list-none md:px-7 md:text-base px-5 py-5 text-foreground text-sm tracking-tight"><span class=min-w-0>How does billing work?</span> <span class="text-muted-foreground font-mono group-open:rotate-45 text-base transition-transform" aria-hidden=true>+</span></summary><p class="text-muted-foreground text-base leading-relaxed md:px-7 px-5 pb-5">Two line items per request: bandwidth ($1 per GB of pre-transformation content) and compute ($0.0001 per minute of CPU). Most pages land at a fraction of a cent. Failed requests cost $0.</p></details><details class="border-[hsl(var(--md-rule)/0.6)] border-t group" data-faq-q="Does my balance expire?"><summary class="items-center flex cursor-pointer font-mono gap-3 justify-between list-none md:px-7 md:text-base px-5 py-5 text-foreground text-sm tracking-tight"><span class=min-w-0>Does my balance expire?</span> <span class="text-muted-foreground font-mono group-open:rotate-45 text-base transition-transform" aria-hidden=true>+</span></summary><p class="text-muted-foreground text-base leading-relaxed md:px-7 px-5 pb-5">No. Pay as you go has no subscription. Top up once and use the balance whenever you need it. Nothing resets monthly. Unlimited is a separate monthly plan you pick on the Unlimited tab.</p></details><details class="border-[hsl(var(--md-rule)/0.6)] border-t group" data-faq-q="What if I need to top up more?"><summary class="items-center flex cursor-pointer font-mono gap-3 justify-between list-none md:px-7 md:text-base px-5 py-5 text-foreground text-sm tracking-tight"><span class=min-w-0>What if I need to top up more?</span> <span class="text-muted-foreground font-mono group-open:rotate-45 text-base transition-transform" aria-hidden=true>+</span></summary><p class="text-muted-foreground text-base leading-relaxed md:px-7 px-5 pb-5">Top up any amount, any time. A single purchase of $500 or more earns an automatic bonus, and the top up form shows the exact percentage for each amount. You never have to negotiate for it.</p></details><details class="border-[hsl(var(--md-rule)/0.6)] border-t group" data-faq-q="How does the Unlimited plan work?"><summary class="items-center flex cursor-pointer font-mono gap-3 justify-between list-none md:px-7 md:text-base px-5 py-5 text-foreground text-sm tracking-tight"><span class=min-w-0>How does the Unlimited plan work?</span> <span class="text-muted-foreground font-mono group-open:rotate-45 text-base transition-transform" aria-hidden=true>+</span></summary><p class="text-muted-foreground text-base leading-relaxed md:px-7 px-5 pb-5">Instead of paying per request, you buy concurrency: how many requests can be in flight at once. Pick any amount from 2 ($40/mo) up to 1,538 ($19,994/mo) and run unlimited requests through it for a flat monthly price. The price per concurrent request drops from $20 to $13 as you add concurrency. Each price band is billed on its own line, so one subscription shows several line items on the invoice. Above the self-serve maximum, talk to sales for a custom rate. Geo-targeting is not available on Unlimited yet.</p></details><details class="border-[hsl(var(--md-rule)/0.6)] border-t group" data-faq-q="What happens when all my Unlimited concurrency is busy?"><summary class="items-center flex cursor-pointer font-mono gap-3 justify-between list-none md:px-7 md:text-base px-5 py-5 text-foreground text-sm tracking-tight"><span class=min-w-0>What happens when all my Unlimited concurrency is busy?</span> <span class="text-muted-foreground font-mono group-open:rotate-45 text-base transition-transform" aria-hidden=true>+</span></summary><p class="text-muted-foreground text-base leading-relaxed md:px-7 px-5 pb-5">Requests beyond your concurrency limit get an immediate 429 with a Retry-After header. Spider queues nothing server-side and bills nothing extra. Retry or back off on your side, or add concurrency at any time. Any whole number works, not only the listed tiers.</p></details><details class="border-[hsl(var(--md-rule)/0.6)] border-t group" data-faq-q="Are there multipliers for JS rendering or proxies?"><summary class="items-center flex cursor-pointer font-mono gap-3 justify-between list-none md:px-7 md:text-base px-5 py-5 text-foreground text-sm tracking-tight"><span class=min-w-0>Are there multipliers for JS rendering or proxies?</span> <span class="text-muted-foreground font-mono group-open:rotate-45 text-base transition-transform" aria-hidden=true>+</span></summary><p class="text-muted-foreground text-base leading-relaxed md:px-7 px-5 pb-5">None for JS rendering or standard proxies. JS rendering bills as compute, and proxy rotation comes with every request. Residential and ISP pools and AI extraction have their own prices, listed under Pricing details above. The only account-wide multiplier is the optional zero data retention setting, which bills requests at 2.5x credits. Enterprise plans include it at no extra charge.</p></details><details class="border-[hsl(var(--md-rule)/0.6)] border-t group" data-faq-q="What are the rate limits?"><summary class="items-center flex cursor-pointer font-mono gap-3 justify-between list-none md:px-7 md:text-base px-5 py-5 text-foreground text-sm tracking-tight"><span class=min-w-0>What are the rate limits?</span> <span class="text-muted-foreground font-mono group-open:rotate-45 text-base transition-transform" aria-hidden=true>+</span></summary><p class="text-muted-foreground text-base leading-relaxed md:px-7 px-5 pb-5">Every account can make up to 10,000 core API requests per minute by default. Contact us if you need higher throughput.</p></details><details class="border-[hsl(var(--md-rule)/0.6)] border-t group" data-faq-q="What if I get blocked?"><summary class="items-center flex cursor-pointer font-mono gap-3 justify-between list-none md:px-7 md:text-base px-5 py-5 text-foreground text-sm tracking-tight"><span class=min-w-0>What if I get blocked?</span> <span class="text-muted-foreground font-mono group-open:rotate-45 text-base transition-transform" aria-hidden=true>+</span></summary><p class="text-muted-foreground text-base leading-relaxed md:px-7 px-5 pb-5">Spider loads protected pages in its native browser, with rotating proxies and automatic retries. Heavily protected sites route to the cloud browser, which runs full sessions in a real browser engine.</p></details><details class="border-[hsl(var(--md-rule)/0.6)] border-t group" data-faq-q="Does it respect robots.txt?"><summary class="items-center flex cursor-pointer font-mono gap-3 justify-between list-none md:px-7 md:text-base px-5 py-5 text-foreground text-sm tracking-tight"><span class=min-w-0>Does it respect robots.txt?</span> <span class="text-muted-foreground font-mono group-open:rotate-45 text-base transition-transform" aria-hidden=true>+</span></summary><p class="text-muted-foreground text-base leading-relaxed md:px-7 px-5 pb-5">Yes. Spider follows robots.txt by default. You can turn it off per request.</p></details><details class="border-[hsl(var(--md-rule)/0.6)] border-t group" data-faq-q="What formats can Spider return?"><summary class="items-center flex cursor-pointer font-mono gap-3 justify-between list-none md:px-7 md:text-base px-5 py-5 text-foreground text-sm tracking-tight"><span class=min-w-0>What formats can Spider return?</span> <span class="text-muted-foreground font-mono group-open:rotate-45 text-base transition-transform" aria-hidden=true>+</span></summary><p class="text-muted-foreground text-base leading-relaxed md:px-7 px-5 pb-5">HTML, raw, plain text, and multiple markdown formats. API responses support JSON, JSONL, CSV, and XML.</p></details></div><p class="text-muted-foreground text-base leading-relaxed md:px-7 px-5 pt-6">Per-endpoint costs are on the <a class="text-foreground transition-colors decoration-foreground/40 hover:decoration-foreground underline underline-offset-4" href=/api/scrape/ >Scrape API </a>and <a class="text-foreground transition-colors decoration-foreground/40 hover:decoration-foreground underline underline-offset-4" href=/api/crawl/ >Crawl API </a>pages, every parameter is in the <a class="text-foreground transition-colors decoration-foreground/40 hover:decoration-foreground underline underline-offset-4" href=/docs/api/ >API docs </a>, and the <a class="text-foreground transition-colors decoration-foreground/40 hover:decoration-foreground underline underline-offset-4" href=/use-cases/ai-agents/ >AI agents </a>use case shows a crawl wired in as an agent tool.</p></section></div><astro-island client=idle component-export=default component-url=/_astro/LazySessionRefresh.UgMoX2io.js opts={&quot;name&quot;:&quot;LazySessionRefresh&quot;,&quot;value&quot;:true} props={} renderer-url=/_astro/client.CV2LLJuO.js ssr uid=Z7eYGq prefix=r1></astro-island></main><footer class="pb-16 pt-20"><div class="mx-auto lg:px-16 max-w-site md:px-12 sm:px-6 w-full px-4"><div class="items-center flex flex-col border-[hsl(var(--md-rule)/0.6)] border-t gap-y-12 pt-12"><nav aria-label="Footer navigation" class="grid grid-cols-2 w-full gap-x-8 gap-y-10 md:grid-cols-5 text-left"><div><div class=pb-4><h2 class="text-muted-foreground font-mono uppercase text-[11px] font-medium m-0 md:text-xs tracking-[0.16em]">Compare</h2></div><ul class="m-0 p-0 flex flex-col gap-y-3 list-none"><li class="m-0 p-0"><a class="text-muted-foreground hover:text-foreground transition-colors items-center inline-flex gap-1.5 no-underline text-sm" href=https://spider.cloud/compare/ >Pricing calculator</a></li><li class="m-0 p-0"><a class="text-muted-foreground hover:text-foreground transition-colors items-center inline-flex gap-1.5 no-underline text-sm" href=https://spider.cloud/why-spider/ ><span class=notranslate translate=no>Why Spider</span></a></li><li class="m-0 p-0"><a class="text-muted-foreground hover:text-foreground transition-colors items-center inline-flex gap-1.5 no-underline text-sm" href=https://spider.cloud/open-source-vs-cloud/ >Open source vs cloud</a></li><li class="m-0 p-0"><a class="text-muted-foreground hover:text-foreground transition-colors items-center inline-flex gap-1.5 no-underline text-sm" href=https://spider.cloud/blog/spi