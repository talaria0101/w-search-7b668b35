0m9 0h0m9 0h0m9 0h0m9 0h0m9 0h0M247 602h0m9 0h0m9 0h0m9 0h0m9 0h0m9 0h0m153 0h0m18 0h0m9 0h0m207 0h0m9 0h0m9 0h0m9 0h0m9 0h0m9 0h0m9 0h0m9 0h0m9 0h0m9 0h0M247 611h0m9 0h0m9 0h0m9 0h0m9 0h0m171 0h0m9 0h0m216 0h0m9 0h0m9 0h0m9 0h0m9 0h0m9 0h0m9 0h0m9 0h0m9 0h0m9 0h0M247 620h0m9 0h0m9 0h0m9 0h0m9 0h0m171 0h0m9 0h0m216 0h0m9 0h0m9 0h0m9 0h0m9 0h0m9 0h0m9 0h0m9 0h0m9 0h0m9 0h0M247 629h0m9 0h0m9 0h0m9 0h0m405 0h0m9 0h0m9 0h0m9 0h0m9 0h0m9 0h0m9 0h0m9 0h0m9 0h0m9 0h0M247 638h0m9 0h0m9 0h0m450 0h0m9 0h0m9 0h0m9 0h0m9 0h0m9 0h0M256 647h0m468 0h0m9 0h0m9 0h0m9 0h0M247 656h0m9 0h0m468 0h0m9 0h0m9 0h0m63 0h0M247 665h0m9 0h0M247 674h0m9 0h0m477 0h0m72 0h0M256 683h0m540 0h0M265 692h0m513 0h0m9 0h0" fill=none stroke=hsl(var(--foreground)/0.22) stroke-width=1.5 vector-effect=non-scaling-stroke stroke-linecap=round></path><path d="M436 386L193.3 419" fill=none stroke=var(--hp-accent) stroke-width=1 vector-effect=non-scaling-stroke></path><circle cx=427 cy=395 r=2.5 fill=var(--hp-dot)></circle><circle cx=427 cy=386 r=2.5 fill=var(--hp-dot)></circle><circle cx=436 cy=386 r=2.5 fill=var(--hp-accent)></circle><circle cx=193.3 cy=419 r=2.5 fill=var(--hp-accent)></circle></svg> <span class="text-muted-foreground font-mono uppercase tracking-[0.14em] text-[11px] absolute left-0 top-0">215M+ exits · 199 countries</span> <span class="text-muted-foreground font-mono uppercase tracking-[0.14em] text-[11px] absolute bottom-0 right-0">exit · DE · RES</span> <span class="text-muted-foreground font-mono hidden absolute bottom-0 left-0 sm:block text-[11px] tracking-[0.06em]">doc.rust-lang.org/book</span></div></div></div></div><div class="flex flex-col min-w-0 px-5 gap-4 sm:px-8 pb-8 pt-5"><p class="text-muted-foreground font-mono uppercase tracking-[0.1em] leading-[1.7] max-w-[34rem] text-[12px]">215M+ exits, 199 countries, one per request.</p><a class="items-center inline-flex transition-colors gap-1.5 no-underline font-mono hover:text-muted-foreground text-foreground text-xs tracking-[0.14em] uppercase" href=/proxy-locations/ >See proxy locations <span aria-hidden=true>&rarr;</span></a></div></li></ol></div><noscript><style>[data-hp-trace] .hp-s{opacity:1!important}[data-hp-trace] :is(.hp-su,.hp-u){opacity:0!important}</style></noscript></section><script type=module>function e(e,t){e.setAttribute("data-hp-state",t?"done":"run")}function t(t,n){if(!("IntersectionObserver"in window))return e(t,!0);let r=Math.min(.35,.5*innerHeight/Math.max(t.offsetHeight,1)),i=new IntersectionObserver(r=>{r.some(e=>e.isIntersecting)&&(i.disconnect(),e(t,n))},{threshold:r});i.observe(t)}function n(t,n){if(n)return e(t,!0);let r=!1,i=()=>{r||(r=!0,e(t,!1))};setTimeout(i,250),document.fonts?.ready.then(i,i)}function r(){let e=matchMedia("(prefers-reduced-motion: reduce)").matches;for(let r of document.querySelectorAll("[data-hp-trace]"))"idle"===r.getAttribute("data-hp-state")&&("load"===(r.getAttribute("data-hp-trigger")??"view")?n:t)(r,e)}r()</script><section class="min-w-0 w-full lg:px-16 max-w-site md:px-12 mx-auto px-4 sm:px-6 lg:pt-36 md:pt-32 pt-24 hs-defer hs-reveal" data-astro-cid-w4p3l6me aria-labelledby=home-manifesto-title style=--hs-h0:2224px;--hs-h1:2647px;--hs-h2:1177px;--hs-h3:1416px><div class="min-w-0 max-w-[52rem]"><h2 class="text-foreground [font-optical-sizing:auto] font-[500] font-display text-balance scroll-m-20 tracking-[-0.03em] leading-[1.05] lg:text-[3rem] sm:text-[2.5rem] text-[2rem] lg:leading-[1] lg:text-[3.75rem]" id=home-manifesto-title>Use the whole web like a dataset.</h2><p class="text-muted-foreground max-w-[34rem] leading-[1.55] max-w-[38rem] mt-4 text-lg text-pretty">Most websites have no API. Spider renders their pages and extracts the content for your <a class="text-foreground transition-colors underline underline-offset-4 decoration-muted-foreground/40 hover:decoration-foreground" href=/use-cases/rag/ >RAG pipeline</a> or <a class="text-foreground transition-colors underline underline-offset-4 decoration-muted-foreground/40 hover:decoration-foreground" href=/use-cases/ai-agents/ >agent</a>.</p></div><div class="lg:pt-16 pt-12"><ol class="min-w-0 border-[hsl(var(--md-rule)/0.6)] border-t grid border-b grid-cols-1 md:grid-cols-2" role=list><li class="flex flex-col min-w-0 border-[hsl(var(--md-rule)/0.6)] pl-cell relative md:border-t-0"><div class=pl-tabs aria-hidden=true><span class=con-tab>render</span> <code class="font-mono leading-[1.6] con-tab con-tab-r normal-case text-[12px] text-[hsl(var(--md-code-fg))] tracking-normal">request: &quot;browser&quot;</code></div><h3 class="text-foreground uppercase [font-optical-sizing:auto] font-[500] font-display leading-[1.15] tracking-[0.02em] sm:text-[1.75rem] text-[1.5rem] text-balance tracking-[-0.02em] pt-10 px-5 sm:px-8">Renders like a user</h3><p class=sr-only>Engraving of an eighteenth century printing shop, the pressman at the press with a sheet on the tympan. From the Encyclopedie of Diderot and d&#39;Alembert.</p><div class="min-w-0 px-5 sm:px-8 pt-5"><figure aria-hidden=true class="flex flex-col min-w-0 gap-2" data-astro-cid-a252b257><div class="min-w-0 border-[hsl(var(--md-rule)/0.6)] border overflow-hidden relative pg aspect-[4/3]" data-astro-cid-a252b257 data-tone=picture><div class="absolute inset-0 pg-grain" data-astro-cid-a252b257></div><div class="absolute inset-0 pg-figure" data-astro-cid-a252b257 data-kind=render data-lazy-mask=/img/landing/plate-render.webp></div></div></figure></div><div class="flex flex-col min-w-0 px-5 gap-4 sm:px-8 pb-8 pt-5"><p class="text-muted-foreground font-mono uppercase tracking-[0.1em] leading-[1.7] max-w-[34rem] text-[12px]">Scripts run, lazy images load, and infinite scroll reaches the end. You get the page a person sees, not the one the server sends.</p><a class="items-center inline-flex transition-colors gap-1.5 no-underline font-mono hover:text-muted-foreground text-foreground text-xs tracking-[0.14em] uppercase" href=/browser/ >See the browser <span aria-hidden=true>&rarr;</span></a></div></li><li class="flex flex-col min-w-0 border-[hsl(var(--md-rule)/0.6)] border-t relative md:border-l md:border-t-0 pl-cell"><div class=pl-tabs aria-hidden=true><span class=con-tab>checkpoint</span> <code class="font-mono leading-[1.6] con-tab con-tab-r normal-case text-[12px] text-[hsl(var(--md-code-fg))] tracking-normal">stealth: true</code></div><h3 class="text-foreground uppercase [font-optical-sizing:auto] font-[500] font-display leading-[1.15] tracking-[0.02em] sm:text-[1.75rem] text-[1.5rem] text-balance tracking-[-0.02em] pt-10 px-5 sm:px-8">Loads the protected page</h3><p class=sr-only>Engraving of the Porta Maggiore in Rome, two arches under an inscribed attic with the road passing through. From Piranesi&#39;s Vedute di Roma.</p><div class="min-w-0 px-5 sm:px-8 pt-5"><figure aria-hidden=true class="flex flex-col min-w-0 gap-2" data-astro-cid-a252b257><div class="min-w-0 border-[hsl(var(--md-rule)/0.6)] border overflow-hidden relative pg aspect-[4/3]" data-astro-cid-a252b257 data-tone=picture><div class="absolute inset-0 pg-grain" data-astro-cid-a252b257></div><div class="absolute inset-0 pg-figure" data-astro-cid-a252b257 data-kind=checkpoint data-lazy-mask=/img/landing/plate-checkpoint.webp></div></div></figure></div><div class="flex flex-col min-w-0 px-5 gap-4 sm:px-8 pb-8 pt-5"><p class="text-muted-foreground font-mono uppercase tracking-[0.1em] leading-[1.7] max-w-[34rem] text-[12px]">Spider is a real browser engine, so a protected page loads for it the way it loads for a person, geo checks included. What comes back is the page, with a 200.</p><a class="items-center inline-flex transition-colors gap-1.5 no-underline font-mono hover:text-muted-foreground text-foreground text-xs tracking-[0.14em] uppercase" href=/api/scrape/ >See the scrape API <span aria-hidden=true>&rarr;</span></a></div></li><li class="flex flex-col min-w-0 border-[hsl(var(--md-rule)/0.6)] border-t relative pl-cell"><div class=pl-tabs aria-hidden=true><span class=con-tab>extract</span> <code class="font-mono leading-[1.6] con-tab con-tab-r normal-case text-[12px] text-[hsl(var(--md-code-fg))] tracking-normal">return_format: &quot;markdown&quot;</code></div><h3 class="text-foreground uppercase [font-optical-sizing:auto] font-[500] font-display leading-[1.15] tracking-[0.02em] sm:text-[1.75rem] text-[1.5rem] text-balance tracking-[-0.02em] pt-10 px-5 sm:px-8">Extracts the content</h3><p class=sr-only>Woodcut of a papermaker lifting a fresh sheet from the vat on a mould, a boy carrying finished sheets beside him. From Jost Amman&#39;s Book of Trades.</p><div class="min-w-0 px-5 sm:px-8 pt-5"><figure aria-hidden=true class="flex flex-col min-w-0 gap-2" data-astro-cid-a252b257><div class="min-w-0 border-[hsl(var(--md-rule)/0.6)] border overflow-hidden relative pg aspect-[4/3]" data-astro-cid-a252b257 data-tone=picture><div class="absolute inset-0 pg-grain" data-astro-cid-a252b257></div><div class="absolute inset-0 pg-figure" data-astro-cid-a252b257 data-kind=extract data-lazy-mask=/img/landing/plate-extract.webp></div></div></figure></div><div class="flex flex-col min-w-0 px-5 gap-4 sm:px-8 pb-8 pt-5"><p class="text-muted-foreground font-mono uppercase tracking-[0.1em] leading-[1.7] max-w-[34rem] text-[12px]">Navigation, ads and footers drop away. What is left is markdown or JSON that reads the way the page was written.</p><a class="items-center inline-flex transition-colors gap-1.5 no-underline font-mono hover:text-muted-foreground text-foreground text-xs tracking-[0.14em] uppercase" href=/docs/api/scrape/ >See the formats <span aria-hidden=true>&rarr;</span></a></div></li><li class="flex flex-col min-w-0 border-[hsl(var(--md-rule)/0.6)] border-t relative md:border-l pl-cell"><div class=pl-tabs aria-hidden=true><span class=con-tab>stream</span> <code class="font-mono leading-[1.6] con-tab con-tab-r normal-case text-[12px] text-[hsl(var(--md-code-fg))] tracking-normal">application/jsonl</code></div><h3 class="text-foreground uppercase [font-optical-sizing:auto] font-[500] font-display leading-[1.15] tracking-[0.02em] sm:text-[1.75rem] text-[1.5rem] text-balance tracking-[-0.02em] pt-10 px-5 sm:px-8">Streams in order</h3><p class=sr-only>Engraving of the Marly machine in elevation, a water wheel driving a row of pumps on pilings. From the Encyclopedie of Diderot and d&#39;Alembert.</p><div class="min-w-0 px-5 sm:px-8 pt-5"><figure aria-hidden=true class="flex flex-col min-w-0 gap-2" data-astro-cid-a252b257><div class="min-w-0 border-[hsl(var(--md-rule)/0.6)] border overflow-hidden relative pg aspect-[4/3]" data-astro-cid-a252b257 data-tone=picture><div class="absolute inset-0 pg-grain" data-astro-cid-a252b257></div><div class="absolute inset-0 pg-figure" data-astro-cid-a252b257 data-kind=stream data-lazy-mask=/img/landing/plate-stream.webp></div></div></figure></div><div class="flex flex-col min-w-0 px-5 gap-4 sm:px-8 pb-8 pt-5"><p class="text-muted-foreground font-mono uppercase tracking-[0.1em] leading-[1.7] max-w-[34rem] text-[12px]">Each page in a crawl arrives as one JSONL line the moment it is done, in order. Nothing waits for the last URL.</p><a class="items-center inline-flex transition-colors gap-1.5 no-underline font-mono hover:text-muted-foreground text-foreground text-xs tracking-[0.14em] uppercase" href=/docs/core/concurrent-streaming/ >See streaming <span aria-hidden=true>&rarr;</span></a></div></li></ol></div></section><section class="min-w-0 w-full lg:px-16 max-w-site md:px-12 mx-auto px-4 sm:px-6 lg:pt-36 md:pt-32 pt-24 hs-defer hs-reveal" data-astro-cid-w4p3l6me aria-labelledby=home-pricing-title style=--hs-h0:854px;--hs-h1:839px;--hs-h2:511px;--hs-h3:476px><h2 class="text-foreground [font-optical-sizing:auto] font-[500] font-display text-balance scroll-m-20 tracking-[-0.03em] leading-[1.05] lg:text-[3rem] sm:text-[2.5rem] text-[2rem]" id=home-pricing-title data-astro-cid-cjtx3uua>Pay for usage, or for concurrency.</h2><div class="grid grid-cols-1 md:grid-cols-2 gap-7 lg:pt-12 pt-10" data-astro-cid-cjtx3uua><div class="flex flex-col con-tick bg-background lg:px-10 p-7 sm:p-9" data-astro-cid-cjtx3uua><div class="absolute inset-0 overflow-hidden pe pointer-events-none" aria-hidden=true data-astro-cid-7yk4m3wq><div class="absolute inset-0 pe-grain" data-astro-cid-7yk4m3wq></div><div class="absolute inset-0 pe-figure" data-kind=usage data-lazy-mask=/img/landing/pricing-usage.webp data-astro-cid-7yk4m3wq></div></div><h3 class=con-tab data-astro-cid-cjtx3uua>pay as you go</h3><span class="con-tab con-tab-r" data-astro-cid-cjtx3uua>no minimum</span><div class="flex items-baseline gap-2.5 mt-2 relative" data-astro-cid-cjtx3uua><span class="text-foreground [font-optical-sizing:auto] font-[500] font-display text-[2.75rem] tabular-nums tracking-[-0.04em] leading-none lg:text-[4rem] sm:text-[3.5rem]" data-astro-cid-cjtx3uua>$1</span> <span class="text-muted-foreground font-mono uppercase tracking-[0.1em] text-xs whitespace-nowrap" data-astro-cid-cjtx3uua>per GB</span></div><p class="text-muted-foreground font-mono relative text-xs mt-2" data-astro-cid-cjtx3uua>Plus $0.0001 per CPU minute.</p><dl class="text-muted-foreground font-mono relative border-[hsl(var(--md-rule)/0.6)] border-t mt-6 text-[13px]" data-astro-cid-cjtx3uua><div class="flex items-baseline border-[hsl(var(--md-rule)/0.6)] border-b flex-wrap gap-x-4 gap-y-1 justify-between py-3" data-astro-cid-cjtx3uua><dt data-astro-cid-cjtx3uua>Bandwidth</dt><dd class=text-foreground data-astro-cid-cjtx3uua>$1 per GB</dd></div><div class="flex items-baseline border-[hsl(var(--md-rule)/0.6)] border-b flex-wrap gap-x-4 gap-y-1 justify-between py-3" data-astro-cid-cjtx3uua><dt data-astro-cid-cjtx3uua>CPU time</dt><dd class=text-foreground data-astro-cid-cjtx3uua>$0.0001 per minute</dd></div><div class="flex items-baseline border-[hsl(var(--md-rule)/0.6)] border-b flex-wrap gap-x-4 gap-y-1 justify-between py-3" data-astro-cid-cjtx3uua><dt data-astro-cid-cjtx3uua>Blocked, timed out, failed</dt><dd class="dark:text-brand-400 text-brand-700" data-astro-cid-cjtx3uua>$0</dd></div></dl><a class="items-center inline-flex transition-colors gap-1.5 no-underline font-mono hover:text-muted-foreground text-foreground text-xs tracking-[0.14em] uppercase self-start mt-auto pt-6 relative" href=/register/ data-astro-cid-cjtx3uua>Start free<span aria-hidden=true data-astro-cid-cjtx3uua>&rarr;</span></a></div><div class="flex flex-col con-tick bg-background lg:px-10 p-7 sm:p-9" data-astro-cid-cjtx3uua><div class="absolute inset-0 overflow-hidden pe pointer-events-none" aria-hidden=true data-astro-cid-7yk4m3wq><div class="absolute inset-0 pe-grain" data-astro-cid-7yk4m3wq></div><div class="absolute inset-0 pe-figure" data-kind=concurrency data-lazy-mask=/img/landing/pricing-concurrency.webp data-astro-cid-7yk4m3wq></div></div><h3 class=con-tab data-astro-cid-cjtx3uua>unlimited</h3><span class="con-tab con-tab-r" data-astro-cid-cjtx3uua>flat rate</span><div class="flex items-baseline gap-2.5 mt-2 relative" data-astro-cid-cjtx3uua><span class="text-muted-foreground font-mono uppercase tracking-[0.1em] text-xs whitespace-nowrap" data-astro-cid-cjtx3uua>from</span> <span class="text-foreground [font-optical-sizing:auto] font-[500] font-display text-[2.75rem] tabular-nums tracking-[-0.04em] leading-none lg:text-[4rem] sm:text-[3.5rem]" data-astro-cid-cjtx3uua>$40</span> <span class="text-muted-foreground font-mono uppercase tracking-[0.1em] text-xs whitespace-nowrap" data-astro-cid-cjtx3uua>a month</span></div><p class="text-muted-foreground font-mono relative text-xs mt-2" data-astro-cid-cjtx3uua>Priced by concurrency. <a class="text-foreground underline underline-offset-2" href=/pricing/ data-astro-cid-cjtx3uua>View concurrency pricing</a></p><dl class="text-muted-foreground font-mono relative border-[hsl(var(--md-rule)/0.6)] border-t mt-6 text-[13px]" data-astro-cid-cjtx3uua><div class="flex items-baseline border-[hsl(var(--md-rule)/0.6)] border-b flex-wrap gap-x-4 gap-y-1 justify-between py-3" data-astro-cid-cjtx3uua><dt data-astro-cid-cjtx3uua>Requests</dt><dd class=text-foreground data-astro-cid-cjtx3uua>unlimited</dd></div><div class="flex items-baseline border-[hsl(var(--md-rule)/0.6)] border-b flex-wrap gap-x-4 gap-y-1 justify-between py-3" data-astro-cid-cjtx3uua><dt data-astro-cid-cjtx3uua>Starting concurrency</dt><dd class=text-foreground data-astro-cid-cjtx3uua>2 requests in flight</dd></div><div class="flex items-baseline border-[hsl(var(--md-rule)/0.6)] border-b flex-wrap gap-x-4 gap-y-1 justify-between py-3" data-astro-cid-cjtx3uua><dt data-astro-cid-cjtx3uua>Per concurrent request</dt><dd class=text-foreground data-astro-cid-cjtx3uua>$20 down to $13</dd></div></dl><a class="items-center inline-flex transition-colors gap-1.5 no-underline font-mono hover:text-muted-foreground text-foreground text-xs tracking-[0.14em] uppercase self-start mt-auto pt-6 relative" href=/pricing/ data-astro-cid-cjtx3uua>See unlimited plans<span aria-hidden=true data-astro-cid-cjtx3uua>&rarr;</span></a></div></div></section><section class="min-w-0 w-full lg:px-16 max-w-site md:px-12 mx-auto px-4 sm:px-6 lg:pt-36 md:pt-32 pt-24 hs-defer hs-reveal" data-astro-cid-w4p3l6me aria-labelledby=home-setup-title style=--hs-h0:1444px;--hs-h1:1135px;--hs-h2:1103px;--hs-h3:1086px><div class="grid grid-cols-1 gap-8 lg:gap-20 lg:grid-cols-[minmax(0,1.1fr)_minmax(0,0.9fr)] lg:items-end" data-astro-cid-jmq6zs5r><div class=min-w-0 data-astro-cid-jmq6zs5r><h2 class="text-foreground [font-optical-sizing:auto] font-[500] font-display text-balance scroll-m-20 tracking-[-0.03em] leading-[1.05] lg:text-[3rem] sm:text-[2.5rem] text-[2rem]" id=home-setup-title data-astro-cid-jmq6zs5r>Make your first request.</h2><p class="text-muted-foreground max-w-[34rem] leading-[1.55] max-w-[38rem] mt-4 text-lg text-pretty" data-astro-cid-jmq6zs5r>Three steps, the same ones the dashboard shows after you sign up. Pick your client and paste.</p></div><div class="items-center flex flex-wrap gap-x-5 gap-y-2 lg:justify-end" data-astro-cid-jmq6zs5r aria-label=Client data-home-tablist role=tablist><button class="text-muted-foreground hover:text-foreground transition-colors inline-flex items-center font-mono uppercase text-2xs whitespace-nowrap aria-selected:border-foreground aria-selected:text-foreground border-b border-transparent focus-visible:outline focus-visible:outline-2 focus-visible:outline-foreground focus-visible:outline-offset-4 focus-visible:text-foreground pb-2 tracking-[0.14em]" type=button data-astro-cid-jmq6zs5r aria-controls=home-setup-panel-claude-code aria-selected=true data-home-kind=connect data-home-tab=claude-code id=home-setup-tab-claude-code role=tab tabindex=0>claude code</button><button class="text-muted-foreground hover:text-foreground transition-colors inline-flex items-center font-mono uppercase text-2xs whitespace-nowrap aria-selected:border-foreground aria-selected:text-foreground border-b border-transparent focus-visible:outline focus-visible:outline-2 focus-visible:outline-foreground focus-visible:outline-offset-4 focus-visible:text-foreground pb-2 tracking-[0.14em]" type=button data-astro-cid-jmq6zs5r aria-controls=home-setup-panel-codex aria-selected=false data-home-kind=connect data-home-tab=codex id=home-setup-tab-codex role=tab tabindex=-1>codex</button><button class="text-muted-foreground hover:text-foreground transition-colors inline-flex items-center font-mono uppercase text-2xs whitespace-nowrap aria-selected:border-foreground aria-selected:text-foreground border-b border-transparent focus-visible:outline focus-visible:outline-2 focus-visible:outline-foreground focus-visible:outline-offset-4 focus-visible:text-foreground pb-2 tracking-[0.14em]" type=button data-astro-cid-jmq6zs5r aria-controls=home-setup-panel-agent-cli aria-selected=false data-home-kind=request data-home-tab=agent-cli id=home-setup-tab-agent-cli role=tab tabindex=-1>agent cli</button><button class="text-muted-foreground hover:text-foreground transition-colors inline-flex items-center font-mono uppercase text-2xs whitespace-nowrap aria-selected:border-foreground aria-selected:text-foreground border-b border-transparent focus-visible:outline focus-visible:outline-2 focus-visible:outline-foreground focus-visible:outline-offset-4 focus-visible:text-foreground pb-2 tracking-[0.14em]" type=button data-astro-cid-jmq6zs5r aria-controls=home-setup-panel-mcp aria-selected=false data-home-kind=connect data-home-tab=mcp id=home-setup-tab-mcp role=tab tabindex=-1>mcp</button><button class="text-muted-foreground hover:text-foreground transition-colors inline-flex items-center font-mono uppercase text-2xs whitespace-nowrap aria-selected:border-foreground aria-selected:text-foreground border-b border-transparent focus-visible:outline focus-visible:outline-2 focus-visible:outline-foreground focus-visible:outline-offset-4 focus-visible:text-foreground pb-2 tracking-[0.14em]" type=button data-astro-cid-jmq6zs5r aria-controls=home-setup-panel-curl aria-selected=false data-home-kind=request data-home-tab=curl id=home-setup-tab-curl role=tab tabindex=-1>curl</button><button class="text-muted-foreground hover:text-foreground transition-colors inline-flex items-center font-mono uppercase text-2xs whitespace-nowrap aria-selected:border-foreground aria-selected:text-foreground border-b border-transparent focus-visible:outline focus-visible:outline-2 focus-visible:outline-foreground focus-visible:outline-offset-4 focus-visible:text-foreground pb-2 tracking-[0.14em]" type=button data-astro-cid-jmq6zs5r aria-controls=home-setup-panel-python aria-selected=false data-home-kind=request data-home-tab=python id=home-setup-tab-python role=tab tabindex=-1>python</button><button class="text-muted-foreground hover:text-foreground transition-colors inline-flex items-center font-mono uppercase text-2xs whitespace-nowrap aria-selected:border-foreground aria-selected:text-foreground border-b border-transparent focus-visible:outline focus-visible:outline-2 focus-visible:outline-foreground focus-visible:outline-offset-4 focus-visible:text-foreground pb-2 tracking-[0.14em]" type=button data-astro-cid-jmq6zs5r aria-controls=home-setup-panel-js aria-selected=false data-home-kind=request data-home-tab=js id=home-setup-tab-js role=tab tabindex=-1>js</button></div></div><div class="lg:pt-12 pt-10" data-astro-cid-jmq6zs5r><div class="scroll-m-24 bg-background con-tick" data-astro-cid-jmq6zs5r id=quickstart data-home-kind=connect data-home-quickstart><div class=pl-tabs data-astro-cid-jmq6zs5r aria-hidden=true><span class=con-tab data-astro-cid-jmq6zs5r>quickstart</span> <code class="font-mono leading-[1.6] con-tab con-tab-r normal-case text-[12px] text-[hsl(var(--md-code-fg))] tracking-normal" data-astro-cid-jmq6zs5r><span class="hidden sm:inline" data-astro-cid-jmq6zs5r>Authorization: </span>Bearer $SPIDER_API_KEY</code></div><span class=sr-only data-astro-cid-jmq6zs5r aria-live=polite data-home-live></span><div class="grid grid-cols-1 lg:grid-cols-[minmax(0,4fr)_minmax(0,8fr)] xl:grid-cols-[minmax(0,5fr)_minmax(0,7fr)]" data-astro-cid-jmq6zs5r><div class="min-w-0 flex-col border-[hsl(var(--md-rule)/0.6)] gap-5 hidden lg:border-r lg:flex pb-8 pt-10 px-8" data-astro-cid-jmq6zs5r><h3 class="text-foreground uppercase [font-optical-sizing:auto] font-[500] font-display leading-[1.15] tracking-[0.02em] sm:text-[1.75rem] text-[1.5rem] text-balance tracking-[-0.02em]" data-astro-cid-jmq6zs5r>One key, one request</h3><p class="text-muted-foreground text-pretty leading-[1.55] max-w-[26rem] text-[15px]" data-astro-cid-jmq6zs5r>Every client below sends the same header, so the key is the only thing you type. Connect an agent or call the API directly; the page comes back the same way.</p><a class="items-center inline-flex transition-colors gap-1.5 no-underline font-mono hover:text-muted-foreground text-foreground text-xs tracking-[0.14em] uppercase self-start" href=/docs/quickstart/ data-home-cta=home_setup_docs data-astro-cid-jmq6zs5r>Quickstart in the docs <span data-astro-cid-jmq6zs5r aria-hidden=true>&rarr;</span></a><p class=sr-only data-astro-cid-jmq6zs5r>Engraving of two hands cutting a quill with a penknife. From the Ecritures plates of the Encyclopedie of Diderot and d&#39;Alembert.</p><figure aria-hidden=true class="flex flex-col min-w-0 gap-2 flex-1 min-h-0" data-astro-cid-a252b257><div class="min-w-0 border-[hsl(var(--md-rule)/0.6)] border overflow-hidden relative pg flex-1 min-h-[16rem]" data-astro-cid-a252b257 data-tone=quiet data-fill><div class="absolute inset-0 pg-grain" data-astro-cid-a252b257></div><div class="absolute inset-0 pg-figure" data-astro-cid-a252b257 data-kind=request data-lazy-mask=/img/landing/plate-request.webp></div></div></figure></div><div class="flex flex-col min-w-0" data-astro-cid-jmq6zs5r><div class="flex flex-col min-w-0 px-5 gap-4 sm:px-8 py-7 lg:pt-10 pt-9" data-astro-cid-jmq6zs5r><h3 class="flex items-baseline gap-3" data-astro-cid-jmq6zs5r><span class="text-muted-foreground font-mono tracking-[0.14em] text-2xs tabular-nums" data-astro-cid-jmq6zs5r>01</span> <span class="text-foreground uppercase [font-optical-sizing:auto] font-[500] font-display leading-[1.15] tracking-[0.02em] text-[1.25rem]" data-astro-cid-jmq6zs5r>Get a key</span></h3><a class="items-center inline-flex transition-colors no-underline font-mono uppercase self-start bg-foreground border border-foreground font-medium h-8 hover:bg-foreground/90 justify-center px-3.5 sm:w-auto text-2xs text-background tracking-[0.12em] w-full" href=/register/ data-home-cta=home_setup_key data-astro-cid-jmq6zs5r>Create API key</a><p class="text-muted-foreground max-w-[34rem] leading-[1.5] text-[13.5px]" data-astro-cid-jmq6zs5r>Sign up and copy the key. New accounts start with a free balance.</p><div class="flex flex-col min-w-0 border-[hsl(var(--md-rule)/0.6)] gap-3 bg-background border items-start px-3 py-2 sm:flex-row" data-astro-cid-jmq6zs5r data-home-copy><pre class="font-mono leading-[1.6] min-w-0 [overflow-wrap:anywhere] flex-1 text-[12.5px] text-foreground w-full whitespace-pre-wrap" data-astro-cid-jmq6zs5r>export SPIDER_API_KEY=&quot;sk-...&quot;</pre><button class="text-muted-foreground hover:text-foreground transition-colors font-mono uppercase text-2xs whitespace-nowrap focus-visible:outline-2 focus-visible:text-foreground tracking-[0.14em] focus-visible:outline focus-visible:outline-foreground focus-visible:outline-offset-2 min-w-[19ch] self-end shrink-0 sm:self-start text-right w-[19ch]" type=button data-astro-cid-jmq6zs5r aria-label="Copy the export line" data-home-copy-btn>copy</button></div><p class="text-muted-foreground max-w-[34rem] leading-[1.5] text-[13.5px]" data-astro-cid-jmq6zs5r>SDKs, the MCP server and every command read it.</p></div><div class="min-w-0 border-[hsl(var(--md-rule)/0.6)] border-t grid" data-astro-cid-jmq6zs5r><div class="flex flex-col min-w-0 px-5 gap-4 sm:px-8 py-7 [grid-area:1/1]" data-astro-cid-jmq6zs5r aria-hidden=false aria-labelledby=home-setup-tab-claude-code data-home-panel=claude-code id=home-setup-panel-claude-code role=tabpanel><h3 class="flex items-baseline gap-3" data-astro-cid-jmq6zs5r><span class="text-muted-foreground font-mono tracking-[0.14em] text-2xs tabular-nums" data-astro-cid-jmq6zs5r>02</span> <span class="text-foreground uppercase [font-optical-sizing:auto] font-[500] font-display leading-[1.15] tracking-[0.02em] text-[1.25rem]" data-astro-cid-jmq6zs5r>Connect Claude Code</span></h3><div class="flex flex-col min-w-0 gap-2" data-astro-cid-jmq6zs5r><div class="flex flex-col min-w-0 border-[hsl(var(--md-rule)/0.6)] gap-3 bg-background border items-start px-3 py-2 sm:flex-row" data-astro-cid-jmq6zs5r data-home-copy><pre class="font-mono leading-[1.6] min-w-0 [overflow-wrap:anywhere] flex-1 text-[12.5px] text-foreground w-full whitespace-pre-wrap" data-astro-cid-jmq6zs5r>claude mcp add spider --transport http \
  https://mcp.spider.cloud/mcp \
  -H &quot;Authorization: Bearer $SPIDER_API_KEY&quot;</pre><button class="text-muted-foreground hover:text-foreground transition-colors font-mono uppercase text-2xs whitespace-nowrap focus-visible:outline-2 focus-visible:text-foreground tracking-[0.14em] focus-visible:outline focus-visible:outline-foreground focus-visible:outline-offset-2 min-w-[19ch] self-end shrink-0 sm:self-start text-right w-[19ch]" type=button data-astro-cid-jmq6zs5r aria-label="Copy this snippet" data-home-copy-btn>copy</button></div></div><div class="flex flex-col min-w-0 gap-2" data-astro-cid-jmq6zs5r><span class="text-muted-foreground font-mono tracking-[0.08em] text-2xs" data-astro-cid-jmq6zs5r>CLAUDE.md</span><div class="flex flex-col min-w-0 border-[hsl(var(--md-rule)/0.6)] gap-3 bg-background border items-start px-3 py-2 sm:flex-row" data-astro-cid-jmq6zs5r data-home-copy><pre class="font-mono leading-[1.6] min-w-0 [overflow-wrap:anywhere] flex-1 text-[12.5px] text-foreground w-full whitespace-pre-wrap" data-astro-cid-jmq6zs5r>For web pages use spider-agent. Read https://spider.cloud/agent-skill/spider-agent/SKILL.md first.</pre><button class="text-muted-foreground hover:text-foreground transition-colors font-mono uppercase text-2xs whitespace-nowrap focus-visible:outline-2 focus-visible:text-foreground tracking-[0.14em] focus-visible:outline focus-visible:outline-foreground focus-visible:outline-offset-2 min-w-[19ch] self-end shrink-0 sm:self-start text-right w-[19ch]" type=button data-astro-cid-jmq6zs5r aria-label="Copy this snippet" data-home-copy-btn>copy</button></div><p class="text-muted-foreground max-w-[34rem] leading-[1.5] text-[13.5px]" data-astro-cid-jmq6zs5r>Or the CLI. It picks HTTP or a browser per page, stops at your budget, and returns 187 bytes for named fields where asking for everything returns 9021.</p></div><a class="items-center inline-flex transition-colors gap-1.5 no-underline font-mono hover:text-muted-foreground text-foreground text-xs tracking-[0.14em] upperc