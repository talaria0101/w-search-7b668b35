          #pricing .pricing-table-wrapper { min-width: 0 !important; margin-top: 10px !important; }
          #pricing table { min-width: 620px !important; font-size: 13px !important; }
          #pricing thead th, #pricing tbody td { padding: 12px 10px !important; }
          #pricing thead th:first-child, #pricing tbody td:first-child { min-width: 150px !important; }
          #pricing .plan-name { font-size: 17px !important; }
          #pricing .plan-price { font-size: 26px !important; }
          #pricing .pricing-fade-right {
            display: block !important;
            position: absolute;
            top: 0;
            right: 0;
            bottom: 0;
            width: 40px;
            background: linear-gradient(to right, rgba(0,0,0,0), rgba(0,0,0,0.5));
            pointer-events: none;
            border-radius: 0 12px 12px 0;
          }
        }
        @keyframes pricingSwipe {
          0%, 100% { transform: translateX(0); }
          50% { transform: translateX(6px); }
        }
