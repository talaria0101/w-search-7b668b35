  <span class="ck">new</span> URLSearchParams({ url: <span class="cs">'https://example.com'</span> }),
  { headers: { <span class="cs">'x-api-key'</span>: <span class="cs">'<span class="cp">YOUR_API_KEY</span>'</span> } },
);
console.log(<span class="ck">await</span> res.text());</code></pre>
