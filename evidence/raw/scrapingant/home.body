<style>.hp-contact{padding:96px 0 110px;background:#1a1a1a;color:#fff;font-family:var(--c-mono)}.hp-contact-grid{display:grid;grid-template-columns:.85fr 1.15fr;gap:64px;align-items:center}.hp-contact-eyebrow{display:inline-block;font-size:12px;letter-spacing:1.5px;color:#f5a623;font-weight:700;text-transform:uppercase;margin-bottom:14px}.hp-contact-h{font-size:36px;line-height:1.15;color:#fff;margin:0 0 18px;font-weight:700;letter-spacing:-.6px}.hp-contact-h .hp-mark{background:linear-gradient(180deg,transparent 62%,#f5a623 62%,#f5a623 92%,transparent 92%);padding:0 4px}.hp-contact-body{font-size:16px;color:#ffffffb3;line-height:1.6;margin:0 0 26px}.hp-contact-quote{background:#ffffff0a;border-left:3px solid #f5a623;border-radius:8px;padding:18px 20px;margin-bottom:22px}.hp-contact-quote p{font-size:15px;line-height:1.55;color:#ffffffd9;margin:0 0 10px;font-style:italic}.hp-contact-author{display:flex;align-items:center;gap:12px}.hp-contact-author img{width:40px;height:40px;border-radius:50%;object-fit:cover;flex-shrink:0}.hp-contact-author-name{font-size:14px;color:#fff;font-weight:700;line-height:1.3;font-style:normal}.hp-contact-author-role{font-size:12px;color:#ffffff8c;line-height:1.3;margin-top:2px}.hp-contact-card{background:#ffffff0a;border:1px solid rgba(255,255,255,.08);border-radius:14px;padding:30px}.hp-form-row{display:grid;grid-template-columns:1fr 1fr;gap:12px;margin-bottom:12px}.hp-form-row--single{grid-template-columns:1fr}.hp-form-input{width:100%;padding:12px 14px;background:#ffffff0f;border:1px solid rgba(255,255,255,.12);border-radius:8px;color:#fff;font-family:inherit;font-size:14.5px;transition:border-color .15s,background .15s;box-sizing:border-box}.hp-form-input:focus{outline:none;border-color:#f5a623;background:#ffffff14}.hp-form-input::placeholder{color:#fff6}textarea.hp-form-input{resize:vertical;min-height:96px;font-family:inherit}.hp-form-submit{width:100%;padding:14px 22px;background:#f5a623;color:#1a1a1a;border:0;border-radius:8px;font-weight:700;cursor:pointer;font-size:15px;transition:transform .15s,background .15s;font-family:inherit;margin-top:4px}.hp-form-submit:hover{transform:translateY(-1px);background:#ffb937}.hp-form-note{font-size:12px;color:#ffffff80;margin:12px 0 0;text-align:center}.w-form-done,.w-form-fail{display:none}.w-form-done.hp-show,.w-form-fail.hp-show{display:block}.hp-contact-card.hp-submitted form{display:none}.hp-form-success,.hp-form-error{padding:14px 16px;border-radius:8px;margin-top:12px;font-size:14px}.hp-form-success{background:#27ae6026;color:#abe338;border:1px solid rgba(39,174,96,.3)}.hp-form-error{background:#e74c3c26;color:#ff8a7a;border:1px solid rgba(231,76,60,.3)}@media(max-width:900px){.hp-contact{padding:64px 0 72px}.hp-contact-grid{grid-template-columns:1fr;gap:36px}.hp-contact-h{font-size:28px}.hp-contact-card{padding:22px}.hp-form-row{grid-template-columns:1fr}}
</style>
