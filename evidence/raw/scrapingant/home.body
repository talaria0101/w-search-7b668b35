    <style>
      .hp-reviews { padding: 96px 0 110px; background: #fafaf7; }
      .hp-reviews-head { text-align: center; max-width: 720px; margin: 0 auto 56px; }
      .hp-reviews-eyebrow { display: inline-block; font-family: 'IBM Plex Mono', monospace; font-size: 12px; letter-spacing: 1.5px; color: #f5a623; font-weight: 700; text-transform: uppercase; margin-bottom: 14px; }
      .hp-reviews-h { font-family: 'IBM Plex Mono', monospace; font-size: 38px; line-height: 1.15; color: #1a1a1a; margin: 0 0 14px; font-weight: 700; letter-spacing: -0.6px; }
      .hp-reviews-h .hp-mark { background: linear-gradient(180deg, transparent 62%, #ffd803 62%, #ffd803 92%, transparent 92%); padding: 0 4px; }
      .hp-reviews-sub { font-family: 'IBM Plex Mono', monospace; font-size: 16px; color: #666; line-height: 1.55; margin: 0 0 22px; }
      .hp-reviews-capterra { display: inline-flex; align-items: center; gap: 10px; background: #fff; border: 1px solid #ececec; padding: 8px 14px; border-radius: 999px; text-decoration: none; box-shadow: 0 2px 6px rgba(0,0,0,0.04); transition: transform 0.15s, box-shadow 0.15s; font-family: 'IBM Plex Mono', monospace; }
      .hp-reviews-capterra:hover { transform: translateY(-1px); box-shadow: 0 6px 14px rgba(0,0,0,0.08); }
      .hp-reviews-capterra .hp-capterra-stars { color: #f5a623; font-size: 14px; letter-spacing: 1px; }
      .hp-reviews-capterra .hp-capterra-text { font-size: 13px; color: #1a1a1a; font-weight: 600; }
      .hp-reviews-capterra .hp-capterra-text strong { font-weight: 700; }
      .hp-reviews-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 20px; }
