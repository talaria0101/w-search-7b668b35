v5s9H5nXtRxJVeWJfN2QAIO-KdloJLZ0cg=w640-rw-lo 640w, https://lh3.googleusercontent.com/sstKLttccjVdRvqpzh06Hpr_2k7kzOMBBKhn8oIJTA1Bav_s8VbG1k9lhsbhMGUDifk3KdYgWDAR0xYfv5s9H5nXtRxJVeWJfN2QAIO-KdloJLZ0cg=w768-rw-lo 768w, https://lh3.googleusercontent.com/sstKLttccjVdRvqpzh06Hpr_2k7kzOMBBKhn8oIJTA1Bav_s8VbG1k9lhsbhMGUDifk3KdYgWDAR0xYfv5s9H5nXtRxJVeWJfN2QAIO-KdloJLZ0cg=w1024-rw-lo 1024w, https://lh3.googleusercontent.com/sstKLttccjVdRvqpzh06Hpr_2k7kzOMBBKhn8oIJTA1Bav_s8VbG1k9lhsbhMGUDifk3KdYgWDAR0xYfv5s9H5nXtRxJVeWJfN2QAIO-KdloJLZ0cg=w1440-rw-lo 1440w, https://lh3.googleusercontent.com/sstKLttccjVdRvqpzh06Hpr_2k7kzOMBBKhn8oIJTA1Bav_s8VbG1k9lhsbhMGUDifk3KdYgWDAR0xYfv5s9H5nXtRxJVeWJfN2QAIO-KdloJLZ0cg=w1728-rw-lo 1728w, https://lh3.googleusercontent.com/sstKLttccjVdRvqpzh06Hpr_2k7kzOMBBKhn8oIJTA1Bav_s8VbG1k9lhsbhMGUDifk3KdYgWDAR0xYfv5s9H5nXtRxJVeWJfN2QAIO-KdloJLZ0cg=w2880-rw-lo 2200w" type=image/webp><img src="https://lh3.googleusercontent.com/sstKLttccjVdRvqpzh06Hpr_2k7kzOMBBKhn8oIJTA1Bav_s8VbG1k9lhsbhMGUDifk3KdYgWDAR0xYfv5s9H5nXtRxJVeWJfN2QAIO-KdloJLZ0cg=w1440" alt class=picture__image height=1036 loading=lazy role=presentation width=1440></picture><div class="prompt-card__content has-no-icon"><span class=prompt-card__badge>NEW</span><span class=prompt-card__heading>Turn any PDF into an illustrated storybook animation</span><span class=prompt-card__text> Turn this dense PDF into an interactive animated visual web app that I can scrub through to make the key moments come alive </span></div></div></div><div class="marquee-carousel__slide js-marquee-card"><div class="prompt-card has-image has-extended-prompt has-modal" data-event-content-name="Create a retro-style mall studio portrait" data-modal-extended-prompt='First, ask me to upload an image of myself. After I upload the image, create a retro-style mall studio portrait of the subject. Give the subject 1980s clothing, accessories, and hairstyling. The subject should be facing the camera directly on an 80s laser studio background. In the upper right corner, there is also a second, superimposed three-quarter angle image of their face. This second image is a close-up of the subject laughing. This superimposed image should be free floating without any bounding shape and the edges should blend into the background. The overall style is 1980s studio photography, with studio lighting. In the bottom left corner in very small, gold cursive write "Gemini"' data-gtm-event=prompt_wall_select data-modal-open=modal-overlay-0-create-a-retro-style-mall-studio-portrait data-target=/prompts/create-a-retro-style-mall-studio-portrait/><picture class="image --scrim prompt-card__background-image" aria-hidden=true><source sizes="(max-width: 768px) calc(100vw - 2rem), (max-width: 1440px) 90vw, 1440px" srcset="https://lh3.googleusercontent.com/J8SpCLzE99R4_RY_z_pp1ZsxKWLX5SfhAS3Uunyo46dYq5hI1URgHQc81vJenkTIyY6GQOPngAWL8dtCifn9zibzUH3LOo0axXoe8J3U0v6BqzNiWQ=w393-rw-lo 393w, https://lh3.googleusercontent.com/J8SpCLzE99R4_RY_z_pp1ZsxKWLX5SfhAS3Uunyo46dYq5hI1URgHQc81vJenkTIyY6GQOPngAWL8dtCifn9zibzUH3LOo0axXoe8J3U0v6BqzNiWQ=w480-rw-lo 480w, https://lh3.googleusercontent.com/J8SpCLzE99R4_RY_z_pp1ZsxKWLX5SfhAS3Uunyo46dYq5hI1URgHQc81vJenkTIyY6GQOPngAWL8dtCifn9zibzUH3LOo0axXoe8J3U0v6BqzNiWQ=w640-rw-lo 640w, https://lh3.googleusercontent.com/J8SpCLzE99R4_RY_z_pp1ZsxKWLX5SfhAS3Uunyo46dYq5hI1URgHQc81vJenkTIyY6GQOPngAWL8dtCifn9zibzUH3LOo0axXoe8J3U0v6BqzNiWQ=w768-rw-lo 768w, https://lh3.googleusercontent.com/J8SpCLzE99R4_RY_z_pp1ZsxKWLX5SfhAS3Uunyo46dYq5hI1URgHQc81vJenkTIyY6GQOPngAWL8dtCifn9zibzUH3LOo0axXoe8J3U0v6BqzNiWQ=w1024-rw-lo 800w" type=image/webp><img src="https://lh3.googleusercontent.com/J8SpCLzE99R4_RY_z_pp1ZsxKWLX5SfhAS3Uunyo46dYq5hI1URgHQc81vJenkTIyY6GQOPngAWL8dtCifn9zibzUH3LOo0axXoe8J3U0v6BqzNiWQ=w1440" alt class=picture__image height=640 loading=lazy role=presentation width=800></picture><div class=prompt-card__content><span class="prompt-icon prompt-card__icon"> <span class=icon-md-outlined data-icon=image></span> </span><span class=prompt-card__heading>Create a retro-style mall studio portrait</span><span class=prompt-card__text> First, ask me to upload an image of myself. After I upload the image, create a retro-style mall studio portrait of the subject. Give the subject 1980s clothing, accessories, and hairstyling. The subject should be facing the camera directly on an 80s laser studio background. In the upper right corner, there is also a second, superimposed three-quarter angle image of their face. This second image is a close-up of the subject laughing. This superimposed image should be free floating without any bounding shape and the edges should blend into the background. The overall style is 1980s studio photography, with studio lighting. In the bottom left corner in very small, gold cursive write "Gemini" </span></div></div></div><div class="marquee-carousel__slide js-marquee-card"><div class="prompt-card has-image has-extended-prompt has-modal prompt-card--red" data-event-content-name="Turn everyday objects into playable games" data-modal-extended-prompt="Make me an image of a boxy pixel plane.
