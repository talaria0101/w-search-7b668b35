ded Most Scalable Provider by Proxyway for pairing industry-leading proxy network scale with top-tier success rates, speed, and stability.","spans":[],"direction":"ltr"}]},{"badgeMedia":{"link_type":"Web","key":"bf2e6c35-a4dc-4004-ad49-0c6c53d5c961","url":"https://public-files.oxylabs.io/website/WebAPI/Trust/iso.mp4"},"badgeImage":{},"badgeTitle":[{"type":"paragraph","text":"ISO/IEC 27001:2022","spans":[],"direction":"ltr"}],"badgeDescription":[{"type":"paragraph","text":"The standard for robust risk assessment and information security, covering our Datacenter Proxies, Residential Proxies, and Web API solutions.","spans":[],"direction":"ltr"}]},{"badgeMedia":{"link_type":"Web","key":"2963e030-7bb2-46ff-8f66-1ab7ea66a32c","url":"https://public-files.oxylabs.io/website/WebAPI/Trust/soc2.mp4"},"badgeImage":{},"badgeTitle":[{"type":"paragraph","text":"SOC 2 Type II Certification","spans":[],"direction":"ltr"}],"badgeDescription":[{"type":"paragraph","text":"This audit report covers controls relevant to Security, Availability, and Confidentiality across Oxylabs' Scrape endpoint and Web Unblocker solutions.","spans":[],"direction":"ltr"}]},{"badgeMedia":{"link_type":"Web","key":"252dd494-d65f-472b-9263-de1af2bb49f1","url":"https://public-files.oxylabs.io/website/WebAPI/Trust/AI.mp4"},"badgeImage":{},"badgeTitle":[{"type":"paragraph","text":"EU AI Act Alignment","spans":[],"direction":"ltr"}],"badgeDescription":[{"type":"paragraph","text":"At Oxylabs, EU AI Act principles are embedded in daily operations through internal policies on AI governance, safe AI usage, and employee AI use.","spans":[],"direction":"ltr"}]},{"badgeMedia":{"link_type":"Web","key":"b4cd86b5-e22b-4b2b-8e4b-33fb320de75f","url":"https://public-files.oxylabs.io/website/WebAPI/Trust/lock.mp4"},"badgeImage":{},"badgeTitle":[{"type":"paragraph","text":"Data Protection \u0026 Privacy","spans":[],"direction":"ltr"}],"badgeDescription":[{"type":"paragraph","text":"Data protection, privacy, and security are fundamental to our operations and product design – and we fully support the objectives and legal requirements of the GDPR.","spans":[],"direction":"ltr"}]},{"badgeMedia":{"link_type":"Web","key":"529c7815-103c-411a-8110-cb5b207c982c","url":"https://public-files.oxylabs.io/website/WebAPI/Trust/Shield.mp4"},"badgeImage":{},"badgeTitle":[{"type":"paragraph","text":"Information Security","spans":[],"direction":"ltr"}],"badgeDescription":[{"type":"paragraph","text":"Information security is embedded in Oxylabs' governance, with a certified management system and controls covering our operations and products.","spans":[],"direction":"ltr"}]},{"badgeMedia":{"link_type":"Web","key":"2f62d862-76e2-45ad-99cf-944971526959","url":"https://public-files.oxylabs.io/website/WebAPI/Trust/cnet.mp4"},"badgeImage":{},"badgeTitle":[{"type":"paragraph","text":"Best Proxy for Businesses","spans":[],"direction":"ltr"}],"badgeDescription":[{"type":"paragraph","text":"Rated \"as close to perfect as it gets\" by CNET, Oxylabs was ranked as the best proxy server for larger businesses on overall performance and pool quality.","spans":[],"direction":"ltr"}]},{"badgeMedia":{"link_type":"Web","key":"772e5bc5-3317-4332-94e4-f84b51aa4c68","url":"https://public-files.oxylabs.io/website/WebAPI/Trust/cyber%20shield.mp4"},"badgeImage":{},"badgeTitle":[{"type":"paragraph","text":"Insurance Coverage","spans":[],"direction":"ltr"}],"badgeDescription":[{"type":"paragraph","text":"All of our products are covered by Technology Errors \u0026 Omissions (Technology E\u0026O) and Cyber Insurance.","spans":[],"direction":"ltr"}]}],"buttons":[{"leftIconName":null,"text":"Visit trust center","rightIconName":null,"link":{"link_type":"Web","key":"9fba23aa-7264-4db3-80b7-7e38715156ae","url":"https://trust.oxylabs.io/","target":"_blank"},"action":null,"variant":"outline"}],"idAttribute":"enterprise-grade-by-default"}},{"variation":"largeCardsWithVideo","items":[],"slice_type":"cards","primary":{"theme":"dark","badgeText":"Testimonials","title":[{"type":"heading2","text":"Why industry leaders don’t look elsewhere","spans":[],"direction":"ltr"}],"description":[{"type":"paragraph","text":"Discover how top companies drive real results with our solutions.","spans":[{"start":0,"end":65,"type":"label","data":{"label":"lg-paragraph"}}],"direction":"ltr"}],"buttons":[{"leftIconName":null,"text":"See all stories","rightIconName":null,"link":{"link_type":"Web","key":"f633481b-876d-4c6a-a1ae-4032496d9cd4","url":"https://oxylabs.io/resources/case-studies","target":"_blank"},"action":null,"variant":"outline"}],"cards":[{"video":"https://public-files.oxylabs.io/website/WebAPI/testimonials/NIQ.mp4","poster":{},"logo":{"src":"https://oxylabs.io/oxylabs-web/Uj5zpYIj-hBB6Exq_nielsenIQ.png?auto=format,compress","alt":"","width":198,"height":56},"quote":[{"type":"paragraph","text":"“Great technology and good leaders matter, but without the right people and the right mindset, it doesn't work – and Oxylabs has all three.\"","spans":[],"direction":"ltr"}],"authorName":"Hocine Amrane","authorTitle":"Agile Rollout Senior Director at NielsenIQ","clipStart":null,"clipEnd":null},{"video":"https://public-files.oxylabs.io/website/WebAPI/testimonials/Wiser-compressed.mp4","poster":{},"logo":{"src":"https://oxylabs.io/prismic_resources/jo6mJJ8_G91M6RbG_wiser.svg","alt":"","width":86,"height":26},"quote":[{"type":"paragraph","text":"“Oxylabs proxy offerings are a critical part of Wiser’s workflows. [...] we execute crucial data operations and provide our clients with the freshest retail insights.”","spans":[],"direction":"ltr"}],"authorName":"Devon Kelly Walczak","authorTitle":"SVP Operations","clipStart":null,"clipEnd":null}],"idAttribute":"why-industry-leaders-don’t-look-elsewhere"}},{"variation":"largeCardsWithBackground","items":[],"slice_type":"cards","primary":{"theme":"dark","badgeText":"Infrastructure","title":[{"type":"heading2","text":"What’s behind the biggest data operations","spans":[],"direction":"ltr"},{"type":"paragraph","text":"Web API delivers because of what runs beneath it – new experience, the same proven infrastructure.","spans":[{"start":0,"end":98,"type":"label","data":{"label":"lg-paragraph"}}],"direction":"ltr"}],"cards":[{"asciiShaderPresetId":1,"backgroundImage":{"src":"https://oxylabs.io/oxylabs-web/OOlSUU0WvbZE471Y_Productlist-Proxies.png?auto=format,compress","alt":"","width":795,"height":1068},"icon":{"src":"https://oxylabs.io/oxylabs-web/fHloftgOwvUWaz7o_Frame1618873677.png?auto=format,compress","alt":"Proxy icon","width":112,"height":112},"title":[{"type":"heading5","text":"Proxies","spans":[],"direction":"ltr"}],"description":[{"type":"paragraph","text":"177M+ IPs – the backbone every request runs on, with proxy solutions built on top to reach even the most demanding targets reliably.","spans":[],"direction":"ltr"}],"buttons":[{"link":{"url":"https://oxylabs.io/products/residential-proxy-pool","link_type":"Web"},"text":"Residential Proxies"},{"link":{"url":"https://oxylabs.io/products/mobile-proxies","link_type":"Web"},"text":"Mobile Proxies"},{"link":{"url":"https://oxylabs.io/products/isp-proxies","link_type":"Web"},"text":"ISP Proxies"},{"link":{"url":"https://oxylabs.io/products/dedicated-isp-proxies","link_type":"Web"},"text":"Dedicated ISP Proxies"},{"link":{"url":"https://oxylabs.io/products/datacenter-proxies","link_type":"Web"},"text":"Datacenter Proxies"},{"link":{"url":"https://oxylabs.io/products/web-unblocker","link_type":"Web"},"text":"Web Unblocker"}],"asciiShaderConfig":{"font":"Instrument Sans","rows":51,"type":"image","gamma":3,"cutout":"off","invert":false,"columns":111,"kerning":0,"palette":["#0d1b2a","#2b6cff","#e0f2fe"],"trigger":"hover","cellSize":12,"charRamp":" .-=+#@","contrast":43,"pixelate":0,"toneGain":1,"animation":"pointer-reactive","blendMode":"normal","colorMode":"mono","edgeStyle":"sobel","glyphMode":"ramp","imageBlur":0,"monoColor":"#ffffff","background":"solid","brightness":-26,"fontWeight":400,"rampPreset":"custom","densityBias":0.95,"imageOpacity":1,"edgeDetection":true,"edgeThreshold":0.24,"revealOnHover":false,"animationSpeed":1,"cutoutSoftness":0.05,"backgroundColor":"#000000","cutoutThreshold":0.08,"pointerInfluence":1,"temporalSmoothing":1,"animationIntensity":1,"backgroundGradient":{"blur":0,"type":"linear","angle":145,"stops":[{"pos":0,"color":"#0a0a0a"},{"pos":1,"color":"#1f2a3a"}]}}},{"asciiShaderPresetId":1,"backgroundImage":{"src":"https://oxylabs.io/oxylabs-web/flVfT0IlcSFIMYNe_Productlist-Browser.png?auto=format,compress","alt":"","width":795,"height":1068},"icon":{"src":"https://oxylabs.io/oxylabs-web/7ZL1TkDKl6V_6Abm_Frame1618873677-1-.png?auto=format,compress","alt":"","width":112,"height":112},"title":[{"type":"heading5","text":"Browser","spans":[],"direction":"ltr"}],"description":[{"type":"paragraph","text":"Advanced browser automation for AI agents and scraping – complete multi-step tasks and fetch public data from dynamic websites at scale.","spans":[],"direction":"ltr"}],"buttons":[{"link":{"url":"https://oxylabs.io/products/agent-browser","link_type":"Web"},"text":"Agent Browser"}],"asciiShaderConfig":{"font":"Instrument Sans","rows":51,"type":"image","gamma":3,"cutout":"off","invert":false,"columns":111,"kerning":0,"palette":["#0d1b2a","#2b6cff","#e0f2fe"],"trigger":"hover","cellSize":12,"charRamp":" .-=+#@","contrast":43,"pixelate":0,"toneGain":1,"animation":"pointer-reactive","blendMode":"normal","colorMode":"mono","edgeStyle":"sobel","glyphMode":"ramp","imageBlur":0,"monoColor":"#ffffff","background":"solid","brightness":-26,"fontWeight":400,"rampPreset":"custom","densityBias":0.95,"imageOpacity":1,"edgeDetection":true,"edgeThreshold":0.24,"revealOnHover":false,"animationSpeed":1,"cutoutSoftness":0.05,"backgroundColor":"#000000","cutoutThreshold":0.08,"pointerInfluence":1,"temporalSmoothing":1,"animationIntensity":1,"backgroundGradient":{"blur":0,"type":"linear","angle":145,"stops":[{"pos":0,"color":"#0a0a0a"},{"pos":1,"color":"#1f2a3a"}]}}},{"asciiShaderPresetId":1,"backgroundImage":{"src":"https://oxylabs.io/oxylabs-web/K340PGsIS6VmucBO_Productlist-Datasets.png?auto=format,compress","alt":"","width":795,"height":1068},"icon":{"src":"https://oxylabs.io/oxylabs-web/m1xr-Q02Fo1YuvZE_Frame1618873677-2-.png?auto=format,compress","alt":"Datasets icon","width":112,"height":112},"title":[{"type":"heading5","text":"Datasets","spans":[],"direction":"ltr"}],"description":[{"type":"paragraph","text":"Clean, structured public data on demand – fresh, verified, and custom-made web datasets tailored to your exact needs.","spans":[],"direction":"ltr"}],"buttons":[{"link":{"url":"https://oxylabs.io/products/datasets","link_type":"Web"},"text":"Various datasets"},{"link":{"url":"https://oxylabs.io/products/video-datasets","link_type":"Web"},"text":"Video datasets"}],"asciiShaderConfig":{"font":"Instrument Sans","rows":51,"type":"image","gamma":3,"cutout":"off","invert":false,"columns":111,"kerning":0,"palette":["#0d1b2a","#2b6cff","#e0f2fe"],"trigger":"hover","cellSize":12,"charRamp":" .-=+#@","contrast":43,"pixelate":0,"toneGain":1,"animation":"pointer-reactive","blendMode":"normal","colorMode":"mono","edgeStyle":"sobel","glyphMode":"ramp","imageBlur":0,"monoColor":"#ffffff","background":"solid","brightness":-26,"fontWeight":400,"rampPreset":"custom","densityBias":0.95,"imageOpacity":1,"edgeDetection":true,"edgeThreshold":0.24,"revealOnHover":false,"animationSpeed":1,"cutoutSoftness":0.05,"backgroundColor":"#000000","cutoutThreshold":0.08,"pointerInfluence":1,"temporalSmoothing":1,"animationIntensity":1,"backgroundGradient":{"blur":0,"type":"linear","angle":145,"stops":[{"pos":0,"color":"#0a0a0a"},{"pos":1,"color":"#1f2a3a"}]}}}],"idAttribute":"what’s-behind-the-biggest-data-operations_web-api-delivers-because-of-what-runs-beneath-it-–-new-experience,-the-same-proven-infrastructure."}},{"variation":"releaseNotes","items":[{"buttonLink":"https://developers.oxylabs.io/products/web-api","buttonLinkTarget":"_blank","labels":["General updates"],"date":"October 07, 2026","title":[{"type":"heading2","text":"Introducing Oxylabs’ Web API","spans":[],"direction":"ltr"}],"description":[{"type":"paragraph","text":"Meet the new Web API – let your AI agents search the web and extract fresh data without switching tools. It’s two endpoints: /search finds the right sources, and /scrape turns them into clean, structured output, all with one key and one billing model. ","spans":[{"start":13,"end":20,"type":"hyperlink","data":{"link_type":"Web","url":"https://oxylabs.io/products/web-api","target":"_blank"}},{"start":13,"end":20,"type":"strong"},{"start":125,"end":132,"type":"label","data":{"label":"code"}},{"start":125,"end":132,"type":"strong"},{"start":162,"end":169,"type":"label","data":{"label":"code"}},{"start":162,"end":169,"type":"strong"}],"direction":"ltr"},{"type":"paragraph","text":"Web API also connects to agents through MCP and Agent Skills – so no custom integration is necessary. Try it for free with $5 welcome credit upon registration.","spans":[{"start":40,"end":43,"type":"hyperlink","data":{"link_type":"Web","url":"https://developers.oxylabs.io/ai-workflows/mcp","target":"_blank"}},{"start":48,"end":60,"type":"hyperlink","data":{"link_type":"Web","url":"https://developers.oxylabs.io/ai-workflows/agent-skills","target":"_blank"}}],"direction":"ltr"}],"shortDescription":[{"type":"paragraph","text":"Say hello to Web API – one API to search the web and extract what you need into model-ready data for your AI workflows.","spans":[{"start":13,"end":20,"type":"strong"}],"direction":"ltr"}],"buttonText":"Learn more"},{"buttonLink":"https://developers.oxylabs.io/products/proxies/residential-proxies/protocols#http-3-masque","buttonLinkTarget":"_blank","labels":["Proxies"],"date":"September 29, 2026","title":[{"type":"heading2","text":"MASQUE protocol for Residential Proxies","spans":[],"direction":"ltr"}],"description":[{"type":"paragraph","text":"Residential Proxies now support MASQUE, it enables QUIC and HTTP/3 connections through the proxy. Your requests can use HTTP/3 all the way to the destination without being converted to a traditional TCP-based connection along the way.","spans":[{"start":32,"end":38,"type":"strong"}],"direction":"ltr"}],"shortDescription":[{"type":"paragraph","text":"Connect through Residential Proxies using MASQUE with end-to-end HTTP/3 support with stronger success rates.","spans":[{"start":42,"end":48,"type":"strong"}],"direction":"ltr"}],"buttonText":"Learn more"},{"buttonLink":"https://oxylabs.io/products/scraper-api/fast-search","buttonLinkTarget":"_blank","labels":["Web Scraper API"],"date":"August 27, 2026","title":[{"type":"heading2","text":"News endpoint for Fast Search API","spans":[],"direction":"ltr"}],"description":[{"type":"paragraph","text":"You can now pull up-to-date news results through Fast Search API, returned in a lightweight, structured format that keeps responses in the millisecond range. It gives AI search, RAG pipelines, and research assistants the real-time data they depend on.","spans":[{"start":27,"end":40,"type":"strong"}],"direction":"ltr"}],"shortDescription":[{"type":"paragraph","text":"Get fresh news results in milliseconds – lightweight, structured, and built for real-time AI workflows.","spans":[{"start":10,"end":22,"type":"strong"}],"direction":"ltr"}],"buttonText":"Learn more"},{"buttonLink":"https://oxylabs.io/products/scraper-api/fast-search","buttonLinkTarget":"_blank","labels":["Web Scraper API"],"date":"August 26, 2026","title":[{"type":"heading2","text":"Image search results in Fast Search API","spans":[],"direction":"ltr"}],"description":[{"type":"paragraph","text":"You can now retrieve structured image results in milliseconds through Fast Search API, with native filtering by size, color, aspect ratio, file type, usage license, and time range. Results arrive as integration-ready JSON, so no separate scraping or parsing infrastructure needs  to be maintained.","spans":[{"start":21,"end":45,"type":"strong"}],"direction":"ltr"}],"shortDescription":[{"type":"paragraph","text":"Get structured image results in milliseconds – filter by size, color, file type, license, and more.","spans":[{"start":4,"end":28,"type":"strong"}],"direction":"ltr"}],"buttonText":"Learn more"},{"buttonLink":"https://developers.oxylabs.io/products/web-scraper-api/targets/search-engines/google/scholar","buttonLinkTarget":"_blank","labels":["Web Scraper API"],"date":"August 25, 2026","title":[{"type":"heading2","text":"Structured Google Scholar results","spans":[],"direction":"ltr"}],"description":[{"type":"paragraph","text":"Google Scholar now returns clean, structured JSON, eliminating the need for a Custom Parser on your end. Our infrastructure handles the parsing internally, delivering ready-to-use metadata, including articles, authors, citations, and publications. You get simpler integration and less setup work to retrieve academic data.","spans":[{"start":34,"end":49,"type":"strong"}],"direction":"ltr"}],"shortDescription":[{"type":"paragraph","text":"Google Scholar now returns structured academic data, with no custom parser required.","spans":[{"start":27,"end":51,"type":"strong"}],"direction":"ltr"}],"buttonText":"Learn more"},{"buttonLink":"https://developers.oxylabs.io/products/web-scraper-api/targets/search-engines/google/travel-hotels","buttonLinkTarget":"_blank","labels":["Web Scraper API"],"date":"August 24, 2026","title":[{"type":"heading2","text":"Granular parsed results for Google Travel: Hotels","spans":[],"direction":"ltr"}],"description":[{"type":"paragraph","text":"Now you can get more granular hotel-offer details in your google_travel_hotel results, giving you a fuller picture of each offer in a single request. Whether you're tracking rates or comparing providers, there's less parsing to do on your end. The structured data appears automatically in new requests, so no changes are needed on your side.","spans":[{"start":21,"end":41,"type":"strong"},{"start":58,"end":77,"type":"label","data":{"label":"code"}}],"direction":"ltr"}],"shortDescription":[{"type":"paragraph","text":"Get richer and structured Google Travel: Hotel data – with more granular offers field results.","spans":[{"start":64,"end":79,"type":"strong"}],"direction":"ltr"}],"buttonText":"Learn more"},{"buttonLink":"https://developers.oxylabs.io/products/web-scraper-api/targets/search-engines/google/search","buttonLinkTarget":"_blank","labels":["Web Scraper API"],"date":"August 20, 2026","title":[{"type":"heading2","text":"Enhanced parsing for Google search news","spans":[],"direction":"ltr"}],"description":[{"type":"paragraph","text":"The news component in google_search source now gets you enhanced structured data. Each news result now comes back with a fuller set of fields, so you get cleaner, more complete structured output without extra parsing on your side.","spans":[{"start":22,"end":35,"type":"label","data":{"label":"code"}},{"start":56,"end":80,"type":"strong"}],"direction":"ltr"}],"shortDescription":[{"type":"paragraph","text":"Google Search now returns detailed parsed data – more complete output, less cleanup on your end.","spans":[{"start":26,"end":46,"type":"strong"}],"direction":"ltr"}],"buttonText":"Learn more"},{"buttonLink":"https://developers.oxylabs.io/products/headless-browser","buttonLinkTarget":"_blank","labels":["Headless Browser"],"date":"August 18, 2026","title":[{"type":"heading2","text":"Improved session consistency in Headless Browser","spans":[],"direction":"ltr"}],"description":[{"type":"paragraph","text":"Headless Browser sessions now keep a consistent browser environment from start to finish, so demanding targets are less likely to interrupt a run with extra verification. That means fewer stalls mid-session, lower latency, and higher success rates – without touching your code.","spans":[{"start":37,"end":67,"type":"strong"}],"direction":"ltr"}],"shortDescription":[{"type":"paragraph","text":"Headless Browser sessions are now more consistent with higher success rates \u0026 less interruptions.","spans":[{"start":34,"end":49,"type":"strong"}],"direction":"ltr"}],"buttonText":"Learn more"},{"buttonLink":"https://developers.oxylabs.io/products/web-scraper-api/targets/search-engines/google/search/web-search","buttonLinkTarget":"_blank","labels":["Web Scraper API"],"date":"August 17, 2026","title":[{"type":"heading2","text":"New dedicated parser for Google Books","spans":[],"direction":"ltr"}],"description":[{"type":"paragraph","text":"Google Books data is now available in structured JSON. Submit a Google Books URL through the google_search source and enable parsing. Results come back as ready-to-use JSON, so there's no parser to build or maintain on your end.","spans":[{"start":38,"end":53,"type":"strong"},{"start":93,"end":106,"type":"label","data":{"label":"code"}}],"direction":"ltr"}],"shortDescription":[{"type":"paragraph","text":"Collect clean and structured results from Google Books – no custom parser needed.","spans":[{"start":8,"end":36,"type":"strong"}],"direction":"ltr"}],"buttonText":"Learn more"},{"buttonLink":"https://developers.oxylabs.io/products/web-scraper-api/targets/video-and-social-media/youtube/downloader","buttonLinkTarget":"_blank","labels":["Web Scraper API"],"date":"August 11, 2026","title":[{"type":"heading2","text":"New audio parameter for Video Data API","spans":[],"direction":"ltr"}],"description":[{"type":"paragraph","text":"Video Data API now lets you specify which audio track to retrieve through the audio_language parameter. You can select the creator's original recording or the platform's default track. This gives you direct control over the language you receive. Existing jobs are unaffected unless you set the option.","spans":[{"start":42,"end":53,"type":"strong"},{"start":78,"end":92,"type":"label","data":{"label":"code"}},{"start":133,"end":141,"type":"label","data":{"label":"code"}},{"start":170,"end":177,"type":"label","data":{"label":"code"}}],"direction":"ltr"}],"shortDescription":[{"type":"paragraph","text":"Choose your audio track in Video Data API – control which language you receive.","spans":[{"start":12,"end":23,"type":"strong"}],"direction":"ltr"}],"buttonText":"Learn more"}],"slice_type":"external_data","primary":{"theme":"dark","title":[{"type":"heading2","text":"Always shipping","spans":[],"direction":"ltr"}],"description":[{"type":"paragraph","text":"The latest updates across our products, all in one place.","spans":[{"start":0,"end":57,"type":"label","data":{"label":"lg-paragraph"}}],"direction":"ltr"}],"buttons":[{"leftIconName":null,"text":"See all updates","rightIconName":"ArrowRight","link":{"link_type":"Web","key":"97217e89-3cf0-4e06-93e1-afef4548cf6f","url":"https://oxylabs.io/developers/release-notes","target":"_blank"},"action":null,"variant":"outline"}],"idAttribute":"always-shipping"}},{"variation":"fullFooterWithCta","items":[],"slice_type":"footer_v2","primary":{"theme":"dark","bannerBackgroundImage":{"src":"https://oxylabs.io/oxylabs-web/-i4cA-LNB6cIsMz4_hp-cta.png?auto=format,compress","alt":"","width":2894,"height":732},"isDarkText":true,"bannerTitle":[{"type":"heading2","text":"Give agents the live web","spans":[],"direction":"ltr"}],"bannerDescription":[{"type":"paragraph","text":"One API for search and retrieval – start free, scale when you're ready.","spans":[{"start":0,"end":71,"type":"label","data":{"label":"lg-paragraph"}}],"direction":"ltr"}],"buttons":[{"leftIconName":null,"text":"Start for free","rightIconName":null,"link":{"link_type":"Any"},"action":"Redirect to Overview","variant":"secondary"},{"leftIconName":"GoogleColor","text":"Start with Google","rightIconName":null,"link":{"link_type":"Any"},"action":"Redirect to Overview (Google sign-in)","variant":"default"}],"asciiShaderConfig":{"font":"Instrument Sans","rows":51,"type":"image","gamma":3,"cutout":"off","invert":false,"columns":111,"kerning":0,"palette":["#0d1b2a","#2b6cff","#e0f2fe"],"trigger":"hover","cellSize":12,"