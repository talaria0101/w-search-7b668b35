px] shrink-0 flex-col items-center gap-6 rounded-xl border border-border p-5 dark:bg-[#060606]"><video class="max-h-[160px] flex-1 saturate-0" autoPlay="" playsInline="" muted="" loop=""><source src="https://public-files.oxylabs.io/website/WebAPI/Trust/Globe.mp4"/></video><div class="flex flex-col gap-[6px]"><p class="font-width-normal text-base text-accent-foreground">Most Scalable Provider</p><div class="[&amp;_p]:text-muted-foreground"><p class="font-width-normal text-base text-accent-foreground">Awarded Most Scalable Provider by Proxyway for pairing industry-leading proxy network scale with top-tier success rates, speed, and stability.</p></div></div></div><div class="flex w-[280px] shrink-0 flex-col items-center gap-6 rounded-xl border border-border p-5 dark:bg-[#060606]"><video class="max-h-[160px] flex-1 saturate-0" autoPlay="" playsInline="" muted="" loop=""><source src="https://public-files.oxylabs.io/website/WebAPI/Trust/iso.mp4"/></video><div class="flex flex-col gap-[6px]"><p class="font-width-normal text-base text-accent-foreground">ISO/IEC 27001:2022</p><div class="[&amp;_p]:text-muted-foreground"><p class="font-width-normal text-base text-accent-foreground">The standard for robust risk assessment and information security, covering our Datacenter Proxies, Residential Proxies, and Web API solutions.</p></div></div></div><div class="flex w-[280px] shrink-0 flex-col items-center gap-6 rounded-xl border border-border p-5 dark:bg-[#060606]"><video class="max-h-[160px] flex-1 saturate-0" autoPlay="" playsInline="" muted="" loop=""><source src="https://public-files.oxylabs.io/website/WebAPI/Trust/soc2.mp4"/></video><div class="flex flex-col gap-[6px]"><p class="font-width-normal text-base text-accent-foreground">SOC 2 Type II Certification</p><div class="[&amp;_p]:text-muted-foreground"><p class="font-width-normal text-base text-accent-foreground">This audit report covers controls relevant to Security, Availability, and Confidentiality across Oxylabs&#x27; Scrape endpoint and Web Unblocker solutions.</p></div></div></div><div class="flex w-[280px] shrink-0 flex-col items-center gap-6 rounded-xl border border-border p-5 dark:bg-[#060606]"><video class="max-h-[160px] flex-1 saturate-0" autoPlay="" playsInline="" muted="" loop=""><source src="https://public-files.oxylabs.io/website/WebAPI/Trust/AI.mp4"/></video><div class="flex flex-col gap-[6px]"><p class="font-width-normal text-base text-accent-foreground">EU AI Act Alignment</p><div class="[&amp;_p]:text-muted-foreground"><p class="font-width-normal text-base text-accent-foreground">At Oxylabs, EU AI Act principles are embedded in daily operations through internal policies on AI governance, safe AI usage, and employee AI use.</p></div></div></div><div class="flex w-[280px] shrink-0 flex-col items-center gap-6 rounded-xl border border-border p-5 dark:bg-[#060606]"><video class="max-h-[160px] flex-1 saturate-0" autoPlay="" playsInline="" muted="" loop=""><source src="https://public-files.oxylabs.io/website/WebAPI/Trust/lock.mp4"/></video><div class="flex flex-col gap-[6px]"><p class="font-width-normal text-base text-accent-foreground">Data Protection &amp; Privacy</p><div class="[&amp;_p]:text-muted-foreground"><p class="font-width-normal text-base text-accent-foreground">Data protection, privacy, and security are fundamental to our operations and product design – and we fully support the objectives and legal requirements of the GDPR.</p></div></div></div><div class="flex w-[280px] shrink-0 flex-col items-center gap-6 rounded-xl border border-border p-5 dark:bg-[#060606]"><video class="max-h-[160px] flex-1 saturate-0" autoPlay="" playsInline="" muted="" loop=""><source src="https://public-files.oxylabs.io/website/WebAPI/Trust/Shield.mp4"/></video><div class="flex flex-col gap-[6px]"><p class="font-width-normal text-base text-accent-foreground">Information Security</p><div class="[&amp;_p]:text-muted-foreground"><p class="font-width-normal text-base text-accent-foreground"