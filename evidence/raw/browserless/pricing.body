="opacity:0;transform:translateY(20px)"><h1 class="mb-6 text-4xl font-bold tracking-[-0.02em] text-foreground md:text-5xl">Simple, Transparent Pricing</h1><p class="mb-12 text-lg leading-relaxed text-muted-foreground">Switch plans or cancel anytime.</p><div class="flex justify-center"><fieldset class="grid h-12 grid-cols-2 rounded-lg bg-muted p-1 text-muted-foreground"><legend class="sr-only">Billing cycle</legend><label class="relative cursor-pointer"><input type="radio" class="peer sr-only" name="billing-cycle" checked="" value="yearly"/><span class="inline-flex h-full w-full items-center justify-center whitespace-nowrap rounded-md px-6 py-1 text-lg font-medium ring-offset-background transition-all peer-checked:bg-background peer-checked:text-foreground peer-checked:shadow peer-focus-visible:ring-2 peer-focus-visible:ring-ring peer-focus-visible:ring-offset-2">Pay Yearly<div class="inline-flex items-center rounded-md border px-2.5 py-0.5 text-xs font-semibold transition-colors focus:outline-none focus:ring-2 focus:ring-ring focus:ring-offset-2 border-transparent bg-secondary text-secondary-foreground hover:bg-secondary/80 ml-2">Save 30%</div></span></label><label class="relative cursor-pointer"><input type="radio" class="peer sr-only" name="billing-cycle" value="monthly"/><span class="inline-flex h-full w-full items-center justify-center whitespace-nowrap rounded-md px-6 py-1 text-lg font-medium ring-offset-background transition-all peer-checked:bg-background peer-checked:text-foreground peer-checked:shadow peer-focus-visible:ring-2 peer-focus-visible:ring-ring peer-focus-visible:ring-offset-2">Pay Monthly</span></label></fieldset></div></div></div></section><section class="dark relative overflow-hidden bg-background py-16 text-foreground"><div aria-hidden="true" class="pointer-events-none absolute inset-0 bg-cover bg-center" style="background-image:url(&quot;https://www.browserless.io/brand/motifs/03.webp&quot;)"></div><div class="container relative mx-auto px-4 lg:px-20"><div class="grid gap-8 md:grid-cols-2 lg:grid-cols-4" style="opacity:0"><div style="opacity:0;transform:translateY(20px)"><div class="rounded-xl border text-card-foreground shadow relative flex h-full flex-col border-border/50 bg-card transition-all duration-300 hover:border-primary/30 hover:shadow-xl hover:shadow-primary/5"><div class="absolute -top-3 left-1/2 -translate-x-1/2"><div class="inline-flex items-center rounded-md border text-xs font-semibold transition-colors focus:outline-none focus:ring-2 focus:ring-ring focus:ring-offset-2 border-transparent bg-secondary text-secondary-foreground hover:bg-secondary/80 px-3 py-1 shadow-lg">No card required</div></div><div class="flex flex-col space-y-1.5 p-6 pb-8 pt-8"><div class="tracking-tight text-2xl font-bold">Free</div><div class="text-sm text-muted-foreground mt-6"><div class="flex items-baseline"><span class="text-5xl font-bold tracking-tight text-foreground">$<!-- -->0</span><span class="ml-2 text-muted-foreground">/month</span></div><p class="mt-2 text-sm text-muted-foreground invisible">billed annually</p><div class="mt-3 flex items-center text-sm text-foreground"><span>2<!-- --> <!-- -->max concurrent browsers</span></div></div></div><div class="p-6 pt-0 flex-1 pb-8"><ul class="space-y-3"><li class="flex items-start text-sm"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-check mr-3 mt-0.5 h-4 w-4 shrink-0 text-primary" aria-hidden="true"><path d="M20 6 9 17l-5-5"></path></svg><span class="leading-relaxed">BrowserQL language and editor</span></li><li class="flex items-start text-sm"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-check mr-3 mt-0.5 h-4 w-4 shrink-0 text-primary" aria-hidden="true"><path d="M20 6 9 17l-5-5"></path></svg><span class="leading-relaxed">1k units/month</span></li><li class="flex items-start text-sm"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-check mr-3 mt-0.5 h-4 w-4 shrink-0 text-primary" aria-hidden="true"><path d="M20 6 9 17l-5-5"></path></svg><span class="leading-relaxed">2 max concurrent browsers</span></li><li class="flex items-start text-sm"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-check mr-3 mt-0.5 h-4 w-4 shrink-0 text-primary" aria-hidden="true"><path d="M20 6 9 17l-5-5"></path></svg><span class="leading-relaxed">2 min. max session time</span></li><li class="flex items-start text-sm"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-check mr-3 mt-0.5 h-4 w-4 shrink-0 text-primary" aria-hidden="true"><path d="M20 6 9 17l-5-5"></path></svg><span class="leading-relaxed">Session reconnects</span></li><li class="flex items-start text-sm"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-check mr-3 mt-0.5 h-4 w-4 shrink-0 text-primary" aria-hidden="true"><path d="M20 6 9 17l-5-5"></path></svg><span class="leading-relaxed">1 day persisted sessions and replays storage</span></li><li class="flex items-start text-sm"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-c