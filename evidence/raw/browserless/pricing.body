                    // Page-lifecycle hooks: if user closes/hides the tab
                    // before any other trigger has fired, force-load so
                    // the pageview is sent (Plausible uses keepalive +
                    // sendBeacon so in-flight requests survive unload).
                    window.addEventListener('pagehide', loadPlausible);
                    document.addEventListener('visibilitychange', function() {
                      if (document.visibilityState === 'hidden') loadPlausible();
                    });

                    // Interaction triggers (kept as redundant safety net).
                    ['click', 'scroll', 'keydown', 'touchstart'].forEach(function(evt) {
                      document.addEventListener(evt, loadPlausible, { once: true, passive: true });
