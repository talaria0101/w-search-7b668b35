ng%2Fcustomers%2Ftrust-logos%2Fcvs-health.svg&amp;w=384&amp;q=75"/></div><div class="flex shrink-0 items-center justify-center"><img alt="Microsoft" loading="lazy" width="140" height="40" decoding="async" data-nimg="1" class="h-10 w-auto opacity-60 grayscale transition-all hover:opacity-100 hover:grayscale-0 dark:invert dark:hover:invert" style="color:transparent" srcSet="/.netlify/images?url=%2Fmarketing%2Fcustomers%2Ftrust-logos%2Fmicrosoft.svg&amp;w=256&amp;q=75 1x, /.netlify/images?url=%2Fmarketing%2Fcustomers%2Ftrust-logos%2Fmicrosoft.svg&amp;w=384&amp;q=75 2x" src="/.netlify/images?url=%2Fmarketing%2Fcustomers%2Ftrust-logos%2Fmicrosoft.svg&amp;w=384&amp;q=75"/></div><div class="flex shrink-0 items-center justify-center"><img alt="Heroku" loading="lazy" width="140" height="40" decoding="async" data-nimg="1" class="h-10 w-auto opacity-60 grayscale transition-all hover:opacity-100 hover:grayscale-0 dark:invert dark:hover:invert" style="color:transparent" srcSet="/.netlify/images?url=%2Fmarketing%2Fcustomers%2Ftrust-logos%2Fheroku.svg&amp;w=256&amp;q=75 1x, /.netlify/images?url=%2Fmarketing%2Fcustomers%2Ftrust-logos%2Fheroku.svg&amp;w=384&amp;q=75 2x" src="/.netlify/images?url=%2Fmarketing%2Fcustomers%2Ftrust-logos%2Fheroku.svg&amp;w=384&amp;q=75"/></div><div class="flex shrink-0 items-center justify-center"><img alt="Webflow" loading="lazy" width="140" height="40" decoding="async" data-nimg="1" class="h-10 w-auto opacity-60 grayscale transition-all hover:opacity-100 hover:grayscale-0 dark:invert dark:hover:invert" style="color:transparent" srcSet="/.netlify/images?url=%2Fmarketing%2Fcustomers%2Ftrust-logos%2Fwebflow.svg&amp;w=256&amp;q=75 1x, /.netlify/images?url=%2Fmarketing%2Fcustomers%2Ftrust-logos%2Fwebflow.svg&amp;w=384&amp;q=75 2x" src="/.netlify/images?url=%2Fmarketing%2Fcustomers%2Ftrust-logos%2Fwebflow.svg&amp;w=384&amp;q=75"/></div><div class="flex shrink-0 items-center justify-center"><img alt="WQRank" loading="lazy" width="140" height="40" decoding="async" data-nimg="1" class="h-10 w-auto opacity-60 grayscale transition-all hover:opacity-100 hover:grayscale-0 dark:invert dark:hover:invert" style="color:transparent" srcSet="/.netlify/images?url=%2Fmarketing%2Fcustomers%2Ftrust-logos%2Fwqrank.svg&amp;w=256&amp;q=75 1x, /.netlify/images?url=%2Fmarketing%2Fcustomers%2Ftrust-logos%2Fwqrank.svg&amp;w=384&amp;q=75 2x" src="/.netlify/images?url=%2Fmarketing%2Fcustomers%2Ftrust-logos%2Fwqrank.svg&amp;w=384&amp;q=75"/></div><div class="flex shrink-0 items-center justify-center"><img alt="Samsara" loading="lazy" width="140" height="40" decoding="async" data-nimg="1" class="h-10 w-auto opacity-60 grayscale transition-all hover:opacity-100 hover:grayscale-0 dark:invert dark:hover:invert" style="color:transparent" srcSet="/.netlify/images?url=%2Fmarketing%2Fcustomers%2Ftrust-logos%2Fsamsara.svg&amp;w=256&amp;q=75 1x, /.netlify/images?url=%2Fmarketing%2Fcustomers%2Ftrust-logos%2Fsamsara.svg&amp;w=384&amp;q=75 2x" src="/.netlify/images?url=%2Fmarketing%2Fcustomers%2Ftrust-logos%2Fsamsara.svg&amp;w=384&amp;q=75"/></div><div class="flex shrink-0 items-center justify-center"><img alt="CVS Health" loading="lazy" width="140" height="40" decoding="async" data-nimg="1" class="h-5 w-auto opacity-60 grayscale transition-all hover:opacity-100 hover:grayscale-0 dark:invert dark:hover:invert" style="color:transparent" srcSet="/.netlify/images?url=%2Fmarketing%2Fcustomers%2Ftrust-logos%2Fcvs-health.svg&amp;w=256&amp;q=75 1x, /.netlify/images?url=%2Fmarketing%2Fcustomers%2Ftrust-logos%2Fcvs-health.svg&amp;w=384&amp;q=75 2x" src="/.netlify/images?url=%2Fmarketing%2Fcustomers%2Ftrust-logos%2Fcvs-health.svg&amp;w=384&amp;q=75"/></div></div></div></div></section><section class="py-20 lg:py-28"><div class="container mx-auto px-4 lg:px-20"><div class="mb-16" style="opacity:0;transform:translateY(20px)"><div class="mb-4 inline-flex items-center gap-2 rounded-full border border-primary/20 bg-primary/5 px-4 py-1.5 text-sm font-medium text-primary"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-sparkles lucide-stars h-4 w-4" aria-hidden="true"><path d="M11.017 2.814a1 1 0 0 1 1.966 0l1.051 5.558a2 2 0 0 0 1.594 1.594l5.558 1.051a1 1 0 0 1 0 1.966l-5.558 1.051a2 2 0 0 0-1.594 1.594l-1.051 5.558a1 1 0 0 1-1.966 0l-1.051-5.558a2 2 0 0 0-1.594-1.594l-5.558-1.051a1 1 0 0 1 0-1.966l5.558-1.051a2 2 0 0 0 1.594-1.594z"></path><path d="M20 2v4"></path><path d="M22 4h-4"></path><circle cx="4" cy="20" r="2"></circle></svg>Built for AI agents</div><h2 class="text-balance text-brand-h2 text-foreground md:text-brand-h2-lg">Your agent is only as good as the browser under it.</h2><p class="mt-4 max-w-2xl text-lg leading-relaxed text-muted-foreground">Connect over the protocol you already use, stay logged in across runs, and let Browserless eat the stealth and bot-detection headaches so your code doesn&#x27;t have to.</p></div><div class="grid gap-6 md:grid-cols-3" style="opacity:0"><div style="opacity:0;transform:translateY(20px)"><a class="group flex h-full flex-col overflow-hidden rounded-xl border border-border/60 bg-card p-8 transition duration-300 hover:-translate-y-1 hover:border-primary/40 hover:shadow-xl hover:shadow-primary/5 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring focus-visible:ring-offset-2" href="/feature/mcp-browser-automation"><div class="mb-5 flex h-11 w-11 items-center justify-center rounded-lg bg-primary/10"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-cable h-5 w-5 text-primary" aria-hidden="true"><path d="M17 19a1 1 0 0 1-1-1v-2a2 2 0 0 1 2-2h2a2 2 0 0 1 2 2v2a1 1 0 0 1-1 1z"></path><path d="M17 21v-2"></path><path d="M19 14V6.5a1 1 0 0 0-7 0v11a1 1 0 0 1-7 0V10"></path><path d="M21 21v-2"></path><path d="M3 5V3"></path><path d="M4 10a2 2 0 0 1-2-2V6a1 1 0 0 1 1-1h4a1 1 0 0 1 1 1v2a2 2 0 0 1-2 2z"></path><path d="M7 5V3"></path></svg></div><h3 class="mb-3 text-xl font-semibold tracking-tight text-foreground">MCP tools</h3><p class="mb-6 text-sm leading-relaxed text-muted-foreground">Give your agent search, scrape, and crawl tools over MCP. Plug in Claude, Cursor, or any MCP client and let it pull live web data without getting blocked.</p><div class="mt-auto inline-flex items-center text-sm font-medium text-primary">Explore the MCP server<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-arrow-right ml-1.5 h-4 w-4 transition-transform group-hover:translate-x-0.5" aria-hidden="true"><path d="M5 12h14"></path><path d="m12 5 7 7-7 7"></path></svg></div></a></div><div style="opacity:0;transform:translateY(20px)"><a class="group flex h-full flex-col overflow-hidden rounded-xl border border-border/60 bg-card p-8 transition duration-300 hover:-translate-y-1 hover:border-primary/40 hover:shadow-xl hover:shadow-primary/5 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring focus-visible:ring-offset-2" href="/ai-agent-browser-automation"><div class="mb-5 flex h-11 w-11 items-center justify-center rounded-lg bg-primary/10"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-bot h-5 w-5 text-primary" aria-hidden="true"><path d="M12 8V4H8"></path><rect width="16" height="12" x="4" y="8" rx="2"></rect><path d="M2 14h2"></path><path d="M20 14h2"></path><path d="M15 13v2"></path><path d="M9 13v2"></path></svg></div><h3 class="mb-3 text-xl font-semibold tracking-tight text-foreground">Browser agent</h3><p class="mb-6 text-sm leading-relaxed text-muted-foreground">Run our <span translate="no">Browserless</span> agent instead of building one. It drives a real browser across multi-step tasks and finishes them, fast and stateful, built for production.</p><div class="mt-auto inline-flex items-center text-sm font-medium text-primary">See the browser agent<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-arrow-right ml-1.5 h-4 w-4 transition-transform group-hover:translate-x-0.5" aria-hidden="true"><path d="M5 12h14"></path><path d="m12 5 7 7-7 7"></path></svg></div></a></div><div style="opacity:0;transform:translateY(20px)"><a class="group flex h-full flex-col overflow-hidden rounded-xl border border-border/60 bg-card p-8 transition duration-300 hover:-translate-y-1 hover:border-primary/40 hover:shadow-xl hover:shadow-primary/5 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring focus-visible:ring-offset-2" href="/feature/browser-authentication"><div class="mb-5 flex h-11 w-11 items-center justify-center rounded-lg bg-primary/10"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-key-round h-5 w-5 text-primary" aria-hidden="true"><path d="M2.586 17.414A2 2 0 0 0 2 18.828V21a1 1 0 0 0 1 1h3a1 1 0 0 0 1-1v-1a1 1 0 0 1 1-1h1a1 1 0 0 0 1-1v-1a1 1 0 0 1 1-1h.172a2 2 0 0 0 1.414-.586l.814-.814a6.5 6.5 0 1 0-4-4z"></path><circle cx="16.5" cy="7.5" r=".5" fill="currentColor"></circle></svg></div><h3 class="mb-3 text-xl font-semibold tracking-tight text-foreground">Authenticated Profiles</h3><p class="mb-6 text-sm leading-relaxed text-muted-foreground">Log in once and reuse it across every run. Your agent starts signed in instead of fighting the login wall, with no credentials baked into your code.</p><div class="mt-auto inline-flex items-center text-sm font-medium text-primary">See Authenticated Profiles<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-arrow-right ml-1.5 h-4 w-4 transition-transform group-hover:translate-x-0.5" aria-hidden="true"><path d="M5 12h14"></path><path d="m12 5 7 7-7 7"></path></svg></div></a></div></div></div></section><section class="py-20 lg:py-28"><div class="container mx-auto px-4 lg:px-20"><div class="grid gap-12 lg:grid-cols-2 lg:items-center lg:gap-20"><div class="" style="opacity:0;transform:translateY(20px)"><h2 class="mb-8 text-balance text-brand-h2 text-foreground md:text-brand-h2-lg">Why your AI automation works in the demo and dies in production</h2><p class="text-pretty text-lg leading-relaxed text-muted-foreground">Your model reasons just fine. It&#x27;s the browser underneath that gets blocked, loses the login, and stalls three steps into the task. The intelligence was never the bottleneck. The web was.</p></div><div class="" style="opacity:0;transform:translateY(20px)"><div role="img" aria-label="Sample error log showing common headless Chrome failures: memory leak, Chrome version mismatch, session timeout, and bot detection." class="relative overflow-hidden rounded-xl border border-border/60 bg-slate-950 font-mono text-sm shadow-2xl shadow-primary/5"><div class="flex items-center gap-1.5 border-b border-white/10 bg-white/5 px-4 py-3"><span aria-hidden="true" class="h-2.5 w-2.5 rounded-full bg-red-500/80"></span><span aria-hidden="true" class="h-2.5 w-2.5 rounded-full bg-amber-500/80"></span><span aria-hidden="true" class="h-2.5 w-2.5 rounded-full bg-emerald-500/80"></span><span class="ml-3 text-[11px] uppercase tracking-[0.15em] text-white/40">prod.log</span></div><pre class="whitespace-pre-wrap break-words px-5 py-5 leading-relaxed text-slate-300"><code><span class="text-slate-500">02:14:03 </span><span class="text-rose-400">ERROR</span> <span translate="no">Chrome</span>  <!-- -->process crashed (SIGSEGV)<!-- -->
<span class="text-slate-500">02:14:11 </span><span class="text-amber-400">WARN </span> memory usage 4.2 GB / 4 GB<!-- -->
<span class="text-slate-500">02:14:28 </span><span class="text-rose-400">ERROR</span> session_id=9f3a lost, unable to reconnect<!-- -->
<span class="text-slate-500">02:15:02 </span><span class="text-amber-400">WARN </span> captcha_challenge detected, blocked<!-- -->
<span class="text-slate-500">02:15:44 </span><span class="text-rose-400">ERROR</span> <span translate="no">Chrome</span> 130 → 131: launcher args rejected<!-- -->
<span class="text-slate-500">02:16:09 </span><span class="text-rose-400">ERROR</span> queue overflow (127 sessions pending)<!-- -->
<span class="text-slate-500">02:16:12 </span><span class="text-emerald-400">HINT </span> migrate to<!-- --> <span translate="no">Browserless</span> →<!-- --> <span class="text-periwinkle-500">one-line swap</span></code></pre></div></div></div></div></section><section class="border-y border-border/40 bg-muted/20 py-20 lg:py-28"><div class="container mx-auto px-4 lg:px-20"><div class="mb-12" style="opacity:0;transform:translateY(20px)"><h2 class="text-balance text-brand-h2 text-foreground md:text-brand-h2-lg">Connect your scripts in minutes. Three lines, no rewrite.</h2></div><div class="mx-auto max-w-5xl" style="opacity:0;transform:translateY(20px)"><div class="grid gap-8 lg:grid-cols-[minmax(0,1fr)_320px]"><div class="overflow-hidden rounded-xl border border-border/60 bg-slate-950 font-mono shadow-2xl shadow-primary/10" translate="no"><div dir="ltr" data-orientation="horizontal"><div class="flex items-center border-b border-white/10 bg-white/5"><div class="flex items-center gap-1.5 px-4 py-3"><span aria-hidden="true" class="h-2.5 w-2.5 rounded-full bg-red-500/80"></span><span aria-hidden="true" class="h-2.5 w-2.5 rounded-full bg-amber-500/80"></span><span aria-hidden="true" class="h-2.5 w-2.5 rounded-full bg-emerald-500/80"></span></div><div role="tablist" aria-orientation="horizontal" class="inline-flex items-center text-muted-foreground h-auto w-full flex-1 justify-start gap-0 rounded-none border-0 bg-transparent p-0" tabindex="-1" data-orientation="horizontal" style="outline:none"><button type="button" role="tab" aria-selected="true" aria-controls="radix-_R_6jp6_-content-puppeteer" data-state="active" id="radix-_R_6jp6_-trigger-puppeteer" class="inline-flex items-center justify-center whitespace-nowrap font-medium ring-offset-background focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring focus-visible:ring-offset-2 disabled:pointer-events-none disabled:opacity-50 relative rounded-none border-r border-white/10 bg-transparent px-3 py-3 text-[10px] uppercase tracking-[0.1em] text-white/40 transition-colors hover:text-white/70 data-[state=active]:bg-slate-950 data-[state=active]:text-white data-[state=active]:shadow-none sm:px-5 sm:text-[11px] sm:tracking-[0.15em]" tabindex="-1" data-orientation="horizontal" data-radix-collection-item="">puppeteer.ts</button><button type="button" role="tab" aria-selected="false" aria-controls="radix-_R_6jp6_-content-playwright" data-state="inactive" id="radix-_R_6jp6_-trigger-playwright" class="inline-flex items-center justify-center whitespace-nowrap font-medium ring-offset-background focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring focus-visible:ring-offset-2 disabled:pointer-events-none disabled:opacity-50 relative rounded-none border-r border-white/10 bg-transparent px-3 py-3 text-[10px] uppercase tracking-[0.1em] text-white/40 transition-colors hover:text-white/70 data-[state=active]:bg-slate-950 data-[state=active]:text-white data-[state=active]:shadow-none sm:px-5 sm:text-[11px] sm:tracking-[0.15em]" tabindex="-1" data-orientation="horizontal" data-radix-collection-item="">playwright.ts</button><button type="button" role="tab" aria-selected="false" aria-controls="radix-_R_6jp6_-content-rest" data-state="inactive" id="radix-_R_6jp6_-trigger-rest" class="inline-flex items-center justify-center whitespace-nowrap font-medium ring-offset-background focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring focus-visible:ring-offset-2 disabled:pointer-events-none disabled:opacity-50 relative rounded-none border-r border-white/10 bg-transparent px-3 py-3 text-[10px] uppercase tracking-[0.1em] text-white/40 transition-colors hover:text-white/70 data-[state=active]:bg-slate-950 data-[state=active]:text-white data-[state=active]:shadow-none sm:px-5 sm:text-[11px] sm:tracking-[0.15em]" tabindex="-1" data-orientation="horizontal" data-radix-collection-item="">rest.sh</button></div></div><div data-state="active" data-orientation="horizontal" role="tabpanel" aria-labelledby="radix-_R_6jp6_-trigger-puppeteer" id="radix-_R_6jp6_-content-puppeteer" tabindex="0" class="ring-offset-background focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring focus-visible:ring-offset-2 code-on-dark m-0 px-1 py-1" style="animation-duration:0s"><pre class="language-javascript overflow-x-auto rounded-lg bg-slate-950 p-4 text-sm text-[#f8f8f2] !whitespace-pre-wrap ![overflow-wrap:anywhere] [&amp;_code]:!whitespace-pre-wrap [&amp;_code]:![overflow-wrap:anywhere] "><code class="language-javascript">import puppeteer from &#x27;puppeteer-core&#x27;;

const browser = await puppeteer.connect({
  browserWSEndpoint:
    &#x27;wss://chrome.browserless.io?token=YOUR_API_KEY&#x27;,
});

const page = await browser.newPage();
await page.goto(&#x27;https://example.com&#x27;);

// Your automation code here...

await browser.close();</code></pre></div><div data-state="inactive" data-orientation="horizontal" role="tabpanel" aria-labelledby="radix-_R_6jp6_-trigger-playwright" hidden="" id="radix-_R_6jp6_-content-playwright" tabindex="0" class="ring-offset-background focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring focus-visible:ring-offset-2 code-on-dark m-0 px-1 py-1"></div><div data-state="inactive" data-orientation="horizontal" role="tabpanel" aria-labelledby="radix-_R_6jp6_-trigger-rest" hidden="" id="radix-_R_6jp6_-content-rest" tabindex="0" class="ring-offset-background focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring focus-visible:ring-offset-2 code-on-dark m-0 px-1 py-1"></div></div></div><ol class="space-y-6"><li class="rounded-lg border border-border/60 bg-card/80 p-5" style="opacity:0;transform:translateY(8px)"><div class="mb-2 flex items-center gap-3"><span class="inline-flex h-7 w-7 items-center justify-center rounded-md bg-primary/10 font-mono text-xs font-semibold text-primary tabular-nums">01</span><h3 class="text-sm font-semibold text-foreground">Swap launch() for connect()</h3></div><p class="text-sm leading-relaxed text-muted-foreground">One-line change. Your automation code stays identical.</p></li><li class="rounded-lg border border-border/60 bg-card/80 p-5" style="opacity:0;transform:translateY(8px)"><div class="mb-2 flex items-center gap-3"><span class="inline-flex h-7 w-7 items-center justify-center rounded-md bg-primary/10 font-mono text-xs font-semibold text-primary tabular-nums">02</span><h3 class="text-sm font-semibold text-foreground">Drop in your API key</h3></div><p class="text-sm leading-relaxed text-muted-foreground">Free plan: 1k sessions/month. No credit card required.</p></li><li style="opacity:0;transform:translateY(8px)"><a class="inline-flex items-center justify-center gap-2 whitespace-nowrap text-sm font-medium focus-visible:outline-none focus-visible:ring-1 focus-visible:ring-ring disabled:pointer-events-none disabled:opacity-50 [&amp;_svg]:pointer-events-none [&amp;_svg]:size-4 [&amp;_svg]:shrink-0 bg-primary text-primary-foreground hover:bg-primary/90 h-10 rounded-md px-8 group w-full shadow-lg shadow-primary/20 transition hover:scale-[1.02]" href="/signup/email?plan=free"><span class="flex items-center justify-center">Get your API key<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-arrow-right ml-2 h-4 w-4 transition-transform group-hover:translate-x-0.5" aria-hidden="true"><path d="M5 12h14"></path><path d="m12 5 7 7-7 7"></path></svg></span></a></li></ol></div></div></div></section><section class="border-y border-border/40 bg-muted/20 py-20 lg:py-28"><div class="container relative mx-auto px-4 lg:px-20"><div class="mb-14" style="opacity:0;transform:translateY(20px)"><h2 class="text-balance text-brand-h2 text-foreground md:text-brand-h2-lg">Your browser layer, without the trade-offs.</h2><p class="mt-4 text-lg leading-relaxed text-muted-foreground">Scrape anything. Run anywhere. Deploy on your terms. Three problems that usually force a compromise, solved by default.</p></div><div class="grid gap-6 md:grid-cols-3" style="opacity:0"><div style="opacity:0;transform:translateY(20px)"><div class="rounded-xl border text-card-foreground shadow flex h-full flex-col overflow-hidden border-border/50 bg-card transition duration-300 hover:border-primary/30 hover:shadow-xl hover:shadow-primary/5"><div class="flex flex-1 flex-col p-7"><div class="mb-5 flex items-center justify-between"><div class="flex h-10 w-10 shrink-0 items-center justify-center rounded-lg bg-primary/10"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-bot h-5 w-5 text-primary" aria-hidden="true"><path d="M12 8V4H8"></path><rect width="16" height="12" x="4" y="8" rx="2"></rect><path d="M2 14h2"></path><path d="M20 14h2"></path><path d="M15 13v2"></path><path d="M9 13v2"></path></svg></div><span class="rounded-full bg-primary/10 px-2.5 py-1 text-brand-label uppercase text-primary">Scrape</span></div><h3 class="mb-3 text-lg font-semibold tracking-tight text-foreground">Get past the blockers</h3><p class="mb-5 text-sm leading-relaxed text-muted-foreground">Anti-bot bypass, retries, and <span translate="no">Chrome</span> upgrades. Not your problem anymore.</p><ul class="mb-6 space-y-2.5"><li class="flex items-start gap-2.5 text-sm text-foreground/90"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-circle-check lucide-check-circle-2 mt-0.5 h-4 w-4 shrink-0 text-primary" aria-hidden="true"><circle cx="12" cy="12" r="10"></circle><path d="m16 9-5.5 5.5L8 12"></path></svg><span class="leading-relaxed">Stealth fingerprints that sites don&#x27;t flag.</span></li><li class="flex items-start gap-2.5 text-sm text-foreground/90"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-circle-check lucide-check-circle-2 mt-0.5 h-4 w-4 shrink-0 text-primary" aria-hidden="true"><circle cx="12" cy="12" r="10"></circle><path d="m16 9-5.5 5.5L8 12"></path></svg><span class="leading-relaxed">CAPTCHA solving, built in.</span></li><li class="flex items-start gap-2.5 text-sm text-foreground/90"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-circle-check lucide-check-circle-2 mt-0.5 h-4 w-4 shrink-0 text-primary" aria-hidden="true"><circle cx="12" cy="12" r="10"></circle><path d="m16 9-5.5 5.5L8 12"></path></svg><span class="leading-relaxed">Session persistence cuts proxy spend.</span></li></ul><a class="group mt-auto inline-flex items-center self-start text-sm font-medium text-primary hover:text-primary/80" href="/scraping">See it scrape<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-arrow-right ml-1.5 h-4 w-4 transition-transform group-hover:translate-x-0.5" aria-hidden="true"><path d="M5 12h14"></path><path d="m12 5 7 7-7 7"></path></svg></a></div></div></div><div style="opacity:0;transform:translateY(20px)"><div class="rounded-xl border text-card-foreground shadow flex h-full flex-col overflow-hidden border-border/50 bg-card transition duration-300 hover:border-primary/30 hover:shadow-xl hover:shadow-primary/5"><div class="flex flex-1 flex-col p-7"><div class="mb-5 flex items-center justify-between"><div class="flex h-10 w-10 shrink-0 items-center justify-center rounded-lg bg-primary/10"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-shield-check h-5 w-5 text-primary" aria-hidden="true"><path d="M20 13c0 5-3.5 7.5-7.66 8.95a1 1 0 0 1-.67-.01C7.5 20.5 4 18 4 13V6a1 1 0 0 1 1-1c2 0 4.5-1.2 6.24-2.72a1.17 1.17 0 0 1 1.52 0C14.51 3.81 17 5 19 5a1 1 0 0 1 1 1z"></path><path d="m9 12 2 2 4-4"></path></svg></div><span class="rounded-full bg-primary/10 px-2.5 py-1 text-brand-label uppercase text-primary">Run</span></div><h3 class="mb-3 text-lg font-semibold tracking-tight text-foreground">Production you can actually sleep through</h3><p class="mb-5 text-sm leading-relaxed text-muted-foreground">Eight years in production, 175M+ <span translate="no">Docker</span> pulls, 99.9% uptime. Boring on purpose.</p><ul class="mb-6 space-y-2.5"><li class="flex items-start gap-2.5 text-sm text-foreground/90"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-circle-check lucide-check-circle-2 mt-0.5 h-4 w-4 shrink-0 text-primary" aria-hidden="true"><circle cx="12" cy="12" r="10"></circle><path d="m16 9-5.5 5.5L8 12"></path></svg><span class="leading-relaxed">Auto-scales through traffic spikes.</span></li><li class="flex items-start gap-2.5 text-sm text-foreground/90"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-circle-check lucide-check-circle-2 mt-0.5 h-4 w-4 shrink-0 text-primary" aria-hidden="true"><circle cx="12" cy="12" r="10"></circle><path d="m16 9-5.5 5.5L8 12"></path></svg><span class="leading-relaxed">PDF, screenshot, download APIs built in.</span></li><li class="flex items-start gap-2.5 text-sm text-foreground/90"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-circle-check lucide-check-circle-2 mt-0.5 h-4 w-4 shrink-0 text-primary" aria-hidden="true"><circle cx="12" cy="12" r="10"></circle><path d="m16 9-5.5 5.5L8 12"></path></svg><span class="leading-relaxed">Live debugger. Fix in minutes, not hours.</span></li></ul><a class="group mt-auto inline-flex items-center self-start text-sm font-medium text-primary hover:text-primary/80" href="/feature/browsers-as-a-service">See the architecture<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-arrow-right ml-1.5 h-4 w-4 transition-transform group-hover:translate-x-0.5" aria-hidden="true"><path d="M5 12h14"></path><path d="m12 5 7 7-7 7"></path></svg></a></div></div></div><div style="opacity:0;transform:translateY(20px)"><div class="rounded-xl border text-card-foreground shadow flex h-full flex-col overflow-hidden border-border/50 bg-card transition duration-300 hover:border-primary/30 hover:shadow-xl hover:shadow-primary/5"><div class="flex flex-1 flex-col p-7"><div class="mb-5 flex items-center justify-between"><div class="flex h-10 w-10 shrink-0 items-center justify-center rounded-lg bg-primary/10"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-cloud h-5 w-5 text-primary" aria-hidden="true"><path d="M17.5 19H9a7 7 0 1 1 6.71-9h1.79a4.5 4.5 0 1 1 0 9Z"></path></svg></div><span class="rounded-full bg-primary/10 px-2.5 py-1 text-brand-label uppercase text-primary">Deploy</span></div><h3 class="mb-3 text-lg font-semibold tracking-tight text-foreground">Your infrastructure, your rules</h3><p class="mb-5 text-sm leading-relaxed text-muted-foreground">Cloud, managed cloud, or your own hardware. Same API either way. No lock-in.</p><ul class="mb-6 space-y-2.5"><li class="flex items-start gap-2.5 text-sm text-foreground/90"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-circle-check lucide-check-circle-2 mt-0.5 h-4 w-4 shrink-0 text-primary" aria-hidden="true"><circle cx="12" cy="12" r="10"></circle><path d="m16 9-5.5 5.5L8 12"></path></svg><span class="leading-relaxed">Cloud, managed, or self-hosted.</span></li><li class="flex items-start gap-2.5 text-sm text-foreground/90"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-circle-check lucide-check-circle-2 mt-0.5 h-4 w-4 shrink-0 text-primary" aria-hidden="true"><circle cx="12" cy="12" r="10"></circle><path d="m16 9-5.5 5.5L8 12"></path></svg><span class="leading-relaxed">Same API across every deployment.</span></li><li class="flex items-start gap-2.5 text-sm text-foreground/90"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-circle-check lucide-check-circle-2 mt-0.5 h-4 w-4 shrink-0 text-primary" aria-hidden="true"><circle cx="12" cy="12" r="10"></circle><path d="m16 9-5.5 5.5L8 12"></path></svg><span class="leading-relaxed">Custom configs: GPUs, region, your cloud.</span></li></ul><a class="group mt-auto inline-flex items-center self-start text-sm font-medium text-primary hover:text-primary/80" href="/feature/enterprise-features">Explore enterprise deployment<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-arrow-right ml-1.5 h-4 w-4 transition-transform group-hover:translate-x-0.5" aria-hidden="true"><path d="M5 12h14"></path><path d="m12 5 7 7-7 7"></path></svg></a></div></div></div></div></div></section><section class="py-20 lg:py-28"><div class="container mx-auto px-4 lg:px-20"><div class="mb-16" style="opacity:0;transform:translateY(20px)"><h2 class="text-balance text-brand-h2 text-foreground md:text-brand-h2-lg">We&#x27;ve been running browsers at scale for eight years. Since before AI agents were a thing.</h2></div><div class="grid gap-12 md:grid-cols-2" style="opacity:0"><div class="border-t border-border/60 pt-6" style="opacity:0;transform:translateY(20px)"><div class="mb-3 bg-gradient-to-br from-primary via-primary to-primary/70 bg-clip-text text-4xl font-bold leading-none tracking-[-0.02em] text-transparent tabular-nums md:text-5xl">175M+</div><div class="mb-2 text-lg font-semibold text-foreground">Docker pulls</div><p class="max-w-sm text-sm leading-relaxed text-muted-foreground">One of the most-pulled browser images on Docker Hub.</p></div><div class="border-t border-border/60 pt-6" style="opacity:0;transform:translateY(20px)"><div class="mb-3 bg-gradient-to-br from-primary via-primary to-primary/70 bg-clip-text text-4xl font-bold leading-none tracking-[-0.02em] text-transparent tabular-nums md:text-5xl">99.9%</div><div class="mb-2 text-lg font-semibold text-foreground">uptime, measured</div><p class="max-w-sm text-sm leading-relaxed text-muted-foreground">The kind of reliability your on-call engineer can sleep through.</p></div></div><div class="mt-16 grid grid-cols-3 gap-4 border-t border-border/60 pt-10 sm:gap-6" style="opacity:0"><div style="opacity:0;transform:translateY(20px)"><div class="text-xl font-bold tracking-[-0.02em] text-foreground tabular-nums sm:text-2xl md:text-3xl">8</div><div class="text-xs leading-relaxed text-muted-foreground sm:text-sm">years in production</div></div><div style="opacity:0;transform:translateY(20px)"><div class="text-xl font-bold tracking-[-0.02em] text-foreground tabular-nums sm:text-2xl md:text-3xl">2,000+</div><div class="text-xs leading-relaxed text-muted-foreground sm:text-sm">paying customers</div></div><div style="opacity:0;transform:translateY(20px)"><div class="text-xl font-bold tracking-[-0.02em] text-foreground tabular-nums sm:text-2xl md:text-3xl">13K+</div><div class="text-xs leading-relaxed text-muted-foreground sm:text-sm">GitHub stars</div></div></div></div></section><section class="py-20 lg:py-28"><div class="container mx-auto px-4 lg:px-20"><div class="mb-16" style="opacity:0;transform:translateY(20px)"><h2 class="text-balance text-brand-h2 text-foreground md:text-brand-h2-lg">One API. Four ways people actually use it.</h2></div><div class="grid gap-6 md:grid-cols-2" style="opacity:0"><div style="opacity:0;transform:translateY(20px)"><a class="group flex h-full flex-col overflow-hidden rounded-xl border border-border/60 bg-card p-8 transition duration-300 hover:-translate-y-1 hover:border-primary/40 hover:shadow-xl hover:shadow-primary/5 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring focus-visible:ring-offset-2" href="/scraping"><div class="mb-5 flex items-center justify-between"><div class="flex h-11 w-11 items-center justify-center rounded-lg bg-primary/10"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-bot h-5 w-5 text-primary" aria-hidden="true"><path d="M12 8V4H8"></path><rect width="16" height="12" x="4" y="8" rx="2"></rect><path d="M2 14h2"></path><path d="M20 14h2"></path><path d="M15 13v2"></path><path d="M9 13v2"></path></svg></div><span class="font-mono text-xs tabular-nums text-muted-foreground/70">01</span></div><h3 class="mb-3 text-xl font-semibold tracking-tight text-foreground">Web Scraping</h3><p class="mb-6 text-sm leading-relaxed text-muted-foreground">Scrape anti-bot-heavy sites without building the infrastructure. Session rotation, proxies, retries: handled.</p><div class="mb-6 overflow-hidden rounded-md border border-border/50 bg-slate-950 px-4 py-3 font-mono text-[12px] leading-relaxed text-slate-300" translate="no"><span class="text-slate-500" aria-hidden="true">›<!-- --> </span>POST /unblock { url: &quot;https://…&quot; }</div><div class="mt-auto inline-flex items-center text-sm font-medium text-primary">See the scraping API<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-arrow-right ml-1.5 h-4 w-4 transition-transform group-hover:translate-x-0.5" aria-hidden="true"><path d="M5 12h14"></path><path d="m12 5 7 7-7 7"></path></svg></div></a></div><div style="opacity:0;transform:translateY(20px)"><a class="group flex h-full flex-col overflow-hidden rounded-xl border border-border/60 bg-card p-8 transition duration-300 hover:-translate-y-1 hover:border-primary/40 hover:shadow-xl hover:shadow-primary/5 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring focus-visible:ring-offset-2" href="/automation"><div class="mb-5 flex items-center justify-between"><div class="flex h-11 w-11 items-center justify-center rounded-lg bg-primary/10"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-workflow h-5 w-5 text-primary" aria-hidden="true"><rect width="8" height="8" x="3" y="3" rx="2"></rect><path d="M7 11v4a2 2 0 0 0 2 2h4"></path><rect width="8" height="8" x="13" y="13" rx="2"></rect></svg></div><span class="font-mono text-xs tabular-nums text-muted-foreground/70">02</span></div><h3 class="mb-3 text-xl font-semibold tracking-tight text-foreground">Browser Automation</h3><p class="mb-6 text-sm leading-relaxed text-muted-foreground">Replace the manual clicks in your workflows. Form fills, uptime checks, multi-step flows that keep running.</p><div class="mb-6 overflow-hidden rounded-md border border-border/50 bg-slate-950 px-4 py-3 font-mono text-[12px] leading-relaxed text-slate-300" translate="no"><span class="text-slate-500" aria-hidden="true">›<!-- --> </span>puppeteer.connect({ browserWSEndpoint })</div><div class="mt-auto inline-flex items-center text-sm font-medium text-primary">See automation<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-arrow-right ml-1.5 h-4 w-4 transition-transform group-hover:translate-x-0.5" aria-hidden="true"><path d="M5 12h14"></path><path d="m12 5 7 7-7 7"></path></svg></div></a></div><div style="opacity:0;transform:translateY(20px)"><a class="group flex h-full flex-col overflow-hidden rounded-xl border border-border/60 bg-card p-8 transition duration-300 hover:-translate-y-1 hover:border-primary/40 hover:shadow-xl hover:shadow-primary/5 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring focus-visible:ring-offset-2" href="/lp/ai-agents"><div class="mb-5 flex items-center justify-between"><div class="flex h-11 w-11 items-center justify-center rounded-lg bg-primary/10"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-sparkles lucide-stars h-5 w-5 text-primary" aria-hidden="true"><path d="M11.017 2.814a1 1 0 0 1 1.966 0l1.051 5.558a2 2 0 0 0 1.594 1.594l5.558 1.051a1 1 0 0 1 0 1.966l-5.558 1.051a2 2 0 0 0-1.594 1.594l-1.051 5.558a1 1 0 0 1-1.966 0l-1.051-5.558a2 2 0 0 0-1.594-1.594l-5.558-1.051a1 1 0 0 1 0-1.966l5.558-1.051a2 2 0 0 0 1.594-1.594z"></path><path d="M20 2v4"></path><path d="M22 4h-4"></path><circle cx="4" cy="20" r="2"></circle></svg></div><span class="font-mono text-xs tabular-nums text-muted-foreground/70">03</span></div><h3 class="mb-3 text-xl font-semibold tracking-tight text-foreground">AI Agents</h3><p class="mb-6 text-sm leading-relaxed text-muted-foreground">Your agent needs a browser that won&#x27;t crash. Works with <span translate="no">LangChain</span>, <span translate="no">Claude Computer Use</span>, or any custom framework through standard <span translate="no">Puppeteer</span> and <span translate="no">Playwright</span>.</p><div class="mb-6 overflow-hidden rounded-md border border-border/50 bg-slate-950 px-4 py-3 font-mono text-[12px] leading-relaxed text-slate-300" translate="no"><span class="text-slate-500" aria-hidden="true">›<!-- --> </span>chromium.connectOverCDP(WS_ENDPOINT)</div><div class="mt-auto inline-flex items-center text-sm font-medium text-primary">See AI agent setup<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-arrow-right ml-1.5 h-4 w-4 transition-transform group-hover:translate-x-0.5" aria-hidden="true"><path d="M5 12h14"></path><path d="m12 5 7 7-7 7"></path></svg></div></a></div><div style="opacity:0;transform:translateY(20px)"><a class="group flex h-full flex-col overflow-hidden rounded-xl border border-border/60 bg-card p-8 transition duration-300 hover:-translate-y-1 hover:border-primary/40 hover:shadow-xl hover:shadow-primary/5 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring focus-visible:ring-offset-2" href="/pdf-screenshot-screencast"><div class="mb-5 flex items-center justify-between"><div class="flex h-11 w-11 items-center justify-center rounded-lg bg-primary/10"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-camera h-5 w-5 text-primary" aria-hidden="true"><path d="M13.997 4a2 2 0 0 1 1.76 1.05l.486.9A2 2 0 0 0 18.003 7H20a2 2 0 0 1 2 2v9a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2V9a2 2 0 0 1 2-2h1.997a2 2 0 0 0 1.759-1.048l.489-.904A2 2 0 0 1 10.004 4z"></path><circle cx="12" cy="13" r="3"></circle></svg></div><span class="font-mono text-xs tabular-nums text-muted-foreground/70">04</span></div><h3 class="mb-3 text-xl font-semibold tracking-tight text-foreground">Screenshots &amp; PDFs</h3><p class="mb-6 text-sm leading-relaxed text-muted-foreground">Generate screenshots and PDFs from any URL via API. Dynamic content and custom viewports handled out of the box.</p><div class="mb-6 overflow-hidden rounded-md border border-border/50 bg-slate-950 px-4 py-3 font-mono text-[12px] leading-relaxed text-slate-300" translate="no"><span class="text-slate-500" aria-hidden="true">›<!-- --> </span>POST /screenshot { url, fullPage: true }</div><div class="mt-auto inline-flex items-center text-sm font-medium text-primary">See screenshot &amp; PDF API<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-arrow-right ml-1.5 h-4 w-4 transition-transform group-hover:translate-x-0.5" aria-hidden="true"><path d="M5 12h14"></path><path d="m12 5 7 7-7 7"></path></svg></div></a></div></div></div></section><section class="relative overflow-hidden py-20 lg:py-28"><div class="container mx-auto px-4 lg:px-20"><div class="mx-auto max-w-3xl text-center mb-16" style="opacity:0;transform:translateY(20px)"><h2 class="mb-6 text-balance text-brand-h2 text-foreground md:text-brand-h2-lg">Shipping with Browserless</h2></div><div class="mb-12 grid gap-8 md:grid-cols-2" style="opacity:0"><div style="opacity:0;transform:translateY(20px)"><div class="rounded-xl border text-card-foreground shadow relative h-full overflow-hidden border-border/50 bg-gradient-to-br from-card to-card/80 transition hover:shadow-xl hover:shadow-primary/5"><div class="flex h-full flex-col p-8"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-quote absolute -right-4 -top-4 h-24 w-24 rotate-12 text-primary/5" aria-hidden="true"><path d="M16 3a2 2 0 0 0-2 2v6a2 2 0 0 0 2 2 1 1 0 0 1 1 1v1a2 2 0 0 1-2 2 1 1 0 0 0-1 1v2a1 1 0 0 0 1 1 6 6 0 0 0 6-6V5a2 2 0 0 0-2-2z"></path><path d="M5 3a2 2 0 0 0-2 2v6a2 2 0 0 0 2 2 1 1 0 0 1 1 1v1a2 2 0 0 1-2 2 1 1 0 0 0-1 1v2a1 1 0 0 0 1 1 6 6 0 0 0 6-6V5a2 2 0 0 0-2-2z"></path></svg><blockquote class="relative mb-8 text-lg leading-relaxed text-foreground">“<span translate="no">Browserless</span> helped us focus on the problem we were trying to solve, and less on scaling an automation infrastructure. <span translate="no">Browserless</span>&#x27;s developer focused approach has been a key to us bringing our product to market at the speed we were able to do so.<!-- -->”</blockquote><div class="mt-auto space-y-4"><div class="flex items-center gap-4"><img alt="Atomic" loading="lazy" width="80" height="80" decoding="async" data-nimg="1" class="h-10 w-10 shrink-0 rounded-md object-contain" style="color:transparent" srcSet="/.netlify/images?url=%2Fmarketing%2Fcustomers%2Fatomic.svg&amp;w=96&amp;q=75 1x, /.netlify/images?url=%2Fmarketing%2Fcustomers%2Fatomic.svg&amp;w=256&amp;q=75 2x" src="/.netlify/images?url=%2Fmarketing%2Fcustomers%2Fatomic.svg&amp;w=256&amp;q=75"/><div><p class="font-semibold text-foreground">Scott Weinert</p><p class="text-sm text-muted-foreground">Co-Founder &amp; CTO<!-- -->, <span translate="no">Atomic</span></p></div></div><a class="group inline-flex items-center rounded text-sm font-medium text-primary hover:text-primary/80 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring focus-visible:ring-offset-2" href="/customers/atomic-fi"><span>Read the <span translate="no">Atomic</span> case study</span><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-arrow-right ml-1.5 h-4 w-4 transition-transform group-hover:translate-x-0.5" aria-hidden="true"><path d="M5 12h14"></path><path d="m12 5 7 7-7 7"></path></svg></a></div></div></div></div><div style="opacity:0;transform:translateY(20px)"><div class="rounded-xl border text-card-foreground shadow relative h-full overflow-hidden border-border/50 bg-gradient-to-br from-card to-card/80 transition hover:shadow-xl hover:shadow-primary/5"><div class="flex h-full flex-col p-8"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-quote absolute -right-4 -top-4 h-24 w-24 rotate-12 text-primary/5" aria-hidden="true"><path d="M16 3a2 2 0 0 0-2 2v6a2 2 0 0 0 2 2 1 1 0 0 1 1 1v1a2 2 0 0 1-2 2 1 1 0 0 0-1 1v2a1 1 0 0 0 1 1 6 6 0 0 0 6-6V5a2 2 0 0 0-2-2z"></path><path d="M5 3a2 2 0 0 0-2 2v6a2 2 0 0 0 2 2 1 1 0 0 1 1 1v1a2 2 0 0 1-2 2 1 1 0 0 0-1 1v2a1 1 0 0 0 1 1 6 6 0 0 0 6-6V5a2 2 0 0 0-2-2z"></path></svg><blockquote class="relative mb-8 text-lg leading-relaxed text-foreground">“<!-- -->We were hosting our own <span translate="no">Puppeteer</span>-driven smoke testing service, which required specialized operational attention to maintain and scale. We began looking for third-party hosted solutions so that we could focus our attention on building and supporting our core products, and <span translate="no">Browserless</span> fit the bill.<!-- -->”</blockquote><div class="mt-auto space-y-4"><div class="flex items-center gap-4"><img alt="Samsara" loading="lazy" width="80" height="80" decoding="async" data-nimg="1" class="h-10 w-10 shrink-0 rounded-md object-contain" style="color:transparent" srcSet="/.netlify/images?url=%2Fmarketing%2Fcustomers%2Fsamsara.svg&amp;w=96&amp;q=75 1x, /.netlify/images?url=%2Fmarketing%2Fcustomers%2Fsamsara.svg&amp;w=256&amp;q=75 2x" src="/.netlify/images?url=%2Fmarketing%2Fcustomers%2Fsamsara.svg&amp;w=256&amp;q=75"/><div><p class="font-semibold text-foreground">Christopher Zhen</p><p class="text-sm text-muted-foreground">Software Engineer<!-- -->, <span translate="no">Samsara</span></p></div></div><a class="group inline-flex items-center rounded text-sm font-medium text-primary hover:text-primary/80 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring focus-visible:ring-offset-2" href="/blog/samsara-stress-test-automation"><span>Read the <span translate="no">Samsara</span> case study</span><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-arrow-right ml-1.5 h-4 w-4 transition-transform group-hover:translate-x-0.5" aria-hidden="true"><path d="M5 12h14"></path><path d="m12 5 7 7-7 7"></path></svg></a></div></div></div></div></div><div class="" style="opacity:0;transform:translateY(20px)"><div class="rounded-xl border text-card-foreground relative overflow-hidden border-primary/20 bg-gradient-to-br from-primary/5 via-card to-card shadow-xl shadow-primary/5"><div class="p-8 md:p-12"><div class="flex flex-col items-start gap-6 md:flex-row md:items-center md:justify-between"><div class="max-w-2xl"><div class="mb-4 inline-flex items-center gap-2 rounded-full border border-primary/20 bg-primary/10 px-3 py-1 text-xs font-medium text-primary"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-sparkles lucide-stars h-3.5 w-3.5" aria-hidden="true"><path d="M11.017 2.814a1 1 0 0 1 1.966 0l1.051 5.558a2 2 0 0 0 1.594 1.594l5.558 1.051a1 1 0 0 1 0 1.966l-5.558 1.051a2 2 0 0 0-1.594 1.594l-1.051 5.558a1 1 0 0 1-1.966 0l-1.051-5.558a2 2 0 0 0-1.594-1.594l-5.558-1.051a1 1 0 0 1 0-1.966l5.558-1.051a2 2 0 0 0 1.594-1.594z"></path><path d="M20 2v4"></path><path d="M22 4h-4"></path><circle cx="4" cy="20" r="2"></circle></svg>Case study: Takeoff Copenhagen</div><p class="text-pretty text-lg leading-relaxed text-foreground"><span translate="no">Takeoff</span> cut scrape times from<!-- --> <strong class="font-semibold tabular-nums">25 seconds</strong> <!-- -->down to<!-- --> <strong class="font-semibold tabular-nums">under 5</strong>, hit a<!-- --> <strong class="font-semibold tabular-nums">99.5% success rate</strong>, and reduced their costs by two-thirds. Their first scraper was live inside an hour.</p></div><a class="inline-flex items-center justify-center gap-2 whitespace-nowrap text-sm font-medium focus-visible:outline-none focus-visible:ring-1 focus-visible:ring-ring disabled:pointer-events-none disabled:opacity-50 [&amp;_svg]:pointer-events-none [&amp;_svg]:size-4 [&amp;_svg]:shrink-0 border border-input bg-background shadow-sm hover:bg-accent hover:text-accent-foreground dark:!bg-card dark:hover:!bg-accent h-10 rounded-md px-8 group shrink-0 backdrop-blur-sm transition hover:scale-[1.02]" href="/customers/takeoff"><span>Why <span translate="no">Takeoff</span> switched from<!-- --> <span translate="no">Bright Data</span></span><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-arrow-right ml-2 h-4 w-4 transition-transform group-hover:translate-x-1" aria-hidden="true"><path d="M5 12h14"></path><path d="m12 5 7 7-7 7"></path></svg></a></div></div></div></div></div></section><section class="border-y border-border/40 bg-muted/20 py-20 lg:py-28"><div class="container mx-auto px-4 lg:px-20"><div class="mb-12" style="opacity:0;transform:translateY(20px)"><h2 class="text-balance text-brand-h2 text-foreground md:text-brand-h2-lg">Deploy as code. Debug through a GUI.</h2><p class="mt-3 text-lg text-muted-foreground">See every request. Catch every regression.</p></div><div class="relative" style="opacity:0;transform:translateY(20px)"><div class="absolute -inset-6 rounded-3xl bg-gradient-to-br from-primary/20 via-primary/5 to-transparent opacity-50 blur-3xl"></div><div class="relative overflow-hidden rounded-xl border border-border/60 bg-card shadow-2xl shadow-primary/10"><div class="flex items-center gap-1.5 border-b border-border/60 bg-muted/40 px-4 py-3"><span aria-hidden="true" class="h-2.5 w-2.5 rounded-full bg-red-500/80"></span><span aria-hidden="true" class="h-2.5 w-2.5 rounded-full bg-amber-500/80"></span><span aria-hidden="true" class="h-2.5 w-2.5 rounded-full bg-emerald-500/80"></span><span class="ml-3 font-mono text-[11px] uppercase tracking-[0.15em] text-muted-foreground">browserless.io/account/dashboard</span></div><img alt="Browserless dashboard showing 314,490 successful requests over the last week, with 4 timed out, 8 errored, 0 rejected, 411,982 proxy units, 75,477 captcha units, 446,576 time units, and peak concurrency of 97 of 150. A tooltip on the chart breaks down one day into successful requests and time, proxy, and captcha units." loading="lazy" width="2360" height="1192" decoding="async" data-nimg="1" class="block w-full" style="color:transparent" sizes="(min-width: 1024px) 90vw, 100vw" srcSet="/.netlify/images?url=%2Fmarketing%2Fdashboard%2Frequests.webp&amp;w=640&amp;q=75 640w, /.netlify/images?url=%2Fmarketing%2Fdashboard%2Frequests.webp&amp;w=750&amp;q=75 750w, /.netlify/images?url=%2Fmarketing%2Fdashboard%2Frequests.webp&amp;w=828&amp;q=75 828w, /.netlify/images?url=%2Fmarketing%2Fdashboard%2Frequests.webp&amp;w=1080&amp;q=75 1080w, /.netlify/images?url=%2Fmarketing%2Fdashboard%2Frequests.webp&amp;w=1200&amp;q=75 1200w, /.netlify/images?url=%2Fmarketing%2Fdashboard%2Frequests.webp&amp;w=1920&amp;q=75 1920w, /.netlify/images?url=%2Fmarketing%2Fdashboard%2Frequests.webp&amp;w=2048&amp;q=75 2048w, /.netlify/images?url=%2Fmarketing%2Fdashboard%2Frequests.webp&amp;w=3840&amp;q=75 3840w" src="/.netlify/images?url=%2Fmarketing%2Fdashboard%2Frequests.webp&amp;w=3840&amp;q=75"/></div></div><ul class="mt-12 grid gap-8 md:grid-cols-3" style="opacity:0"><li class="flex items-start gap-4" style="opacity:0;transform:translateY(20px)"><div class="flex h-10 w-10 shrink-0 items-center justify-center rounded-lg bg-primary/10"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-chart-line lucide-line-chart h-5 w-5 text-primary" aria-hidden="true"><path d="M3 3v16a2 2 0 0 0 2 2h16"></path><path d="m19 9-5 5-4-4-3 3"></path></svg></div><div><h3 class="mb-1.5 text-base font-semibold text-foreground">Request Metrics</h3><p class="text-sm leading-relaxed text-muted-foreground">Success, errors, timeouts, queue times, and session durations at a glance.</p></div></li><li class="flex items-start gap-4" style="opacity:0;transform:translateY(20px)"><div class="flex h-10 w-10 shrink-0 items-center justify-center rounded-lg bg-primary/10"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-monitor h-5 w-5 text-primary" aria-hidden="true"><rect width="20" height="14" x="2" y="3" rx="2"></rect><line x1="8" x2="16" y1="21" y2="21"></line><line x1="12" x2="12" y1="17" y2="21"></line></svg></div><div><h3 class="mb-1.5 text-base font-semibold text-foreground">Worker Health</h3><p class="text-sm leading-relaxed text-muted-foreground">CPU and memory usage for dedicated workers.</p></div></li><li class="flex items-start gap-4" style="opacity:0;transform:translateY(20px)"><div class="flex h-10 w-10 shrink-0 items-center justify-center rounded-lg bg-primary/10"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-bug h-5 w-5 text-primary" aria-hidden="true"><path d="M12 20v-9"></path><path d="M14 7a4 4 0 0 1 4 4v3a6 6 0 0 1-12 0v-3a4 4 0 0 1 4-4z"></path><path d="M14.12 3.88 16 2"></path><path d="M21 21a4 4 0 0 0-3.81-4"></path><path d="M21 5a4 4 0 0 1-3.55 3.97"></path><path d="M22 13h-4"></path><path d="M3 21a4 4 0 0 1 3.81-4"></path><path d="M3 5a4 4 0 0 0 3.55 3.97"></path><path d="M6 13H2"></path><path d="m8 2 1.88 1.88"></path><path d="M9 7.13V6a3 3 0 1 1 6 0v1.13"></path></svg></div><div><h3 class="mb-1.5 text-base font-semibold text-foreground">Debugger</h3><p class="text-sm leading-relaxed text-muted-foreground">Watch scripts run in real time. Fix issues without digging through logs.</p></div></li></ul></div></section><section class="border-t border-border/30 py-14 md:py-16"><div class="container mx-auto px-4"><div class="flex flex-col items-center gap-6" style="opacity:0;transform:translateY(20px)"><p class="brand-eyebrow text-center text-brand-label uppercase text-muted-foreground md:text-brand-label-lg">Security &amp; compliance</p><a class="group flex flex-col items-center gap-4 rounded-xl focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring focus-visible:ring-offset-4" aria-label="See Browserless security and compliance details" href="/trust#compliance"><div class="flex flex-wrap items-center justify-center gap-3"><span class="inline-flex items-center gap-2.5 rounded-full border border-border/60 bg-card px-4 py-2.5 shadow-sm transition-all group-hover:border-primary/40 group-hover:shadow-md"><span class="flex h-6 w-6 shrink-0 items-center justify-center rounded-md bg-primary/10"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-shield-check h-3.5 w-3.5 text-primary" aria-hidden="true"><path d="M20 13c0 5-3.5 7.5-7.66 8.95a1 1 0 0 1-.67-.01C7.5 20.5 4 18 4 13V6a1 1 0 0 1 1-1c2 0 4.5-1.2 6.24-2.72a1.17 1.17 0 0 1 1.52 0C14.51 3.81 17 5 19 5a1 1 0 0 1 1 1z"></path><path d="m9 12 2 2 4-4"></path></svg></span><span class="text-sm font-semibold text-foreground">SOC 2</span><span class="text-xs text-muted-foreground">Type II</span></span><span class="inline-flex items-center gap-2.5 rounded-full border border-border/60 bg-card px-4 py-2.5 shadow-sm transition-all group-hover:border-primary/40 group-hover:shadow-md"><span class="flex h-6 w-6 shrink-0 items-center justify-center rounded-md bg-primary/10"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-globe h-3.5 w-3.5 text-primary" aria-hidden="true"><circle cx="12" cy="12" r="10"></circle><path d="M12 2a14.5 14.5 0 0 0 0 20 14.5 14.5 0 0 0 0-20"></path><path d="M2 12h20"></path></svg></span><span class="text-sm font-semibold text-foreground">GDPR</span><span class="text-xs text-muted-foreground">Compliant</span></span><span class="inline-flex items-center gap-2.5 rounded-full border border-border/60 bg-card px-4 py-2.5 shadow-sm transition-all group-hover:border-primary/40 group-hover:shadow-md"><span class="flex h-6 w-6 shrink-0 items-center justify-center rounded-md bg-primary/10"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-heart-pulse h-3.5 w-3.5 text-primary" aria-hidden="true"><path d="M2 9.5a5.5 5.5 0 0 1 9.591-3.676.56.56 0 0 0 .818 0A5.49 5.49 0 0 1 22 9.5c0 2.29-1.5 4-3 5.5l-5.492 5.313a2 2 0 0 1-3 .019L5 15c-1.5-1.5-3-3.2-3-5.5"></path><path d="M3.22 13H9.5l.5-1 2 4.5 2-7 1.5 3.5h5.27"></path></svg></span><span class="text-sm font-semibold text-foreground">HIPAA</span><span class="text-xs text-muted-foreground">BAA Available</span></span><span class="inline-flex items-center gap-2.5 rounded-full border border-border/60 bg-card px-4 py-2.5 shadow-sm transition-all group-hover:border-primary/40 group-hover:shadow-md"><span class="flex h-6 w-6 shrink-0 items-center justify-center rounded-md bg-primary/10"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-file-check h-3.5 w-3.5 text-primary" aria-hidden="true"><path d="M6 22a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h8a2.4 2.4 0 0 1 1.704.706l3.588 3.588A2.4 2.4 0 0 1 20 8v12a2 2 0 0 1-2 2z"></path><path d="M14 2v5a1 1 0 0 0 1 1h5"></path><path d="m9 15 2 2 4-4"></path></svg></span><span class="text-sm font-semibold text-foreground">DPA</span><span class="text-xs text-muted-foreground">Available</span></span></div><span class="inline-flex items-center gap-1 text-xs text-muted-foreground transition-colors group-hover:text-foreground">See the Trust Center<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-arrow-right h-3 w-3 transition-transform group-hover:translate-x-0.5" aria-hidden="true"><path d="M5 12h14"></path><path d="m12 5 7 7-7 7"></path></svg></span></a></div></div></section><section class="py-20 lg:py-28"><div class="container mx-auto px-4 lg:px-20"><div class="mx-auto max-w-3xl text-center mb-12" style="opacity:0;transform:translateY(20px)"><h2 class="mb-6 text-balance text-brand-h2 text-foreground md:text-brand-h2-lg">Common questions</h2></div><div class="mx-auto max-w-3xl" style="opacity:0;transform:translateY(20px)"><div class="w-full space-y-3" data-orientation="vertical"><div data-state="closed" data-orientation="vertical" class="dark:border-secondary overflow-hidden rounded-xl border border-border/60 border-b bg-card transition-colors hover:border-primary/30 data-[state=open]:border-primary/40 data-[state=open]:shadow-sm data-[state=open]:shadow-primary/5"><h3 data-orientation="vertical" data-state="closed" class="flex"><button type="button" aria-expanded="false" data-state="closed" data-orientation="vertical" id="radix-_R_6n96_" class="flex flex-1 items-center justify-between hover:underline [&amp;[data-state=open]&gt;svg]:rotate-180 px-5 py-4 text-left text-base font-semibold text-foreground !no-underline transition-colors hover:text-primary hover:!no-underlin