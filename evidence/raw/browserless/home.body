                link.fetchPriority = 'high';
                link.href = dark ? '/brand/motifs/07.svg' : '/brand/motifs/light/07.svg';
                document.head.appendChild(link);
              })();</script><script type="application/ld+json" data-next-head="">{"@context":"https://schema.org","@type":"FAQPage","mainEntity":[{"@type":"Question","name":"What is Browserless?","acceptedAnswer":{"@type":"Answer","text":"A managed headless browser platform for developers running Puppeteer, Playwright, and headless Chrome. No servers, containers, or Chrome updates to manage. Connect with one line of code."}},{"@type":"Question","name":"How does Browserless work?","acceptedAnswer":{"@type":"Answer","text":"Replace launch() with connect() in your existing scripts and point to a Browserless endpoint. Your code stays the same. We manage the browsers, concurrency, memory, and Chrome versions on our side."}},{"@type":"Question","name":"What's included in the free plan?","acceptedAnswer":{"@type":"Answer","text":"1,000 units per month, 2 concurrent browsers, automatic CAPTCHA solving, residential proxies, and access to Chrome, Firefox, and WebKit. No credit card required."}},{"@type":"Question","name":"Do I need to rewrite my code?","acceptedAnswer":{"@type":"Answer","text":"No. Browserless is compatible with standard Puppeteer and Playwright APIs. If your scripts run locally, they run on Browserless."}},{"@type":"Question","name":"Can I self-host Browserless?","acceptedAnswer":{"@type":"Answer","text":"Yes. Browserless offers cloud, managed cloud, and self-hosted deployment options. Same API everywhere. Enterprise customers can specify cloud providers, regions, GPU configs, and run on their own infrastructure."}},{"@type":"Question","name":"How does pricing work? What's a 'unit'?","acceptedAnswer":{"@type":"Answer","text":"Browserless uses unit-based pricing. A Unit is any time a browser is started with our API and runs for up to 30 seconds, and a new Unit is charged every 30 seconds the session continues. Paid plans include a monthly unit allowance; overages are billed at a per-unit rate. Residential proxies use 6 units per MB. Free plan: 1,000 units per month, no credit card required."}},{"@type":"Question","name":"How is Browserless different from Bright Data, Browserbase, or ScrapingBee?","acceptedAnswer":{"@type":"Answer","text":"Browserless runs standard Puppeteer and Playwright, not a proprietary wrapper, so your existing scripts work unchanged. It's battle-tested at scale: 175M+ Docker pulls, 8 years in production, SOC 2 Type II certified. Unlike Browserbase or Bright Data, Browserless is also available self-hosted on your own infrastructure. Unlike ScrapingBee's API-only model, you get full browser access for complex automations. Bright Data focuses on proxies; Browserless focuses on browsers, with proxies built in."}}]}</script><script type="application/ld+json" data-next-head="">{"@context":"https://schema.org","@type":"SoftwareApplication","name":"Browserless","applicationCategory":"DeveloperApplication","operatingSystem":"Cloud, Linux, macOS, Windows","description":"Browserless runs Puppeteer and Playwright at scale, with built-in stealth, captcha solving, residential proxies, and self-hosted deployment options.","url":"https://www.browserless.io/","offers":{"@type":"AggregateOffer","priceCurrency":"USD","lowPrice":"0","highPrice":"350","offerCount":"4"}}</script><script>window.dataLayer=window.dataLayer||[];function gtag(){dataLayer.push(arguments);}gtag('consent','default',{'ad_storage':'denied','ad_user_data':'denied','ad_personalization':'denied','analytics_storage':'denied','functionality_storage':'denied','personalization_storage':'denied','security_storage':'granted'});</script><script>
                
