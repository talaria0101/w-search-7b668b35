 height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-bot h-[18px] w-[18px] shrink-0 text-primary" aria-hidden="true"><path d="M12 8V4H8"></path><rect width="16" height="12" x="4" y="8" rx="2"></rect><path d="M2 14h2"></path><path d="M20 14h2"></path><path d="M15 13v2"></path><path d="M9 13v2"></path></svg>For AI Agents</a><a class="!text-foreground font-normal flex items-center gap-3 pl-2 py-2" href="/pdf-screenshot-screencast"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-camera h-[18px] w-[18px] shrink-0 text-primary" aria-hidden="true"><path d="M13.997 4a2 2 0 0 1 1.76 1.05l.486.9A2 2 0 0 0 18.003 7H20a2 2 0 0 1 2 2v9a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2V9a2 2 0 0 1 2-2h1.997a2 2 0 0 0 1.759-1.048l.489-.904A2 2 0 0 1 10.004 4z"></path><circle cx="12" cy="13" r="3"></circle></svg>For Screenshots &amp; PDFs</a><a class="!text-foreground font-normal flex items-center gap-3 pl-2 py-2" href="/feature/enterprise-features"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-building-complex lucide-building-2 h-[18px] w-[18px] shrink-0 text-primary" aria-hidden="true"><path d="M10 12h4"></path><path d="M10 8h4"></path><path d="M14 21v-3a2 2 0 0 0-4 0v3"></path><path d="M6 10H4a2 2 0 0 0-2 2v7a2 2 0 0 0 2 2h16a2 2 0 0 0 2-2V9a2 2 0 0 0-2-2h-2"></path><path d="M6 21V5a2 2 0 0 1 2-2h8a2 2 0 0 1 2 2v16"></path></svg>For Enterprise</a></div></div><div class="border-b border-border"><button type="button" class="flex w-full items-center justify-between py-4 !text-foreground font-bold" aria-expanded="false" aria-controls="_R_976_">Resources<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-chevron-down h-5 w-5 transition-transform duration-200" aria-hidden="true"><path d="m6 9 6 6 6-6"></path></svg></button><div id="_R_976_" class="flex-col gap-1 pb-3 hidden"><a class="!text-foreground font-normal flex items-center gap-3 pl-2 py-2" href="/customers"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-users h-[18px] w-[18px] shrink-0 text-primary" aria-hidden="true"><path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"></path><path d="M16 3.128a4 4 0 0 1 0 7.744"></path><path d="M22 21v-2a4 4 0 0 0-3-3.87"></path><circle cx="9" cy="7" r="4"></circle></svg>Customers</a><a class="!text-foreground font-normal flex items-center gap-3 pl-2 py-2" href="/blog"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-newspaper h-[18px] w-[18px] shrink-0 text-primary" aria-hidden="true"><path d="M15 18h-5"></path><path d="M18 14h-8"></path><path d="M4 22h16a2 2 0 0 0 2-2V4a2 2 0 0 0-2-2H8a2 2 0 0 0-2 2v16a2 2 0 0 1-4 0v-9a2 2 0 0 1 2-2h2"></path><rect width="8" height="4" x="10" y="6" rx="1"></rect></svg>Blog</a><a class="!text-foreground font-normal flex items-center gap-3 pl-2 py-2" href="/skills"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-sparkles lucide-stars h-[18px] w-[18px] shrink-0 text-primary" aria-hidden="true"><path d="M11.017 2.814a1 1 0 0 1 1.966 0l1.051 5.558a2 2 0 0 0 1.594 1.594l5.558 1.051a1 1 0 0 1 0 1.966l-5.558 1.051a2 2 0 0 0-1.594 1.594l-1.051 5.558a1 1 0 0 1-1.966 0l-1.051-5.558a2 2 0 0 0-1.594-1.594l-5.558-1.051a1 1 0 0 1 0-1.966l5.558-1.051a2 2 0 0 0 1.594-1.594z"></path><path d="M20 2v4"></path><path d="M22 4h-4"></path><circle cx="4" cy="20" r="2"></circle></svg>Skill Catalog</a><a class="!text-foreground font-normal flex items-center gap-3 pl-2 py-2" href="/trust"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-building-complex lucide-building-2 h-[18px] w-[18px] shrink-0 text-primary" aria-hidden="true"><path d="M10 12h4"></path><path d="M10 8h4"></path><path d="M14 21v-3a2 2 0 0 0-4 0v3"></path><path d="M6 10H4a2 2 0 0 0-2 2v7a2 2 0 0 0 2 2h16a2 2 0 0 0 2-2V9a2 2 0 0 0-2-2h-2"></path><path d="M6 21V5a2 2 0 0 1 2-2h8a2 2 0 0 1 2 2v16"></path></svg>Trust Center</a><a class="!text-foreground font-normal flex items-center gap-3 pl-2 py-2" href="/about"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-info h-[18px] w-[18px] shrink-0 text-primary" aria-hidden="true"><circle cx="12" cy="12" r="10"></circle><path d="M12 16v-4"></path><path d="M12 8h.01"></path></svg>About</a></div></div><a class="!text-foreground py-4 border-b border-border" href="/pricing">Pricing</a><a class="!text-foreground py-4 border-b border-border" href="https://docs.browserless.io/">Docs</a><a class="!text-foreground py-4" href="/account">Log In</a></div><main id="main-content" class="overflow-x-hidden pt-20 bg-background text-foreground"><script id="webmcp-tools" type="text/javascript">(function () {
  if (typeof navigator === "undefined" || !navigator.modelContext ||
      typeof navigator.modelContext.provideContext !== "function") {
    return;
  }
  var tools = [{"name":"browserless_signup","description":"Open the Browserless signup page so the user can create a free account.","inputSchema":{"type":"object","properties":{},"additionalProperties":false},"invoke":"navigate:/signup/email?plan=free"},{"name":"browserless_view_pricing","description":"Open the Browserless pricing page.","inputSchema":{"type":"object","properties":{},"additionalProperties":false},"invoke":"navigate:/pricing"},{"name":"browserless_open_docs","description":"Open the Browserless technical documentation site at docs.browserless.io.","inputSchema":{"type":"object","properties":{"topic":{"type":"string","description":"Optional topic slug (e.g. 'browserql/start', 'baas/quick-start')."}},"additionalProperties":false},"invoke":"open:https://docs.browserless.io/"},{"name":"browserless_contact_sales","description":"Open the Browserless contact page to get in touch with sales or support.","inputSchema":{"type":"object","properties":{},"additionalProperties":false},"invoke":"navigate:/contact"}].map(function (tool) {
    return {
      name: tool.name,
      description: tool.description,
      inputSchema: tool.inputSchema,
      execute: function (input) {
        var parts = tool.invoke.split(":");
        var action = parts.shift();
        var target = parts.join(":");
        if (action === "navigate") {
          window.location.assign(target);
          return { ok: true, url: new URL(target, window.location.origin).toString() };
        }
        if (action === "open") {
          var base = target;
          var isDocs = tool.name === "browserless_open_docs";
          var hasTopic =
            input &&
            typeof input === "object" &&
            typeof input.topic === "string";
          if (isDocs && hasTopic) {
            var safeTopic = input.topic
              .split("/")
              .map(function (segment) {
                return encodeURIComponent(segment);
              })
              .filter(function (segment) {
                return segment.length > 0 && segment !== "." && segment !== "..";
              })
              .join("/");
            if (safeTopic.length > 0) {
              base = base.replace(/\/$/, "") + "/" + safeTopic;
            }
          }
          var popup = window.open(base, "_blank", "noopener,noreferrer");
          if (!popup) {
            return { ok: false, error: "popup_blocked", url: base };
          }
          return { ok: true, url: base };
        }
        return { ok: false };
      },
    };
  });
  try {
    navigator.modelContext.provideContext({ tools: tools });
  } catch (err) {
    // WebMCP is still experimental; ignore registration failures.
  }
})();</script><section class="relative overflow-hidden bg-background text-foreground"><div aria-hidden="true" class="pointer-events-none absolute inset-0 bg-[url(&#x27;/brand/motifs/light/07.svg&#x27;)] bg-cover bg-center dark:bg-[url(&#x27;/brand/motifs/07.svg&#x27;)]"></div><div class="container relative mx-auto px-4 py-12 lg:py-20"><div class="grid gap-10 lg:grid-cols-2 lg:items-center lg:gap-14"><div class="flex flex-col"><h1 class="mb-8 text-balance text-4xl font-semibold leading-[1.05] tracking-[-0.02em] text-foreground sm:text-5xl lg:text-[3.5rem]">The<!-- --> <span class="bg-gradient-to-r from-primary via-primary to-primary/70 bg-clip-text text-transparent">web layer</span> <!-- -->your agents run on</h1><p class="mb-8 max-w-xl text-pretty text-base text-muted-foreground sm:text-lg">Bring your own agent and library, or run ours. Stealth, CAPTCHA, residential proxies, and authenticated profiles that persist and scale to thousands. Your agent gets in, and gets it done.</p><div class="flex flex-col items-start gap-5"><div class="flex w-full flex-col items-stretch gap-3 sm:w-auto sm:flex-row"><a class="inline-flex items-center justify-center gap-2 whitespace-nowrap text-sm font-medium focus-visible:outline-none focus-visible:ring-1 focus-visible:ring-ring disabled:pointer-events-none disabled:opacity-50 [&amp;_svg]:pointer-events-none [&amp;_svg]:size-4 [&amp;_svg]:shrink-0 bg-primary text-primary-foreground hover:bg-primary/90 h-12 rounded-md px-10 group relative overflow-hidden shadow-lg shadow-primary/25 transition hover:scale-[1.02] hover:shadow-xl hover:shadow-primary/30" href="/signup/email?plan=free"><span class="relative z-10 flex items-center justify-center">Get your API key<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-arrow-right ml-2 h-5 w-5 transition-transform group-hover:translate-x-0.5" aria-hidden="true"><path d="M5 12h14"></path><path d="m12 5 7 7-7 7"></path></svg></span></a><a target="_blank" rel="noopener noreferrer" class="inline-flex items-center justify-center gap-2 whitespace-nowrap text-sm font-medium focus-visible:outline-none focus-visible:ring-1 focus-visible:ring-ring disabled:pointer-events-none disabled:opacity-50 [&amp;_svg]:pointer-events-none [&amp;_svg]:size-4 [&amp;_svg]:shrink-0 border border-input bg-background shadow-sm hover:text-accent-foreground dark:!bg-card dark:hover:!bg-accent h-12 rounded-md px-10 backdrop-blur-sm transition hover:scale-[1.02] hover:bg-accent/50" href="https://docs.browserless.io">Read the Docs</a></div><span class="text-xs text-muted-foreground">1k free runs a month. No card, no catch.</span></div></div><div class="w-full"><div class="relative mx-auto flex w-full max-w-md flex-col items-center xl:max-w-none xl:flex-row xl:items-center xl:justify-center" aria-label="Diagram: your AI agent connects through Browserless to a target site and lands signed in." role="img"><div class="w-full max-w-[240px] rounded-xl border border-border/60 bg-card p-4 shadow-xl shadow-primary/5 xl:w-[160px] xl:max-w-none"><div class="mb-3 flex items-center gap-2.5"><span class="flex h-8 w-8 items-center justify-center rounded-md bg-foreground text-background"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-terminal h-4 w-4" aria-hidden="true"><path d="M12 19h8"></path><path d="m4 17 6-6-6-6"></path></svg></span><span class="text-sm font-semibold text-foreground">Your agent</span></div><div class="space-y-2"><div translate="no" class="rounded-md bg-muted px-3 py-1.5 font-mono text-xs text-slate-600 dark:text-muted-foreground">search</div><div translate="no" class="rounded-md bg-muted px-3 py-1.5 font-mono text-xs text-slate-600 dark:text-muted-foreground">scrape</div><div translate="no" class="rounded-md bg-muted px-3 py-1.5 font-mono text-xs text-slate-600 dark:text-muted-foreground">crawl</div></div></div><div aria-hidden="true" class="relative my-1.5 h-7 w-px self-center bg-muted-foreground/60 dark:bg-border xl:hidden"><span class="absolute h-1.5 w-1.5 rounded-full bg-primary" style="left:-2.5px;top:0"></span></div><div aria-hidden="true" class="relative mx-1 hidden h-px w-8 shrink-0 self-center bg-muted-foreground/60 dark:bg-border xl:block"><span class="absolute h-1.5 w-1.5 rounded-full bg-primary" style="top:-2.5px;left:0"></span></div><div class="flex shrink-0 flex-col items-center gap-1 rounded-xl bg-gradient-to-br from-primary to-primary/80 px-6 py-4 text-white shadow-xl shadow-primary/30"><svg viewBox="0 0 1024 1024" class="h-7 w-7" fill="currentColor" aria-hidden="true"><path d="m243.9 0c0.3 0.1 26.4 15 115.1 66.5v411.8c0 391.6 0.1 411.7 1.8 411.2 0.9-0.3 69.7-34 304.1-149l0.1-61.8c0-48.9-0.3-61.6-1.3-61.3-0.6 0.2-43.6 20-95.5 44-51.8 24-94.4 43.5-94.7 43.3-0.2-0.1-0.3-128.3 0-569.6l115.5 68 1.1 256.4 191.4 111.4 0.5 243.6-213.1 104.5c-117.2 57.5-213.9 104.6-214.8 104.8-0.9 0.2-26.5-16.3-112.2-73.3l0.1-296.5c0-163.1 0.3-376.9 0.7-475.2 0.3-98.4 0.9-178.8 1.2-178.8z"></path></svg><span translate="no" class="font-mono text-xs font-semibold tracking-tight">browserless</span></div><div aria-hidden="true" class="relative my-1.5 h-7 w-px self-center bg-muted-foreground/60 dark:bg-border xl:hidden"><span class="absolute h-1.5 w-1.5 rounded-full bg-primary" style="left:-2.5px;top:0"></span></div><div aria-hidden="true" class="relative mx-1 hidden h-px w-8 shrink-0 self-center bg-muted-foreground/60 dark:bg-border xl:block"><span class="absolute h-1.5 w-1.5 rounded-full bg-primary" style="top:-2.5px;left:0"></span></div><div class="relative mx-auto h-[160px] w-[240px] shrink-0"><div aria-hidden="true" class="absolute left-[36px] top-0 z-10 w-[204px] overflow-hidden rounded-xl border border-border/60 bg-card opacity-40 shadow-sm shadow-primary/5"><div class="flex items-center gap-1.5 border-b border-border/60 bg-muted/50 px-3 py-2"><span class="h-2 w-2 rounded-full bg-muted-foreground/30"></span><span class="h-2 w-2 rounded-full bg-muted-foreground/30"></span><span class="h-2 w-2 rounded-full bg-muted-foreground/30"></span></div><div class="h-[97px]"></div></div><div aria-hidden="true" class="absolute left-[18px] top-[18px] z-20 w-[204px] overflow-hidden rounded-xl border border-border/60 bg-card opacity-[0.65] shadow-md shadow-primary/5"><div class="flex items-center gap-1.5 border-b border-border/60 bg-muted/50 px-3 py-2"><span class="h-2 w-2 rounded-full bg-muted-foreground/30"></span><span class="h-2 w-2 rounded-full bg-muted-foreground/30"></span><span class="h-2 w-2 rounded-full bg-muted-foreground/30"></span></div><div class="h-[97px]"></div></div><div translate="no" class="absolute left-0 top-[36px] z-30 w-[204px] overflow-hidden rounded-xl border border-border/60 bg-card shadow-xl shadow-primary/10"><div class="flex items-center gap-1.5 border-b border-border/60 bg-muted/50 px-3 py-2"><span class="h-2 w-2 rounded-full bg-red-400/80"></span><span class="h-2 w-2 rounded-full bg-amber-400/80"></span><span class="h-2 w-2 rounded-full bg-emerald-400/80"></span><span class="ml-2 font-mono text-[11px] text-muted-foreground">target.com</span></div><div class="space-y-2 px-4 py-3.5"><div class="h-5 w-2/3 rounded bg-muted"></div><div class="h-3 w-full rounded bg-muted/70"></div></div><div class="flex items-center gap-2 border-t border-border/60 px-4 py-2.5"><span class="h-2 w-2 animate-pulse rounded-full bg-emerald-500"></span><span class="font-mono text-xs font-medium text-emerald-700 dark:text-emerald-400" style="opacity:0">200 OK</span></div></div></div></div></div></div></div></section><section class="relative border-y border-border/30 bg-gradient-to-b from-muted/30 to-background py-12"><div class="container mx-auto px-4"><p class="mb-8 text-balance text-center text-sm font-medium text-muted-foregr