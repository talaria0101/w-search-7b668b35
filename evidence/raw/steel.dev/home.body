th%3D%222%22%20stroke-linecap%3D%22square%22%20stroke-linejoin%3D%22miter%22%3E%3Cpath%20d%3D%22M3.5%2019V5H20.5V19H3.5Z%22%2F%3E%3Cpath%20d%3D%22M3.5%209C2.9477%209%202.5%209.4477%202.5%2010C2.5%2010.5523%202.9477%2011%203.5%2011Z%22%2F%3E%3Cpath%20d%3D%22M20.5%209C21.0523%209%2021.5%209.4477%2021.5%2010C21.5%2010.5523%2021.0523%2011%2020.5%2011Z%22%2F%3E%3Cpath%20fill%3D%22none%22%20d%3D%22M12%205V3%22%2F%3E%3C%2Fg%3E%3Cg%20fill%3D%22none%22%20stroke%3D%22%23000%22%20stroke-width%3D%222%22%20stroke-linecap%3D%22square%22%20stroke-linejoin%3D%22miter%22%3E%3Ccircle%20cx%3D%228.5%22%20cy%3D%2210%22%20r%3D%221.25%22%20fill%3D%22%23000%22%20stroke%3D%22none%22%2F%3E%3Ccircle%20cx%3D%2215.5%22%20cy%3D%2210%22%20r%3D%221.25%22%20fill%3D%22%23000%22%20stroke%3D%22none%22%2F%3E%3Cpath%20d%3D%22M10%2014.5H14%22%2F%3E%3C%2Fg%3E%3Cg%20fill%3D%22%23fff%22%3E%3C%2Fg%3E%3C%2Fmask%3E%3Crect%20width%3D%2224%22%20height%3D%2224%22%20mask%3D%22url(%23m)%22%2F%3E%3C%2Fsvg%3E&quot;);mask-size:100% 100%;-webkit-mask-size:100% 100%;mask-repeat:no-repeat;-webkit-mask-repeat:no-repeat"></span>Agent-ready commands</div><p class="mt-1.5 line-clamp-2 text-[14px] leading-[1.5] font-description text-[color-mix(in_srgb,currentColor_60%,transparent)]">The same commands, for agents, via the skill.</p></li></ul><div class="flex flex-wrap items-center mt-8 gap-4" style="--arrow-ink:var(--picture-cli-cta, var(--picture-cli-ink))"><div class="inline-flex max-w-full h-10 items-stretch rounded-[var(--radius-button)] border-[0.5px] border-[var(--button-edge)] bg-[var(--button-secondary)] text-[var(--brand-ink)] max-md:w-full shadow-[0_1px_2px_0_color-mix(in_srgb,color-mix(in_oklab,var(--button-secondary)_45%,var(--brand-ink))_12%,transparent),0_0_0_1px_color-mix(in_srgb,color-mix(in_oklab,var(--button-secondary)_45%,var(--brand-ink))_8%,transparent)]" data-hook="cli-field"><code class="flex min-w-0 flex-1 items-center gap-2 overflow-hidden px-3 font-mono text-[13px] leading-4 whitespace-nowrap"><span aria-hidden="true" class="shrink-0 select-none" style="color:color-mix(in srgb, var(--text) 40%, transparent)">$</span><span class="min-w-0 truncate">curl -fsS https://setup.steel.dev | sh</span></code><span aria-hidden="true" class="my-2 w-px shrink-0 self-stretch bg-[var(--hairline)]"></span><button aria-label="Copy the install command" class="relative grid aspect-square h-full shrink-0 place-items-center rounded-r-[var(--radius-button)] transition-colors duration-150 ease-out hover:bg-[color-mix(in_srgb,var(--button-secondary)_88%,var(--brand-ink))]" type="button"><svg aria-hidden="true" class="absolute size-4 transition-[opacity,scale] ease-out duration-(--duration-press) scale-100 opacity-100" fill="none" focusable="false" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg"><path d="M15 9V4.25C15 3.55964 14.4404 3 13.75 3H4.25C3.55964 3 3 3.55964 3 4.25V13.75C3 14.4404 3.55964 15 4.25 15H9M10.25 9H19.75C20.4404 9 21 9.55964 21 10.25V19.75C21 20.4404 20.4404 21 19.75 21H10.25C9.55964 21 9 20.4404 9 19.75V10.25C9 9.55964 9.55964 9 10.25 9Z" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2"></path></svg><svg aria-hidden="true" class="absolute size-4 transition-[opacity,scale] ease-out duration-(--duration-press) scale-[0.95] opacity-0" fill="none" focusable="false" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg"><path d="M5 12.75L10 19L19 5" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2"></path></svg></button><span aria-live="polite" class="sr-only"></span></div></div></div><div aria-hidden="true" data-illustration="" class="relative isolate col-span-full mt-12 overflow-hidden rounded-[var(--radius-button)] md:col-span-4 xl:col-span-6 md:mt-0 h-[467px] md:col-start-5 xl:col-start-7 md:-ms-8 xl:ms-[calc(542px-var(--grid-gap)-100%)]" style="background:var(--picture-cli)"><div class="absolute top-[7%] left-[3%] w-[84%] max-md:left-4 max-md:w-[calc(100%-32px)]" data-hook="cli-terminal"><div class="overflow-hidden rounded-none border-[0.5px] border-[var(--line-subtle)] bg-[var(--terminal-bg)] font-mono text-[12px]" data-window="terminal" style="box-shadow:0px 23px 10px 1px rgb(0 0 0 / 0.014), 0px 13px 8.889px 1px rgb(0 0 0 / 0.028), 0px 6px 6.667px 1px rgb(0 0 0 / 0.055), 0px 1px 3.333px 1px rgb(0 0 0 / 0.055)"><div aria-hidden="true"><div class="flex items-center gap-1.5 bg-[var(--strip-ground,var(--terminal-chrome))] transition-colors duration-(--duration-modal)" style="height:36px;padding-inline:13px"><span class="rounded-full bg-[var(--strip-dot,var(--line))] transition-colors duration-(--duration-modal)" style="width:10px;height:10px"></span><span class="rounded-full bg-[var(--strip-dot,var(--line))] transition-colors duration-(--duration-modal)" style="width:10px;height:10px"></span><span class="rounded-full bg-[var(--strip-dot,var(--line))] transition-colors duration-(--duration-modal)" style="width:10px;height:10px"></span></div></div><pre aria-label="Installing the Steel CLI with npm" class="m-0 px-4 pt-4 font-mono whitespace-pre-wrap text-[var(--text)]" style="font-size:12px;line-height:20px;padding-bottom:64px"><code><div class="flex"><span class="shrink-0 select-none" style="color:color-mix(in srgb, var(--text) 30%, transparent);width:16px">$</span><span class="min-w-0 [overflow-wrap:anywhere]"><span style="color:color-mix(in srgb, var(--text) 100%, transparent)">npm</span><span style="color:color-mix(in srgb, var(--text) 100%, transparent)"> </span><span style="color:color-mix(in srgb, var(--text) 100%, transparent)">install</span><span style="color:color-mix(in srgb, var(--text) 100%, transparent)"> -</span><span style="color:color-mix(in srgb, var(--text) 100%, transparent)">g</span><span style="color:color-mix(in srgb, var(--text) 100%, transparent)"> @</span><span style="color:color-mix(in srgb, var(--text) 100%, transparent)">steel</span><span style="color:color-mix(in srgb, var(--text) 100%, transparent)">-</span><span style="color:color-mix(in srgb, var(--text) 100%, transparent)">dev</span><span style="color:color-mix(in srgb, var(--text) 100%, transparent)">/</span><span style="color:color-mix(in srgb, var(--text) 100%, transparent)">cli</span></span></div><div style="color:color-mix(in srgb, var(--text) 55%, transparent);padding-inline-start:16px">added 1 package in 2s</div><div class="flex"><span class="shrink-0 select-none" style="color:color-mix(in srgb, var(--text) 30%, transparent);width:16px">$</span><span class="min-w-0 [overflow-wrap:anywhere]"><span style="color:color-mix(in srgb, var(--text) 100%, transparent)">steel</span><span style="color:color-mix(in srgb, var(--text) 100%, transparent)"> </span><span style="color:color-mix(in srgb, var(--text) 100%, transparent)">login</span></span></div><div style="color:color-mix(in srgb, var(--text) 55%, transparent);padding-inline-start:16px">Logged in to Steel</div><div class="flex"><span class="shrink-0 select-none" style="color:color-mix(in srgb, var(--text) 30%, transparent);width:16px">$</span><span class="min-w-0 [overflow-wrap:anywhere]"><span style="color:color-mix(in srgb, var(--text) 100%, transparent)">steel</span><span style="color:color-mix(in srgb, var(--text) 100%, transparent)"> </span><span style="color:color-mix(in srgb, var(--text) 100%, transparent)">browser</span><span style="color:color-mix(in srgb, var(--text) 100%, transparent)"> </span><span style="color:color-mix(in srgb, var(--text) 100%, transparent)">start</span></span></div><div style="color:color-mix(in srgb, var(--text) 55%, transparent);padding-inline-start:16px">Session started</div></code></pre></div></div><div class="absolute right-[3%] bottom-[7%] w-[84%] max-md:right-4 max-md:w-[calc(100%-32px)]" data-hook="cli-terminal"><div class="overflow-hidden rounded-none border-[0.5px] border-[var(--line-subtle)] bg-[var(--terminal-bg)] font-mono text-[12px]" data-window="terminal" style="box-shadow:0px 23px 10px 1px rgb(0 0 0 / 0.014), 0px 13px 8.889px 1px rgb(0 0 0 / 0.028), 0px 6px 6.667px 1px rgb(0 0 0 / 0.055), 0px 1px 3.333px 1px rgb(0 0 0 / 0.055)"><div aria-hidden="true"><div class="flex items-center gap-1.5 bg-[var(--strip-ground,var(--terminal-chrome))] transition-colors duration-(--duration-modal)" style="height:36px;padding-inline:13px"><span class="rounded-full bg-[var(--strip-dot,var(--line))] transition-colors duration-(--duration-modal)" style="width:10px;height:10px"></span><span class="rounded-full bg-[var(--strip-dot,var(--line))] transition-colors duration-(--duration-modal)" style="width:10px;height:10px"></span><span class="rounded-full bg-[var(--strip-dot,var(--line))] transition-colors duration-(--duration-modal)" style="width:10px;height:10px"></span></div></div><pre aria-label="Installing the Steel CLI with its install script" class="m-0 px-4 pt-4 font-mono whitespace-pre-wrap text-[var(--text)]" style="font-size:12px;line-height:20px;padding-bottom:64px"><code><div class="flex"><span class="shrink-0 select-none" style="color:color-mix(in srgb, var(--text) 30%, transparent);width:16px">$</span><span class="min-w-0 [overflow-wrap:anywhere]"><span style="color:color-mix(in srgb, var(--text) 100%, transparent)">curl</span><span style="color:color-mix(in srgb, var(--text) 100%, transparent)"> -</span><span style="color:color-mix(in srgb, var(--text) 100%, transparent)">fsS</span><span style="color:color-mix(in srgb, var(--text) 100%, transparent)"> </span><span style="color:color-mix(in srgb, var(--text) 100%, transparent)">https</span><span style="color:color-mix(in srgb, var(--text) 100%, transparent)">://</span><span style="color:color-mix(in srgb, var(--text) 100%, transparent)">setup</span><span style="color:color-mix(in srgb, var(--text) 100%, transparent)">.</span><span style="color:color-mix(in srgb, var(--text) 100%, transparent)">steel</span><span style="color:color-mix(in srgb, var(--text) 100%, transparent)">.</span><span style="color:color-mix(in srgb, var(--text) 100%, transparent)">dev</span><span style="color:color-mix(in srgb, var(--text) 100%, transparent)"> | </span><span style="color:color-mix(in srgb, var(--text) 100%, transparent)">sh</span></span></div><div style="color:color-mix(in srgb, var(--text) 55%, transparent);padding-inline-start:16px">Installed the Steel CLI</div><div class="flex"><span class="shrink-0 select-none" style="color:color-mix(in srgb, var(--text) 30%, transparent);width:16px">$</span><span class="min-w-0 [overflow-wrap:anywhere]"><span style="color:color-mix(in srgb, var(--text) 100%, transparent)">steel</span><span style="color:color-mix(in srgb, var(--text) 100%, transparent)"> </span><span style="color:color-mix(in srgb, var(--text) 100%, transparent)">browser</span><span style="color:color-mix(in srgb, var(--text) 100%, transparent)"> </span><span style="color:color-mix(in srgb, var(--text) 100%, transparent)">navigate</span><span style="color:color-mix(in srgb, var(--text) 100%, transparent)"> </span><span style="color:color-mix(in srgb, var(--text) 100%, transparent)">https</span><span style="color:color-mix(in srgb, var(--text) 100%, transparent)">://</span><span style="color:color-mix(in srgb, var(--text) 100%, transparent)">news</span><span style="color:color-mix(in srgb, var(--text) 100%, transparent)">.</span><span style="color:color-mix(in srgb, var(--text) 100%, transparent)">ycombinator</span><span style="color:color-mix(in srgb, var(--text) 100%, transparent)">.</span><span style="color:color-mix(in srgb, var(--text) 100%, transparent)">com</span></span></div><div class="flex"><span class="shrink-0 select-none" style="color:color-mix(in srgb, var(--text) 30%, transparent);width:16px">$</span><span class="min-w-0 [overflow-wrap:anywhere]"><span style="color:color-mix(in srgb, var(--text) 100%, transparent)">steel</span><span style="color:color-mix(in srgb, var(--text) 100%, transparent)"> </span><span style="color:color-mix(in srgb, var(--text) 100%, transparent)">browser</span><span style="color:color-mix(in srgb, var(--text) 100%, transparent)"> </span><span style="color:color-mix(in srgb, var(--text) 100%, transparent)">live</span></span></div><div style="color:color-mix(in srgb, var(--text) 55%, transparent);padding-inline-start:16px">Live view open in your browser</div></code></pre></div></div><div aria-hidden="true" class="pointer-events-none absolute inset-0 z-30" data-grain="" style="background-image:url(&quot;data:image/svg+xml,%3Csvg%20xmlns%3D&#x27;http%3A%2F%2Fwww.w3.org%2F2000%2Fsvg&#x27;%20width%3D&#x27;180&#x27;%20height%3D&#x27;180&#x27;%3E%3Cfilter%20id%3D&#x27;g&#x27;%3E%3CfeTurbulence%20type%3D&#x27;fractalNoise&#x27;%20baseFrequency%3D&#x27;1.26&#x27;%20numOctaves%3D&#x27;3&#x27;%20stitchTiles%3D&#x27;stitch&#x27;%2F%3E%3CfeColorMatrix%20type%3D&#x27;saturate&#x27;%20values%3D&#x27;0&#x27;%2F%3E%3C%2Ffilter%3E%3Crect%20width%3D&#x27;100%25&#x27;%20height%3D&#x27;100%25&#x27;%20filter%3D&#x27;url(%23g)&#x27;%20opacity%3D&#x27;0.09&#x27;%2F%3E%3C%2Fsvg%3E&quot;);background-repeat:repeat"></div></div></div></div></section><section class="bg-[var(--surface)] py-[100px] max-md:mt-16 max-md:py-16" data-hook="sdks-agents"><div class="layout-grid items-start max-md:gap-y-10"><div class="col-span-full flex flex-col items-start md:col-span-4 xl:col-span-6 md:pe-10 xl:pe-[calc(100%-510px)]"><h2 class="text-[40px] leading-[1.05] text-balance text-[var(--text)] max-md:text-[32px]">Build with SDKs for your stack and the agents you already use</h2><p class="mt-5 max-w-[30em] text-[16px] leading-[1.6] text-[var(--text-muted)]">Use Steel&#x27;s Python and Node.js SDKs or its REST API in the stack you have. Coding agents set Steel up for you and browse the web through it.</p><div class="mt-8"><a rel="noopener noreferrer" target="_blank" class="nav-login inline-flex items-center gap-[0.4em] font-mono text-[12px] leading-4 font-[440] text-[var(--arrow-ink,var(--text))] uppercase" data-arrow-link="" href="https://docs.steel.dev"><span class="nav-underline">Rea