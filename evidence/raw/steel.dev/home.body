-[20px]\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"text-[16px] leading-[24px] font-description\",\"data-face\":\"text\",\"children\":\"Developers\"}],[\"$\",\"ul\",null,{\"className\":\"mt-4 flex flex-col gap-3\",\"children\":[[\"$\",\"li\",\"Documentation\",{\"children\":[\"$\",\"$L45\",null,{\"href\":\"https://docs.steel.dev\",\"target\":\"_blank\",\"rel\":\"noopener noreferrer\",\"className\":\"text-[16px] leading-[24px] font-description opacity-80 transition-opacity duration-150 ease-out hover:opacity-100\",\"children\":\"Documentation\"}]}],[\"$\",\"li\",\"SDKs\",{\"children\":[\"$\",\"$L45\",null,{\"href\":\"https://docs.steel.dev/overview/sessions-api/quickstart\",\"target\":\"_blank\",\"rel\":\"noopener noreferrer\",\"className\":\"text-[16px] leading-[24px] font-description opacity-80 transition-opacity duration-150 ease-out hover:opacity-100\",\"children\":\"SDKs\"}]}],[\"$\",\"li\",\"Steel Skills\",{\"children\":[\"$\",\"$L45\",null,{\"href\":\"https://docs.steel.dev/overview/skills\",\"target\":\"_blank\",\"rel\":\"noopener noreferrer\",\"className\":\"text-[16px] leading-[24px] font-description opacity-80 transition-opacity duration-150 ease-out hover:opacity-100\",\"children\":\"Steel Skills\"}]}],[\"$\",\"li\",\"REST API\",{\"children\":[\"$\",\"$L45\",null,{\"href\":\"https://docs.steel.dev/api-reference\",\"target\":\"_blank\",\"rel\":\"noopener noreferrer\",\"className\":\"text-[16px] leading-[24px] font-description opacity-80 transition-opacity duration-150 ease-out hover:opacity-100\",\"children\":\"REST API\"}]}],[\"$\",\"li\",\"Self-hosting\",{\"children\":[\"$\",\"$L45\",null,{\"href\":\"https://docs.steel.dev/overview/self-hosting/docker\",\"target\":\"_blank\",\"rel\":\"noopener noreferrer\",\"className\":\"text-[16px] leading-[24px] font-description opacity-80 transition-opacity duration-150 ease-out hover:opacity-100\",\"children\":\"Self-hosting\"}]}],\"$L47\"]}]]}],\"$L48\",\"$L49\"]}],\"$L4a\"]}],null,\"$L4b\"]}]]}]\n4c:T910,{\"@context\":\"https://schema.org\",\"@graph\":[{\"@type\":\"FAQPage\",\"mainEntity\":[{\"@type\":\"Question\",\"name\":\"What is Steel and what does it do?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"Steel is cloud browser infrastructure for AI agents. It gives agents isolated cloud browser sessions with built-in anti-bot stealth, CAPTCHA solving and session persistence.\"}},{\"@type\":\"Question\",\"name\":\"Is Steel open source?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"Yes. Steel Browser is the open-source server on GitHub that you can host yourself. Steel Cloud is the managed version, adding scale, stealth, proxies and CAPTCHA solving.\"}},{\"@type\":\"Question\",\"name\":\"Can I use Steel with Playwright, Puppeteer or Selenium?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"Yes. Steel works with Playwright, Puppeteer, Selenium and its own Node and Python SDKs. You connect over a standard CDP WebSocket URL, so any CDP-compatible tool works out of the box.\"}},{\"@type\":\"Question\",\"name\":\"How fast does Steel start a browser session?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"Under a second on average, with no cold-start penalty. Each session launches into its own isolated Chromium in the cloud, with its proxy, cookies and storage already set up.\"}},{\"@type\":\"Question\",\"name\":\"Can Steel bypass CAPTCHAs?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"Yes, on Steel Cloud. With CAPTCHA solving on, a session detects and solves CAPTCHAs as your agent browses, including Cloudflare Turnstile, PerimeterX press-and-hold and image CAPTCHAs, and the CAPTCHAs API reports each one's progress. Stealth and proxies keep many from appearing at all.\"}},{\"@type\":\"Question\",\"name\":\"Does Steel support human-in-the-loop workflows and reusing logins?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"Yes. A live session viewer lets people watch or take over running sessions. Persistent browser profiles keep cookies and session tokens, so agents pick up signed-in workflows without logging in again.\"}},{\"@type\":\"Question\",\"name\":\"How much does Steel cost, and is there a free tier?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"Launch includes $30 free credits, no monthly fee, and usage-based pricing after your one-time credits run out. Scale is $250 per month plus usage, and Enterprise pricing is custom. Steel Browser is free and open source.\"}}]}]}30:[\"$\",\"script\",null,{\"type\":\"application/ld+json\",\"dangerouslySetInnerHTML\":{\"__html\":\"$4c\"}}]\n59:I[57668,[\"/_next/static/immutable/chunks/3jbmnjw52m8et.js\",\"/_next/static/immutable/chunks/2i3199fuqs76b.js\",\"/_next/static/immutable/chunks/28346eo8wd077.js\",\"/_next/static/immutable/chunks/38liju9rh5xcx.js\",\"/_next/static/immutable/chunks/35h7rce85deob.js\",\"/_next/static/immutable/chunks/0xwf7zwi0ctrq.js\",\"/_next/static/immutable/chunks/29gtcan9x970k.js\",\"/_next/static/immutable/chunks/23d4dh4lbxp66.js\",\"/_next/static/immutable/chunks/25lfe4es0xr6j.js\",\"/_next/static/immutable/chunks/2ezxfjwb5hizb.js\",\"/_next/static/immutable/chunks/126603b-yuot_.js\",\"/_next/static/immutable/chunks/2hdsgzrxw_xrq.js\"],\"CookieSettings\"]\n5a:I[2241,[\"/_next/static/immutable/chunks/3jbmnjw52m8et.js\",\"/_next/static/immutable/chunks/2i3199fuqs76b.js\",\"/_next/static/immutable/chunks/28346eo8wd077.js\",\"/_next/static/immutable/chunks/38liju9rh5xcx.js\",\"/_next/static/immutable/chunks/35h7rce85deob.js\",\"/_next/static/immutable/chunks/0xwf7zwi0ctrq.js\",\"/_next/static/immutable/chunks/29gtcan9x970k.js\",\"/_next/static/immutable/chunks/23d4dh4lbxp66.js\",\"/_next/static/immutable/chunks/25lfe4es0xr6j.js\",\"/_next/static/immutable/chunks/2ezxfjwb5hizb.js\",\"/_next/static/immutable/chunks/126603b-yuot_.js\",\"/_next/static/immutable/chunks/2hdsgzrxw_xrq.js\"],\"ColorModeToggle\"]\n5b:I[31222,[\"/_next/static/immutable/chunks/3jbmnjw52m8et.js\",\"/_next/static/immutable/chunks/2i3199fuqs76b.js\",