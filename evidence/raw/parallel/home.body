",\"accuracyPct\":94,\"costCpm\":2,\"accuracyDisplay\":94,\"costDisplay\":2,\"isParallel\":true},{\"id\":\"simpleqa-verified-parallel-turbo\",\"label\":\"Parallel Turbo\",\"accuracyPct\":91,\"costCpm\":2,\"accuracyDisplay\":91,\"costDisplay\":2,\"isParallel\":true},{\"id\":\"simpleqa-verified-parallel-advanced\",\"label\":\"Parallel Advanced\",\"accuracyPct\":97,\"costCpm\":28.3,\"accuracyDisplay\":97,\"costDisplay\":28.3,\"isParallel\":true},{\"id\":\"simpleqa-verified-parallel-basic\",\"label\":\"Parallel Basic\",\"accuracyPct\":97,\"costCpm\":45,\"accuracyDisplay\":97,\"costDisplay\":45,\"isParallel\":true},{\"id\":\"simpleqa-verified-exa-auto-low-cost\",\"label\":\"Exa Auto (low-cost)\",\"accuracyPct\":91,\"costCpm\":7.9,\"accuracyDisplay\":91,\"costDisplay\":7.9,\"isParallel\":false},{\"id\":\"simpleqa-verified-tavily-low-cost\",\"label\":\"Tavily (low-cost)\",\"accuracyPct\":94,\"costCpm\":17.4,\"accuracyDisplay\":94,\"costDisplay\":17.4,\"isParallel\":false},{\"id\":\"simpleqa-verified-exa-auto-frontier\",\"label\":\"Exa Auto (frontier)\",\"accuracyPct\":91,\"costCpm\":35.7,\"accuracyDisplay\":91,\"costDisplay\":35.7,\"isParallel\":false},{\"id\":\"simpleqa-verified-tavily-frontier\",\"label\":\"Tavily (frontier)\",\"accuracyPct\":92,\"costCpm\":61.3,\"accuracyDisplay\":92,\"costDisplay\":61.3,\"isParallel\":false}],\"ariaLabel\":\"Accuracy versus cost, SimpleQA Verified. Parallel Fast 94% at 2 CPM, Parallel Turbo 91% at 2 CPM, Parallel Advanced 97% at 28.3 CPM, Parallel Basic 97% at 45 CPM, Exa Auto (low-cost) 91% at 7.9 CPM, Tavily (low-cost) 94% at 17.4 CPM, Exa Auto (frontier) 91% at 35.7 CPM, Tavily (frontier) 92% at 61.3 CPM.\",\"legend\":\"CPM: USD per 1000 requests, log scale. Frontier tier uses a GPT-5.6 Sol agent; low-cost tier uses a GPT-5.6 Luna agent.\",\"description\":[{\"_key\":\"blk1\",\"_type\":\"block\",\"children\":[{\"_key\":\"sp1\",\"_type\":\"span\",\"marks\":[\"strong\"],\"text\":\"Dataset\"}],\"markDefs\":[],\"style\":\"normal\"},{\"_key\":\"blk2\",\"_type\":\"block\",\"children\":[{\"_key\":\"sp2\",\"_type\":\"span\",\"marks\":[\"lnk1\"],\"text\":\"SimpleQA Verified\"},{\"_key\":\"sp2b\",\"_type\":\"span\",\"marks\":[],\"text\":\", created by Google DeepMind, is a 1,000-question refinement of OpenAI's SimpleQA with corrected labels and balanced topics, covering short, fact-seeking questions. Results are reported on a sample of 100 questions.\"}],\"markDefs\":[{\"_key\":\"lnk1\",\"_type\":\"link\",\"href\":\"https://www.kaggle.com/benchmarks/deepmind/simpleqa-verified\"}],\"style\":\"normal\"},{\"_key\":\"blk3\",\"_type\":\"block\",\"children\":[{\"_key\":\"sp3\",\"_type\":\"span\",\"marks\":[],\"text\":\"\"}],\"markDefs\":[],\"style\":\"normal\"},{\"_key\":\"blk4\",\"_type\":\"block\",\"children\":[{\"_key\":\"sp4\",\"_type\":\"span\",\"marks\":[\"strong\"],\"text\":\"Evaluation methodology\"}],\"markDefs\":[],\"style\":\"normal\"},{\"_key\":\"blk5\",\"_type\":\"block\",\"children\":[{\"_key\":\"sp5\",\"_type\":\"span\",\"marks\":[],\"text\":\"Multi-step agentic evaluation at two price tiers. In the frontier tier a GPT-5.6 Sol agent (reasoning: high) is paired with Parallel Basic and Parallel Advanced; in the low-cost tier a GPT-5.6 Luna agent (reasoning: low) is paired with Parallel Fast and Parallel Turbo. Exa and Tavily are run at both tiers with the same agent. The agent calls each provider's search tool and extract tool. Answers are graded by an LLM judge.\"}],\"markDefs\":[],\"style\":\"normal\"},{\"_key\":\"blk6\",\"_type\":\"block\",\"children\":[{\"_key\":\"sp6\",\"_type\":\"span\",\"marks\":[],\"text\":\"Cost includes LLM token costs and tool call costs, averaged per question and shown on a log scale.\"}],\"markDefs\":[],\"style\":\"normal\"},{\"_key\":\"blk7\",\"_type\":\"block\",\"children\":[{\"_key\":\"sp7\",\"_type\":\"span\",\"marks\":[],\"text\":\"\"}],\"markDefs\":[],\"style\":\"normal\"},{\"_key\":\"blk8\",\"_type\":\"block\",\"children\":[{\"_key\":\"sp8\",\"_type\":\"span\",\"marks\":[\"strong\"],\"text\":\"Testing dates\"}],\"markDefs\":[],\"style\":\"normal\"},{\"_key\":\"blk9\",\"_type\":\"block\",\"children\":[{\"_key\":\"sp9\",\"_type\":\"span\",\"marks\":[],\"text\":\"Evals were run on September 9, 2026.\"}],\"markDefs\":[],\"style\":\"normal\"}],\"xAxis\":{\"formatType\":\"none\",\"label\":\"Cost\",\"reverseScale\":false,\"rightMargin\":100,\"scaleType\":\"log\",\"showTicks\":false,\"unit\":\"CPM\"},\"yAxis\":{\"_type\":\"axis\",\"formatType\":\"none\",\"label\":\"Accuracy\",\"reverseScale\":false,\"scaleType\":\"linear\",\"showTicks\":false,\"unit\":\"%\"}},{\"id\":\"browsecomp\",\"label\":\"BrowseComp\",\"points\":[{\"id\":\"browsecomp-parallel-fast\",\"label\":\"Parallel Fast\",\"accuracyPct\":44,\"costCpm\":11.8,\"accuracyDisplay\":44,\"costDisplay\":11.8,\"isParallel\":true},{\"id\":\"browsecomp-parallel-turbo\",\"label\":\"Parallel Turbo\",\"accuracyPct\":32,\"costCpm\":13.2,\"accuracyDisplay\":32,\"costDisplay\":13.2,\"isParallel\":true},{\"id\":\"browsecomp-parallel-advanced\",\"label\":\"Parallel Advanced\",\"accuracyPct\":74,\"costCpm\":399,\"accuracyDisplay\":74,\"costDisplay\":399,\"isParallel\":true},{\"id\":\"browsecomp-parallel-basic\",\"label\":\"Parallel Basic\",\"accuracyPct\":72,\"costCpm\":612,\"accuracyDisplay\":72,\"costDisplay\":612,\"isParallel\":true},{\"id\":\"browsecomp-exa-auto-low-cost\",\"label\":\"Exa Auto (low-cost)\",\"accuracyPct\":36,\"costCpm\":53.4,\"accuracyDisplay\":36,\"costDisplay\":53.4,\"isParallel\":false},{\"id\":\"browsecomp-tavily-low-cost\",\"label\":\"Tavily (low-cost)\",\"accuracyPct\":32,\"costCpm\":176,\"accuracyDisplay\":32,\"costDisplay\":176,\"isParallel\":false},{\"id\":\"browsecomp-tavily-frontier\",\"label\":\"Tavily (frontier)\",\"accuracyPct\":66,\"costCpm\":935,\"accuracyDisplay\":66,\"costDisplay\":935,\"isParallel\":false},{\"id\":\"browsecomp-exa-auto-frontier\",\"label\":\"Exa Auto (frontier)\",\"accuracyPct\":70,\"costCpm\":971,\"accuracyDisplay\":70,\"costDisplay\":971,\"isParallel\":false}],\"ariaLabel\":\"Accuracy versus cost, BrowseComp. Parallel Fast 44% at 11.8 CPM, Parallel Turbo 32% at 13.2 CPM, Parallel Advanced 74% at 399 CPM, Parallel Basic 72% at 612 CPM, Exa Auto (low-cost) 36% at 53.4 CPM, Tavily (low-cost) 32% at 176 CPM, Tavily (frontier) 66% at 935 CPM, Exa Auto (frontier) 70% at 971 CPM.\",\"legend\":\"CPM: USD per 1000 requests, log scale. Frontier tier uses a GPT-5.6 Sol agent; low-cost tier uses a GPT-5.6 Luna agent.\",\"description\":[{\"_key\":\"blk1\",\"_type\":\"block\",\"children\":[{\"_key\":\"sp1\",\"_type\":\"span\",\"marks\":[\"strong\"],\"text\":\"Dataset\"}],\"markDefs\":[],\"style\":\"normal\"},{\"_key\":\"blk2\",\"_type\":\"block\",\"children\":[{\"_key\":\"sp2\",\"_type\":\"span\",\"marks\":[\"lnk1\"],\"text\":\"BrowseComp\"},{\"_key\":\"sp2b\",\"_type\":\"span\",\"marks\":[],\"text\":\", created by OpenAI, contains 1,266 questions that require persistent browsing to locate hard-to-find, entangled information on the web. Results are reported on a sample of 50 questions.\"}],\"markDefs\":[{\"_key\":\"lnk1\",\"_type\":\"link\",\"href\":\"https://openai.com/index/browsecomp/\"}],\"style\":\"normal\"},{\"_key\":\"blk3\",\"_type\":\"block\",\"children\":[{\"_key\":\"sp3\",\"_type\":\"span\",\"marks\":[],\"text\":\"\"}],\"markDefs\":[],\"style\":\"normal\"},{\"_key\":\"blk4\",\"_type\":\"block\",\"children\":[{\"_key\":\"sp4\",\"_type\":\"span\",\"marks\":[\"strong\"],\"text\":\"Evaluation methodology\"}],\"markDefs\":[],\"style\":\"normal\"},{\"_key\":\"blk5\",\"_type\":\"block\",\"children\":[{\"_key\":\"sp5\",\"_type\":\"span\",\"marks\":[],\"text\":\"Multi-step agentic evaluation at two price tiers. In the frontier tier a GPT-5.6 Sol agent (reasoning: high) is paired with Parallel Basic and Parallel Advanced; in the low-cost tier a GPT-5.6 Luna agent (reasoning: low) is paired with Parallel Fast and Parallel Turbo. Exa and Tavily are run at both tiers with the same agent. The agent calls each provider's search tool and extract tool. Answers are graded by an LLM judge.\"}],\"markDefs\":[],\"style\":\"normal\"},{\"_key\":\"blk6\",\"_type\":\"block\",\"children\":[{\"_key\":\"sp6\",\"_type\":\"span\",\"marks\":[],\"text\":\"Cost includes LLM token costs and tool call costs, averaged per question and shown on a log scale.\"}],\"markDefs\":[],\"style\":\"normal\"},{\"_key\":\"blk7\",\"_type\":\"block\",\"children\":[{\"_key\":\"sp7\",\"_type\":\"span\",\"marks\":[],\"text\":\"\"}],\"markDefs\":[],\"style\":\"normal\"},{\"_key\":\"blk8\",\"_type\":\"block\",\"children\":[{\"_key\":\"sp8\",\"_type\":\"span\",\"marks\":[\"strong\"],\"text\":\"Testing dates\"}],\"markDefs\":[],\"style\":\"normal\"},{\"_key\":\"blk9\",\"_type\":\"block\",\"children\":[{\"_key\":\"sp9\",\"_type\":\"span\",\"marks\":[],\"text\":\"Evals were run on September 9, 2026.\"}],\"markDefs\":[],\"style\":\"normal\"}],\"xAxis\":{\"formatType\":\"none\",\"label\":\"Cost\",\"reverseScale\":false,\"rightMargin\":100,\"scaleType\":\"log\",\"showTicks\":false,\"unit\":\"CPM\"},\"yAxis\":{\"_type\":\"axis\",\"formatType\":\"none\",\"label\":\"Accuracy\",\"reverseScale\":false,\"scaleType\":\"linear\",\"showTicks\":false,\"unit\":\"%\"}},{\"id\":\"widesearch\",\"label\":\"WideSearch\",\"points\":[{\"id\":\"widesearch-parallel-turbo\",\"label\":\"Parallel Turbo\",\"accuracyPct\":44,\"costCpm\":10.1,\"accuracyDisplay\":44,\"costDisplay\":10.1,\"isParallel\":true},{\"id\":\"widesearch-parallel-fast\",\"label\":\"Parallel Fast\",\"accuracyPct\":45.5,\"costCpm\":10.5,\"accuracyDisplay\":45.5,\"costDisplay\":10.5,\"isParallel\":true},{\"id\":\"widesearch-parallel-advanced\",\"label\":\"Parallel Advanced\",\"accuracyPct\":57.6,\"costCpm\":692,\"accuracyDisplay\":57.6,\"costDisplay\":692,\"isParallel\":true},{\"id\":\"widesearch-parallel-basic\",\"label\":\"Parallel Basic\",\"accuracyPct\":55.3,\"costCpm\":965,\"accuracyDisplay\":55.3,\"costDisplay\":965,\"isParallel\":true},{\"id\":\"widesearch-exa-auto-low-cost\",\"label\":\"Exa Auto (low-cost)\",\"accuracyPct\":53,\"costCpm\":41.2,\"accuracyDisplay\":53,\"costDisplay\":41.2,\"isParallel\":false},{\"id\":\"widesearch-tavily-low-cost\",\"label\":\"Tavily (low-cost)\",\"accuracyPct\":47.9,\"costCpm\":107,\"accuracyDisplay\":47.9,\"costDisplay\":107,\"isParallel\":false},{\"id\":\"widesearch-exa-auto-frontier\",\"label\":\"Exa Auto (frontier)\",\"accuracyPct\":55.9,\"costCpm\":1061,\"accuracyDisplay\":55.9,\"costDisplay\":1061,\"isParallel\":false},{\"id\":\"widesearch-tavily-frontier\",\"label\":\"Tavily (frontier)\",\"accuracyPct\":55.9,\"costCpm\":1072,\"accuracyDisplay\":55.9,\"costDisplay\":1072,\"isParallel\":false}],\"ariaLabel\":\"Accuracy versus cost, WideSearch. Parallel Turbo 44% at 10.1 CPM, Parallel Fast 45.5% at 10.5 CPM, Parallel Advanced 57.6% at 692 CPM, Parallel Basic 55.3% at 965 CPM, Exa Auto (low-cost) 53% at 41.2 CPM, Tavily (low-cost) 47.9% at 107 CPM, Exa Auto (frontier) 55.9% at 1061 CPM, Tavily (frontier) 55.9% at 1072 CPM.\",\"legend\":\"CPM: USD per 1000 requests, log scale. Score is item-level correctness averaged across tasks (partial credit). Frontier tier uses a GPT-5.6 Sol agent; low-cost tier uses a GPT-5.6 Luna agent.\",\"description\":[{\"_key\":\"blk1\",\"_type\":\"block\",\"children\":[{\"_key\":\"sp1\",\"_type\":\"span\",\"marks\":[\"strong\"],\"text\":\"Dataset\"}],\"markDefs\":[],\"style\":\"normal\"},{\"_key\":\"blk2\",\"_type\":\"block\",\"children\":[{\"_key\":\"sp2\",\"_type\":\"span\",\"marks\":[\"lnk1\"],\"text\":\"WideSearch\"},{\"_key\":\"sp2b\",\"_type\":\"span\",\"marks\":[],\"text\":\", created by ByteDance Seed, contains 200 broad information-seeking tasks that require collecting many verifiable facts from across the web and assembling them into a structured table. Results are reported on a sample of 100 tasks.\"}],\"markDefs\":[{\"_key\":\"lnk1\",\"_type\":\"link\",\"href\":\"https://arxiv.org/abs/2508.07999\"}],\"style\":\"normal\"},{\"_key\":\"blk3\",\"_type\":\"block\",\"children\":[{\"_key\":\"sp3\",\"_type\":\"span\",\"marks\":[],\"text\":\"\"}],\"markDefs\":[],\"style\":\"normal\"},{\"_key\":\"blk4\",\"_type\":\"block\",\"children\":[{\"_key\":\"sp4\",\"_type\":\"span\",\"marks\":[\"strong\"],\"text\":\"Evaluation methodology\"}],\"markDefs\":[],\"style\":\"normal\"},{\"_key\":\"blk5\",\"_type\":\"block\",\"children\":[{\"_key\":\"sp5\",\"_type\":\"span\",\"marks\":[],\"text\":\"Multi-step agentic evaluation at two price tiers. In the frontier tier a GPT-5.6 Sol agent (reasoning: high) is paired with Parallel Basic and Parallel Advanced; in the low-cost tier a GPT-5.6 Luna agent (reasoning: low) is paired with Parallel Fast and Parallel Turbo. Exa and Tavily are run at both tiers with the same agent. The agent calls each provider's search tool and extract tool. Answers are graded by an LLM judge.\"}],\"markDefs\":[],\"style\":\"normal\"},{\"_key\":\"blk6\",\"_type\":\"block\",\"children\":[{\"_key\":\"sp6\",\"_type\":\"span\",\"marks\":[],\"text\":\"WideSearch is scored with partial credit: each task's score reflects the share of required items collected correctly, averaged across tasks, so it is not directly comparable to the exact-match accuracy on the other benchmarks.\"}],\"markDefs\":[],\"style\":\"normal\"},{\"_key\":\"blk6b\",\"_type\":\"block\",\"children\":[{\"_key\":\"sp6b\",\"_type\":\"span\",\"marks\":[],\"text\":\"Cost includes LLM token costs and tool call costs, averaged per task and shown on a log scale.\"}],\"markDefs\":[],\"style\":\"normal\"},{\"_key\":\"blk7\",\"_type\":\"block\",\"children\":[{\"_key\":\"sp7\",\"_type\":\"span\",\"marks\":[],\"text\":\"\"}],\"markDefs\":[],\"style\":\"normal\"},{\"_key\":\"blk8\",\"_type\":\"block\",\"children\":[{\"_key\":\"sp8\",\"_type\":\"span\",\"marks\":[\"strong\"],\"text\":\"Testing dates\"}],\"markDefs\":[],\"style\":\"normal\"},{\"_key\":\"blk9\",\"_type\":\"block\",\"children\":[{\"_key\":\"sp9\",\"_type\":\"span\",\"marks\":[],\"text\":\"Evals were run on September 9, 2026.\"}],\"markDefs\":[],\"style\":\"normal\"}],\"xAxis\":{\"formatType\":\"none\",\"label\":\"Cost\",\"reverseScale\":false,\"rightMargin\":100,\"scaleType\":\"log\",\"showTicks\":false,\"unit\":\"CPM\"},\"yAxis\":{\"_type\":\"axis\",\"formatType\":\"none\",\"label\":\"Score\",\"reverseScale\":false,\"scaleType\":\"linear\",\"showTicks\":false,\"unit\":\"%\"}}]}]\n"])</script></body></html>