, /_next/image?url=%2Fviews%2Fart%2Fwf-paper-blue.webp&amp;w=2048&amp;q=75&amp;dpl=dpl_DN6wEEXkkxyLkPTuhqYH6w144j2A 2x" src="/_next/image?url=%2Fviews%2Fart%2Fwf-paper-blue.webp&amp;w=2048&amp;q=75&amp;dpl=dpl_DN6wEEXkkxyLkPTuhqYH6w144j2A"/><img alt="" loading="lazy" width="1024" height="539" decoding="async" data-nimg="1" class="wcard__bg" style="color:transparent" srcSet="/_next/image?url=%2Fviews%2Fart%2Fwf-paper-green.webp&amp;w=1080&amp;q=75&amp;dpl=dpl_DN6wEEXkkxyLkPTuhqYH6w144j2A 1x, /_next/image?url=%2Fviews%2Fart%2Fwf-paper-green.webp&amp;w=2048&amp;q=75&amp;dpl=dpl_DN6wEEXkkxyLkPTuhqYH6w144j2A 2x" src="/_next/image?url=%2Fviews%2Fart%2Fwf-paper-green.webp&amp;w=2048&amp;q=75&amp;dpl=dpl_DN6wEEXkkxyLkPTuhqYH6w144j2A"/><img class="wcard__dither wcard__dither--orange wcard__dither--from-bottom is-active" src="/views/art/wf-dither-orange.svg" alt="" width="955" height="537" loading="lazy" decoding="async"/><img class="wcard__dither wcard__dither--taupe wcard__dither--from-right" src="/views/art/wf-dither-taupe.svg" alt="" width="955" height="537" loading="lazy" decoding="async"/><img class="wcard__dither wcard__dither--blue wcard__dither--from-top" src="/views/art/wf-dither-blue-top.svg" alt="" width="955" height="537" loading="lazy" decoding="async"/><img class="wcard__dither wcard__dither--blue wcard__dither--from-bottom" src="/views/art/wf-dither-blue-bottom.svg" alt="" width="955" height="537" loading="lazy" decoding="async"/><img class="wcard__dither wcard__dither--green wcard__dither--from-left" src="/views/art/wf-dither-green-left.svg" alt="" width="955" height="537" loading="lazy" decoding="async"/><img class="wcard__dither wcard__dither--green wcard__dither--from-right" src="/views/art/wf-dither-green-right.svg" alt="" width="955" height="537" loading="lazy" decoding="async"/><div class="pw-views stack__item workflow-motion__item"><div class="stack__item__inner"><div class="xgroup"><div class="xcard xcard--query"><div class="xquery"><p class="xquery__