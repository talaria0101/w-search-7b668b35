latAmount":2910000,"unitAmount":0,"totalAmount":2910000,"upTo":8600},{"flatAmount":2970000,"unitAmount":0,"totalAmount":2970000,"upTo":8800},{"flatAmount":3030000,"unitAmount":0,"totalAmount":3030000,"upTo":9000},{"flatAmount":3090000,"unitAmount":0,"totalAmount":3090000,"upTo":9200},{"flatAmount":3150000,"unitAmount":0,"totalAmount":3150000,"upTo":9400},{"flatAmount":3210000,"unitAmount":0,"totalAmount":3210000,"upTo":9600},{"flatAmount":3270000,"unitAmount":0,"totalAmount":3270000,"upTo":9800},{"flatAmount":3330000,"unitAmount":0,"totalAmount":3330000,"upTo":10000},{"flatAmount":330000,"unitAmount":300,"totalAmount":330300,"upTo":0}],"url":"https://dashboard.stripe.com/prices/price_0NcsLXKMxxAubV6lwbBzdhun"},{"interval":"year","lookup_key":"business-annual-a","tiers":[{"flatAmount":594000,"unitAmount":300,"totalAmount":594300,"upTo":0}],"url":"https://dashboard.stripe.com/prices/price_0QFdSLKMxxAubV6lu7YRe1Qy"},{"interval":"year","lookup_key":"business-annual-a-gbp","tiers":[{"flatAmount":594000,"unitAmount":300,"totalAmount":594300,"upTo":0}],"url":"https://dashboard.stripe.com/prices/price_0QhD6CKMxxAubV6lk2l7ycbj"},{"interval":"year","lookup_key":"enterprise-annual-base","tiers":[{"flatAmount":3000000,"unitAmount":0,"totalAmount":3000000,"upTo":1000},{"flatAmount":3000000,"unitAmount":300,"totalAmount":3000300,"upTo":0}],"url":"https://dashboard.stripe.com/prices/price_0TP3sBKMxxAubV6lFUxFv40u"}],"jsonLd":"{\"@context\":\"https://schema.org\",\"@graph\":[{\"@type\":\"Organization\",\"@id\":\"https://urlbox.com/#organization\",\"name\":\"Urlbox\",\"url\":\"https://urlbox.com\",\"logo\":{\"@type\":\"ImageObject\",\"url\":\"https://urlbox.com/apple-touch-icon-180x180.png\",\"width\":180,\"height\":180},\"email\":\"support@urlbox.com\",\"sameAs\":[\"https://github.com/urlbox\",\"https://twitter.com/urlboxhq\"]},{\"@type\":\"SoftwareApplication\",\"@id\":\"https://urlbox.com/#software\",\"name\":\"Urlbox\",\"url\":\"https://urlbox.com\",\"applicationCategory\":\"DeveloperApplication\",\"operatingSystem\":\"Any (cloud API)\",\"description\":\"Urlbox is a website screenshot API. Send a URL or HTML and get back a pixel-perfect PNG, JPEG, WebP, AVIF, PDF, MP4 or WebM render, or extract HTML, Markdown and metadata. It supports full-page screenshots, hiding cookie banners and ads, geo-located and stealth rendering, and saving renders to your own S3-compatible storage.\",\"featureList\":[\"Full-page website screenshots\",\"Image, PDF and scrolling-video output\",\"HTML, Markdown and metadata extraction\",\"Cookie banner, popup and ad blocking\",\"Geo-located proxies and anti-bot rendering\",\"Bring your own S3-compatible storage\",\"Webhooks and async rendering\",\"No charge for failed renders\"],\"provider\":{\"@id\":\"https://urlbox.com/#organization\"},\"offers\":{\"@type\":\"AggregateOffer\",\"priceCurrency\":\"USD\",\"lowPrice\":\"19.00\",\"highPrice\":\"3000.00\",\"offerCount\":5,\"offers\":[{\"@type\":\"Offer\",\"name\":\"Lo-Fi plan\",\"price\":\"19.00\",\"priceCurrency\":\"USD\",\"availability\":\"https://schema.org/InStock\",\"url\":\"https://urlbox.com/pricing\",\"priceSpecification\":{\"@type\":\"UnitPriceSpecification\",\"price\":\"19.00\",\"priceCurrency\":\"USD\",\"unitText\":\"MONTH\",\"valueAddedTaxIncluded\":false}},{\"@type\":\"Offer\",\"name\":\"Hi-Fi plan\",\"price\":\"49.00\",\"priceCurrency\":\"USD\",\"availability\":\"https://schema.org/InStock\",\"url\":\"https://urlbox.com/pricing\",\"priceSpecification\":{\"@type\":\"UnitPriceSpecification\",\"price\":\"49.00\",\"priceCurrency\":\"USD\",\"unitText\":\"MONTH\",\"valueAddedTaxIncluded\":false}},{\"@type\":\"Offer\",\"name\":\"Ultra plan\",\"price\":\"99.00\",\"priceCurrency\":\"USD\",\"availability\":\"https://schema.org/InStock\",\"url\":\"https://urlbox.com/pricing\",\"priceSpecification\":{\"@type\":\"UnitPriceSpecification\",\"price\":\"99.00\",\"priceCurrency\":\"USD\",\"unitText\":\"MONTH\",\"valueAddedTaxIncluded\":false}},{\"@type\":\"Offer\",\"name\":\"Business plan\",\"price\":\"498.00\",\"priceCurrency\":\"USD\",\"availability\":\"https://schema.org/InStock\",\"url\":\"https://urlbox.com/pricing\",\"priceSpecification\":{\"@type\":\"UnitPriceSpecification\",\"price\":\"498.00\",\"priceCurrency\":\"USD\",\"unitText\":\"MONTH\",\"valueAddedTaxIncluded\":false}},{\"@type\":\"Offer\",\"name\":\"Enterprise plan\",\"price\":\"3000.00\",\"priceCurrency\":\"USD\",\"availability\":\"https://schema.org/InStock\",\"url\":\"https://urlbox.com/pricing\",\"priceSpecification\":{\"@type\":\"UnitPriceSpecification\",\"price\":\"3000.00\",\"priceCurrency\":\"USD\",\"unitText\":\"MONTH\",\"valueAddedTaxIncluded\":false}}]}},{\"@type\":\"FAQPage\",\"mainEntity\":[{\"@type\":\"Question\",\"name\":\"What counts as a Successful Render?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"Unlike other APIs we don't charge for requests that fail for any reason. This happens when a web page is unavailble or the combination of options sent to us is not valid. A Successful Render is one that results in an image being returned to you.\"}},{\"@type\":\"Question\",\"name\":\"Do you cache screenshots?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"Yes, we cache screenshots for 30 days when generated with Render Links. You can override this setting via the TTL parameter or use the force option to override a previously cached screenshot.\"}},{\"@type\":\"Question\",\"name\":\"Do requests to cached screenshots count against the monthly quota on the plan?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"No. Only screenshots that are being rendered for the first time or via our REST API count against the quota.\"}},{\"@type\":\"Question\",\"name\":\"What happens if I go over my quota?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"No need to worry - we won't cut off your service. We'll automatically upgrade you to the next tier and you benefit from volume pricing. See the pricing page for more details.\"}},{\"@type\":\"Question\",\"name\":\"Do you send alerts when I am breaching or close to going over my monthly quota of screenshots?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"We sure do. We will send you an email when you are at 80%, 90%, and 100% usage.\"}},{\"@type\":\"Question\",\"name\":\"Are my credit card details safe?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"Yes. We never store or transmit your credit card details to our servers. We outsource all of the payment and subscription handling to our payment processor, Stripe.\"}},{\"@type\":\"Question\",\"name\":\"Do you offer any support?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"Of course! Feel free to try our first-class service out. We generally respond to any queries via email within the same day, and we aim to resolve issues within 3 working days.\"}},{\"@type\":\"Question\",\"name\":\"Do you offer Service Level Agreements / guarantees for uptime and screenshot processing time?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"Yes. Please get in touch to discuss our Business or Enterprise plans\"}},{\"@type\":\"Question\",\"name\":\"Why don't you offer a free plan?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"We primarily serve revenue generating businesses ranging from single freelancers, bloggers and startups all the way to established businesses and enterprises. These customers depend on us to continue operating sustainably as we have done for over a decade.\"}},{\"@type\":\"Question\",\"name\":\"I really want to use you guys, but I just can't afford the service right now!\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"We've worked to make our plans as affordable as possible while keeping our business sustainable. The annual Lo-Fi plan works out at just over $4/month. If that doesn't work for you, please get in touch to tell us about your project. We'll see if we can work something out.\"}},{\"@type\":\"Question\",\"name\":\"Where do screenshots get stored?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"We use Google Cloud Storage to store screenshot images. If you're on the Hi-Fi plan or above, you can choose to save screenshots to your own Amazon S3 bucket. The Ultra plan and above supports any S3-compatible storage provider.\"}},{\"@type\":\"Question\",\"name\":\"Your service sucks - I want my money back!\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"We will work with you to ensure our product meets your needs. Please help us make it better by letting us know what we can do to improve. If you're still not satisfied after 30 days you can have your money back.\"}},{\"@type\":\"Question\",\"name\":\"How do I cancel my subscription?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"It's easy to cancel - just log in to the dashboard to cancel your subscription. Your account will remain active until your renewal date, and after that you will no longer be charged.\"}}]}]}"},"__N_SSG":true},"page":"/pricing","query":{},"buildId":"_U4WoQP02lZlsSZyXFYbP","isFallback":false,"gsp":true,"scriptLoader":[]}</script></body></html>