0.97] disabled:pointer-events-none disabled:opacity-50 [&amp;_svg]:pointer-events-none [&amp;_svg]:shrink-0 bg-white/50 text-indigo-600 ring-4 ring-[rgb(22_88_155/0.06)] hover:bg-slate-50 dark:text-indigo-200 dark:ring-slate-800 dark:hover:bg-indigo-500/15 h-9 rounded-xl px-4 text-base m-1" data-slot="button" href="/contact">Talk to a human</a></div><button type="button" aria-haspopup="dialog" aria-expanded="false" aria-controls="radix-_R_18ptm_" data-state="closed" class="-mr-2 flex size-11 items-center justify-center rounded-lg text-indigo-500 focus:outline-none focus-visible:ring-2 focus-visible:ring-indigo-500/30 xl:hidden" aria-label="Open menu"><svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" class="w-6 fill-current"><path fill-rule="evenodd" clip-rule="evenodd" d="M2 12C2 11.4477 2.44772 11 3 11H21C21.5523 11 22 11.4477 22 12C22 12.5523 21.5523 13 21 13H3C2.44772 13 2 12.5523 2 12Z" fill="current"></path><path fill-rule="evenodd" clip-rule="evenodd" d="M2 6C2 5.44772 2.44772 5 3 5H21C21.5523 5 22 5.44772 22 6C22 6.55228 21.5523 7 21 7H3C2.44772 7 2 6.55228 2 6Z" fill="current"></path><path fill-rule="evenodd" clip-rule="evenodd" d="M8 18C8 17.4477 8.44772 17 9 17H21C21.5523 17 22 17.4477 22 18C22 18.5523 21.5523 19 21 19H9C8.44772 19 8 18.5523 8 18Z" fill="current"></path></svg></button></div></div></header><main><script type="application/ld+json">{"@context":"https://schema.org","@graph":[{"@type":"Organization","@id":"https://urlbox.com/#organization","name":"Urlbox","url":"https://urlbox.com","logo":{"@type":"ImageObject","url":"https://urlbox.com/apple-touch-icon-180x180.png","width":180,"height":180},"email":"support@urlbox.com","sameAs":["https://github.com/urlbox","https://twitter.com/urlboxhq"]},{"@type":"SoftwareApplication","@id":"https://urlbox.com/#software","name":"Urlbox","url":"https://urlbox.com","applicationCategory":"DeveloperApplication","operatingSystem":"Any (cloud API)","description":"Urlbox is a website screenshot API. Send a URL or HTML and get back a pixel-perfect PNG, JPEG, WebP, AVIF, PDF, MP4 or WebM render, or extract HTML, Markdown and metadata. It supports full-page screenshots, hiding cookie banners and ads, geo-located and stealth rendering, and saving renders to your own S3-compatible storage.","featureList":["Full-page website screenshots","Image, PDF and scrolling-video output","HTML, Markdown and metadata extraction","Cookie banner, popup and ad blocking","Geo-located proxies and anti-bot rendering","Bring your own S3-compatible storage","Webhooks and async rendering","No charge for failed renders"],"provider":{"@id":"https://urlbox.com/#organization"},"offers":{"@type":"AggregateOffer","priceCurrency":"USD","lowPrice":"19.00","highPrice":"3000.00","offerCount":5,"offers":[{"@type":"Offer","name":"Lo-Fi plan","price":"19.00","priceCurrency":"USD","availability":"https://schema.org/InStock","url":"https://urlbox.com/pricing","priceSpecification":{"@type":"UnitPriceSpecification","price":"19.00","priceCurrency":"USD","unitText":"MONTH","valueAddedTaxIncluded":false}},{"@type":"Offer","name":"Hi-Fi plan","price":"49.00","priceCurrency":"USD","availability":"https://schema.org/InStock","url":"https://urlbox.com/pricing","priceSpecification":{"@type":"UnitPriceSpecification","price":"49.00","priceCurrency":"USD","unitText":"MONTH","valueAddedTaxIncluded":false}},{"@type":"Offer","name":"Ultra plan","price":"99.00","priceCurrency":"USD","availability":"https://schema.org/InStock","url":"https://urlbox.com/pricing","priceSpecification":{"@type":"UnitPriceSpecification","price":"99.00","priceCurrency":"USD","unitText":"MONTH","valueAddedTaxIncluded":false}},{"@type":"Offer","name":"Business plan","price":"498.00","priceCurrency":"USD","availability":"https://schema.org/InStock","url":"https://urlbox.com/pricing","priceSpecification":{"@type":"UnitPriceSpecification","price":"498.00","priceCurrency":"USD","unitText":"MONTH","valueAddedTaxIncluded":false}},{"@type":"Offer","name":"Enterprise plan","price":"3000.00","priceCurrency":"USD","availability":"https://schema.org/InStock","url":"https://urlbox.com/pricing","priceSpecification":{"@type":"UnitPriceSpecification","price":"3000.00","priceCurrency":"USD","unitText":"MONTH","valueAddedTaxIncluded":false}}]}},{"@type":"FAQPage","mainEntity":[{"@type":"Question","name":"What counts as a Successful Render?","acceptedAnswer":{"@type":"Answer","text":"Unlike other APIs we don't charge for requests that fail for any reason. This happens when a web page is unavailble or the combination of options sent to us is not valid. A Successful Render is one that results in an image being returned to you."}},{"@type":"Question","name":"Do you cache screenshots?","acceptedAnswer":{"@type":"Answer","text":"Yes, we cache screenshots for 30 days when generated with Render Links. You can override this setting via the TTL parameter or use the force option to override a previously cached screenshot."}},{"@type":"Question","name":"Do requests to cached screenshots count against the monthly quota on the plan?","acceptedAnswer":{"@type":"Answer","text":"No. Only screenshots that are being rendered for the first time or via our REST API count against the quota."}},{"@type":"Question","name":"What happens if I go over my quota?","acceptedAnswer":{"@type":"Answer","text":"No need to worry - we won't cut off your service. We'll automatically upgrade you to the next tier and you benefit from volume pricing. See the pricing page for more details."}},{"@type":"Question","name":"Do you send alerts when I am breaching or close to going over my monthly quota of screenshots?","acceptedAnswer":{"@type":"Answer","text":"We sure do. We will send you an email when you are at 80%, 90%, and 100% usage."}},{"@type":"Question","name":"Are my credit card details safe?","acceptedAnswer":{"@type":"Answer","text":"Yes. We never store or transmit your credit card details to our servers. We outsource all of the payment and subscription handling to our payment processor, Stripe."}},{"@type":"Question","name":"Do you offer any support?","acceptedAnswer":{"@type":"Answer","text":"Of course! Feel free to try our first-class service out. We generally respond to any queries via email within the same day, and we aim to resolve issues within 3 working days."}},{"@type":"Question","name":"Do you offer Service Level Agreements / guarantees for uptime and screenshot processing time?","acceptedAnswer":{"@type":"Answer","text":"Yes. Please get in touch to discuss our Business or Enterprise plans"}},{"@type":"Question","name":"Why don't you offer a free plan?","acceptedAnswer":{"@type":"Answer","text":"We primarily serve revenue generating businesses ranging from single freelancers, bloggers and startups all the way to established businesses and enterprises. These customers depend on us to continue operating sustainably as we have done for over a decade."}},{"@type":"Question","name":"I really want to use you guys, but I just can't afford the service right now!","acceptedAnswer":{"@type":"Answer","text":"We've worked to make our plans as affordable as possible while keeping our business sustainable. The annual Lo-Fi plan works out at just over $4/month. If that doesn't work for you, please get in touch to tell us about your project. We'll see if we can work something out."}},{"@type":"Question","name":"Where do screenshots get stored?","acceptedAnswer":{"@type":"Answer","text":"We use Google Cloud Storage to store screenshot images. If you're on the Hi-Fi plan or above, you can choose to save screenshots to your own Amazon S3 bucket. The Ultra plan and above supports any S3-compatible storage provider."}},{"@type":"Question","name":"Your service sucks - I want my money back!","acceptedAnswer":{"@type":"Answer","text":"We will work with you to ensure our product meets your needs. Please help us make it better by letting us know what we can do to improve. If you're still not satisfied after 30 days you can have your money back."}},{"@type":"Question","name":"How do I cancel my subscription?","acceptedAnswer":{"@type":"Answer","text":"It's easy to cancel - just log in to the dashboard to cancel your subscription. Your account will remain active until your renewal date, and after that you will no longer be charged."}}]}]}</script><section class="mx-auto w-full max-w-(--breakpoint-xl) px-4 pt-12 sm:px-8 lg:px-12 lg:pt-12 2xl:px-0"><div class="mb-12 flex items-center justify-center"><div class="relative inline-flex rounded-lg bg-slate-100 p-1"><a class="relative z-10 rounded-md px-6 py-2 text-sm font-medium transition-all text-slate-600 hover:text-slate-900" href="/pricing/capturedeck">Bulk Screenshots Pricing</a><a class="relative z-10 rounded-md px-6 py-2 text-sm font-medium transition-all bg-white text-slate-900 shadow-sm" href="/pricing">Screenshot API Pricing</a></div></div><div class="text-center"><h5 class="mb-2 inline-block bg-linear-to-r bg-clip-text text-xs font-semibold uppercase text-transparent sm:text-sm from-slate-800 to-slate-800">Screenshot API Pricing</h5><h2 class="font-semibold text-slate-800 text-xl sm:text-2xl md:text-3xl">Automatic discounts as you scale</h2></div><div class="mt-8 lg:flex"><div class="mx-4 rounded-t-2xl border border-b-0 border-slate-200 bg-white p-6 sm:p-8 md:p-12 lg:mx-0 lg:my-4 lg:w-1/3 lg:rounded-l-2xl lg:rounded-r-none lg:border-b lg:border-r-0"><div class="relative flex flex-col gap-8"><div><div class="flex flex-col gap-4"><div class="flex items-baseline gap-2"><h5 class="inline-block bg-linear-to-r bg-clip-text text-xs font-semibold uppercase text-transparent sm:text-sm from-cyan-500 to-sky-600 mb-0">Hi-Fi<!-- -->:</h5><p class="text-sm">Accurate, reliable renders</p></div><div><div class="flex items-center gap-2 text-slate-800"><span>$</span><span class="text-5xl font-medium">49</span><span>/month</span></div><p class="text-balance text-sm leading-normal"><span>For up to </span><span class="text-slate-800">5,000<!-- --> renders<!-- --> </span><span><br/>($<!-- -->9.80<!-- --> <!-- -->per 1,000)</span></p></div></div><ul class="mt-6 flex flex-col gap-y-1 text-sm"><li class="flex gap-1.5"><svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" class="mt-[0.2rem] size-3.5 shrink-0 fill-current text-emerald-500"><path fill-rule="evenodd" clip-rule="evenodd" d="M20.7071 5.29289C21.0976 5.68342 21.0976 6.31658 20.7071 6.70711L9.70711 17.7071C9.31658 18.0976 8.68342 18.0976 8.29289 17.7071L3.29289 12.7071C2.90237 12.3166 2.90237 11.6834 3.29289 11.2929C3.68342 10.9024 4.31658 10.9024 4.70711 11.2929L9 15.5858L19.2929 5.29289C19.6834 4.90237 20.3166 4.90237 20.7071 5.29289Z" fill="current"></path></svg><div>Pixel-perfect screenshots</div></li><li class="flex gap-1.5"><svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" class="mt-[0.2rem] size-3.5 shrink-0 fill-current text-emerald-500"><path fill-rule="evenodd" clip-rule="evenodd" d="M20.7071 5.29289C21.0976 5.68342 21.0976 6.31658 20.7071 6.70711L9.70711 17.7071C9.31658 18.0976 8.68342 18.0976 8.29289 17.7071L3.29289 12.7071C2.90237 12.3166 2.90237 11.6834 3.29289 11.2929C3.68342 10.9024 4.31658 10.9024 4.70711 11.2929L9 15.5858L19.2929 5.29289C19.6834 4.90237 20.3166 4.90237 20.7071 5.29289Z" fill="current"></path></svg><div>Suitable for 80% of use cases</div></li><li class="flex gap-1.5"><svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" class="mt-[0.2rem] size-3.5 shrink-0 fill-current text-emerald-500"><path fill-rule="evenodd" clip-rule="evenodd" d="M20.7071 5.29289C21.0976 5.68342 21.0976 6.31658 20.7071 6.70711L9.70711 17.7071C9.31658 18.0976 8.68342 18.0976 8.29289 17.7071L3.29289 12.7071C2.90237 12.3166 2.90237 11.6834 3.29289 11.2929C3.68342 10.9024 4.31658 10.9024 4.70711 11.2929L9 15.5858L19.2929 5.29289C19.6834 4.90237 20.3166 4.90237 20.7071 5.29289Z" fill="current"></path></svg><div>Standard support</div></li></ul></div><div><div class="flex flex-wrap items-baseline gap-x-3