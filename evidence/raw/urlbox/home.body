width="137" height="32" fill="white"></rect></clipPath></defs></svg></div></div></div><style>
        .scan-reveal,
        .scan-glow,
        .scan-line,
        .scan-handle {
          opacity: 0;
        }

        .cs-visible .scan-reveal {
          height: 4%;
          animation: scan-cycle 4.8s linear infinite, scan-visibility 4.8s linear infinite;
        }

        .cs-visible .scan-glow {
          top: 4%;
          background: linear-gradient(to top, rgb(79 70 229 / 0.25), rgb(79 70 229 / 0));
          animation: scan-line-cycle 4.8s linear infinite, scan-visibility 4.8s linear infinite;
        }

        .cs-visible .scan-line {
          top: 4%;
          animation: scan-line-cycle 4.8s linear infinite, scan-visibility 4.8s linear infinite;
        }

        .cs-visible .scan-handle {
          top: 4%;
          animation: scan-line-cycle 4.8s linear infinite, scan-visibility 4.8s linear infinite;
        }

        .sparkle-shimmer {
          position: absolute;
          inset: 0;
          background: linear-gradient(
            115deg,
            transparent 34%,
            rgb(255 255 255 / 0.12) 44%,
            rgb(255 255 255 / 0.5) 50%,
            rgb(255 255 255 / 0.12) 56%,
            transparent 66%
          );
          opacity: 0;
          transform: translateX(-120%);
        }

        .cs-visible .sparkle-shimmer {
          animation: sparkle-shimmer 4.8s linear infinite;
        }

        @keyframes scan-cycle {
          from { height: 4%; }
          99%  { height: 96%; }
          to   { height: 4%; }
        }

        @keyframes scan-line-cycle {
          from { top: 4%; }
          99%  { top: 96%; }
          to   { top: 4%; }
        }

        @keyframes scan-visibility {
          0%       { opacity: 0; }
          7%       { opacity: 1; }
          94%      { opacity: 1; }
          98%, 100% { opacity: 0; }
        }

        @keyframes sparkle-shimmer {
          0%, 34%   { opacity: 0; transform: translateX(-120%); }
          40%       { opacity: 0.65; transform: translateX(-8%); }
          46%       { opacity: 0.65; transform: translateX(120%); }
          52%, 68%  { opacity: 0; transform: translateX(120%); }
          69%       { opacity: 0; transform: translateX(-120%); }
          73%       { opacity: 0.75; transform: translateX(-8%); }
          81%       { opacity: 0.75; transform: translateX(120%); }
          82%, 86%, 100% { opacity: 0; transform: translateX(120%); }
        }

        @media (prefers-reduced-motion: reduce) {
          .scan-reveal,
          .scan-glow,
          .scan-line,
          .scan-handle,
          .sparkle-shimmer {
            animation: none !important;
            opacity: 1;
          }
          .scan-reveal { height: 50%; }
          .scan-glow,
          .scan-line,
          .scan-handle { top: 50%; }
        }
      </style></div></div></div></section><section id="forensic-grade-context" class="relative"><div class="border-b border-slate-200 overflow-hidden"><div class="relative mx-auto w-full max-w-(--breakpoint-xl) px-4 sm:px-8 lg:px-12 2xl:px-0 grid grid-cols-1 lg:grid-cols-2 items-end gap-x-16 gap-y-8 pt-16 lg:pt-32"><div class="flex flex-col px-6 md:px-0 lg:pl-12 lg:pb-16"><p class="text-xs uppercase text-indigo-600 font-semibold tracking-widest mb-2">Context</p><h2 class="font-semibold text-slate-800 text-xl sm:text-2xl md:text-3xl max-w-xl">Screenshots with forensic-grade context</h2><p class="mt-8 text-balance max-w-xl">Capture metadata, links, markdown, and fully-hydrated HTML alongside every screenshot, secured with timestamps and cryptographic hashes so every screenshot is a provable, searchable record — not just an image.</p></div><div class="relative w-full max-w-xl overflow-visible pt-28"><div class="forensic-visual absolute inset-x-0 top-0 aspect-square overflow-visible" style="container-type:inline-size"><div class="forensic-orbit-track absolute rounded-full border border-dashed border-indigo-200 pointer-events-none" style="width:58.5cqi;height:58.5cqi;left:calc(50% - 29.25cqi);top:calc(50% - 29.25cqi)"></div><div class="forensic-orbit-track absolute rounded-full border border-dashed border-indigo-200 pointer-events-none" style="width:71cqi;height:71cqi;left:calc(50% - 35.5cqi);top:calc(50% - 35.5cqi)"></div><div class="forensic-orbit-track absolute rounded-full border border-dashed border-indigo-200 pointer-events-none" style="width:83.5cqi;height:83.5cqi;left:calc(50% - 41.75cqi);top:calc(50% - 41.75cqi)"></div><div class="forensic-orbit-track absolute rounded-full border border-dashed border-indigo-200 pointer-events-none" style="width:96cqi;height:96cqi;left:calc(50% - 48cqi);top:calc(50% - 48cqi)"></div><div class="forensic-orbit-track absolute rounded-full border border-dashed border-indigo-200 pointer-events-none" style="width:108.5cqi;height:108.5cqi;left:calc(50% - 54.25cqi);top:calc(50% - 54.25cqi)"></div><div class="absolute left-1/2 top-1/2 w-0 h-0 z-10"><div class="forensic-spinner forensic-spinner-0"><div class="forensic-counter forensic-counter-0 flex w-max items-center gap-1 rounded-lg border border-slate-200 bg-white px-2 h-7 shadow-md shadow-black/5 text-sm text-slate-700 "><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-braces size-4 text-indigo-500" aria-hidden="true"><path d="M8 3H7a2 2 0 0 0-2 2v5a2 2 0 0 1-2 2 2 2 0 0 1 2 2v5c0 1.1.9 2 2 2h1"></path><path d="M16 21h1a2 2 0 0 0 2-2v-5c0-1.1.9-2 2-2a2 2 0 0 1-2-2V5a2 2 0 0 0-2-2h-1"></path></svg>JSON</div></div></div><div class="absolute left-1/2 top-1/2 w-0 h-0 z-10"><div class="forensic-spinner forensic-spinner-1"><div class="forensic-counter forensic-counter-1 flex w-max items-center gap-1 rounded-lg border border-slate-200 bg-white px-2 h-7 shadow-md shadow-black/5 text-sm text-slate-700 "><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-arrow-big-down size-4 text-amber-500" aria-hidden="true"><path d="M15 6v6h4l-7 7-7-7h4V6h6z"></path></svg>Markdown</div></div></div><div class="absolute left-1/2 top-1/2 w-0 h-0 z-10"><div class="forensic-spinner forensic-spinner-2"><div class="forensic-counter forensic-counter-2 flex w-max items-center gap-1 rounded-lg border border-slate-200 bg-white px-2 h-7 shadow-md shadow-black/5 text-sm text-slate-700 "><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-code-xml size-4 text-sky-500" aria-hidden="true"><path d="m18 16 4-4-4-4"></path><path d="m6 8-4 4 4 4"></path><path d="m14.5 4-5 16"></path></svg>HTML</div></div></div><div class="absolute left-1/2 top-1/2 w-0 h-0 z-10"><div class="forensic-spinner forensic-spinner-3"><div class="forensic-counter forensic-counter-3 flex w-max items-center gap-1 rounded-lg border border-slate-200 bg-white px-2 h-7 shadow-md shadow-black/5 text-sm text-slate-700 font-mono text-xs"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-badge-check size-4 text-green-500" aria-hidden="true"><path d="M3.85 8.62a4 4 0 0 1 4.78-4.77 4 4 0 0 1 6.74 0 4 4 0 0 1 4.78 4.78 4 4 0 0 1 0 6.74 4 4 0 0 1-4.77 4.78 4 4 0 0 1-6.75 0 4 4 0 0 1-4.78-4.77 4 4 0 0 1 0-6.76Z"></path><path d="m9 12 2 2 4-4"></path></svg>a3f8…c91d</div></div></div><div class="absolute left-1/2 top-1/2 w-0 h-0 z-10"><div class="forensic-spinner forensic-spinner-4"><div class="forensic-counter forensic-counter-4 flex w-max items-center gap-1 rounded-lg border border-slate-200 bg-white px-2 h-7 shadow-md shadow-black/5 text-sm text-slate-700 "><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-clock size-4 text-slate-500" aria-hidden="true"><path d="M12 6v6l4 2"></path><circle cx="12" cy="12" r="10"></circle></svg>Timestamp</div></div></div></div><img alt="Forensic-grade context" loading="lazy" width="1200" height="689" decoding="async" data-nimg="1" class="relative w-full max-w-112 mx-auto h-auto" style="color:transparent" srcSet="/_next/image?url=%2Fimages%2F2026%2Fvisuals%2Fforensic-context.png&amp;w=1200&amp;q=75 1x, /_next/image?url=%2Fimages%2F2026%2Fvisuals%2Fforensic-context.png&amp;w=3840&amp;q=75 2x" src="/_next/image?url=%2Fimages%2F2026%2Fvisuals%2Fforensic-context.png&amp;w=3840&amp;q=75"/><style>
        .forensic-orbit-track { opacity: 0; }
        .forensic-spinner { opacity: 0; }

