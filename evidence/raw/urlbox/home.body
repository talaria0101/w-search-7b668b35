"USD","unitText":"MONTH","valueAddedTaxIncluded":false}},{"@type":"Offer","name":"Ultra plan","price":"99.00","priceCurrency":"USD","availability":"https://schema.org/InStock","url":"https://urlbox.com/pricing","priceSpecification":{"@type":"UnitPriceSpecification","price":"99.00","priceCurrency":"USD","unitText":"MONTH","valueAddedTaxIncluded":false}},{"@type":"Offer","name":"Business plan","price":"498.00","priceCurrency":"USD","availability":"https://schema.org/InStock","url":"https://urlbox.com/pricing","priceSpecification":{"@type":"UnitPriceSpecification","price":"498.00","priceCurrency":"USD","unitText":"MONTH","valueAddedTaxIncluded":false}},{"@type":"Offer","name":"Enterprise plan","price":"3000.00","priceCurrency":"USD","availability":"https://schema.org/InStock","url":"https://urlbox.com/pricing","priceSpecification":{"@type":"UnitPriceSpecification","price":"3000.00","priceCurrency":"USD","unitText":"MONTH","valueAddedTaxIncluded":false}}]}}]}</script><section id="hero" class="relative"><div class="relative mx-auto w-full max-w-(--breakpoint-xl) px-4 pt-8 md:pt-16 sm:px-8 lg:px-12 2xl:px-0"><div class="relative bg-white border border-slate-200 rounded-3xl p-6 md:p-12"><div class="absolute inset-0 rounded-3xl overflow-hidden"><div class="absolute right-0 w-1/2 bg-indigo-500/50 h-32 -bottom-32 blur-3xl" style="border-radius:50% 50%"></div><div class="absolute -bottom-48 right-32 bg-indigo-500 h-128 w-20 rotate-30 blur-3xl" style="border-radius:50% 50%"></div><div class="absolute -bottom-48 right-64 bg-rose-400 h-96 w-16 rotate-30 blur-3xl mix-blend-color-burn" style="border-radius:50% 50%"></div><div class="absolute -bottom-48 right-80 bg-rose-400 h-96 w-8 rotate-30 blur-3xl" style="border-radius:50% 50%"></div></div><div class="relative lg:max-w-lg xl:max-w-none"><h1 class="font-semibold text-slate-800 text-3xl sm:text-4xl md:text-5xl max-w-2xl">Website screenshots you&#x27;d stake your reputation on</h1><p class="max-w-xl text-balance mt-8">Reliable enou