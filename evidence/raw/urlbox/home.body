        }
        .fgc-visible .forensic-counter-4 {
          transform: translate(-50%, -50%) rotate(-220deg);
          animation: forensic-counter-4 44s linear infinite;
        }
        @keyframes forensic-orbit-4 {
          from { transform: rotate(220deg) translateX(54.25cqi); }
          to   { transform: rotate(580deg) translateX(54.25cqi); }
        }
        @keyframes forensic-counter-4 {
          from { transform: translate(-50%, -50%) rotate(-220deg); }
          to   { transform: translate(-50%, -50%) rotate(-580deg); }
        }

        @keyframes forensic-fade-in {
          from { opacity: 0; }
          to   { opacity: 1; }
        }

        @media (prefers-reduced-motion: reduce) {
          .forensic-orbit-track,
          .forensic-spinner,
          .forensic-spinner-0,
          .forensic-spinner-1,
          .forensic-spinner-2,
          .forensic-spinner-3,
          .forensic-spinner-4 {
            animation: none !important;
            opacity: 1;
          }
          .forensic-counter-0,
          .forensic-counter-1,
          .forensic-counter-2,
          .forensic-counter-3,
          .forensic-counter-4 {
            animation: none !important;
          }
        }
      </style></div></div></div></section><section id="output-formats" class="relative mx-auto w-full max-w-(--breakpoint-xl) px-4 pt-16 lg:pt-32 sm:px-8 lg:px-12 2xl:px-0"><div class="max-w-xl px-6 md:px-0 lg:pl-12"><p class="text-xs uppercase text-indigo-600 font-semibold tracking-widest mb-2">Formats</p><h2 class="font-semibold text-slate-800 text-xl sm:text-2xl md:text-3xl">Every screenshot format you need</h2><p class="mt-8 text-balance max-w-xl">Turn any URL or HTML into images, video, PDFs, and structured data — so captures drop straight into reports, websites, and workflows.</p><div class="mt-8 flex"><a class="relative inline-flex shrink-0 items-center justify-center gap-2 whitespace-nowrap font-button font-medium transition-all duration-200 ease-out outline-none focus-visible:ring-2 focus-visible:ring-brand-500 focus-visible:ring-offset-1 active:scale-[0.97] disabled:pointer-events-none disabled:opacity-50 [&amp;_svg]:pointer-events-none [&amp;_svg]:shrink-0 bg-linear-to-br from-indigo-500 to-indigo-600 text-white ring-4 ring-[rgb(22_88_155/0.06)] hover:from-indigo-600 hover:to-indigo-700 dark:ring-slate-800 h-9 rounded-xl px-4 text-base" data-slot="button" href="/blog?category=features"><span>See detailed guides</span><svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true" data-slot="icon" class="size-4"><path fill-rule="evenodd" d="M2 10a.75.75 0 0 1 .75-.75h12.59l-2.1-1.95a.75.75 0 1 1 1.02-1.1l3.5 3.25a.75.75 0 0 1 0 1.1l-3.5 3.25a.75.75 0 1 1-1.02-1.1l2.1-1.95H2.75A.75.75 0 0 1 2 10Z" clip-rule="evenodd"></path></svg></a></div></div><div class="lg:flex lg:items-center lg:justify-center w-full mt-12 lg:-mt-8"><div class="lg:flex lg:grow lg:shrink-0"><div class="lg:grow lg:shrink-0 grid grid-cols-1 sm:grid-cols-2 lg:flex lg:flex-col gap-4"><div class="p-6 md:pl-12 bg-white border border-slate-200 rounded-2xl"><div class="flex items-center gap-1"><svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="c