"21.1768" y2="14.8588" gradientUnits="userSpaceOnUse"><stop stop-color="#3646D6"></stop><stop offset="1" stop-color="#00109C"></stop></linearGradient><linearGradient id="_R_54kj1tm_-paint-2" x1="18.6812" y1="20.579" x2="23.8841" y2="29.4288" gradientUnits="userSpaceOnUse"><stop stop-color="#3A4BE8"></stop><stop offset="1" stop-color="#2D3BB5"></stop></linearGradient><clipPath id="_R_54kj1tm_-clip"><rect width="137" height="32" fill="white"></rect></clipPath></defs></svg></div></div></div><div class="py-4 flex justify-center lg:hidden"><svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true" data-slot="icon" class="w-6 fill-current text-indigo-500"><path fill-rule="evenodd" d="M10 2a.75.75 0 0 1 .75.75v12.59l1.95-2.1a.75.75 0 1 1 1.1 1.02l-3.25 3.5a.75.75 0 0 1-1.1 0l-3.25-3.5a.75.75 0 1 1 1.1-1.02l1.95 2.1V2.75A.75.75 0 0 1 10 2Z" clip-rule="evenodd"></path></svg></div><div class="hidden lg:block self-stretch shrink-0 relative"><svg viewBox="0 0 64 0" width="64" height="0" xmlns="http://www.w3.org/2000/svg"><path d="M 0 0 H 32 V 51 H 64" fill="none" stroke="#e2e8f0"></path><path d="M 0 0 H 32 V 169 H 64" fill="none" stroke="#e2e8f0"></path><path d="M 0 0 H 32 V 287 H 64" fill="none" stroke="#e2e8f0"></path><path d="M 0 0 H 32 V 405 H 64" fill="none" stroke="#e2e8f0"></path><path d="M 0 0 H 32 V 51 H 64" fill="none" stroke="#6366f1"></path></svg></div><div class="grow shrink-0 grid grid-cols-1 sm:grid-cols-2 lg:flex lg:flex-col gap-4"><div class="p-6 bg-white border border-slate-200 rounded-2xl"><div class="flex items-center gap-1"><svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true" data-slot="icon" class="size-4 text-indigo-500"><path fill-rule="evenodd" d="M1 5.25A2.25 2.25 0 0 1 3.25 3h13.5A2.25 2.25 0 0 1 19 5.25v9.5A2.25 2.25 0 0 1 16.75 17H3.25A2.25 2.25 0 0 1 1 14.75v-9.5Zm1.5 5.81v3.69c0 .414.336.75.75.75h13.5a.75.75 0 0 0 .75-.75v-2.69l-2.22-2.219a.75.75 0 0 0-1.06 0l-1.91 1.909.47.47a.75.75 0 1 1-1.06 1.06L6.53 8.091a.75.75 0 0 0-1.06 0l-2.97 2.97ZM12 7a1 1 0 1 1-2 0 1 1 0 0 1 2 0Z" clip-rule="evenodd"></path></svg><p class="text-slate-800">Image</p></div><p class="text-sm">PNG, JPEG, SVG, AVIF</p></div><div class="p-6 bg-white border border-slate-200 rounded-2xl"><div class="flex items-center gap-1"><svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true" data-slot="icon" class="size-4 text-indigo-500"><path d="M3.25 4A2.25 2.25 0 0 0 1 6.25v7.5A2.25 2.25 0 0 0 3.25 16h7.5A2.25 2.25 0 0 0 13 13.75v-7.5A2.25 2.25 0 0 0 10.75 4h-7.5ZM19 4.75a.75.75 0 0 0-1.28-.53l-3 3a.75.75 0 0 0-.22.53v4.5c0 .199.079.39.22.53l3 3a.75.75 0 0 0 1.28-.53V4.75Z"></path></svg><p class="text-slate-800">Video</p></div><p class="text-sm">MP4, WEBM</p></div><div class="p-6 bg-white border border-slate-200 rounded-2xl"><div class="flex items-center gap-1"><svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true" data-slot="icon" class="size-4 text-indigo-500"><path fill-rule="evenodd" d="M4.5 2A1.5 1.5 0 0 0 3 3.5v13A1.5 1.5 0 0 0 4.5 18h11a1.5 1.5 0 0 0 1.5-1.5V7.621a1.5 1.5 0 0 0-.44-1.06l-4.12-4.122A1.5 1.5 0 0 0 11.378 2H4.5Zm2.25 8.5a.75.75 0 0 0 0 1.5h6.5a.75.75 0 0 0 0-1.5h-6.5Zm0 3a.75.75 0 0 0 0 1.5h6.5a.75.75 0 0 0 0-1.5h-6.5Z" clip-rule="evenodd"></path></svg><p class="text-slate-800">Document</p></div><p class="text-sm">PDF, SVG</p></div><div class="p-6 bg-white border border-slate-200 rounded-2xl"><div class="flex items-center gap-1"><svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true" data-slot="icon" class="size-4 text-indigo-500"><path fill-rule="evenodd" d="M6.28 5.22a.75.75 0 0 1 0 1.06L2.56 10l3.72 3.72a.75.75 0 0 1-1.06 1.06L.97 10.53a.75.75 0 0 1 0-1.06l4.25-4.25a.75.75 0 0 1 1.06 0Zm7.44 0a.75.75 0 0 1 1.06 0l4.25 4.25a.75.75 0 0 1 0 1.06l-4.25 4.25a.75.75 0 0 1-1.06-1.06L17.44 10l-3.72-3.72a.75.75 0 0 1 0-1.06ZM11.377 2.011a.75.75 0 0 1 .612.867l-2.5 14.5a.75.75 0 0 1-1.478-.255l2.5-14.5a.75.75 0 0 1 .866-.612Z" clip-rule="evenodd"></path></svg><p class="text-slate-800">Data</p></div><p class="text-sm">MD, JSON, HTML</p></div></div></div><div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-8 mt-12 px-6 md:px-12"><div><h3 class="text-slate-800 mb-4 text-lg flex items-center gap-2"><svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true" data-slot="icon" class="w-5 fill-current text-indigo-500"><path fill-rule="evenodd" d="M1 5.25A2.25 2.25 0 0 1 3.25 3h13.5A2.25 2.25 0 0 1 19 5.25v9.5A2.25 2.25 0 0 1 16.75 17H3.25A2.25 2.25 0 0 1 1 14.75v-9.5Zm1.5 5.81v3.69c0 .414.336.75.75.75h13.5a.75.75 0 0 0 .75-.75v-2.69l-2.22-2.219a.75.75 0 0 0-1.06 0l-1.91 1.909.47.47a.75.75 0 1 1-1.06 1.06L6.53 8.091a.75.75 0 0 0-1.06 0l-2.97 2.97ZM12 7a1 1 0 1 1-2 0 1 1 0 0 1 2 0Z" clip-rule="evenodd"></path></svg><span>Image</span></h3><p class="text-sm mt-3">When you want to capture a snapshot of a full or partial page at a specific point in time.</p><ul class="mt-5 text-sm space-y-2 list-disc pl-3 marker:text-indigo-500"><li><span class="font-medium text-slate-800">PNG</span><span>: <!-- -->Even with a transparent background.</span></li><li><span class="font-medium text-slate-800">JPEG</span><span>: <!-- -->For photos and general use.</span></li><li><span class="font-medium text-slate-800">WEBP</span><span>: <!-- -->For modern browsers and mobile devices.</span></li><li><span class="font-medium text-slate-800">AVIF</span><span>: <!-- -->For high-quality images on modern browsers.</span></li></ul></div><div><h3 class="text-slate-800 mb-4 text-lg flex items-center gap-2"><svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true" data-slot="icon" class="w-5 fill-current text-indigo-500"><path d="M3.25 4A2.25 2.25 0 0 0 1 6.25v7.5A2.25 2.25 0 0 0 3.25 16h7.5A2.25 2.25 0 0 0 13 13.75v-7.5A2.25 2.25 0 0 0 10.75 4h-7.5ZM19 4.75a.75.75 0 0 0-1.28-.53l-3 3a.75.75 0 0 0-.22.53v4.5c0 .199.079.39.22.53l3 3a.75.75 0 0 0 1.28-.53V4.75Z"></path></svg><span>Video</span></h3><p class="text-sm mt-3">When you want to capture an animated website or a video scrolling down a page.</p><ul class="mt-5 text-sm space-y-2 list-disc pl-3 marker:text-indigo-500"><li><span class="font-medium text-slate-800">MP4</span><span>: <!-- -->For general video use.</span></li><li><span class="font-medium text-slate-800">WEBM</span><span>: <!-- -->For modern browsers and mobile devices.</span></li></ul></div><div><h3 class="text-slate-800 mb-4 text-lg flex items-center gap-2"><svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true" data-slot="icon" class="w-5 fill-current text-indigo-500"><path fill-rule="evenodd" d="M4.5 2A1.5 1.5 0 0 0 3 3.5v13A1.5 1.5 0 0 0 4.5 18h11a1.5 1.5 0 0 0 1.5-1.5V7.621a1.5 1.5 0 0 0-.44-1.06l-4.12-4.122A1.5 1.5 0 0 0 11.378 2H4.5Zm2.25 8.5a.75.75 0 0 0 0 1.5h6.5a.75.75 0 0 0 0-1.5h-6.5Zm0 3a.75.75 0 0 0 0 1.5h6.5a.75.75 0 0 0 0-1.5h-6.5Z" clip-rule="evenodd"></path></svg><span>Document</span></h3><p class="text-sm mt-3">When you want to capture a page as if it were printed or you need a vector graphic for a design pipeline.</p><ul class="mt-5 text-sm space-y-2 list-disc pl-3 marker:text-indigo-500"><li><span class="font-medium text-slate-800">PDF</span><span>: <!-- -->For reports, invoices and more.</span></li><li><span class="font-medium text-slate-800">SVG</span><span>: <!-- -->For vector graphics.</span></li></ul></div><div><h3 class="text-slate-800 mb-4 text-lg flex items-center gap-2"><svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true" data-slot="icon" class="w-5 fill-current text-indigo-500"><path fill-rule="evenodd" d="M6.28 5.22a.75.75 0 0 1 0 1.06L2.56 10l3.72 3.72a.75.75 0 0 1-1.06 1.06L.97 10.53a.75.75 0 0 1 0-1.06l4.25-4.25a.75.75 0 0 1 1.06 0Zm7.44 0a.75.75 0 0 1 1.06 0l4.25 4.25a.75.75 0 0 1 0 1.06l-4.25 4.25a.75.75 0 0 1-1.06-1.06L17.44 10l-3.72-3.72a.75.75 0 0 1 0-1.06ZM11.377 2.011a.75.75 0 0 1 .612.867l-2.5 14.5a.75.75 0 0 1-1.478-.255l2.5-14.5a.75.75 0 0 1 .866-.612Z" clip-rule="evenodd"></path></svg><span>Data</span></h3><p class="text-sm mt-3">When you need to capture more context at the same moment as taking a screenshot, recording a video or generating a document.</p><ul class="mt-5 text-sm space-y-2 list-disc pl-3 marker:text-indigo-500"><li><span class="font-medium text-slate-800">MD</span><span>: <!-- -->Extract text content as markdown for LLM inputs.</span></li><li><span class="font-medium text-slate-800">JSON</span><span>: <!-- -->Extract structured metadata and more data from pages.</span></li><li><span class="font-medium text-slate-800">HTML</span><span>: <!-- -->Get the fully hydrated HTML with dynamically loaded content.</span></li></ul></div></div></section><section id="render-options" class="relative"><div class="border-t mt-16 lg:mt-32 border-slate-200 overflow-hidden"><div class="relative mx-auto w-full max-w-(--breakpoint-xl) px-4 sm:px-8 lg:px-12 2xl:px-0 grid grid-cols-1 lg:grid-cols-2 items-start gap-x-16 gap-y-8 py-16 lg:py-32"><div class="w-full"><div class="relative mx-auto max-w-lg"><div class="ro-el ro-dims flex items-center gap-2 mb-3 mx-10"><div class="relative flex-1 h-px border-t border-dashed border-slate-300"><div class="absolute left-0 -top-1 w-px h-2 bg-slate-300"></div></div><div class="ro-el ro-device flex w-max items-center gap-1 rounded-lg border border-slate-200 bg-white px-2 h-7 shadow-md shadow-black/5 text-sm text-slate-700"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-monitor size-4 text-sky-500" aria-hidden="true"><rect width="20" height="14" x="2" y="3" rx="2"></rect><line x1="8" x2="16" y1="21" y2="21"></line><line x1="12" x2="12" y1="17" y2="21"></line></svg><span>Desktop</span><span class="text-xs font-mono text-slate-400 ml-0.5">1280 × 800</span></div><div class="relative flex-1 h-px border-t border-dashed border-slate-300"><div class="absolute right-0 -top-1 w-px h-2 bg-slate-300"></div></div></div><div class="ro-el ro-frame relative mx-10"><div class="rounded-xl border border-slate-200 bg-white p-1 shadow-lg shadow-black/5"><div class="flex items-center gap-1 m-1 mb-1.5"><div class="size-2.5 bg-red-400 rounded-full"></div><div class="size-2.5 bg-amber-400 rounded-full"></div><div class="size-2.5 bg-green-400 rounded-full"></div></div><div class="relative rounded-lg border border-slate-100 bg-slate-50 p-3 space-y-2"><div class="flex gap-2 items-center"><div class="h-2 w-8 rounded-sm bg-slate-200/80"></div><div class="h-2 w-5 rounded-sm bg-slate-200/50"></div><div class="h-2 w-5 rounded-sm bg-slate-200/50"></div><div class="h-2 w-5 rounded-sm bg-slate-200/50"></div></div><div class="ro-el ro-hero-focus relative h-24 w-full rounded bg-slate-100 border border-dashed border-rose-400"></div><div class="flex gap-2"><div class="h-14 flex-1 rounded bg-slate-100 border border-dashed border-slate-200/40"></div><div class="h-14 flex-1 rounded bg-slate-100 border border-dashed border-slate-200/40"></div></div><div class="h-3 w-2/3 rounded-sm bg-slate-100"></div><div class="h-3 w-1/2 rounded-sm bg-slate-100"></div></div></div><div class="absolute -left-4 top-1/2 -translate-x-full -translate-y-1/2 z-20 hidden sm:flex flex-col items-end gap-1.5"><div class="ro-el ro-inject-0 relative flex w-max items-center gap-1 rounded-lg border border-slate-200 bg-white px-2 h-6 shadow-md shadow-black/5 text-xs text-slate-600"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-braces size-3.5 text-violet-500" aria-hidden="true"><path d="M8 3H7a2 2 0 0 0-2 2v5a2 2 0 0 1-2 2 2 2 0 0 1 2 2v5c0 1.1.9 2 2 2h1"></path><path d="M16 21h1a2 2 0 0 0 2-2v-5c0-1.1.9-2 2-2a2 2 0 0 1-2-2V5a2 2 0 0 0-2-2h-1"></path></svg>Headers</div><div class="ro-el ro-inject-1 relative flex w-max items-center gap-1 rounded-lg border border-slate-200 bg-white px-2 h-6 shadow-md shadow-black/5 text-xs text-slate-600"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-cookie size-3.5 text-amber-500" aria-hidden="true"><path d="M12 2a10 10 0 1 0 10 10 4 4 0 0 1-5-5 4 4 0 0 1-5-5"></path><path d="M8.5 8.5v.01"></path><path d="M16 15.5v.01"></path><path d="M12 12v.01"></path><path d="M11 17v.01"></path><path d="M7 14v.01"></path></svg>Cookies</div><div class="ro-el ro-inject-2 relative flex w-max items-center gap-1 rounded-lg border border-slate-200 bg-white px-2 h-6 shadow-md shadow-black/5 text-xs text-slate-600"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-file-code2 lucide-file-code-2 size-3.5 text-yellow-500" aria-hidden="true"><path d="M4 22h14a2 2 0 0 0 2-2V7l-5-5H6a2 2 0 0 0-2 2v4"></path><path d="M14 2v4a2 2 0 0 0 2 2h4"></path><path d="m5 12-3 3 3 3"></path><path d="m9 18 3-3-3-3"></path></svg>JavaScript</div><div class="ro-el ro-inject-3 relative flex w-max items-center gap-1 rounded-lg border border-slate-200 bg-white px-2 h-6 shadow-md shadow-black/5 text-xs text-slate-600"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-code size-3.5 text-sky-500" aria-hidden="true"><path d="m16 18 6-6-6-6"></path><path d="m8 6-6 6 6 6"></path></svg>CSS</div><div class="ro-el ro-inject-4 relative flex w-max items-center gap-1 rounded-lg border border-slate-200 bg-white px-2 h-6 shadow-md shadow-black/5 text-xs text-slate-600"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-globe size-3.5 text-emerald-500" aria-hidden="true"><circle cx="12" cy="12" r="10"></circle><path d="M12 2a14.5 14.5 0 0 0 0 20 14.5 14.5 0 0 0 0-20"></path><path d="M2 12h20"></path></svg>User Agent</div><div class="ro-el ro-inject-5 relative flex w-max items-center gap-1 rounded-lg border border-slate-200 bg-white px-2 h-6 shadow-md shadow-black/5 text-xs text-slate-600"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-clock size-3.5 text-indigo-500" aria-hidden="true"><path d="M12 6v6l4 2"></path><circle cx="12" cy="12" r="10"></circle></svg>Delay</div><div class="ro-el ro-inject-6 relative flex w-max items-center gap-1 rounded-lg border border-slate-200 bg-white px-2 h-6 shadow-md shadow-black/5 text-xs text-slate-600"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-arrow-down-up size-3.5 text-teal-500" aria-hidden="true"><path d="m3 16 4 4 4-4"></path><path d="M7 20V4"></path><path d="m21 8-4-4-4 4"></path><path d="M17 4v16"></path></svg>Scroll</div></div></div><div class="ro-el ro-focus relative flex justify-center mt-3 mx-10"><div class="ro-focus-line absolute bottom-full left-1/2 w-px"></div><div class="relative flex w-max items-center gap-1 rounded-lg border border-rose-200 bg-white px-2 h-7 shadow-md shadow-black/5 text-sm text-slate-700"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-crosshair size-4 text-rose-500" aria-hidden="true"><circle cx="12" cy="12" r="10"></circle><line x1="22" x2="18" y1="12" y2="12"></line><line x1="6" x2="2" y1="12" y2="12"></line><line x1="12" x2="12" y1="6" y2="2"></line><line x1="12" x2="12" y1="22" y2="18"></line></svg>Element Focus</div></div><style>
        .ro-el { opacity: 0; }

        .ro-visible .ro-frame      { animation: ro-fade 0.5s ease-out 0.2s both; }
        .ro-visible .ro-dims       { animation: ro-fade 0.4s ease-out 0.4s both; }
        .ro-visible .ro-device     { animation: ro-fade 0.4s ease-out 0.5s both; }
        .ro-visible .ro-hero-focus { animation: ro-fade 0.4s ease-out 0.7s both; }
        .ro-visible .ro-focus      { animation: ro-fade 0.4s ease-out 0.9s both; }
        .ro-visible .ro-inject-0 { animation: ro-fade 0.4s ease-out 0.5s both; }
        .ro-visible .ro-inject-1 { animation: ro-fade 0.4s ease-out 0.6s both; }
        .ro-visible .ro-inject-2 { animation: ro-fade 0.4s ease-out 0.7s both; }
        .ro-visible .ro-inject-3 { animation: ro-fade 0.4s ease-out 0.8s both; }
        .ro-visible .ro-inject-4 { animation: ro-fade 0.4s ease-out 0.9s both; }
        .ro-visible .ro-inject-5 { animation: ro-fade 0.4s ease-out 1.0s both; }
        .ro-visible .ro-inject-6 { animation: ro-fade 0.4s ease-out 1.1s both; }

        /* Leader lines: inject labels → frame */
        .ro-inject-0::after,
        .ro-inject-1::after,
        .ro-inject-2::after,
        .ro-inject-3::after,
        .ro-inject-4::after,
        .ro-inject-5::after,
        .ro-inject-6::after {
          content: '';
          position: absolute;
          left: 100%;
          top: 50%;
          margin-left: 2px;
          height: 1px;
          width: 20px;
          background: repeating-linear-gradient(to right, #CBD5E1 0, #CBD5E1 3px, transparent 3px, transparent 6px);
        }

        /* Leader line: focus → hero element */
        .ro-focus-line {
          height: 148px;
          background: repeating-linear-gradient(to bottom, #FDA4AF 0, #FDA4AF 3px, transparent 3px, transparent 6px);
        }

        @keyframes ro-fade {
          from { opacity: 0; }
          to   { opacity: 1; }
        }

        @media (prefers-reduced-motion: reduce) {
          .ro-el {
            animation: none !important;
            opacity: 1;
          }
        }
      </style></div></div><div class="flex flex-col px-6 md:px-0 lg:pr-12"><p class="text-xs uppercase text-indigo-600 font-semibold tracking-widest mb-2">Controls</p><h2 class="font-semibold text-slate-800 text-xl sm:text-2xl md:text-3xl max-w-xl">100+ more controls for the perfect screenshot</h2><p class="mt-8 text-balance max-w-xl">Fine-tune device, viewport, element focus, timing, interactivity, and perspective so your screenshots match any specific scenario.</p><div class="mt-8 flex gap-4 flex-wrap"><a class="relative inline-flex shrink-0 items-center justify-center gap-2 whitespace-nowrap font-button font-medium transition-all duration-200 ease-out outline-none focus-visible:ring-2 focus-visible:ring-brand-500 focus-visible:ring-offset-1 active:scale-[0.97] disabled:pointer-events-none disabled:opacity-50 [&amp;_svg]:pointer-events-none [&amp;_svg]:shrink-0 bg-linear-to-br from-indigo-500 to-indigo-600 text-white ring-4 ring-[rgb(22_88_155/0.06)] hover:from-indigo-600 hover:to-indigo-700 dark:ring-slate-800 h-9 rounded-xl px-4 text-base" data-slot="button" href="/features">Discover all features</a><a class="group flex items-center gap-1 text-indigo-600 font-medium" href="/changelog"><span>Latest Changes</span><svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true" data-slot="icon" class="size-4 group-hover:translate-x-1 transition-transform"><path fill-rule="evenodd" d="M2 10a.75.75 0 0 1 .75-.75h12.59l-2.1-1.95a.75.75 0 1 1 1.02-1.1l3.5 3.25a.75.75 0 0 1 0 1.1l-3.5 3.25a.75.75 0 1 1-1.02-1.1l2.1-1.95H2.75A.75.75 0 0 1 2 10Z" clip-rule="evenodd"></path></svg></a></div></div></div></div></section><section id="integrations" class="relative border-t border-slate-200"><div class="relative mx-auto w-full max-w-(--breakpoint-xl) px-4 sm:px-8 lg:px-12 2xl:px-0 pt-16 lg:pt-32"><div class="flex flex-col px-6 md:px-0 lg:pl-12"><p class="text-xs uppercase text-indigo-600 font-semibold tracking-widest mb-2">Integrations</p><h2 class="font-semibold text-slate-800 text-xl sm:text-2xl md:text-3xl max-w-xl">Storage and workflow integrations</h2></div><div class="mt-8 md:mt-16 bg-white border border-slate-200 rounded-2xl"><div class="grid grid-cols-1 md:grid-cols-2"><div class="p-6 lg:p-12 flex flex-col border-b md:border-b-0 md:border-r border-slate-200"><p class="text-xs uppercase text-indigo-600 font-semibold tracking-widest mb-2">Automation</p><h2 class="font-semibold text-slate-800 text-xl sm:text-2xl max-w-xl">Screenshots that run themselves</h2><p class="mt-8 text-balance max-w-xl">Schedule captures daily, weekly, monthly or continuously so your records stay up to date without manual work.</p></div><div class="p-6 lg:p-12 flex flex-col"><p class="text-xs uppercase text-indigo-600 font-semibold tracking-widest mb-2">Archive</p><h2 class="font-semibold text-slate-800 text-xl sm:text-2xl max-w-xl">Your private archive of the web</h2><p class="mt-8 text-balance max-w-xl">Keep months or years of historical screenshots so you can prove exactly what a page looked like at any point in time.</p></div></div><div class="grid grid-cols-1 md:grid-cols-2 border-t border-slate-200"><div class="p-6 lg:p-12 flex flex-col border-b md:border-b-0 md:border-r border-slate-200"><p class="text-xs uppercase text-indigo-600 font-semibold tracking-widest mb-2">Storage</p><h2 class="font-semibold text-slate-800 text-xl sm:text-2xl max-w-xl">Store every screenshot in your own infrastructure</h2><p class="mt-8 text-balance max-w-xl">Send screenshots and their context directly to your cloud storage so sensitive data doesn’t have to live on someone else’s servers.</p><div class="w-full flex flex-wrap items-end mt-8 md:mt-12 gap-x-8 gap-y-4"><img alt="AWS" loading="lazy" width="150" height="100" decoding="async" data-nimg="1" class="h-6 w-auto" style="color:transparent" srcSet="/_next/image?url=%2Fimages%2F2026%2Flogos%2Faws.png&amp;w=256&amp;q=75 1x, /_next/image?url=%2Fimages%2F2026%2Flogos%2Faws.png&amp;w=384&amp;q=75 2x" src="/_next/image?url=%2Fimages%2F2026%2Flogos%2Faws.png&amp;w=384&amp;q=75"/><img alt="Microsoft Azure" loading="lazy" width="468" height="99" decoding="async" data-nimg="1" class="h-7 w-auto" style="color:transparent" srcSet="/_next/image?url=%2Fimages%2F2026%2Flogos%2Fmicrosoft-azure.png&amp;w=640&amp;q=75 1x, /_next/image?url=%2Fimages%2F2026%2Flogos%2Fmicrosoft-azure.png&amp;w=1080&amp;q=75 2x" src="/_next/image?url=%2Fimages%2F2026%2Flogos%2Fmicrosoft-azure.png&amp;w=1080&amp;q=75"/><img alt="Google Cloud" loading="lazy" width="543" height="84" decoding="async" data-nimg="1" class="h-5 w-auto" style="color:transparent" srcSet="/_next/image?url=%2Fimages%2F2026%2Flogos%2Fgoogle-cloud.png&amp;w=640&amp;q=75 1x, /_next/image?url=%2Fimages%2F2026%2Flogos%2Fgoogle-cloud.png&amp;w=1200&amp;q=75 2x" src="/_next/image?url=%2Fimages%2F2026%2Flogos%2Fgoogle-cloud.png&amp;w=1200&amp;q=75"/><img alt="Cloudflare" loading="lazy" width="315" height="120" decoding="async" data-nimg="1" class="h-9 w-auto" style="color:transparent" srcSet="/_next/image?url=%2Fimages%2F2026%2Flogos%2Fcloudflare.png&amp;w=384&amp;q=75 1x, /_next/image?url=%2Fimages%2F2026%2Flogos%2Fcloudflare.png&amp;w=640&amp;q=75 2x" src="/_next/image?url=%2Fimages%2F2026%2Flogos%2Fcloudflare.png&amp;w=640&amp;q=75"/></div></div><div class="p-6 lg:p-12 flex flex-col"><p class="text-xs uppercase text-indigo-600 font-semibold tracking-widest mb-2">Workflows</p><h2 class="font-semibold text-slate-800 text-xl sm:text-2xl max-w-xl">Fit screenshots into your real-world workflows</h2><p class="mt-8 text-balance max-w-xl">Screenshots are rarely the first or last step. Trigger, transform, and route them through the systems you already rely on.</p><div class="w-full flex flex-wrap items-center mt-8 md:mt-13 gap-x-8 gap-y-4"><img alt="Zapier" loading="lazy" width="312" height="84" decoding="async" data-nimg="1" class="h-6 w-auto" style="color:transparent" srcSet="/_next/image?url=%2Fimages%2F2026%2Flogos%2Fzapier.png&amp;w=384&amp;q=75 1x, /_next/image?url=%2Fimages%2F2026%2Flogos%2Fzapier.png&amp;w=640&amp;q=75 2x" src="/_next/image?url=%2Fimages%2F2026%2Flogos%2Fzapier.png&amp;w=640&amp;q=75"/><img alt="n8n" loading="lazy" width="375" height="102" decoding="async" data-nimg="1" class="h-7 w-auto" style="color:transparent" srcSet="/_next/image?url=%2Fimages%2F2026%2Flogos%2Fn8n.png&amp;w=384&amp;q=75 1x, /_next/image?url=%2Fimages%2F2026%2Flogos%2Fn8n.png&amp;w=750&amp;q=75 2x" src="/_next/image?url=%2Fimages%2F2026%2Flogos%2Fn8n.png&amp;w=750&amp;q=75"/></div></div></div><div class="border-t border-slate-200 flex flex-col p-6 py-8 lg:p-12"><p class="text-xs uppercase text-indigo-600 font-semibold tracking-widest mb-2">Artificial Intelligence</p><h2 class="font-semibold text-slate-800 text-xl sm:text-2xl max-w-xl">No screenshot AI unless you choose it</h2><p class="mt-8 text-balance max-w-xl">Core capture, storage, and analysis work without LLMs. Optional AI features are opt-in, clearly labelled, and can run on your own models or keys.</p><div class="mt-8 flex flex-wrap gap-4"><a class="relative inline-flex shrink-0 items-center justify-center gap-2 whitespace-nowrap font-button font-medium transition-all duration-200 ease-out outline-none focus-visible:ring-2 focus-visible:ring-brand-500 focus-visible:ring-offset-1 active:scale-[0.97] disabled:pointer-events-none disabled:opacity-50 [&amp;_svg]:pointer-events-none [&amp;_svg]:shrink-0 bg-linear-to-br from-indigo-500 to-indigo-600 text-white ring-4 ring-[rgb(22_88_155/0.06)] hover:from-indigo-600 hover:to-indigo-700 dark:ring-slate-800 h-9 rounded-xl px-4 text-base" data-slot="button" href="/llm-structured-output"><span class="inline md:hidden">Learn more</span><span class="hidden md:inline">Learn about structured output support</span></a></div><div class="mt-8 md:mt-12 flex items-center gap-y-4 flex-wrap gap-x-8 "><img alt="OpenAI" loading="lazy" width="261" height="72" decoding="async" data-nimg="1" class="h-6 w-auto mt-1" style="color:transparent" srcSet="/_next/image?url=%2Fimages%2F2026%2Flogos%2Fopenai.png&amp;w=384&amp;q=75 1x, /_next/image?url=%2Fimages%2F2026%2Flogos%2Fopenai.png&amp;w=640&amp;q=75 2x" src="/_next/image?url=%2Fimages%2F2026%2Flogos%2Fopenai.png&amp;w=640&amp;q=75"/><img alt="Claude" loading="lazy" width="336" height="72" decoding="async" data-nimg="1" class="h-6 w-auto" style="color:transparent" srcSet="/_next/image?url=%2Fimages%2F2026%2Flogos%2Fclaude.png&amp;w=384&amp;q=75 1x, /_next/image?url=%2Fimages%2F2026%2Flogos%2Fclaude.png&amp;w=750&amp;q=75 2x" src="/_next/image?url=%2Fimages%2F2026%2Flogos%2Fclaude.png&amp;w=750&amp;q=75"/><img alt="Gemini" loading="lazy" width="264" height="96" decoding="async" data-nimg="1" class="h-7 w-auto -mt-2" style="color:transparent" srcSet="/_next/image?url=%2Fimages%2F2026%2Flogos%2Fgemini.png&amp;w=384&amp;q=75 1x, /_next/image?url=%2Fimages%2F2026%2Flogos%2Fgemini.png&amp;w=640&amp;q=75 2x" src="/_next/image?url=%2Fimages%2F2026%2Flogos%2Fgemini.png&amp;w=640&amp;q=75"/><img alt="Mistral" loading="lazy" width="381" height="60" decoding="async" data-nimg="1" class="h-5 w-auto" style="color:transparent" srcSet="/_next/image?url=%2Fimages%2F2026%2Flogos%2Fmistral.png&amp;w=384&amp;q=75 1x, /_next/image?url=%2Fimages%2F2026%2Flogos%2Fmistral.png&amp;w=828&amp;q=75 2x" src="/_next/image?url=%2Fimages%2F2026%2Flogos%2Fmistral.png&amp;w=828&amp;q=75"/><img alt="Deepseek" loading="lazy" width="342" height="72" decoding="async" data-nimg="1" class="h-6 w-auto" style="color:transparent" srcSet="/_next/image?url=%2Fimages%2F2026%2Flogos%2Fdeepseek.png&amp;w=384&amp;q=75 1x, /_next/image?url=%2Fimages%2F2026%2Flogos%2Fdeepseek.png&amp;w=750&amp;q=75 2x" src="/_next/image?url=%2Fimages%2F2026%2Flogos%2Fdeepseek.png&amp;w=750&amp;q=75"/><img alt="Perplexity" loading="lazy" width="303" height="72" decoding="async" data-nimg="1" class="h-7 w-auto" style="color:transparent" srcSet="/_next/image?url=%2Fimages%2F2026%2Flogos%2Fperplexity.png&amp;w=384&amp;q=75 1x, /_next/image?url=%2Fimages%2F2026%2Flogos%2Fperplexity.png&amp;w=640&amp;q=75 2x" src="/_next/image?url=%2Fimages%2F2026%2Flogos%2Fperplexity.png&amp;w=640&amp;q=75"/><img alt="Openrouter" loading="lazy" width="387" height="60" decoding="async" data-nimg="1" class="h-6 w-auto" style="color:transparent" srcSet="/_next/image?url=%2Fimages%2F2026%2Flogos%2Fopenrouter.png&amp;w=640&amp;q=75 1x, /_next/image?url=%2Fimages%2F2026%2Flogos%2Fopenrouter.png&amp;w=828&amp;q=75 2x" src="/_next/image?url=%2Fimages%2F2026%2Flogos%2Fopenrouter.png&amp;w=828&amp;q=75"/></div></div></div></div></section><section id="testimonial" class="relative"><div class="relative overflow-hidden mx-auto w-full max-w-(--breakpoint-xl) px-4 sm:px-8 lg:px-12 2xl:px-0"><div class="absolute h-96 w-16 bg-indigo-500 opacity-50 -top-32 right-1/3 rotate-30 blur-3xl" style="border-radius:50% 50%"></div><div class="absolute h-80 w-4 bg-emerald-500 opacity-75 -top-32 right-1/3 -translate-x-24 rotate-30 blur-3xl" style="border-radius:50% 50%"></div><div class="absolute h-48 w-8 bg-indigo-500 -top-32 right-1/3 translate-x-8 rotate-30 blur-3xl" style="border-radius:50% 50%"></div><div class="absolute w-20 inset-y-0 right-0 bg-linear-to-r from-transparent via-slate-50 to-slate-50"></div><div class="flex flex-col items-center gap-8 py-16 lg:py-32 relative"><figure class="flex flex-col items-center"><blockquote class="max-w-3xl text-center text-slate-800 text-2xl text-balance tracking-tighter"><q class="">When I have a new feature request, I email support and get a response saying it&#x27;s already possible - within minutes.</q></blockquote><figcaption class="relative mt-6 flex items-center gap-3 text-sm md:text-base"><div class="relative size-5 md:size-7 overflow-hidden rounded-full"><img alt="Rutger Tolenaar" loading="lazy" decoding="async" data-nimg="fill" class="object-cover object-center" style="position:absolute;height:100%;width:100%;left:0;top:0;right:0;bottom:0;color:transparent" sizes="(min-width: 768px) 28px, 20px" srcSet="/_next/image?url=%2Ftestimonials%2Frutger.jpg&amp;w=32&amp;q=75 32w, /_next/image?url=%2Ftestimonials%2Frutger.jpg&amp;w=48&amp;q=75 48w, /_next/image?url=%2Ftestimonials%2Frutger.jpg&amp;w=64&amp;q=75 64w, /_next/image?url=%2Ftestimonials%2Frutger.jpg&amp;w=96&amp;q=75 96w, /_next/image?url=%2Ftestimonials%2Frutger.jpg&amp;w=128&amp;q=75 128w, /_next/image?url=%2Ftestimonials%2Frutger.jpg&amp;w=256&amp;q=75 256w, /_next/image?url=%2Ftestimonials%2Frutger.jpg&amp;w=384&amp;q=75 384w, /_next/image?url=%2Ftestimonials%2Frutger.jpg&amp;w=640&amp;q=75 640w, /_next/image?url=%2Ftestimonials%2Frutger.jpg&amp;w=750&amp;q=75 750w, /_next/image?url=%2Ftestimonials%2Frutger.jpg&amp;w=828&amp;q=75 828w, /_next/image?url=%2Ftestimonials%2Frutger.jpg&amp;w=1080&amp;q=75 1080w, /_next/image?url=%2Ftestimonials%2Frutger.jpg&amp;w=1200&amp;q=75 1200w, /_next/image?url=%2Ftestimonials%2Frutger.jpg&amp;w=1920&amp;q=75 1920w, /_next/image?url=%2Ftestimonials%2Frutger.jpg&amp;w=2048&amp;q=75 2048w, /_next/image?url=%2Ftestimonials%2Frutger.jpg&amp;w=3840&amp;q=75 3840w" src="/_next/image?url=%2Ftestimonials%2Frutger.jpg&amp;w=3840&amp;q=75"/></div><p><span class="font-semibold text-slate-800">Rutger Tolenaar</span><span>, <!-- -->Founder ReviewTycoon</span></p></figcaption></figure><a class="relative inline-flex shrink-0 items-center justify-center gap-2 whitespace-nowrap font-button font-medium transition-all duration-200 ease-out outline-none focus-visible:ring-2 focus-visible:ring-brand-500 focus-visible:ring-offset-1 active:scale-[0.97] disabled:pointer-events-none disabled:opacity-50 [&amp;_svg]:pointer-events-none [&amp;_svg]:shrink-0 bg-linear-to-br from-indigo-500 to-indigo-600 text-white ring-4 ring-[rgb(22_88_155/0.06)] hover:from-indigo-600 hover:to-indigo-700 dark:ring-slate-800 h-9 rounded-xl px-4 text-base" data-slot="button" href="/customers"><span>See all customer stories</span><svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true" data-slot="icon" class="size-4"><path fill-rule="evenodd" d="M2 10a.75.75 0 0 1 .75-.75h12.59l-2.1-1.95a.75.75 0 1 1 1.02-1.1l3.5 3.25a.75.75 0 0 1 0 1.1l-3.5 3.25a.75.75 0 1 1-1.02-1.1l2.1-1.95H2.75A.75.75 0 0 1 2 10Z" clip-rule="evenodd"></path></svg></a></div></div></section><section id="geo-stealth" class="relative"><div class="border-t border-slate-200 overflow-hidden"><div class="relative mx-auto w-full max-w-(--breakpoint-xl) px-4 sm:px-8 lg:px-12 2xl:px-0 grid grid-cols-1 lg:grid-cols-2 gap-x-16 gap-y-8 py-16 lg:py-32"><div class="w-full -my-8"><div class="relative mx-auto max-w-md"><canvas class="gs-globe w-full h-auto aspect-square max-w-sm mx-auto" width="800" height="800"></canvas><div class="gs-el gs-pill-0 absolute flex w-max items-center gap-1 rounded-lg border border-slate-200 bg-white px-2 h-7 shadow-md shadow-black/5 text-sm text-slate-700" style="bottom:14%;left:50%;transform:translateX(-50%)"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-map-pin size-4 text-indigo-500" aria-hidden="true"><path d="M20 10c0 4.993-5.539 10.193-7.399 11.799a1 1 0 0 1-1.202 0C9.539 20.193 4 14.993 4 10a8 8 0 0 1 16 0"></path><circle cx="12" cy="10" r="3"></circle></svg><span class="font-semibold text-indigo-600">200+</span>countries</div><div class="gs-el gs-pill-1 absolute flex w-max items-center gap-1 rounded-lg border border-slate-200 bg-white px-2 h-7 shadow-md shadow-black/5 text-sm text-slate-700" style="top:16%;right:8%"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-shield-off size-4 text-rose-500" aria-hidden="true"><path d="m2 2 20 20"></path><path d="M5 5a1 1 0 0 0-1 1v7c0 5 3.5 7.5 7.67 8.94a1 1 0 0 0 .67.01c2.35-.82 4.48-1.97 5.9-3.71"></path><path d="M9.309 3.652A12.252 12.252 0 0 0 11.24 2.28a1.17 1.17 0 0 1 1.52 0C14.51 3.81 17 5 19 5a1 1 0 0 1 1 1v7a9.784 9.784 0 0 1-.08 1.264"></path></svg>Bot detection blocked</div><div class="gs-el gs-pill-2 absolute flex w-max items-center gap-1 rounded-lg border border-slate-200 bg-white px-2 h-7 shadow-md shadow-black/5 text-sm text-slate-700" style="top:16%;left:8%"><svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide size-4 text-emerald-500"><path d="M14 18a2 2 0 0 0-4 0"></path><path d="m19 11-2.11-6.657a2 2 0 0 0-2.752-1.148l-1.276.61A2 2 0 0 1 12 4H8.5a2 2 0 0 0-1.925 1.456L5 11"></path><path d="M2 11h20"></path><circle cx="17" cy="18" r="3"></circle><circle cx="7" cy="18" r="3"></circle></svg>Stealth mode</div><style>
        .gs-globe, .gs-el { opacity: 0; }

        .gs-visible .gs-globe { animation: gs-fade 0.8s ease-out 0.2s both; }
        .gs-visible .gs-pill-0 { animation: gs-fade 0.4s ease-out 0.8s both; }
        .gs-visible .gs-pill-1 { animation: gs-fade 0.4s ease-out 1.0s both; }
        .gs-visible .gs-pill-2 { animation: gs-fade 0.4s ease-out 1.2s both; }

        @keyframes gs-fade {
          from { opacity: 0; }
          to   { opacity: 1; }
        }

        @media (prefers-reduced-motion: reduce) {
          .gs-globe,
          .gs-el {
            animation: none !important;
            opacity: 1;
          }
        }
      </style></div></div><div class="flex flex-col px-6 md:px-0 lg:pr-12"><p class="text-xs uppercase text-indigo-600 font-semibold tracking-widest mb-2">Coverage</p><h2 class="font-semibold text-slate-800 text-xl sm:text-2xl md:text-3xl max-w-xl">Screenshots without getting blocked</h2><p class="mt-8 text-balance max-w-xl">Set the geographic origin of each request and hide automation signals so you avoid blocks, bot detection, and unwanted regional redirects.</p><div class="mt-8 flex gap-4 flex-wrap items-center"><div class="flex gap-3"><div class="flex items-center gap-1 text-sm text-slate-600"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-globe size-4 text-indigo-500" aria-hidden="true"><circle cx="12" cy="12" r="10"></circle><path d="M12 2a14.5 14.5 0 0 0 0 20 14.5 14.5 0 0 0 0-20"></path><path d="M2 12h20"></path></svg>200+ countries</div><div class="flex items-center gap-1 text-sm text-slate-600"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-shield-check size-4 text-emerald-500" aria-hidden="true"><path d="M20 13c0 5-3.5 7.5-7.66 8.95a1 1 0 0 1-.67-.01C7.5 20.5 4 18 4 13V6a1 1 0 0 1 1-1c2 0 4.5-1.2 6.24-2.72a1.17 1.17 0 0 1 1.52 0C14.51 3.81 17 5 19 5a1 1 0 0 1 1 1z"></path><path d="m9 12 2 2 4-4"></path></svg>Stealth</div><div class="flex items-center gap-1 text-sm text-slate-600"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-radar size-4 text-slate-400" aria-hidden="true"><path d="M19.07 4.93A10 10 0 0 0 6.99 3.34"></path><path d="M4 6h.01"></path><path d="M2.29 9.62A10 10 0 1 0 21.31 8.35"></path><path d="M16.24 7.76A6 6 0 1 0 8.23 16.67"></path><path d="M12 18h.01"></path><path d="M17.99 11.66A6 6 0 0 1 15.77 16.67"></path><circle cx="12" cy="12" r="2"></circle><path d="m13.41 10.59 5.66-5.66"></path></svg>Hidden</div></div></div></div></div></div></section><section id="performance" class="relative overflow-hidden border-t border-slate-200"><div class="relative mx-auto w-full max-w-(--breakpoint-xl) px-4 sm:px-8 lg:px-12 2xl:px-0 grid grid-cols-1 lg:grid-cols-2 items-center gap-x-16 gap-y-8 py-16 lg:py-32"><div class="flex flex-col px-6 md:px-0 lg:pl-12"><p class="text-xs uppercase text-indigo-600 font-semibold tracking-widest mb-2">Performance</p><h2 class="font-semibold text-slate-800 text-xl sm:text-2xl md:text-3xl max-w-xl">Fast screenshots when it matters, accurate captures when it counts</h2><p class="mt-8 text-balance max-w-xl">Every capture prioritises correctness by default, but when speed drives growth, we help you tune performance and accuracy to match your product&#x27;s needs.</p><p class="mt-4 text-balance max-w-xl">You only pay for successful renders — so accuracy is in our interest too.</p></div><div class="w-full"><div class="relative mx-auto max-w-lg"><div class="perf-el perf-stats flex items-center justify-center gap-3 mb-6"><div class="flex w-max items-center gap-1 rounded-lg border border-slate-200 bg-white px-2 h-7 shadow-md shadow-black/5 text-sm text-slate-700"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-zap size-4 text-amber-500" aria-hidden="true"><path d="M4 14a1 1 0 0 1-.78-1.63l9.9-10.2a.5.5 0 0 1 .86.46l-1.92 6.02A1 1 0 0 0 13 10h7a1 1 0 0 1 .78 1.63l-9.9 10.2a.5.5 0 0 1-.86-.46l1.92-6.02A1 1 0 0 0 11 14z"></path></svg><span class="font-semibold text-indigo-600">~3s</span>avg render</div><div class="flex w-max items-center gap-1 rounded-lg border border-slate-200 bg-white px-2 h-7 shadow-md shadow-black/5 text-sm text-slate-700"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-circle-check size-4 text-emerald-500" aria-hidden="true"><circle cx="12" cy="12" r="10"></circle><path d="m9 12 2 2 4-4"></path></svg><span class="font-semibold text-indigo-600">99.9%</span>success</div></div><div class="perf-el perf-chart rounded-xl border border-slate-200 bg-white p-4 shadow-lg shadow-black/5"><div class="flex items-center justify-between mb-3 px-1"><div class="flex items-center gap-1 text-xs font-medium text-slate-500"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-activity size-3.5" aria-hidden="true"><path d="M22 12h-2.48a2 2 0 0 0-1.93 1.46l-2.35 8.36a.25.25 0 0 1-.48 0L9.24 2.18a.25.25 0 0 0-.48 0l-2.35 8.36A2 2 0 0 1 4.49 12H2"></path></svg>Request Waterfall</div><div class="text-xs font-mono text-slate-400">0s — <!-- -->2.6<!-- -->s</div></div><div class="relative h-px bg-slate-200 mb-4 mx-1"><div class="absolute -top-1 w-px h-2 bg-slate-300" style="left:0%"></div><div class="absolute -top-1 w-px h-2 bg-slate-300" style="left:25%"></div><div class="absolute -top-1 w-px h-2 bg-slate-300" style="left:50%"></div><div class="absolute -top-1 w-px h-2 bg-slate-300" style="left:75%"></div><div class="absolute -top-1 w-px h-2 bg-slate-300" style="left:100%"></div></div><div class="space-y-2"><div class="perf-el perf-row-0 flex items-center gap-2"><span class="w-14 text-xs text-slate-500 text-right shrink-0">Request</span><div class="flex-1 h-6 relative"><div class="perf-bar perf-bar-0 h-full rounded bg-indigo-400" style="width:9.433962264150944%;margin-left:0%"></div></div></div><div class="perf-el perf-row-1 flex items-center gap-2"><span class="w-14 text-xs text-slate-500 text-right shrink-0">Queue</span><div class="flex-1 h-6 relative"><div class="perf-bar perf-bar-1 h-full rounded bg-slate-300" style="width:6.037735849056603%;margin-left:9.433962264150944%"></div></div></div><div class="perf-el perf-row-2 flex items-center gap-2"><span class="w-14 text-xs text-slate-500 text-right shrink-0">Render</span><div class="flex-1 h-6 relative"><div class="perf-bar perf-bar-2 h-full rounded bg-indigo-500" style="width:63.01886792452831%;margin-left:15.471698113207546%"></div></div></div><div class="perf-el perf-row-3 flex items-center gap-2"><span class="w-14 text-xs text-slate-500 text-right shrink-0">Upload</span><div class="flex-1 h-6 relative"><div class="perf-bar perf-bar-3 h-full rounded bg-indigo-300" style="width:14.33962264150943%;margin-left:78.49056603773586%"></div></div></div><div class="perf-el perf-row-4 flex items-center gap-2"><span class="w-14 text-xs text-slate-500 text-right shrink-0">Deliver</span><div class="flex-1 h-6 relative"><div class="perf-bar perf-bar-4 h-full rounded bg-emerald-400" style="width:7.169811320754715%;margin-left:92.83018867924528%"></div></div></div></div><div class="flex items-center justify-end gap-1 mt-3 px-1"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-timer size-3.5 text-slate-400" aria-hidden="true"><line x1="10" x2="14" y1="2" y2="2"></line><line x1="12" x2="15" y1="14" y2="11"></line><circle cx="12" cy="14" r="8"></circle></svg><span class="text-xs font-mono text-slate-500">Total:<!-- --> <span class="font-semibold text-indigo-600">2.6<!-- -->s</span></span></div></div><div class="perf-el perf-bottom flex items-center justify-center gap-3 mt-6"><div class="flex w-max items-center gap-1 rounded-lg border border-slate-200 bg-white px-2 h-7 shadow-md shadow-black/5 text-sm text-slate-700"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-gauge size-4 text-indigo-500" aria-hidden="true"><path d="m12 14 4-4"></path><path d="M3.34 19a10 10 0 1 1 17.32 0"></path></svg>Tunable speed</div><div class="flex w-max items-center gap-1 rounded-lg border border-slate-200 bg-white px-2 h-7 shadow-md shadow-black/5 text-sm text-slate-700"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-shield-check size-4 text-emerald-500" aria-hidden="true"><path d="M20 13c0 5-3.5 7.5-7.66 8.95a1 1 0 0 1-.67-.01C7.5 20.5 4 18 4 13V6a1 1 0 0 1 1-1c2 0 4.5-1.2 6.24-2.72a1.17 1.17 0 0 1 1.52 0C14.51 3.81 17 5 19 5a1 1 0 0 1 1 1z"></path><path d="m9 12 2 2 4-4"></path></svg>Pay per success</div><div class="flex w-max items-center gap-1 rounded-lg border border-slate-200 bg-white px-2 h-7 shadow-md shadow-black/5 text-sm text-slate-700"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-circle-dot size-4 text-amber-500" aria-hidden="true"><circle cx="12" cy="12" r="10"></circle><circle cx="12" cy="12" r="1"></circle></svg>Accuracy first</div></div><style>
        .perf-el { opacity: 0; }
        .perf-bar {
          transform-origin: left;
          transform: scaleX(0);
        }

        .perf-visible .perf-stats  { animation: perf-fade 0.4s ease-out 0.3s both; }
        .perf-visible .perf-chart  { animation: perf-fade 0.5s ease-out 0.2s both; }
        .perf-visible .perf-bottom { animation: perf-fade 0.4s ease-out 2.71s both; }

        .perf-visible .perf-row-0 { animation: perf-fade 0.4s ease-out 0.40s both; }
        .perf-visible .perf-row-1 { animation: perf-fade 0.4s ease-out 0.50s both; }
        .perf-visible .perf-row-2 { animation: perf-fade 0.4s ease-out 0.60s both; }
        .perf-visible .perf-row-3 { animation: perf-fade 0.4s ease-out 0.70s both; }
        .perf-visible .perf-row-4 { animation: perf-fade 0.4s ease-out 0.80s both; }

        .perf-visible .perf-bar-0 { animation: perf-grow 0.30s ease-out 0.50s both; }
        .perf-visible .perf-bar-1 { animation: perf-grow 0.30s ease-out 0.80s both; }
        .perf-visible .perf-bar-2 { animation: perf-grow 1.01s ease-out 1.10s both; }
        .perf-visible .perf-bar-3 { animation: perf-grow 0.30s ease-out 2.11s both; }
        .perf-visible .perf-bar-4 { animation: perf-grow 0.30s ease-out 2.41s both; }

        @keyframes perf-fade {
          from { opacity: 0; }
          to   { opacity: 1; }
        }

        @keyframes perf-grow {
          from { transform: scaleX(0); }
          to   { transform: scaleX(1); }
        }

        @media (prefers-reduced-motion: reduce) {
          .perf-el,
          .perf-bar {
            animation: none !important;
            opacity: 1;
            transform: scaleX(1);
          }
        }
      </style></div></div></div></section><section id="change-detection" class="relative"><div class="border-t border-slate-200 overflow-hidden"><div class="relative mx-auto w-full max-w-(--breakpoint-xl) px-4 sm:px-8 lg:px-12 2xl:px-0 grid grid-cols-1 lg:grid-cols-2 gap-y-8 gap-x-16 items-start py-16 lg:py-32"><div class="order-2 lg:order-1"><div class="relative"><div class="cd-el cd-frame rounded-xl border border-slate-200 bg-white shadow-lg shadow-black/5 overflow-hidden"><div class="flex items-center gap-2 px-3 py-2 border-b border-slate-100 bg-slate-50/50"><div class="flex items-center gap-1"><div class="size-2 bg-red-400 rounded-full"></div><div class="size-2 bg-amber-400 rounded-full"></div><div class="size-2 bg-green-400 rounded-full"></div></div><span class="text-[11px] font-mono text-slate-500">landing-page.md</span><span class="ml-auto text-[10px] font-mono text-slate-400">diff</span></div><div class="relative font-mono text-[11px] leading-5"><div class="cd-scan pointer-events-none absolute inset-x-0 top-0 h-0.5 bg-indigo-500 z-10"></div><div class="cd-el cd-line-0 flex items-baseline "><span class="w-8 shrink-0 text-right pr-2 text-slate-300 select-none border-r border-slate-100">1</span><span class="w-4 shrink-0 text-center select-none font-bold text-transparent"> </span><span class="pr-3 whitespace-pre text-slate-600"># Welcome to Acme</span></div><div class="cd-el cd-line-1 flex items-baseline "><span class="w-8 shrink-0 text-right pr-2 text-slate-300 select-none border-r border-slate-100">2</span><span class="w-4 shrink-0 text-center select-none font-bold text-transparent"> </span><span class="pr-3 whitespace-pre text-slate-600"> </span></div><div class="cd-el cd-line-2 flex items-baseline "><span class="w-8 shrink-0 text-right pr-2 text-slate-300 select-none border-r border-slate-100">3</span><span class="w-4 shrink-0 text-center select-none font-bold text-transparent"> </span><span class="pr-3 whitespace-pre text-slate-600">Build **modern products** with our</span></div><div class="cd-el cd-line-3 flex items-baseline cd-line-removed bg-red-50"><span class="w-8 shrink-0 text-right pr-2 text-slate-300 select-none border-r border-slate-100">4</span><span class="w-4 shrink-0 text-center select-none font-bold text-red-400">−</span><span class="pr-3 whitespace-pre text-red-700/70">developer-first platform.</span></div><div class="cd-el cd-line-4 flex items-baseline cd-line-added bg-emerald-50"><span class="w-8 shrink-0 text-right pr-2 text-slate-300 select-none border-r border-slate-100">5</span><span class="w-4 shrink-0 text-center select-none font-bold text-emerald-500">+</span><span class="pr-3 whitespace-pre text-emerald-800/80">developer-first API platform.</span></div><div class="cd-el cd-line-5 flex items-baseline "><span class="w-8 shrink-0 text-right pr-2 text-slate-300 select-none border-r border-slate-100">6</span><span class="w-4 shrink-0 text-center select-none font-bold text-transparent"> </span><span class="pr-3 whitespace-pre text-slate-600"> </span></div><div class="cd-el cd-line-6 flex items-baseline "><span class="w-8 shrink-0 text-right pr-2 text-slate-300 select-none border-r border-slate-100">7</span><span class="w-4 shrink-0 text-center select-none font-bold text-transparent"> </span><span class="pr-3 whitespace-pre text-slate-600">## Pricing</span></div><div class="cd-el cd-line-7 flex items-baseline "><span class="w-8 shrink-0 text-right pr-2 text-slate-300 select-none border-r border-slate-100">8</span><span class="w-4 shrink-0 text-center select-none font-bold text-transparent"> </span><span class="pr-3 whitespace-pre text-slate-600"> </span></div><div class="cd-el cd-line-8 flex items-baseline "><span class="w-8 shrink-0 text-right pr-2 text-slate-300 select-none border-r border-slate-100">9</span><span class="w-4 shrink-0 text-center select-none font-bold text-transparent"> </span><span class="pr-3 whitespace-pre text-slate-600">| Plan   | Price     |</span></div><div class="cd-el cd-line-9 flex items-baseline "><span class="w-8 shrink-0 text-right pr-2 text-slate-300 select-none border-r border-slate-100">10</span><span class="w-4 shrink-0 text-center select-none font-bold text-transparent"> </span><span class="pr-3 whitespace-pre text-slate-600">|--------|-----------|</span></div><div class="cd-el cd-line-10 flex items-baseline cd-line-removed bg-red-50"><span class="w-8 shrink-0 text-right pr-2 text-slate-300 select-none border-r border-slate-100">11</span><span class="w-4 shrink-0 text-center select-none font-bold text-red-400">−</span><span class="pr-3 whitespace-pre text-red-700/70">| Pro    | $29/mo    |</span></div><div class="cd-el cd-line-11 flex items-baseline cd-line-added bg-emerald-50"><span class="w-8 shrink-0 text-right pr-2 text-slate-300 select-none border-r border-slate-100">12</span><span class="w-4 shrink-0 text-center select-none font-bold text-emerald-500">+</span><span class="pr-3 whitespace-pre text-emerald-800/80">| Pro    | $39/mo    |</span></div><div class="cd-el cd-line-12 flex items-baseline "><span class="w-8 shrink-0 text-right pr-2 text-slate-300 select-none border-r border-slate-100">13</span><span class="w-4 shrink-0 text-center select-none font-bold text-transparent"> </span><span class="pr-3 whitespace-pre text-slate-600">| Team   | $79/mo    |</span></div><div class="cd-el cd-line-13 flex items-baseline "><span class="w-8 shrink-0 text-right pr-2 text-slate-300 select-none border-r border-slate-100">14</span><span class="w-4 shrink-0 text-center select-none font-bold text-transparent"> </span><span class="pr-3 whitespace-pre text-slate-600"> </span></div><div class="cd-el cd-line-14 flex items-baseline "><span class="w-8 shrink-0 text-right pr-2 text-slate-300 select-none border-r border-slate-100">15</span><span class="w-4 shrink-0 text-center select-none font-bold text-transparent"> </span><span class="pr-3 whitespace-pre text-slate-600">## Get Started</span></div><div class="cd-el cd-line-15 flex items-baseline "><span class="w-8 shrink-0 text-right pr-2 text-slate-300 select-none border-r border-slate-100">16</span><span class="w-4 shrink-0 text-center select-none font-bold text-transparent"> </span><span class="pr-3 whitespace-pre text-slate-600"> </span></div><div class="cd-el cd-line-16 flex items-baseline cd-line-removed bg-red-50"><span class="w-8 shrink-0 text-right pr-2 text-slate-300 select-none border-r border-slate-100">17</span><span class="w-4 shrink-0 text-center select-none font-bold text-red-400">−</span><span class="pr-3 whitespace-pre text-red-700/70">[Sign up free](https://acme.dev)</span></div><div class="cd-el cd-line-17 flex items-baseline cd-line-added bg-emerald-50"><span class="w-8 shrink-0 text-right pr-2 text-slate-300 select-none border-r border-slate-100">18</span><span class="w-4 shrink-0 text-center select-none font-bold text-emerald-500">+</span><span class="pr-3 whitespace-pre text-emerald-800/80">[Start free trial](https://acme.dev)</span></div></div></div><div class="cd-el cd-summary mt-3 flex justify-center"><div class="flex items-center gap-3 rounded-lg border border-slate-200 bg-white px-3 h-7 shadow-md shadow-black/5 text-xs font-medium text-slate-600"><span class="flex items-center gap-1"><span class="size-1.5 rounded-full bg-red-400"></span><span class="text-red-600">3 removed</span></span><span class="w-px h-3 bg-slate-200"></span><span class="flex items-center gap-1"><span class="size-1.5 rounded-full bg-emerald-500"></span><span class="text-emerald-700">3 added</span></span></div></div><style>
        .cd-el { opacity: 0; }
        .cd-scan { opacity: 0; }

        /* Frame fades in */
        .cd-visible .cd-frame { animation: cd-fade 0.5s ease-out 0.2s both; }

        /* Lines appear plain first, then highlights reveal after scan */
        .cd-visible .cd-line-0 { animation: cd-fade 0.2s ease-out 0.30s both; }
        .cd-visible .cd-line-1 { animation: cd-fade 0.2s ease-out 0.36s both; }
        .cd-visible .cd-line-2 { animation: cd-fade 0.2s ease-out 0.42s both; }
        .cd-visible .cd-line-3 { animation: cd-fade 0.2s ease-out 0.48s both; }
        .cd-visible .cd-line-4 { animation: cd-fade 0.2s ease-out 0.54s both; }
        .cd-visible .cd-line-5 { animation: cd-fade 0.2s ease-out 0.60s both; }
        .cd-visible .cd-line-6 { animation: cd-fade 0.2s ease-out 0.66s both; }
        .cd-visible .cd-line-7 { animation: cd-fade 0.2s ease-out 0.72s both; }
        .cd-visible .cd-line-8 { animation: cd-fade 0.2s ease-out 0.78s both; }
        .cd-visible .cd-line-9 { animation: cd-fade 0.2s ease-out 0.84s both; }
        .cd-visible .cd-line-10 { animation: cd-fade 0.2s ease-out 0.90s both; }
        .cd-visible .cd-line-11 { animation: cd-fade 0.2s ease-out 0.96s both; }
        .cd-visible .cd-line-12 { animation: cd-fade 0.2s ease-out 1.02s both; }
        .cd-visible .cd-line-13 { animation: cd-fade 0.2s ease-out 1.08s both; }
        .cd-visible .cd-line-14 { animation: cd-fade 0.2s ease-out 1.14s both; }
        .cd-visible .cd-line-15 { animation: cd-fade 0.2s ease-out 1.20s both; }
        .cd-visible .cd-line-16 { animation: cd-fade 0.2s ease-out 1.26s both; }
        .cd-visible .cd-line-17 { animation: cd-fade 0.2s ease-out 1.32s both; }

        /* Scan sweeps after lines are visible */
        .cd-visible .cd-scan {
          animation: cd-scan-sweep 1.4s ease-in-out 1.78s both;
        }

        /* Diff highlights fade in after scan */
        .cd-visible .cd-line-removed,
        .cd-visible .cd-line-added {
          background: transparent;
          transition: background 0.5s ease-out;
        }

        .cd-visible.cd-scanned .cd-line-removed {
          background: rgb(254 242 242);
        }
        .cd-visible.cd-scanned .cd-line-added {
          background: rgb(236 253 245);
        }

        /* Summary badge after scan */
        .cd-visible .cd-summary {
          animation: cd-fade 0.4s ease-out 3.38s both;
        }

        @keyframes cd-fade {
          from { opacity: 0; }
          to   { opacity: 1; }
        }

        @keyframes cd-scan-sweep {
          0%   { top: 0%; opacity: 0; }
          5%   { opacity: 1; }
          95%  { opacity: 1; }
          100% { top: 100%; opacity: 0; }
        }

        @media (prefers-reduced-motion: reduce) {
          .cd-el, .cd-scan {
            animation: none !important;
            opacity: 1;
          }
          .cd-scan { opacity: 0; }
          .cd-line-removed { background: rgb(254 242 242) !important; }
          .cd-line-added { background: rgb(236 253 245) !important; }
        }
      </style></div></div><div class="flex flex-col px-6 md:px-0 lg:pr-12 lg:pb-16 order-1 lg:order-2"><p class="text-xs uppercase text-indigo-600 font-semibold tracking-widest mb-2">Monitoring</p><h2 class="font-semibold text-slate-800 text-xl sm:text-2xl md:text-3xl max-w-xl">Detect any change, automatically</h2><p class="mt-8 text-balance max-w-xl">Urlbox captures image, text, and metadata together so consecutive renders can be compared on every axis — layout shifts, copy updates, missing elements, or silent changes in the underlying HTML — and flag exactly what changed before your users do.</p></div></div></div></section><section id="scale" class="relative"><div class="border-y border-slate-200"><div class="relative mx-auto w-full max-w-(--breakpoint-xl) px-4 sm:px-8 lg:px-12 2xl:px-0 grid grid-cols-1 lg:grid-cols-2 items-end gap-x-16 gap-y-8 pt-16 lg:pt-32"><img alt="One Million Screenshots" loading="lazy" width="1200" height="500" decoding="async" data-nimg="1" class="order-2 lg:order-1 w-full max-w-xl" style="color:transparent" srcSet="/_next/image?url=%2Fimages%2F2026%2Fonemillionscreenshots.png&amp;w=1200&amp;q=75 1x, /_next/image?url=%2Fimages%2F2026%2Fonemillionscreenshots.png&amp;w=3840&amp;q=75 2x" src="/_next/image?url=%2Fimages%2F2026%2Fonemillionscreenshots.png&amp;w=3840&amp;q=75"/><div class="order-1 lg:order-2 flex flex-col px-6 md:px-0 lg:pr-12 lg:pb-16"><p class="text-xs uppercase text-indigo-600 font-semibold tracking-widest mb-2">Scale</p><h2 class="font-semibold text-slate-800 text-xl sm:text-2xl md:text-3xl max-w-xl">Screenshots at internet scale</h2><p class="mt-8 text-balance max-w-xl">From a few screenshots to millions a month, customers grow on infrastructure proven at billion-capture scale.</p><p class="mt-4 text-balance max-w-xl">See it in action on OneMillionScreenshots.com — a public monthly run that captures the web at real-world scale.</p><a target="_blank" rel="noreferrer noopener" class="mt-8 text-indigo-600 font-medium flex items-center gap-1 group" href="https://onemillionscreenshots.com"><span>OneMillionScreenshots.com</span><svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true" data-slot="icon" class="size-4 group-hover:translate-x-0.5 group-hover:-translate-y-0.5 transition-transform"><path fill-rule="evenodd" d="M5.22 14.78a.75.75 0 0 0 1.06 0l7.22-7.22v5.69a.75.75 0 0 0 1.5 0v-7.5a.75.75 0 0 0-.75-.75h-7.5a.75.75 0 0 0 0 1.5h5.69l-7.22 7.22a.75.75 0 0 0 0 1.06Z" clip-rule="evenodd"></path></svg></a></div></div></div></section><section id="team" class="relative"><div class="relative mx-auto w-full max-w-(--breakpoint-xl) px-4 sm:px-8 lg:px-12 2xl:px-0 pt-16 lg:pt-32"><div class="overflow-hidden bg-white border border-slate-200 rounded-2xl"><div class="flex flex-col p-6 py-8 lg:p-12 border-b border-slate-200 relative"><img alt="UK Flag" loading="lazy" width="800" height="480" decoding="async" data-nimg="1" class="absolute top-0 right-0 opacity-30 h-full w-auto" style="color:transparent" srcSet="/_next/image?url=%2Fimages%2F2026%2Fteam%2Fuk-flag.png&amp;w=828&amp;q=75 1x, /_next/image?url=%2Fimages%2F2026%2Fteam%2Fuk-flag.png&amp;w=1920&amp;q=75 2x" src="/_next/image?url=%2Fimages%2F2026%2Fteam%2Fuk-flag.png&amp;w=1920&amp;q=75"/><p class="text-xs uppercase text-indigo-600 font-semibold tracking-widest mb-2">Team</p><h2 class="font-semibold text-slate-800 text-xl sm:text-2xl md:text-3xl max-w-xl">A real team behind every screenshot</h2><p class="mt-8 text-balance max-w-xl">Four UK-based screenshot engineers, decades of experience, and a shared inbox — when you email support, or book a call, you talk directly to the people who built the platform.</p><div class="mt-8 lg:mt-12 flex flex-wrap gap-y-4 gap-x-12"><div class="flex items-center gap-3 lg:gap-4"><img alt="Arnold Cubici-Jones" loading="lazy" width="100" height="100" decoding="async" data-nimg="1" class="rounded-full size-10 lg:size-12" style="color:transparent" srcSet="/_next/image?url=%2Fimages%2F2026%2Fteam%2Farnold.jpg&amp;w=128&amp;q=75 1x, /_next/image?url=%2Fimages%2F2026%2Fteam%2Farnold.jpg&amp;w=256&amp;q=75 2x" src="/_next/image?url=%2Fimages%2F2026%2Fteam%2Farnold.jpg&amp;w=256&amp;q=75"/><div class="leading-snug text-sm lg:text-base"><p class="font-medium text-slate-800">Arnold Cubici-Jones</p><p>Worcestershire</p></div></div><div class="flex items-center gap-3 lg:gap-4"><img alt="Chris Roebuck" loading="lazy" width="100" height="100" decoding="async" data-nimg="1" class="rounded-full size-10 lg:size-12" style="color:transparent" srcSet="/_next/image?url=%2Fimages%2F2026%2Fteam%2Fchris.jpg&amp;w=128&amp;q=75 1x, /_next/image?url=%2Fimages%2F2026%2Fteam%2Fchris.jpg&amp;w=256&amp;q=75 2x" src="/_next/image?url=%2Fimages%2F2026%2Fteam%2Fchris.jpg&amp;w=256&amp;q=75"/><div class="leading-snug text-sm lg:text-base"><p class="font-medium text-slate-800">Chris Roebuck</p><p>Yorkshire</p></div></div><div class="flex items-center gap-3 lg:gap-4"><img alt="Gus Meneses" loading="lazy" width="100" height="100" decoding="async" data-nimg="1" class="rounded-full size-10 lg:size-12" style="color:transparent" srcSet="/_next/image?url=%2Fimages%2F2026%2Fteam%2Fgus.jpg&amp;w=128&amp;q=75 1x, /_next/image?url=%2Fimages%2F2026%2Fteam%2Fgus.jpg&amp;w=256&amp;q=75 2x" src="/_next/image?url=%2Fimages%2F2026%2Fteam%2Fgus.jpg&amp;w=256&amp;q=75"/><div class="leading-snug text-sm lg:text-base"><p class="font-medium text-slate-800">Gus Meneses</p><p>Oxfordshire</p></div></div><div class="flex items-center gap-3 lg:gap-4"><img alt="Jon Markwell" loading="lazy" width="100" height="100" decoding="async" data-nimg="1" class="rounded-full size-10 lg:size-12" style="color:transparent" srcSet="/_next/image?url=%2Fimages%2F2026%2Fteam%2Fjon.jpg&amp;w=128&amp;q=75 1x, /_next/image?url=%2Fimages%2F2026%2Fteam%2Fjon.jpg&amp;w=256&amp;q=75 2x" src="/_next/image?url=%2Fimages%2F2026%2Fteam%2Fjon.jpg&amp;w=256&amp;q=75"/><div class="leading-snug text-sm lg:text-base"><p class="font-medium text-slate-800">Jon Markwell</p><p>Sussex</p></div></div></div></div><div class="grid grid-cols-1 md:grid-cols-2"><div class="p-6 py-8 lg:p-12 flex flex-col border-b md:border-b-0 md:border-r border-slate-200"><p class="text-xs uppercase text-indigo-600 font-semibold tracking-widest mb-2">Compliance</p><h2 class="font-semibold text-slate-800 text-xl sm:text-2xl md:text-3xl max-w-xl">Built to meet your security and compliance standards</h2><p class="mt-8 text-balance max-w-xl">Every capture is protected by the same product security, network controls, and data-privacy policies you expect from modern SaaS — with SOC 2 Type II, GDPR, and US or EU infrastructure.</p><div class="mt-8 flex flex-wrap items-center gap-y-4 gap-x-8"><div class="flex items-center gap-2"><img alt="EU Flag" loading="lazy" width="120" height="80" decoding="async" data-nimg="1" class="h-5 w-auto rounded" style="color:transparent" srcSet="/_next/image?url=%2Fimages%2F2026%2Feu-flag.png&amp;w=128&amp;q=75 1x, /_next/image?url=%2Fimages%2F2026%2Feu-flag.png&amp;w=256&amp;q=75 2x" src="/_next/image?url=%2Fimages%2F2026%2Feu-flag.png&amp;w=256&amp;q=75"/><img alt="USA Flag" loading="lazy" width="152" height="80" decoding="async" data-nimg="1" class="h-5 w-auto rounded" style="color:transparent" srcSet="/_next/image?url=%2Fimages%2F2026%2Fusa-flag.png&amp;w=256&amp;q=75 1x, /_next/image?url=%2Fimages%2F2026%2Fusa-flag.png&amp;w=384&amp;q=75 2x" src="/_next/image?url=%2Fimages%2F2026%2Fusa-flag.png&amp;w=384&amp;q=75"/></div><div class="flex items-center gap-2"><svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true" data-slot="icon" class="size-4.5"><path fill-rule="evenodd" d="M12.516 2.17a.75.75 0 0 0-1.032 0 11.209 11.209 0 0 1-7.877 3.08.75.75 0 0 0-.722.515A12.74 12.74 0 0 0 2.25 9.75c0 5.942 4.064 10.933 9.563 12.348a.749.749 0 0 0 .374 0c5.499-1.415 9.563-6.406 9.563-12.348 0-1.39-.223-2.73-.635-3.985a.75.75 0 0 0-.722-.516l-.143.001c-2.996 0-5.