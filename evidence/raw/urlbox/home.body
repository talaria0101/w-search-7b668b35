          from { transform: rotate(40deg) translateX(29.25cqi); }
          to   { transform: rotate(400deg) translateX(29.25cqi); }
        }
        @keyframes forensic-counter-0 {
          from { transform: translate(-50%, -50%) rotate(-40deg); }
          to   { transform: translate(-50%, -50%) rotate(-400deg); }
