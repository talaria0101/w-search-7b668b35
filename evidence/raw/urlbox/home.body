\":\"Offer\",\"name\":\"Lo-Fi plan\",\"price\":\"19.00\",\"priceCurrency\":\"USD\",\"availability\":\"https://schema.org/InStock\",\"url\":\"https://urlbox.com/pricing\",\"priceSpecification\":{\"@type\":\"UnitPriceSpecification\",\"price\":\"19.00\",\"priceCurrency\":\"USD\",\"unitText\":\"MONTH\",\"valueAddedTaxIncluded\":false}},{\"@type\":\"Offer\",\"name\":\"Hi-Fi plan\",\"price\":\"49.00\",\"priceCurrency\":\"USD\",\"availability\":\"https://schema.org/InStock\",\"url\":\"https://urlbox.com/pricing\",\"priceSpecification\":{\"@type\":\"UnitPriceSpecification\",\"price\":\"49.00\",\"priceCurrency\":\"USD\",\"unitText\":\"MONTH\",\"valueAddedTaxIncluded\":false}},{\"@type\":\"Offer\",\"name\":\"Ultra plan\",\"price\":\"99.00\",\"priceCurrency\":\"USD\",\"availability\":\"https://schema.org/InStock\",\"url\":\"https://urlbox.com/pricing\",\"priceSpecification\":{\"@type\":\"UnitPriceSpecification\",\"price\":\"99.00\",\"priceCurrency\":\"USD\",\"unitText\":\"MONTH\",\"valueAddedTaxIncluded\":false}},{\"@type\":\"Offer\",\"name\":\"Business plan\",\"price\":\"498.00\",\"priceCurrency\":\"USD\",\"availability\":\"https://schema.org/InStock\",\"url\":\"https://urlbox.com/pricing\",\"priceSpecification\":{\"@type\":\"UnitPriceSpecification\",\"price\":\"498.00\",\"priceCurrency\":\"USD\",\"unitText\":\"MONTH\",\"valueAddedTaxIncluded\":false}},{\"@type\":\"Offer\",\"name\":\"Enterprise plan\",\"price\":\"3000.00\",\"priceCurrency\":\"USD\",\"availability\":\"https://schema.org/InStock\",\"url\":\"https://urlbox.com/pricing\",\"priceSpecification\":{\"@type\":\"UnitPriceSpecification\",\"price\":\"3000.00\",\"priceCurrency\":\"USD\",\"unitText\":\"MONTH\",\"valueAddedTaxIncluded\":false}}]}}]}","announcement":null},"__N_SSG":true},"page":"/","query":{},"buildId":"_U4WoQP02lZlsSZyXFYbP","isFallback":false,"isExperimentalCompile":false,"gsp":true,"scriptLoader":[]}</script></body></html>