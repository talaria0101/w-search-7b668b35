h-96 w-16 bg-indigo-500 opacity-50 -top-32 right-1/3 rotate-30 blur-3xl" style="border-radius:50% 50%"></div><div class="absolute h-80 w-4 bg-emerald-500 opacity-75 -top-32 right-1/3 -translate-x-24 rotate-30 blur-3xl" style="border-radius:50% 50%"></div><div class="absolute h-48 w-8 bg-indigo-500 -top-32 right-1/3 translate-x-8 rotate-30 blur-3xl" style="border-radius:50% 50%"></div><div class="absolute w-20 inset-y-0 right-0 bg-linear-to-r from-transparent via-slate-50 to-slate-50"></div><div class="flex flex-col items-center gap-8 py-16 lg:py-32 relative"><figure class="flex flex-col items-center"><blockquote class="max-w-3xl text-center text-slate-800 text-2xl text-balance tracking-tighter"><q class="">It&#x27;s so evident that Urlbox really cares and pays attention.</q></blockquote><figcaption class="relative mt-6 flex items-center gap-3 text-sm md:text-base"><div class="relative size-5 md:size-7 overflow-hidden rounded-full"><img alt="Mike Schauer" loading="lazy" decoding="async" data-nimg="fill" class="object-cover object-center" style="position:absolute;height:100%;width:100%;left:0;top:0;right:0;bottom:0;color:transparent" sizes="(min-width: 768px) 28px, 20px" srcSet="/_next/image?url=%2Ftestimonials%2Fmike-schauer.jpg&amp;w=32&amp;q=75 32w, /_next/image?url=%2Ftestimonials%2Fmike-schauer.jpg&amp;w=48&amp;q=75 48w, /_next/image?url=%2Ftestimonials%2Fmike-schauer.jpg&amp;w=64&amp;q=75 64w, /_next/image?url=%2Ftestimonials%2Fmike-schauer.jpg&amp;w=96&amp;q=75 96w, /_next/image?url=%2Ftestimonials%2Fmike-schauer.jpg&amp;w=128&amp;q=75 128w, /_next/image?url=%2Ftestimonials%2Fmike-schauer.jpg&amp;w=256&amp;q=75 256w, /_next/image?url=%2Ftestimonials%2Fmike-schauer.jpg&amp;w=384&amp;q=75 384w, /_next/image?url=%2Ftestimonials%2Fmike-schauer.jpg&amp;w=640&amp;q=75 640w, /_next/image?url=%2Ftestimonials%2Fmike-schauer.jpg&amp;w=750&amp;q=75 750w, /_next/image?url=%2Ftestimonials%2Fmike-schauer.jpg&amp;w=828&amp;q=75 828w, /_next/image?url=%2Ftestimonials%2Fmike-schauer.jpg&amp;w=1080&amp;q=75 1080w, /_next/image?url=%2Ftestimonials%2Fmike-schauer.jpg&amp;w=1200&amp;q=75 1200w, /_next/image?url=%2Ftestimonials%2Fmike-schauer.jpg&amp;w=1920&amp;q=75 1920w, /_next/image?url=%2Ftestimonials%2Fmike-schauer.jpg&amp;w=2048&amp;q=75 2048w, /_next/image?url=%2Ftestimonials%2Fmike-schauer.jpg&amp;w=3840&amp;q=75 3840w" src="/_next/image?url=%2Ftestimonials%2Fmike-schauer.jpg&amp;w=3840&amp;q=75"/></div><p><span class="font-semibold text-slate-800">Mike Schauer</span><span>, <!-- -->Founder Swiped.co</span></p></figcaption></figure><a class="relative inline-flex shrink-0 items-center justify-center gap-2 whitespace-nowrap font-button font-medium transition-all duration-200 ease-out outline-none focus-visible:ring-2 focus-visible:ring-brand-500 focus-visible:ring-offset-1 active:scale-[0.97] disabled:pointer-events-none disabled:opacity-50 [&amp;_svg]:pointer-events-none [&amp;_svg]:shrink-0 bg-linear-to-br from-indigo-500 to-indigo-600 text-white ring-4 ring-[rgb(22_88_155/0.06)] hover:from-indigo-600 hover:to-indigo-700 dark:ring-slate-800 h-9 rounded-xl px-4 text-base" data-slot="button" href="/customers"><span>See all customer stories</span><svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true" data-slot="icon" class="size-4"><path fill-rule="evenodd" d="M2 10a.75.75 0 0 1 .75-.75h12.59l-2.1-1.95a.75.75 0 1 1 1.02-1.1l3.5 3.25a.75.75 0 0 1 0 1.1l-3.5 3.25a.75.75 0 1 1-1.02-1.1l2.1-1.95H2.75A.75.75 0 0 1 2 10Z" clip-rule="evenodd"></path></svg></a></div></div></section><section id="full-page-screenshots" class="relative"><div class="border-b border-slate-200 overflow-hidden"><div class="relative mx-auto w-full max-w-(--breakpoint-xl) px-4 sm:px-8 lg:px-12 2xl:px-0 grid grid-cols-1 lg:grid-cols-2 gap-y-8 gap-x-16 items-end pt-16 lg:pt-32"><div class="order-2 lg:order-1"><div class="relative -mb-16"><div class="fp-el fp-frame rounded-xl border border-slate-200 bg-white p-1 shadow-lg shadow-black/5"><div class="flex items-center gap-1 m-1 mb-1.5"><div class="size-2.5 bg-red-400 rounded-full"></div><div class="size-2.5 bg-amber-400 rounded-full"></div><div class="size-2.5 bg-green-400 rounded-full"></div></div><div class="fp-container relative overflow-hidden rounded-lg border border-slate-100"><div class="fp-image-wrapper"><img alt="Full page screenshot of Stripe website" draggable="false" loading="lazy" width="800" height="4133" decoding="async" data-nimg="1" class="w-full h-auto" style="color:transparent" srcSet="/_next/image?url=%2Fimages%2Fscreenshots%2Fstripe-fullpage.jpg&amp;w=828&amp;q=75 1x, /_next/image?url=%2Fimages%2Fscreenshots%2Fstripe-fullpage.jpg&amp;w=1920&amp;q=75 2x" src="/_next/image?url=%2Fimages%2Fscreenshots%2Fstripe-fullpage.jpg&amp;w=1920&amp;q=75"/></div><div class="fp-el fp-viewport pointer-events-none absolute inset-x-0 top-0 border-b-2 border-dashed border-indigo-400/50"></div></div></div><div class="fp-el fp-ruler absolute -right-3 top-8 bottom-0 flex flex-col items-center"><div class="fp-ruler-line relative w-px flex-1 bg-slate-300"><div class="absolute top-0 left-1/2 -translate-x-1/2 w-2 h-px bg-slate-300"></div><div class="absolute bottom-0 left-1/2 -translate-x-1/2 w-2 h-px bg-slate-300"></div></div><div class="fp-el fp-badge mt-2 flex w-max items-center gap-1 rounded-lg border border-indigo-200 bg-white px-2.5 h-7 shadow-md shadow-black/5 text-xs font-medium text-indigo-600 whitespace-nowrap">Full Page</div></div><style>
        .fp-el { opacity: 0; }

        /* Frame fade in */
        .fp-visible .fp-frame { animation: fp-fade 0.5s ease-out 0.2s both; }

        /* Container starts at viewport height, expands */
        .fp-container {
          max-height: 180px;
          transition: max-height 1.2s cubic-bezier(0.4, 0, 0.2, 1);
        }
        .fp-visible .fp-container {
          max-height: 380px;
          transition-delay: 0.6s;
        }

        /* Image scrolls within the container after expansion */
        .fp-image-wrapper {
          transform: translateY(0);
        }
        .fp-visible .fp-image-wrapper {
          animation: fp-scroll 16s ease-in-out 2.1999999999999997s infinite;
        }

        /* Viewport indicator – shows initial crop line, fades during expand */
        .fp-viewport {
          height: 180px;
        }
        .fp-visible .fp-viewport {
          opacity: 1;
          animation: fp-fade 0.4s ease-out 0.4s both, fp-fade-out 0.6s ease-out 0.8s both;
        }

        /* Ruler appears as container expands */
        .fp-visible .fp-ruler { animation: fp-fade 0.6s ease-out 1s both; }
        .fp-visible .fp-badge { animation: fp-fade 0.4s ease-out 1.7999999999999998s both; }

        @keyframes fp-fade {
          from { opacity: 0; }
          to   { opacity: 1; }
        }

        @keyframes fp-fade-out {
          from { opacity: 1; }
          to   { opacity: 0; }
        }

        @keyframes fp-scroll {
          0%, 8%   { transform: translateY(0); }
          42%, 58% { transform: translateY(calc(-100% + 380px)); }
          92%, 100% { transform: translateY(0); }
        }

        @media (prefers-reduced-motion: reduce) {
          .fp-el {
            animation: none !important;
            opacity: 1;
          }
          .fp-container {
            max-height: 380px;
            transition: none;
          }
          .fp-image-wrapper {
            animation: none !important;
            transform: translateY(0);
          }
          .fp-viewport {
            opacity: 0;
          }
        }
      </style></div></div><div class="flex flex-col px-6 md:px-0 lg:pr-12 lg:pb-16 order-1 lg:order-2"><p class="text-xs uppercase text-indigo-600 font-semibold tracking-widest mb-2">Full-page</p><h2 class="font-semibold text-slate-800 text-xl sm:text-2xl md:text-3xl max-w-xl">Capture entire pages, not just the viewport</h2><p class="mt-8 text-balance max-w-xl">Urlbox renders the full scrollable height of any page and delivers it as a single, seamless image. From marketing landing pages to documentation sites to infinite-scroll feeds — get the complete picture every time.</p></div></div></div></section><section id="clean-screenshots" class="relative"><div class="border-y border-slate-200 overflow-hidden"><div class="relative mx-auto w-full max-w-(--breakpoint-xl) px-4 sm:px-8 lg:px-12 2xl:px-0 grid grid-cols-1 lg:grid-cols-2 gap-y-8 gap-x-16 items-end pt-16 lg:pt-32"><div class="flex flex-col px-6 md:px-0 lg:pl-12 lg:pb-16"><p class="text-xs uppercase text-indigo-600 font-semibold tracking-widest mb-2">Clarity</p><h2 class="font-semibold text-slate-800 text-xl sm:text-2xl md:text-3xl max-w-xl">Clean screenshots you can trust</h2><p class="mt-8 text-balance max-w-xl">Automatically remove modals, overlays, cookie banners, ads, and widgets so your screenshots reflect the true state of a page, not a cluttered one-off view.</p></div><div class="relative -mb-16"><div class="rounded-xl border border-slate-200 bg-white p-1 shadow-lg shadow-black/5"><div class="flex items-center gap-1 m-1 mb-1.5"><div class="size-2.5 bg-red-400 rounded-full"></div><div class="size-2.5 bg-amber-400 rounded-full"></div><div class="size-2.5 bg-green-400 rounded-full"></div></div><div class="relative overflow-hidden rounded-lg border border-slate-100"><img alt="Google results covered by a consent pop-up" draggable="false" loading="lazy" width="800" height="689" decoding="async" data-nimg="1" class="w-full h-auto" style="color:transparent" srcSet="/_next/image?url=%2Fimages%2F2026%2Fvisuals%2Fclean-capture-before.jpg&amp;w=828&amp;q=75 1x, /_next/image?url=%2Fimages%2F2026%2Fvisuals%2Fclean-capture-before.jpg&amp;w=1920&amp;q=75 2x" src="/_next/image?url=%2Fimages%2F2026%2Fvisuals%2Fclean-capture-before.jpg&amp;w=1920&amp;q=75"/><div class="scan-reveal absolute inset-x-0 top-0 overflow-hidden"><img alt="The same Google results, clean" draggable="false" loading="lazy" width="800" height="689" decoding="async" data-nimg="1" class="w-full h-auto" style="color:transparent" srcSet="/_next/image?url=%2Fimages%2F2026%2Fvisuals%2Fclean-capture-after.jpg&amp;w=828&amp;q=75 1x, /_next/image?url=%2Fimages%2F2026%2Fvisuals%2Fclean-capture-after.jpg&amp;w=1920&amp;q=75 2x" src="/_next/image?url=%2Fimages%2F2026%2Fvisuals%2Fclean-capture-after.jpg&amp;w=1920&amp;q=75"/><div class="sparkle-shimmer pointer-events-none absolute inset-0"></div></div><div class="scan-glow pointer-events-none absolute left-0 right-0 h-12 -translate-y-full"></div><div class="scan-line pointer-events-none absolute left-0 right-0 h-0.5 bg-indigo-500"></div><div class="scan-handle pointer-events-none absolute left-1/2 -translate-x-1/2 -translate-y-1/2 py-2 px-4 rounded-full border border-slate-200 bg-white shadow-md shadow-black/5"><svg viewBox="0 0 137 32" fill="none" xmlns="http://www.w3.org/2000/svg" class="h-4 fill-current text-black urlbox-logo"><g clip-path="url(#_R_mcf1tm_-clip)"><path d="M64.4582 9.98936V25.374H61.8739V23.1592C60.659 24.8829 59.2267 25.7444 56.8915 25.7444C52.5324 25.7444 51.0684 22.9124 51.0684 19.0977V9.98936H53.8084V19.0977C53.8084 21.5278 54.5251 23.2829 57.3585 23.2829C60.9081 23.2829 61.7799 20.39 61.7799 17.1592V9.98936H64.4582ZM75.3727 9.62007C75.9026 9.62007 76.3995 9.68161 76.8983 9.77391V12.5739C76.3696 12.4508 75.9026 12.3893 75.3415 12.3893C71.8549 12.3893 70.7651 14.7278 70.7651 18.2053V25.3751H68.0861V9.9893H70.6704V12.297C71.6357 10.6047 73.1931 9.62007 75.3727 9.62007ZM79.3562 25.3748V3.8357H82.0962V25.3748H79.3562ZM93.6178 12.7895C90.8467 12.7895 88.9474 