ref\":\"https://www.g2.com/products/scrape-do/reviews\",\"target\":\"_blank\",\"rel\":\"noopener noreferrer\",\"children\":[\"$\",\"img\",null,{\"className\":\"w-32 md:w-42.5 h-auto\",\"src\":\"/images/hero-client-2.svg\",\"alt\":\"G2 Reviews\"}]}]}],[\"$\",\"li\",null,{\"children\":[\"$\",\"a\",null,{\"href\":\"https://www.capterra.com/p/245777/Scrapedo/\",\"target\":\"_blank\",\"rel\":\"noopener noreferrer\",\"children\":[\"$\",\"img\",null,{\"className\":\"w-23.5 md:w-31 h-auto\",\"src\":\"/images/hero-client-3.svg\",\"alt\":\"Capterra Reviews\"}]}]}]]}],[\"$\",\"ul\",null,{\"className\":\"flex items-center justify-center flex-wrap max-sm:gap-x-1 gap-6 lg:gap-8 mt-6 md:mt-8 px-6\",\"children\":[[\"$\",\"li\",null,{\"children\":[\"$\",\"img\",null,{\"src\":\"/images/capterra-most-recommended.svg\",\"alt\":\"scrapedo capterra most recommended\",\"className\":\"w-20.5 md:w-23 h-16 md:h-18\"}]}],[\"$\",\"li\",null,{\"children\":[\"$\",\"img\",null,{\"src\":\"/images/capterra-best-ease-of-use.svg\",\"alt\":\"scrapedo capterra best ease of use\",\"className\":\"w-20.5 md:w-23 h-16 md:h-18\"}]}],[\"$\",\"li\",null,{\"children\":[\"$\",\"img\",null,{\"src\":\"/images/capterra-best-value.png\",\"alt\":\"scrapedo capterra best value\",\"className\":\"w-20.5 md:w-23 h-16 md:h-18\"}]}],[\"$\",\"li\",null,{\"children\":[\"$\",\"img\",null,{\"src\":\"/images/capterra-best-customer-support.svg\",\"alt\":\"capterra best customer support\",\"className\":\"w-20.5 md:w-23 h-16 md:h-18\"}]}],[\"$\",\"li\",null,{\"children\":[\"$\",\"img\",null,{\"src\":\"/images/capterra-front-runners.png\",\"alt\":\"scrapedo capterra front runners\",\"className\":\"w-20.5 md:w-23 h-16 md:h-18\"}]}]]}]]}]}]\n"])</script><script>self.__next_f.push([1,"13e:Tc1b,"])</script><script>self.__next_f.push([1,"{\"@context\":\"https://schema.org\",\"@type\":\"FAQPage\",\"mainEntity\":[{\"@type\":\"Question\",\"name\":\"How do you only charge for successful API calls?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"\\u003cp\u003eYou\u0026#39;re only charged when a request returns a successful response with valid content. You won\u0026#39;t lose credits on timeouts, blocks, or errors. Even if you get a 200 OK response but the response content is not valid, you can reach out to our support to claim your used credits.\\u003c/p\u003e\\n\"}},{\"@type\":\"Question\",\"name\":\"What features are included in the free plan?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"\\u003cp\u003eThe free plan includes 1,000 successful API calls per month with full access to residential and mobile proxies, geo-targeting, CAPTCHA handling, JavaScript rendering, and more—no credit card required.\\u003c/p\u003e\\n\"}},{\"@type\":\"Question\",\"name\":\"Can I cancel anytime?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"\\u003cp\u003eYes, there are no long-term commitments. Cancel, downgrade, or upgrade your plan whenever you need.\\u003c/p\u003e\\n\"}},{\"@type\":\"Question\",\"name\":\"What payment methods do you accept?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"\\u003cp\u003eYou can pay your Scrape.do subscription using credit card, with crypto, or through a bank wire transfer for monthly payments over $500.\\u003c/p\u003e\\n\"}},{\"@type\":\"Question\",\"name\":\"What happens when I use up my monthly credits?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"\\u003cp\u003eWe will contact you when it seems like your credits won\u0026#39;t last for this month, and once you hit your monthly limit, requests will stop unless you upgrade your plan or purchase additional credits.\\u003c/p\u003e\\n\"}},{\"@type\":\"Question\",\"name\":\"Is there a discount for annual billing?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"\\u003cp\u003eYes. Annual billing gives you up to 20% off—pay for 10 months and get 12—on every plan except Enterprise. Hobby is $290/year instead of $29/month, Pro is $990/year instead of $99/month, Business is $2,490/year instead of $249/month, and Advanced is $6,990/year instead of $699/month. This is currently set up manually, so reach out to us via chat or email \\u003ca href=\\\"mailto:support@scrape.do\\\"\u003esupport@scrape.do\\u003c/a\u003e to switch to annual billing.\\u003c/p\u003e\\n\"}},{\"@type\":\"Question\",\"name\":\"Do you offer custom plans for unique scraping needs?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"\\u003cp\u003eYes. Our Custom and Enterprise plans are built around your volume, concurrency, support, and infrastructure needs; tailored specifically for your use case.\\u003c/p\u003e\\n\"}},{\"@type\":\"Question\",\"name\":\"How many requests can you handle?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"\\u003cp\u003eScrape.do processes billions of requests per month and can scale from 10 to 1 billion+ requests, instantly.\\u003c/p\u003e\\n\"}},{\"@type\":\"Question\",\"name\":\"Do I get hands-on support, or just ticket-based help?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"\\u003cp\u003eAll paid plans include real developer support; no bots, no tickets. Business and Enterprise plans also come with a dedicated account manager and priority response.\\u003c/p\u003e\\n\"}}]}"])</script><script>self.__next_f.push([1,"129:[\"$\",\"section\",null,{\"id\":\"faq\",\"className\":\"md:pt-7 pb-20 md:pb-[10.75rem] bg-custom-white-400 rounded-[2rem] md:rounded-[3.5rem] relative -bottom-18\",\"children\":[[\"$\",\"script\",null,{\"type\":\"application/ld+json\",\"dangerouslySetInnerHTML\":{\"__html\":\"$13e\"}}],\"$L13f\"]}]\n"])</script><script>self.__next_f.push([1,"144:I[286534,[\"/_next/static/chunks/149986da54b25f1f.js\",\"/_next/static/chunks/b7f8daa2de0d9ef7.js\",\"/_next/static/chunks/619643f952ad2b36.js\",\"/_next/static/chunks/133c9330b5743987.js\",\"/_next/static/chunks/20b2fd3031a599c8.js\",\"/_next/static/chunks/399ad79afe30e089.js\",\"/_next/static/chunks/406338ad5018d25f.js\",\"/_next/static/chunks/906c0385b0475d7e.js\",\"/_next/static/chunks/