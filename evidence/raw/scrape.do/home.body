h([1,"{\"@context\":\"https://schema.org\",\"@type\":\"FAQPage\",\"mainEntity\":[{\"@type\":\"Question\",\"name\":\"Can I cancel anytime?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"\\u003cp\u003eYes, you can! Simply head to your dashboard to cancel, and you won’t be charged again - unless, of course, you decide to come back!\\u003c/p\u003e\\n\"}},{\"@type\":\"Question\",\"name\":\"Do you have a free trial?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"\\u003cp\u003eYes! Get 1,000 successful API credits with 5 concurrent requests, completely free. Sign up and explore what’s possible with our data harvesting tools, no strings attached.\\u003c/p\u003e\\n\"}},{\"@type\":\"Question\",\"name\":\"Can I get a refund if I'm not satisfied?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"\\u003cp\u003eThough it’s rare, we do offer refunds within the first three days of purchase. Just make sure to review our refunds policy for details.\\u003c/p\u003e\\n\"}},{\"@type\":\"Question\",\"name\":\"Do I need a credit card to start the free trial?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"\\u003cp\u003eNot at all! Our free trial is truly free - no credit card required.\\u003c/p\u003e\\n\"}},{\"@type\":\"Question\",\"name\":\"Do I get charged for the failed requests?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"\\u003cp\u003eAbsolutely not! Only successful requests use up API credits—failed requests won’t be deducted from your balance.\\u003c/p\u003e\\n\"}},{\"@type\":\"Question\",\"name\":\"Can I see my usage data?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"\\u003cp\u003eYes! View your usage data directly on your dashboard page, or access detailed insights with our \\u003ca href=\\\"/documentation/api-response/usage-stats/\\\"\u003eStatistics API\\u003c/a\u003e.\\u003c/p\u003e\\n\"}},{\"@type\":\"Question\",\"name\":\"What is a super proxy?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"\\u003cp\u003eYou can force Scrape.d