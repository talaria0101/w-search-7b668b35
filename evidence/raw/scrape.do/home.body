u0026#39;ve got you covered! Contact us at \u003ca href=\\\"mailto:sales@scrape.do\\\"\u003esales@scrape.do\u003c/a\u003e for a customer service package tailored to your exact needs.\u003c/p\u003e\\n\"},{\"question\":\"Can you create custom scraping scripts for me?\",\"answer\":\"\u003cp\u003eAbsolutely! We offer a fully customizable scraping API to tailor to your needs. Reach out at \u003ca href=\\\"mailto:sales@scrape.do\\\"\u003esales@scrape.do\u003c/a\u003e and let’s talk about what we can do together!\u003c/p\u003e\\n\"},{\"question\":\"I have a technical question\",\"answer\":\"\u003cp\u003eOur extensive documentation covers every technical detail you might need - built to get you up and running without a hitch. But if you need more help, expert developers are available 24/7 at \u003ca href=\\\"mailto:support@scrape.do\\\"\u003esupport@scrape.do\u003c/a\u003e\u003c/p\u003e\\n\"}]}],\"$undefined\"]}]\n"])</script><script>self.__next_f.push([1,":HL[\"/images/hierarchy.svg\",\"image\"]\n:HL[\"/images/trello.svg\",\"image\"]\n:HL[\"/images/competitive-data-lines.png\",\"image\"]\n:HL[\"/images/cart.svg\",\"image\"]\n:HL[\"/images/travel.svg\",\"image\"]\n:HL[\"/images/real-state.svg\",\"image\"]\n:HL[\"/images/marketing.svg\",\"image\"]\nc2:[\"$\",\"div\",null,{\"className\":\"w-8 h-8 overflow-hidden flex items-center justify-center flex-col\",\"children\":[[\"$\",\"img\",null,{\"className\":\"w-8 h-auto translate-y-4 group-hover:-translate-y-4 transition-all duration-300\",\"src\":\"/images/hierarchy.svg\",\"alt\":\"hierarchy\"}],[\"$\",\"img\",null,{\"className\":\"w-8 h-auto translate-y-4 group-hover:-translate-y-4 transition-all duration-300\",\"src\":\"/images/hierarchy.svg\",\"alt\":\"hierarchy\"}]]}]\nc3:[\"$\",\"div\",null,{\"className\":\"text-font-32 font-normal -tracking-[.125rem] md:tracking-tight mt-4.5\",\"children\":\"150 Million\"}]\nc4:[\"$\",\"div\",null,{\"className\":\"space-y-1.5 mt-1\",\"children\":[\"$\",\"p\",null,{\"className\":\"text-font