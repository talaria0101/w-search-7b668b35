}
.home-hero-logo {
  width: 170px;
  height: auto;
  margin-bottom: 22px;
}
.home-hero h1 {
  margin-top: 0;
  font-size: 44px;
  line-height: 1.1;
}
.home-hero-copy p {
  font-size: 18px;
  line-height: 1.55;
}
.home-hero-actions {
  display: flex;
  flex-wrap: wrap;
  gap: 10px;
  margin-top: 24px;
}
.home-hero-screenshot {
