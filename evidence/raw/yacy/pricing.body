  width: 100%;
  height: auto;
  margin: 0 auto 14px auto;
}
.network-picture {
  display: block;
  width: 100%;
  max-width: 1170px;
  height: auto;
  margin: 18px auto 0 auto;
}
@media (max-width: 991px) {
  .home-hero {
    display: block;
    overflow-x: hidden;
  }
  .home-hero-copy {
    margin-bottom: 26px;
  }
  .home-hero h1 {
    font-size: 36px;
    overflow-wrap: anywhere;
  }
  .home-hero-actions {
    display: block;
  }
  .home-hero-actions .btn {
    display: block;
    width: 100%;
    margin: 0;
