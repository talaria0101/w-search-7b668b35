<div class="wp-block-column is-layout-flow wp-block-column-is-layout-flow">
<h2 class="wp-block-traject-heading fluid-2xl text-center has-blue-color has-text-color has-link-color wp-elements-8" style="background-color:transparent;font-weight:700;margin-bottom:0.35em">Flexible Pricing Options</h2><hr class="heading-hr centered" style="--traject-hr-color:var(--wp--preset--color--api-color);margin-bottom:2.5rem"/>



<p class="has-text-align-center wp-block-paragraph">Choose between monthly or annual plans—scalable to fit your needs</p>



<div class="wp-block-traject-pricing-toggle pricing-toggle" style="--toggle-text-color:#101010;--toggle-active-text-color:#101010;--toggle-discount-bg-color:#6FA287;--toggle-discount-text-color:#ffffff;--toggle-active-color:#6FA287;--toggle-inactive-color:#CBCBC9"><span class="toggle-label monthly ">Monthly</span><label class="switch"><input type="checkbox" id="pricingToggle"/><span class="slider"></span></label><span class="toggle-label annual active">Annual</span><span class="discount-badge">-10%</span></div>



<script>
jQuery(document).ready(function($) {

    const $toggle = $('#pricingToggle');
    const $price = $('.25k-card').find('h2.price-label');

    // Hide price immediately on load
    $price.css('visibility', 'hidden');

    function updatePrice() {
        const isAnnual = $toggle.is(':checked');

        if ($price.length) {
            $price.text(isAnnual ? '$50/month' : '$56/month')
                  .css('visibility', 'visible');
        }
    }

    // Run after slight delay to ensure widget logic finishes
    setTimeout(updatePrice, 150);

    $toggle.on('change', function() {
        $price.css('visibility', 'hidden');
        setTimeout(updatePrice, 100);
    });

});

</script>
</div>
</div>



