<script>
  (function($) {
    function createQuizHTML() {
      return `
        <div id="apiQuiz">
          <div id="loading" class="loading hidden">
            <div class="spinner">
              <div class="dot dot1"></div><div class="dot dot2"></div><div class="dot dot3"></div>
              <div class="dot dot4"></div><div class="dot dot5"></div><div class="dot dot6"></div>
              <div class="dot dot7"></div><div class="dot dot8"></div>
            </div>
          </div>
          <form id="quizForm" class="w-full" role="form">
            <div class="steps">
              <span class="step active" data-step="1">1</span>
              <span class="step" data-step="2">2</span>
              <span class="step" data-step="3">3</span>
              <span class="progress-bar"><span></span></span>
            </div>
            <section id="page-1" class="w-full">
              <p class="text-white text-center mb-8">Select Your API Type</p>
              <ul class="results" role="radiogroup" id="apiType">
                <li><input type="radio" name="apiType" id="apiType-ecommerce" value="ecommerce"><label for="apiType-ecommerce"><img src="https://trajectdata.com/wp-content/uploads/2024/09/ecom-icon_03.svg" alt="" width="300" height="300" class="mb-6" /><span>eCommerce</span></label></li><li><input type="radio" name="apiType" id="apiType-serp" value="serp"><label for="apiType-serp"><img src="https://trajectdata.com/wp-content/uploads/2024/09/serp-icon_02.svg" alt="" width="300" height="300" class="mb-6" /><span>SERP</span></label></li>              </ul>
            </section>
            <section id="page-2" class="w-full hidden"></section>
            <section id="page-3" class="w-full hidden"></section>
            <div class="flex justify-between mt-8">
              <button id="back-button" type="button" class="button btn-lightgreen" disabled>Back</button>
              <button id="next-button" type="button" class="button btn-lightgreen">Next</button>
            </div>
          </form>
        </div>
      `;
    }

    $(document).ready(function() {
      var quizOpen = false;
      $('.open-quiz').on('click', function(e) {
        e.preventDefault();
        if (quizOpen) {
          return;
        }
        quizOpen = true;

        // Pass the HTML string to featherlight directly.
        // Do NOT append it to <body> first, or you end up with two #apiQuiz
        // copies (one in the page, one in the popup).
        const quizHTML = createQuizHTML();

        $.featherlight(quizHTML, {
          variant: 'featherlight-quiz',
          persist: false,
          beforeClose: function() {
            resetQuizForm();
          },
          afterClose: function() {
            quizOpen = false;
          }
        });
      });

      // If page loads with url containing #apiQuiz, open the quiz
      if (window.location.hash === '#apiQuiz') {
        $('.open-quiz').trigger('click');
      }

      // Function to reset the quiz form and hide/show relevant sections
      function resetQuizForm() {
        const $quiz = $('#apiQuiz');
        if (!$quiz.length) return;

        // Clear the content of #page-2 and #page-3 and hide them
        $quiz.find('#page-2, #page-3').empty().hide();

        // Uncheck the selection on #page-1
        $quiz.find('#page-1 input[type="radio"]').prop('checked', false);

        // Show #page-1
        $quiz.find('#page-1').show();

        // Set the first step as active
        $quiz.find('.steps .step').removeClass('active completed');
        $quiz.find('.steps .step[data-step="1"]').addClass('active');

        // Reset the progress bar
        $quiz.find('.progress-bar span').css('width', '15%');

        // Disable the back button and enable the next button
        $quiz.find('#back-button').attr('disabled', true);
        $quiz.find('#next-button').attr('disabled', false);
      }

      $(document).on('click', '#apiQuiz #next-button', function() {
        const $quiz = $(this).closest('#apiQuiz');
        var currentStep = $quiz.find('.steps .step.active').data('step');
        if (currentStep === 1) {
          var apiType = $quiz.find('#apiType input:checked').val();
          if (!apiType) {
            alert('Please select an API type.');
            return;
          }
          // Show the loading indicator
          $quiz.find('#loading').removeClass('hidden');

          // Do GTM event for API Quiz Step 1
          dataLayer.push({
            'event': 'apiQuiz',
            'eventCategory': 'API Quiz',
            'eventAction': 'Step 1',
            'eventLabel': apiType
          });

          $.ajax({
            url: 'https://trajectdata.com/wp-admin/admin-ajax.php',
            type: 'POST',
            data: {
              action: 'get_search_engines',
              apiType: apiType
            },
            success: function(response) {
              $quiz.find('#page-2').html(response);
              $quiz.find('#page-1').hide();
              $quiz.find('#page-2').show();

              // Set the second step as active
              $quiz.find('.steps .step').removeClass('active');
              $quiz.find('.steps .step[data-step="1"]').addClass('completed');
              $quiz.find('.steps .step[data-step="2"]').addClass('active');
              currentStep = $quiz.find('.steps .step.active').data('step');
              // Update the progress bar
              $quiz.find('.progress-bar span').css('width', '60%');

              handlePage2($quiz);

              // Enable the back button
              $quiz.find('#back-button').attr('disabled', false);
            },
            complete: function() {
              // Hide the loading indicator when the request is complete
              $quiz.find('#loading').addClass('hidden');
            }
          });
        } else if (currentStep === 2) {
          var selectedValues = [];
          $quiz.find('#page-2 input:checked').each(function() {
            selectedValues.push($(this).val());
          });
          var selectedValue = selectedValues.join(',');

          if (!selectedValue) {
            alert('Please select a value.');
            return;
          }
          // Show the loading indicator
          $quiz.find('#loading').removeClass('hidden');

          // Do GTM event for API Quiz Step 2
          dataLayer.push({
            'event': 'apiQuiz',
            'eventCategory': 'API Quiz',
            'eventAction': 'Step 2',
            'eventLabel': selectedValue
          });

          $.ajax({
            url: 'https://trajectdata.com/wp-admin/admin-ajax.php',
            type: 'POST',
            data: {
              action: 'get_api_results',
              apiType: $quiz.find('#apiType input:checked').val(),
              selectedValue: selectedValue
            },
            success: function(response) {
              // Handle the response from the second AJAX request
              $quiz.find('#page-3').html(response);
              $quiz.find('#page-2').hide();
              $quiz.find('#page-3').show();

              // Set the third step as active
              $quiz.find('.steps .step').removeClass('active');
              $quiz.find('.steps .step[data-step="2"]').addClass('completed');
              $quiz.find('.steps .step[data-step="3"]').addClass('active');
              currentStep = $quiz.find('.steps .step.active').data('step');
              // Update the progress bar
              $quiz.find('.progress-bar span').css('width', '100%');

              // Disable the next button
              $quiz.find('#next-button').attr('disabled', true);
            },
            complete: function() {
              $quiz.find('#apiResults input[type="radio"]').on('change', function() {
                var selectedApi = $(this).val();
                var selectedApiUrl = $(this).data('url');
                var buttonHtml = '<a class="button btn-lightgreen inline-block font-normal" id="apiSelectionButton" target="_blank" href="' + selectedApiUrl + '">View ' + selectedApi + '</a>';
                $quiz.find('.selection-button').html(buttonHtml).hide();
                $quiz.find('.selection-button').fadeIn('slow');
                var suggestedApis = $(this).siblings('.hidden').html();
                $quiz.find('.suggested-apis').html(suggestedApis).hide();
                $quiz.find('.suggested-apis').fadeIn('slow');
                $quiz.find('.steps .step').removeClass('active').addClass('completed');

                // When #apiSelectionButton is clicked, do GTM event for API Quiz Step 3
                $quiz.find('#apiSelectionButton').on('click', function() {
                  dataLayer.push({
                    'event': 'apiQuiz',
                    'eventCategory': 'API Quiz',
                    'eventAction': 'Step 3',
                    'eventLabel': selectedApi
                  });
                });
              });
              // Hide the loading indicator when the request is complete
              $quiz.find('#loading').addClass('hidden');
              // If there is only one result, select it automatically
              if ($quiz.find('#page-3 input[type="radio"]').length === 1) {
                $quiz.find('#page-3 input[type="radio"]').trigger('click').trigger('change');
              }
              // If there are more than two results, make the p.text-center elements the same height
              if ($quiz.find('#page-3 p.text-center').length > 1) {
                var maxHeight = 0;
                $quiz.find('#page-3 p.text-center').each(function() {
                  var height = $(this).height();
                  if (height > maxHeight) {
                    maxHeight = height;
                  }
                });
                $quiz.find('#page-3 p.text-center').height(maxHeight);
              }
            }
          });
        }
        // Animated scroll the quiz box to the top
        $('.featherlight-quiz .featherlight-content').animate({
          scrollTop: 0
        }, 'fast');
        console.log('Next button clicked');
      });

      $(document).on('click', '#apiQuiz #back-button', function() {
        const $quiz = $(this).closest('#apiQuiz');
        var currentStep = $quiz.find('.steps .step.active').data('step');
        if (!currentStep) {
          currentStep = 3;
        }
        // Click the previous step
        $quiz.find('.steps .step[data-step="' + (currentStep - 1) + '"]').trigger('click');
        // Animated scroll the quiz box to the top
        $('.featherlight-quiz .featherlight-content').animate({
          scrollTop: 0
        }, 'fast');
      });

      function handlePage2($quiz) {
        // Make the results li elements the same width
        var maxWidth = 0;
        $quiz.find('#page-2 li').each(function() {
          var width = $(this).width();
          if (width > maxWidth) {
            maxWidth = width;
          }
        });

        $quiz.find('#page-2 li').width(maxWidth);
      }

      // Handle step clicks
      $(document).on('click', '#apiQuiz .steps .step', function() {
        const $quiz = $(this).closest('#apiQuiz');
        var step = $(this).data('step');

        $quiz.find('.steps .step').removeClass('active completed').each(function() {
          if ($(this).data('step') < step) {
            $(this).addClass('completed');
          }
        });

        $(this).addClass('active');
        $quiz.find('#page-1, #page-2, #page-3').hide();
        $quiz.find('#page-' + step).show();

        $quiz.find('.progress-bar span').css('width', function() {
          if (step === 1) return '15%';
          if (step === 2) return '60%';
          if (step === 3) return '100%';
          return '0%';
        });

        // Handle button states
        $quiz.find('#back-button').attr('disabled', step === 1);
        $quiz.find('#next-button').attr('disabled', step === 3);

        // Uncheck all radio buttons
        $quiz.find('#page-' + step + ' input[type="radio"]').prop('checked', false);
      });
    });
  })(jQuery);
</script>

<script type="speculationrules">
{"prefetch":[{"source":"document","where":{"and":[{"href_matches":"/*"},{"not":{"href_matches":["/wp-*.php","/wp-admin/*","/wp-content/uploads/*","/wp-content/*","/wp-content/plugins/*","/wp-content/themes/traject-data/*","/*\\?(.+)"]}},{"not":{"selector_matches":"a[rel~=\"nofollow\"]"}},{"not":{"selector_matches":".no-prefetch, .no-prefetch a"}}]},"eagerness":"conservative"}]}
