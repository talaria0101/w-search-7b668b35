 w-max m-auto ___SButton_waagg_gg_ _size_l_waagg_gg_ _theme_tertiary-invert_waagg_gg_" data-ui-name="Button" type="button" tabindex="0" target="_blank" href="https://www.semrush.com/stats/" data-path="main.stats" data-label="more-semrush-stats" data-ga4-click="true"><span class="_inAfterOutline_false_w9nx7_gg_ ___SBox_w9nx7_gg_ ___SInner_waagg_gg_" data-ui-name="Button.InnerWrapper"><span class="_inAfterOutline_false_w9nx7_gg_ ___SBox_w9nx7_gg_ _size_l_waagg_gg_ ___SText_waagg_gg_" data-ui-name="Button.Text">More Semrush Stats</span><span class="_inAfterOutline_false_w9nx7_gg_ ___SBox_w9nx7_gg_ _size_l_waagg_gg_ ___SAddon_waagg_gg_" data-ui-name="Button.Addon"><svg aria-hidden="true" tabindex="-1" disabled="" class="___SIcon_1ma42_gg_ _inAfterOutline_false_w9nx7_gg_ ___SBox_w9nx7_gg_" data-ui-name="LinkExternal" width="16" height="16" viewBox="0 0 16 16" data-name="LinkExternal" data-group="m"><path d="M14.388 1.079a.998.998 0 0 0-.39-.079H9.75a1.001 1.001 0 1 0 0 2.003h1.83L5.298 9.29a1.001 1.001 0 0 0 1.416 1.416l6.284-6.288v1.83a1.001 1.001 0 1 0 2.003 0V2.002a.997.997 0 0 0-.612-.922Z" shape-rendering="geometricPrecision"></path><path d="M1 5a1 1 0 0 1 1-1h4v2H3v7h7v-3h2v4a1 1 0 0 1-1 1H2a1 1 0 0 1-1-1V5Z" shape-rendering="geometricPrecision"></path></svg></span></span></a></div></section><section aria-labelledby=":r317R0H1:" class="pt-15 px-6 pb-20 md:px-10 2xl:px-23 max-w-[1168px] xl:pb-30"><h2 class="text-[28px]/[36px] font-semibold mb-5" id=":r317R0H1:">API Features</h2><ul class="flex flex-col gap-[42px] xl:flex-row"><li class="flex-1 min-w-0 md:pt-[30px] mt-5 md:mt-0"><div class="w-[60px] h-[60px] mb-5 bg-cover bg-left bg-no-repeat" style="background-image:url(https://static.semrush.com/semrush-developer-api/_astro/API_features_analyze.DcmT32N1.svg)"></div><h3 class="text-500 font-semibold mb-3">Analyze Big Data at lightning speed</h3><p class="text-300/(--lh-500)">Display and analyze only what is relevant to your website’s optimization, instead of spending hours parsing through tons of data.</p></li><li class="flex-1 min-w-0 md:pt-[30px]"><div class="w-[60px] h-[60px] mb-5 bg-cover bg-left bg-no-repeat" style="background-image:url(https://static.semrush.com/semrush-developer-api/_astro/API_features_enhance.BVLcBupD.svg)"></div><h3 class="text-500 font-semibold mb-3">Enhance your own software</h3><p class="text-300/(--lh-500)">Simply integrate our API into your internal application, widget, or dashboard to visualize data your way. For tool with external users, please contact our sales:<!-- --> <a class="_inAfterOutline_false_w9nx7_gg_ ___SBoxInline_w9nx7_gg_ ___SBox_w9nx7_gg_ ___SLink_1xzws_gg_ __noWrapText_1xzws_gg_ __inline_1xzws_gg_ ___SText_xqtf6_gg_" data-ui-name="Link" role="link" tabindex="0" target="_blank" href="mailto:sales@semrush.com" data-path="main.api_features.enhance" data-label="sales_email" data-ga4-click="true"><span class="_inAfterOutline_false_w9nx7_gg_ ___SBox_w9nx7_gg_ ___SText_1xzws_gg_" data-ui-name="Link.Text">sales@semrush.com</span></a></p></li><li class="flex-1 min-w-0 md:pt-[30px]"><div class="w-[60px] h-[60px] mb-5 bg-cover bg-left bg-no-repeat" style="background-image:url(https://static.semrush.com/semrush-developer-api/_astro/API_features_benefit.DUAIBdaB.svg)"></div><h3 class="text-500 font-semibold mb-3">Benefit from valuable data</h3><p class="text-300/(--lh-500)">Analyze competitive strategies in organic and paid search, their display ads, and backlinks. Track any keyword or domain at any location and get daily updates on websites’ position changes.</p></li></ul></section>  </main> <astro-island uid="1xtTzh" prefix="r294" component-url="https://static.semrush.com/semrush-developer-api/_astro/Footer.DKeEKAct.js" component-export="default" renderer-url="https://static.semrush.com/semrush-developer-api/_astro/client.B-YODn_L.js" props="{&quot;className&quot;:[0,&quot;footer astro-cxak7cg3&quot;]}" ssr client="visible" opts="{&quot;name&quot;:&quot;Footer&quot;,&quot;value&quot;:true}