el-set aria-hidden=true><div class="flex items-center gap-2 shrink-0"><iconify-icon icon=tabler:server-2 width=16 height=16 style="color: black"></iconify-icon><span class="text-sm text-black-100/50 md:text-base">Infrastructure security</span></div><div class="flex items-center gap-2 shrink-0"><iconify-icon icon=ci:slider-01 width=16 height=16 style="color: black"></iconify-icon><span class="text-sm text-black-100/50 md:text-base">Access Control</span></div><div class="flex items-center gap-2 shrink-0"><iconify-icon icon=icon-park-outline:data-lock width=16 height=16 style="color: black"></iconify-icon><span class="text-sm text-black-100/50 md:text-base">Data Privacy</span></div><div class="flex items-center gap-2 shrink-0"><iconify-icon icon=iconamoon:shield-yes width=16 height=16 style="color: black"></iconify-icon><span class="text-sm text-black-100/50 md:text-base">Endpoint Security</span></div><div class="flex items-center gap-2 shrink-0"><iconify-icon icon=carbon:gateway-security width=16 height=16 style="color: black"></iconify-icon><span class="text-sm text-black-100/50 md:text-base">Vulnerability Management</span></div><div class="flex items-center gap-2 shrink-0"><iconify-icon icon=clarity:blocks-group-outline-badged width=16 height=16 style="color: black"></iconify-icon><span class="text-sm text-black-100/50 md:text-base">Secure Development</span></div></div></div></div></div></div></section><style>.feature-carousel-mask{-webkit-mask-image:linear-gradient(to right,transparent 0,black 8%,black 92%,transparent 100%);mask-image:linear-gradient(to right,transparent 0,black 8%,black 92%,transparent 100%)}.feature-carousel-track{display:flex;width:max-content;animation:feature-scroll 25s linear infinite;will-change:transform;backface-visibility:hidden}.feature-carousel-set{display:flex;align-items:center;gap:2.5rem;padding-right:2.5rem;flex-shrink:0}@keyframes feature-scroll{from{transform:translate3d(0,0,0)}to{transform:translate3d(-50%,0,0)}}</style><section class="pt-12 sm:pt-20"><div class=container><div class="relative w-full"><div class="relative z-10 grid grid-cols-1 items-stretch rounded-xl bg-yellow-100 lg:grid-cols-2 overflow-hidden"><div class="flex flex-col items-start gap-10 p-10 lg:p-14"><div class="flex flex-col items-start gap-3"><h3 class="text-3xl font-bold text-black-100 md:text-4xl">Ready to get started?</h3><div class="text-sm text-black-100/70 md:text-base">Your web scraping API is just a click away. Start scraping in minutes with 1,000 free API credits. No infrastructure to set up, no proxies to manage, and no credit card required.</div></div><ul class="flex flex-wrap items-center gap-3 lg:gap-10"><li class="flex items-center gap-3"><iconify-icon icon=material-symbols-light:api width=24 height=24 style="color: black"></iconify-icon><span class="text-sm text-black-100/70 md:text-base">Get 1,000 free API Credits</span></li><li class="flex items-center gap-3"><iconify-icon icon=famicons:card-outline width=24 height=24 style="color: black"></iconify-icon><span class="text-sm text-black-100/70 md:text-base">No credit card required</span></li></ul><a href=https://dashboard.scrapingbee.com/account/register class="rounded border border-black-100 bg-black-100 px-6 py-1.5 font-bold text-white transition-colors duration-300 hover:bg-black-100/80">Make your first API request</a></div><div class="flex items-end h-full"><img src=/images/landing/start-web-scraping.svg alt="example of scraping web data with ScrapingBee api" class="w-full object-contain" width=647 height=358 loading=lazy decoding=async draggable=false></div></div><div class="absolute -bottom-2.5 -right-2.5 h-full w-full rounded-xl border-2 border-black-100/20 bg-black-100"></div></div></div></section><section id=pricing class="pt-[100px] md:pt-[180px] pb-[100px]"><div class="container max-w-7xl"><div class="mb-[25px] md:mb-[54px] text-center text-[18px] sm:text-[24px]"><h2 class="text-[36px] sm:text-[48px] md:text-[56px] leading-[1.21] font-bold mb-[5px]">Simple, transparent pricing.</h2><p>Cancel anytime, no questions asked!</p><div class="flex justify-center mt-[28px]"><div class="inline-flex p-[4px] bg-white rounded-full border border-gray-600" role=group aria-label="Plan type"><button type=button data-plan-toggle=standard aria-pressed=true class="px-[24px] py-[8px] text-[16px] leading-[1.25] font-bold rounded-full transition-colors text-black-100 aria-pressed:bg-black-100 aria-pressed:text-white">Standard</button>
<button type=button data-plan-toggle=enterprise aria-pressed=false class="px-[24px] py-[8px] text-[16px] leading-[1.25] font-bold rounded-full transition-colors text-black-100 aria-pressed:bg-black-100 aria-pressed:text-white">Enterprise</button></div></div><script>document.addEventListener("click",function(e){var n,s,t=e.target.closest("[data-plan-toggle]");if(!t)return;n=t.closest("section"),s=t.getAttribute("data-plan-toggle"),n.querySelectorAll("[data-plan-toggle]").forEach(function(e){e.setAttribute("aria-pressed",e===t?"true":"false")}),n.querySelectorAll("[data-plan-view]").forEach(function(e){e.classList.toggle("hidden",e.getAttribute("data-plan-view")!==s)})})</script></div><div class="overflow-auto md:overflow-visible mb-[66px]"><div class="min-w-[1100px] md:min-w-[0] flex flex-wrap"><div class="w-[195px] text-[16px] leading-[1.25] text-gray-200"><div class="h-[150px] border-b relative border-transparent"></div><div class="h-[58px] flex items-center"><span>API Credits</span>
<button class="ml-[10px] text-gray-200" data-microtip-size=medium aria-label="API credits are valid for one month and don't roll over. Requests start at 1 credit each." data-microtip-position=right>
<img class="max-w-none h-[24px] w-[24px]" height=24 width=24 src=/images/icons/icon-info-grey.svg alt="Info icon"></button></div><div class="h-[58px] flex items-center"><span>Concurrent requests</span>
<button class="ml-[10px] text-gray-200" data-microtip-size=medium aria-label="The number of requests that can be sent at the same time." data-microtip-position=right>
