<script>
  window.addEventListener('DOMContentLoaded', function() {
		( function( $ ) {
			if (!Cookies.get('saFirstPage')) {
					Cookies.set('saFirstPage',
											JSON.stringify({
													url: window.location.href,
													visited: new Date()
											}),
											{
													expires: 365 * 100,
													domain: '.scraperapi.com'
											});
					Cookies.set('saReferrer', document.referrer, { expires: 365 * 100, domain: '.scraperapi.com' });
				}
				if (!Cookies.get('fp')) {
									let referralCookie = getReferralParameter();
					if (referralCookie) {
						Cookies.set('fp', referralCookie ,
										{ expires: 365 * 100, domain: '.scraperapi.com' });
					}
      }
		}( jQuery ) );
  });
</script>

