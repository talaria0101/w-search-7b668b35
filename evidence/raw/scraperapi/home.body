<script nowprocket>
	
	( function( $ ) {
 			function signupLinkClicked(event) {
				const href = $(this).attr('href');
				const referralParameter = getReferralParameter();

				if (href && referralParameter) {
					if (href.indexOf('?') === -1) {
						window.location = href + '?fp_ref=' + getReferralParameter();
					} else {
						window.location = href + '&fp_ref=' + getReferralParameter();
					}

					event.preventDefault();
					return false;
				}

				return true;
			}

			window.addEventListener('DOMContentLoaded', function() {
				$('a[href|="https://dashboard.scraperapi.com/signup"]').on('click', signupLinkClicked);
				$('a[href|="https://www.scraperapi.com/signup"]').on('click', signupLinkClicked);
			});	
	}( jQuery ) );
	
	
			
</script>

