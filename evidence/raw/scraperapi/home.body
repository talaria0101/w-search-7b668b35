	function getReferralParameter() {
		for (const referralParam of [ 'fp_ref=', 'fpr=', 'via=' ]) {
			if (window.location.href.indexOf(referralParam) !== -1) {
				return window.location.href.split(referralParam)[1].split('&')[0];
			}
		}
		return null;
	}
</script>

