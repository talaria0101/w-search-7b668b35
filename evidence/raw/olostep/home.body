  <script src="https://d3e54v103j8qbb.cloudfront.net/js/jquery-3.5.1.min.dc5e7f18c8.js?site=6665ee948e0a3f19d93e90c7" type="text/javascript" integrity="sha256-9/aliU8dGd2tb6OSsuzixeV4y/faTqgFtohetphbbj0=" crossorigin="anonymous"></script>
  <script src="js/webflow.js" type="text/javascript"></script><!--  Google Tag Manager (noscript)  -->
  <noscript><iframe src="https://www.googletagmanager.com/ns.html?id=GTM-P7CGSST6" height="0" width="0" style="display: none; visibility: hidden"></iframe></noscript>
  <!--  End Google Tag Manager (noscript)  -->
  <script src="https://cdn.jsdelivr.net/npm/gsap@3.12.5/dist/gsap.min.js"></script>
  <script src="/legacy-js/main.bundle.js"></script>
  <script src="https://cdn.jsdelivr.net/npm/lumious-components@latest/component/ticker.js"></script>
  <!--  Slick Slider JS  -->
  <script type="text/javascript" src="https://cdn.jsdelivr.net/npm/slick-carousel@1.8.1/slick/slick.min.js"></script>
  <script>
window.addEventListener("load", function () {
  gsap.registerPlugin(ScrollTrigger);
  // Find the section containing the cards
  const section = document.querySelector(".layout417_component");
  if (!section) return;
  // List all seven cards in their animation order
  const cards = [
    ".card-1",
    ".card-2",
    ".card-3",
    ".card-4",
    ".card-5",
    ".card-6",
    ".card-7"
  ];
  // Create the scroll-controlled animation
  const tl = gsap.timeline({
    scrollTrigger: {
      trigger: section,
      start: "top top",
      end: "bottom bottom",
      scrub: true
    }
  });
  // Animate each card sequentially
  cards.forEach(function (cardClass) {
    const card = section.querySelector(cardClass);
    if (!card) return;
    tl.to(card, {
      y: "-100vh",
      rotation: -30,
      duration: 1,
      ease: "power2.in"
    });
  });
  // Refresh scroll calculations after the page loads
  ScrollTrigger.refresh();
});
</script>
  <!--  Card Slider Config  -->
  <script>
  document.querySelector('#close-announcement').addEventListener('click', function () {
    document.querySelector('#announcement-banner').remove();
    document.querySelector('#main-section').style.marginTop = '78px';
  });
  $(document).ready(function () {
    //-------- Configure slider ----------
    $('#cms-slider').slick({
      arrows: false,
      infinite: false,
      autoplay: false,
      autoplaySpeed: 8000,
      speed: 300,
      slidesToShow: 3,
      slidesToScroll: 1,
      responsive: [
        {
          breakpoint: 1024,
          settings: {
            slidesToShow: 2,
          },
        },
        {
          breakpoint: 768,
          settings: {
            slidesToShow: 1,
          },
        },
      ],
      variableWidth: true,
    });
    //--------- Set custom nav ---------
    $('#cms-slider-right').click(function () {
      $('#cms-slider').slick('slickNext');
    });
    $('#cms-slider-left').click(function () {
      $('#cms-slider').slick('slickPrev');
    });
    // ---- Hover Arrow visibility logic ----
    function updateSliderArrows() {
      const slick = $('#cms-slider').slick('getSlick');
      if (slick.currentSlide <= 0) {
        $('#cms-slider-left').css('opacity', '0');
        $('#cms-slider-left').css('pointer-events', 'none');
      } else {
        $('#cms-slider-left').css('opacity', '1');
        $('#cms-slider-left').css('pointer-events', 'auto');
      }
      if (slick.currentSlide >= slick.slideCount - slick.options.slidesToShow) {
        $('#cms-slider-right').hide();
      } else {
        $('#cms-slider-right').show();
      }
    }
    // Run on load
    updateSliderArrows();
    // Run after every slide change
    $('#cms-slider').on('afterChange', function () {
      updateSliderArrows();
    });
  });
  (function () {
    const input = document.getElementById('prompt-playground');
    const tabs = document.querySelectorAll('.play-tab');
    const openBtn = document.getElementById('open-playground');
    const form = document.querySelector('.form-block-47 form');
    const submitBtn = document.getElementById('hidden-submit-url');
    const tabConfig = {
      'Tab 1': {
        placeholder: 'https://www.olostep.com/quote',
        param: 'scrape',
        inputKey: 'url',
      },
      'Tab 2': {
        placeholder: "What's the latest book by J.K. Rowling?",
        param: 'answers',
        inputKey: 'text',
      },
      'Tab 3': {
        placeholder: 'https://stripe.com/',
        param: 'map',
        inputKey: 'url',
      },
      'Tab 4': {
        placeholder: 'https://docs.stripe.com/api',
        param: 'crawl',
        inputKey: 'url',
      },
      'Tab 5': {
        placeholder: 'Latest updates with Apple',
        param: 'search',
        inputKey: 'text',
      },
    };
    let currentTab = 'Tab 1'; // Default active tab
    // Update placeholder based on selected tab
    function updatePlaceholder(tabKey) {
      if (tabConfig[tabKey]) {
        input.placeholder = tabConfig[tabKey].placeholder;
        currentTab = tabKey;
      }
    }
    // Build and open playground URL
    function openPlayground() {
      const config = tabConfig[currentTab];
      const typed = input.value.trim();
      const inputValue = typed !== '' ? input.value : config.placeholder;
      const url = `https://www.olostep.com/playground?q=${config.param}&${config.inputKey}=${encodeURIComponent(inputValue)}&auto_start=true`;
      window.location.href = url;
    }
    // Prevent form submission helper
    function preventSubmit(e) {
      e.preventDefault();
      e.stopPropagation();
      e.stopImmediatePropagation();
      openPlayground();
      return false;
    }
    // Add click listeners to tabs
    tabs.forEach((tab) => {
      tab.addEventListener('click', function () {
        const tabKey = this.getAttribute('data-w-tab');
        updatePlaceholder(tabKey);
      });
    });
    // Open playground on button click
    openBtn.addEventListener('click', openPlayground);
    // Handle form submission - multiple approaches to override Webflow
    form.addEventListener('submit', preventSubmit, true);
    // Intercept submit button click
    submitBtn.addEventListener('click', preventSubmit, true);
    // Intercept Enter key on input
    input.addEventListener(
      'keydown',
      function (e) {
        if (e.key === 'Enter') {
          e.preventDefault();
          e.stopPropagation();
          e.stopImmediatePropagation();
          openPlayground();
          return false;
        }
      },
      true,
    );
    // Initialize with current active tab
    const activeTab = document.querySelector('.play-tab.w--current');
    if (activeTab) {
      updatePlaceholder(activeTab.getAttribute('data-w-tab'));
    }
    const typewriterContent = {
      'Tab 1': ['https://olostep.com/quote', 'https://stripe.com', 'https://openai.com'],
      'Tab 2': ["What's the latest AI news?", 'Summarize Tesla earnings', 'Who won the last F1 race?'],
      'Tab 3': ['https://docs.stripe.com/api', 'https://vercel.com/docs', 'https://docs.olostep.com'],
      'Tab 4': ['https://news.ycombinator.com', 'https://github.com/trending', 'https://reddit.com/r/technology'],
      'Tab 5': ['Latest updates with Apple', 'Joint Embedding Predictive Architecture (JEPA) sources', 'Best open-source LLMs in 2026', 'NVIDIA earnings highlights'],
    };
    let currentTextIndex = 0;
    let currentChar = 0;
    let isDeleting = false;
    let typingPaused = false;
    // Pause + clear on input interaction
    function pauseTyping() {
      typingPaused = true;
      input.placeholder = tabConfig[currentTab] ? tabConfig[currentTab].placeholder : '';
    }
    input.addEventListener('focus', pauseTyping);
    input.addEventListener('click', pauseTyping);
    input.addEventListener('keydown', pauseTyping);
    // Restart typing on tab switch
    tabs.forEach((tab) => {
      tab.addEventListener('click', () => {
        currentTab = tab.getAttribute('data-w-tab');
        typingPaused = false;
        currentChar = 0;
        currentTextIndex = 0;
        isDeleting = false;
        input.placeholder = '';
      });
    });
    function typeEffect() {
      const currentTexts = typewriterContent[currentTab];
      if (!currentTexts) {
        setTimeout(typeEffect, 100);
        return;
      }
      const fullText = currentTexts[currentTextIndex];
      if (!typingPaused) {
        if (!isDeleting) {
          input.placeholder = fullText.substring(0, currentChar + 1);
          currentChar++;
          if (currentChar === fullText.length) {
            isDeleting = true;
            setTimeout(typeEffect, 1200);
            return;
          }
        } else {
          input.placeholder = fullText.substring(0, currentChar - 1);
          currentChar--;
          if (currentChar === 0) {
            isDeleting = false;
            currentTextIndex = (currentTextIndex + 1) % currentTexts.length;
          }
        }
      }
      setTimeout(typeEffect, isDeleting ? 30 : 70);
    }
    typeEffect();
    //Developer section copy button functionality
    document.querySelectorAll('.copy-code-btn').forEach((button) => {
      button.addEventListener('click', async function () {
        const currentTabPane = button.closest('.w-tab-pane');
        const activeInnerTab = currentTabPane.querySelector('.w-tab-pane.w--tab-active');
        const codeBlock = activeInnerTab.querySelector('.developer-code');
        // Clone so we don't mutate what's on screen
        const clone = codeBlock.cloneNode(true);
        // Remove any explicit line-number elements if they exist in the DOM
        clone.querySelectorAll('.line-number, .line-num, .ln, .linenumber, [class*="line-number"], [class*="lineNumber"]').forEach((el) => el.remove());
        // Backstop: strip a leading line number from each line
        // (handles cases where numbers are injected as plain text or via inline spans)
        const code = (clone.textContent || clone.innerText)
          .split('\n')
          .map((line) => line.replace(/^\s*\d+\s?/, ''))
          .join('\n')
          .trim();
        try {
          await navigator.clipboard.writeText(code);
          const copyIcon = button.querySelector('.copy-button');
          const tickIcon = button.querySelector('.tick-button');
          copyIcon.style.opacity = '0';
          tickIcon.style.opacity = '1';
          setTimeout(() => {
            copyIcon.style.opacity = '1';
            tickIcon.style.opacity = '0';
          }, 1200);
        } catch (err) {
          console.log('Copy failed');
        }
      });
    });
    // Integrations ticker
    document.addEventListener('DOMContentLoaded', () => {
      const ticker1 = document.querySelector('.integrations-ticker');
      const ticker2 = document.querySelector('.integrations-ticker-2');
      const ticker3 = document.querySelector('.integrations-ticker-3');
      function setupTicker(ticker, reverse = false) {
        if (!ticker) return;
        ticker.innerHTML += ticker.innerHTML;
        gsap.fromTo(
          ticker,
          {
            xPercent: reverse ? -50 : 0,
          },
          {
            xPercent: reverse ? 0 : -50,
            duration: 80,
            ease: 'none',
            repeat: -1,
          },
        );
      }
      setupTicker(ticker1, false);
      setupTicker(ticker2, true);
      setupTicker(ticker3, false);
    });
// Custom cursor
const cursor = document.querySelector('.cursor-wrapper');
const triggers = document.querySelectorAll('.pointer-trigger-wrapper');
let isActive = false;
document.addEventListener('mousemove', (e) => {
  if (!isActive || !cursor) return;
  cursor.style.left = `${e.clientX + 13}px`;
  cursor.style.top = `${e.clientY - 5}px`;
});
triggers.forEach((trigger) => {
  trigger.addEventListener('mouseenter', () => {
    isActive = true;
    cursor.style.opacity = '1';
  });
  trigger.addEventListener('mouseleave', () => {
    isActive = false;
    cursor.style.opacity = '0';
  });
});
// Switching Endpoints
    document.addEventListener('DOMContentLoaded', function () {
      const accordions = document.querySelectorAll('.accordion-items');
      const hiddenTabLinks = document.querySelectorAll('.tab-menu-hidden .w-tab-link');
      accordions.forEach((accordion, index) => {
        accordion.addEventListener('click', function () {
          // REMOVE ACTIVE FROM ALL
          accordions.forEach((item) => {
            item.classList.remove('is-active');
          });
          // ADD ACTIVE TO CURRENT
          accordion.classList.add('is-active');
          // SWITCH TAB
          if (hiddenTabLinks[index]) {
            hiddenTabLinks[index].click();
          }
        });
      });
    });
  })();
</script>
  <style>
  .accordion-icon {
    transition: transform 300ms ease;
  }
  .accordion-items.is-active .accordion-icon {
    visibility: hidden;
  }
</style>
</body>
</html>