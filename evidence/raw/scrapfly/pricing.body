<section class="section-bigger py-5">
  <div class="container">
    <div class="text-center mb-5">
      <small class="text-uppercase text-primary d-inline-block">ESTIMATOR</small>
      <h2 class="h2 mb-2">Price your workload.</h2>
      <p class="lead text-muted">Drag the slider to your expected monthly credit consumption. The plan card on the right updates live.</p>
    </div>

    <div class="card">
      <div class="card-body">
        <div class="row align-items-center" style="row-gap: 32px;">
          <div class="col-lg-7 pricing-estimator-slider">
            <label class="d-block mb-3" for="pricing-slider">// API credits per month</label>
                        <input
              data-action="API Credits"
              data-ticks='[200, 40000, 500000, 2500000, 5000000, 6000000]'
              data-tick-labels='["200", "40k", "500k", "2.5M", "5M", "6M+"]'
              data-action-price="1"
              type="range"
              id="pricing-slider"
              name="pricing-estimation"
              min="0"
              max="5"
              step="1"
              value="2"
              class="pricing-range"
            >
            <div class="pricing-range-labels d-flex justify-content-between mt-2">
              <span data-tick-idx="0">200</span>
              <span data-tick-idx="1">40k</span>
              <span data-tick-idx="2">500k</span>
              <span data-tick-idx="3">2.5M</span>
              <span data-tick-idx="4">5M</span>
              <span data-tick-idx="5">6M+</span>
            </div>

            <div class="pricing-cost-reference mt-5 pt-4" data-cost-reference>
              <small class="text-uppercase text-muted d-block mb-3">// credits per scrape · click to adjust</small>
              <div class="row no-gutters" style="gap: 8px 0;">
                <div class="col-6 col-md-3 pr-2">
                  <button type="button" class="bento-tile pricing-cost-tile pricing-cost-tile--active" data-credits="1" data-addon="0">
                    <strong class="d-block">1</strong>
                    <small class="text-muted d-block mt-1" style="font-size: 9px;">HTTP · datacenter</small>
                  </button>
                </div>
                <div class="col-6 col-md-3 pr-md-2">
                  <button type="button" class="bento-tile pricing-cost-tile" data-credits="5" data-addon="4">
                    <strong class="d-block">5</strong>
                    <small class="text-muted d-block mt-1" style="font-size: 9px;">+ Unblocker / browser</small>
                  </button>
                </div>
                <div class="col-6 col-md-3 pr-2 mt-2 mt-md-0">
                  <button type="button" class="bento-tile pricing-cost-tile" data-credits="25" data-addon="24">
                    <strong class="d-block">25</strong>
                    <small class="text-muted d-block mt-1" style="font-size: 9px;">+ residential</small>
                  </button>
                </div>
                <div class="col-6 col-md-3 mt-2 mt-md-0">
                  <button type="button" class="bento-tile pricing-cost-tile" data-credits="60" data-addon="59">
                    <strong class="d-block">60</strong>
                    <small class="text-muted d-block mt-1" style="font-size: 9px;">screenshot</small>
                  </button>
                </div>
              </div>

              <input type="checkbox" class="custom-control-input d-none" id="cost_tile_5"  data-addon="4">
              <input type="checkbox" class="custom-control-input d-none" id="cost_tile_25" data-addon="24">
              <input type="checkbox" class="custom-control-input d-none" id="cost_tile_60" data-addon="59">
            </div>

            <script>
            (function () {
              var root = document.querySelector('[data-cost-reference]');
              if (!root) return;
              var tiles = root.querySelectorAll('.pricing-cost-tile');
              var hidden = {
                5:  root.querySelector('#cost_tile_5'),
                25: root.querySelector('#cost_tile_25'),
                60: root.querySelector('#cost_tile_60')
              };

              tiles.forEach(function (tile) {
                tile.addEventListener('click', function () {
                  tiles.forEach(function (t) { t.classList.remove('pricing-cost-tile--active'); });
                  tile.classList.add('pricing-cost-tile--active');

                  var credits = parseInt(tile.getAttribute('data-credits'), 10);

                  Object.keys(hidden).forEach(function (k) {
                    var cb = hidden[k];
                    if (!cb) return;
                    if (cb.checked) {
                      cb.checked = false;
                      cb.dispatchEvent(new Event('change', {bubbles: true}));
                    }
                  });

                  if (credits > 1 && hidden[credits]) {
                    hidden[credits].checked = true;
                    hidden[credits].dispatchEvent(new Event('change', {bubbles: true}));
                  }
                });
              });
            })();
            </script>

            <script>
            // Enterprise ceiling driver: when slider sits at max (6M+), swap
            // the pricing card for a "Talk to Sales" panel. Slider now uses
            // tick INDICES (0..5) — index 5 is the explicit 6M+ stop, beyond
            // the highest paid plan (5.5M at Enterprise).
            (function () {
              var slider = document.getElementById('pricing-slider');
              var grid   = document.getElementById('pricing-container');
              var ceil   = document.getElementById('pricing-enterprise-ceiling');
              if (!slider || !grid || !ceil) return;

              var ENTERPRISE_TICK_INDEX = 5;

              function applyState() {
                var idx = parseInt(slider.value, 10);
                if (isNaN(idx)) return;
                if (idx >= ENTERPRISE_TICK_INDEX) {
                  grid.classList.add('d-none');
                  ceil.classList.remove('d-none');
                } else {
                  grid.classList.remove('d-none');
                  ceil.classList.add('d-none');
                }
              }

              slider.addEventListener('input', applyState);
              slider.addEventListener('change', applyState);
              setTimeout(applyState, 0);
            })();
            </script>
          </div>

          <div class="col-lg-5">
            <div class="pricing-estimator-result">
              <div id="pricing-container"></div>

                            <div id="pricing-enterprise-ceiling" class="pricing-enterprise-ceiling d-none">
                <small class="text-uppercase text-primary d-block">// CUSTOM &middot; 6M+ CREDITS / MO</small>
                <strong class="pricing-ceiling-title d-block">You're past the self-serve ceiling.</strong>
                <p class="pricing-ceiling-lead">
                  At this volume the effective per-credit rate keeps dropping. Custom contracts at Scrapfly start at <strong>$1.2k/mo</strong> and scale to <strong>$30k+/mo</strong> &mdash; same API, same compliance, dedicated infrastructure.
                </p>

                <ul class="pricing-ceiling-stack">
                  <li><i class="fa-solid fa-bolt text-primary mr-2"></i><strong>Committed concurrency</strong> &mdash; reserved capacity on dedicated workers, no shared throttle.</li>
                  <li><i class="fa-solid fa-server text-primary mr-2"></i><strong>Dedicated residential pools</strong> &mdash; isolated IP space, sized to your geography mix.</li>
                  <li><i class="fa-solid fa-file-signature text-primary mr-2"></i><strong>MSA, DPA, BAA &amp; HIPAA</strong> &mdash; SOC 2 Type II + ISO 27001 + GDPR, ready for procurement.</li>
                  <li><i class="fa-solid fa-headset text-primary mr-2"></i><strong>Premium 24/7 support</strong> &mdash; named engineer, Slack channel, SLA on response.</li>
                </ul>

                <a class="btn btn-primary btn-block pricing-ceiling-cta"
                   href="mailto:sales@scrapfly.io?subject=Enterprise%20Plan%20Request%20(from%20estimator)"
                    data-on="click" data-event-category="pricing_estimator_sales_cta" data-event-action="click" >
                  Talk to Sales
                </a>
                <small class="d-block text-center text-muted pricing-ceiling-foot">
                  Typical first-contract close in under 7 days. No annual lock-in required.
                </small>
              </div>

              <small class="d-block text-muted mt-3">
                On Pro and up, overflow auto-switches to pay-as-you-go and the integration never stalls. Discovery caps on quota.
              </small>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

