                                                                            <pre class="m-0 cli-terminal-pane d-none"
                     data-cli-pane-for="pricing-asp-ts"
                     style="background:transparent;padding:16px;overflow-x:auto;"><code class="hljs typescript">import { 
    ScrapflyClient, ScrapeConfig 
} from &#039;jsr:@scrapfly/scrapfly-sdk&#039;;

const client = new ScrapflyClient({ key: &quot;API KEY&quot; });
let api_result = await client.scrape(
    new ScrapeConfig({
        url: &#039;https://httpbin.dev/html&#039;,
        // enable the Scrapfly Unblocker
        unblocker: true,
    })
);
console.log(api_result.result);</code></pre>
                                                                            <pre class="m-0 cli-terminal-pane d-none"
                     data-cli-pane-for="pricing-asp-go"
                     style="background:transparent;padding:16px;overflow-x:auto;"><code class="hljs go">package main

import (
	&quot;fmt&quot;
	&quot;github.com/scrapfly/go-scrapfly&quot;
)

func main() {
	client, _ := scrapfly.New(&quot;API KEY&quot;)
	result, _ := client.Scrape(&amp;scrapfly.ScrapeConfig{
		URL: &quot;https://httpbin.dev/html&quot;,
		// enable the Scrapfly Unblocker
		Unblocker: scrapfly.BoolPtr(true),
	})
	fmt.Println(result.Result.Content)
}</code></pre>
                                                                            <pre class="m-0 cli-terminal-pane d-none"
                     data-cli-pane-for="pricing-asp-rs"
                     style="background:transparent;padding:16px;overflow-x:auto;"><code class="hljs rust">use scrapfly_sdk::{Client, ScrapeConfig};

#[tokio::main]
async fn main() -&gt; Result&lt;(), Box&lt;dyn std::error::Error&gt;&gt; {
    let client = Client::builder().api_key(&quot;API KEY&quot;).build()?;

    let cfg = ScrapeConfig::builder(&quot;https://httpbin.dev/html&quot;)
        // enable the Scrapfly Unblocker
        .unblocker(true)
        .build()?;

    let result = client.scrape(&amp;cfg).await?;
    println!(&quot;{}&quot;, result.result.content);
    Ok(())
}</code></pre>
                    </div>
