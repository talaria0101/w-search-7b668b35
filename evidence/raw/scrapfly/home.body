<script>
(function() {
  // Wire every .feature-frame on the page independently.
  document.querySelectorAll('[data-feature-frame]').forEach(function(frame) {
    var items = frame.querySelectorAll('[data-feature-index]');
    var panes = frame.querySelectorAll('[data-feature-pane]');
    if (!items.length || !panes.length) return;

    function activate(idx) {
      items.forEach(function(item) {
        var match = item.getAttribute('data-feature-index') === String(idx);
        item.classList.toggle('feature-frame__item--selected', match);
        item.setAttribute('aria-selected', match ? 'true' : 'false');
      });
      panes.forEach(function(pane) {
        var match = pane.getAttribute('data-feature-pane') === String(idx);
        pane.classList.toggle('feature-frame__pane--active', match);
      });
    }

    items.forEach(function(item) {
      item.addEventListener('click', function() {
        activate(item.getAttribute('data-feature-index'));
      });
      item.addEventListener('keydown', function(e) {
        if (e.key === 'Enter' || e.key === ' ') {
          e.preventDefault();
          activate(item.getAttribute('data-feature-index'));
        }
      });
    });
  });
})();
</script>
