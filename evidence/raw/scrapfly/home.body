<script async defer src="https://cdn.scrapfly.io/static/fp/l.js?version=0.1.2435" data-key="MFkwEwYHKoZIzj0CAQYIKoZIzj0DAQcDQgAEXhnwGjm29RPoxvkqvzpXJQLAF9lt7jOvswaUDMYpJEVYRTb51+owAlZAl/8A19DtyJThVaLw5QjlUILQxeV5RQ==" data-probe-endpoint="https://tools.scrapfly.io" ></script>


            <script defer src="https://accounts.google.com/gsi/client" onerror="window.__fedcmUnavailable=true"></script>
    <script>
        window.addEventListener('load', () => {
            if (window.__fedcmUnavailable) return;
            if (typeof google === 'undefined' || !google.accounts || !google.accounts.id) return;
            try {
                google.accounts.id.initialize({
                    client_id: "503124556247-fnk5ch1q8t9lhpgtb9ggqdr37k0bnoa6.apps.googleusercontent.com",
                    callback: (resp) => {
                        if (!resp || !resp.credential) return;
                        const tz = (() => { try { return Intl.DateTimeFormat().resolvedOptions().timeZone || ''; } catch (e) { return ''; } })();
                        fetch("https:\/\/scrapfly.io\/auth\/google\/fedcm", {
                            method: 'POST',
                            credentials: 'include',
                            headers: { 'Content-Type': 'application/json' },
                            body: JSON.stringify({ credential: resp.credential, tz: tz }),
                        }).then(r => r.json()).then(data => {
                            if (data && data.redirect_url) {
                                window.location.href = data.redirect_url;
                            }
                        }).catch(() => {});
                    },
                    use_fedcm_for_prompt: true,
                    auto_select: false,
                    context: 'signup',
                    ux_mode: 'popup',
                });
                google.accounts.id.prompt((notification) => {
                    if (!notification) return;
                    if (typeof notification.isNotDisplayed === 'function' && notification.isNotDisplayed()) return;
                    if (typeof notification.isSkippedMoment === 'function' && notification.isSkippedMoment()) return;
                    if (typeof notification.isDismissedMoment === 'function' && notification.isDismissedMoment()) return;
                });
            } catch (_) {
            }
        });
    </script>
