<section class="api-playground padding-horizontal" id="tryDemo">
    <div class="max-w-screen-1xl mx-auto min-[1441px]:pb-20 xl:pb-[75px] lg:pb-16 md:pb-14 pb-12">
        <div class="flex flex-col items-center justify-center">
            <h2 class=" text-primary-dark text-center sub-title">API Playground</h2>
            <p class="content-medium text-secondary max-w-[1007px] text-center 2xl:mt-5 mt-3.5">
                SERPHouse effortlessly powers your SEO apps and services. Try our
                complete and easy to use API
            </p>
        </div>
        <div class="mt-10 min-h-[830px] h-full w-full rounded-[40px] border-[1px] border-[#DDDDDD] bg-[#FFFFFF] shadow-[0_0_20px_0_#00000026]"
            id="content-container">
            <form method="POST" action="#" id="searchFormStatic" class="lg:px-10 sm:px-5 px-2.5">
                <input type="hidden" name="_token" value="OuIiVZtHaExsozsyzIQa2ZKnblnZB2pT9HwbiGrp" autocomplete="off">                <input type="hidden" name="f_type" value="frontend">
                <input type="hidden" name="data[page]" value="1">
                <input type="hidden" name="data[device]" value="desktop">
                <input type="hidden" name="data[serp_type]" value="web">
                <input type="hidden" name="data[verbatim]" value="0">
                <div class="grid lg:grid-cols-4 min-[500px]:grid-cols-2 xl:gap-5 lg:gap-2.5 gap-5 pt-10 ">
                    <input type="text" name="data[q]" required placeholder="Search Query" value="ChatGPT"
                        class="form-control text-secondary w-full rounded-[10px] border-[1px] border-[#DDDDDD] py-[7px] pl-[15px] focus:outline-none" />
                    <select name="data[domain]" id="domainStatic"
                        class="w-full  text-secondary rounded-[10px] border-[1px] border-[#DDDDDD] bg-white py-[7px] pl-[15px] focus:outline-none ">
                        <option value="google.com" selected>google.com</option>
                    </select>
                    <select name="data[loc]" id="locationStatic" required class="w-full text-secondary pl-[15px] bg-white">
                        <option value="Abernathy,Texas,United States" selected>Abernathy,Texas,United States</option>
                    </select>
                    <select name="data[lang]" id="languageStatic" required
                        class="w-full text-secondary rounded-[10px] border-[1px] border-[#DDDDDD] bg-white py-[7px] pl-[15px] focus:outline-none  ">
                        <option value="en" selected>English</option>
                    </select>
                </div>
                <div
                    class="mt-3 min-[701px]:mt-5 flex lg:gap-x-10 gap-x-8 gap-y-3 justify-center sm:flex-nowrap flex-wrap">
                    <div class="g-recaptcha" data-sitekey="6LdzRL8UAAAAAN7vHXDQD8I7PFehkKLsRYzlC4ip">
                    </div>
                    <button type="submit" id="searchStatic" disabled
                        class="bg-primary max-h-[54px] minor-subheading  font-medium h-full py-3 max-w-52 w-full self-center  text-white rounded-full">Processing...</button>
                </div>
            </form>
            <div
                class="min-h-[685px] lg:mx-10 lg:mb-10 mb-5 sm:mt-10 mt-8 sm:mx-5 rounded-[40px] shadow-[-1px_0_10px_-2px_#00000024] loader-container">
                <div class="custom-container z-20 relative  max-h-[685px] rounded-[26px]">
                    <div class="slide-container">
                        <div id="iframe-content" class="slide-before slider-section ">
                            <iframe loading="lazy" name="api-playground-frame" title="API Playground Content"
                                id="iframe-block-static" class="min-h-[685px] "
                                style="-webkit-transform: scale(0.5); -webkit-transform-origin: 0 0; width: 200%; height: 200%;"></iframe>
                        </div>
                        <div class="code-container ser-code-toolbar slider-section min-h-[685px] min-w-[50%]  mostly-customized-scrollbar"
                            role="region" aria-labelledby="code-block-label">
                            <div class="code-toolbar">
                                <pre style="margin-top: 0 !important; margin-left: var(--position) !important;"
                                    id="api-code-block" class="mostly-customized-scrollbar  h-full min-h-[685px] image-after overflow-auto"
                                    aria-live="polite" aria-atomic="true">

                                        <code class="language-json copy-code" id="code-block-static" tabindex="0">
                                            
