                <script>
$(document).ready(function () {
    // Select2 setup
    $('#domainStatic').select2({
        placeholder: "Select a Domain",
        minimumInputLength: 1,
        language: {
            inputTooShort: function () {
                return 'Please enter 1 or more characters';
            },
        },
        ajax: {
            url: '/serp/domains',
            method: 'GET',
            dataType: 'json',
            data: function (params) {
                return {
                    term: params.term,
                    f_type: 'dropdown'
                };
            },
            processResults: function (data) {
                let domains = [];
                let items = data.result || data;
                let list = [];
                if (Array.isArray(items)) {
                    list = items;
                } else if (typeof items === 'object') {
                    list = Object.keys(items).map(k => items[k]);
                }
                $.each(list, function (key, value) {
                    domains.push({
                        'id': value,
                        'text': value
                    });
                });
                return {
                    'results': domains
                };
            }
        }
    });

    $('#locationStatic').select2({
        placeholder: "Select a Location",
        minimumInputLength: 2,
        language: {
            inputTooShort: function () {
                return 'Please enter 2 or more characters';
            }
        },
        ajax: {
            url: '/serp/locations',
            method: 'GET',
            dataType: 'json',
            data: function (params) {
                let domainText = $("#domainStatic option:selected").text().trim();
                return {
                    term: params.term,
                    f_type: 'dropdown',
                    type: domainText.includes('bing') ? 'bing' : ''
                };
            },
            processResults: function (response) {
                let location = [];
                let items = response.data || response;
                if (Array.isArray(items)) {
                    $.each(items, function (key, value) {
                        location.push({
                            'id': value.loc || value.id,
                            'text': value.loc || value.name || value.text
                        });
                    });
                }
                return {
                    'results': location
                };
            }
        }
    });

    $('#languageStatic').select2({
        placeholder: "Select a Language",
        minimumInputLength: 1,
        language: {
            inputTooShort: function () {
                return 'Please enter 1 or more characters';
            }
        },
        ajax: {
            url: '/serp/language',
            method: 'GET',
            data: function (params) {
                return {
                    term: params.term,
                    f_type: 'dropdown',
                    domain: $("#domainStatic option:selected").text().trim()
                };
            },
            dataType: 'json',
            processResults: function (data) {
                let language = [];
                let items = data.result || data;
                if (items) {
                    $.each(items, function (key, value) {
                        language.push({
                            'id': key,
                            'text': value
                        });
                    });
                }
                return {
                    'results': language
                };
            }
        }
    });

    $('#domainStatic').on('change', function (e) {
        e.stopPropagation();
        
        let langSelect = $('#languageStatic');
        let currentLangVal = langSelect.val();
        let domain = $(this).val();

        $.get('/serp/language', { term: '', f_type: 'dropdown', domain: domain }, function(data) {
            let items = data.result || data;
            if (currentLangVal && items && items[currentLangVal]) {
                let label = items[currentLangVal];
                let newOption = new Option(label, currentLangVal, true, true);
                langSelect.empty().append(newOption).trigger('change');
            } else {
                langSelect.empty().val(null).trigger('change');
            }
        }).fail(function() {
            langSelect.empty().val(null).trigger('change');
        });
    });

    $('#searchFormStatic').on('submit', function (e) {
        e.preventDefault();
        
        if (grecaptcha.getResponse() === "") {
            alert("Captcha is required.");
            return;
        }

        $('.loader-container').addClass('loading');

        let submitButton = $('#searchStatic');
        submitButton.attr("disabled", "disabled");
        submitButton.text('Processing...');
        $.ajaxSetup({
            headers: {
                'X-CSRF-TOKEN': $('meta[name="csrf-token"]').attr('content')
            }
        });

        let formData = $('#searchFormStatic').serialize();

        $.ajax({
            url: '/serp/search',
            data: formData,
            type: 'POST',
            success: function (response) {
                let iframe = $("#iframe-block-static").contents().find('body');
                if (response.status == true) {
                    let htmlData = response.data.html;
                    let jsonData = response.data.json;

                    $('#code-block-static').text(JSON.stringify(jsonData, null, 2));

                    if (htmlData) {
                        $('#iframe-block-static').removeAttr('src');
                        $('#iframe-block-static').attr('srcdoc', htmlData);
                    } else {
                        $('#iframe-block-static').removeAttr('src');
                        $('#iframe-block-static').removeAttr('srcdoc');
                    }
                } else {
                    $('#iframe-block-static').removeAttr('src');
                    $('#iframe-block-static').removeAttr('srcdoc');
                    $('#code-block-static').text(JSON.stringify(response, null, 4));
                }
                submitButton.text('Search');
                submitButton.removeAttr("disabled");
                Prism.highlightElement(document.querySelector('#code-block-static'));
                $('.loader-container').removeClass('loading');
                if (typeof grecaptcha !== 'undefined') {
                    grecaptcha.reset();
                }
            },
            error: function (xhr) {
                $('.loader-container').removeClass('loading');
                submitButton.text('Search');
                submitButton.removeAttr("disabled");
            }
        });
    });

    setTimeout(() => {
        $('.loader-container').removeClass('loading');
        const apiPlayGroundIframe = document.getElementById('iframe-block-static');
        if (apiPlayGroundIframe) {
            apiPlayGroundIframe.src = '/data/chatgpt.html';
        }

        const codeBlock = document.getElementById('code-block-static');
        if (codeBlock) {
            fetch('/data/chatgpt.json')
            .then(response => response.json())
            .then(data => {
                if (codeBlock) {
                    codeBlock.textContent = JSON.stringify(data, null, 2);
                    Prism.highlightElement(codeBlock);
                }
                let submitButton = $('#searchStatic');
                if (submitButton.length) {
                    submitButton.text('Search');
                    submitButton.removeAttr("disabled");
                }
            })
            .catch(error => {
                console.error('Error loading code block content:', error);
                codeBlock.textContent = "Error loading content.";
                let submitButton = $('#searchStatic');
                if (submitButton.length) {
                    submitButton.text('Search');
                    submitButton.removeAttr("disabled");
                }
            });
        }
    }, 5000);
});
</script>
</body>

</html>
