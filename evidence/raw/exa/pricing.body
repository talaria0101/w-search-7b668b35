0 0 1-2 2h-2"></path><path d="M10 6h4"></path><path d="M10 10h4"></path><path d="M10 14h4"></path><path d="M10 18h4"></path></svg><span class="flex-1 text-[1.02rem] font-medium">Company search</span><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-chevron-right h-[18px] w-[18px] flex-shrink-0 transition-opacity [transition-duration:140ms] opacity-0"><path d="m9 18 6-6-6-6"></path></svg></button></div><div class="min-w-0"><div class="relative rounded-[10px] bg-white p-5 shadow-[0_10px_20px_rgba(15,23,42,0.1)] outline outline-1 outline-[rgba(0,0,0,0.05)] md:p-6 xl:p-6"><div class="grid gap-5 xl:grid-cols-[minmax(0,1.08fr)_340px] xl:gap-7"><div class="flex min-w-0 flex-col p-1 md:pt-4"><div><h3 class="m-0 font-serif text-[1.8rem] font-normal text-black md:text-[2.05rem]">Coding agents</h3><p class="m-0 mt-3.5 max-w-[34rem] text-[0.94rem] leading-[1.35] text-[#6B6B6B] md:text-[0.98rem] md:[text-wrap:balance]">Search over millions of GitHub repos, docs, and Stack Overflow with high-accuracy code retrieval.</p></div><ul class="m-0 mt-4 list-disc space-y-1.5 pl-6 text-[0.94rem] leading-[1.35] text-[#5F5F5F] md:text-[0.98rem]"><li>Search docs, repos, and changelogs in real time</li><li>Use sub-200ms search options inside latency-sensitive agent loops</li><li>Ground code generation with current package and API references</li></ul><div class="mt-6 flex flex-wrap gap-2.5"><span class="rounded-[3px] bg-[#F5F5F3] px-2.5 py-1.5 font-mono text-[0.82rem] text-[#5F5F5F]">Docs Search</span><span class="rounded-[3px] bg-[#F5F5F3] px-2.5 py-1.5 font-mono text-[0.82rem] text-[#5F5F5F]">Repo Search</span><span class="rounded-[3px] bg-[#F5F5F3] px-2.5 py-1.5 font-mono text-[0.82rem] text-[#5F5F5F]">Changelog Lookup</span></div><div class="mt-auto pt-8"><div class="rounded-[12px] bg-[#FAFAF8] px-5 py-5"><div class="flex flex-col gap-3 md:flex-row md:items-end md:justify-between"><p class="m-0 text-[1.05rem] font-medium text-black md:whitespace-nowrap md:text-[1.2rem]">Exa Search</p><div class="flex items-baseline gap-2.5 md:justify-end"><span class="text-[1.7rem] font-medium leading-none tracking-[-0.04em] text-black">From $4</span><span class="text-[0.95rem] text-[#6B6B6B]">/1k requests</span></div></div></div><a href="https://dashboard.exa.ai/playground/search" target="_blank" rel="noopener noreferrer" class="mt-5 inline-flex w-full items-center justify-center rounded-[6px] bg-[#09111A] px-6 py-2.5 text-[0.95rem] font-medium text-white transition-opacity [transition-duration:140ms] hover:opacity-90">Try Search for Free</a></div></div><div class="flex min-h-[390px] flex-col overflow-hidden rounded-md border border-[rgba(215,217,222,0.7)] bg-[#FAFAFA]"><div class="relative h-[290px] overflow-hidden"><img src="https://exa.imgix.net/blueabstract2.avif" alt="Cursor story background" class="h-full w-full object-cover"/><div class="absolute inset-0" style="background:linear-gradient(to bottom, transparent 20%, rgba(0,0,0,0.35) 50%, transparent 80%)"></div><div class="absolute inset-0 flex items-center justify-center p-7"><img src="/images/testimonial/cursor_monochrome.svg" alt="Cursor logo" class="h-10 w-auto object-contain [filter:brightness(0)_invert(1)]"/></div></div><div class="flex flex-1 flex-col py-7 pl-6 pr-7"><p class="m-0 text-[0.88rem] text-[#7B7B7B]">Customer Stories</p><h4 class="m-0 mt-4 text-[1.08rem] font-normal leading-[1.08] text-black md:text-[1.25rem]">Cursor uses Exa to get the latest docs for more accurate code</h4><p class="m-0 mt-3.5 text-[0.9rem] leading-[1.4] text-[#6B6B6B]">Coding agents use Exa for low latency search across millions of repos.</p></div></div></div></div></div></div></section><section id="endpoint-pricing" class="flex w-full scroll-mt-24 flex-col gap-6 py-8 md:scroll-mt-32 md:gap-8 md:py-12"><div class="flex flex-col gap-2"><h2 class="m-0 font-serif text-[1.75rem] font-normal text-black md:text-[2.35rem]">Endpoint pricing</h2></div><div class="w-full overflow-x-auto"><table class="w-full min-w-[980px] table-fixed border-collapse border border-gray-200 bg-white"><thead><tr><th class="w-[18rem] border-b border-gray-200 bg-[#F5F4F1] px-4 py-1.5 text-right text-[0.88rem] font-normal text-transparent">Endpoint</th><th class="w-[7.5rem] border-b border-l border-gray-200 bg-[#F5F4F1] px-5 py-1.5 text-right text-[0.92rem] font-medium text-black md:text-[1rem]">Instant Search</th><th class="w-[7.5rem] border-b border-l border-gray-200 bg-[#F5F4F1] px-5 py-1.5 text-right text-[0.92rem] font-medium text-black md:text-[1rem]">Fast / Auto Search</th><th class="w-[8.5rem] border-b border-l border-gray-200 bg-[#F5F4F1] px-5 py-1.5 text-right text-[0.92rem] font-medium text-black md:text-[1rem]">Deep Search</th><th class="w-[12.75rem] border-b border-l border-gray-200 bg-[#F5F4F1] px-5 py-1.5 text-right text-[0.92rem] font-medium text-black md:text-[1rem]"><span class="whitespace-nowrap">Deep-Reasoning Search</span></th><th class="w-[7.5rem] border-b border-l border-gray-200 bg-[#F5F4F1] px-5 py-1.5 text-right text-[0.92rem] font-medium text-black md:text-[1rem]">Contents</th><th class="w-[7.5rem] border-b border-l border-gray-200 bg-[#F5F4F1] px-5 py-1.5 text-right text-[0.92rem] font-medium text-black md:text-[1rem]">Monitors</th><th class="w-[7.5rem] border-b border-l border-gray-200 bg-[#F5F4F1] px-5 py-1.5 text-right text-[0.92rem] font-medium text-black md:text-[1rem]">Answer</th></tr></thead><tbody><tr><th scope="row" class="px-4 py-2.5 text-left text-[0.92rem] font-normal text-[#6B6B6B] md:text-[0.96rem] border-b border-gray-200">Base price, with up to 10 results<span class="block text-[0.88em] text-[#8A8A8A]">(per 1k requests)</span></th><td class=" border-l border-gray-200 px-5 py-2.5 text-right text-[0.92rem] font-normal text-black md:text-[0.96rem] border-b border-gray-200">$4</td><td class=" border-l border-gray-200 px-5 py-2.5 text-right text-[0.92rem] font-normal text-black md:text-[0.96rem] border-b border-gray-200">$7</td><td class=" border-l border-gray-200 px-5 py-2.5 text-right text-[0.92rem] font-normal text-black md:text-[0.96rem] border-b border-gray-200">$12</td><td class=" border-l border-gray-200 px-5 py-2.5 text-right text-[0.92rem] font-normal text-black md:text-[0.96rem] border-b border-gray-200">$15</td><td class="relative border-l border-gray-200 px-5 py-2.5 text-right text-[0.92rem] font-normal text-black md:text-[0.96rem] border-b border-gray-200"><span>$1</span><span class="absolute bottom-1.5 right-5 whitespace-nowrap text-[0.72rem] text-[#8A8A8A]">(per 1k pages)</span></td><td class=" border-l border-gray-200 px-5 py-2.5 text-right text-[0.92rem] font-normal text-black md:text-[0.96rem] border-b border-gray-200">$15</td><td class=" border-l border-gray-200 px-5 py-2.5 text-right text-[0.92rem] font-normal text-black md:text-[0.96rem] border-b border-gray-200">$5</td></tr><tr><th scope="row" class="px-4 py-2.5 text-left text-[0.92rem] font-normal text-[#6B6B6B] md:text-[0.96rem] border-b border-gray-200">Cost per additional result above 10<span class="block text-[0.88em] text-[#8A8A8A]">(per 1k requests)</span></th><td class=" border-l border-gray-200 px-5 py-2.5 text-right text-[0.92rem] font-normal text-black md:text-[0.96rem] border-b border-gray-200">$1</td><td class=" border-l border-gray-200 px-5 py-2.5 text-right text-[0.92rem] font-normal text-black md:text-[0.96rem] border-b border-gray-200">$1</td><td class=" border-l border-gray-200 px-5 py-2.5 text-right text-[0.92rem] font-normal text-black md:text-[0.96rem] border-b border-gray-200">$1</td><td class=" border-l border-gray-200 px-5 py-2.5 text-right text-[0.92rem] font-normal text-black md:text-[0.96rem] border-b border-gray-200">$1</td><td class=" border-l border-gray-200 px-5 py-2.5 text-right text-[0.92rem] font-normal text-black md:text-[0.96rem] border-b border-gray-200">-</td><td class=" border-l border-gray-200 px-5 py-2.5 text-right text-[0.92rem] font-normal text-black md:text-[0.96rem] border-b border-gray-200">$1</td><td class=" border-l border-gray-200 px-5 py-2.5 text-right text-[0.92rem] font-normal text-black md:text-[0.96rem] border-b border-gray-200">-</td></tr><tr><th scope="row" class="px-4 py-2.5 text-left text-[0.92rem] font-normal text-[#6B6B6B] md:text-[0.96rem] ">AI page summaries<span class="block text-[0.88em] text-[#8A8A8A]">(per 1k pages)</span></th><td class=" border-l border-gray-200 px-5 py-2.5 text-right text-[0.92rem] font-normal text-black md:text-[0.96rem] ">$1</td><td class=" border-l border-gray-200 px-5 py-2.5 text-right text-[0.92rem] font-normal text-black md:text-[0.96rem] ">$1</td><td class=" border-l border-gray-200 px-5 py-2.5 text-right text-[0.92rem] font-normal text-black md:text-[0.96rem] ">$1</td><td class=" border-l border-gray-200 px-5 py-2.5 text-right text-[0.92rem] font-normal text-black md:text-[0.96rem] ">$1</td><td class=" border-l border-gray-200 px-5 py-2.5 text-right text-[0.92rem] font-normal text-black md:text-[0.96rem] ">$1</td><td class=" border-l border-gray-200 px-5 py-2.5 text-right text-[0.92rem] font-normal text-black md:text-[0.96rem] ">$1</td><td class=" border-l border-gray-200 px-5 py-2.5 text-right text-[0.92rem] font-normal text-black md:text-[0.96rem] ">-</td></tr></tbody></table></div><div class="mt-4 rounded-[6px] border border-gray-200 bg-[#FBFBFA] p-4 md:p-5"><div class="grid gap-5 lg:grid-cols-[minmax(240px,0.62fr)_minmax(0,1.5fr)]"><div><p class="m-0 text-[0.95rem] font-medium text-black">Agent pricing</p><p class="m-0 mt-1 max-w-[27rem] text-[0.86rem] leading-[1.45] text-[#6B6B6B]">By default, Agent uses effort: auto. Compute and tool usage scale to the task. Choose a fixed effort mode for predictable per-request pricing.</p><p class="m-0 mt-3 max-w-[27rem] text-[0.86rem] leading-[1.45] text-[#6B6B6B]">For request parameters, run lifecycle events, and examples, see the<!-- --> <a href="https://exa.ai/docs/reference/agent-api-guide" class="font-medium text-black underline decoration-[rgba(0,0,0,0.28)] underline-offset-2 transition-colors hover:text-[#4B4B4B]">Agent docs</a>.</p></div><div class="grid gap-3 sm:grid-cols-2"><div><p class="m-0 mb-2 text-[0.76rem] font-medium uppercase tracking-[0.08em] text-[#8A8A8A]">Usage components</p><div class="divide-y divide-[rgba(215,217,222,0.5)] rounded-[5px] border border-gray-200 bg-white"><div class="flex items-baseline justify-between gap-4 px-3 py-2"><span class="text-[0.84rem] text-[#5F5F5F]">Agent Compute Units</span><span class="whitespace-nowrap text-[0.84rem] font-medium text-black">$0.10<span class="font-normal text-[#8A8A8A]"> <!-- -->/ ACU</span></span></div><div class="flex items-baseline justify-between gap-4 px-3 py-2"><span class="text-[0.84rem] text-[#5F5F5F]">Search tool calls</span><span class="whitespace-nowrap text-[0.84rem] font-medium text-black">$0.005<span class="font-normal text-[#8A8A8A]"> <!-- -->/ search</span></span></div><div class="flex items-baseline justify-between gap-4 px-3 py-2"><span class="text-[0.84rem] text-[#5F5F5F]">Email contact enrichment</span><span class="whitespace-nowrap text-[0.84rem] font-medium text-black">$0.02<span class="font-normal text-[#8A8A8A]"> <!-- -->/ email</span></span></div><div class="flex items-baseline justify-between gap-4 px-3 py-2"><span class="text-[0.84rem] text-[#5F5F5F]">Phone contact enrichment</span><span class="whitespace-nowrap text-[0.84rem] font-medium text-black">$0.07<span class="font-normal text-[#8A8A8A]"> <!-- -->/ phone number</span></span></div></div></div><div><p class="m-0 mb-2 text-[0.76rem] font-medium uppercase tracking-[0.08em] text-[#8A8A8A]">Effort levels*</p><div class="divide-y divide-[rgba(215,217,222,0.5)] rounded-[5px] border border-gray-200 bg-white"><div class="flex items-baseline justify-between gap-4 px-3 py-2"><span class="text-[0.84rem] text-[#5F5F5F]">Minimal</span><span class="whitespace-nowrap text-[0.84rem] font-medium text-black">$0.012<span class="font-normal text-[#8A8A8A]"> <!-- -->/ request</span></span></div><div class="flex items-baseline justify-between gap-4 px-3 py-2"><span class="text-[0.84rem] text-[#5F5F5F]">Low</span><span class="whitespace-nowrap text-[0.84rem] font-medium text-black">$0.025<span class="font-normal text-[#8A8A8A]"> <!-- -->/ request</span></span></div><div class="flex items-baseline justify-between gap-4 px-3 py-2"><span class="text-[0.84rem] text-[#5F5F5F]">Medium</span><span class="whitespace-nowrap text-[0.84rem] font-medium text-black">$0.10<span class="font-normal text-[#8A8A8A]"> <!-- -->/ request</span></span></div><div class="flex items-baseline justify-between gap-4 px-3 py-2"><span class="text-[0.84rem] text-[#5F5F5F]">High</span><span class="whitespace-nowrap text-[0.84rem] font-medium text-black">$0.50<span class="font-normal text-[#8A8A8A]"> <!-- -->/ request</span></span></div><div class="flex items-baseline justify-between gap-4 px-3 py-2"><span class="text-[0.84rem] text-[#5F5F5F]">X-high</span><span class="whitespace-nowrap text-[0.84rem] font-medium text-black">$1.00<span class="font-normal text-[#8A8A8A]"> <!-- -->/ request</span></span></div><div class="flex items-baseline justify-between gap-4 px-3 py-2"><span class="text-[0.84rem] text-[#5F5F5F]">Ultra</span><span class="whitespace-nowrap text-[0.84rem] font-medium text-black">usage-based<span class="font-normal text-[#8A8A8A]"> </span></span></div></div><p class="m-0 mt-2 text-[0.76rem] leading-[1.35] text-[#8A8A8A]">*Contact enrichment for emails and phone numbers is billed separately.</p></div></div></div></div></section><div class="flex w-full flex-col gap-8 rounded-[6px] bg-[var(--cream)] p-8 md:flex-row md:gap-16 md:px-12 md:py-20"><div class="flex flex-col gap-6 md:w-[300px] md:flex-shrink-0"><div class="flex flex-col gap-3"><h4 class="m-0 whitespace-nowrap font-serif text-[2.2rem] font-medium text-[var(--charcoal)]">Exa Connect pricing</h4><p class="m-0 text-[1rem] leading-relaxed text-[var(--text-light-muted)]">Pull live data from specialized third-party providers through a single Exa integration. Billed on top of Agent usage.</p></div><a href="https://exa.ai/docs/reference/agent-api/connect/overview#pricing" target="_blank" rel="noopener noreferrer" class="inline-flex w-full items-center justify-center rounded-[2px] bg-black px-6 py-2 text-[1rem] font-medium text-white transition-opacity hover:opacity-80 md:w-fit">View pricing</a></div><div class="grid flex-1 grid-cols-1 gap-6 sm:grid-cols-2 lg:grid-cols-3 lg:gap-8"><div class="flex flex-col gap-4"><p class="m-0 text-[0.95rem] font-medium text-[var(--text-light-muted)]">Self-serve providers</p><div class="flex flex-col gap-3"><div class="flex items-start gap-2"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-check mt-0.5 h-4 w-4 flex-shrink-0 text-[var(--text-light-muted)]"><path d="M20 6 9 17l-5-5"></path></svg><span class="text-[0.95rem] text-[var(--charcoal)]">Jinko</span></div><div class="flex items-start gap-2"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-check mt-0.5 h-4 w-4 flex-shrink-0 text-[var(--text-light-muted)]"><path d="M20 6 9 17l-5-5"></path></svg><span class="text-[0.95rem] text-[var(--charcoal)]">Financial Datasets</span></div><div class="flex items-start gap-2"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-check mt-0.5 h-4 w-4 flex-shrink-0 text-[var(--text-light-muted)]"><path d="M20 6 9 17l-5-5"></path></svg><span class="text-[0.95rem] text-[var(--charcoal)]">Affiliate.com<