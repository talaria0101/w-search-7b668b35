.jUgYuZ{background:var(--color-neutral-background-muted);color:var(--color-neutral-text);padding:4rem 0;display:flex;flex-direction:column;gap:4rem;border-top:1px solid var(--color-neutral-separator-subtle);}/*!sc*/
