blisher":{"@id":"https://apify.com/#organization"}}</script><script id="json-ld-platform" type="application/ld+json">{"@context":"https://schema.org","@type":"SoftwareApplication","@id":"https://apify.com/#platform","name":"Apify","url":"https://apify.com/","description":"Thousands of tools to automate your business. Get real-time web data, track competitors, generate leads, and integrate your apps and AI agents.","applicationCategory":"DeveloperApplication","operatingSystem":"Any","provider":{"@id":"https://apify.com/#organization"},"offers":{"@type":"Offer","name":"Free","price":0,"priceCurrency":"USD","url":"https://apify.com/pricing"},"softwareHelp":{"@type":"CreativeWork","url":"https://docs.apify.com/"}}</script><div id="content" class="HomepageContent__StyledHomepage-sc-476c7a18-0 hJhqiw"><div class="HomepageHeroSection__HomepageHeroSectionWrapper-sc-bdd2cd25-0 kHkrvl"><h1 class="box__StyledBox-sc-df7907ba-0 gVScJa text_base__StyledText-sc-4f18f771-0 faRhVr heading_marketing__StyledHeadingMarketing-sc-24919fb0-0 ehEjKX HomepageHeroSection-title"><span class="HomepageHeroSection__HeroTitleAccent-sc-bdd2cd25-1 ixZUlj">91,856</span> tools for your AI</h1><p class="box__StyledBox-sc-df7907ba-0 gVScJa text_base__StyledText-sc-4f18f771-0 gIULRu text_marketing__StyledTextMarketing-sc-bc174923-0 dcWGoU HomepageHeroSection-description">Apify is a marketplace of ready-to-run tools for AI. Get real-time web data, track competitors,
 generate leads, monitor social media, and integrate your apps and agents.</p><form class="HomepageHeroSection-searchWrapper"><div class="HomepageHeroSection-typingAnimation" tabindex="0"><span data-testid="react-typed"><span></span></span></div><button type="submit" class="Button-sc-39857208-0 limNrR HomepageHeroSection-searchButton" aria-label="Find your Actor"><span class="HomepageHeroSection-searchButtonLabelFull">Find your Actor</span><span class="HomepageHeroSection-searchButtonLabelShort">Find</span></button></form><span class="agent-setup-button__AgentSetupButtonRoot-sc-84232af8-0 cVESta AgentSetupButton HomepageHeroSection-agentSetupButton"><button type="button" aria-label="Copy setup for AI" class="box__StyledBox-sc-df7907ba-0 etESDF button-style__StyledButton-sc-f89ae191-0 kPYlZn AgentSetupButton__button"><svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 20 20" class="_icon_20_1678j_11" aria-hidden="true"><path stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.667" d="M5.833 8.056a2.22 2.22 0 0 1 2.223-2.223h7.221A2.22 2.22 0 0 1 17.5 8.056v7.222a2.223 2.223 0 0 1-2.223 2.222H8.056a2.22 2.22 0 0 1-2.223-2.222z"></path><path stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.667" d="M3.343 13.948A1.67 1.67 0 0 1 2.5 12.5V4.167c0-.917.75-1.667 1.667-1.667H12.5c.625 0 .965.32 1.25.833"></path></svg>Copy setup for AI</button><span role="status" class="AgentSetupButton__status"></span></span><h2 class="box__StyledBox-sc-df7907ba-0 gVScJa text_base__StyledText-sc-4f18f771-0 faRhVr heading_marketing__StyledHeadingMarketing-sc-24919fb0-0 fmnkCx HomepageHeroSection-cardsHeading">Popular Actors</h2><div class="HomepageHeroSection-cardsWrapper"><a rel="" target="_self" data-test="actor-card" class="box__StyledBox-sc-df7907ba-0 etESDF link__StyledAsLink-sc-c6c1be68-0 cvOcBA box__StyledBox-sc-df7907ba-0 etESDF actor_store_item_link_styles__ActorStoreItemWrapper-sc-4160afd1-0 dYwTLB HomepageHeroSection-actorCard HomepageHeroSection-actorCardHighlighted" href="/clockworks/tiktok-scraper"><div class="ActorStoreItem-header-and-description"><div data-test="actor-store-item-header" class="box__StyledBox-sc-df7907ba-0 etESDF store_actor_header__StyledStoreActorHeader-sc-a3055d-0 fQSigF"><div class="box__StyledBox-sc-df7907ba-0 etESDF store_actor_header__ActorAvatarWrapper-sc-a3055d-1 iSDSnj"><img crossorigin="anonymous" src="https://images.apifyusercontent.com/5TrEQbTFGVZia_ZUYmobfvO6YvVxiQX0l3HXv7x7-uU/rs:fill:76:76/cb:1/aHR0cHM6Ly9hcGlmeS1pbWFnZS11cGxvYWRzLXByb2QuczMuYW1hem9uYXdzLmNvbS9HZFdDa3hCdEtXT3NLamRjaC96dExHNWhUM1pMaEFGRmVLTi1UaWtUb2tfU2NyYXBlci5wbmc.webp" class="actor_avatar__StyledImg-sc-a38947c-1 gCcFUe ActorAvatar ActorAvatar-image" width="40" height="40" alt="TikTok Scraper avatar"/></div><div class="box__StyledBox-sc-df7907ba-0 etESDF store_actor_header__ActorTitleWrapper-sc-a3055d-3 eriuKI"><div class="ActorStoreItem-title"><h3 class="box__StyledBox-sc-df7907ba-0 gVScJa text_base__StyledText-sc-4f18f771-0 dOAIAy text_shared__StyledTextShared-sc-5045462-0 iHqneF">TikTok Scraper</h3></div><p class="box__StyledBox-sc-df7907ba-0 gVScJa text_base__StyledText-sc-4f18f771-0 hBreDq text_shared__StyledTextShared-sc-5045462-0 bClFKO ActorStoreItem-slug">clockworks<!-- -->/<!-- -->tiktok-scraper</p></div></div><p class="box__StyledBox-sc-df7907ba-0 gVScJa text_base__StyledText-sc-4f18f771-0 gIULRu text_shared__StyledTextShared-sc-5045462-0 gybToy ActorStoreItem-desc">Extract data from TikTok videos, hashtags, and users. Use URLs or search queries to scrape TikTok profiles, hashtags, posts, URLs, shares, followers, hearts, names, video, and music-related data. Export scraped data, run the scraper via API, schedule and monitor runs or integrate with other tools.</p></div><div class="ActorStoreItem-info"><div class="ActorStoreItem-author"><img class="user_avatar__StyledImg-sc-9506a459-1 jIuDrf UserAvatar UserAvatar-image ActorStoreItem-user-avatar" sr