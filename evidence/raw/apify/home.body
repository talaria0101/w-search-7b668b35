.26 1.802-.319zm-8.571 6.964.877 1.522 1.801.32-1.259 1.26.236 1.72-1.655-.744-1.656.744.236-1.72-1.259-1.26 1.801-.32zm38.571 0 .878 1.522 1.8.32-1.258 1.26.236 1.72-1.656-.744-1.655.744.236-1.72-1.26-1.26 1.802-.32zm-8.571-6.964.877 1.522 1.801.32-1.259 1.26.236 1.72-1.655-.744-1.656.743.236-1.72-1.259-1.26 1.801-.319zM30 51.964l.878 1.522 1.801.32-1.259 1.26.236 1.72-1.655-.744-1.656.743.236-1.72-1.259-1.26 1.801-.319zM19.286 48.75l.878 1.523 1.8.319-1.258 1.26.236 1.72-1.656-.744-1.655.743.236-1.72-1.26-1.26 1.802-.319zm-8.571-6.964.877 1.522 1.801.32-1.259 1.26.236 1.72-1.655-.745-1.656.744.236-1.72-1.259-1.26 1.801-.319zm38.571 0 .878 1.522 1.8.32-1.258 1.26.236 1.72-1.656-.745-1.655.744.236-1.72-1.26-1.26 1.802-.319zm-8.571 6.964.877 1.523 1.801.319-1.259 1.26.236 1.72-1.655-.744-1.656.743.236-1.72-1.259-1.26 1.801-.319z"></path></g><defs><clipPath id="Gdpr_svg__a"><path fill="#fff" d="M0 0h60v60H0z"></path></clipPath></defs></svg><h2 class="box__StyledBox-sc-df7907ba-0 gVScJa text_base__StyledText-sc-4f18f771-0 bShVIc heading_marketing__StyledHeadingMarketing-sc-24919fb0-0 kNJTNj">Enterprise-grade solution</h2><p class="box__StyledBox-sc-df7907ba-0 gVScJa text_base__StyledText-sc-4f18f771-0 bShVIc text_marketing__StyledTextMarketing-sc-bc174923-0 DPzZy">Accurate and secure web data from any website, at any scale.<br/>99.95% uptime. SOC2, GDPR, and CCPA compliant.</p><div class="enterprise-section-header-buttons"><a class="Link__StyledNextLink-sc-ca37d6e9-0 kEdVTs" href="/contact-sales">Contact sales</a><a class="Link__StyledNextLink-sc-ca37d6e9-0 byxFWl" variant="secondary" href="/enterprise">Learn more</a></div></div></div><div class="enterprise-section-testimonials"><a class="Link__StyledLink-sc-ca37d6e9-1 fFjvF EnterpriseSection__TestimonialCardWrapper-sc-af7cf096-0 usbuE" href="https://blog.apify.com/intercom-customer-support-ai-chatbot-web-scraping" rel="noopener" target="_blank"><p class="box__StyledBox-sc-df7907ba-0 gVScJa text_base__StyledText-sc-4f18f771-0 faRhVr text_marketing__StyledTextMarketing-sc-bc174923-0 dLgZJq testimonial-card-quote-text">We looked at several providers, and Apify was the most complete, reliant solution we found. It was miles ahead of everything else we reviewed.</p><div class="testimonial-card-bottom-part"><div class="testimonial-card-author"><img src="/_next/image?url=%2Fimg%2Fhomepage%2Fpranav.webp&amp;w=3840&amp;q=75&amp;dpl=1240ae1cda" srcSet="/_next/image?url=%2Fimg%2Fhomepage%2Fpranav.webp&amp;w=640&amp;q=75&amp;dpl=1240ae1cda 640w, /_next/image?url=%2Fimg%2Fhomepage%2Fpranav.webp&amp;w=750&amp;q=75&amp;dpl=1240ae1cda 750w, /_next/image?url=%2Fimg%2Fhomepage%2Fpranav.webp&amp;w=828&amp;q=75&amp;dpl=1240ae1cda 828w, /_next/image?url=%2Fimg%2Fhomepage%2Fpranav.webp&amp;w=1080&amp;q=75&amp;dpl=1240ae1cda 1080w, /_next/image?url=%2Fimg%2Fhomepage%2Fpranav.webp&amp;w=1200&amp;q=75&amp;dpl=1240ae1cda 1200w, /_next/image?url=%2Fimg%2Fhomepage%2Fpranav.webp&amp;w=1920&amp;q=75&amp;dpl=1240ae1cda 1920w, /_next/image?url=%2Fimg%2Fhomepage%2Fpranav.webp&amp;w=2048&amp;q=75&amp;dpl=1240ae1cda 2048w, /_next/image?url=%2Fimg%2Fhomepage%2Fpranav.webp&amp;w=3840&amp;q=75&amp;dpl=1240ae1cda 3840w" sizes="100vw" alt="Pranav Singh" loading="lazy" width="40" height="40" decoding="async" class="Image__StyledImage-sc-cb6241f0-0 MRKTX"/><div class="testimonial-card-author-text"><p class="box__StyledBox-sc-df7907ba-0 gVScJa text_base__StyledText-sc-4f18f771-0 faRhVr text_marketing__StyledTextMarketing-sc-bc174923-0 lbA-DQN">Pranav Singh</p><p class="box__StyledBox-sc-df7907ba-0 gVScJa text_base__StyledText-sc-4f18f771-0 hBreDq text_marketing__StyledTextMarketing-sc-bc174923-0 dLgZJq">Engineering Manager at Intercom</p></div></div><div class="testimonial-card-icon-wrapper"><svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 20 20" class="_icon_20_1678j_11" aria-hidden="true"><path stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.667" d="M4.167 10h11.667M10.833 15l5-5M10.833 5l5 5"></path></svg><svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 20 20" class="_icon_20_1678j_11" aria-hidden="true"><path stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.667" d="M4.167 10h11.667M10.833 15l5-5M10.833 5l5 5"></path></svg></div></div></a><a class="Link__StyledLink-sc-ca37d6e9-1 fFjvF EnterpriseSection__TestimonialCardWrapper-sc-af7cf096-0 usbuE" href="https://blog.apify.com/groupon-reaches-new-merchants-with-web-data-collection" rel="noopener" target="_blank"><p class="box__StyledBox-sc-df7907ba-0 gVScJa text_base__StyledText-sc-4f18f771-0 faRhVr text_marketing__StyledTextMarketing-sc-bc174923-0 dLgZJq testimonial-card-quote-text">We selected Apify because of their vast experience with web data collection to empower our sales team with fresh, unique leads.</p><div class="testimonial-card-bottom-part"><div class="testimonial-card-author"><img src="/_next/image?url=%2Fimg%2Fhomepage%2Ffilip.webp&amp;w=3840&amp;q=75&amp;dpl=1240ae1cda" srcSet="/_next/image?url=%2Fimg%2Fhomepage%2Ffilip.webp&amp;w=640&amp;q=75&amp;dpl=1240ae1cda 640w, /_next/image?url=%2Fimg%2Fhomepage%2Ffilip.webp&amp;w=750&amp;q=75&amp;dpl=1240ae1cda 750w, /_next/image?url=%2Fimg%2Fhomepage%2Ffilip.webp&amp;w=828&amp;q=75&amp;dpl=1240ae1cda 828w, /_next/image?url=%2Fimg%2Fhomepage%2Ffilip.webp&amp;w=1080&amp;q=75&amp;dpl=1240ae1cda 1080w, /_next/image?url=%2Fimg%2Fhomepage%2Ffilip.webp&amp;w=1200&amp;q=75&amp;dpl=1240ae1cda 1200w, /_next/image?url=%2Fimg%2Fhomepage%2Ffilip.webp&amp;w=1920&amp;q=75&amp;dpl=1240ae1cda 1920w, /_next/image?url=%2Fimg%2Fhomepage%2Ffilip.webp&amp;w=2048&amp;q=75&amp;dpl=1240ae1cda 2048w, /_next/image?url=%2Fimg%2Fhomepage%2Ffilip.webp&amp;w=3840&amp;q=75&amp;dpl=1240ae1cda 3840w" sizes="100vw" alt="Filip Popovic" loading="lazy" width="40" height="40" decoding="async" class="Image__StyledImage-sc-cb6241f0-0 MRKTX"/><div class="testimonial-card-author-text"><p class="box__StyledBox-sc-df7907ba-0 gVScJa text_base__StyledText-sc-4f18f771-0 faRhVr text_marketing__StyledTextMarketing-sc-bc174923-0 lbA-DQN">Filip Popovic</p><p class="box__StyledBox-sc-df7907ba-0 gVScJa text_base__StyledText-sc-4f18f771-0 hBreDq text_marketing__StyledTextMarketing-sc-bc174923-0 dLgZJq">COO at Groupon</p></div></div><div class="testimonial-card-icon-wrapper"><svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 20 20" class="_icon_20_1678j_11" aria-hidden="true"><path stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.667" d="M4.167 10h11.667M10.833 15l5-5M10.833 5l5 5"></path></svg><svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 20 20" class="_icon_20_1678j_11" aria-hidden="true"><path stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.667" d="M4.167 10h11.667M10.833 15l5-5M10.833 5l5 5"></path></svg></div></div></a><a class="Link__StyledLink-sc-ca37d6e9-1 fFjvF EnterpriseSection__TestimonialCardWrapper-sc-af7cf096-0 usbuE" href="https://blog.apify.com/how-web-scraping-ai-and-the-eu-have-come-together-to-sweep-away-fake-discounts-in-europe" rel="noopener" target="_blank"><p class="box__StyledBox-sc-df7907ba-0 gVScJa text_base__StyledText-sc-4f18f771-0 faRhVr text_marketing__StyledTextMarketing-sc-bc174923-0 dLgZJq testimonial-card-quote-text">Our collaboration with Apify proves that advanced IT tools leveraging AI can be the key in detecting infringements of consumer protection legislation.</p><div class="testimonial-card-bottom-part"><div class="testimonial-card-author"><img src="/_next/image?url=%2Fimg%2Fhomepage%2Fmarie.webp&amp;w=3840&amp;q=75&amp;dpl=1240ae1cda" srcSet="/_next/image?url=%2Fimg%2Fhomepage%2Fmarie.webp&amp;w=640&amp;q=75&amp;dpl=1240ae1cda 640w, /_next/image?url=%2Fimg%2Fhomepage%2Fmarie.webp&amp;w=750&amp;q=75&amp;dpl=1240ae1cda 750w, /_next/image?url=%2Fimg%2Fhomepage%2Fmarie.webp&amp;w=828&amp;q=75&amp;dpl=1240ae1cda 828w, /_next/image?url=%2Fimg%2Fhom