45462-0 ggxtvj">See all features and compare plans</p></a></div></div><section class="HowPricingWorksSection__HowPricingWorksSectionWrapper-sc-8268af10-0 hxgNWB"><div><h2 class="box__StyledBox-sc-df7907ba-0 kHgCjA text_base__StyledText-sc-4f18f771-0 bShVIc heading_marketing__StyledHeadingMarketing-sc-24919fb0-0 kNJTNj">How pricing works</h2><p class="box__StyledBox-sc-df7907ba-0 kOrGSp text_base__StyledText-sc-4f18f771-0 eUXohl text_marketing__StyledTextMarketing-sc-bc174923-0 dcWGoU">Every Actor in Apify Store uses one of these pricing models.</p></div><div class="box__StyledBox-sc-df7907ba-0 etESDF controlled_button_switch-styled__StyledControlledButtonSwitch-sc-504f23c6-0 igFlzD ButtonSwitch__Wrapper StyledButtonSwitch__StyledButtonsSwitch-sc-bad28456-0 kMya-DL"><div class="ButtonSwitch__Background"></div><button type="button" class="ButtonSwitch__Item ButtonSwitch__Item--active" data-test="button-switch-item-active" title=""><p class="box__StyledBox-sc-df7907ba-0 gVScJa text_base__StyledText-sc-4f18f771-0 faRhVr text_shared__StyledTextShared-sc-5045462-0 ggxtvj">Pay per event</p></button><button type="button" class="ButtonSwitch__Item" data-test="button-switch-item-inactive" title=""><p class="box__StyledBox-sc-df7907ba-0 gVScJa text_base__StyledText-sc-4f18f771-0 faRhVr text_shared__StyledTextShared-sc-5045462-0 ggxtvj">Pay per usage</p></button><button type="button" class="ButtonSwitch__Item" data-test="button-switch-item-inactive" title=""><p class="box__StyledBox-sc-df7907ba-0 gVScJa text_base__StyledText-sc-4f18f771-0 faRhVr text_shared__StyledTextShared-sc-5045462-0 ggxtvj">Pay per event + usage</p></button></div><picture><source srcSet="/img/pricing/instagram-large-desktop.svg" media="(min-width: 1440px)"/><source srcSet="/img/pricing/instagram-desktop.svg" media="(min-width: 1024px)"/><source srcSet="/img/pricing/instagram-tablet.svg" media="(min-width: 768px)"/><img class="Pricing-Picture" src="/img/pricing/instagram-mobile.svg" alt="Pricing"/></picture></section><div class="CreatorPlanBanner__CreatorPlanBannerWrapper-sc-1a5f7f5e-0 ggdcUe"><div class="CreatorPlanBanner-bannerText"><h2 class="box__StyledBox-sc-df7907ba-0 gVScJa text_base__StyledText-sc-4f18f771-0 faRhVr heading_marketing__StyledHeadingMarketing-sc-24919fb0-0 fmnkCx">Build your own</h2><p class="box__StyledBox-sc-df7907ba-0 gVScJa text_base__StyledText-sc-4f18f771-0 gIULRu text_marketing__StyledTextMarketing-sc-bc174923-0 DPzZy">Enjoy $500 worth of free usage to build your own Actors and AI agents along with other benefits for 6 months.</p><a class="Link__StyledNextLink-sc-ca37d6e9-0 byxFWl CreatorPlanBanner-button" variant="secondary" href="/pricing/creator-plan">Learn more</a></div><img src="/_next/image?url=%2F_next%2Fstatic%2Fmedia%2Fcreator-banner-dark.0dt79eggjwu80.png&amp;w=3840&amp;q=75&amp;dpl=1240ae1cda" srcSet="/_next/image?url=%2F_next%2Fstatic%2Fmedia%2Fcreator-banner-dark.0dt79eggjwu80.png&amp;w=384&amp;q=75&amp;dpl=1240ae1cda 384w, /_next/image?url=%2F_next%2Fstatic%2Fmedia%2Fcreator-banner-dark.0dt79eggjwu80.png&amp;w=640&amp;q=75&amp;dpl=1240ae1cda 640w, /_next/image?url=%2F_next%2Fstatic%2Fmedia%2Fcreator-banner-dark.0dt79eggjwu80.png&amp;w=750&amp;q=75&amp;dpl=1240ae1cda 750w, /_next/image?url=%2F_next%2Fstatic%2Fmedia%2Fcreator-banner-dark.0dt79eggjwu80.png&amp;w=828&amp;q=75&amp;dpl=1240ae1cda 828w, /_next/image?url=%2F_next%2Fstatic%2Fmedia%2Fcreator-banner-dark.0dt79eggjwu80.png&amp;w=1080&amp;q=75&amp;dpl=1240ae1cda 1080w, /_next/image?url=%2F_next%2Fstatic%2Fmedia%2Fcreator-banner-dark.0dt79eggjwu80.png&amp;w=1200&amp;q=75&amp;dpl=1240ae1cda 1200w, /_next/image?url=%2F_next%2Fstatic%2Fmedia%2Fcreator-banner-dark.0dt79eggjwu80.png&amp;w=1920&amp;q=75&amp;dpl=1240ae1cda 1920w, /_next/image?url=%2F_next%2Fstatic%2Fmedia%2Fcreator-banner-dark.0dt79eggjwu80.png&amp;w=2048&amp;q=75&amp;dpl=1240ae1cda 2048w, /_next/image?url=%2F_next%2Fstatic%2Fmedia%2Fcreator-banner-dark.0dt79eggjwu80.png&amp;w=3840&amp;q=75&amp;dpl=1240ae1cda 3840w" sizes="(min-width: 1200px) 50vw, (min-width: 768px) 75vw, 100vw" alt="Creator plan" loading="lazy" width="1174" height="644" decoding="async" class="Image__StyledImage-sc-cb6241f0-0 MRKTX CreatorPlanBanner-image"/></div><section class="Section__SectionWrapper-sc-e1b1f799-1 gJcVoG AddOnsSection__StyledSection-sc-3fc18a9-0 dVRtRB"><div class="Section__SectionInnerWrapper-sc-e1b1f799-0 cXlOyN Section-wrap"><div class="Section-body Section-body--withBorders"><div class="AddOnsSection__StyledAddOnsSection-sc-3fc18a9-1 dvDOeP"><h2 class="box__StyledBox-sc-df7907ba-0 gVScJa text_base__StyledText-sc-4f18f771-0 faRhVr heading_marketing__StyledHeadingMarketing-sc-24919fb0-0 kNJTNj AddOnsSection-heading" id="be-flexible-with-addons">Be flexible with<br class="show-on-mobile"/> <svg xmlns="http://www.w3.org/2000/svg" width="48" height="48" fill="none"><path fill="#1672EB" d="m37.047 24.199-9.672-3.574-3.562-9.679a2.985 2.985 0 0 0-5.603 0l-3.585 9.679-9.678 3.563a2.985 2.985 0 0 0 0 5.602l9.678 3.585 3.563 9.679a2.985 2.985 0 0 0 5.602 0l3.585-9.679 9.679-3.562a2.985 2.985 0 0 0 0-5.603zm-11.36 6.592a1.5 1.5 0 0 0-.888.889L21 41.972 17.21 31.687a1.5 1.5 0 0 0-.896-.896L6.028 27l10.285-3.791a1.5 1.5 0 0 0 .896-.896L21 12.028l3.791 10.285a1.5 1.5 0 0 0 .89.888L35.971 27zM27 7.5A1.5 1.5 0 0 1 28.5 6h3V3a1.5 1.5 0 1 1 3 0v3h3a1.5 1.5 0 0 1 0 3h-3v3a1.5 1.5 0 1 1-3 0V9h-3A1.5 1.5 0 0 1 27 7.5m19.5 9A1.5 1.5 0 0 1 45 18h-1.5v1.5a1.5 1.5 0 1 1-3 0V18H39a1.5 1.5 0 1 1 0-3h1.5v-1.5a1.5 1.5 0 1 1 3 0V15H45a1.5 1.5 0 0 1 1.5 1.5"></path></svg> add-ons</h2><div class="AddOnsSection-list"><div class="AddOnsSection-card"><div class="AddOnsSection-card-top"><div class="AddOnsSection-card-tag"><svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="none"><path fill="#1672EB" d="M15 8a.99.99 0 0 1-.657.938l-3.965 1.441-1.44 3.965a1 1 0 0 1-1.876 0l-1.441-3.965-3.965-1.441a1 1 0 0 1 0-1.875L5.62 5.62l1.441-3.965a1 1 0 0 1 1.875 0l1.442 3.965 3.964 1.442A.99.99 0 0 1 15 8"></path></svg> <p class="box__StyledBox-sc-df7907ba-0 gVScJa text_base__StyledText-sc-4f18f771-0 faRhVr text_marketing__StyledTextMarketing-sc-bc174923-0 jvnVsP">Add-on</p></div><p class="box__StyledBox-sc-df7907ba-0 gVScJa text_base__StyledText-sc-4f18f771-0 hBreDq text_marketing__StyledTextMarketing-sc-bc174923-0 dLgZJq">$5 / run</p></div><div class="AddOnsSection-card-text"><h3 class="box__StyledBox-sc-df7907ba-0 gVScJa text_base__StyledText-sc-4f18f771-0 faRhVr heading_marketing__StyledHeadingMarketing-sc-24919fb0-0 jmVzNu">Concurrent runs</h3><p class="box__StyledBox-sc-df7907ba-0 gVScJa text_base__StyledText-sc-4f18f771-0 gIULRu text_marketing__StyledTextMarketing-sc-bc174923-0 dLgZJq">Allows multiple instances of an Actor to run simultaneously, enabling faster task processing and efficient resource use.</p></div><a class="Link__StyledNextLink-sc-ca37d6e9-0 cOTwtv AddOnsSection-card-button" variant="secondary" href="https://console.apify.com/billing#/subscription?openSubscriptionWizard=true">Add to plan</a></div><div class="AddOnsSection-card"><div class="AddOnsSection-card-top"><div class="AddOnsSection-card-tag"><svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="none"><path fill="#1672EB" d="M15 8a.99.99 0 0 1-.657.938l-3.965 1.441-1.44 3.965a1 1 0 0 1-1.876 0l-1.441-3.965-3.965-1.441a1 1 0 0 1 0-1.875L5.62 5.62l1.441-3.965a1 1 0 0 1 1.875 0l1.442 3.965 3.964 1.442A.99.99 0 0 1 15 8"></path></svg> <p class="box__StyledBox-sc-df7907ba-0 gVScJa text_base__StyledText-sc-4f18f771-0 faRhVr text_marketing__StyledTextMarketing-sc-bc174923-0 jvnVsP">Add-on</p></div><p class="box__StyledBox-sc-df7907ba-0 gVScJa text_base__StyledText-sc-4f18f771-0 hBreDq text_marketing__StyledTextMarketing-sc-bc174923-0 dLgZJq">$1 / GB</p></div><div class="AddOnsSection-card-text"><h3 class="box__StyledBox-sc-df7907ba-0 gVScJa text_base__StyledText-sc-4f18f771-0 faRhVr heading_marketing__StyledHeadingMarketing-sc-24919fb0-0 jmVzNu">Actor RAM</h3><p class="box__StyledBox-sc-df7907ba-0 gVScJa text_base__StyledText-sc-4f18f771-0 gIULRu text_marketing__StyledTextMarketing-sc-bc174923-0 dLgZJq">The memory allocated to an Actor while it runs. More memory lets an Actor process more data and run faster.</p></div><a class="Link__StyledNextLink-sc-ca37d6e9-0 cOTwtv AddOnsSection-card-button" variant="secondary" href="https://console.apify.com/billing#/subscription?openSubscriptionWizard=true">Add to plan</a></div><div class="AddOnsSection-card"><div class="AddOnsSection-card-top"><div class="AddOnsSection-card-tag"><svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="none"><path fill="#1672EB" d="M15 8a.99.99 0 0 1-.657.938l-3.965 1.441-1.44 3.965a1 1 0 0 1-1.876 0l-1.441-3.965-3.965-1.441a1 1 0 0 1 0-1.875L5.62 5.62l1.441-3.965a1 1 0 0 1 1.875 0l1.442 3.965 3.964 1.442A.99.99 0 0 1 15 8"></path></svg> <p class="box__StyledBox-sc-df7907ba-0 gVScJa text_base__StyledText-sc-4f18f771-0 faRhVr text_marketing__StyledTextMarketing-sc-bc174923-0 jvnVsP">Add-on</p></div><p class="box__StyledBox-sc-df7907ba-0 gVScJa text_base__StyledText-sc-4f18f771-0 hBreDq text_marketing__StyledTextMarketing-sc-bc174923-0 dLgZJq">from $0.6 / IP</p></div><div class="AddOnsSection-card-text"><h3 class="box__StyledBox-sc-df7907ba-0 gVScJa text_base__StyledText-sc-4f18f771-0 faRhVr heading_marketing__StyledHeadingMarketing-sc-24919fb0-0 jmVzNu">Datacenter proxy</h3><p class="box__StyledBox-sc-df7907ba-0 gVScJa text_base__StyledText-sc-4f18f771-0 gIULRu text_marketing__StyledTextMarketing-sc-bc174923-0 dLgZJq">Fast, cost-effective non-residential IPs from data centers, ideal for scraping less-protected websites and automation tasks.</p></div><a class="Link__StyledNextLink-sc-ca37d6e9-0 cOTwtv AddOnsSection-card-button" variant="secondary" href="https://console.apify.com/billing#/subscription?openSubscriptionWizard=true">Add to plan</a></div><div class="AddOnsSection-card"><div class="AddOnsSection-card-top"><div class="AddOnsSection-card-tag"><svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="none"><path fill="#1672EB" d="M15 8a.99.99 0 0 1-.657.938l-3.965 1.441-1.44 3.965a1 1 0 0 1-1.876 0l-1.441-3.965-3.965-1.441a1 1 0 0 1 0-1.875L5.62 5.62l1.441-3.965a1 1 0 0 1 1.875 0l1.442 3.965 3.964 1.442A.99.99 0 0 1 15 8"></path></svg> <p class="box__StyledBox-sc-df7907ba-0 gVScJa text_base__StyledText-sc-4f18f771-0 faRhVr text_marketing__StyledTextMarketing-sc-bc174923-0 jvnVsP">Add-on</p></div><p class="box__StyledBox-sc-df7907ba-0 gVScJa text_base__StyledText-sc-4f18f771-0 hBreDq text_marketing__StyledTextMarketing-sc-bc174923-0 dLgZJq">$150 / hour</p></div><div class="AddOnsSection-card-text"><h3 class="box__StyledBox-sc-df7907ba-0 gVScJa text_base__StyledText-sc-4f18f771-0 faRhVr heading_marketing__StyledHeadingMarketing-sc-24919fb0-0 jmVzNu">Personal training</h3><p class="box__StyledBox-sc-df7907ba-0 gVScJa text_base__StyledText-sc-4f18f771-0 gIULRu text_marketing__StyledTextMarketing-sc-bc174923-0 dLgZJq">Personal training support or guidance to help you use the platform, optimize Actors, and achieve specific goals.</p></div><a class="Link__StyledNextLink-sc-ca37d6e9-0 cOTwtv AddOnsSection-card-button" variant="secondary" href="https://console.apify.com/billing#/subscription?openSubscriptionWizard=true">Add to plan</a></div></div></div></div></div></section><section class="Section__SectionWrapper-sc-e1b1f799-1 gJcVoG TestimonialsSection__StyledSection-sc-bf9c7e6-0 eKiXpy"><div class="Section__SectionInnerWrapper-sc-e1b1f799-0 cXlOyN Section-wrap"><div class="Section-body Section-body--withBorders"><div class="TestimonialsSection__StyledTestimonialsSection-sc-bf9c7e6-1 jfGFeX"><div class="Testimonials-card"><div class="Testimonials-text"><h3 class="box__StyledBox-sc-df7907ba-0 gVScJa text_base__StyledText-sc-4f18f771-0 faRhVr heading_marketing__StyledHeadingMarketing-sc-24919fb0-0 dGOyZn">2x leads</h3><p class="box__StyledBox-sc-df7907ba-0 gVScJa text_base__StyledText-sc-4f18f771-0 gIULRu text_marketi