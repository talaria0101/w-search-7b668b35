peGraphAI\"}],[\"$\",\"h2\",null,{\"className\":\"text-2xl md:text-3xl lg:text-4xl text-foreground text-balance font-semibold tracking-tight\",\"children\":\"Turn any webpage into structured data with one API call\"}]]}],[\"$\",\"$L6c\",null,{\"features\":[{\"id\":1,\"title\":\"Scrape\",\"description\":\"Convert any webpage to clean, well-formatted Markdown. Documentation, content migration, or preparing context for LLMs.\",\"codeHtml\":{\"curl\":\"$6d\",\"python\":\"$6e\",\"javascript\":\"$6f\"},\"codeRaw\":{\"curl\":\"curl -X POST \\\\\\n  https://v2-api.scrapegraphai.com/api/scrape \\\\\\n  -H \\\"Content-Type: application/json\\\" \\\\\\n  -H \\\"SGAI-APIKEY: $SGAI_API_KEY\\\" \\\\\\n  -d '{\\n  \\\"url\\\": \\\"https://docs.example.com/getting-started\\\",\\n  \\\"formats\\\": [\\n    {\\n      \\\"type\\\": \\\"markdown\\\"\\n    }\\n  ]\\n}'\",\"python\":\"from scrapegraph_py import ScrapeGraphAI, MarkdownFormatConfig\\n\\nsgai = ScrapeGraphAI()\\n\\nresult = sgai.scrape(\\n    \\\"https://docs.example.com/getting-started\\\",\\n    formats=[MarkdownFormatConfig()],\\n)\\n\\nif result.status == \\\"success\\\":\\n    print(result.data)\\nelse:\\n    print(result.error)\",\"javascript\":\"import { ScrapeGraphAI } from \\\"scrapegraph-js\\\";\\n\\nconst sgai = ScrapeGraphAI();\\n\\nconst result = await sgai.scrape({\\n  url: \\\"https://docs.example.com/getting-started\\\",\\n  formats: [{\\n    type: \\\"markdown\\\",\\n  }],\\n});\\n\\nif (result.status === \\\"success\\\") {\\n  console.log(result.data);\\n} else {\\n  console.error(result.error);\\n}\"},\"outputHtml\":\"$70\"},{\"id\":2,\"title\":\"Extract\",\"description\":\"Extract structured data from any webpage using natural language prompts. Define a schema and get back clean JSON — product details, contact info, or any content.\",\"codeHtml\":{\"curl\":\"$71\",\"python\":\"$72\",\"javascript\":\"$73\"},\"codeRaw\":{\"curl\":\"curl -X POST \\\\\\n  https://v2-api.scrapegraphai.com/api/extract \\\\\\n  -H \\\"Content-Type: application/json\\\" \\\\\\n  -H \\\"SGAI-APIKEY: $SGAI_API_KEY\\\" \\\\\\n  -d '{\\n  \\\"url\\\": \\\"https://news.ycombinator.com\\\",\\n  \\\"prompt\\\": \\\"Extract the top 3 stories with title, points, and author\\\"\\n}'\",\"python\":\"from scrapegraph_py import ScrapeGraphAI\\n\\nsgai = ScrapeGraphAI()\\n\\nresult = sgai.extract(\\n    \\\"Extract the top 3 stories with title, points, and author\\\",\\n    url=\\\"https://news.ycombinator.com\\\",\\n)\\n\\nif result.status == \\\"success\\\":\\n    print(result.data)\\nelse:\\n    print(result.error)\",\"javascript\":\"import { ScrapeGraphAI } from \\\"scrapegraph-js\\\";\\n\\nconst sgai = ScrapeGraphAI();\\n\\nconst result = await sgai.extract({\\n  url: \\\"https://news.ycombinator.com\\\",\\n  prompt: \\\"Extract the top 3 stories with title, points, and author\\\",\\n});\\n\\nif (result.status === \\\"success\\\") {\\n  console.log(result.data);\\n} else {\\n  console.error(result.error);\\n}\"},\"outputHtml\":\"$74\"},{\"id\":3,\"title\":\"Search\",\"description\":\"Search the web and extract structured data from results in one call. Market research, competitor analysis, and trend tracking.\",\"codeHtml\":{\"curl\":\"$75\",\"python\":\"$76\",\"javascript\":\"$77\"},\"codeRaw\":{\"curl\":\"curl -X POST \\\\\\n  https://v2-api.scrapegraphai.com/api/search \\\\\\n  -H \\\"Content-Type: application/json\\\" \\\\\\n  -H \\\"SGAI-APIKEY: $SGAI_API_KEY\\\" \\\\\\n  -d '{\\n  \\\"query\\\": \\\"sustainable packaging trends 2026\\\",\\n  \\\"numResults\\\": 3,\\n  \\\"prompt\\\": \\\"Extract top trends with market size\\\",\\n  \\\"locationGeoCode\\\": \\\"us\\\"\\n}'\",\"python\":\"from scrapegraph_py import ScrapeGraphAI\\n\\nsgai = ScrapeGraphAI()\\n\\nresult = sgai.search(\\n    \\\"sustainable packaging trends 2026\\\",\\n    num_results=3,\\n    prompt=\\\"Extract top trends with market size\\\",\\n    location_geo_code=\\\"us\\\",\\n)\\n\\nif result.status == \\\"success\\\":\\n    print(result.data)\\nelse:\\n    print(result.error)\",\"javascript\":\"import { ScrapeGraphAI } from \\\"scrapegraph-js\\\";\\n\\nconst sgai = ScrapeGraphAI();\\n\\nconst result = await sgai.search({\\n  query: \\\"sustainable packaging trends 2026\\\",\\n  numResults: 3,\\n  prompt: \\\"Extract top trends with market size\\\",\\n  locationGeoCode: \\\"us\\\",\\n});\\n\\nif (result.status === \\\"success\\\") {\\n  console.log(result.data);\\n} else {\\n  console.error(result.error);\\n}\"},\"outputHtml\":\"$78\"},{\"id\":4,\"title\":\"Crawl\",\"description\":\"Crawl all the pages on a website and get structured data for each link. Site-wide extraction, content audits, and data pipelines.\",\"codeHtml\":{\"curl\":\"$79\",\"python\":\"$7a\",\"javascript\":\"$7b\"},\"codeRaw\":{\"curl\":\"curl -X POST \\\\\\n  https://v2-api.scrapegraphai.com/api/crawl \\\\\\n  -H \\\"Content-Type: application/json\\\" \\\\\\n  -H \\\"SGAI-APIKEY: $SGAI_API_KEY\\\" \\\\\\n  -d '{\\n  \\\"url\\\": \\\"https://docs.example.com\\\"\\n}'\",\"python\":\"from scrapegraph_py import ScrapeGraphAI\\n\\nsgai = ScrapeGraphAI()\\n\\nresult = sgai.crawl.start(\\\"https://docs.example.com\\\")\\n\\nif result.status == \\\"success\\\":\\n    print(result.data)\\nelse:\\n    print(result.error)\",\"javascript\":\"import { ScrapeGraphAI } from \\\"scrapegraph-js\\\";\\n\\nconst sgai = ScrapeGraphAI();\\n\\nconst result = await sgai.crawl.start({\\n  url: \\\"https://docs.example.com\\\",\\n});\\n\\nif (result.status === \\\"success\\\") {\\n  console.log(result.data);\\n} else {\\n  console.error(result.error);\\n}\"},\"outputHtml\":\"$7c\"},{\"id\":5,\"title\":\"Monitor\",\"description\":\"Watch webpages for changes and get notified via webhook. Price tracking, content updates, and competitor intelligence.\",\"codeHtml\":{\"curl\":\"$7d\",\"python\":\"$7e\",\"javascript\":\"$7f\"},\"codeRaw\":{\"curl\":\"curl -X POST \\\\\\n  https://v2-api.scrapegraphai.com/api/monitor \\\\\\n  -H \\\"Content-Type: application/json\\\" \\\\\\n  -H \\\"SGAI-APIKEY: $SGAI_API_KEY\\\" \\\\\\n  -d '{\\n  \\\"url\\\": \\\"https://example-shop.com/product\\\",\\n  \\\"interval\\\": \\\"0 */6 * * *\\\",\\n  \\\"webhookUrl\\\": \\\"https://your-app.com/webhook\\\",\\n  \\\"formats\\\": [\\n    {\\n      \\\"type\\\": \\\"markdown\\\"\\n    }\\n  ]\\n}'\",\"python\":\"from scrapegraph_py import ScrapeGraphAI, MarkdownFormatConfig\\n\\nsgai = ScrapeGraphAI()\\n\\nresult = sgai.monitor.create(\\n    \\\"https://example-shop.com/product\\\",\\n    \\\"0 */6 * * *\\\",\\n    webhook_url=\\\"https://your-app.com/webhook\\\",\\n    formats=[MarkdownFormatConfig()],\\n)\\n\\nif result.status == \\\"success\\\":\\n    print(result.data)\\nelse:\\n    print(result.error)\",\"javascript\":\"import { ScrapeGraphAI } from \\\"scrapegraph-js\\\";\\n\\nconst sgai = ScrapeGraphAI();\\n\\nconst result = await sgai.monitor.create({\\n  url: \\\"https://example-shop.com/product\\\",\\n  interval: \\\"0 */6 * * *\\\",\\n  webhookUrl: \\\"https://your-app.com/webhook\\\",\\n  formats: [{\\n    type: \\\"markdown\\\",\\n  }],\\n});\\n\\nif (result.status === \\\"success\\\") {\\n  console.log(result.data);\\n} else {\\n  console.error(result.error);\\n}\"},\"outputHtml\":\"$80\"}]}]]}]\n"])</script><script>self.__next_f.push([1,"65:[\"$\",\"$La\",null,{\"src\":\"https://pub-308fdc8a1858487d9ab275774108077b.r2.dev/images/marketing/use-cases/mcp-server-dark.jpeg\",\"alt\":\"MCP Server\",\"fill\":true,\"className\":\"object-cover block dark:hidden\",\"sizes\":\"(max-width: 1024px) 100vw, 33vw\"}]\n66:[\"$\",\"$La\",null,{\"src\":\"https://pub-308fdc8a1858487d9ab275774108077b.r2.dev/images/marketing/use-cases/mcp-server-light.jpeg\",\"alt\":\"MCP Server\",\"fill\":true,\"className\":\"object-cover hidden dark:block\",\"sizes\":\"(max-width: 1024px) 100vw, 33vw\"}]\n67:[\"$\",\"h3\",null,{\"className\":\"text-xl font-semibold mb-3 text-foreground\",\"children\":\"MCP Server\"}]\n"])</script><script>self.__next_