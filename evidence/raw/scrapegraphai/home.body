w, /_next/image?url=https%3A%2F%2Fpub-308fdc8a1858487d9ab275774108077b.r2.dev%2Fimages%2Fblog%2Fscrapegraphai-v2%2Fog-light.webp&amp;w=750&amp;q=75 750w, /_next/image?url=https%3A%2F%2Fpub-308fdc8a1858487d9ab275774108077b.r2.dev%2Fimages%2Fblog%2Fscrapegraphai-v2%2Fog-light.webp&amp;w=828&amp;q=75 828w, /_next/image?url=https%3A%2F%2Fpub-308fdc8a1858487d9ab275774108077b.r2.dev%2Fimages%2Fblog%2Fscrapegraphai-v2%2Fog-light.webp&amp;w=1080&amp;q=75 1080w, /_next/image?url=https%3A%2F%2Fpub-308fdc8a1858487d9ab275774108077b.r2.dev%2Fimages%2Fblog%2Fscrapegraphai-v2%2Fog-light.webp&amp;w=1200&amp;q=75 1200w, /_next/image?url=https%3A%2F%2Fpub-308fdc8a1858487d9ab275774108077b.r2.dev%2Fimages%2Fblog%2Fscrapegraphai-v2%2Fog-light.webp&amp;w=1920&amp;q=75 1920w, /_next/image?url=https%3A%2F%2Fpub-308fdc8a1858487d9ab275774108077b.r2.dev%2Fimages%2Fblog%2Fscrapegraphai-v2%2Fog-light.webp&amp;w=2048&amp;q=75 2048w, /_next/image?url=https%3A%2F%2Fpub-308fdc8a1858487d9ab275774108077b.r2.dev%2Fimages%2Fblog%2Fscrapegraphai-v2%2Fog-light.webp&amp;w=3840&amp;q=75 3840w" src="/_next/image?url=https%3A%2F%2Fpub-308fdc8a1858487d9ab275774108077b.r2.dev%2Fimages%2Fblog%2Fscrapegraphai-v2%2Fog-light.webp&amp;w=3840&amp;q=75"/></div></div><div class="p-5 flex flex-col flex-grow"><div><span class="font-mono text-xs text-muted-foreground mb-3">[ <!-- -->01<!-- --> ]</span></div><h3 class="text-lg font-semibold text-foreground leading-tight mb-3">ScrapeGraphAI V2: Better, Faster and Cheaper</h3><p class="text-sm  leading-relaxed line-clamp-3 flex-grow mb-3">ScrapeGraphAI V2 brings scrape, extract, search, crawl, monitor, events, and history into one cleaner API for production web data workflows.</p><div class="flex justify-between items-center mb-2"><p class="text-sm text-muted-foreground ">Francesco Zuppichini</p><p class="text-sm text-muted-foreground ">Apr 24, 2026</p></div><div class="flex items-center gap-1 font-mono text-[10px] uppercase tracking-widest text-foreground pt-1"><span class="font-medium">Read more</span><span class="transition-transform group-hover:translate-x-1" aria-hidden="true">→</span></div></div></article></a><a class="group block h-full" href="/blog/scrapegraphai-cli"><article class="h-full border border-border bg-background hover:bg-muted/30 transition-colors flex flex-col overflow-hidden"><div class="border-b border-border"><div class="@container w-full"><div class="relative aspect-[1200/630] overflow-hidden bg-[#242424] dark:bg-[#EFEFEF]"><div class="absolute inset-0 flex flex-col px-[5cqw] pt-[4.2cqw] pb-[4.2cqw]"><span class="text-primary font-medium text-[2cqw] uppercase tracking-wide">Tutorials</span><p class="mt-[2cqw] font-bold text-[#EFEFEF] dark:text-[#242424] text-[7.8cqw] leading-[1.08] line-clamp-4">ScrapeGraphAI CLI: Web Scraping From Your Terminal</p><span class="mt-auto self-end text-muted-foreground font-medium text-[2cqw]">ScrapeGraphAI</span></div><div class="absolute top-[4.2cqw] right-[5cqw] h-[4.6cqw] w-auto"><img alt="" aria-hidden="true" loading="lazy" width="120" height="55" decoding="async" data-nimg="1" class="h-full w-auto block dark:hidden" style="color:transparent" src="/logos/logo-light.svg"/><img alt="" aria-hidden="true" loading="lazy" width="120" height="55" decoding="async" data-nimg="1" class="h-full w-auto hidden dark:block" style="color:transparent" src="/logos/logo-dark.svg"/></div></div></div></div><div class="p-5 flex flex-col flex-grow"><div><span class="font-mono text-xs text-muted-foreground mb-3">[ <!-- -->02<!-- --> ]</span></div><h3 class="text-lg font-semibold text-foreground leading-tight mb-3">ScrapeGraphAI CLI: Web Scraping From Your Terminal</h3><p class="text-sm  leading-relaxed line-clamp-3 flex-grow mb-3">Install just-scrape and run AI-powered scraping, extraction, search, and crawling from your terminal. A practical guide to the ScrapeGraphAI CLI with examples.</p><div class="flex justify-between items-center mb-2"><p class="text-sm text-muted-foreground ">Marco Vinciguerra</p><p class="text-sm text-muted-foreground ">May 30, 2026</p></div><div class="flex items-center gap-1 font-mono text-[10px] uppercase tracking-widest text-foreground pt-1"><span class="font-medium">Read more</span><span class="transition-transform group-hover:translate-x-1" aria-hidden="true">→</span></div></div></article></a><a class="group block h-full" href="/blog/scrapegraphai-mcp-server"><article class="h-full border border-border bg-background hover:bg-muted/30 transition-colors flex flex-col overflow-hidden"><div class="border-b border-border"><div class="@container w-full"><div class="relative aspect-[1200/630] overflow-hidden bg-[#242424] dark:bg-[#EFEFEF]"><div class="absolute inset-0 flex flex-col px-[5cqw] pt-[4.2cqw] pb-[4.2cqw]"><span class="text-primary font-medium text-[2cqw] uppercase tracking-wide">Tutorials</span><p class="mt-[2cqw] font-bold text-[#EFEFEF] dark:text-[#242424] text-[7.8cqw] leading-[1.08] line-clamp-4">ScrapeGraphAI MCP Server: Give Your AI the Web</p><span class="mt-auto self-end text-muted-foreground font-medium text-[2cqw]">ScrapeGraphAI</span></div><div class="absolute top-[4.2cqw] right-[5cqw] h-[4.6cqw] w-auto"><img alt="" aria-hidden="true" loading="lazy" width="120" height="55" decoding="async" data-nimg="1" class="h-full w-auto block dark:hidden" style="color:transparent" src="/logos/logo-light.svg"/><img alt="" aria-hidden="true" loading="lazy" width="120" height="55" decoding="async" data-nimg="1" class="h-full w-auto hidden dark:block" style="color:transparent" src="/logos/logo-dark.svg"/></div></div></div></div><div class="p-5 flex flex-col flex-grow"><div><span class="font-mono text-xs text-muted-foreground mb-3">[ <!-- -->03<!-- --> ]</span></div><h3 class="text-lg font-semibold text-foreground leading-tight mb-3">ScrapeGraphAI MCP Server: Give Your AI the Web</h3><p class="text-sm  leading-relaxed line-clamp-3 flex-grow mb-3">Connect Claude, Cursor, and any MCP client to live web data. Set up the ScrapeGraphAI MCP server with the hosted endpoint or a local install in minutes.</p><div class="flex justify-between items-center mb-2"><p class="text-sm text-muted-foreground ">Marco Vinciguerra</p><p class="text-sm text-muted-foreground ">Jun 26, 2026</p></div><div class="flex items-center gap-1 font-mono text-[10px] uppercase tracking-widest text-foreground pt-1"><span class="font-medium">Read more</span><span class="transition-transform group-hover:translate-x-1" aria-hidden="true">→</span></div></div></article></a></div><div class="flex justify-center pt-8"><a class="font-mono text-[10px] font-medium uppercase tracking-widest text-foreground hover:text-primary transition-colors inline-flex items-center gap-2" href="/blog">View all posts <span aria-hidden="true">→</span></a></div></section><section id="faq" class="max-w-[1536px] mx-auto px-6 sm:px-10 lg:px-20 py-16 sm:py-20" aria-labelledby="faq-heading"><div class="max-w-4xl mx-auto text-center mb-10"><p class="font-mono text-xs font-medium uppercase tracking-widest text-muted-foreground mb-6">// FAQ</p><h2 id="faq-heading" class="text-2xl md:text-3xl lg:text-4xl text-foreground text-balance font-semibold tracking-tight">Frequently Asked Questions</h2></div><div class="max-w-3xl mx-auto"><div class="w-full space-y-3"><div class="border last:border-b rounded-lg px-6"><h3 class="flex"><button type="button" id="faq-0-trigger" aria-controls="faq-0-content" aria-expanded="true" data-state="open" class="focus-visible:border-ring focus-visible:ring-ring/50 flex flex-1 items-start justify-between gap-4 rounded-md py-4 text-left text-base font-semibold transition-all outline-none focus-visible:ring-[3px]">What is ScrapeGraphAI?<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-chevron-down text-muted-foreground pointer-events-none size-4 shrink-0 translate-y-0.5 transition-transform duration-200 rotate-180" aria-hidden="true"><path d="m6 9 6 6 6-6"></path></svg></button></h3><section id="faq-0-content" aria-labelledby="faq-0-trigger" data-state="open" class="overflow-hidden text-sm"><div class="pt-0 pb-4 text-foreground/70 text-sm font-mono leading-relaxed">ScrapeGraphAI is an AI-powered web scraping API that lets you extract structured data from any website using natural language prompts. No complex selectors, no brittle scripts. Just describe what you want and get clean JSON back.</div></section></div><div class="border last:border-b rounded-lg px-6"><h3 class="flex"><button type="button" id="faq-1-trigger" aria-controls="faq-1-content" aria-expanded="false" data-state="closed" class="focus-visible:border-ring focus-visible:ring-ring/50 flex flex-1 items-start justify-between gap-4 rounded-md py-4 text-left text-base font-semibold transition-all outline-none focus-visible:ring-[3px]">How does AI-powered web scraping work?<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-chevron-down text-muted-foreground pointer-events-none size-4 shrink-0 translate-y-0.5 transition-transform duration-200" aria-hidden="true"><path d="m6 9 6 6 6-6"></path></svg></button></h3><section id="faq-1-content" aria-labelledby="faq-1-trigger" hidden="" data-state="closed" class="overflow-hidden text-sm"><div class="pt-0 pb-4 text-foreground/70 text-sm font-mono leading-relaxed">You send a URL and a natural language prompt describing the data you need. Our AI models read and understand the page content, then extract exactly the fields you asked for, returned as structured JSON. It handles dynamic content, SPAs, and messy HTML automatically.</div></section></div><div class="border last:border-b rounded-lg px-6"><h3 class="flex"><button type="button" id="faq-2-trigger" aria-controls="faq-2-content" aria-expanded="false" data-state="closed" class="focus-visible:border-ring focus-visible:ring-ring/50 flex flex-1 items-start justify-between gap-4 rounded-md py-4 text-left text-base font-semibold transition-all outline-none focus-visible:ring-[3px]">Do I need to write CSS selectors or XPath to scrape websites?<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-chevron-down text-muted-foreground pointer-events-none size-4 shrink-0 translate-y-0.5 transition-transform duration-200" aria-hidden="true"><path d="m6 9 6 6 6-6"></path></svg></button></h3><section id="faq-2-content" aria-labelledby="faq-2-trigger" hidden="" data-state="closed" class="overflow-hidden text-sm"><div class="pt-0 pb-4 text-foreground/70 text-sm font-mono leading-relaxed">No. ScrapeGraphAI uses large language models to understand page content semantically. You describe what you want in plain English. No selectors, no regex, no DOM traversal. The AI figures out where the data lives.</div></section></div><div class="border last:border-b rounded-lg px-6"><h3 class="flex"><button type="button" id="faq-3-trigger" aria-controls="faq-3-content" aria-expanded="false" data-state="closed" class="focus-visible:border-ring focus-visible:ring-ring/50 flex flex-1 items-start justify-between gap-4 rounded-md py-4 text-left text-base font-semibold transition-all outline-none focus-visible:ring-[3px]">What data formats does the web scraping API support?<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-chevron-down text-muted-foreground pointer-events-none size-4 shrink-0 translate-y-0.5 transition-transform duration-200" aria-hidden="true"><path d="m6 9 6 6 6-6"></path></svg></button></h3><section id="faq-3-content" aria-labelledby="faq-3-trigger" hidden="" data-state="closed" class="overflow-hidden text-sm"><div class="pt-0 pb-4 text-foreground/70 text-sm font-mono leading-relaxed">All responses come back as structured JSON matching your prompt. You can also provide a JSON schema to enforce exact output shapes, perfect for feeding data directly into your pipeline or database.</div></section></div><div class="border last:border-b rounded-lg px-6"><h3 class="flex"><button type="button" id="faq-4-trigger" aria-controls="faq-4-content" aria-expanded="false" data-state="closed" class="focus-visible:border-ring focus-visible:ring-ring/50 flex flex-1 items-start justify-between gap-4 rounded-md py-4 text-left text-base font-semibold transition-all outline-none focus-visible:ring-[3px]">Is ScrapeGraphAI free to use?<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-chevron-down text-muted-foreground pointer-events-none size-4 shrink-0 translate-y-0.5 transition-transform duration-200" aria-hidden="true"><path d="m6 9 6 6 6-6"></path></svg></button></h3><section id="faq-4-content" aria-labelledby="faq-4-trigger" hidden="" data-state="closed" class="overflow-hidden text-sm"><div class="pt-0 pb-4 text-foreground/70 text-sm font-mono leading-relaxed">Yes. The free plan includes 500 API credits, enough to test the API and build a proof of concept. Paid plans start at $20/month with 10,000 credits and scale up from there.</div></section></div><div class="border last:border-b rounded-lg px-6"><h3 class="flex"><button type="button" id="faq-5-trigger" aria-controls="faq-5-content" aria-expanded="false" data-state="closed" class="focus-visible:border-ring focus-visible:ring-ring/50 flex flex-1 items-start justify-between gap-4 rounded-md py-4 text-left text-base font-semibold transition-all outline-none focus-visible:ring-[3px]">Can ScrapeGraphAI scrape JavaScript-rendered pages and SPAs?<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-chevron-down text-muted-foreground pointer-events-none size-4 shrink-0 translate-y-0.5 transition-transform duration-200" aria-hidden="true"><path d="m6 9 6 6 6-6"></path></svg></button></h3><section id="faq-5-content" aria-labelledby="faq-5-trigger" hidden="" data-state="closed" class="overflow-hidden text-sm"><div class="pt-0 pb-4 text-foreground/70 text-sm font-mono leading-relaxed">Yes. ScrapeGraphAI handles JavaScript-heavy pages, single-page applications, and dynamically loaded content out of the box. No need to manage headless browsers yourself.</div></section></div><div class="border last:border-b rounded-lg px-6"><h3 class="flex"><button type="button" id="faq-6-trigger" aria-controls="faq-6-content" aria-expanded="false" data-state="closed" class="focus-visible:border-ring focus-visible:ring-ring/50 flex flex-1 items-start justify-between gap-4 rounded-md py-4 text-left text-base font-semibold transition-all outline-none focus-visible:ring-[3px]">How fast is the ScrapeGraphAI API?<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-chevron-down text-muted-foreground pointer-events-none size-4 shrink-0 translate-y-0.5 transition-transform duration-200" aria-hidden="true"><path d="m6 9 6 6 6-6"></path></svg></button></h3><section id="faq-6-content" aria-labelledby="faq-6-trigger" hidden="" data-state="closed" class="overflow-hidden text-sm"><div class="pt-0 pb-4 text-foreground/70 text-sm font-mono leading-relaxed">Most requests complete in 2-10 seconds depending on page complexity and the amount of data extracted. Frequently requested URLs are cached, so repeat calls come back almost instantly.</div></section></div><div class="border last:border-b rounded-lg px-6"><h3 class="flex"><button type="button" id="faq-7-trigger" aria-controls="faq-7-content" aria-expanded="false" data-state="closed" class="focus-visible:border-ring focus-visible:ring-ring/50 flex flex-1 items-start justify-between gap-4 rounded-md py-4 text-left text-base font-semibold transition-all outline-none focus-visible:ring-[3px]">Is there an MCP server for AI agents?<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-chevron-down text-muted-foreground pointer-events-none size-4 shrink-0 translate-y-0.5 transition-transform duration-200" aria-hidden="true"><path d="m6 9 6 6 6-6"></path></svg></button></h3><section id="faq-7-content" aria-labelledby="faq-7-trigger" hidden="" data-state="closed" class="overflow-hidden text-sm"><div class="pt-0 pb-4 text-foreground/70 text-sm font-mono leading-relaxed">Yes. We provide an official MCP (Model Context Protocol) server so AI agents like Claude, Cursor, and Windsurf can use ScrapeGraphAI as a tool directly. Install it with one command and your agent gets web scraping superpowers.</div></section></div></div></div></section><section id="cta" class="mx-auto max-w-[1536px] px-6 py-16 sm:px-10 sm:py-20 lg:px-20"><div class="mx-auto mb-10 max-w-4xl text-center"><p class="mb-6 font-mono text-xs font-medium uppercase tracking-widest text-muted-foreground">Ready to start</p><h2 class="text-balance text-2xl font-semibold tracking-tight text-foreground md:text-3xl lg:text-4xl">Give your AI Agent superpowers with lightning-fast web data!</h2></div><div class="mx-auto text-center"><div class="flex justify-center"><a data-slot="button" data-variant="default" data-size="default" class="justify-center whitespace-nowrap rounded-md font-mono text-[11px] font-medium uppercase tracking-widest transition-all disabled:pointer-events-none disabled:opacity-50 [&amp;_svg]:pointer-events-none [&amp;_svg:not([class*=&#x27;size-&#x27;])]:size-4 shrink-0 [&amp;_svg]:shrink-0 outline-none focus-visible:border-ring focus-visible:ring-ring/50 focus-visible:ring-[3px] aria-invalid:ring-destructive/20 dark:aria-invalid:ring-destructive/40 aria-invalid:border-destructive bg-primary text-primary-foreground hover:bg-primary/90 h-9 px-4 py-2 has-[&gt;svg]:px-3 flex items-center gap-2" href="/signup">Get Started <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-arrow-right h-4 w-4" aria-hidden="true"><path d="M5 12h14"></path><path d="m12 5 7 7-7 7"></path></svg></a></div></div></section><!--$--><!--/$--></main><footer class="theme-inverted bg-background"><div class="max-w-[1536px] mx-auto px-6 sm:px-10 lg:px-20 pt-16 pb-6"><div class="flex flex-col gap-6 sm:flex-row sm:items-end sm:justify-between"><h2 class="max-w-full font-display font-semibold text-[clamp(2.5rem,14vw,7rem)] leading-[0.95] tracking-tighter text-foreground">ScrapeGraphAI</h2><div aria-hidden="true" class="relative block shrink-0 self-start invert dark:invert-0" style="width:134px;height:0;visibility:hidden"><div class="absolute top-0 left-0 bg-no-repeat" style="width:134px;height:0;background-image:url(&quot;https://pub-308fdc8a1858487d9ab275774108077b.r2.dev/images/spider/spider-4x4-sprite.png&quot;);background-size:536px 0px;background-position:-0px -0px;image-rendering:pixelated"></div></div></div><hr class="mt-8 mb-8 border-border"/><div class="grid grid-cols-1 gap-10 md:grid-cols-[minmax(0,1.3fr)_minmax(0,0.7fr)]"><div class="grid grid-cols-2 gap-x-8 gap-y-10 sm:max-w-md sm:gap-x-16"><div class="space-y-3"><h3 class="font-mono text-[10px] font-medium uppercase tracking-widest text-muted-foreground">Product</h3><ul class="space-y-2"><li><a class="font-mono text-[10px] font-medi