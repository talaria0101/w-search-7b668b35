cqw]\",\"children\":[[\"$\",\"span\",null,{\"className\":\"text-primary font-medium text-[2cqw] uppercase tracking-wide\",\"children\":\"Tutorials\"}],[\"$\",\"p\",null,{\"className\":\"mt-[2cqw] font-bold text-[#EFEFEF] dark:text-[#242424] text-[7.8cqw] leading-[1.08] line-clamp-4\",\"children\":\"ScrapeGraphAI CLI: Web Scraping From Your Terminal\"}],[\"$\",\"span\",null,{\"className\":\"mt-auto self-end text-muted-foreground font-medium text-[2cqw]\",\"children\":\"ScrapeGraphAI\"}]]}],\"$L5f\"]}]}]}],\"$L60\"]}]}],\"$L61\"]}],\"$L62\"]}]\n"])</script><script>self.__next_f.push([1,"33:[\"$\",\"section\",null,{\"id\":\"faq\",\"className\":\"max-w-[1536px] mx-auto px-6 sm:px-10 lg:px-20 py-16 sm:py-20\",\"aria-labelledby\":\"faq-heading\",\"children\":[[\"$\",\"div\",null,{\"className\":\"max-w-4xl mx-auto text-center mb-10\",\"children\":[[\"$\",\"p\",null,{\"className\":\"font-mono text-xs font-medium uppercase tracking-widest text-muted-foreground mb-6\",\"children\":\"// FAQ\"}],[\"$\",\"h2\",null,{\"id\":\"faq-heading\",\"className\":\"text-2xl md:text-3xl lg:text-4xl text-foreground text-balance font-semibold tracking-tight\",\"children\":\"Frequently Asked Questions\"}]]}],[\"$\",\"$L63\",null,{\"items\":[{\"question\":\"What is ScrapeGraphAI?\",\"answer\":\"ScrapeGraphAI is an AI-powered web scraping API that lets you extract structured data from any website using natural language prompts. No complex selectors, no brittle scripts. Just describe what you want and get clean JSON back.\"},{\"question\":\"How does AI-powered web scraping work?\",\"answer\":\"You send a URL and a natural language prompt describing the data you need. Our AI models read and understand the page content, then extract exactly the fields you asked for, returned as structured JSON. It handles dynamic content, SPAs, and messy HTML automatically.\"},{\"question\":\"Do I need to write CSS selectors or XPath to scrape websites?\",\"answer\":\"No. ScrapeGraphAI uses large language models to understand page content semantically. You describe what you want in plain English. No selectors, no regex, no DOM traversal. The AI figures out where the data lives.\"},{\"question\":\"What data formats does the web scraping API support?\",\"answer\":\"All responses come back as structured JSON matching your prompt. You can also provide a JSON schema to enforce exact output shapes, perfect for feeding data directly into your pipeline or database.\"},{\"question\":\"Is ScrapeGraphAI free to use?\",\"answer\":\"Yes. The free plan includes 500 API credits, enough to test the API and build a proof of concept. Paid plans start at $20/month with 10,000 credits and scale up from there.\"},{\"question\":\"Can ScrapeGraphAI scrape JavaScript-rendered pages and SPAs?\",\"answer\":\"Yes. ScrapeGraphAI handles JavaScript-heavy pages, single-page applications, and dynamically loaded content out of the box. No need to manage headless browsers yourself.\"},{\"question\":\"How fast is the ScrapeGraphAI API?\",\"answer\":\"Most requests complete in 2-10 seconds depending on page complexity and the amount of data extracted. Frequently requested URLs are cached, so repeat calls come back almost instantly.\"},{\"question\":\"Is there an MCP server for AI agents?\",\"answer\":\"Yes. We provide an official MCP (Model Context Protocol) server so AI agents like Claude, Cursor, and Windsurf can use ScrapeGraphAI as a tool directly. Install it with one command and your agent gets web scraping superpowers.\"}]}]]}]\n"])</script><script>self.__next_f.push([1,"34:[\"$\",\"$L64\",null,{}]\n"])</script><script>self.__next_f.push([1,"6c:I[450288,[\"/_next/static/chunks/07-cl2b9xstko.js\",\"/_next/static/chunks/27i25u_zuh3lu.js\",\"/_next/static/chunks/3jm796h_31c0l.js\",\"/_next/static/chunks/3p1wam3rw0icd.js\",\"/_next/static/chunks/16jwv1l_-h3s5.js\",\"/_next/static/chunks/1fqwttfzu3jl9.js\",\"/_next/static/chunks/2av--8-87l3bg.js\",\"/_next/static/chunks/39w3rabxc2ugj.js\",\"/_next/static/chun