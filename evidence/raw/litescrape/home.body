<script data-seo-managed="true" id="seo-json-ld" type="application/ld+json">{"@context":"https://schema.org","@graph":[{"@type":"Organization","@id":"https://litescrape.com/#organization","name":"Litescrape","url":"https://litescrape.com/"},{"@type":"WebSite","@id":"https://litescrape.com/#website","url":"https://litescrape.com/","name":"Litescrape","publisher":{"@id":"https://litescrape.com/#organization"},"inLanguage":"en-US"},{"@type":"WebPage","@id":"https://litescrape.com/#webpage","url":"https://litescrape.com/","name":"Cheapest SERP API: $0.15 per 1,000 Searches | Litescrape","description":"The cheapest SERP API: Google, Bing, DuckDuckGo, and Maps for a flat $0.15 per 1,000 requests. Prepay from $10 for credits that last six months.","isPartOf":{"@id":"https://litescrape.com/#website"},"inLanguage":"en-US"},{"@type":"SoftwareApplication","@id":"https://litescrape.com/#software","name":"Litescrape SERP API","applicationCategory":"DeveloperApplication","operatingSystem":"Any","url":"https://litescrape.com/","description":"The cheapest SERP API: Google, Bing, DuckDuckGo, and Maps for a flat $0.15 per 1,000 requests. Prepay from $10 for credits that last six months.","publisher":{"@id":"https://litescrape.com/#organization"},"offers":{"@type":"Offer","url":"https://litescrape.com/pricing","price":"0.15","priceCurrency":"USD","availability":"https://schema.org/InStock","priceSpecification":{"@type":"UnitPriceSpecification","price":"0.15","priceCurrency":"USD","referenceQuantity":{"@type":"QuantitativeValue","value":1000,"unitText":"requests"}}}},{"@type":"FAQPage","@id":"https://litescrape.com/#faq","mainEntity":[{"@type":"Question","name":"What is a SERP API?","acceptedAnswer":{"@type":"Answer","text":"A SERP API returns search engine results pages as structured JSON instead of HTML. You send a query and a location, and Litescrape returns organic results, Knowledge Graph panels, and rich SERP modules from Google, Bing, or DuckDuckGo without running browsers or proxies yourself."}},{"@type":"Question","name":"How much does the Litescrape SERP API cost?","acceptedAnswer":{"@type":"Answer","text":"A flat $0.15 per 1,000 requests for every endpoint. There are no plans, seats, or monthly fees. Prepay from $10, which buys 66,667 requests, and the credits last six months."}},{"@type":"Question","name":"Is there a free SERP API tier?","acceptedAnswer":{"@type":"Answer","text":"Every new visitor key comes with 5 free calls and no card is required. Use them in the playground on this page or from your own code, then top up the same key when you need more."}},{"@type":"Question","name":"How does Litescrape compare with Serper, SerpApi, and Scrapingdog on price?","acceptedAnswer":{"@type":"Answer","text":"Serper's entry pack works out to $1.00 per 1,000 searches and its credits expire after six months. SerpApi's Starter plan is $25 a month for 1,000 searches. Scrapingdog's Lite plan is $40 a month for 40,000 Google searches. Litescrape is $0.15 per 1,000 at any volume, and credits last six months."}},{"@type":"Question","name":"Which search engines and result types are covered?","acceptedAnswer":{"@type":"Answer","text":"Google Search, Google Ads, Google Local, Google Shopping, Google AI Mode, Bing, and DuckDuckGo for SERPs; Google Maps, Bing Maps, DuckDuckGo Maps, Apple Maps, Yelp, and Tripadvisor for places; Google, Apple, Yelp, and Tripadvisor reviews. All as typed JSON."}},{"@type":"Question","name":"Do I need a subscription or a credit card to start?","acceptedAnswer":{"@type":"Answer","text":"No. Your first 5 calls are free with no card. After that you buy credit top-ups through Stripe starting at $10. You can optionally enable automatic top-ups with a monthly spending limit in your dashboard."}},{"@type":"Question","name":"Is there a concurrency limit?","acceptedAnswer":{"@type":"Answer","text":"Yes. Each key can run 25 requests concurrently. Email support@litescrape.com to have the limit raised."}},{"@type":"Question","name":"Is there an SDK?","acceptedAnswer":{"@type":"Answer","text":"Yes. pip install litescrape-sdk, then call scrape() with a list of requests. It retries transient errors automatically, runs at your key's concurrency limit, and returns results in the order you sent them."}}]}]}</script>
