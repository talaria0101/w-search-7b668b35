ption><option value="instagram-profile" data-v-33095c99>Instagram Profile</option><option value="instagram-profile-post-count" data-v-33095c99>Instagram Profile Post Count</option><option value="instagram-search-popular" data-v-33095c99>Instagram Search Popular</option><!--]--></optgroup><optgroup label="Jobs by Ashby" data-v-33095c99><!--[--><option value="ashby-search" data-v-33095c99>Jobs by Ashby Search</option><!--]--></optgroup><optgroup label="Kroger" data-v-33095c99><!--[--><option value="kroger-product" data-v-33095c99>Kroger Product</option><option value="kroger-search" data-v-33095c99>Kroger Search</option><!--]--></optgroup><optgroup label="Levels.fyi" data-v-33095c99><!--[--><option value="levels-search" data-v-33095c99>Levels.fyi Search</option><!--]--></optgroup><optgroup label="Microsoft" data-v-33095c99><!--[--><option value="copilot-chat-completions" data-v-33095c99>Microsoft Copilot Chat Completions</option><!--]--></optgroup><optgroup label="Naver" data-v-33095c99><!--[--><option value="naver-search" data-v-33095c99>Naver Search</option><option value="naver-ai-overview" data-v-33095c99>Naver AI Overview</option><!--]--></optgroup><optgroup label="Realtor.com" data-v-33095c99><!--[--><option value="realtor-property" data-v-33095c99>Realtor.com Property</option><option value="realtor-search" data-v-33095c99>Realtor.com Search</option><!--]--></optgroup><optgroup label="Redfin" data-v-33095c99><!--[--><option value="redfin-property" data-v-33095c99>Redfin Property</option><option value="redfin-search" data-v-33095c99>Redfin Search</option><!--]--></optgroup><optgroup label="Sprouts" data-v-33095c99><!--[--><option value="sprouts-product" data-v-33095c99>Sprouts Product</option><option value="sprouts-search" data-v-33095c99>Sprouts Search</option><!--]--></optgroup><optgroup label="Target" data-v-33095c99><!--[--><option value="target-product" data-v-33095c99>Target Product</option><option value="target-search" data-v-33095c99>Target Search</option><!--]--></optgroup><optgroup label="TikTok" data-v-33095c99><!--[--><option value="tiktok-collection-videos" data-v-33095c99>TikTok Collection Videos</option><option value="tiktok-comment-replies" data-v-33095c99>TikTok Comment Replies</option><option value="tiktok-comments" data-v-33095c99>TikTok Comments</option><option value="tiktok-followers" data-v-33095c99>TikTok Followers</option><option value="tiktok-following" data-v-33095c99>TikTok Following</option><option value="tiktok-live" data-v-33095c99>TikTok Live Room</option><option value="tiktok-profile" data-v-33095c99>TikTok Profile</option><option value="tiktok-profile-videos" data-v-33095c99>TikTok Profile Videos</option><option value="tiktok-search-hashtag" data-v-33095c99>TikTok Search Hashtag</option><option value="tiktok-search-keyword" data-v-33095c99>TikTok Search Keyword</option><option value="tiktok-search-suggestions" data-v-33095c99>TikTok Search Suggestions</option><option value="tiktok-search-top" data-v-33095c99>TikTok Search Top</option><option value="tiktok-song" data-v-33095c99>TikTok Song</option><option value="tiktok-song-videos" data-v-33095c99>TikTok Song Videos</option><option value="tiktok-transcript" data-v-33095c99>TikTok Transcript</option><option value="tiktok-trending-feed" data-v-33095c99>TikTok Trending Feed</option><option value="tiktok-user-live" data-v-33095c99>TikTok User Live</option><option value="tiktok-video" data-v-33095c99>TikTok Video</option><!--]--></optgroup><optgroup label="Tripadvisor" data-v-33095c99><!--[--><option value="tripadvisor-search" data-v-33095c99>Tripadvisor Search</option><option value="tripadvisor-place" data-v-33095c99>Tripadvisor Place</option><option value="tripadvisor-reviews" data-v-33095c99>Tripadvisor Reviews</option><!--]--></optgroup><optgroup label="Walmart" data-v-33095c99><!--[--><option value="walmart-product" data-v-33095c99>Walmart Product</option><option value="walmart-search" data-v-33095c99>Walmart Search</option><!--]--></optgroup><optgroup label="Wayfair" data-v-33095c99><!--[--><option value="wayfair-product" data-v-33095c99>Wayfair Product</option><option value="wayfair-search" data-v-33095c99>Wayfair Search</option><!--]--></optgroup><optgroup label="Whole Foods" data-v-33095c99><!--[--><option value="wholefoods-product" data-v-33095c99>Whole Foods Product</option><option value="wholefoods-search" data-v-33095c99>Whole Foods Search</option><!--]--></optgroup><optgroup label="X" data-v-33095c99><!--[--><option value="x-community" data-v-33095c99>X Community</option><option value="x-community-posts" data-v-33095c99>X Community Posts</option><option value="x-post" data-v-33095c99>X Post</option><option value="x-profile" data-v-33095c99>X Profile</option><option value="x-user-posts" data-v-33095c99>X User Posts</option><!--]--></optgroup><optgroup label="Yahoo" data-v-33095c99><!--[--><option value="yahoo-search" data-v-33095c99>Yahoo Search</option><option value="yahoo-images" data-v-33095c99>Yahoo Images</option><!--]--></optgroup><optgroup label="Yandex" data-v-33095c99><!--[--><option value="yandex-images" data-v-33095c99>Yandex Images</option><option value="yandex-search" data-v-33095c99>Yandex Search</option><!--]--></optgroup><optgroup label="Yelp" data-v-33095c99><!--[--><option value="yelp-place" data-v-33095c99>Yelp Place</option><option value="yelp-search" data-v-33095c99>Yelp Search</option><option value="yelp-reviews" data-v-33095c99>Yelp Reviews</option><!--]--></optgroup><optgroup label="YouTube" data-v-33095c99><!--[--><option value="youtube-channel" data-v-33095c99>YouTube Channel</option><option value="youtube-search" data-v-33095c99>YouTube Search</option><!--]--></optgroup><optgroup label="Zillow" data-v-33095c99><!--[--><option value="zillow-locations" data-v-33095c99>Zillow Locations</option><option value="zillow-property" data-v-33095c99>Zillow Property</option><option value="zillow-search" data-v-33095c99>Zillow Search</option><!--]--></optgroup><optgroup label="ZipRecruiter" data-v-33095c99><!--[--><option value="ziprecruiter-search" data-v-33095c99>ZipRecruiter Search</option><!--]--></optgroup><!--]--></select></label><!--[--><label class="hero-api-field" data-v-33095c99><span>Query</span><input name="q" type="text" value="coffee maker" placeholder="coffee shops in Austin" autocomplete="off"><small>Google Search query, up to 2,048 characters. Required unless ludocid, kgmid, or page_token is supplied. Maximum characters: 2048</small></label><!--]--><details class="integration__options" open data-v-33095c99><summary data-v-33095c99>More options <span data-v-33095c99>42</span></summary><div class="integration__option-groups" data-v-33095c99><!--[--><details class="parameter-fieldset parameter-fieldset--group" data-v-33095c99><summary class="parameter-fieldset__summary" data-v-33095c99>Query or entity</summary><div class="parameter-fieldset__content" data-v-33095c99><p data-v-33095c99>Supply a query, Google local CID, or Knowledge Graph machine ID.</p><div class="integration__option-fields" data-v-33095c99><!--[--><label class="hero-api-field" data-v-33095c99><span>Fast mode</span><select name="fast_mode" value=""><!--[--><option value="">Default (false)</option><option value="true">true</option><option value="false">false</option><!--]--></select><small>Return organic results only, skipping AI Overview and all other result groups. Keeps search metadata and parameters. Omits cross-module position_absolute.</small></label><label class="hero-api-field" data-v-33095c99><span>Local CID</span><input name="ludocid" type="text" value="" placeholder="1234567890123456789" autocomplete="off"><small>Google local CID used to search for one entity. Maximum characters: 128 Pattern: ^\d+$</small></label><label class="hero-api-field" data-v-33095c99><span>Knowledge Graph ID</span><input name="kgmid" type="text" value="" placeholder="/m/0k8z" autocomplete="off"><small>Google Knowledge Graph machine ID, such as /m/0k8z. Maximum characters: 512</small></label><!--]--></div></div></details><details class="parameter-fieldset parameter-fieldset--group" data-v-33095c99><summary class="parameter-fieldset__summary" data-v-33095c99>Geography</summary><div class="parameter-fieldset__content" data-v-33095c99><p data-v-33095c99>Choose location, uule, or latitude and longitude. Radius depends on device.</p><div class="integration__option-fields" data-v-33095c99><!--[--><label class="hero-api-field" data-v-33095c99><span>Location</span><input name="location" type="text" value="" placeholder="Austin, Texas" autocomplete="off"><small>Human-readable city-level location encoded to UULE by Litescrape. Conflicts with uule and lat/lon. Maximum characters: 512</small></label><label class="hero-api-field" data-v-33095c99><span>UULE</span><textarea name="uule" placeholder="w+CAIQICI…" rows="2"></textarea><small>Pre-encoded Google location value. Conflicts with location and lat/lon. Maximum characters: 2048</small></label><label class="hero-api-field" data-v-33095c99><span>Latitude</span><input name="lat" type="number" value="" placeholder="30.2672" autocomplete="off"><small>Latitude from -90 through 90. Requires lon and conflicts with location and uule. Minimum: -90 Maximum: 90</small></label><label class="hero-api-field" data-v-33095c99><span>Longitude</span><input name="lon" type="number" value="" placeholder="-97.7431" autocomplete="off"><small>Longitude from -180 through 180. Requires lat and conflicts with location and uule. Minimum: -180 Maximum: 180</small></label><label class="hero-api-field" data-v-33095c99><span>Radius (meters)</span><input name="radius" type="number" value="" placeholder="150.75" autocomplete="off"><small>Decimal search-bias radius in meters. Requires location or lat/lon. Desktop: 1–199; tablet/mobile: 1–1,000. Minimum: 1 Maximum: 1000</small></label><!--]--></div></div></details><details class="parameter-fieldset parameter-fieldset--group" data-v-33095c99><summary class="parameter-fieldset__summary" data-v-33095c99>Knowledge Graph controls</summary><div class="parameter-fieldset__content" data-v-33095c99><p data-v-33095c99>Pass Google entity, layout, and cached-context tokens without rewriting them.</p><div class="integration__option-fields" data-v-33095c99><!--[--><label class="hero-api-field" data-v-33095c99><span>lsig</span><textarea name="lsig" rows="2"></textarea><small>Opaque Knowledge Graph or local-pack signature. Maximum characters: 4096</small></label><label class="hero-api-field" data-v-33095c99><span>si</span><textarea name="si" rows="2"></textarea><small>Opaque cached Google search context. Maximum characters: 4096</small></label><label class="hero-api-field" data-v-33095c99><span>ibp</span><textarea name="ibp" rows="2"></textarea><small>Google layout or expansion control. Maximum characters: 4096</small></label><label class="hero-api-field" data-v-33095c99><span>uds</span><textarea name="uds" rows="2"></textarea><small>Opaque Google filter token. Maximum characters: 4096</small></label><label class="hero-api-field" data-v-33095c99><span>Color scheme</span><select name="color_scheme" value=""><!--[--><option value="">Omit</option><option value="light">light</option><option value="dark">dark</option><!--]--></select><small>Google result color presentation.</small></label><!--]--></div></div></details><details class="parameter-fieldset parameter-fieldset--group" data-v-33095c99><summary class="parameter-fieldset__summary" data-v-33095c99>Localization</summary><div class="parameter-fieldset__content" data-v-33095c99><p data-v-33095c99>Control Google domain, language, country, restrictions, and device.</p><div class="integration__option-fields" data-v-33095c99><!--[--><label class="hero-api-field" data-v-33095c99><span>Google domain</span><input name="google_domain" type="text" value="" placeholder="google.com" autocomplete="off"><small>Results use google.com. Use gl, hl, cr, lr or geography for localization.</small></label><label class="hero-api-field" data-v-33095c99><span>Country</span><input name="gl" type="text" value="us" placeholder="us" autocomplete="off"><small>Lowercase two-letter country localization code. Pattern: ^[a-z]{2}$</small></label><label class="hero-api-field" data-v-33095c99><span>Language</span><input name="hl" type="text" value="en" placeholder="en" autocomplete="off"><small>Google interface and result language code. Pattern: ^[a-z]{2,3}(?:-[A-Za-z]{2,8})?$</small></label><label class="hero-api-field" data-v-33095c99><span>Country restrict</span><input name="cr" type="text" value="" placeholder="countryUS" autocomplete="off"><small>One or more countryXX restrictions joined with |. Pattern: ^country[A-Z]{2}(?:\|country[A-Z]{2})*$</small></label><label class="hero-api-field" data-v-33095c99><span>Language restrict</span><input name="lr" type="text" value="" placeholder="lang_en" autocomplete="off"><small>One or more lang_xx restrictions joined with |. Pattern: ^lang_[a-z]{2,3}(?:\|lang_[a-z]{2,3})*$</small></label><label class="hero-api-field" data-v-33095c99><span>Device</span><select name="device" value="desktop"><!--[--><option value="">Default (desktop)</option><option value="desktop">desktop</option><option value="tablet">tablet</option><option value="mobile">mobile</option><!--]--></select><small>Request device profile and radius bound.</small></label><!--]--></div></div></details><details class="parameter-fieldset parameter-fieldset--group" data-v-33095c99><summary class="parameter-fieldset__summary" data-v-33095c99>Filtering &amp; pagination</summary><div class="parameter-fieldset__content" data-v-33095c99><p data-v-33095c99>Apply native Google filtering, vertical, date, safety, and offset controls.</p><div class="integration__option-fields" data-v-33095c99><!--[--><label class="hero-api-field" data-v-33095c99><span>Search filter</span><textarea name="tbs" rows="2"></textarea><small>Google native date or search filter string. Maximum characters: 4096</small></label><label class="hero-api-field" data-v-33095c99><span>Safe search</span><select name="safe" value=""><!--[--><option value="">Omit</option><option value="active">active</option><option value="off">off</option><!--]--></select><small>Google adult-content filtering.</small></label><label class="hero-api-field" data-v-33095c99><span>Auto-correction</span><select name="nfpr" value=""><!--[--><option value="">Omit</option><option value="0">0</option><option value="1">1</option><!--]--></select><small>Google auto-correction control.</small></label><label class="hero-api-field" data-v-33095c99><span>Similar results</span><select name="filter" value=""><!--[--><option value="">Omit</option><option value="0">0</option><option value="1">1</option><!--]--></select><small>Google similar-result filtering control.</small></label><label class="hero-api-field" data-v-33095c99><span>Personalization</span><select name="pws" value=""><!--[--><option value="">Omit</option><option value="0">0</option><option value="1">1</option><!--]--></select><small>Google personalization control; 0 asks for non-personalized results.</small></label><label class="hero-api-field" data-v-33095c99><span>Personalization peek</span><select name="peek_pws" value=""><!--[--><option value="">Omit</option><option value="0">0</option><option value="1">1</option><!--]--></select><small>Google personalization peek flag, forwarded unchanged.</small></label><label class="hero-api-field" data-v-33095c99><span>Vertical</span><select name="tbm" value=""><!--[--><option value="">Omit</option><option value="lcl">lcl</option><option value="vid">vid</option><option value="nws">nws</option><option value="shop">shop</option><option value="pts">pts</option><!--]--></select><small>Google vertical: lcl, vid, nws, shop, or pts. For image searches, use /api/google/images.</small></label><label class="hero-api-field" data-v-33095c99><span>Start offset</span><input name="start" type="number" value="" placeholder="0" autocomplete="off"><small>Non-negative Google result offset. Prefer page_token to repeating the same search with start=10, start=20, or another offset. Minimum: 0</small></label><label class="hero-api-field" data-v-33095c99><span>Results requested</span><input name="num" type="number" value="" placeholder="10" autocomplete="off"><small>Best-effort first-page result count, 1 to 10. Minimum: 1 Maximum: 10</small></label><!--]--></div></div></details><details class="parameter-fieldset parameter-fieldset--group" data-v-33095c99><summary class="parameter-fieldset__summary" data-v-33095c99>Advanced query</summary><div class="parameter-fieldset__content" data-v-33095c99><p data-v-33095c99>Expose Google’s complete advanced-search parameter family.</p><div class="integration__option-fields" data-v-33095c99><!--[--><label class="hero-api-field" data-v-33095c99><span>Original query</span><input name="oq" type="text" value="" autocomplete="off"><small>Original query associated with an autocomplete selection. Maximum characters: 2048</small></label><label class="hero-api-field" data-v-33095c99><span>Autocomplete lineage</span><input name="gs_lp" type="text" value="" autocomplete="off"><small>Google gs_lp value associated with an autocomplete selection. Maximum characters: 4096</small></label><label class="hero-api-field" data-v-33095c99><span>Search client</span><input name="sclient" type="text" value="" placeholder="gws-wiz-serp" autocomplete="off"><small>Google client identifier such as gws-wiz-serp. Maximum characters: 64 Pattern: ^[A-Za-z0-9._-]+$</small></label><label class="hero-api-field" data-v-33095c99><span>Site mode</span><select name="as_dt" value=""><!--[--><option value="">Omit</option><option value="i">i</option><option value="e">e</option><!--]--></select><small>Includes or excludes as_sitesearch. Requires as_sitesearch.</small></label><label class="hero-api-field" data-v-33095c99><span>Exact phrase</span><input name="as_epq" type="text" value="" autocomplete="off"><small>Exact phrase query. Maximum characters: 2048</small></label><label class="hero-api-field" data-v-33095c99><span>Exclude phrase</span><input name="as_eq" type="text" value="" autocomplete="off"><small>Excluded phrase query. Maximum characters: 2048</small></label><label class="hero-api-field" data-v-33095c99><span>Links to URL</span><input name="as_lq" type="text" value="" placeholder="https://example.com" autocomplete="off"><small>Require results that link to this URL. Maximum characters: 4096</small></label><label class="hero-api-field" data-v-33095c99><span>Range low</span><input name="as_nlo" type="number" value="" placeholder="10" autocomplete="off"><small>Inclusive range lower bound. Requires as_nhi. Minimum: 0</small></label><label class="hero-api-field" data-v-33095c99><span>Range high</span><input name="as_nhi" type="number" value="" placeholder="100" autocomplete="off"><small>Inclusive range upper bound. Requires as_nlo. Minimum: 0</small></label><label class="hero-api-field" data-v-33095c99><span>Any terms</span><input name="as_oq" type="text" value="" autocomplete="off"><small>Any-of search terms. Maximum characters: 2048</small></label><label class="hero-api-field" data-v-33095c99><span>All terms</span><input name="as_q" type="text" value="" autocomplete="off"><small>Additional all-of search terms. Maximum characters: 2048</small></label><label class="hero-api-field" data-v-33095c99><span>Date range</span><input name="as_qdr" type="text" value="" placeholder="m3" autocomplete="off"><small>Quick range d, w, m, or y with an optional positive count. Pattern: ^[dwmy](?:[1-9][0-9]*)?$</small></label><label class="hero-api-field" data-v-33095c99><span>Related to URL</span><input name="as_rq" type="text" value="" placeholder="https://example.com" autocomplete="off"><small>Find pages related to this URL. Maximum characters: 4096</small></label><label class="hero-api-field" data-v-33095c99><span>Site hostname</span><input name="as_sitesearch" type="text" value="" placeholder="example.com" autocomplete="off"><small>Site hostname to include or exclude. Maximum characters: 253</small></label><!--]--></div></div></details><!--]--></div></details><p class="integration__request-note" data-v-33095c99>Your request updates the code instantly.</p><!----><a href="/playground" class="text-link" data-v-33095c99>Open the Playground →</a></div><div class="integration__code" data-v-33095c99><div class="integration__tabs" role="tablist" aria-label="Integration method" data-v-33095c99><!--[--><button id="integration-tab-mcp" type="button" role="tab" aria-selected="true" aria-controls="integration-panel-mcp" tabindex="0" data-v-33095c99>MCP</button><button id="integration-tab-python" type="button" role="tab" aria-selected="false" aria-controls="integration-panel-python" tabindex="-1" data-v-33095c99>Python SDK</button><button id="integration-tab-typescript" type="button" role="tab" aria-selected="false" aria-controls="integration-panel-typescript" tabindex="-1" data-v-33095c99>TypeScript SDK</button><button id="integration-tab-curl" type="button" role="tab" aria-selected="false" aria-controls="integration-panel-curl" tabindex="-1" data-v-33095c99>cURL</button><!--]--></div><div id="integration-panel-mcp" class="integration__panel" role="tabpanel" aria-labelledby="integration-tab-mcp" tabindex="0" data-v-33095c99><div class="integration__setup" data-v-33095c99><code data-v-33095c99>https://ecll-litescrape-v3--site-mcp.modal.run/mcp</code><button type="button" aria-label="Copy MCP server URL" data-v-33095c99>Copy</button></div><p class="integration__hint" data-v-33095c99>Add the server URL to your MCP client, then call the tool below. A free allowance is available without a key.</p><!--[--><div class="integration__filename" data-v-33095c99><span data-v-33095c99>tools/call.json</span><button type="button" aria-label="Copy MCP request" data-v-33095c99>Copy request</button></div><pre data-v-33095c99><code data-v-33095c99>{
  &quot;jsonrpc&quot;: &quot;2.0&quot;,
  &quot;id&quot;: 1,
  &quot;method&quot;: &quot;tools/call&quot;,
  &quot;params&quot;: {
    &quot;name&quot;: &quot;google_search&quot;,
    &quot;arguments&quot;: {
      &quot;q&quot;: &quot;coffee maker&quot;,
      &quot;gl&quot;: &quot;us&quot;,
      &quot;hl&quot;: &quot;en&quot;,
      &quot;device&quot;: &quot;desktop&quot;
    }
  }
}</code></pre><!--]--></div></div></div><div class="integration__footer" data-v-33095c99><p aria-live="polite" role="status" data-v-33095c99></p><a href="/docs" class="text-link" data-v-33095c99>Read the docs →</a></div></section><section id="compare" class="section shell"><div class="section-heading"><p class="eyebrow">// why it&#39;s the cheapest</p><h2>The cheapest SERP API, <span class="home-accent">per 1,000 requests</span></h2><p> Public list prices for 100,000 Google searches a month, normalized to one request and ranked from cheapest to most expensive. Litescrape&#39;s rate is flat at every volume; most other providers sell credits, packs, or subscription tiers. </p></div><div class="table-wrap serp-price-table"><table><caption> Google Search pricing at 100,000 requests per month, month-to-month billing, public list prices as of August 2026. </caption><thead><tr><th scope="col">Provider</th><th scope="col">Plan modeled</th><th scope="col">Per 1,000 requests</th><th scope="col">Monthly cost</th></tr></thead><tbody><!--[--><tr class="serp-price-table__row--winner" data-provider="litescrape"><td>Litescrape</td><td>Flat prepaid rate</td><td>$0.15</td><td>$15.00</td></tr><tr class="" data-provider="searlo"><td>Searlo</td><td>Scale</td><td>$0.30</td><td>$30.00</td></tr><tr class="" data-provider="dataforseo"><td>DataForSEO (queue)</td><td>Standard Queue · 1 organic SERP</td><td>$0.60</td><td>$60.00</td></tr><tr class="" data-provider="serper"><td>Serper</td><td>Standard</td><td>$0.75</td><td>$75.00</td></tr><tr class="" data-provider="scrapingdog"><td>Scrapingdog</td><td>Standard</td><td>$0.90</td><td>$90.00</td></tr><tr class="" data-provider="cloro"><td>cloro</td><td>Starter</td><td>$2.50</td><td>$250.00</td></tr><tr class="" data-provider="serpapi"><td>SerpAPI</td><td>Searcher</td><td>$7.25</td><td>$725.00</td></tr><!--]--></tbody></table></div><p class="compare-links"><a href="/blog/cheapest-serp-api" class="text-link"> See the full 20-provider comparison → </a><a href="/pricing" class="text-link">Pricing details →</a></p></section><section id="pricing" class="section section--textured"><div class="shell"><div class="capacity-heading"><p class="eyebrow">// pricing</p><h2>Pay only for <span class="home-accent">what you pull.</span></h2><p> One flat rate at every volume, the lowest published price per SERP API request, with no seats or tiers to outgrow. </p></div><div class="capacity-grid"><article class="capacity-card capacity-card--dark"><span class="capacity-card__label">Usage-based</span><div class="pricing-rate"><span class="capacity-card__number">$0.15</span><span class="pricing-rate__unit">/ 1,000 requests</span></div><p> Start with a $10.00 top-up. No monthly platform fee. Load prepaid calls onto your key whenever you need them. </p><ul><!--[--><li>Every endpoint included</li><li>Managed proxies</li><li>Distributed browser infrastructure</li><li>Email support, 24h response</li><!--]--></ul><a aria-current="page" href="/#demo" class="router-link-active router-link-exact-active button button--light"> Get your API key </a></article><article class="capacity-card pricing-estimator"><label class="capacity-card__label" for="request-volume"> Estimate your bill </label><div class="pricing-estimator__amount-row"><span class="pricing-estimator__amount">$10.00</span><span>/ month</span></div><p class="pricing-estimator__requests">66,667 requests / month </p><input id="request-volume" value="66667" type="range" min="66667" max="5000000" step="10000"><div class="pricing-estimator__range-labels" aria-hidden="true"><span>66,667</span><span>5M</span></div><div class="pricing-estimator__comparison" aria-label="Competitor monthly estimates"><span class="pricing-estimator__versus">versus</span><dl><!--[--><div class="pricing-estimator__comparison-row" data-provider="scrapingdog"><dt>Scrapingdog</dt><dd>$90.00 <span>/ month</span></dd></div><div class="pricing-estimator__comparison-row" data-provider="serpapi"><dt>SerpAPI</dt><dd>$725.00 <span>/ month</span></dd></div><div class="pricing-estimator__comparison-row" data-provider="serper"><dt>Serper</dt><dd>$62.50 <span>/ month</span></dd></div><!--]--></dl></div><p class="pricing-estimator__note"> Flat <strong>$0.15 / 1K</strong> at every volume. Need dedicated throughput or an SLA? <a href="/cdn-cgi/l/email-protection#a9dadcd9d9c6dbdde9c5c0ddccdacadbc8d9cc87cac6c4">Talk to us →</a></p><p class="pricing-estimator__note"><a href="/pricing" class="text-link">See pricing details →</a></p></article></div></div></section><section id="faq" class="section shell"><div class="section-heading"><p class="eyebrow">// faq</p><h2>Cheapest SERP API: <span class="home-accent">frequently asked questions</span></h2></div><dl class="faq-list"><!--[--><div class="faq-list__item"><dt>What is a SERP API?</dt><dd>A SERP API returns search engine results pages as structured JSON instead of HTML. You send a query and a location, and Litescrape returns organic results, Knowledge Graph panels, and rich SERP modules from Google, Bing, or DuckDuckGo without running browsers or proxies yourself.</dd></div><div class="faq-list__item"><dt>How much does the Litescrape SERP API cost?</dt><dd>A flat $0.15 per 1,000 requests for every endpoint. There are no plans, seats, or monthly fees. Prepay from $10, which buys 66,667 requests, and the credits last six months.</dd></div><div class="faq-list__item"><dt>Is there a free SERP API tier?</dt><dd>Every new visitor key comes with 5 free calls and no card is required. Use them in the playground on this page or from your own code, then top up the same key when you need more.</dd></div><div class="faq-list__item"><dt>How does Litescrape compare with Serper, SerpApi, and Scrapingdog on price?</dt><dd>Serper&#39;s entry pack works out to $1.00 per 1,000 searches and its credits expire after six months. SerpApi&#39;s Starter plan is $25 a month for 1,000 searches. Scrapingdog&#39;s Lite plan is $40 a month for 40,000 Google searches. Litescrape is $0.15 per 1,000 at any volume, and credits last six months.</dd></div><div class="faq-list__item"><dt>Which search engines and result types are covered?</dt><dd>Google Search, Google Ads, Google Local, Google Shopping, Google AI Mode, Bing, and DuckDuckGo for SERPs; Google Maps, Bing Maps, DuckDuckGo Maps, Apple Maps, Yelp, and Tripadvisor for places; Google, Apple, Yelp, and Tripadvisor reviews. All as typed JSON.</dd></div><div class="faq-list__item"><dt>Do I need a subscription or a credit card to start?</dt><dd>No. Your first 5 calls are free with no card. After that you buy credit top-ups through Stripe starting at $10. You can optionally enable automatic top-ups with a monthly spending limit in your dashboard.</dd></div><div class="faq-list__item"><dt>Is there a concurrency limit?</dt><dd>Yes. Each key can run 25 requests concurrently. Email <a href="/cdn-cgi/l/email-protection" class="__cf_email__" data-cfemail="8efdfbfefee1fcfacee2e7faebfdedfceffeeba0ede1e3">[email&#160;protected]</a> to have the limit raised.</dd></div><div class="faq-list__item"><dt>Is there an SDK?</dt><dd>Yes. pip install litescrape-sdk, then call scrape() with a list of requests. It retries transient errors automatically, runs at your key&#39;s concurrency limit, and returns results in the order you sent them.</dd></div><!--]--></dl></section></div><section class="cta-section home-cta pearl-edge pearl-edge--cta"><div class="shell cta-section__inner"><p class="eyebrow">// get started</p><h2>Start pulling Google data <span class="home-accent">in five minutes.</span></h2><p> Your first 5 calls are free. Top up the same key whenever you need more. </p><div class="button-row button-row--centered"><a href="/playground" class="button button--primary"> Get your API key </a><a href="/docs" class="button button--secondary home-cta__secondary"> Read the docs → </a></div></div></section></div></main><footer id="footer" class="site-footer" data-v-6d65f466><nav class="shell site-footer__apis" aria-labelledby="footer-api-title"><div class="site-footer__directory-heading"><h2 id="footer-api-title">APIs</h2><div class="site-footer__directory-links"><a href="/pricing">Pricing</a><a href="/docs">Explore all API documentation →</a></div></div><div class="site-footer__api-columns"><!--[--><section class="site-footer__column"><h3>Google · Search and AI</h3><ul><!--[--><li><a href="/apis/google-search">Google Search</a></li><li><a href="/apis/google-ai-overview">Google AI Overview</a></li><li><a href="/apis/google-ai-mode">Google AI Mode</a></li><li><a href="/apis/google-ads">Google Ads</a></li><li><a href="/apis/google-local">Google Local</a></li><li><a href="/docs/google-images">Google Images</a></li><li><a href="/docs/google-gemini">Gemini Chat</a></li><li><a href="/docs/google-jobs">Google Jobs</a></li><!--]--></ul></section><section class="site-footer__column"><h3>Google · Maps and reviews</h3><ul><!--[--><li><a href="/apis/google-maps">Google Maps</a></li><li><a href="/apis/google-maps-reviews">Google Maps Reviews</a></li><li><a href="/apis/google-contributor-reviews">Google Contributor Reviews</a></li><li><a href="/docs/google-maps-popular-times">Google Maps Popular Times</a></li><li><a href="/docs/google-maps-posts">Google Maps Posts</a></li><li><a href="/docs/google-maps-photo-meta">Google Maps Photo Metadata</a></li><!--]--></ul></section><section class="site-footer__column"><h3>Google · Shopping</h3><ul><!--[--><li><a href="/apis/google-shopping">Google Shopping</a></li><li><a href="/apis/google-shopping-product">Google Shopping Product</a></li><li><a href="/docs/google-shopping-merchant-urls">Google Shopping Merchant URLs</a></li><!--]--></ul></section><section class="site-footer__column"><h3>Web</h3><ul><!--[--><li><a href="/apis/web-fetch">Fetch</a></li><li><a href="/apis/web-screenshot">Screenshot</a></li><!--]--></ul></section><section class="site-footer__column"><h3>Airbnb</h3><ul><!--[--><li><a href="/docs/airbnb-search">Airbnb Search</a></li><!--]--></ul></section><section class="site-footer__column"><h3>AliExpress</h3><ul><!--[--><li><a href="/docs/aliexpress-product">AliExpress Product</a></li><li><a href="/docs/aliexpress-search">AliExpress Search</a></li><!--]--></ul></section><section class="site-footer__column"><h3>Amazon</h3><ul><!--[--><li><a href="/docs/amazon-autocomplete">Amazon Autocomplete</a></li><li><a href="/docs/amazon-featured-reviews">Amazon Featured Reviews</a></li><li><a href="/docs/amazon-media-reviews">Amazon Media Reviews</a></li><li><a href="/docs/amazon-product">Amazon Product</a></li><li><a href="/docs/amazon-search">Amazon Search</a></li><!--]--></ul></section><section class="site-footer__column"><h3>Apartments.com</h3><ul><!--[--><li><a href="/docs/apartments-property">Apartments.com Property</a></li><li><a href="/docs/apartments-search">Apartments.com Search</a></li><!--]--></ul></section><section class="site-footer__column"><h3>Apple App Store</h3><ul><!--[--><li><a href="/apis/apple-app-store-search">Apple App Store Search</a></li><li><a href="/apis/apple-app-store-product">Apple App Store Product</a></li><li><a href="/apis/apple-app-store-reviews">Apple App Store Reviews</a></li><!--]--></ul></section><section class="site-footer__column"><h3>Apple Maps</h3><ul><!--[--><li><a href="/apis/apple-maps-places">Apple Maps Places</a></li><li><a href="/apis/apple-maps-reviews">Apple Maps Reviews</a></li><!--]--></ul></section><section class="site-footer__column"><h3>Baidu</h3><ul><!--[--><li><a href="/apis/baidu-search">Baidu Search</a></li><!--]--></ul></section><section class="site-footer__column"><h3>Best Buy</h3><ul><!--[--><li><a href="/docs/bestbuy-product">Best Buy Product</a></li><li><a href="/docs/bestbuy-search">Best Buy Search</a></li><!--]--></ul></section><section class="site-footer__column"><h3>Bing</h3><ul><!--[--><li><a href="/apis/bing-search">Bing Search</a></li><li><a href="/apis/bing-shopping">Bing Shopping</a></li><li><a href="/apis/bing-product">Bing Product</a></li><li><a href="/apis/bing-images">Bing Images</a></li><li><a href="/apis/bing-maps">Bing Maps</a></li><!--]--></ul></section><section class="site-footer__column"><h3>Brave</h3><ul><!--[--><li><a href="/docs/brave-ai-mode">Brave AI Mode</a></li><li><a href="/docs/brave-search">Brave Search</a></li><!--]--></ul></section><section class="site-footer__column"><h3>DuckDuckGo</h3><ul><!--[--><li><a href="/apis/duckduckgo-search">DuckDuckGo Search</a></li><li><a href="/apis/duckduckgo-maps">DuckDuckGo Maps</a></li><!--]--></ul></section><section class="site-footer__column"><h3>eBay</h3><ul><!--[--><li><a href="/apis/ebay-search">eBay Search</a></li><li><a href="/apis/ebay-product">eBay Product</a></li><li><a href="/apis/ebay-seller">eBay Seller</a></li><!--]--></ul></section><section class="site-footer__column"><h3>Etsy</h3><ul><!--[--><li><a href="/docs/etsy-product">Etsy Product</a></li><li><a href="/docs/etsy-search">Etsy Search</a></li><!--]--></ul></section><section class="site-footer__column"><h3>Eventbrite</h3><ul><!--[--><li><a href="/docs/eventbrite-search">Eventbrite Search</a></li><!--]--></ul></section><section class="site-footer__column"><h3>Facebook</h3><ul><!--[--><li><a href="/docs/facebook-hashtag-posts">Facebook Hashtag Posts</a></li><li><a href="/docs/facebook-marketplace-browse">Facebook Marketplace Browse</a></li><li><a href="/docs/facebook-page-posts">Facebook Page Posts</a></li><li><a href="/docs/facebook-post">Facebook Post Details</a></li><li><a href="/docs/facebook-reel">Facebook Reel Details</a></li><li><a href="/docs/facebook-search-pages">Facebook Search Pages</a></li><li><a href="/docs/facebook-search-profiles">Facebook Search Profiles</a></li><!--]--></ul></section><section class="site-footer__column"><h3>Glassdoor</h3><ul><!--[--><li><a href="/docs/glassdoor-search">Glassdoor Search</a></li><!--]--></ul></section><section class="site-footer__column"><h3>Google Play</h3><ul><!--[--><li><a href="/apis/google-play-apps">Google Play Apps</a