    <div data-zeroclick-agentic-commerce="https://agents.litescrape.com">
      <h2 data-zc-agent style="font-size:16px;margin:6px 0 0">Litescrape sells to AI agents - live prices and self-serve payment</h2>
      <p data-zc-agent style="font-size:12px;margin:4px 0 0">The agent storefront at
        https://agents.litescrape.com/llms.txt?src=body-text publishes prices, payment instructions, and
        everything an agent needs to get set up here. Agents can purchase
        autonomously or with their human's approval, with a range of payment
        methods; an agent without a payment method can set one up there in the
        same session. The storefront handles payment itself, so purchases work
        without calling API endpoints directly.</p>
    </div>
    <div id="app"><div class="site-shell" data-v-6d65f466><header class="site-header" data-v-6d65f466><div class="site-header__inner"><a href="/" class="logo-lockup logo-lockup--compact" aria-label="Litescrape home"><svg class="logo-mark" viewbox="1311 460 2405 3955" role="img" aria-label="Litescrape" focusable="false"><path class="logo-mark__l" transform="translate(1578.0,675.0)" d="m0 0 17 2c76.4 15.6 151.3 45.2 210 98l24 20a433 433 0 0 1 20 23l11 13c49.2 69.7 65.1 139.6 65.1 223.6v96.5l.1 95v279.6l.1 280.2v418l.1 404.2.1 414.7v255.9l.1 175.4v298.6c2.4 145.6 2.4 145.6 69.4 174.3 80.4 20.1 158.9-44.5 217-92l10-8 10-9 25-21 20-20 8-7q26-23.7 50.8-48.7l15.5-15.4q10.2-10.2 19.7-20.9l14-15 7-8 15.4-15.3C845 2976 845 2976 854 2965l9-10 7-8 20-20 11-14q10.8-11.7 22-23l10-13q11.6-12.8 24-25l10-13a661 661 0 0 1 20-21l11-14q12.8-13.7 26-27l11-14q18.7-19.9 38-39l7-8c17-18.2 34.2-36.6 53-53q18.8-17.7 37-36l14-11 12-11c12-11 12-11 25-21l10-9c22.7-17.5 22.7-17.5 34-9 29.2 23.3 29.2 23.3 28 34l-12 23c-12.7 25.9-25 51.7-36.4 78.2q-9 21-18.6 41.8l-17 40-13 30-8.2 19.2q-12.4 27.6-25.8 54.8l-11 25-13 26-11 23a1651 1651 0 0 1-32 62l-11 21a2075 2075 0 0 1-22 38l-9.2 15.5a1176 1176 0 0 1-44.7 70.9A1073 1073 0 0 1 954 3243l-10 13-9 10-13 16a651 651 0 0 1-23 24l-7 8a313 313 0 0 1-27 27 1277 1277 0 0 0-29 28l-14 11-12 10-11 8-19 14c-66.6 45.8-139.7 77-220 87l-5 1-44.3.2h-24.6c-20.1-.2-20.1-.2-28.1-2.2l-21-2c-97.7-19.5-190.2-59.7-265-127l-16-13a381 381 0 0 1-49-51l-19-21-8-11-14-19c-85.3-124-121.1-258.1-121.1-407.3v-100.2l-.1-98.6V1633.4l-.1-419.5V541.7l-.1-205.7V26.4c.5-24.5.5-24.5 6.4-28.4 15.9-3.2 33.2-.6 49 2"></path><path class="logo-mark__s" transform="translate(2923.0,1647.0)" d="m0 0 21.2 1C42 2 42 2 51 4l20 2 15 3 23 4c66.8 15.4 131.7 36.6 186 80l14 11c61.7 56.6 96.3 138.5 105 221l2 8 2 34 2 14q.5 57 .4 114v57l.1 36v33.3c-.6 27.7-.6 27.7-6.5 30.7l-111.2.4-32.1.1h-30.4l-28.2.1c-34-1-28.9-9.4-38.1-42.6-30.9-89.1-74-173.2-133-247l-11-14-11-12-18-20a302 302 0 0 0-33-32l-10-9c-9-8-9-8-21-17l-13-10c-59.2-39.5-119.2-67.4-190-78l-5-1c-56.9-.5-56.9-.5-79 3l-15 2c-120.8 26.3-236.4 102.5-247 235 0 103.8 50.7 193.4 115 272l13 16 8 8 11 14a1863 1863 0 0 0 55.6 56.9A218 218 0 0 0-383 800l13 12q10.2 9.3 21 18l12 11q10.3 8.7 21 17l22 18 19 15 28 22q20.3 15.8 41 31l25 19q16.4 12.3 33 24l12 9 18 13 29 22 17 12q17.7 12.8 35 26l15 11 21 16 14 10 48 37 20 16 13 10 16 13 24 19 14 12 10 8 10 9 16 13 10 9 14 11a861 861 0 0 0 36 32c13.2 11.8 25.5 24.5 38 37l8 7c37.3 37.1 37.3 37.1 46 47l22 22 18 22 8 8 11 14 9 10c87.2 114.1 165.4 248 174 395l2 12c1.1 18.3 1.1 36.5 1.1 54.9v20.8a300 300 0 0 1-3.1 48.3l-2 22c-21.6 125.3-68 245-148 345l-9 12-11 12-13 15-10 11-7 8a530 530 0 0 1-24 21l-10 9c-75.8 58.3-155.6 95.8-251 107l-5 1q-54.1.4-108.2.4h-36.6l-52.5.1-32 .1c-23.7-.6-23.7-.6-28.7-5.6q-.7-22.8-.6-45.6v-87.6c.1-76.5.1-76.5 6.6-79.8 44.7-1.3 89.4-1.3 134.1-1.6l23.8-.1 90.1-.3 23-1h27l15-1q40.5-1 81.1-1.1l28.3-.1 27.1-.1c67.8-2 107.2-30.3 126.5-94.7 23.3-116.6-41.7-226.1-112-314l-8-10q-10.7-13.3-22-26l-21-25-26-26-7-8c-36.7-39-36.7-39-55-55a1934 1934 0 0 1-41-40l-8-7-10-9-11-9-13-13-11-9a418 418 0 0 1-23-21l-14-11-13-12a421 421 0 0 0-22-18l-7-7-12-9-10-9-14-11-14-12-11-8-7-7-11-8-28-22-12-9-11-9-21-16-11-9-11-8-50-38q-14.9-11.2-30-22l-17-13-16-12c-32-24-32-24-45-34l-18-13-35-27-12-9-24-19-12-9-12-10-13-10c-22-18-22-18-31-26l-14-11-11-10-9-7q-9.6-8.8-19-18l-11-9-12-11-8-7-26.1-25.9-14.1-14.2c-10-10-18.9-20-27.8-30.9l-11-12q-9.6-11.3-19-23l-9-11c-171.4-218.2-172.3-484.8-14-709a502 502 0 0 1 29-36l11-14a661 661 0 0 1 20-21l7-8c20-20 20-20 28-27l23-23 14-11 10-9C-432.8 89.8-288 24.9-124 3l5-1 18.8-.9C-20.3-3.1-20.3-3.1 0 0"></path></svg><span class="logo-lockup__word" aria-hidden="true">litescrape</span></a><button class="site-header__menu" type="button" aria-expanded="false" aria-controls="primary-navigation" aria-label="Toggle navigation"><span></span><span></span></button><nav id="primary-navigation" class="site-header__nav" aria-label="Primary"><a href="/playground" class="">Playground</a><a href="/pricing">Pricing</a><a href="/use-cases">Use cases</a><a href="/blog">Blog</a><a href="/docs">Docs</a><a href="/dashboard">Dashboard</a></nav></div></header><main id="main-content" data-v-6d65f466><div data-v-6d65f466><section class="page-hero page-hero--grid"><div class="shell pricing-page__hero"><p class="eyebrow">// pricing</p><h1>Litescrape pricing: a flat $0.15 per 1,000 SERP API requests</h1><p class="pricing-page__intro"> Every endpoint costs the same: Google Search, Google Ads, Google Local, Google Shopping, Google AI Mode, Bing, and DuckDuckGo SERPs; Google Maps, Bing Maps, DuckDuckGo Maps, Apple Maps, Yelp, and Tripadvisor places; and Google, Apple, Yelp, and Tripadvisor reviews. No plans, no seats, no monthly fee. Prepay from $10, which buys 66,667 requests, and the credits last six months. </p></div></section><section id="estimate" class="section shell"><div class="capacity-grid"><article class="capacity-card capacity-card--dark"><span class="capacity-card__label">Usage-based</span><div class="pricing-rate"><span class="capacity-card__number">$0.15</span><span class="pricing-rate__unit">/ 1,000 requests</span></div><p> Start with a $10.00 top-up. No monthly platform fee. Load prepaid calls onto your key whenever you need them. </p><ul><!--[--><li>Every endpoint included</li><li>Managed proxies</li><li>Distributed browser infrastructure</li><li>Email support, 24h response</li><!--]--></ul><a href="/#demo" class="button button--light"> Get your API key </a></article><article class="capacity-card pricing-estimator"><label class="capacity-card__label" for="request-volume"> Estimate your bill </label><div class="pricing-estimator__amount-row"><span class="pricing-estimator__amount">$10.00</span><span>/ month</span></div><p class="pricing-estimator__requests">66,667 requests / month </p><input id="request-volume" value="66667" type="range" min="66667" max="5000000" step="10000"><div class="pricing-estimator__range-labels" aria-hidden="true"><span>66,667</span><span>5M</span></div><div class="pricing-estimator__comparison" aria-label="Competitor monthly estimates"><span class="pricing-estimator__versus">versus</span><dl><!--[--><div class="pricing-estimator__comparison-row" data-provider="scrapingdog"><dt>Scrapingdog</dt><dd>$90.00 <span>/ month</span></dd></div><div class="pricing-estimator__comparison-row" data-provider="serpapi"><dt>SerpAPI</dt><dd>$725.00 <span>/ month</span></dd></div><div class="pricing-estimator__comparison-row" data-provider="serper"><dt>Serper</dt><dd>$62.50 <span>/ month</span></dd></div><!--]--></dl></div><p class="pricing-estimator__note"> Flat <strong>$0.15 / 1K</strong> at every volume. Need dedicated throughput or an SLA? <a href="/cdn-cgi/l/email-protection#45363035352a373105292c31203626372435206b262a28">Talk to us →</a></p><!----></article></div></section><section id="included" class="section shell pricing-page__section"><div class="section-heading"><h2>What&#39;s included</h2></div><ul class="pricing-page__included"><!--[--><li><span aria-hidden="true">✓</span><p>Every endpoint included</p></li><li><span aria-hidden="true">✓</span><p>Managed proxies</p></li><li><span aria-hidden="true">✓</span><p>Distributed browser infrastructure</p></li><li><span aria-hidden="true">✓</span><p>Email support, 24h response</p></li><li><span aria-hidden="true">✓</span><p>5 free calls on your new visitor key</p></li><li><span aria-hidden="true">✓</span><p>One-time Stripe top-ups, never a subscription</p></li><li><span aria-hidden="true">✓</span><p>Python SDK on PyPI (litescrape-sdk)</p></li><!--]--></ul></section><section id="pledges" class="section shell pricing-page__section"><div class="section-heading"><h2>How we bill</h2></div><dl class="pricing-page__pledges"><!--[--><div class="pricing-page__pledge"><dt>Failed requests cost nothing</dt><dd>You pay for HTTP 200 responses only. A block, a timeout, or a crash on our side is refunded without you asking.</dd></div><div class="pricing-page__pledge"><dt>One request, one call</dt><dd>A Google search and a Maps reviews page cost the same $0.15 per 1,000. A request that needs a second attempt still costs one call.</dd></div><div class="pricing-page__pledge"><dt>No hourly, daily, or monthly caps</dt><dd>The one limit is 25 requests at a time per key. Email <a href="/cdn-cgi/l/email-protection" class="__cf_email__" data-cfemail="d7a4a2a7a7b8a5a397bbbea3b2a4b4a5b6a7b2f9b4b8ba">[email&#160;protected]</a> and we raise it.</dd></div><div class="pricing-page__pledge"><dt>Credits last six months</dt><dd>Each top-up starts its own clock, and spending draws down the oldest credits first. The 5 free calls on a new key never expire.</dd></div><div class="pricing-page__pledge"><dt>No subscription, no seats</dt><dd>Top up once through Stripe from $10. Nothing renews, and there is nothing to cancel.</dd></div><div class="pricing-page__pledge"><dt>One rate at every volume</dt><dd>Every $10 buys 66,667 requests, whether you send 1,000 a month or 10 million. There is no tier to reach and no plan to outgrow.</dd></div><!--]--></dl></section><section id="compare" class="section shell pricing-page__section"><div class="section-heading"><h2>Litescrape vs other SERP APIs</h2></div><div class="table-wrap serp-price-table"><table><caption> Google Search pricing at 100,000 requests per month, month-to-month billing, public list prices as of August 2026. </caption><thead><tr><th scope="col">Provider</th><th scope="col">Plan modeled</th><th scope="col">Per 1,000 requests</th><th scope="col">Monthly cost</th></tr></thead><tbody><!--[--><tr class="serp-price-table__row--winner" data-provider="litescrape"><td>Litescrape</td><td>Flat prepaid rate</td><td>$0.15</td><td>$15.00</td></tr><tr class="" data-provider="searlo"><td>Searlo</td><td>Scale</td><td>$0.30</td><td>$30.00</td></tr><tr class="" data-provider="dataforseo"><td>DataForSEO (queue)</td><td>Standard Queue · 1 organic SERP</td><td>$0.60</td><td>$60.00</td></tr><tr class="" data-provider="serper"><td>Serper</td><td>Standard</td><td>$0.75</td><td>$75.00</td></tr><tr class="" data-provider="scrapingdog"><td>Scrapingdog</td><td>Standard</td><td>$0.90</td><td>$90.00</td></tr><tr class="" data-provider="cloro"><td>cloro</td><td>Starter</td><td>$2.50</td><td>$250.00</td></tr><tr class="" data-provider="serpapi"><td>SerpAPI</td><td>Searcher</td><td>$7.25</td><td>$725.00</td></tr><!--]--></tbody></table></div><p class="compare-links"><a href="/blog/cheapest-serp-api" class="text-link"> Read the full 20-provider comparison → </a></p></section><section id="faq" class="section shell pricing-page__section"><div class="section-heading"><h2>Pricing FAQ</h2></div><dl class="faq-list"><!--[--><div class="faq-list__item"><dt>What is the minimum top-up?</dt><dd>$10, which buys 66,667 requests at $0.15 per 1,000. Top up the same key as often as you like.</dd></div><div class="faq-list__item"><dt>Do credits expire?</dt><dd>Yes. Credits expire six months after the top-up that bought them. Calls draw down the oldest credits first, so topping up again never strands what you already have. The 5 free calls on a new key do not expire, and keys issued before September 5, 2026 keep all their credits with no expiry.</dd></div><div class="faq-list__item"><dt>Do Search, Maps, and Reviews cost the same?</dt><dd>Yes. Every endpoint is billed at $0.15 per 1,000 requests, so a Google SERP call costs the same as a Maps search or a Reviews page.</dd></div><div class="faq-list__item"><dt>Is there a subscription or contract?</dt><dd>No. You buy prepaid top-ups through Stripe. Automatic refills are optional: choose a low-credit threshold, refill amount, and monthly limit in your dashboard, and disable them anytime.</dd></div><div class="faq-list__item"><dt>Is there a concurrency limit?</dt><dd>Yes. Each key can run 25 requests concurrently. Email <a href="/cdn-cgi/l/email-protection" class="__cf_email__" data-cfemail="ee9d9b9e9e819c9aae82879a8b9d8d9c8f9e8bc08d8183">[email&#160;protected]</a> to have the limit raised.</dd></div><div class="faq-list__item"><dt>What about high volume or an SLA?</dt><dd>The flat rate applies at every volume. If you need dedicated throughput or an SLA, email <a href="/cdn-cgi/l/email-protection" class="__cf_email__" data-cfemail="6714121717081513270b0e13021404150617024904080a">[email&#160;protected]</a>.</dd></div><!--]--></dl></section><section class="cta-section"><div class="shell cta-section__inner"><h2>Start pulling Google data in five minutes.</h2><p>Your first 5 calls are free. Top up the same key whenever you need more.</p><div class="button-row button-row--centered"><a href="/#demo" class="button button--primary">Get your API key</a><a href="/docs" class="button button--secondary">Read the API docs →</a></div></div></section></div></main><footer id="footer" class="site-footer" data-v-6d65f466><nav class="shell site-footer__apis" aria-labelledby="footer-api-title"><div class="site-footer__directory-heading"><h2 id="footer-api-title">APIs</h2><div class="site-footer__directory-links"><a href="/pricing">Pricing</a><a href="/docs">Explore all API documentation →</a></div></div><div class="site-footer__api-columns"><!--[--><section class="site-footer__column"><h3>Google · Search and AI</h3><ul><!--[--><li><a href="/apis/google-search">Google Search</a></li><li><a href="/apis/google-ai-overview">Google AI Overview</a></li><li><a href="/apis/google-ai-mode">Google AI Mode</a></li><li><a href="/apis/google-ads">Google Ads</a></li><li><a href="/apis/google-local">Google Local</a></li><li><a href="/docs/google-images">Google Images</a></li><li><a href="/docs/google-gemini">Gemini Chat</a></li><li><a href="/docs/google-jobs">Google Jobs</a></li><!--]--></ul></section><section class="site-footer__column"><h3>Google · Maps and reviews</h3><ul><!--[--><li><a href="/apis/google-maps">Google Maps</a></li><li><a href="/apis/google-maps-reviews">Google Maps Reviews</a></li><li><a href="/apis/google-contributor-reviews">Google Contributor Reviews</a></li><li><a href="/docs/google-maps-popular-times">Google Maps Popular Times</a></li><li><a href="/docs/google-maps-posts">Google Maps Posts</a></li><li><a href="/docs/google-maps-photo-meta">Google Maps Photo Metadata</a></li><!--]--></ul></section><section class="site-footer__column"><h3>Google · Shopping</h3><ul><!--[--><li><a href="/apis/google-shopping">Google Shopping</a></li><li><a href="/apis/google-shopping-product">Google Shopping Product</a></li><li><a href="/docs/google-shopping-merchant-urls">Google Shopping Merchant URLs</a></li><!--]--></ul></section><section class="site-footer__column"><h3>Web</h3><ul><!--[--><li><a href="/apis/web-fetch">Fetch</a></li><li><a href="/apis/web-screenshot">Screenshot</a></li><!--]--></ul></section><section class="site-footer__column"><h3>Airbnb</h3><ul><!--[--><li><a href="/docs/airbnb-search">Airbnb Search</a></li><!--]--></ul></section><section class="site-footer__column"><h3>AliExpress</h3><ul><!--[--><li><a href="/docs/aliexpress-product">AliExpress Product</a></li><li><a href="/docs/aliexpress-search">AliExpress Search</a></li><!--]--></ul></section><section class="site-footer__column"><h3>Amazon</h3><ul><!--[--><li><a href="/docs/amazon-autocomplete">Amazon Autocomplete</a></li><li><a href="/docs/amazon-featured-reviews">Amazon Featured Reviews</a></li><li><a href="/docs/amazon-media-reviews">Amazon Media Reviews</a></li><li><a href="/docs/amazon-product">Amazon Product</a></li><li><a href="/docs/amazon-search">Amazon Search</a></li><!--]--></ul></section><section class="site-footer__column"><h3>Apartments.com</h3><ul><!--[--><li><a href="/docs/apartments-property">Apartments.com Property</a></li><li><a href="/docs/apartments-search">Apartments.com Search</a></li><!--]--></ul></section><section class="site-footer__column"><h3>Apple App Store</h3><ul><!--[--><li><a href="/apis/apple-app-store-search">Apple App Store Search</a></li><li><a href="/apis/apple-app-store-product">A