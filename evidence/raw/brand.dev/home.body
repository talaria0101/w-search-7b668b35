<span class="line"><span style="color:#D2A8FF">func</span><span style="color:#7EE787"> main</span><span style="color:#B1BAC4">()</span><span style="color:#B1BAC4"> {</span></span>
<span class="line"><span style="color:#E6EDF3">	client </span><span style="color:#B1BAC4">:=</span><span style="color:#E6EDF3"> contextdev</span><span style="color:#B1BAC4">.</span><span style="color:#7EE787">NewClient</span><span style="color:#B1BAC4">(</span></span>
<span class="line"><span style="color:#E6EDF3">		option</span><span style="color:#B1BAC4">.</span><span style="color:#7EE787">WithAPIKey</span><span style="color:#B1BAC4">(</span><span style="color:#A5D6FF">"YOUR_API_KEY"</span><span style="color:#B1BAC4">),</span></span>
<span class="line"><span style="color:#B1BAC4">	)</span></span>
<span class="line"></span>
<span class="line"><span style="color:#E6EDF3">	response</span><span style="color:#B1BAC4">,</span><span style="color:#E6EDF3"> err </span><span style="color:#B1BAC4">:=</span><span style="color:#E6EDF3"> client</span><span style="color:#B1BAC4">.</span><span style="color:#E6EDF3">Web</span><span style="color:#B1BAC4">.</span><span style="color:#7EE787">Scrape</span><span style="color:#B1BAC4">(</span><span style="color:#E6EDF3">context</span><span style="color:#B1BAC4">.</span><span style="color:#7EE787">TODO</span><span style="color:#B1BAC4">(),</span><span style="color:#FFA657"> contextdev</span><span style="color:#B1BAC4">.</span><span style="color:#FFA657">WebScrapeParams</span><span style="color:#B1BAC4">{</span></span>
<span class="line"><span style="color:#79C0FF">		URL</span><span style="color:#B1BAC4">:</span><span style="color:#A5D6FF"> "https://linear.app"</span><span style="color:#B1BAC4">,</span></span>
<span class="line"><span style="color:#79C0FF">		Formats</span><span style="color:#B1BAC4">:</span><span style="color:#FFA657"> contextdev</span><span style="color:#B1BAC4">.</span><span style="color:#FFA657">WebScrapeParamsFormats</span><span style="color:#B1BAC4">{</span></span>
<span class="line"><span style="color:#79C0FF">			HTML</span><span style="color:#B1BAC4">:</span><span style="color:#E6EDF3">       contextdev</span><span style="color:#B1BAC4">.</span><span style="color:#7EE787">Bool</span><span style="color:#B1BAC4">(</span><span style="color:#FFA657">true</span><span style="color:#B1BAC4">),</span></span>
<span class="line"><span style="color:#79C0FF">			Markdown</span><span style="color:#B1BAC4">:</span><span style="color:#E6EDF3">   contextdev</span><span style="color:#B1BAC4">.</span><span style="color:#7EE787">Bool</span><span style="color:#B1BAC4">(</span><span style="color:#FFA657">true</span><span style="color:#B1BAC4">),</span></span>
<span class="line"><span style="color:#79C0FF">			Screenshot</span><span style="color:#B1BAC4">:</span><span style="color:#E6EDF3"> contextdev</span><span style="color:#B1BAC4">.</span><span style="color:#7EE787">Bool</span><span style="color:#B1BAC4">(</span><span style="color:#FFA657">true</span><span style="color:#B1BAC4">),</span></span>
<span class="line"><span style="color:#B1BAC4">		},</span></span>
<span class="line"><span style="color:#79C0FF">		SharedParams</span><span style="color:#B1BAC4">:</span><span style="color:#FFA657"> contextdev</span><span style="color:#B1BAC4">.</span><span style="color:#FFA657">WebScrapeParamsSharedParams</span><span style="color:#B1BAC4">{</span></span>
<span class="line"><span style="color:#79C0FF">			MainContentOnly</span><span style="color:#B1BAC4">:</span><span style="color:#E6EDF3"> contextdev</span><span style="color:#B1BAC4">.</span><span style="color:#7EE787">Bool</span><span style="color:#B1BAC4">(</span><span style="color:#FFA657">true</span><span style="color:#B1BAC4">),</span></span>
<span class="line"><span style="color:#B1BAC4">		},</span></span>
<span class="line"><span style="color:#B1BAC4">	})</span></span>
<span class="line"><span style="color:#D2A8FF">	if</span><span style="color:#E6EDF3"> err </span><span style="color:#B1BAC4">!=</span><span style="color:#FFA657"> nil</span><span style="color:#B1BAC4"> {</span></span>
<span class="line"><span style="color:#7EE787">		panic</span><span style="color:#B1BAC4">(</span><span style="color:#E6EDF3">err</span><span style="color:#B1BAC4">)</span></span>
<span class="line"><span style="color:#B1BAC4">	}</span></span>
<span class="line"></span>
<span class="line"><span style="color:#E6EDF3">	fmt</span><span style="color:#B1BAC4">.</span><span style="color:#7EE787">Printf</span><span style="color:#B1BAC4">(</span><span style="color:#A5D6FF">"%+v\n"</span><span style="color:#B1BAC4">,</span><span style="color:#E6EDF3"> response</span><span style="color:#B1BAC4">)</span></span>
<span class="line"><span style="color:#B1BAC4">}</span></span></code></pre></div><div id="_R_5dptbr4nuhqlb_-panel-curl" role="tabpanel" aria-labelledby="_R_5dptbr4nuhqlb_-tab-curl" tabindex="0" hidden="" class="absolute inset-0 overflow-auto p-5 text-sm leading-[22px] [scrollbar-color:rgba(255,255,255,0.2)_transparent] [scrollbar-width:thin] focus-visible:outline-2 focus-visible:-outline-offset-2 focus-visible:outline-brand-primary [&amp;_code]:font-mono [&amp;_pre]:bg-transparent!"><pre class="shiki context-code-dark" style="background-color:#00000000;color:#e6edf3"><code><span class="line"><span style="color:#7EE787">curl</span><span style="color:#A5D6FF"> --request</span><span style="color:#A5D6FF"> POST</span><span style="color:#A5D6FF"> 'https://api.context.dev/v1/web/scrape'</span><span style="color:#E6EDF3"> \</span></span>
<span class="line"><span style="color:#A5D6FF">  --header</span><span style="color:#A5D6FF"> 'Authorization: Bearer YOUR_API_KEY'</span><span style="color:#E6EDF3"> \</span></span>
<span class="line"><span style="color:#A5D6FF">  --header</span><span style="color:#A5D6FF"> 'Content-Type: application/json'</span><span style="color:#E6EDF3"> \</span></span>
<span class="line"><span style="color:#A5D6FF">  --data</span><span style="color:#A5D6FF"> '{</span></span>
<span class="line"><span style="color:#A5D6FF">  "url": "https://linear.app",</span></span>
<span class="line"><span style="color:#A5D6FF">  "formats": {</span></span>
<span class="line"><span style="color:#A5D6FF">    "html": true,</span></span>
<span class="line"><span style="color:#A5D6FF">    "markdown": true,</span></span>
<span class="line"><span style="color:#A5D6FF">    "screenshot": true</span></span>
<span class="line"><span style="color:#A5D6FF">  },</span></span>
<span class="line"><span style="color:#A5D6FF">  "sharedParams": {</span></span>
<span class="line"><span style="color:#A5D6FF">    "mainContentOnly": true</span></span>
<span class="line"><span style="color:#A5D6FF">  }</span></span>
<span class="line"><span style="color:#A5D6FF">}'</span></span></code></pre></div></div><div class="flex min-h-12 items-center gap-2 border-t border-white/10 px-4 py-2"><code class="min-w-0 flex-1 overflow-x-auto whitespace-nowrap font-mono text-xs text-white/80">npm install context.dev</code><button type="button" aria-label="Copy TypeScript install command" class="flex size-8 items-center justify-center rounded-full text-white/60 transition-colors duration-150 hover:bg-white/10 hover:text-white focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-white motion-reduce:transition-none"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" color="currentColor" class="size-4" aria-hidden="true"><path d="M7 11V9C7 5.70017 7 4.05025 8.02513 3.02513C9.05025 2 10.7002 2 14 2C17.2998 2 18.9497 2 19.9749 3.02513C21 4.05025 21 5.70017 21 9V11C21 14.2998 21 15.9497 19.9749 16.9749C18.9497 18 17.2998 18 14 18C10.7002 18 9.05025 18 8.02513 16.9749C7 15.9497 7 14.2998 7 11Z" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5"></path><path d="M3 6V15C3 18.2998 3 19.9497 4.02513 20.9749C5.05025 22 6.70017 22 10 22H17" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5"></path></svg></button></div></div></div></div></div></div></div></div></div></div></div></section></div><div aria-hidden="true" data-grid-line="true" class="relative h-px w-screen [margin-inline:calc(50%-50vw)] bg-gray-200"></div><div class="contents max-md:[&amp;&gt;*]:[content-visibility:auto] max-md:[&amp;&gt;*]:[contain-intrinsic-size:auto_900px]"><section id="workflows" aria-labelledby="workflows-title" class="relative bg-white px-6 pt-10 pb-16 sm:px-8 md:px-10 md:pt-12 md:pb-20 lg:px-12"><div aria-hidden="true" class="pointer-events-none absolute inset-x-0 bottom-0 z-[70] flex justify-center top-0"><div class="relative h-full w-full max-w-[100vw] md:max-w-[90vw] lg:max-w-[85vw] xl:max-w-[var(--marketing-inner-max,68.75rem)]"><div class="absolute inset-y-0 left-0 w-px -translate-x-1/2 bg-gray-200"></div><div class="absolute inset-y-0 right-0 w-px translate-x-1/2 bg-gray-200"></div><div class="absolute top-0 left-1/2 h-px w-screen -translate-x-1/2 -translate-y-1/2 bg-gray-200"></div><span class="absolute size-2 rounded-full bg-gray-300 top-0 left-0 -translate-x-1/2 -translate-y-1/2"></span><span class="absolute size-2 rounded-full bg-gray-300 top-0 right-0 translate-x-1/2 -translate-y-1/2"></span></div></div><div class="flex flex-col items-start gap-6"><h2 id="workflows-title" class="max-w-[42rem] text-balance font-brand-heading text-[2rem] font-normal leading-[1.12] tracking-[-0.035em] md:text-[2.75rem] text-black">Build on <span class="text-brand-primary">what the web knows.</span></h2><p class="max-w-[36rem] font-brand-body text-base leading-relaxed text-black/60 md:text-lg">Connect web content to the places your product needs it: research, onboarding, enrichment, and retrieval.</p></div><div aria-hidden="true" class="pointer-events-none relative z-[71] mt-10 mb-8 h-px md:mt-12"><div class="absolute top-0 left-1/2 h-px w-screen -translate-x-1/2 bg-gray-200"></div><span class="absolute size-2 rounded-full bg-gray-300 top-1/2 left-[calc(-1*var(--marketing-gutter))] -translate-x-1/2 -translate-y-1/2"></span><span class="absolute size-2 rounded-full bg-gray-300 top-1/2 right-[calc(-1*var(--marketing-gutter))] translate-x-1/2 -translate-y-1/2"></span></div><ul class="grid grid-cols-1 gap-6 md:grid-cols-2 xl:grid-cols-3 xl:gap-5"><li class="brand-glass-ring"><div class="flex h-full min-w-0 flex-col gap-6 rounded-brand-section bg-white p-6 ring-1 ring-black/[0.08] md:p-8 xl:p-6"><div class="flex flex-col gap-3"><h3 class="text-h4 font-normal text-black">Scrape anything</h3><p class="text-[0.9375rem] leading-[1.5] text-black/65">Turn webpages and PDFs into Markdown, HTML, structured fields, images, and screenshots in one request.</p></div><div c