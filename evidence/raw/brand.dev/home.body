),\\n\\t)\\n\\n\\tmonitor, err := client.Monitors.New(context.TODO(), contextdev.MonitorNewParams{\\n\\t\\tName: \\\"Linear pricing changes\\\",\\n\\t\\tMode: contextdev.MonitorNewParamsModeWeb,\\n\\t\\tTarget: contextdev.MonitorNewParamsTargetUnion{\\n\\t\\t\\tOfPage: \u0026contextdev.MonitorNewParamsTargetPage{\\n\\t\\t\\t\\tURL: \\\"https://linear.app/pricing\\\",\\n\\t\\t\\t},\\n\\t\\t},\\n\\t\\tChangeDetection: contextdev.MonitorNewParamsChangeDetectionUnion{\\n\\t\\t\\tOfExact: \u0026contextdev.MonitorNewParamsChangeDetectionExact{},\\n\\t\\t},\\n\\t\\tSchedule: contextdev.MonitorNewParamsSchedule{\\n\\t\\t\\tType:      \\\"interval\\\",\\n\\t\\t\\tFrequency: 6,\\n\\t\\t\\tUnit:      \\\"hours\\\",\\n\\t\\t},\\n\\t})\\n\\tif err != nil {\\n\\t\\tpanic(err.Error())\\n\\t}\\n\\tfmt.Printf(\\\"%+v\\\\n\\\", monitor.ID)\\n}\",\"html\":\"$ee\"},{\"language\":\"curl\",\"label\":\"cURL\",\"filename\":\"monitors.sh\",\"install\":null,\"code\":\"curl -X POST \\\"https://api.context.dev/v1/monitors\\\" \\\\\\n  -H \\\"Content-Type: application/json\\\" \\\\\\n  -H \\\"Authorization: Bearer YOUR_API_KEY\\\" \\\\\\n  -d '{\\n  \\\"mode\\\": \\\"web\\\",\\n  \\\"name\\\": \\\"Linear pricing changes\\\",\\n  \\\"target\\\": {\\n    \\\"type\\\": \\\"page\\\",\\n    \\\"url\\\": \\\"https://linear.app/pricing\\\"\\n  },\\n  \\\"change_detection\\\": {\\n    \\\"type\\\": \\\"exact\\\"\\n  },\\n  \\\"schedule\\\": {\\n    \\\"type\\\": \\\"interval\\\",\\n    \\\"frequency\\\": 6,\\n    \\\"unit\\\": \\\"hours\\\"\\n  }\\n}'\",\"html\":\"$ef\"}]},{\"id\":6,\"title\":\"Retrieve brand data\",\"description\":\"Get the company profile and the website’s design system from one domain.\",\"docsUrl\":\"https://docs.context.dev/api-reference/brand-intelligence/brand\",\"tryItUrl\":\"/dashboard/api-playground/retrieve\",\"code\":\"import ContextDev from 'context.dev';\\n\\nconst client = new ContextDev({ apiKey: 'YOUR_API_KEY' });\\n\\nconst [{ brand }, { styleguide }] = await Promise.all([\\n  client.brand.retrieve({\\n    type: 'by_domain',\\n    domain: 'notion.so',\\n  }),\\n  client.web.extractStyleguide({\\n    domain: 'notion.so',\\n  }),\\n]);\\n\\nconsole.log(brand);\\nconsole.log(styleguide);\",\"glyph\":\"company\",\"samples\":[{\"language\":\"typescript\",\"label\":\"TypeScript\",\"filename\":\"brand.ts\",\"install\":\"npm install context.dev\",\"code\":\"import ContextDev from 'context.dev';\\n\\nconst client = new ContextDev({ apiKey: 'YOUR_API_KEY' });\\n\\nconst [{ brand }, { styleguide }] = await Promise.all([\\n  client.brand.retrieve({\\n    type: 'by_domain',\\n    domain: 'notion.so',\\n  }),\\n  client.web.extractStyleguide({\\n    domain: 'notion.so',\\n  }),\\n]);\\n\\nconsole.log(brand);\\nconsole.log(styleguide);\",\"html\":\"$f0\"},{\"language\":\"python\",\"label\":\"Python\",\"filename\":\"brand.py\",\"install\":\"pip install context.dev\",\"code\":\"from context.dev import ContextDev\\n\\nclient = ContextDev(api_key=\\\"YOUR_API_KEY\\\")\\n\\nbrand = client.brand.retrieve(\\n    domain=\\\"notion.so\\\",\\n    type=\\\"by_domain\\\",\\n)\\nstyleguide = client.web.extract_styleguide(\\n    domain=\\\"notion.so\\\",\\n)\\n\\nprint(brand)\\nprint(styleguide)\",\"html\":\"$f1\"},{\"language\":\"ruby\",\"label\":\"Ruby\",\"filename\":\"brand.rb\",\"install\":\"gem install context.dev base64\",\"code\":\"require \\\"cgi/core\\\"\\nrequire \\\"context_dev\\\"\\n\\nclient = ContextDev::Client.new(api_key: \\\"YOUR_API_KEY\\\")\\n\\nbrand = client.brand.retrieve(\\n  body: {\\n    domain: \\\"notion.so\\\",\\n    type: :by_domain\\n  }\\n)\\nstyleguide = client.web.extract_styleguide(\\n  domain: \\\"notion.so\\\"\\n)\\n\\nputs brand\\nputs styleguide\",\"html\":\"$f2\"},{\"language\":\"php\",\"label\":\"PHP\",\"filename\":\"brand.php\",\"install\":\"composer require \\\"context-dev/context-dev-php:^2.24\\\" guzzlehttp/guzzle\",\"code\":\"\u003c?php\\n\\nrequire_once 'vendor/autoload.php';\\n\\nuse ContextDev\\\\Client;\\n\\n$client = new Client(apiKey: 'YOUR_API_KEY');\\n\\n// Retrieve Brand goes through the low-level request method so one lookup type can be sent on its own.\\n$raw = $client-\u003erequest(\\n    method: 'post',\\n    path: 'brand/retrieve',\\n    body: [\\n        'domain' =\u003e 'notion.so',\\n        'type' =\u003e 'by_domain',\\n    ],\\n);\\n$brand = json_decode((string) $raw-\u003egetBody(), true, flags: JSON_THROW_ON_ERROR);\\n\\n$styleguide = $client-\u003eweb-\u003eextractStyleguide(\\n    domain: 'notion.so',\\n);\\n\\nvar_dump($brand);\\nvar_dump($styleguide);\",\"html\":\"$f3\"},{\"language\":\"go\",\"label\":\"Go\",\"filename\":\"brand.go\",\"install\":\"go get github.com/context-dot-dev/context-go-sdk/v2\",\"code\":\"package main\\n\\nimport (\\n\\t\\\"context\\\"\\n\\t\\\"fmt\\\"\\n\\n\\tcontextdev \\\"github.com/context-dot-dev/context-go-sdk/v2\\\"\\n\\t\\\"github.com/context-dot-dev/context-go-sdk/v2/option\\\"\\n)\\n\\nfunc main() {\\n\\tclient := contextdev.NewClient(\\n\\t\\toption.WithAPIKey(\\\"YOUR_API_KEY\\\"),\\n\\t)\\n\\n\\tbrand, err := client.Brand.Get(context.TODO(), contextdev.BrandGetParams{\\n\\t\\tOfByDomain: \u0026contextdev.BrandGetParamsBodyByDomain{\\n\\t\\t\\tDomain: \\\"notion.so\\\",\\n\\t\\t},\\n\\t})\\n\\tif err != nil {\\n\\t\\tpanic(err)\\n\\t}\\n\\n\\tstyleguide, err := client.Web.ExtractStyleguide(context.TODO(), contextdev.WebExtractStyleguideParams{\\n\\t\\tDomain: contextdev.String(\\\"notion.so\\\"),\\n\\t})\\n\\tif err != nil {\\n\\t\\tpanic(err)\\n\\t}\\n\\n\\tfmt.Printf(\\\"%+v\\\\n\\\", brand)\\n\\tfmt.Printf(\\\"%+v\\\\n\\\", styleguide)\\n}\",\"html\":\"$f4\"},{\"language\":\"curl\",\"label\":\"cURL\",\"filename\":\"brand.sh\",\"install\":null,\"code\":\"curl -X POST \\\"https://api.context.dev/v1/brand/retrieve\\\" \\\\\\n  -H \\\"Content-Type: application/json\\\" \\\\\\n  -H \\\"Authorization: Bearer YOUR_API_KEY\\\" \\\\\\n  -d '{\\\"domain\\\": \\\"notion.so\\\", \\\"type\\\": \\\"by_domain\\\"}'\\n\\ncurl -X GET \\\"https://api.context.dev/v1/web/styleguide?domain=notion.so\\\" \\\\\\n  -H \\\"Authorization: Bearer YOUR_API_KEY\\\"\",\"html\":\"$f5\"}]}]}]}]}]]}]]}]\n"])</script><script>self.__next_f.push([1,"1c:C\nc:C\n1b:C\na:C\n7:C\n4:C\n"])</script><script>self.__next_f.push([1,"1e:false\n1d:null\n"])</script></body></html>