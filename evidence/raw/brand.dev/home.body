s="mx-auto h-full max-w-[100vw] md:max-w-[90vw] lg:max-w-[85vw] xl:max-w-[var(--marketing-inner-max,68.75rem)] px-6 sm:px-8 md:px-10 lg:px-12"><div class="h-full border-x-[1px] [border-image:repeating-linear-gradient(to_bottom,rgba(0,0,0,0.12)_0,rgba(0,0,0,0.12)_4px,transparent_4px,transparent_8px)_1]"></div></div></div><div aria-hidden="true" class="pointer-events-none absolute inset-x-0 bottom-0 z-[70] flex justify-center top-0"><div class="relative h-full w-full max-w-[100vw] md:max-w-[90vw] lg:max-w-[85vw] xl:max-w-[var(--marketing-inner-max,68.75rem)]"><div class="absolute inset-y-0 left-0 w-px -translate-x-1/2 bg-gray-200"></div><div class="absolute inset-y-0 right-0 w-px translate-x-1/2 bg-gray-200"></div><div class="absolute top-0 left-1/2 h-px w-screen -translate-x-1/2 -translate-y-1/2 bg-gray-200"></div><span class="absolute size-2 rounded-full bg-gray-300 top-0 left-0 -translate-x-1/2 -translate-y-1/2"></span><span class="absolute size-2 rounded-full bg-gray-300 top-0 right-0 translate-x-1/2 -translate-y-1/2"></span></div></div><div class="w-full"><div class="pt-8 md:pt-10"><div class="relative z-10 mx-auto h-full max-w-[100vw] md:max-w-[90vw] lg:max-w-[85vw] xl:max-w-[var(--marketing-inner-max,68.75rem)] px-6 sm:px-8 md:px-10 lg:px-12 flex flex-col items-center justify-center text-center"><div class="max-w-[60rem]"><h2 class="text-4xl sm:text-5xl text-gray-900 leading-tight mb-6 text-balance"><span class="text-brand-primary">How customers shipped</span> with Context.dev</h2><p class="text-gray-500 text-base leading-relaxed max-w-md mx-auto">From scrappy startups to Fortune 500s, teams ship brand-powered features in days instead of quarters.</p><a class="inline-flex w-fit items-center justify-center whitespace-nowrap rounded-full border px-5 py-3 text-body font-normal transition-colors duration-200 motion-reduce:transition-none border-brand-primary bg-white text-brand-primary hover:bg-brand-blue-10 focus-visible:outline-2 focus-visible:outline-solid focus-visible:outline-offset-2 focus-visible:outline-ring focus-visible:ring-0 mt-8" href="/customers">See all customers</a></div></div></div><div class="mx-auto px-6 sm:px-8 md:px-10 lg:px-12 w-full max-w-[100vw] md:max-w-[90vw] lg:max-w-[85vw] xl:max-w-[var(--marketing-inner-max,68.75rem)]"><div aria-hidden="true" class="pointer-events-none relative z-[71] mt-10 mb-8 h-px md:mt-12"><div class="absolute top-0 left-1/2 h-px w-screen -translate-x-1/2 bg-gray-200"></div><span class="absolute size-2 rounded-full bg-gray-300 top-1/2 left-[calc(-1*var(--marketing-gutter))] -translate-x-1/2 -translate-y-1/2"></span><span class="absolute size-2 rounded-full bg-gray-300 top-1/2 right-[calc(-1*var(--marketing-gutter))] translate-x-1/2 -translate-y-1/2"></span></div></div><div class="relative z-[75] pb-20"><div class="homepage-card-carousel relative z-30 flex flex-col"><div class="relative z-30 w-screen max-w-[100vw] left-1/2 -translate-x-1/2 overflow-y-visible"><div class="relative z-30 overflow-x-auto overflow-y-hidden -my-6 py-6 scrollbar-hide w-full max-[43.2rem]:snap-x max-[43.2rem]:snap-mandatory"><div data-slides-track="true" class="homepage-card-carousel__track relative z-30 flex"><div data-slide="true" class="homepage-card-carousel__slide relative z-30 hover:z-40 shrink-0 snap-center snap-always"><a class="group rounded-brand-section focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-primary focus-visible:ring-offset-2 focus-visible:ring-offset-black" href="/customers/zero-keeps-data-on-20m-companies-fresh-with-context-dev"><article class="relative flex h-full flex-col overflow-hidden rounded-brand-section bg-brand-primary sm:h-[31.25rem]"><div class="relative flex h-60 shrink-0 items-center justify-center sm:h-49"><div class="absolute inset-0 size-full" aria-hidden="true"><svg viewBox="0 0 760 540" preserveAspectRatio="xMidYMid slice" class="block size-full opacity-0"></svg><canvas class="absolute inset-0 size-full invisible"></canvas></div></div><div cla