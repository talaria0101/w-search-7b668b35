div class="relative flex flex-col items-center w-full px-4 sm:px-6 lg:px-12 overflow-hidden h-[calc(100svh-var(--header-total-height))] min-h-[32rem] justify-center gap-7 pb-16 lg:gap-8"><div class="flex flex-col items-center relative z-10 mx-auto w-full shrink-0 gap-3" style="max-width:60rem"><span class="inline-flex items-center gap-1.5 text-body-sm text-black/60" data-hero-pattern-hole="box">Backed by<!-- --> <img alt="" aria-hidden="true" loading="lazy" width="18" height="18" decoding="async" data-nimg="1" class="rounded-[0.1875rem]" style="color:transparent" src="/yc-logo.svg?dpl=dpl_3vJXMp6ngN7XuBrhCA21QfK6vZAU"/><span class="sr-only">Y </span>Combinator</span><div class="flex flex-col items-center gap-3 w-full"><div class="flex flex-col items-center text-center w-full gap-3"><div class="flex w-full justify-center"><h1 class="w-full font-normal text-balance whitespace-pre-line text-black text-[2.5rem] leading-[1.1] tracking-[-0.035em] antialiased sm:text-[48px] lg:text-[56px] lg:leading-[1.08] xl:w-max xl:shrink-0 xl:whitespace-nowrap"><span data-hero-pattern-hole="text">Turn the web into <span class="text-brand-primary">context</span> your <span class="text-brand-primary">agents</span> can use.</span></h1></div><div class="w-full"><p class="text-balance text-black/60 text-h5"><span data-hero-pattern-hole="text">One API for agents to scrape, search, monitor, and collect data from the web.</span></p></div></div></div></div><div class="relative z-10 flex shrink-0 flex-wrap items-center justify-center gap-3" data-hero-pattern-hole="box"><a class="inline-flex w-fit items-center justify-center whitespace-nowrap border px-5 py-3 text-body font-normal transition-colors duration-200 motion-reduce:transition-none border-black bg-black text-white hover:bg-brand-neutral-80 focus-visible:outline-2 focus-visible:outline-solid focus-visible:outline-offset-2 focus-visible:outline-ring focus-visible:ring-0 rounded-full" href="/signup">Start for free</a><div class="relative inline-flex"><span role="status" class="pointer-events-none absolute bottom-full left-1/2 mb-2 inline-flex origin-bottom -translate-x-1/2 items-center gap-1.5 whitespace-nowrap rounded-lg bg-white/65 px-2.5 py-1.5 text-body-sm text-black/75 shadow-md ring-1 ring-black/[0.06] backdrop-blur-md backdrop-saturate-150 transition-[opacity,scale] duration-150 ease-out motion-reduce:transition-none scale-95 opacity-0"></span><button type="button" id="radix-_R_9l51br4nuhqlb_" aria-haspopup="menu" aria-expanded="false" data-state="closed" class="group/connect inline-flex items-center gap-2.5 overflow-hidden rounded-brand-button transition-colors motion-reduce:transition-none h-[calc(2.8rem+2px)] pl-2 pr-4 text-body font-normal tracking-normal border border-brand-primary bg-white text-brand-primary hover:bg-brand-blue-10 focus-visible:outline-2 focus-visible:outline-solid focus-visible:outline-offset-2 focus-visible:outline-ring focus-visible:ring-0 [--radius-brand-button:9999px] max-md:hidden"><span class="inline-flex items-center"><span aria-hidden="true" class="inline-flex shrink-0 items-center justify-center rounded-full size-6 bg-[#d97757] text-white ring-2 ring-white"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" color="currentColor" class="size-3.5" aria-hidden="true"><path d="M13 12L18.5 5M7.63965 3L12.5 12L13.6865 3M4.48381 6.71679L11.9872 12M3 12L11.9872 12.473M12.2244 13.177L7 20M4.84194 16.8682L11.2824 12.9758M11.5 21L12.665 13.177M21 14L13.1846 12.668M21 10.5788L13 12.3223M16.779 19.646L12.8876 13.3772M19.3566 18.207L13.313 12.9893" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5"></path></svg></span><span aria-hidden="true" class="inline-flex shrink-0 items-center justify-center rounded-full size-6 bg-black text-white ring-2 ring-white -ml-1.5"><svg viewBox="0 0 16 16" class="size-3.5" aria-hidden="true"><path fill="currentColor" fill-rule="evenodd" clip-rule="evenodd" d="M6.25 1.46C7.45 1.14 8.67 1.46 9.55 2.22C10.69 2 11.91 2.33 12.79 3.21C13.67 4.09 14 5.31 13.78 6.45C14.54 7.33 14.87 8.55 14.54 9.75C14.22 10.96 13.33 11.85 12.23 12.23C11.85 13.33 10.96 14.22 9.75 14.54C8.55 14.87 7.33 14.54 6.45 13.78C5.31 14 4.09 13.67 3.21 12.79C2.33 11.91 2 10.69 2.21 9.55C1.46 8.67 1.13 7.45 1.46 6.25C1.78 5.04 2.67 4.15 3.77 3.77C4.15 2.67 5.04 1.78 6.25 1.46ZM8.65 8.98C8.29 8.98 8 9.27 8 9.63C8 10 8.29 10.29 8.65 10.29H10.61C10.98 10.29 11.27 10 11.27 9.63C11.27 9.27 10.98 8.98 10.61 8.98H8.65ZM6.27 6.03C6.09 5.72 5.69 5.62 5.38 5.81C5.07 5.99 4.97 6.39 5.15 6.7L5.93 8L5.15 9.3C4.97 9.61 5.07 10.01 5.38 10.2C5.69 10.38 6.09 10.28 6.27 9.97L7.25 8.34C7.38 8.13 7.38 7.87 7.25 7.66L6.27 6.03Z"></path></svg></span><span aria-hidden="true" class="inline-flex shrink-0 items-center justify-center rounded-full size-6 bg-black text-white ring-2 ring-white -ml-1.5"><svg viewBox="0 0 24 24" class="size-3.5" aria-hidden="true"><path fill="currentColor" d="M11.503.131 1.891 5.678a.84.84 0 0 0-.42.726v11.188c0 .3.162.575.42.724l9.609 5.55a1 1 0 0 0 .998 0l9.61-5.55a.84.84 0 0 0 .42-.724V6.404a.84.84 0 0 0-.42-.726L12.497.131a1.01 1.01 0 0 0-.996 0M2.657 6.338h18.55c.263 0 .43.287.297.515L12.23 22.918c-.062.107-.229.064-.229-.06V12.335a.59.59 0 0 0-.295-.51l-9.11-5.257c-.109-.063-.064-.23.061-.23"></path></svg></span></span><span class="whitespace-nowrap">Connect Context.dev</span><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" color="currentColor" class="size-4 opacity-70 transition-transform duration-200 group-data-[state=open]/connect:rotate-180 motion-reduce:transition-none" aria-hidden="true"><path d="M18 9.00005C18 9.00005 13.5811 15 12 15C10.4188 15 6 9 6 9" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5"></path></svg></button></div><p class="w-full text-center text-body-sm md:hidden text-black/60">1,000 free credits. No card required.</p></div><div data-hero-pattern-hole="box" class="relative z-10 w-full max-w-[56.25rem] mx-auto flex min-h-0 flex-col items-center gap-[0.875rem] max-md:hidden"><div class="flex min-h-0 w-full flex-col items-center"><div class="brand-glass-ring relative z-10 w-full max-w-[58rem] rounded-[2.5rem]" data-hero-pattern-hole="box"><div class="relative flex min-h-0 w-full justify-center rounded-[2.25rem] bg-brand-primary p-3 sm:p-6 md:px-12 md:py-10"><div aria-hidden="true" class="pointer-events-none absolute inset-2 rounded-[2rem] md:inset-3"><svg class="absolute inset-0 size-full"><path d="" fill="none" stroke="#FFFFFF" stroke-opacity="0.22" stroke-width="1"></path></svg></div><div class="relative flex w-full justify-center [--hero-demo-ring:var(--color-brand-blue-80)]"><div class="brand-glass-ring w-[calc(100%+1rem)] max-w-[53rem] rounded-[1.75rem] [background:var(--hero-demo-ring,var(--color-brand-blue-80))]"><form toolname="context-dev-hero-demo" tooldescription="Explore Context.dev APIs: search the web, scrape a URL, get a cited answer to a question, map the URLs of a website, or get brand data for a domain. Pick the job and enter a URL, a query, or a question. Running an example requires a free account." data-hero-job="search" class="relative flex w-full flex-col overflow-hidden rounded-[1.25rem] bg-white"><div class="flex shrink-0 px-[10px] pt-[10px] md:px-[12px] md:pt-[12px]"><div role="group" aria-label="What to run" class="relative flex min-w-0 items-center rounded-[0.75rem] bg-black/[0.04] p-[4px] overflow-x-auto overscroll-x-contain scrollbar-hide touch-pan-x [-webkit-overflow-scrolling:touch]"><div class="relative isolate flex items-center gap-[2px]"><span aria-hidden="true" class="pointer-events-none absolute left-0 top-0 -z-10 rounded-[0.5rem] bg-white shadow-[0_1px_2px_rgba(0,0,0,0.08),0_1px_6px_rgba(0,0,0,0.04)] invisible"></span><div class="shrink-0"><button type="button" aria-label="Search Web" aria-pressed="true" data-glide-item="" data-tab-id="search" class="relative flex h-[38px] sh