:\"scrape.ts\",\"install\":\"npm install context.dev\",\"code\":\"import ContextDev from 'context.dev';\\n\\nconst client = new ContextDev({ apiKey: 'YOUR_API_KEY' });\\n\\nconst page = await client.web.scrape({\\n  url: 'https://linear.app',\\n  formats: {\\n    markdown: true,\\n    html: true,\\n    screenshot: true,\\n  },\\n  sharedParams: { mainContentOnly: true },\\n});\\n\\nif (page.markdown.success) console.log(page.markdown.data);\\nif (page.screenshot.success) console.log(page.screenshot.data);\",\"html\":\"$d3\"},{\"language\":\"python\",\"label\":\"Python\",\"filename\":\"scrape.py\",\"install\":\"pip install context.dev\",\"code\":\"from context.dev import ContextDev\\n\\nclient = ContextDev(api_key=\\\"YOUR_API_KEY\\\")\\n\\nresponse = client.web.scrape(\\n    url=\\\"https://linear.app\\\",\\n    formats={\\n        \\\"html\\\": True,\\n        \\\"markdown\\\": True,\\n        \\\"screenshot\\\": True\\n    },\\n    shared_params={\\n        \\\"main_content_only\\\": True\\n    },\\n)\\nprint(response)\",\"html\":\"$d4\"},{\"language\":\"ruby\",\"label\":\"Ruby\",\"filename\":\"scrape.rb\",\"install\":\"gem install context.dev base64\",\"code\":\"require \\\"cgi/core\\\"\\nrequire \\\"context_dev\\\"\\n\\nclient = ContextDev::Client.new(api_key: \\\"YOUR_API_KEY\\\")\\n\\nresponse = client.web.scrape(\\n  url: \\\"https://linear.app\\\",\\n  formats: {\\n    html: true,\\n    markdown: true,\\n    screenshot: true\\n  },\\n  shared_params: {\\n    main_content_only: true\\n  }\\n)\\nputs response\",\"html\":\"$d5\"},{\"language\":\"php\",\"label\":\"PHP\",\"filename\":\"scrape.php\",\"install\":\"composer require \\\"context-dev/context-dev-php:^2.24\\\" guzzlehttp/guzzle\",\"code\":\"\u003c?php\\n\\nrequire_once 'vendor/autoload.php';\\n\\nuse ContextDev\\\\Client;\\n\\n$client = new Client(apiKey: 'YOUR_API_KEY');\\n\\n$response = $client-\u003eweb-\u003escrape(\\n    url: 'https://linear.app',\\n    formats: [\\n        'html' =\u003e true,\\n        'markdown' =\u003e true,\\n        'screenshot' =\u003e true\\n    ],\\n    sharedParams: [\\n        'mainContentOnly' =\u003e true\\n    ]\\n);\\n\\nvar_dump($response);\",\"html\":\"$d6\"},{\"language\":\"go\",\"label\":\"Go\",\"filename\":\"scrape.go\",\"install\":\"go get github.com/context-dot-dev/context-go-sdk/v2\",\"code\":\"package main\\n\\nimport (\\n\\t\\\"context\\\"\\n\\t\\\"fmt\\\"\\n\\n\\tcontextdev \\\"github.com/context-dot-dev/context-go-sdk/v2\\\"\\n\\t\\\"github.com/context-dot-dev/context-go-sdk/v2/option\\\"\\n)\\n\\nfunc main() {\\n\\tclient := contextdev.NewClient(\\n\\t\\toption.WithAPIKey(\\\"YOUR_API_KEY\\\"),\\n\\t)\\n\\n\\tresponse, err := client.Web.Scrape(context.TODO(), contextdev.WebScrapeParams{\\n\\t\\tURL: \\\"https://linear.app\\\",\\n\\t\\tFormats: contextdev.WebScrapeParamsFormats{\\n\\t\\t\\tHTML:       contextdev.Bool(true),\\n\\t\\t\\tMarkdown:   contextdev.Bool(true),\\n\\t\\t\\tScreenshot: contextdev.Bool(true),\\n\\t\\t},\\n\\t\\tSharedParams: contextdev.WebScrapeParamsSharedParams{\\n\\t\\t\\tMainContentOnly: contextdev.Bool(true),\\n\\t\\t},\\n\\t})\\n\\tif err != nil {\\n\\t\\tpanic(err)\\n\\t}\\n\\n\\tfmt.Printf(\\\"%+v\\\\n\\\", response)\\n}\",\"html\":\"$d7\"},{\"language\":\"curl\",\"label\":\"cURL\",\"filename\":\"scrape.sh\",\"install\":null,\"code\":\"curl --request POST 'https://api.context.dev/v1/web/scrape' \\\\\\n  --header 'Authorization: Bearer YOUR_API_KEY' \\\\\\n  --header 'Content-Type: application/json' \\\\\\n  --data '{\\n  \\\"url\\\": \\\"https://linear.app\\\",\\n  \\\"formats\\\": {\\n    \\\"html\\\": true,\\n    \\\"markdown\\\": true,\\n    \\\"screenshot\\\": true\\n  },\\n  \\\"sharedParams\\\": {\\n    \\\"mainContentOnly\\\": true\\n  }\\n}'\",\"html\":\"$d8\"}]},{\"id\":2,\"title\":\"Map domains\",\"description\":\"Discover page URLs across a domain, with titles and descriptions when available.\",\"docsUrl\":\"https://docs.context.dev/api-reference/web-scraping/map\",\"tryItUrl\":\"/dashboard/api-playground/scrape-sitemap\",\"code\":\"import ContextDev from 'context.dev';\\n\\nconst client = new ContextDev({ apiKey: 'YOUR_API_KEY' });\\n\\nconst { urls } = await client.web.mapUrls({\\n  domain: 'stripe.com',\\n  includeSubdomains: true,\\n  maxLinks: 100,\\n});\\n\\nfor (const page of urls) {\\n  console.log(page.url, page.title, page.description);\\n}\",\"glyph\":\"map\",\"samples\":[{\"language\":\"typescript\",\"label\":\"TypeScript\",\"filename\":\"map.ts\",\"install\":\"npm install context.dev\",\"code\":\"import ContextDev from 'context.dev';\\n\\nconst client = new ContextDev({ apiKey: 'YOUR_API_KEY' });\\n\\nconst { urls } = await client.web.mapUrls({\\n  domain: 'stripe.com',\\n  includeSubdomains: true,\\n  maxLinks: 100,\\n});\\n\\nfor (const page of urls) {\\n  console.log(page.url, page.title, page.description);\\n}\",\"html\":\"$d9\"},{\"language\":\"python\",\"label\":\"Python\",\"filename\":\"map.py\",\"install\":\"pip install context.dev\",\"code\":\"from context.dev import ContextDev\\n\\nclient = ContextDev(api_key=\\\"YOUR_API_KEY\\\")\\n\\nresponse = client.web.map_urls(\\n    domain=\\\"stripe.com\\\",\\n    include_subdomains=True,\\n    max_links=100,\\n)\\nprint(response)\",\"html\":\"$da\"},{\"language\":\"ruby\",\"label\":\"Ruby\",\"filename\":\"map.rb\",\"install\":\"gem install context.dev base64\",\"code\":\"require \\\"cgi/core\\\"\\nrequire \\\"context_dev\\\"\\n\\nclient = ContextDev::Client.new(api_key: \\\"YOUR_API_KEY\\\")\\n\\nresponse = client.web.map_urls(\\n  domain: \\\"stripe.com\\\",\\n  include_subdomains: true,\\n  max_links: 100\\n)\\nputs response\",\"html\":\"$db\"},{\"language\":\"php\",\"label\":\"PHP\",\"filename\":\"map.php\",\"install\":\"composer require \\\"context-dev/context-dev-php:^2.24\\\" guzzlehttp/guzzle\",\"code\":\"\u003c?php\\n\\nrequire_once 'vendor/autoload.php';\\n\\nuse ContextDev\\\\Client;\\n\\n$client = new Client(apiKey: 'YOUR_API_KEY');\\n\\n$response = $client-\u003eweb-\u003emapUrls(\\n    domain: 'stripe.com',\\n    includeSubdomains: true,\\n    maxLinks: 100\\n);\\n\\nvar_dump($response);\",\"html\":\"$dc\"},{\"language\":\"go\",\"label\":\"Go\",\"filename\":\"map.go\",\"install\":\"go get github.com/context-dot-dev/context-go-sdk/v2\",\"code\":\"package main\\n\\nimport (\\n\\t\\\"context\\\"\\n\\t\\\"fmt\\\"\\n\\n\\tcontextdev \\\"github.com/context-dot-dev/context-go-sdk/v2\\\"\\n\\t\\\"github.com/context-dot-dev/context-go-sdk/v2/option\\\"\\n)\\n\\nfunc main() {\\n\\tclient := contextdev.NewClient(\\n\\t\\toption.WithAPIKey(\\\"YOUR_API_KEY\\\"),\\n\\t)\\n\\n\\tresponse, err := client.Web.MapURLs(context.TODO(), contextdev.WebMapURLsParams{\\n\\t\\tDomain:            \\\"stripe.com\\\",\\n\\t\\tIncludeSubdomains: contextdev.Bool(true),\\n\\t\\tMaxLinks:          contextdev.Int(100),\\n\\t})\\n\\tif err != nil {\\n\\t\\tpanic(err)\\n\\t}\\n\\n\\tfmt.Printf(\\\"%+v\\\\n\\\", response)\\n}\",\"html\":\"$dd\"},{\"language\":\"curl\",\"label\":\"cURL\",\"filename\":\"map.sh\",\"install\":null,\"code\":\"curl -X GET \\\"https://api.context.dev/v1/web/urls?domain=stripe.com\u0026includeSubdomains=true\u0026maxLinks=100\\\" \\\\\\n  -H \\\"Authorization: Bearer YOUR_API_KEY\\\"\",\"html\":\"\u003cpre class=\\\"shiki context-code-dark\\\" style=\\\"background-color:#00000000;color:#e6edf3\\\"\u003e\u003ccode\u003e\u003cspan class=\\\"line\\\"\u003e\u003cspan style=\\\"color:#7EE787\\\"\u003ecurl\u003c/span\u003e\u003cspan style=\\\"color:#A5D6FF\\\"\u003e -X\u003c/span\u003e\u003cspan style=\\\"color:#A5D6FF\\\"\u003e GET\u003c/span\u003e\u003cspan style=\\\"color:#A5D6FF\\\"\u003e \\\"https://api.context.dev/v1/web/urls?domain=stripe.com\u0026#x26;includeSubdomains=true\u0026#x26;maxLinks=100\\\"\u003c/span\u003e\u003cspan style=\\\"color:#E6EDF3\\\"\u003e \\\\\u003c/span\u003e\u003c/span\u003e\\n\u003cspan class=\\\"line\\\"\u003e\u003cspan style=\\\"color:#A5D6FF\\\"\u003e  -H\u003c/span\u003e\u003cspan style=\\\"color:#A5D6FF\\\"\u003e \\\"Authorization: Bearer YOUR_API_KEY\\\"\u003c/span\u003e\u003c/span\u003e\u003c/code\u003e\u003c/pre\u003e\"}]},{\"id\":3,\"title\":\"Run batches\",\"description\":\"Scrape thousands of URLs or crawl a site in the background with one batch job.\",\"docsUrl\":\"https://docs.context.dev/api-reference/batches/submit\",\"tryItUrl\":\"/dashboard/batches/new\",\"tryItLabel\":\"Create a batch\",\"code\":\"import ContextDev from 'context.dev';\\n\\nconst client = new ContextDev({ apiKey: 'YOUR_API_KEY' });\\n\\nconst urls = [\\n  'https://example.com',\\n  'https://example.com/pricing',\\n  'https://example.com/docs',\\n];\\n\\nconst batch = await client.batch.submit({\\n  input: {\\n    mode: 'scrape',\\n    data: {\\n      formats: { markdown: true },\\n      urls: urls.map((url) =\u003e ({ url })),\\n    },\\n  },\\n});\\n\\nconsole.log(batch.id, batch.status);\",\"glyph\":\"batches\",\"samples\":[{\"language\":\"typescript\",\"label\":\"TypeScript\",\"filename\":\"batches.ts\",\"install\":\"npm install context.dev\",\"code\":\"import ContextDev from 'context.dev';\\n\\nconst client = new ContextDev({ apiKey: 'YOUR_API_KEY' });\\n\\nconst urls = [\\n  'https://example.com',\\n  'https://example.com/pricing',\\n  'https://example.com/docs',\\n];\\n\\nconst batch = await client.batch.submit({\\n  input: {\\n    mode: 'scrape',\\n    data: {\\n      formats: { markdown: true },\\n      urls: urls.map((url) =\u003e ({ url })),\\n    },\\n  },\\n});\\n\\nconsole.log(batch.id, batch.status);\",\"html\":\"$de\"},{\"language\":\"python\",\"label\":\"Python\",\"filename\":\"batches.py\",\"install\":\"pip install context.dev\",\"code\":\"from context.dev import ContextDev\\n\\nclient = ContextDev(api_key=\\\"YOUR_API_KEY\\\")\\n\\nbatch = client.batch.submit(\\n    input={\\n        \\\"mode\\\": \\\"scrape\\\",\\n        \\\"data\\\": {\\n            \\\"formats\\\": {\\\"markdown\\\": True},\\n            \\\"urls\\\": [\\n                {\\n                    \\\"url\\\": \\\"https://example.com\\\",\\n                },\\n                {\\n                    \\\"url\\\": \\\"https://example.com/pricing\\\",\\n                },\\n                {\\n                    \\\"url\\\": \\\"https://example.com/docs\\\",\\n                },\\n            ],\\n        },\\n    },\\n)\\nprint(batch.id, batch.status)\",\"html\":\"$df\"},{\"language\":\"ruby\",\"label\":\"Ruby\",\"filename\":\"batches.rb\",\"install\":\"gem install context.dev base64\",\"code\":\"require \\\"cgi/core\\\"\\nrequire \\\"context_dev\\\"\\n\\nclient = ContextDev::Client.new(api_key: \\\"YOUR_API_KEY\\\")\\n\\nbatch = client.batch.submit(\\n  input: {\\n    mode: \\\"scrape\\\",\\n    data: {\\n      formats: {markdown: true},\\n      urls: [\\n        {\\n          url: \\\"https://example.com\\\"\\n        },\\n        {\\n          url: \\\"https://example.com/pricing\\\"\\n        },\\n        {\\n          url: \\\"https://example.com/docs\\\"\\n        }\\n      ]\\n    }\\n  }\\n)\\n\\nputs(batch.id)\",\"html\":\"$e0\"},{\"language\":\"php\",\"label\":\"PHP\",\"filename\":\"batches.php\",\"install\":\"composer require \\\"context-dev/context-dev-php:^2.24\\\" guzzlehttp/guzzle\",\"code\":\"\u003c?php\\n\\nrequire_once 'vendor/autoload.php';\\n\\nuse ContextDev\\\\Client;\\n\\n$client = new Client(apiKey: 'YOUR_API_KEY');\\n\\n$batch = $client-\u003ebatch-\u003esubmit(\\n    input: [\\n        'mode' =\u003e 'scrape',\\n        'data' =\u003e [\\n            'formats' =\u003e ['markdown' =\u003e true],\\n            'urls' =\u003e [\\n                [\\n                    'url' =\u003e 'https://example.com',\\n                ],\\n                [\\n                    'url' =\u003e 'https://example.com/pricing',\\n                ],\\n                [\\n                    'url' =\u003e 'https://example.com/docs',\\n                ],\\n            ],\\n        ],\\n    ],\\n);\\n\\nvar_dump($batch);\",\"html\":\"$e1\"},{\"language\":\"go\",\"label\":\"Go\",\"filename\":\"batches.go\",\"install\":\"go get github.com/context-dot-dev/context-go-sdk/v2\",\"code\":\"package main\\n\\nimport (\\n\\t\\\"context\\\"\\n\\t\\\"fmt\\\"\\n\\n\\tcontextdev \\\"github.com/context-dot-dev/context-go-sdk/v2\\\"\\n\\t\\\"github.com/context-dot-dev/context-go-sdk/v2/option\\\"\\n)\\n\\nfunc main() {\\n\\tclient := contextdev.NewClient(\\n\\t\\toption.WithAPIKey(\\\"YOUR_API_KEY\\\"),\\n\\t)\\n\\n\\tbatch, err := client.Batch.Submit(context.TODO(), contextdev.BatchSubmitParams{\\n\\t\\tInput: contextdev.BatchSubmitParamsInputUnion{\\n\\t\\t\\tOfScrape: \u0026contextdev.BatchSubmitParamsInputScrape{\\n\\t\\t\\t\\tData: contextdev.BatchSubmitParamsInputScrapeData{\\n\\t\\t\\t\\t\\tFormats: contextdev.BatchSubmitParamsInputScrapeDataFormats{\\n\\t\\t\\t\\t\\t\\tMarkdown: contextdev.Bool(true),\\n\\t\\t\\t\\t\\t},\\n\\t\\t\\t\\t\\tURLs: []contextdev.BatchSubmitParamsInputScrapeDataURL{\\n\\t\\t\\t\\t\\t\\t{URL: \\\"https://example.com\\\"},\\n\\t\\t\\t\\t\\t\\t{URL: \\\"https://example.com/pricing\\\"},\\n\\t\\t\\t\\t\\t\\t{URL: \\\"https://example.com/docs\\\"},\\n\\t\\t\\t\\t\\t},\\n\\t\\t\\t\\t},\\n\\t\\t\\t},\\n\\t\\t},\\n\\t})\\n\\tif err != nil {\\n\\t\\tpanic(err.Error())\\n\\t}\\n\\tfmt.Printf(\\\"%+v\\\\n\\\", batch.ID)\\n}\",\"html\":\"$e2\"},{\"language\":\"curl\",\"label\":\"cURL\",\"filename\":\"batches.sh\",\"install\":null,\"code\":\"curl -X POST \\\"https://api.context.dev/v1/batch/submit\\\" \\\\\\n  -H \\\"Content-Type: application/json\\\" \\\\\\n  -H \\\"Authorization: Bearer YOUR_API_KEY\\\" \\\\\\n  -d '{\\n  \\\"input\\\": {\\n    \\\"mode\\\": \\\"scrape\\\",\\n    \\\"data\\\": {\\n      \\\"formats\\\": {\\\"markdown\\\": true},\\n      \\\"urls\\\": [\\n        {\\n          \\\"url\\\": \\\"https://example.com\\\"\\n        },\\n        {\\n          \\\"url\\\": \\\"https://example.com/pricing\\\"\\n        },\\n        {\\n          \\\"url\\\": \\\"https://example.com/docs\\\"\\n        }\\n      ]\\n    }\\n  }\\n}'\",\"html\":\"$e3\"}]},{\"id\":4,\"title\":\"Answers from the web\",\"description\":\"Ask a research question and get structured answers with source URLs.\",\"docsUrl\":\"https://docs.context.dev/api-reference/web-extraction/answers\",\"tryItUrl\":\"/dashboard/api-playground/answers\",\"code\":\"import ContextDev from 'context.dev';\\n\\nconst client = new ContextDev({ apiKey: 'YOUR_API_KEY' });\\n\\nconst answer = await client.web.answers({\\n  task: 'Find the main product features on linear.app.',\\n  mode: 'fast',\\n  json_format: {\\n    features: [''],\\n  },\\n});\\n\\nconsole.log(answer.json_content);\\nconsole.log(answer.sources);\",\"glyph\":\"chat\",\"samples\":[{\"language\":\"typescript\",\"label\":\"TypeScript\",\"filename\":\"answers.ts\",\"install\":\"npm install context.dev\",\"code\":\"import ContextDev from 'context.dev';\\n\\nconst client = new ContextDev({ apiKey: 'YOUR_API_KEY' });\\n\\nconst answer = await client.web.answers({\\n  task: 'Find the main product features on linear.app.',\\n  mode: 'fast',\\n  json_format: {\\n    features: [''],\\n  },\\n});\\n\\nconsole.log(answer.json_content);\\nconsole.log(answer.sources);\",\"html\":\"$e4\"},{\"language\":\"python\",\"label\":\"Python\",\"filename\":\"answers.py\",\"install\":\"pip install context.dev\",\"code\":\"from context.dev import ContextDev\\n\\nclient = ContextDev(api_key=\\\"YOUR_API_KEY\\\")\\n\\nresponse = client.web.answers(\\n    task=\\\"Find the main product features on linear.app.\\\",\\n    mode=\\\"fast\\\",\\n    json_format={\\\"features\\\": [\\\"\\\"]},\\n)\\nprint(response)\",\"html\":\"$e5\"},{\"language\":\"ruby\",\"label\":\"Ruby\",\"filename\":\"answers.rb\",\"install\":\"gem install context.dev base64\",\"code\":\"require \\\"cgi/core\\\"\\nrequire \\\"context_dev\\\"\\n\\nclient = ContextDev::Client.new(api_key: \\\"YOUR_API_KEY\\\")\\n\\nresponse = client.web.answers(\\n  task: \\\"Find the main product features on linear.app.\\\"