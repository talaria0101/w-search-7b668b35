left-1/2 h-px w-screen -translate-x-1/2 bg-gray-200"></div><span class="absolute size-2 rounded-full bg-gray-300 top-1/2 left-[calc(-1*var(--marketing-gutter))] -translate-x-1/2 -translate-y-1/2"></span><span class="absolute size-2 rounded-full bg-gray-300 top-1/2 right-[calc(-1*var(--marketing-gutter))] translate-x-1/2 -translate-y-1/2"></span></div><div class="grid grid-cols-1 gap-6 lg:grid-cols-[minmax(0,0.8fr)_minmax(0,1.4fr)]"><div class="brand-glass-ring"><div class="flex h-full min-w-0 flex-col rounded-brand-section bg-white p-6 ring-1 ring-black/[0.08] md:p-8 items-center justify-center gap-2 text-center"><span class="font-brand-heading text-[4rem] font-normal leading-none tracking-[-0.045em] text-brand-primary md:text-[5rem]">99.96%</span><span class="text-body text-black/65">Scrape success rate, with no configuration.</span></div></div><div class="brand-glass-ring"><div class="flex h-full items-center rounded-brand-section bg-white p-4 ring-1 ring-black/[0.08] sm:p-6"><div class="relative w-full" style="padding-top:50px;padding-inline:20px;padding-bottom:20px"><svg aria-hidden="true" class="pointer-events-none absolute inset-0 size-full text-brand-primary"><path d="" fill="currentColor"></path><path d="" fill="none" stroke="currentColor" stroke-width="1"></path></svg><div class="relative"><div class="flex items-center justify-between gap-3 border-b border-black/[0.06] pb-4"><span class="truncate font-mono text-xs text-black">shop.example.com/products</span><span class="shrink-0 rounded-full bg-brand-primary/10 px-3 py-1 font-mono text-xs text-brand-primary">200 OK</span></div><ol aria-label="Request log" class="py-2"><li class="flex min-h-10 items-center gap-3 py-1"><span class="hidden w-9 shrink-0 font-mono text-xs text-black/40 sm:block">0.0s</span><span aria-hidden="true" class="size-2.5 shrink-0 rounded-full bg-brand-primary"></span><span class="min-w-0 flex-1 text-body-sm text-black">Rendered in a real browser</span><span class="hidden shrink-0 pl-3 text-right font-mono text-xs sm:block text-black/55">JS executed</span></li><li class="flex min-h-10 items-center gap-3 py-1"><span class="hidden w-9 shrink-0 font-mono text-xs text-black/40 sm:block">1.1s</span><span aria-hidden="true" class="size-2.5 shrink-0 rounded-full ring-[1.5px] ring-inset ring-brand-primary"></span><span class="min-w-0 flex-1 text-body-sm text-black">Blocked by bot protection</span><span class="hidden shrink-0 pl-3 text-right font-mono text-xs sm:block text-black">403</span></li><li class="flex min-h-10 items-center gap-3 py-1"><span class="hidden w-9 shrink-0 font-mono text-xs text-black/40 sm:block">1.2s</span><span aria-hidden="true" class="size-2.5 shrink-0 rounded-full bg-brand-primary"></span><span class="min-w-0 flex-1 text-body-sm text-black">Escalated to a stronger proxy</span><span class="hidden shrink-0 pl-3 text-right font-mono text-xs sm:block text-black/55">automatic</span></li><li class="flex min-h-10 items-center gap-3 py-1"><span class="hidden w-9 shrink-0 font-mono text-xs text-black/40 sm:block">2.0s</span><span aria-hidden="true" class="size-2.5 shrink-0 rounded-full bg-brand-primary"></span><span class="min-w-0 flex-1 text-body-sm text-black">Retried with a new strategy</span><span class="hidden shrink-0 pl-3 text-right font-mono text-xs sm:block text-black/55">200</span></li></ol><div class="flex items-center justify-between gap-3 border-t border-black/[0.06] pt-4"><span class="flex items-center gap-3 whitespace-nowrap text-body-sm text-black"><span aria-hidden="true" class="size-2.5 shrink-0 rounded-full bg-brand-primary"></span>Markdown returned</span><span class="whitespace-nowrap font-mono text-xs text-black/55">2.4s · 1 credit</span></div></div></div></div></div></div><ul class="mt-6 grid grid-cols-1 gap-6 md:grid-cols-3"><li class="brand-glass-ring"><div class="flex h-full min-w-0 flex-col gap-3 rounded-brand-section bg-white p-6 ring-1 ring-black/[0.08] md:p-8"><h3 class="text-h4 font-normal text-black">JavaScript rendering, always</h3><p class="text-body text-black/65">Every request loads in a real browser. There is no opt-out, because half-rendered HTML from a single-page app is a failure that looks like a success.</p></div></li><li class="brand-glass-ring"><div class="flex h-full min-w-0 flex-col gap-3 rounded-brand-section bg-white p-6 ring-1 ring-black/[0.08] md:p-8"><h3 class="text-h4 font-normal text-black">Proxies that escalate</h3><p class="text-body text-black/65">When a site blocks a request, it moves to a stronger proxy on its own. You never pick a proxy tier or pay extra for one.</p></div></li><li class="brand-glass-ring"><div class="flex h-full min-w-0 flex-col gap-3 rounded-brand-section bg-white p-6 ring-1 ring-black/[0.08] md:p-8"><h3 class="text-h4 font-normal text-black">Retries that adapt</h3><p class="text-body text-black/65">Failed attempts retry with a different strategy before anything comes back to you. Retries run on our side, not in your code.</p></div></li></ul></section></div><div aria-hidden="true" data-grid-line="true" class="relative h-px w-screen [margin-inline:calc(50%-50vw)] bg-gray-200"></div><div class="contents max-md:[&amp;&gt;*]:[content-visibility:auto] max-md:[&amp;&gt;*]:[contain-intrinsic-size:auto_900px]"><section id="use-cases" class="w-screen [margin-inline:calc(50%-50vw)] relative bg-white pt-10 pb-16 md:pt-12"><div aria-hidden="true" class="pointer-events-none absolute inset-x-0 bottom-0 z-[70] flex justify-center top-0"><div class="relative h-full w-full max-w-[100vw] md:max-w-[90vw] lg:max-w-[85vw] xl:max-w-[var(--marketing-inner-max,68.75rem)]"><div class="absolute inset-y-0 left-0 w-px -translate-x-1/2 bg-gray-200"></div><div class="absolute inset-y-0 right-0 w-px translate-x-1/2 bg-gray-200"></div><div class="absolute top-0 left-1/2 h-px w-screen -translate-x-1/2 -translate-y-1/2 bg-gray-200"></div><span class="absolute size-2 rounded-full bg-gray-300 top-0 left-0 -translate-x-1/2 -translate-y-1/2"></span><span class="ab