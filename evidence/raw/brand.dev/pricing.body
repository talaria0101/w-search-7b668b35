utline-offset-1 outline-black/5" style="color:transparent" srcSet="/_next/image?url=%2Ftestimonials%2Ftuomo-riekki.png&amp;w=48&amp;q=75&amp;dpl=dpl_3vJXMp6ngN7XuBrhCA21QfK6vZAU 1x, /_next/image?url=%2Ftestimonials%2Ftuomo-riekki.png&amp;w=96&amp;q=75&amp;dpl=dpl_3vJXMp6ngN7XuBrhCA21QfK6vZAU 2x" src="/_next/image?url=%2Ftestimonials%2Ftuomo-riekki.png&amp;w=96&amp;q=75&amp;dpl=dpl_3vJXMp6ngN7XuBrhCA21QfK6vZAU"/><div class="flex flex-col"><p class="text-sm text-gray-900">Tuomo Riekki</p><p class="text-xs text-gray-500">Co-founder @ Zero</p></div></div><p class="text-[0.875rem] leading-[1.375rem] text-gray-700">“<!-- -->Migrating to Context.dev was extremely easy. The APIs are clean and easy for agents to understand and implement. The Dashboard is also handy for testing out how various scraping types behave. Switching to Context.dev from our existing scraping and web search providers took probably less than 5min with Codex.<!-- -->”</p><a target="_blank" rel="noopener noreferrer" class="group/case mt-4 inline-flex items-center gap-1 text-xs font-semibold text-brand-primary hover:underline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-brand-primary" href="/customers/zero-keeps-data-on-20m-companies-fresh-with-context-dev"><span>Read the case study</span><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" color="currentColor" class="size-3 transition-transform duration-200 ease-out group-hover/case:translate-x-0.5 motion-reduce:transition-none"><path d="M18.5 12L4.99997 12" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5"></path><path d="M13 18C13 18 19 13.5811 19 12C19 10.4188 13 6 13 6" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5"></path></svg></a></div></div><div data-testimonial-id="23" class="absolute inset-x-0 top-0 rounded-brand-card border"><div class="p-5"><div class="mb-4 flex items-center gap-3"><img alt="Nick Khami" loading="lazy" width="44" height="44" decoding="async" data-nimg="1" class="size-11 rounded-full object-cover outline-1 -outline-offset-1 outline-black/5" style="color:transparent" srcSet="/_next/image?url=%2Ftestimonials%2Fnickkhami.png&amp;w=48&amp;q=75&amp;dpl=dpl_3vJXMp6ngN7XuBrhCA21QfK6vZAU 1x, /_next/image?url=%2Ftestimonials%2Fnickkhami.png&amp;w=96&amp;q=75&amp;dpl=dpl_3vJXMp6ngN7XuBrhCA21QfK6vZAU 2x" src="/_next/image?url=%2Ftestimonials%2Fnickkhami.png&amp;w=96&amp;q=75&amp;dpl=dpl_3vJXMp6ngN7XuBrhCA21QfK6vZAU"/><div class="flex flex-col"><p class="text-sm text-gray-900">Nick Khami</p><p class="text-xs text-gray-500">Engineering Manager @ Mintlify</p></div></div><p class="text-[0.875rem] leading-[1.375rem] text-gray-700">“<!-- -->Onboarding couldn&#x27;t be simpler. Self-serve sign-up gives you an API key immediately, the documentation is thorough, and we were integrating within 10 minutes.<!-- -->”</p><a target="_blank" rel="noopener noreferrer" class="group/case mt-4 inline-flex items-center gap-1 text-xs font-semibold text-brand-primary hover:underline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-brand-primary" href="/blog/mintlify-turns-github-repos-into-branded-docs-sites-with-brand-dev"><span>Read the case study</span><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" color="currentColor" class="size-3 transition-transform duration-200 ease-out group-hover/case:translate-x-0.5 motion-reduce:transition-none"><path d="M18.5 12L4.99997 12" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5"></path><path d="M13 18C13 18 19 13.5811 19 12C19 10.4188 13 6 13 6" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5"></path></svg></a></div></div><div data-testimonial-id="24" class="absolute inset-x-0 top-0 rounded-brand-card border"><div class="p-5"><div class="mb-4 flex items-center gap-3"><img alt="Pranav" loading="lazy" width="44" height="44" decoding="async" data-nimg="1" class="size-11 rounded-full object-cover outline-1 -outline-offset-1 outline-black/5" style="color:transparent" srcSet="/_next/image?url=%2Ftestimonials%2Fpranav.jpg&amp;w=48&amp;q=75&amp;dpl=dpl_3vJXMp6ngN7XuBrhCA21QfK6vZAU 1x, /_next/image?url=%2Ftestimonials%2Fpranav.jpg&amp;w=96&amp;q=75&amp;dpl=dpl_3vJXMp6ngN7XuBrhCA21QfK6vZAU 2x" src="/_next/image?url=%2Ftestimonials%2Fpranav.jpg&amp;w=96&amp;q=75&amp;dpl=dpl_3vJXMp6ngN7XuBrhCA21QfK6vZAU"/><div class="flex flex-col"><p class="text-sm text-gray-900">Pranav</p><p class="text-xs text-gray-500">Founder @ Chatwoot</p></div></div><p class="text-[0.875rem] leading-[1.375rem] text-gray-700">“<!-- -->Happy to be a paid customer of @getcontextdev. It&#x27;s great, gives us the best results with ms response times. We have tested a couple of products, and Context wins without a doubt.<!-- -->”</p></div></div><div data-testimonial-id="32" class="absolute inset-x-0 top-0 rounded-brand-card border"><div class="p-5"><div class="mb-4 flex items-center gap-3"><img alt="Raz" loading="lazy" width="44" height="44" decoding="async" data-nimg="1" class="size-11 rounded-full object-cover outline-1 -outline-offset-1 outline-black/5" style="color:transparent" srcSet="/_next/image?url=%2Ftestimonials%2Fraz-similarweb.jpeg&amp;w=48&amp;q=75&amp;dpl=dpl_3vJXMp6ngN7XuBrhCA21QfK6vZAU 1x, /_next/image?url=%2Ftestimonials%2Fraz-similarweb.jpeg&amp;w=96&amp;q=75&amp;dpl=dpl_3vJXMp6ngN7XuBrhCA21QfK6vZAU 2x" src="/_next/image?url=%2Ftestimonials%2Fraz-similarweb.jpeg&amp;w=96&amp;q=75&amp;dpl=dpl_3vJXMp6ngN7XuBrhCA21QfK6vZAU"/><div class="flex flex-col"><p class="text-sm text-gray-900">Raz</p><p class="text-xs text-gray-500">AI @ Similarweb</p></div></div><p class="text-[0.875rem] leading-[1.375rem] text-gray-700">“<!-- -->My agent understood it perfectly. Setup was very easy. I was looking for a nice datapoint for my agents, and Context.dev was the best one in the marketplace.<!-- -->”</p><a target="_blank" rel="noopener noreferrer" class="group/case mt-4 inline-flex items-center gap-1 text-xs font-semibold text-brand-primary hover:underline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-brand-primary" href="/blog/similarweb-10x-ai-agents-with-context-dev"><span>Read the case study</span><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" color="currentColor" class="size-3 transition-transform duration-200 ease-out group-hover/case:translate-x-0.5 motion-reduce:transition-none"><path d="M18.5 12L4.99997 12" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5"></path><path d="M13 18C13 18 19 13.5811 19 12C19 10.4188 13 6 13 6" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5"></path></svg></a></div></div><div data-testimonial-id="17" class="absolute inset-x-0 top-0 rounded-brand-card border"><div class="p-5"><div class="mb-4 flex items-center gap-3"><img alt="Wilson Wilson" loading="lazy" width="44" height="44" decoding="async" data-nimg="1" class="size-11 rounded-full object-cover outline-1 -outline-offset-1 outline-black/5" style="color:transparent" srcSet="/_next/image?url=%2Ftestimonials%2Fwilsonwilson.webp&amp;w=48&amp;q=75&amp;dpl=dpl_3vJXMp6ngN7XuBrhCA21QfK6vZAU 1x, /_next/image?url=%2Ftestimonials%2Fwilsonwilson.webp&amp;w=96&amp;q=75&amp;dpl=dpl_3vJXMp6ngN7XuBrhCA21QfK6vZAU 2x" src="/_next/image?url=%2Ftestimonials%2Fwilsonwilson.webp&amp;w=96&amp;q=75&amp;dpl=dpl_3vJXMp6ngN7XuBrhCA21QfK6vZAU"/><div class="flex flex-col"><p class="text-sm text-gray-900">Wilson Wilson</p><p class="text-xs text-gray-500">Founder @ Ferndesk</p></div></div><p class="text-[0.875rem] leading-[1.375rem] text-gray-700">“<!-- -->Now that context.dev has been integrated into Ferndesk, we&#x27;ve been able to ship this really beautiful onboarding that integrates the customer&#x27;s company throughout the entire flow.<!-- -->”</p><a target="_blank" rel="noopener noreferrer" class="group/case mt-4 inline-flex items-center gap-1 text-xs font-semibold text-brand-primary hover:underline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-brand-primary" href="/blog/ferndesk-achieved-personalized-onboarding-in-minutes-with-brand-dev"><span>Read the case study</span><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" color="currentColor" class="size-3 transition-transform duration-200 ease-out group-hover/case:translate-x-0.5 motion-reduce:transition-none"><path d="M18.5 12L4.99997 12" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5"></path><path d="M13 18C13 18 19 13.5811 19 12C19 10.4188 13 6 13 6" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5"></path></svg></a></div></div><div data-testimonial-id="18" class="absolute inset-x-0 top-0 rounded-brand-card border"><div class="p-5"><div class="mb-4 flex items-center gap-3"><img alt="Aaron Edwards" loading="lazy" width="44" height="44" decoding="async" data-nimg="1" class="size-11 rounded-full object-cover outline-1 -outline-offset-1 outline-black/5" style="color:transparent" srcSet="/_next/image?url=%2Ftestimonials%2Faaronedwards.webp&amp;w=48&amp;q=75&amp;dpl=dpl_3vJXMp6ngN7XuBrhCA21QfK6vZAU 1x, /_next/image?url=%2Ftestimonials%2Faaronedwards.webp&amp;w=96&amp;q=75&amp;dpl=dpl_3vJXMp6ngN7XuBrhCA21QfK6vZAU 2x" src="/_next/image?url=%2Ftestimonials%2Faaronedwards.webp&amp;w=96&amp;q=75&amp;dpl=dpl_3vJXMp6ngN7XuBrhCA21QfK6vZAU"/><div class="flex flex-col"><p class="text-sm text-gray-900">Aaron Edwards</p><p class="text-xs text-gray-500">Founder @ DocsBot</p></div></div><p class="text-[0.875rem] leading-[1.375rem] text-gray-700">“<!-- -->We&#x27;re seeing much higher activation rates for our free trials and sign-ups because of it. It&#x27;s made it a lot simpler for customers to get started with DocsBot and to get to that &#x27;aha&#x27; value moment very quickly.<!-- -->”</p><a target="_blank" rel="noopener noreferrer" class="group/case mt-4 inline-flex items-center gap-1 text-xs font-semibold text-brand-primary hover:underline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-brand-primary" href="/blog/docsbot-reduces-onboarding-friction-and-boosts-activation-with-brand-dev"><span>Read the case study</span><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" color="currentColor" class="size-3 transition-transform duration-200 ease-out group-hover/case:translate-x-0.5 motion-reduce:transition-none"><path d="M18.5 12L4.99997 12" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5"></path><path d="M13 18C13 18 19 13.5811 19 12C19 10.4188 13 6 13 6" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5"></path></svg></a></div></div><div data-testimonial-id="20" class="absolute inset-x-0 top-0 rounded-brand-card border"><div class="p-5"><div class="mb-4 flex items-center gap-3"><img alt="Ido Shamun" loading="lazy" width="44" height="44" decoding="async" data-nimg="1" class="size-11 rounded-full object-cover outline-1 -outline-offset-1 outline-black/5" style="color:transparent" srcSet="/_next/image?url=%2Ftestimonials%2Fidoshamun.png&amp;w=48&amp;q=75&amp;dpl=dpl_3vJXMp6ngN7XuBrhCA21QfK6vZAU 1x, /_next/image?url=%2Ftestimonials%2Fidoshamun.png&amp;w=96&amp;q=75&amp;dpl=dpl_3vJXMp6ngN7XuBrhCA21QfK6vZAU 2x" src="/_next/image?url=%2Ftestimonials%2Fidoshamun.png&amp;w=96&amp;q=75&amp;dpl=dpl_3vJXMp6ngN7XuBrhCA21QfK6vZAU"/><div class="flex flex-col"><p class="text-sm text-gray-900">Ido Shamun</p><p class="text-xs text-gray-500">Co-founder @ daily.dev</p></div></div><p class="text-[0.875rem] leading-[1.375rem] text-gray-700">“<!-- -->We use Context.dev for our internal enrichment system to verify companies. The integration was straightforward. We set it up once and never had to touch it again. It just works.<!-- -->”</p><a target="_blank" rel="noopener noreferrer" class="group/case mt-4 inline-flex items-center gap-1 text-xs font-semibold text-brand-primary hover:underline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-brand-primary" href="/blog/daily-dev-maintains-accurate-company-data-with-brand-dev"><span>Read the case study</span><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" color="currentColor" class="size-3 transition-transform duration-200 ease-out group-hover/case:translate-x-0.5 motion-reduce:transition-none"><path d="M18.5 12L4.99997 12" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5"></path><path d="M13 18C13 18 19 13.5811 19 12C19 10.4188 13 6 13 6" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5"></path></svg></a></div></div><div data-testimonial-id="39" class="absolute inset-x-0 top-0 rounded-brand-card border"><div class="p-5"><div class="mb-4 flex items-center gap-3"><img alt="Christopher Price" loading="lazy" width="44" height="44" decoding="async" data-nimg="1" class="size-11 rounded-full object-cover outline-1 -outline-offset-1 outline-black/5" style="color:transparent" srcSet="/_next/image?url=%2Ftestimonials%2Fchristopher-price.jpg&amp;w=48&amp;q=75&amp;dpl=dpl_3vJXMp6ngN7XuBrhCA21QfK6vZAU 1x, /_next/image?url=%2Ftestimonials%2Fchristopher-price.jpg&amp;w=96&amp;q=75&amp;dpl=dpl_3vJXMp6ngN7XuBrhCA21QfK6vZAU 2x" src="/_next/image?url=%2Ftestimonials%2Fchristopher-price.jpg&amp;w=96&amp;q=75&amp;dpl=dpl_3vJXMp6ngN7XuBrhCA21QfK6vZAU"/><div class="flex flex-col"><p class="text-sm text-gray-900">Christopher Price</p><p class="text-xs text-gray-500">COO @ Sixtyfour</p></div></div><p class="text-[0.875rem] leading-[1.375rem] text-gray-700">“<!-- -->The API integration was seamless and expedient. My team was able to ge