bic-bezier(0.34,1.8,0.64,1)] motion-safe:group-hover/logo:-translate-y-[19.36px] motion-safe:group-focus-visible/logo:-translate-y-[19.36px] motion-safe:group-data-pushed/logo:-translate-y-[19.36px]\"}],\"$undefined\"]}],[\"$\",\"path\",null,{\"fill\":\"currentColor\",\"d\":\"M287.56,0H745.26A27.06,27.06,0,0,1,772.32,27.06V484.77A27.06,27.06,0,0,1,745.26,511.83H284.51A24.01,24.01,0,0,1,260.5,487.82V27.06A27.06,27.06,0,0,1,287.56,0Z\",\"className\":\"opacity-0 transition-opacity duration-100 motion-safe:group-hover/logo:opacity-100 motion-safe:group-hover/logo:delay-[520ms] motion-safe:group-focus-visible/logo:opacity-100 motion-safe:group-focus-visible/logo:delay-[520ms] motion-safe:group-data-pushed/logo:opacity-100 motion-safe:group-data-pushed/logo:delay-[520ms]\"}]]}],\"$L59\"]}]}],\"$L5a\",\"$L5b\"]}],\"$L5c\"]}],\"$L5d\"]}],\"$L5e\"]}],\"$L5f\"]}]]}]\n"])</script><script>self.__next_f.push([1,"60:T1d25,"])</script><script>self.__next_f.push([1,"{\"@context\":\"https://schema.org\",\"@type\":\"FAQPage\",\"mainEntity\":[{\"@type\":\"Question\",\"name\":\"Is there a free tier?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"Yes. The free tier includes 1,000 API credits per month, enough for 1,000 standard scrapes, plus 10K one-time Logo Link requests, with no credit card required.\"}},{\"@type\":\"Question\",\"name\":\"How do API credits work?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"Scrape starts at 1 credit, or 2 with browser actions. Structured JSON extraction against your schema adds 4 when it succeeds, so 5 credits per page. Highlights and Product add 1, and PDF OCR adds 1 per recovered page. Brand and Styleguide cost 10 credits. Answers costs 10 in Fast mode or 100 in Ultra. Web and news search cost 1 credit per 10 results; People costs 20 per match. Logo Link has a separate quota.\"}},{\"@type\":\"Question\",\"name\":\"Are there extra fees for JS rendering, anti-bot bypass, or premium proxies?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"JS rendering, anti-bot bypass, and proxies are included in the base scrape price. Browser actions raise the base to 2 credits. Successful JSON extraction adds 4 credits. Highlights and Product add 1, and PDF OCR adds 1 per recovered page.\"}},{\"@type\":\"Question\",\"name\":\"Can I crawl an entire website?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"Yes. Crawl discovers and scrapes up to 500 pages into Markdown in one call, with controls for depth, page count, URL patterns, and subdomains. For larger sites, run Batches in crawl mode and collect results through pagination or a completion webhook. Use Map when you only need the URLs.\"}},{\"@type\":\"Question\",\"name\":\"Am I billed for failed requests?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"Most failed requests are not billed. Not-found responses (404) are billed at the request’s base price. Scrape can return a 200 with failed outputs: it charges when at least one output succeeds or the target page is missing. Check key_metadata.credits_consumed for the amount charged.\"}},{\"@type\":\"Question\",\"name\":\"What pricing plans are available, and can I make one-time lookups instead of subscribing?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"Context.dev offers Developer ($19/mo), Pro ($99/mo), Growth ($299/mo), and Scale ($499/mo), plus Enterprise for teams that need more than 2M credits a month, volume discounts, or security and procurement support. We currently do not support one-time lookups, however you can contact us to discuss options for one-time projects at hello@context.dev.\"}},{\"@type\":\"Question\",\"name\":\"Which plan should I choose?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"Start with Free for testing or Developer for your first workflow. Pro suits steady production usage; Growth adds capacity between Pro and Scale. Scale supports high-volume traffic and self-serve SSO / SAML. Choose Enterprise for custom volume, limits, procurement, or support. Upgrades apply immediately; downgrades apply at renewal.\"}},{\"@type\":\"Question\",\"name\":\"Do you offer annual billing?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"Yes. Annual billing saves two months compared with monthly billing on every paid plan.\"}},{\"@type\":\"Question\",\"name\":\"Do you offer discounts for startups or nonprofits?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"Eligible startups and nonprofits can apply for 30% off an annual paid plan for 12 months, plus private Slack Connect with our team. Existing customer deals stay unchanged. Apply at https://www.context.dev/startups.\"}},{\"@type\":\"Question\",\"name\":\"What happens when my API credits run out?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"The Free plan includes 1,000 API credits that renew every month. Paid plans can use Auto-Topup in 1K-credit blocks: Developer $2.20, Pro $1.80, Growth $1.40, and Scale $1.00 for new subscriptions. Existing subscriptions keep their rates. With insufficient credits and no available top-up, any plan returns 401 USAGE_EXCEEDED. Logo Link has a separate quota.\"}},{\"@type\":\"Question\",\"name\":\"What are the rate limits, and how can I increase them?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"Core API limits cap concurrent requests per organization: Free allows 2; Developer 10, Pro 100, Growth 250, and Scale 500. New Free accounts also allow 10 requests per minute across their API keys. Paid plans have no per-minute cap by default. Existing accounts keep their current allowances until they change plans; custom overrides can apply to either limit or both. The dashboard shows your effective limits. Batches, Monitors, webhook deliveries, logs, and feedback have separate organization limits. Enterprise can have custom limits; Logo Link has a separate quota.\"}},{\"@type\":\"Question\",\"name\":\"Why am I getting timeout errors?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"Scrape waits up to 90 seconds by default. For slow or heavily protected pages, raise timeoutOpts.milliseconds (up to 300,000), set timeoutOpts.behavior to return-partial to keep the outputs that finished, and give your HTTP client a longer timeout than the request. Use Batches for large URL lists, and Prefetch to warm uncached domains before a Brand request.\"}},{\"@type\":\"Question\",\"name\":\"What SDKs are available?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"We provide official SDKs for TypeScript, Python, Ruby, Go, and PHP.\"}},{\"@type\":\"Question\",\"name\":\"How can my agent sign up?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"AI agents can register and obtain API credentials programmatically using our agent authentication guide (auth.md). You will still need to sign in or verify your email. Share the link with your agent:\"}},{\"@type\":\"Question\",\"name\":\"When should I talk to sales?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"Talk to sales if you need high-volume pricing beyond 2M credits/month, custom rate limits, annual invoicing, or help with a security or procurement review. Review our published compliance status, policies, controls, and subprocessors at https://trust.context.dev/. Reach us at hello@context.dev or through the contact page.\"}},{\"@type\":\"Question\",\"name\":\"What's the difference between API credits and Logo Link?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"They are separate products with separate quotas. API credits meter the documented API endpoints. Logo Link returns a square logo through a direct image URL and does not consume API credits. Core API requests use the plan concurrency limit; Logo Link image delivery follows its separately documented quota and delivery policy.\"}},{\"@type\":\"Question\",\"name\":\"How fresh is the brand data? How often is it updated?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"Brand Retrieve may reuse cached data up to its documented maxAgeMs, which defaults to about 90 days and is clamped to 0 through one year. A value of 0 requests a fresh Brand retrieval. For a specific correction or rebrand, use https://www.context.dev/update and treat returned media URLs as external resources that your application should handle defensively.\"}},{\"@type\":\"Question\",\"name\":\"Do you support subdomains?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"Yes, subdomains are fully supported.\"}},{\"@type\":\"Question\",\"name\":\"What if I need additional data points?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"We are constantly adding new data points to the API and have more data under the hood that we don't surface yet. If you need a specific data point, please contact us at hello@context.dev and we will be happy to surface it.\"}}]}"])</script><script>self.__next_f.push([1,"3a:[\"$\",\"script\",null,{\"type\":\"application/ld+json\",\"dangerouslySetInnerHTML\":{\"__html\":\"$60\"}}]\n3b:[\"$\",\"script\",null,{\"type\":\"application/ld+json\",\"dangerouslySetInnerHTML\":{\"__html\":\"{\\\"@context\\\":\\\"https://schema.org\\\",\\\"@type\\\":\\\"BreadcrumbList\\\",\\\"itemListElement\\\":[{\\\"@type\\\":\\\"ListItem\\\",\\\"position\\\":1,\\\"name\\\":\\\"Home\\\",\\\"item\\\":\\\"https://www.context.dev\\\"},{\\\"@type\\\":\\\"ListItem\\\",\\\"position\\\":2,\\\"name\\\":\\\"Pricing\\\",\\\"item\\\":\\\"https://www.context.dev/pricing\\\"}]}\"}}]\n65:T17b7,"])</script><script>self.__next_f.push([1,"(function(a){let b=[.32,.5,.68],c=[[[-.04,.04],[.12,.08],[.23,.36]],[[-.04,.42],[.08,.54],[.22,.62]],[[.04,1.05],[.08,.82],[.22,.78]],[[.9,-.05],[.9,.16],[.78,.3]],[[1.04,.3],[.9,.3],[.77,.46]],[[1.04,.62],[.92,.7],[.78,.7]],[[.97,1.05],[.94,.9],[.8,.82]]],d=[[[-.06,.74],[.28,.84],[.46,1.05]],[[1.06,.82],[.72,.88],[.58,1.05]]];function e(a,b){let c=Math.imul(a,0x165667b1)+Math.imul(b,0x27d4eb2f)+Math.imul(7,0x7fffffff);return(((c=Math.imul(c^c\u003e\u003e\u003e13,0x4bf19f61))^c\u003e\u003e\u003e16)\u003e\u003e\u003e0)/0x100000000}functio