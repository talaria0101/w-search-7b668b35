with Context.dev\",\"summary\":\"SiteGPT, the AI chatbot platform for customer support, switched from Firecrawl to Context.dev to scrape entire websites and turn them into the knowledge base behind its customers' bots. The migration took under a day.\",\"href\":\"/blog/sitegpt-scrapes-websites-to-power-ai-support-chatbots-with-context-dev\",\"logoUrl\":\"/customer-logos/sitegpt.png\",\"logoBackground\":\"$undefined\",\"cardBackground\":\"#1a55d5\"}]}],\"$L37\"]}]]}]\n"])</script><script>self.__next_f.push([1,"9:[\"$\",\"$1\",\"c\",{\"children\":[null,[\"$\",\"$L24\",null,{\"parallelRouterKey\":\"children\",\"error\":\"$undefined\",\"errorStyles\":\"$undefined\",\"errorScripts\":\"$undefined\",\"template\":[\"$\",\"$L28\",null,{}],\"templateStyles\":\"$undefined\",\"templateScripts\":\"$undefined\",\"notFound\":\"$undefined\",\"forbidden\":\"$undefined\",\"unauthorized\":\"$undefined\"}]]}]\n38:T73f,"])</script><script>self.__next_f.push([1,"{\"@context\":\"https://schema.org\",\"@type\":\"Product\",\"name\":\"Context.dev API\",\"description\":\"Web scraping API for AI agents and LLMs: scrape any URL into LLM-ready Markdown, crawl entire sites, and extract structured data. Plans are priced per month with a 1,000-credit free tier and no charge for failed requests.\",\"url\":\"https://www.context.dev/pricing\",\"brand\":{\"@type\":\"Organization\",\"@id\":\"https://www.context.dev/#organization\",\"name\":\"Context.dev\"},\"offers\":[{\"@type\":\"Offer\",\"name\":\"Free Tier plan\",\"description\":\"For exploring the APIs and testing your first ideas. Scrape 1,000 pages per month (1,000 credits).\",\"price\":\"0\",\"priceCurrency\":\"USD\",\"url\":\"https://www.context.dev/pricing\",\"availability\":\"https://schema.org/InStock\"},{\"@type\":\"Offer\",\"name\":\"Developer plan\",\"description\":\"For side projects, MVPs, and lightweight apps. Scrape 7,500 pages per month (7,500 credits).\",\"price\":\"19\",\"priceCurrency\":\"USD\",\"url\":\"https://www.context.dev/pricing\",\"availability\":\"https://schema.org/InStock\"},{\"@type\":\"Offer\",\"name\":\"Pro plan\",\"description\":\"For production apps and AI agents powered by web data. Scrape 125,000 pages per month (125,000 credits).\",\"price\":\"99\",\"priceCurrency\":\"USD\",\"url\":\"https://www.context.dev/pricing\",\"availability\":\"https://schema.org/InStock\"},{\"@type\":\"Offer\",\"name\":\"Growth plan\",\"description\":\"For growing products that need more data, more often. Scrape 500,000 pages per month (500,000 credits).\",\"price\":\"299\",\"priceCurrency\":\"USD\",\"url\":\"https://www.context.dev/pricing\",\"availability\":\"https://schema.org/InStock\"},{\"@type\":\"Offer\",\"name\":\"Scale plan\",\"description\":\"For large datasets, bulk scraping, and continuous monitoring. Scrape 1,000,000 pages per month (1,000,000 credits).\",\"price\":\"499\",\"priceCurrency\":\"USD\",\"url\":\"https://www.context.dev/pricing\",\"availability\":\"https://schema.org/InStock\"}]}"])</script><script>self.__next_f.push([1,"39:T53f,{\"@context\":\"https://schema.org\",\"@type\":\"Organization\",\"@id\":\"https://www.context.dev/#organization\",\"name\":\"Context.dev\",\"alternateName\":[\"Brand.dev\"],\"legalName\":\"Context Dev Inc.\",\"url\":\"https://www.context.dev\",\"logo\":{\"@type\":\"ImageObject\",\"url\":\"https://www.context.dev/android-chrome-512x512.png\",\"width\":512,\"height\":512},\"description\":\"Context.dev is a web scraping API for AI agents: scrape any URL to LLM-ready Markdown, HTML, screenshots, or JSON that matches your schema, crawl and map entire sites, run batches of up to 100,000 URLs, and monitor pages for changes.\",\"foundingDate\":\"2025\",\"founder\":{\"@type\":\"Person\",\"@id\":\"https://www.context.dev/#yahia-bakour\",\"name\":\"Yahia Bakour\",\"url\":\"https://www.context.dev/authors/yahia-bakour\"},\"email\":\"hello@context.dev\",\"sameAs\":[\"https://x.com/getcontextdev\",\"https://www.linkedin.com/company/contextdev\",\"https://github.com/context-dot-dev\",\"https://www.ycombinator.com/companies/contextdev\",\"https://www.producthunt.com/products/context-dev\",\"https://www.npmjs.com/package/context.dev\"],\"contactPoint\":{\"@type\":\"ContactPoint\",\"email\":\"support@context.dev\",\"contactType\":\"customer support\"},\"address\":{\"@type\":\"PostalAddress\",\"streetAddress\":\"1007 N Orange St. 4th Floor Suite #1839\",\"addressLocality\":\"Wilmington\",\"addressRegion\":\"DE\",\"postalCode\":\"19801\",\"addressCountry\":\"US\"}}c:[\"$\",\"$1\",\"c\",{\"children\":[[[\"$\",\"script\",null,{\"type\":\"application/ld+json\",\"dangerouslySetInnerHTML\":{\"__html\":\"$38\"}}],[\"$\",\"div\",null,{\"data-home-page\":true,\"children\":[[\"$\",\"script\",null,{\"type\":\"application/ld+json\",\"dangerouslySetInnerHTML\":{\"__html\":\"$39\"}}],\"$L3a\",\"$L3b\",\"$L3c\",\"$L3d\",\"$L3e\",\"$L3f\",\"$L40\"]}]],[\"$L41\",\"$L42\",\"$L43\",\"$L44\",\"$L45\",\"$L46\",\"$L47\"],\"$L48\"]}]\ne:[\"$\",\"$1\",\"h\",{\"children\":[null,[\"$\",\"$L4a\",null,{\"children\":\"$L4b\"}],[\"$\",\"$L4d\",null,{\"children\":[[\"$\",\"div\",null,{\"hidden\":true,\"children\":[\"$\",\"$4e\",null,{\"name\":\"Next.Metadata\",\"children\":\"$L4f\"}]}],null]}],[\"$\",\"meta\",null,{\"name\":\"next-size-adjust\",\"content\":\"\"}]]}]\n1c:[\"$\",\"link\",\"0\",{\"rel\":\"stylesheet\",\"href\":\"/_next/static/immutable/chunks/2-_1x7vmf8a6q.css\",\"precedence\":\"next\",\"crossOrigin\":\"$undefined\",\"nonce\":\"$undefined\"}]\n1d:[\"$\",\"link\",\"1\",{\"rel\":\"stylesheet\",\"href\":\"/_next/static/immutable/chunks/0x2hqld09kke1.css\",\"precedence\":\"next\",\"crossOrigin\":\"$undefined\",\"nonce\":\"$undefined\"}]\n"])</script><script>self.__next_f.push([1,"51:\"/_next/static/immutable/chunks/2wbycietdj5-q.js\"\n52:\"/_next/static/immutable/chunks/05nyh12sw8b6r.js\"\n53:\"/_next/static/immutable/chunks/2iltjz9nlrjwn.js\"\n54:\"/_next/static/immutable/chunks/3v3d67mx_is5e.js\"\n55:\"/_next/static/immutable/chunks/2lvf9iphtldi_.