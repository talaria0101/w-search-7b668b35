-2 sm:text-body" tabindex="-1" data-orientation="horizontal" data-radix-collection-item="">API &amp; integration</button><button type="button" role="tab" aria-selected="false" aria-controls="radix-_R_4uav5tsnuhqlb_-content-pricing" data-state="inactive" id="radix-_R_4uav5tsnuhqlb_-trigger-pricing" data-tab-id="pricing" class="inline-flex items-center justify-center whitespace-nowrap ring-offset-background focus-visible:outline-hidden focus-visible:ring-2 focus-visible:ring-ring focus-visible:ring-offset-2 disabled:pointer-events-none disabled:opacity-50 rounded-full border border-transparent font-normal transition-colors duration-200 hover:text-black data-[state=active]:border-brand-primary data-[state=active]:bg-white data-[state=active]:text-brand-primary motion-reduce:transition-none px-2.5 py-1.5 text-xs sm:px-5 sm:py-2 sm:text-body" tabindex="-1" data-orientation="horizontal" data-radix-collection-item="">Pricing &amp; plans</button><button type="button" role="tab" aria-selected="false" aria-controls="radix-_R_4uav5tsnuhqlb_-content-credits" data-state="inactive" id="radix-_R_4uav5tsnuhqlb_-trigger-credits" data-tab-id="credits" class="inline-flex items-center justify-center whitespace-nowrap ring-offset-background focus-visible:outline-hidden focus-visible:ring-2 focus-visible:ring-ring focus-visible:ring-offset-2 disabled:pointer-events-none disabled:opacity-50 rounded-full border border-transparent font-normal transition-colors duration-200 hover:text-black data-[state=active]:border-brand-primary data-[state=active]:bg-white data-[state=active]:text-brand-primary motion-reduce:transition-none px-2.5 py-1.5 text-xs sm:px-5 sm:py-2 sm:text-body" tabindex="-1" data-orientation="horizontal" data-radix-collection-item="">Credits &amp; billing</button></div></div><div class="grid"><div data-state="active" data-orientation="horizontal" role="tabpanel" aria-labelledby="radix-_R_4uav5tsnuhqlb_-trigger-api" id="radix-_R_4uav5tsnuhqlb_-content-api" tabindex="0" class="ring-offset-background focus-visible:outline-hidden focus-visible:ring-2 focus-visible:ring-ring focus-visible:ring-offset-2 mt-0 max-lg:data-[state=inactive]:hidden lg:[grid-area:1/1] lg:data-[state=inactive]:invisible" style="animation-duration:0s"><div class="mx-auto flex max-w-3xl flex-col gap-5 lg:max-w-none"><div class="brand-glass-ring"><details name="faq-api" class="group faq-card relative overflow-hidden pb-4 brand-card-bg rounded-brand-section brand-card-shadow"><summary class="w-full px-5 py-4 -mb-4 flex gap-5 items-center text-left transition cursor-pointer list-none [&amp;::-webkit-details-marker]:hidden"><span class="flex-1 text-[1.0625rem] font-normal leading-snug text-black">Can I crawl an entire website?</span><span class="shrink-0 rounded-full bg-brand-neutral-5 p-2.5"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" color="currentColor" class="size-4 text-black block group-open:hidden" stroke-width="1.5" stroke="currentColor"><path d="M12.001 5.00003V19.002" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5"></path><path d="M19.002 12.002L4.99998 12.002" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5"></path></svg><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" color="currentColor" class="size-4 text-black hidden group-open:block" stroke-width="1.5" stroke="currentColor"><path d="M20 12L4 12" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5"></path></svg></span></summary><div class="flex gap-2.5 pl-5 pr-16 pt-1 pb-1 text-sm text-[rgba(0,0,0,0.6)] leading-relaxed"><span aria-hidden="true" class="shrink-0 h-[1.5rem] w-3 rounded-bl-brand-card border-b border-l border-[rgba(0,0,0,0.3)]"></span><div class="flex-1 pt-3">Yes. Crawl discovers and scrapes up to 500 pages into Markdown in one call, with controls for depth, page count, URL patterns, and subdomains. For larger sites, run Batches in crawl mode and collect results through pagination or a completion webhook. Use Map when you only need the URLs.</div></div></details></div><div class="brand-glass-ring"><details name="faq-api" class="group faq-card relative overflow-hidden pb-4 brand-card-bg rounded-brand-section brand-card-shadow"><summary class="w-full px-5 py-4 -mb-4 flex gap-5 items-center text-left transition cursor-pointer list-none [&amp;::-webkit-details-marker]:hidden"><span class="flex-1 text-[1.0625rem] font-normal leading-snug text-black">What are the rate limits, and how can I increase them?</span><span class="shrink-0 rounded-full bg-brand-neutral-5 p-2.5"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" color="currentColor" class="size-4 text-black block group-open:hidden" stroke-width="1.5" stroke="currentColor"><path d="M12.001 5.00003V19.002" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5"></path><path d="M19.002 12.002L4.99998 12.002" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5"></path></svg><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" color="currentColor" class="size-4 text-black hidden group-open:block" stroke-width="1.5" stroke="currentColor"><path d="M20 12L4 12" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5"></path></svg></span></summary><div class="flex gap-2.5 pl-5 pr-16 pt-1 pb-1 text-sm text-[rgba(0,0,0,0.6)] leading-relaxed"><span aria-hidden="true" class="shrink-0 h-[1.5rem] w-3 rounded-bl-brand-card border-b border-l border-[rgba(0,0,0,0.3)]"></span><div class="flex-1 pt-3">Core API limits cap concurrent requests per organization: Free allows 2; Developer 10, Pro 100, Growth 250, and Scale 500. New Free accounts also allow 10 requests per minute across their API keys. Paid plans have no per-minute cap by default. Existing accounts keep their current allowances until they change plans; custom overrides can apply to either limit or both. The dashboard shows your effective limits. Batches, Monitors, webhook deliveries, logs, and feedback have separate organization limits. Enterprise can have custom limits; Logo Link has a separate quota.</div></div></details></div><div class="brand-glass-ring"><details name="faq-api" class="group faq-card relative overflow-hidden pb-4 brand-card-bg rounded-brand-section brand-card-shadow"><summary class="w-full px-5 py-4 -mb-4 flex gap-5 items-center text-left transition cursor-pointer list-none [&amp;::-webkit-details-marker]:hidden"><span class="flex-1 text-[1.0625rem] font-normal leading-snug text-black">Why am I getting timeout errors?</span><span class="shrink-0 rounded-full bg-brand-neutral-5 p-2.5"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" color="currentColor" class="size-4 text-black block group-open:hidden" stroke-width="1.5" stroke="currentColor"><path d="M12.001 5.00003V19.002" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5"></path><path d="M19.002 12.002L4.99998 12.002" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5"></path></svg><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" color="currentColor" class="size-4 text-black hidden group-open:block" stroke-width="1.5" stroke="currentColor"><path d="M20 12L4 12" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5"></path></svg></span></summary><div class="flex gap-2.5 pl-5 pr-16 pt-1 pb-1 text-sm text-[rgba(0,0,0,0.6)] leading-relaxed"><span aria-hidden="true" class="shrink-0 h-[1.5rem] w-3 rounded-bl-brand-card border-b border-l border-[rgba(0,0,0,0.3)]"></span><div class="flex-1 pt-3">Scrape waits up to 90 seconds by default. For slow or heavily protected pages, raise timeoutOpts.milliseconds (up to 300,000), set timeoutOpts.behavior to return-partial to keep the outputs that finished, and give your HTTP client a longer timeout than the request. Use Batches for large URL lists, and Prefetch to warm uncached domains before a Brand request.</div></div></details></div><div class="brand-glass-ring"><details name="faq-api" class="group faq-card relative overflow-hidden pb-4 brand-card-bg rounded-brand-section brand-card-shadow"><summary class="w-full px-5 py-4 -mb-4 flex gap-5 items-center text-left transition cursor-pointer list-none [&amp;::-webkit-details-marker]:hidden"><span class="flex-1 text-[1.0625rem] font-normal leading-snug text-black">What SDKs are available?</span><span class="shrink-0 rounded-full bg-brand-neutral-5 p-2.5"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" color="currentColor" class="size-4 text-black block group-open:hidden" stroke-width="1.5" stroke="currentColor"><path d="M12.001 5.00003V19.002" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5"></path><path d="M19.002 12.002L4.99998 12.002" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5"></path></svg><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" color="currentColor" class="size-4 text-black hidden group-open:block" stroke-width="1.5" stroke="currentColor"><path d="M20 12L4 12" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5"></path></svg></span></summary><div class="flex gap-2.5 pl-5 pr-16 pt-1 pb-1 text-sm text-[rgba(0,0,0,0.6)] leading-relaxed"><span aria-hidden="true" class="shrink-0 h-[1.5rem] w-3 rounded-bl-brand-card border-b border-l border-[rgba(0,0,0,0.3)]"></span><div class="flex-1 pt-3">We provide official SDKs for TypeScript, Python, Ruby, Go, and PHP.</div></div></details></div><div class="brand-glass-ring"><details name="faq-api" class="group faq-card relative overflow-hidden pb-4 brand-card-bg rounded-brand-section brand-card-shadow"><summary class="w-full px-5 py-4 -mb-4 flex gap-5 items-center text-left transition cursor-pointer list-none [&amp;::-webkit-details-marker]:hidden"><span class="flex-1 text-[1.0625rem] font-normal leading-snug text-black">How can my agent sign up?</span><span class="shrink-0 rounded-full bg-brand-neutral-5 p-2.5"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" color="currentColor" class="size-4 text-black block group-open:hidden" stroke-width="1.5" stroke="currentColor"><path d="M12.001 5.00003V19.002" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5"></path><path d="M19.002 12.002L4.99998 12.002" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5"></path></svg><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" color="currentColor" class="size-4 text-black hidden group-open:block" stroke-width="1.5" stroke="currentColor"><path d="M20 12L4 12" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5"></path></svg></span></summary><div class="flex gap-2.5 pl-5 pr-16 pt-1 pb-1 text-sm text-[rgba(0,0,0,0.6)] leading-relaxed"><span aria-hidden="true" class="shrink-0 h-[1.5rem] w-3 rounded-bl-brand-card border-b border-l border-[rgba(0,0,0,0.3)]"></span><div class="flex-1 pt-3">AI agents can register and obtain API credentials programmatically using our agent authentication guide (auth.md). You will still need to sign in or verify your email. Share the link with your agent:<div class="mt-3 flex items-center gap-2 rounded-brand-card border border-black/10 bg-black/[0.03] px-3 py-2"><a href="https://www.context.dev/auth.md" target="_blank" rel="noopener noreferrer" class="min-w-0 flex-1 truncate font-mono text-xs text-brand-primary underline hover:text-brand-primary/80">https://www.context.dev/auth.md</a><button type="button" class="inline-flex shrink-0 items-center gap-1.5 rounded-brand-card px-2 py-1 text-xs font-normal text-black/60 transition-colors hover:bg-black/[0.04] hover:text-black/80" aria-label="Copy link"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" color="currentColor" class="size-3.5"><path d="M7 11V9C7 5.70017 7 4.05025 8.02513 3.02513C9.05025 2 10.7002 2 14 2C17.2998 2 18.9497 2 19.9749 3.02513C21 4.05025 21 5.70017 21 9V11C21 14.2998 21 15.9497 19.9749 16.9749C18.9497 18 17.2998 18 14 18C10.7002 18 9.05025 18 8.02513 16.9749C7 15.9497 7 14.2998 7 11Z" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5"></path><path d="M3 6V15C3 18.2998 3 19.9497 4.02513 20.9749C5.05025 22 6.70017 22 10 22H17" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5"></path></svg>Copy</button></div></div></div></details></div><div class="brand-glass-ring"><details name="faq-api" class="group faq-card relative overflow-hidden pb-4 brand-card-bg rounded-brand-section brand-card-shadow"><summary class="w-full px-5 py-4 -mb-4 flex gap-5 items-center text-left transition cursor-pointer list-none [&amp;::-webkit-details-marker]:hidden"><span class="flex-1 text-[1.0625rem] font-normal leading-snug text-black">How fresh is the brand data? How often is it updated?</span><span class="shrink-0 rounded-full bg-brand-neutral-5 p-2.5"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" color="currentColor" class="size-4 text-black block group-open:hidden" stroke-width="1.5" stroke="currentColor"><path d="M12.001 5.00003V19.002" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5"></path><path d="M19.002 12.002L4.99998 12.002" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5"></path></svg><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" color="currentColor" class="size-4 text-black hidden group-open:block" stroke-width="1.5" stroke="currentColor"><path d="M20 12L4 12" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5"></path></svg></span></summary><div class="flex gap-2.5 pl-5 pr-16 pt-1 pb-1 text-sm text-[rgba(0,0,0,0.6)] leading-relaxed"><span aria-hidden="true" class="shrink-0 h-[1.5rem] w-3 rounded-bl-brand-card border-b border-l border-[rgba(0,0,0,0.3)]"></span><div class="flex-1 pt-3">Brand Retrieve may reuse cached data up to its documented maxAgeMs, which defaults to about 90 days and is clamped to 0 through one year. A value of 0 requests a fresh Brand retrieval. For a specific correction or rebrand, use <a href="https://www.context.dev/update" target="_blank" rel="noopener noreferrer" class="text-brand-primary underline hover:text-brand-primary/80 transition-colors">https://www.context.dev/update</a> and treat returned media URLs as external resources that your application should handle defensively.</div></div></details></div><div class="brand-glass-ring"><details name="faq-api" class="group faq-card relative overflow-hidden pb-4 brand-card-bg rounded-brand-section brand-card-shadow"><summary class="w-full px-5 py-4 -mb-4 flex gap-5 items-center text-left transition cursor-pointer list-none [&amp;::-webkit-details-marker]:hidden"><span class="flex-1 text-[1.0625rem] font-normal leading-snug text-black">Do you support subdomains?</span><span class="shrink-0 rounded-full bg-brand-neutral-5 p-2.5"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" color="currentColor" class="size-4 text-black block group-open:hidden" stroke-width="1.5" stroke="currentColor"><path d="M12.001 5.00003V19.002" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5"></path><path d="M19.002 12.002L4.99998 12.002" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5"></path></svg><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" color="currentColor" class="size-4 text-black hidden group-open:block" stroke-width="1.5" stroke="currentColor"><path d="M20 12L4 12" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5"></path></svg></span></summary><div class="flex gap-2.5 pl-5 pr-16 pt-1 pb-1 text-sm text-[rgba(0,0,0,0.6)] leading-relaxed"><span aria-hidden="true" class="shrink-0 h-[1.5rem] w-3 rounded-bl-brand-card border-b border-l border-[rgba(0,0,0,0.3)]"></span><div class="flex-1 pt-3">Yes, subdomains are fully supported.</div></div></details></div><div class="brand-glass-ring"><details name="faq-api" class="group faq-card relative overflow-hidden pb-4 brand-card-bg rounded-brand-section brand-card-shadow"><summary class="w-full px-5 py-4 -mb-4 flex gap-5 items-center text-left transition cursor-pointer list-none [&amp;::-webkit-details-marker]:hidden"><span class="flex-1 text-[1.0625rem] font-normal leading-snug text-black">What if I need additional data points?</span><span class="shrink-0 rounded-full bg-brand-neutral-5 p-2.5"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" color="currentColor" class="size-4 text-black block group-open:hidden" stroke-width="1.5" stroke="currentColor"><path d="M12.001 5.00003V19.002" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5"></path><path d="M19.002 12.002L4.99998 12.002" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5"></path></svg><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" color="currentColor" class="size-4 text-black hidden group-open:block" stroke-width="1.5" stroke="currentColor"><path d="M20 12L4 12" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5"></path></svg></span></summary><div class="flex gap-2.5 pl-5 pr-16 pt-1 pb-1 text-sm text-[rgba(0,0,0,0.6)] leading-relaxed"><span aria-hidden="true" class="shrink-0 h-[1.5rem] w-3 rounded-bl-brand-card border-b border-l border-[rgba(0,0,0,0.3)]"></span><div class="flex-1 pt-3">We are constantly adding new data points to the API and have more data under the hood that we don&#x27;t surface yet. If you need a specific data point, please contact us at <a href="mailto:hello@context.dev" target="_blank" rel="noopener noreferrer" class="text-brand-primary underline hover:text-brand-primary/80 transition-colors">hello@context.dev</a> and we will be happy to surface it.</div></div></details></div><div class="brand-glass-ring"><div class="relative isolate overflow-hidden brand-card-bg rounded-brand-section brand-card-shadow"><form class="flex items-center gap-5 px-5 py-4"><label for="_R_2dcuav5tsnuhqlb_" class="sr-only">Ask anything</label><input id="_R_2dcuav5tsnuhqlb_" type="text" maxLength="500" placeholder="Ask anything" autoComplete="off" class="min-w-0 flex-1 bg-transparent text-[length:max(1.0625rem,16px)] font-normal leading-snug text-black placeholder:text-black/40 focus:outline-none" value=""/><button type="submit" disabled="" aria-label="Ask" class="shrink-0 rounded-brand-button bg-brand-primary p-2.5 text-white transition hover:bg-brand-primary/90 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-brand-primary/40 focus-visible:ring-offset-2 disabled:cursor-not-allowed disabled:opacity-40"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" color="currentColor" class="size-4 block" stroke-width="1.5" stroke="currentColor"><path d="M12 5.5V19" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5"></path><path d="M18 11C18 11 13.5811 5.00001 12 5C10.4188 4.99999 6 11 6 11" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5"></path></svg></button></form></div></div></div></div><div data-state="inactive" data-orientation="horizontal" role="tabpanel" aria-labelledby="radix-_R_4uav5tsnuhqlb_-trigger-pricing" id="radix-_R_4uav5tsnuhqlb_-content-pricing" tabindex="0" class="ring-offset-background focus-visible:outline-hidden focus-visible:ring-2 focus-visible:ring-ring focus-visible:ring-offset-2 mt-0 max-lg:data-[state=inactive]:hidden lg:[grid-area:1/1] lg:data-[state=inactive]:invisible"><div class="mx-auto flex max-w-3xl flex-col gap-5 lg:max-w-none"><div class="brand-glass-ring"><details name="faq-pricing" class="group faq-card relative overflow-hidden pb-4 brand-card-bg rounded-brand-section brand-card-shadow"><summary class="w-full px-5 py-4 -mb-4 flex gap-5 items-center text-left transition cursor-pointer list-none [&amp;::-webkit-details-marker]:hidden"><span class="flex-1 text-[1.0625rem] font-normal leading-snug text-black">Is there a free tier?</span><span class="shrink-0 rounded-full bg-brand-neutral-5 p-2.5"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" color="currentColor" class="size-4 text-black block group-open:hidden" stroke-width="1.5" stroke="currentColor"><path d="M12.001 5.00003V19.002" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5"></path><path d="M19.002 12.002L4.99998 12.002" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5"></path></svg><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" color="currentColor" class="size-4 text-black hidden group-open:block" stroke-width="1.5" stroke="currentColor"><path d="M20 12L4 12" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5"></path></svg></span></summary><div class="flex gap-2.5 pl-5 pr-16 pt-1 pb-1 text-sm text-[rgba(0,0,0,0.6)] leading-relaxed"><span aria-hidden="true" class="shrink-0 h-[1.5rem] w-3 rounded-bl-brand-card border-b border-l border-[rgba(0,0,0,0.3)]"></span><div class="flex-1 pt-3">Yes. The free tier includes 1,000 API credits per month, enough for 1,000 standard scrapes, plus 10K one-time Logo Link requests, with no credit card required.</div></div></details></div><div class="brand-glass-ring"><details name="faq-pricing" class="group faq-card relative overflow-hidden pb-4 brand-card-bg rounded-brand-section brand-card-shadow"><summary class="w-full px-5 py-4 -mb-4 flex gap-5 items-center text-left transition cursor-pointer list-none [&amp;::-webkit-details-marker]:hidden"><span class="flex-1 text-[1.0625rem] font-normal leading-snug text-black">What pricing plans are available, and can I make one-time lookups instead of subscribing?</span><span class="shrink-0 rounded-full bg-brand-neutral-5 p-2.5"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" color="currentColor" class="size-4 text-black block group-open:hidden" stroke-width="1.5" stroke="currentColor"><path d="M12.001 5.00003V19.002" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5"></path><path d="M19.002 12.002L4.99998 12.002" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5"></path></svg><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" color="currentColor" class="size-4 text-black hidden group-open:block" stroke-width="1.5" stroke="currentColor"><path d="M20 12L4 12" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5"></path></svg></span></summary><div class="flex gap-2.5 pl-5 pr-16 pt-1 pb-1 text-sm text-[rgba(0,0,0,0.6)] leading-relaxed"><span aria-hidden="true" class="shrink-0 h-[1.5rem] w-3 rounded-bl-brand-card border-b border-l border-[rgba(0,0,0,0.3)]"></span><div class="flex-1 pt-3">Context.dev offers Developer ($19/mo), Pro ($99/mo), Growth ($299/mo), and Scale ($499/mo), plus Enterprise for teams that need more than 2M credits a month, volume discounts, or security and procurement support. We currently do not support one-time lookups, however you can contact us to discuss options for one-time projects at <a href="mailto:hello@context.dev" target="_blank" rel="noopener noreferrer" class="text-brand-primary underline hover:text-brand-primary/80 transition-colors">hello@context.dev</a>.</div></div></details></div><div class="brand-glass-ring"><details name="faq-pricing" class="group faq-card relative overflow-hidden pb-4 brand-card-bg rounded-brand-section brand-card-shadow"><summary class="w-full px-5 py-4 -mb-4 flex gap-5 items-center text-left transition cursor-pointer list-none [&amp;::-webkit-details-marker]:hidden"><span class="flex-1 text-[1.0625rem] font-normal leading-snug text-black">Which plan should I choose?</span><span class="shrink-0 rounded-full bg-brand-neutral-5 p-2.5"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" color="currentColor" class="size-4 text-black block group-open:hidden" stroke-width="1.5" stroke="currentColor"><path d="M12.001 5.00003V19.002" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5"></path><path d="M19.002 12.002L4.99998 12.002" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5"></path></svg><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" color="currentColor" class="size-4 text-black hidden group-open:block" stroke-width="1.5" stroke="currentColor"><path d="M20 12L4 12" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5"></path></svg></span></summary><div class="flex gap-2.5 pl-5 pr-16 pt-1 pb-1 text-sm text-[rgba(0,0,0,0.6)] leading-relaxed"><span aria-hidden="true" class="shrink-0 h-[1.5rem] w-3 rounded-bl-brand-card border-b border-l border-[rgba(0,0,0,0.3)]"></span><div class="flex-1 pt-3">Start with Free for testing or Developer for your first workflow. Pro suits steady production usage; Growth adds capacity between Pro and Scale. Scale supports high-volume traffic and self-serve SSO / SAML. Choose Enterprise for custom volume, limits, procurement, or support. Upgrades apply immediately; downgrades apply at renewal.</div></div></details></div><div class="brand-glass-ring"><details name="faq-pricing" class="group faq-card relative overflow-hidden pb-4 brand-card-bg rounded-brand-section brand-card-shadow"><summary class="w-full px-5 py-4 -mb-4 flex gap-5 items-center text-left transition cursor-pointer list-none [&amp;::-webkit-details-marker]:hidden"><span class="flex-1 text-[1.0625rem] font-normal leading-snug text-black">Do you offer annual billing?</span><span class="shrink-0 rounded-full bg-brand-neutral-5 p-2.5"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" color="currentColor" class="size-4 text-black block group-open:hidden" stroke-width="1.5" stroke="currentColor"><path d="M12.001 5.00003V19.002" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5"></path><path d="M19.002 12.002L4.99998 12.002" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5"></path></svg><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" color="currentColor" class="size-4 text-black hidden group-open:block" stroke-width="1.5" stroke="currentColor"><path d="M20 12L4 12" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5"></path></svg></span></summary><div class="flex gap-2.5 pl-5 pr-16 pt-1 pb-1 text-sm text-[rgba(0,0,0,0.6)] leading-relaxed"><span aria-hidden="true" class="shrink-0 h-[1.5rem] w-3 rounded-bl-brand-card border-b border-l border-[rgba(0,0,0,0.3)]"></span><div class="flex-1 pt-3">Yes. Annual billing saves two months compared with monthly billing on every paid plan.</div></div></details></div><div class="brand-glass-ring"><details name="faq-pricing" class="group faq-card relative overflow-hidden pb-4 brand-card-bg rounded-brand-section brand-card-shadow"><summary class="w-full px-5 py-4 -mb-4 flex gap-5 items-center text-left transition cursor-pointer list-none [&amp;::-webkit-details-marker]:hidden"><span class="flex-1 text-[1.0625rem] font-normal leading-snug text-black">Do you offer discounts for startups or nonprofits?</span><span class="shrink-0 rounded-full bg-brand-neutral-5 p-2.5"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" color="currentColor" class="size-4 text-black block group-open:hidden" stroke-width="1.5" stroke="currentColor"><path d="M12.001 5.00003V19.002" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5"></path><path d="M19.002 12.002L4.99998 12.002" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5"></path></svg><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" color="currentColor" class="size-4 text-black hidden group-open:block" stroke-width="1.5" stroke="currentColor"><path d="M20 12L4 12" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5"></path></svg></span></summary><div class="flex gap-2.5 pl-5 pr-16 pt-1 pb-1 text-sm text-[rgba(0,0,0,0.6)] leading-relaxed"><span aria-hidden="true" class="shrink-0 h-[1.5rem] w-3 rounded-bl-brand-card border-b border-l border-[rgba(0,0,0,0.3)]"></span><div class="flex-1 pt-3">Eligible startups and nonprofits can apply for 30% off an annual paid plan for 12 months, plus private Slack Connect with our team. Existing customer deals stay unchanged. Apply at <a href="https://www.context.dev/startups" target="_blank" rel="noopener noreferrer" class="text-brand-primary underline hover:text-brand-primary/80 transition-colors">https://www.context.dev/startups</a>.</div></div></details></div><div class="brand-glass-ring"><details name="faq-pricing" class="group faq-card relative overflow-hidden pb-4 brand-card-bg rounded-brand-section brand-card-shadow"><summary class="w-full px-5 py-4 -mb-4 flex gap-5 items-center text-left transition cursor-pointer list-none [&amp;::-webkit-details-marker]:hidden"><span class="flex-1 text-[1.0625rem] font-normal leading-snug text-black">When should I talk to sales?</span><span class="shrink-0 rounded-full bg-brand-neutral-5 p-2.5"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" color="currentColor" class="size-4 text-black block group-open:hidden" stroke-width="1.5" stroke="currentColor"><path d="M12.001 5.00003V19.002" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5"></path><path d="M19.002 12.002L4.99998 12.002" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5"></path></svg><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" color="currentColor" class="size-4 text-black hidden group-open:block" stroke-width="1.5" stroke="currentColor"><path d="M20 12L4 12" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5"></path></svg></span></summary><div class="flex gap-2.5 pl-5 pr-16 pt-1 pb-1 text-sm text-[rgba(0,0,0,0.6)] leading-relaxed"><span aria-hidden="true" class="shrink-0 h-[1.5rem] w-3 rounded-bl-brand-card border-b border-l border-[rgba(0,0,0,0.3)]"></span><div class="flex-1 pt-3">Talk to sales if you need high-volume pricing beyond 2M credits/month, custom rate limits, annual invoicing, or help with a security or procurement review. Review our published compliance status, policies, controls, and subprocessors at <a href="https://trust.context.dev/" target="_blank" rel="noopener noreferrer" class="text-brand-primary underline hover:text-brand-primary/80 transition-colors">https://trust.context.dev/</a>. Reach us at <a href="mailto:hello@context.dev" target="_blank" rel="noopener noreferrer" class="text-brand-primary underline hover:text-brand-primary/80 transition-colors">hello@context.dev</a> or through the contact page.</div></div></details></div><div class="brand-glass-ring"><div class="relative isolate overflow-hidden brand-card-bg rounded-brand-section brand-card-shadow"><form class="flex items-center gap-5 px-5 py-4"><label for="_R_2lcuav5tsnuhqlb_" class="sr-only">Ask anything</label><input id="_R_2lcuav5tsnuhqlb_" type="text" maxLength="500" placeholder="Ask anything" autoComplete="off" class="min-w-0 flex-1 bg-transparent text-[length:max(1.0625rem,16px)] font-normal leading-snug text-black placeholder:text-black/40 focus:outline-none" value=""/><button type="submit" disabled="" aria-label="Ask" class="shrink-0 rounded-brand-button bg-brand-primary p-2.5 text-white transition hover:bg-brand-primary/90 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-brand-primary/40 focus-visible:ring-offset-2 disabled:cursor-not-allowed disabled:opacity-40"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" color="currentColor" class="size-4 block" stroke-width="1.5" stroke="currentColor"><path d="M12 5.5V19" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5"></path><path d="M18 11C18 11 13.5811 5.00001 12 5C10.4188 4.99999 6 11 6 11" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5"></path></svg></button></form></div></div></div></div><div data-state="inactive" data-orientation="horizontal" role="tabpanel" aria-labelledby="radix-_R_4uav5tsnuhqlb_-trigger-credits" id="radix-_R_4uav5tsnuhqlb_-content-credits" tabindex="0" class="ring-offset-background focus-visible:outline-hidden focus-visible:ring-2 focus-visible:ring-ring focus-visible:ring-offset-2 mt-0 max-lg:data-[state=inactive]:hidden lg:[grid-area:1/1] lg:data-[state=inactive]:invisible"><div class="mx-auto flex max-w-3xl flex-col gap-5 lg:max-w-none"><div class="brand-glass-ring"><details name="faq-credits" class="group faq-card relative overflow-hidden pb-4 brand-card-bg rounded-brand-section brand-card-shadow"><summary class="w-full px-5 py-4 -mb-4 flex gap-5 items-center text-left transition cursor-pointer list-none [&amp;::-webkit-details-marker]:hidden"><span class="flex-1 text-[1.0625rem] font-normal leading-snug text-black">How do API credits work?</span><span class="shrink-0 rounded-full bg-brand-neutral-5 p-2.5"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" color="currentColor" class="size-4 text-black block group-open:hidden" stroke-width="1.5" stroke="currentColor"><path d="M12.001 5.00003V19.002" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5"></path><path d="M19.002 12.002L4.99998 12.002" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5"></path></svg><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" color="currentColor" class="size-4 text-black hidden group-open:block" stroke-width="1.5" stroke="currentColor"><path d="M20 12L4 12" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5"></path></svg></span></summary><div class="flex gap-2.5 pl-5 pr-16 pt-1 pb-1 text-sm text-[rgba(0,0,0,0.6)] leading-relaxed"><span aria-hidden="true" class="shrink-0 h-[1.5rem] w-3 rounded-bl-brand-card border-b border-l border-[rgba(0,0,0,0.3)]"></span><div class="flex-1 pt-3">Scrape starts at 1 credit, or 2 with browser actions. Structured JSON extraction against your schema adds 4 when it succeeds, so 5 credits per page. Highlights and Product add 1, and PDF OCR adds 1 per recovered page. Brand and Styleguide cost 10 credits. Answers costs 10 in Fast mode or 100 in Ultra. Web and news search cost 1 credit per 10 results; People costs 20 per match. Logo Link has a separate quota.</div></div></details></div><div class="brand-glass-ring"><details name="faq-credits" class="group faq-card relative overflow-hidden pb-4 brand-card-bg rounded-brand-section brand-card-shadow"><summary class="w-full px-5 py-4 -mb-4 flex gap-5 items-center text-left transition cursor-pointer list-none [&amp;::-webkit-details-marker]:hidden"><span class="flex-1 text-[1.0625rem] font-normal leading-snug text-black">Are there extra fees for JS rendering, anti-bot bypass, or premium proxies?</span><span class="shrink-0 rounded-full bg-brand-neutral-5 p-2.5"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" color="currentColor" class="size-4 text-black block group-open:hidden" stroke-width="1.5" stroke="currentColor"><path d="M12.001 5.00003V19.002" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5"></path><path d="M19.002 12.002L4.99998 12.002" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5"></path></svg><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" color="currentColor" class="size-4 text-black hidden group-open:block" stroke-width="1.5" stroke="currentColor"><path d="M20 12L4 12" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5"></path></svg></span></summary><div class="flex gap-2.5 pl-5 pr-16 pt-1 pb-1 text-sm text-[rgba(0,0,0,0.6)] leading-relaxed"><span aria-hidden="true" class="shrink-0 h-[1.5rem] w-3 rounded-bl-brand-card border-b border-l border-[rgba(0,0,0,0.3)]"></span><div class="flex-1 pt-3">JS rendering, anti-bot bypass, and proxies are included in the base scrape price. Browser actions raise the base to 2 credits. Successful JSON extraction adds 4 credits. Highlights and Product add 1, and PDF OCR adds 1 per recovered page.</div></div></details></div><div class="brand-glass-ring"><details name="faq-credits" class="group faq-card relative overflow-hidden pb-4 brand-card-bg rounded-brand-section brand-card-shadow"><summary class="w-full px-5 py-4 -mb-4 flex gap-5 items-center text-left transition cursor-pointer list-none [&amp;::-webkit-details-marker]:hidden"><span class="flex-1 text-[1.0625rem] font-normal leading-snug text-black">Am I billed for failed requests?</span><span class="shrink-0 rounded-full bg-brand-neutral-5 p-2.5"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" color="currentColor" class="size-4 text-black block group-open:hidden" stroke-width="1.5" stroke="currentColor"><path d="M12.001 5.00003V19.002" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5"></path><path d="M19.002 12.002L4.99998 12.002" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5"></path></svg><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" color="currentColor" class="size-4 text-black hidden group-open:block" stroke-width="1.5" stroke="currentColor"><path d="M20 12L4 12" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5"></path></svg></span></summary><div class="flex gap-2.5 pl-5 pr-16 pt-1 pb-1 text-sm text-[rgba(0,0,0,0.6)] leading-relaxed"><span aria-hidden="true" class="shrink-0 h-[1.5rem] w-3 rounded-bl-brand-card border-b border-l border-[rgba(0,0,0,0.3)]"></span><div class="flex-1 pt-3">Most failed requests are not billed. Not-found responses (404) are billed at the request’s base price. Scrape can return a 200 with failed outputs: it charges when at least one output succeeds or the target page is missing. Check key_metadata.credits_consumed for the amount charged.</div></div></details></div><div class="brand-glass-ring"><details name="faq-credits" class="group faq-card relative overflow-hidden pb-4 brand-card-bg rounded-brand-section brand-card-shadow"><summary class="w-full px-5 py-4 -mb-4 flex gap-5 items-center text-left transition cursor-pointer list-none [&amp;::-webkit-details-marker]:hidden"><span class="flex-1 text-[1.0625rem] font-normal leading-snug text-black">What happens when my API credits run out?</span><span class="shrink-0 rounded-full bg-brand-neutral-5 p-2.5"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" color="currentColor" class="size-4 text-black block group-open:hidden" stroke-width="1.5" stroke="currentColor"><path d="M12.001 5.00003V19.002" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5"></path><path d="M19.002 12.002L4.99998 12.002" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5"></path></svg><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" color="currentColor" class="size-4 text-black hidden group-open:block" stroke-width="1.5" stroke="currentColor"><path d="M20 12L4 12" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5"></path></svg></span></summary><div class="flex gap-2.5 pl-5 pr-16 pt-1 pb-1 text-sm text-[rgba(0,0,0,0.6)] leading-relaxed"><span aria-hidden="true" class="shrink-0 h-[1.5rem] w-3 rounded-bl-brand-card border-b border-l border-[rgba(0,0,0,0.3)]"></span><div class="flex-1 pt-3">The Free plan includes 1,000 API credits that renew every month. Paid plans can use Auto-Topup in 1K-credit blocks: Developer $2.20, Pro $1.80, Growth $1.40, and Scale $1.00 for new subscriptions. Existing subscriptions keep their rates. With insufficient credits and no available top-up, any plan returns 401 USAGE_EXCEEDED. Logo Link has a separate quota.</div></div></details></div><div class="brand-glass-ring"><details name="faq-credits" class="group faq-card relative overflow-hidden pb-4 brand-card-bg rounded-brand-section brand-card-shadow"><summary class="w-full px-5 py-4 -mb-4 flex gap-5 items-center text-left transition cursor-pointer list-none [&amp;::-webkit-details-marker]:hidden"><span class="flex-1 text-[1.0625rem] font-normal leading-snug text-black">What&#x27;s the difference between API credits and Logo Link?</span><span class="shrink-0 rounded-full bg-brand-neutral-5 p-2.5"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" color="currentColor" class="size-4 text-black block group-open:hidden" stroke-width="1.5" stroke="currentColor"><path d="M12.001 5.00003V19.002" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5"></path><path d="M19.002 12.002L4.99998 12.002" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5"></path></svg><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" color="currentColor" class="size-4 text-black hidden group-open:block" stroke-width="1.5" stroke="currentColor"><path d="M20 12L4 12" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5"></path></svg></span></summary><div class="flex gap-2.5 pl-5 pr-16 pt-1 pb-1 text-sm text-[rgba(0,0,0,0.6)] leading-relaxed"><span aria-hidden="true" class="shrink-0 h-[1.5rem] w-3 rounded-bl-brand-card border-b border-l border-[rgba(0,0,0,0.3)]"></span><div class="flex-1 pt-3">They are separate products with separate quotas. API credits meter the documented API endpoints. Logo Link returns a square logo through a direct image URL and does not consume API credits. Core API requests use the plan concurrency limit; Logo Link image delivery follows its separately documented quota and delivery policy.</div></div></details></div><div class="brand-glass-ring"><div class="relative isolate overflow-hidden brand-card-bg rounded-brand-section brand-card-shadow"><form class="flex items-center gap-5 px-5 py-4"><label for="_R_2tcuav5tsnuhqlb_" class="sr-only">Ask anything</label><input id="_R_2tcuav5tsnuhqlb_" type="text" maxLength="500" placeholder="Ask anything" autoComplete="off" class="min-w-0 flex-1 bg-transparent text-[length:max(1.0625rem,16px)] font-normal leading-snug text-black placeholder:text-black/40 focus:outline-none" value=""/><button type="submit" disabled="" aria-label="Ask" class="shrink-0 rounded-brand-button bg-brand-primary p-2.5 text-white transition hover:bg-brand-primary/90 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-brand-primary/40 focus-visible:ring-offset-2 disabled:cursor-not-allowed disabled:opacity-40"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" color="currentColor" class="size-4 block" stroke-width="1.5" stroke="currentColor"><path d="M12 5.5V19" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5"></path><path d="M18 11C18 11 13.5811 5.00001 12 5C10.4188 4.99999 6 11 6 11" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5"></path></svg></button></form></div></div></div></div></div></div></div></div></section><section id="cta" aria-labelledby="closing-cta-title" class="relative bg-white px-6 py-16 sm:px-8 md:px-10 md:py-20 lg:px-12"><div aria-hidden="true" class="pointer-events-none absolute inset-x-0 bottom-0 z-[70] flex justify-center top-0"><div class="relative h-full w-full max-w-[100vw] md:max-w-[90vw] lg:max-w-[85vw] xl:max-w-[var(--marketing-inner-max,68.75rem)]"><div class="absolute inset-y-0 left-0 w-px -translate-x-1/2 bg-gray-200"></div><div class="absolute inset-y-0 right-0 w-px translate-x-1/2 bg-gray-200"></div><div class="absolute top-0 left-1/2 h-px w-screen -translate-x-1/2 -translate-y-1/2 bg-gray-200"></div><span class="absolute size-2 rounded-full bg-gray-300 top-0 left-0 -translate-x-1/2 -translate-y-1/2"></span><span class="absolute size-2 rounded-full bg-gray-300 top-0 right-0 translate-x-1/2 -translate-y-1/2"></span></div></div><div class="brand-glass-ring"><div class="relative grid items-center gap-8 overflow-hidden rounded-brand-section bg-white p-6 ring-1 ring-black/[0.08] sm:p-8 lg:grid-cols-[1fr_21rem] lg:gap-12 lg:p-12"><svg aria-hidden="true" data-dot-field="true" data-dot-field-options="{&quot;words&quot;:[],&quot;fine&quot;:false,&quot;lively&quot;:false,&quot;logoMark&quot;:false,&quot;streams&quot;:false,&quot;miniStreams&quot;:false,&quot;fillFootOnPhones&quot;:false,&quot;solidDots&quot;:true}" class="pointer-events-none absolute inset-0 size-full text-brand-primary"><g data-dot-field-prepaint="true" fill="currentColor" stroke="currentColor" stroke-width="1"></g><g fill="currentColor" stroke="currentColor" stroke-width="1" class="[&amp;&gt;circle]:transition-[fill-opacity,stroke-opacity,opacity] [&amp;&gt;circle]:duration-700 [&amp;&gt;circle]:ease-in-out motion-reduce:[&amp;&gt;circle]:transition-none"></g><g fill="currentColor" stroke="currentColor" stroke-width="1" class="[&amp;&gt;circle]:transition-[fill-opacity,stroke-opacity,opacity] [&amp;&gt;circle]:duration-700 [&amp;&gt;circle]:ease-in-out motion-reduce:[&amp;&gt;circle]:transition-none"></g><g fill="currentColor" font-size="12" font-weight="800" class="font-data"></g></svg><span aria-hidden="true" data-hero-pattern-hole="box" class="absolute size-1 left-0 top-0"></span><span aria-hidden="true" data-hero-pattern-hole="box" class="absolute size-1 right-0 top-0"></span><span aria-hidden="true" data-hero-pattern-hole="box" class="absolute size-1 left-0 bottom-0"></span><span aria-hidden="true" data-hero-pattern-hole="box" class="absolute size-1 right-0 bottom-0"></span><div class="relative flex flex-col items-start gap-5"><h2 id="closing-cta-title" class="max-w-[34rem] text-balance font-brand-heading text-[2rem] font-normal leading-[1.1] tracking-[-0.035em] text-black sm:text-[2.5rem] lg:text-[3rem]"><span data-hero-pattern-hole="text">Start building with live web context.</span></h2><p class="max-w-[28rem] font-brand-body text-base leading-relaxed text-black/60 sm:text-lg"><span data-hero-pattern-hole="t