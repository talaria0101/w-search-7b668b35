tion","operatingSystem":"Any","offers":{"@type":"Offer","price":"0","priceCurrency":"USD","description":"1,000 free credits on signup"},"aggregateRating":{"@type":"AggregateRating","ratingValue":"4.3","ratingCount":69,"bestRating":"5","worstRating":"1"}}</script><script type="application/ld+json">{"@context":"https://schema.org","@type":"FAQPage","mainEntity":[{"@type":"Question","name":"What is a web scraping API?","acceptedAnswer":{"@type":"Answer","text":"A web scraping API is a service that lets you extract data from any website with a single HTTP request, without building or maintaining your own scraping infrastructure. ScrapeBadger handles proxy rotation, JavaScript rendering, anti-bot bypass, and session management automatically."}},{"@type":"Question","name":"Which anti-bot systems does ScrapeBadger bypass?","acceptedAnswer":{"@type":"Answer","text":"ScrapeBadger bypasses Cloudflare, DataDome, Akamai Bot Manager, Imperva (Incapsula), PerimeterX, and Kasada automatically. It also solves reCAPTCHA v2 and v3, hCaptcha, and Cloudflare Turnstile."}},{"@type":"Question","name":"How does ScrapeBadger handle JavaScript-heavy websites?","acceptedAnswer":{"@type":"Answer","text":"ScrapeBadger renders pages in a stealth Chromium browser (Patchright) that passes fingerprinting checks. Set render_js: true in your request to get the fully rendered DOM."}},{"@type":"Question","name":"What output formats does the web scraping API return?","acceptedAnswer":{"@type":"Answer","text":"ScrapeBadger returns HTML, Markdown, plain text, and screenshot (PNG). Set the format parameter to html, markdown, text, or screenshot."}},{"@type":"Question","name":"How is pricing calculated?","acceptedAnswer":{"@type":"Answer","text":"ScrapeBadger uses a credit-based model. Pay As You Go from $10 ($0.15 per 1,000 credits; PAYG credits never expire) or save up to 70% with a monthly/annual subscription (Starter, Growth, Pro, Scale, Volume, Max). 1,000 free credits on signup, no credit card required."}},{"@type":"Question","name":"Is web scraping legal?","acceptedAnswer":{"@type":"Answer","text":"Scraping publicly accessible data is generally considered legal. A 2022 US Ninth Circuit ruling (hiQ v. LinkedIn) affirmed scraping public data does not violate the CFAA. Always check a site's robots.txt and ToS."}},{"@type":"Question","name":"Is there a free trial?","acceptedAnswer":{"@type":"Answer","text":"Yes. Every new account receives 1,000 free credits on signup with no credit card required."}}]}</script><div class="min-h-screen bg-background overflow-x-hidden"><div class="relative z-20 bg-secondary text-foreground border-b border-border"><div class="container mx-auto px-4"><a class="flex items-center justify-center gap-2 py-2 text-xs md:text-sm font-medium hover:opacity-90 transition-opacity invisible" href="/announcements#0120f118-a2ee-4887-bcdd-4468f8a6e15d"><span><strong>Pricing update:</strong> <!-- -->new credit costs in effect since October 15</span><span class="hidden sm:inline px-2 py-0.5 bg-primary text-primary-foreground text-[10px] font-semibold rounded-md">Read more</span><span class="sm:hidden">→</span></a></div></div><header class="relative z-20 border-b border-border bg-background/80 backdrop-blur-sm"><div class="container mx-auto px-4"><nav class="flex items-center justify-between h-14 md:h-16"><a href="/"><div class="flex items-center gap-2.5"><div class="relative flex-shrink-0 group/logo w-12 h-12"><div class="absolute inset-0 border border-border group-hover/logo:border-primary/50 transition-colors duration-300"></div><div class="absolute -top-px -right-px w-2 h-2 overflow-hidden"><div class="absolute top-0 right-0 w-3 h-3 bg-primary transform rotate-45 translate-x-1.5 -translate-y-1.5"></div></div><div class="absolute -bottom-px -left-px w-1.5 h-1.5 bg-primary"></div><div class="absolute inset-0 bg-primary/0 group-hover/logo:bg-primary/5 transition-colors duration-300"></div><div class="absolute -inset-1 bg-primary/0 group-hover/logo:bg-p