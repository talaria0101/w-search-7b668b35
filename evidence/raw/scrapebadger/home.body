4 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-shield h-4 w-4 md:h-5 md:w-5 text-muted-foreground"><path d="M20 13c0 5-3.5 7.5-7.66 8.95a1 1 0 0 1-.67-.01C7.5 20.5 4 18 4 13V6a1 1 0 0 1 1-1c2 0 4.5-1.2 6.24-2.72a1.17 1.17 0 0 1 1.52 0C14.51 3.81 17 5 19 5a1 1 0 0 1 1 1z"></path></svg></div><span class="text-[10px] md:text-xs font-mono text-muted-foreground">10+ types</span></div><h3 class="text-base md:text-lg font-semibold mb-2">Anti-Bot Bypass</h3><p class="text-xs md:text-sm text-muted-foreground">Cloudflare, DataDome, Akamai: detected and handled without configuration.</p></div><div class="group p-4 md:p-6 bg-card border border-border hover:border-muted-foreground/40 transition-all"><div class="flex items-start justify-between mb-3 md:mb-4"><div class="w-9 h-9 md:w-10 md:h-10 bg-secondary flex items-center justify-center"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-database h-4 w-4 md:h-5 md:w-5 text-muted-foreground"><ellipse cx="12" cy="5" rx="9" ry="3"></ellipse><path d="M3 5V19A9 3 0 0 0 21 19V5"></path><path d="M3 12A9 3 0 0 0 21 12"></path></svg></div><span class="text-[10px] md:text-xs font-mono text-muted-foreground">Stateful</span></div><h3 class="text-base md:text-lg font-semibold mb-2">Session Persistence</h3><p class="text-xs md:text-sm text-muted-foreground">Origin-keyed sessions with proxy pinning. Consistent identity per domain.</p></div><div class="group p-4 md:p-6 bg-card border border-border hover:border-muted-foreground/40 transition-all"><div class="flex items-start justify-between mb-3 md:mb-4"><div class="w-9 h-9 md:w-10 md:h-10 bg-secondary flex items-center justify-center"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-file-text h-4 w-4 md:h-5 md:w-5 text-muted-foreground"><path d="M15 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V7Z"></path><path d="M14 2v4a2 2 0 0 0 2 2h4"></path><path d="M10 9H8"></path><path d="M16 13H8"></path><path d="M16 17H8"></path></svg></div><span class="text-[10px] md:text-xs font-mono text-muted-foreground">4 formats</span></div><h3 class="text-base md:text-lg font-semibold mb-2">Multiple Formats</h3><p class="text-xs md:text-sm text-muted-foreground">HTML, Markdown, plain text, and screenshots. Use the format that fits your pipeline.</p></div><div class="group p-4 md:p-6 bg-card border border-border hover:border-muted-foreground/40 transition-all"><div class="flex items-start justify-between mb-3 md:mb-4"><div class="w-9 h-9 md:w-10 md:h-10 bg-secondary flex items-center justify-center"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-activity h-4 w-4 md:h-5 md:w-5 text-muted-foreground"><path d="M22 12h-2.48a2 2 0 0 0-1.93 1.46l-2.35 8.36a.25.25 0 0 1-.48 0L9.24 2.18a.25.25 0 0 0-.48 0l-2.35 8.36A2 2 0 0 1 4.49 12H2"></path></svg></div><span class="text-[10px] md:text-xs font-mono text-muted-foreground">Resilient</span></div><h3 class="text-base md:text-lg font-semibold mb-2">Smart Retry</h3><p class="text-xs md:text-sm text-muted-foreground">Configurable retry on blocking pages with fresh proxies and new fingerprints.</p></div><div class="group p-4 md:p-6 bg-card border border-border hover:border-muted-foreground/40 transition-all"><div class="flex items-start justify-between mb-3 md:mb-4"><div class="w-9 h-9 md:w-10 md:h-10 bg-secondary flex items-center justify-center"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-credit-card h-4 w-4 md:h-5 md:w-5 text-muted-foreground"><rect width="20" height="14" x="2" y="5" rx="2"></rect><line x1="2" x2="22" y1="10" y2="10"></line></svg></div><span class="text-[10px] md:text-xs font-mono text-muted-foreground">Flexible</span></div><h3 class="text-base md:text-lg font-semibold mb-2">Credit-Based Billing</h3><p class="text-xs md:text-sm text-muted-foreground">Pay As You Go from $10 or subscribe monthly/annually. Save up to 70% on larger plans.</p></div></div></div></section><section class="py-12 md:py-20 border-t border-border"><div class="container mx-auto px-4"><div class="text-center mb-8 md:mb-12"><h2 class="text-2xl md:text-3xl lg:text-4xl mb-4 text-foreground font-display font-bold tracking-tight">Built for <span class="text-primary">every industry</span></h2><p class="text-sm md:text-base text-muted-foreground max-w-2xl mx-auto">From startups to enterprises, ScrapeBadger powers data-driven decisions across every sector that depends on public web data.</p></div><div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-3 md:gap-4 stagger-children"><div class="group p-5 md:p-6 bg-card border border-border hover:border-muted-foreground/40 transition-all cursor-default flex flex-col"><div class="w-10 h-10 md:w-12 md:h-12 bg-secondary flex items-center justify-center mb-3 md:mb-4"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-shopping-cart h-5 w-5 md:h-6 md:w-6 text-muted-foreground"><circle cx="8" cy="21" r="1"></circle><circle cx="19" cy="21" r="1"></circle><path d="M2.05 2.05h2l2.66 12.42a2 2 0 0 0 2 1.58h9.78a2 2 0 0 0 1.95-1.57l1.65-7.43H5.12"></path></svg></div><h3 class="text-sm md:text-base font-semibold mb-2">E-Commerce</h3><p class="text-xs text-muted-foreground leading-relaxed mb-3 flex-1">Monitor competitor pricing, track inventory changes, and build dynamic repricing pipelines without getting blocked.</p><div class="flex flex-wrap gap-1.5 mt-auto"><span class="text-xs px-2 py-0.5 border border-border bg-secondary/50 text-muted-foreground">Amazon</span><span class="text-xs px-2 py-0.5 border border-border bg-secondary/50 text-muted-foreground">eBay</span><span class="text-xs px-2 py-0.5 border border-border bg-secondary/50 text-muted-foreground">Shopify</span></div></div><div class="group p-5 md:p-6 bg-card border border-border hover:border-muted-foreground/40 transition-all cursor-default flex flex-col"><div class="w-10 h-10 md:w-12 md:h-12 bg-secondary flex items-center justify-center mb-3 md:mb-4"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-house h-5 w-5 md:h-6 md:w-6 text-muted-foreground"><path d="M15 21v-8a1 1 0 0 0-1-1h-4a1 1 0 0 0-1 1v8"></path><path d="M3 10a2 2 0 0 1 .709-1.528l7-5.999a2 2 0 0 1 2.582 0l7 5.999A2 2 0 0 1 21 10v9a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"></path></svg></div><h3 class="text-sm md:text-base font-semibold mb-2">Real Estate</h3><p class="text-xs text-muted-foreground leading-relaxed mb-3 flex-1">Extract property listings, pricing history, and market data for automated valuation and investment tools.</p><div class="flex flex-wrap gap-1.5 mt-auto"><span class="text-xs px-2 py-0.5 border border-border bg-secondary/50 text-muted-foreground">Zillow</span><span class="text-xs px-2 py-0.5 border border-border bg-secondary/50 text-muted-foreground">Redfin</span><span class="text-xs px-2 py-0.5 border border-border bg-secondary/50 text-muted-foreground">Realtor.com</span></div></div><div class="group p-5 md:p-6 bg-card border border-border hover:border-muted-foreground/40 transition-all cursor-default flex flex-col"><div class="w-10 h-10 md:w-12 md:h-12 bg-secondary flex items-center justify-center mb-3 md:mb-4"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-users h-5 w-5 md:h-6 md:w-6 text-muted-foreground"><path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"></path><circle cx="9" cy="7" r="4"></circle><path d="M22 21v-2a4 4 0 0 0-3-3.87"></path><path d="M16 3.13a4 4 0 0 1 0 7.75"></path></svg></div><h3 class="text-sm md:text-base font-semibold mb-2">Social Media &amp; News</h3><p class="text-xs text-muted-foreground leading-relaxed mb-3 flex-1">Monitor mentions, track trending topics, and run sentiment analysis on public posts at scale.</p><div class="flex flex-wrap gap-1.5 mt-auto"><span class="text-xs px-2 py-0.5 border border-border bg-secondary/50 text-muted-foreground">Twitter/X</span><span class="text-xs px-2 py-0.5 border border-border bg-secondary/50 text-muted-foreground">Reddit</span><span class="text-xs px-2 py-0.5 border border-border bg-secondary/50 text-muted-foreground">News sites</span></div></div><div class="group p-5 md:p-6 bg-card border border-border hover:border-muted-foreground/40 transition-all cursor-default flex flex-col"><div class="w-10 h-10 md:w-12 md:h-12 bg-secondary flex items-center justify-center mb-3 md:mb-4"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-briefcase h-5 w-5 md:h-6 md:w-6 text-muted-foreground"><path d="M16 20V4a2 2 0 0 0-2-2h-4a2 2 0 0 0-2 2v16"></path><rect width="20" height="14" x="2" y="6" rx="2"></rect></svg></div><h3 class="text-sm md:text-base font-semibold mb-2">Job Market &amp; Recruitment</h3><p class="text-xs text-muted-foreground leading-relaxed mb-3 flex-1">Aggregate listings into a unified pipeline, track hiring trends, and power workforce analytics tools.</p><div class="flex flex-wrap gap-1.5 mt-auto"><span class="text-xs px-2 py-0.5 border border-border bg-secondary/50 text-muted-foreground">Indeed</span><span class="text-xs px-2 py-0.5 border border-border bg-secondary/50 text-muted-foreground">LinkedIn</span><span class="text-xs px-2 py-0.5 border border-border bg-secondary/50 text-muted-foreground">Glassdoor</span></div></div><div class="group p-5 md:p-6 bg-card border border-border hover:border-muted-foreground/40 transition-all cursor-default flex flex-col"><div class="w-10 h-10 md:w-12 md:h-12 bg-secondary flex items-center justify-center mb-3 md:mb-4"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-activity h-5 w-5 md:h-6 md:w-6 text-muted-foreground"><path d="M22 12h-2.48a2 2 0 0 0-1.93 1.46l-2.35 8.36a.25.25 0 0 1-.48 0L9.24 2.18a.25.25 0 0 0-.48 0l-2.35 8.36A2 2 0 0 1 4.49 12H2"></path></svg></div><h3 class="text-sm md:text-base font-semibold mb-2">Finance &amp; Market Data</h3><p class="text-xs text-muted-foreground leading-relaxed mb-3 flex-1">Collect prices, filings, and analyst reports to power trading signals and alternative data products.</p><div class="flex flex-wrap gap-1.5 mt-auto"><span class="text-xs px-2 py-0.5 border border-border bg-secondary/50 text-muted-foreground">SEC filings</span><span class="text-xs px-2 py-0.5 border border-border bg-secondary/50 text-muted-foreground">Yahoo Finance</span><span class="text-xs px-2 py-0.5 border border-border bg-secondary/50 text-muted-foreground">Bloomberg</span></div></div><div class="group p-5 md:p-6 bg-card border border-border hover:border-muted-foreground/40 transition-all cursor-default flex flex-col"><div class="w-10 h-10 md:w-12 md:h-12 bg-secondary flex items-center justify-center mb-3 md:mb-4"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="ro