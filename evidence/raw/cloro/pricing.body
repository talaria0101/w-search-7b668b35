-.62z" fill="#FBBC05"/><path d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.07l3.66 2.84c.87-2.6 3.3-4.53 6.16-4.53z" fill="#EA4335"/></svg></div><label for="provider-input-6" class="text-muted-foreground text-sm font-medium">Google Search<span class="text-xs"></span></label></div><label class="text-muted-foreground flex shrink-0 items-center gap-1.5 text-xs" for="provider-aio-6"><input id="provider-aio-6" type="checkbox" class="provider-aio accent-primary h-3.5 w-3.5 cursor-pointer" data-provider-index="6" aria-label="Include AI Overview">AI Overview</label></div><div class="flex gap-2"><input id="provider-input-6" type="text" value="0" placeholder="Enter requests" class="provider-input border-border bg-background text-foreground focus:ring-primary min-w-0 flex-1 rounded-lg border px-3 py-2 text-sm focus:ring-2 focus:outline-none" data-provider-index="6" inputmode="numeric" pattern="[0-9,]*" title="Enter Google Search requests" aria-label="Google Search requests input" aria-describedby="provider-help-6"><input id="provider-pages-6" type="number" min="1" max="10" step="1" value="1" class="provider-pages border-border bg-background text-foreground focus:ring-primary w-12 rounded-lg border px-2 py-2 text-sm focus:ring-2 focus:outline-none" data-provider-index="6" title="Pages per request (1-10)" aria-label="Google Search pages per request"></div><div id="provider-help-6" class="text-muted-foreground text-right text-xs"><span id="provider-credits-6">3 credits / 1 page</span></div></div><div class="space-y-2" data-provider-index="7"><div class="flex items-center justify-between gap-2"><div class="flex items-center gap-2"><div class="flex h-4 w-4 items-center justify-center opacity-80" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" class="h-full w-full"><path d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92c-.26 1.37-1.04 2.53-2.21 3.31v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.09z" fill="#4285F4"/><path d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z" fill="#34A853"/><path d="M5.84 14.09c-.22-.66-.35-1.36-.35-2.09s.13-1.43.35-2.09V7.07H2.18C1.43 8.55 1 10.22 1 12s.43 3.45 1.18 4.93l2.85-2.22.81-.62z" fill="#FBBC05"/><path d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.07l3.66 2.84c.87-2.6 3.3-4.53 6.16-4.53z" fill="#EA4335"/></svg></div><label for="provider-input-7" class="text-muted-foreground text-sm font-medium">Google News<span class="text-xs"></span></label></div></div><div class="flex gap-2"><input id="provider-input-7" type="text" value="0" placeholder="Enter requests" class="provider-input border-border bg-background text-foreground focus:ring-primary min-w-0 flex-1 rounded-lg border px-3 py-2 text-sm focus:ring-2 focus:outline-none" data-provider-index="7" inputmode="numeric" pattern="[0-9,]*" title="Enter Google News requests" aria-label="Google News requests input" aria-describedby="provider-help-7"><input id="provider-pages-7" type="number" min="1" max="10" step="1" value="1" class="provider-pages border-border bg-background text-foreground focus:ring-primary w-12 rounded-lg border px-2 py-2 text-sm focus:ring-2 focus:outline-none" data-provider-index="7" title="Pages per request (1-10)" aria-label="Google News pages per request"></div><div id="provider-help-7" class="text-muted-foreground text-right text-xs"><span id="provider-credits-7">3 credits / 1 page</span></div></div></div></div><div class="border-border border-t pt-4"><div class="mb-6 grid grid-cols-1 gap-4 md:grid-cols-2" role="group" aria-label="Usage summary"><div class="text-center md:text-left"><div class="text-muted-foreground text-sm">Monthly requests</div><div id="total-requests" class="text-foreground text-2xl font-bold" aria-live="polite" aria-label="Total monthly requests">0</div></div><div class="text-center md:text-left"><div class="text-muted-foreground text-sm">Credits needed</div><div id="total-credits" class="text-foreground text-2xl font-bold" aria-live="polite" aria-label="Total credits needed">0</div></div></div><div class="space-y-3" role="region" aria-label="Recommended plan"><div class="text-muted-foreground text-left text-sm font-medium">Recommended plan:</div><div class="border-primary/50 bg-primary/10 flex items-center justify-between rounded-lg border p-4" role="alert" aria-live="polite"><div class="flex-1 text-left"><div id="recommended-plan-name" class="text-foreground text-lg font-medium" aria-label="Recommended plan name"></div><div id="recommended-plan-description" class="text-muted-foreground mt-1 text-sm" aria-label="Plan details and included credits"></div></div><div class="text-right"><div id="recommended-plan-cost" class="text-foreground text-xl font-bold"></div><div id="recommended-plan-estimate" class="text-muted-foreground text-xs"></div></div></div></div></div></div></div><script type="module" src="/_astro/pricing-calculator.astro_astro_type_script_index_0_lang.BJ6Nq2UE.js"></script></div></div></div></div></section><div class="bg-background relative py-32"><div class="relative z-10 mx-auto max-w-7xl px-4 sm:px-6 lg:px-8"><div class="relative mx-auto max-w-4xl lg:max-w-5xl xl:max-w-6xl"><div class="mb-16 text-center"><h2 class="text-foreground mb-4 text-4xl font-bold md:text-5xl md:leading-[1.2]">Frequently <span class="text-foreground font-semibold">Asked</span> Questions</h2></div><script type="application/ld+json">{"@context":"https://schema.org","@type":"FAQPage","@id":"https://cloro.dev/pricing/#faq","isPartOf":{"@id":"https://cloro.dev/pricing/#webpage"},"mainEntity":[{"@type":"Question","name":"How does pricing work?","acceptedAnswer":{"@type":"Answer","text":"Every plan includes a monthly credit allowance, and each API request consumes credits based on the provider you query. One balance covers every provider, so you size one plan, not one per engine. A free tier includes 500 credits refreshed each month, and paid plans start at $30/mo (Lite, 37,500 credits). From Hobby ($100/mo, 250,000 credits) up, the price per 1,000 credits drops as you scale, from $0.40 on Hobby down to $0.31 on the largest self-serve Enterprise tier. See the billing guide for full details."}},{"@type":"Question","name":"How many credits does each request cost?","acceptedAnswer":{"@type":"Answer","text":"Credit costs vary by provider: Google Search and Google News are 3 credits per request (+2 per extra page on Google), Gemini, AI Mode, and Perplexity are 4, ChatGPT (web search), Copilot, and AI Overview (incl. SERP) are 5, and ChatGPT (full response) is 7, because the full response adds query fan-out, ads, and shopping data. These rates apply to async/batch requests; sync requests add a +2 credit surcharge, so monthly spend tracks which engines you query, not just how many requests you send. See the providers guide for the full breakdown."}},{"@type":"Question","name":"When are credits deducted?","acceptedAnswer":{"@type":"Answer","text":"Credits are deducted only when we successfully extract and deliver AI response data. Failed extractions or system errors do not consume your credits."}},{"@type":"Question","name":"Are credits charged when shopping cards or ads come back empty?","acceptedAnswer":{"@type":"Answer","text":"Yes. Credits are deducted whenever a response returns \"success\": true, regardless of whether optional fields like shopping cards, ads, or sources contain data. These fields are opportunity-based — cloro extracts them when the AI surface serves that content, so an empty result is a valid extraction, not a failure. Requests with \"success\": false are not charged."}},{"@type":"Question","name":"Do credits roll over from month to month?","acceptedAnswer":{"@type":"Answer","text":"No, credits do not roll over from month to month. Each billing cycle, you receive your allocated credits based on your subscription plan. Any unused credits expire at the end of the billing period."}},{"@type":"Question","name":"What happens when I run out of credits?","acceptedAnswer":{"@type":"Answer","text":"Once your balance reaches zero, API requests are rejected with a 403 Insufficient Credits error. To continue, you can upgrade to a higher-volume plan (takes effect immediately), wait for your next billing cycle, or move to an annual Enterprise contract — annual plans include overages, so service continues at your contracted rate instead of stopping at the cap. We email you when you hit 80% and 100% of your monthly allocation."}},{"@type":"Question","name":"How can I check my current credit balance?","acceptedAnswer":{"@type":"Answer","text":"Log into the dashboard to see your current credit balance, usage for the current billing cycle, projected spend based on current usage, and historical usage data. The projection tells you mid-cycle whether the plan is sized right. Programmatically, every monitor response includes X-Credits-Remaining and X-Credits-Charged headers, and batch requests report credit usage per task, so a running job can throttle itself."}},{"@type":"Question","name":"Is there a pay-as-you-go option?","acceptedAnswer":{"@type":"Answer","text":"No. cloro uses a credit-based subscription model, so there is no pay-as-you-go or per-request pricing. All plans include a fixed monthly credit allocation, and credits not used by the end of the cycle expire. The trade is predictability: the bill is the same every month, so you budget once."}},{"@type":"Question","name":"How does concurrency work?","acceptedAnswer":{"@type":"Answer","text":"Concurrency limits depend on your subscription plan. For example, business plans often start with higher concurrency limits (e.g., 100). If you exceed your limit, you will receive a 429 status code. We recommend implementing client-side queuing or using our async endpoint."}},{"@type":"Question","name":"Can I increase my concurrency limits?","acceptedAnswer":{"@type":"Answer","text":"You can increase your concurrency by subscribing to a higher-volume package. Since we dedicate resources exclusively to your organization, we want to ensure those resources are fully utilized and not just spiky traffic. However, if you are indeed limited by concurrency (constantly using your concurrency more than 70% of the time), you should contact us so we can adjust."}},{"@type":"Question","name":"Are there rate limits in addition to concurrency limits?","acceptedAnswer":{"@type":"Answer","text":"Yes. All endpoints are rate-limited to 1,000 requests per second, tracked via the X-RateLimit-Limit and X-RateLimit-Remaining response headers. Concurrency limits (how many requests run simultaneously) depend on your plan and apply on top of that; exceeding either returns a 429 error. See the rate & concurrency limits guide for details."}},{"@type":"Question","name":"Can I upgrade or downgrade my plan?","acceptedAnswer":{"@type":"Answer","text":"Yes, from the dashboard at any time. Upgrades take effect immediately — the price is prorated for the remaining days of the cycle and unused credits from your old plan are preserved, not reset. Downgrades take effect at the start of your next billing cycle, with no proration charge. If you cancel, service continues until the end of the current cycle. See the billing guide for details."}},{"@type":"Question","name":"What if I need more volume than the Business plan?","acceptedAnswer":{"@type":"Answer","text":"Self-serve Enterprise tiers run from $2,000 to $5,000/mo (up to roughly 16.4 million credits and 255 concurrent jobs) and can be selected directly in the dashboard, so growing past Business is a plan change, not a sales call. Above $5,000/mo, Enterprise is available through annual contracts. See Enterprise plans for details."}},{"@type":"Question","name":"What's the difference between monthly and annual Enterprise plans?","acceptedAnswer":{"@type":"Answer","text":"Monthly plans (Standard and self-serve Enterprise) have a hard credit cap — service stops when you run out — and you can cancel anytime. Annual Enterprise contracts are 12-month commitments that include overages (service continues past your monthly allocation, billed at your contracted per-credit rate), 20% more credits per month at the same fee, 1.3× concurrency, a price lock for the term, and net 7-day payment by bank transfer or ACH. See Enterprise plans for details."}},{"@type":"Question","name":"Can I try cloro before subscribing?","acceptedAnswer":{"@type":"Answer","text":"Yes. Every account starts on the free tier — 500 credits refreshed each month — so you can evaluate response quality, latency, and coverage across providers before picking a plan."}},{"@type":"Question","name":"What payment methods do you accept?","acceptedAnswer":{"@type":"Answer","text":"We accept all major credit cards for self-service plans. For Enterprise accounts, we work with bank transfers (ACH/Wire)."}},{"@type":"Question","name":"Do I need a VAT registration to sign up?","acceptedAnswer":{"@type":"Answer","text":"No. You can start the free trial or subscribe to any plan without a VAT number — VAT is charged on the invoice where applicable. Once you have a VAT number, add it under Billing → Manage your subscription in the dashboard and it will appear on future invoices."}},{"@type":"Question","name":"Why is cloro more expensive than some alternatives?","acceptedAnswer":{"@type":"Answer","text":"We take our infrastructure very seriously. When building our platform, we decided to go for much better infrastructure than competitors, and that reflects in both our performance and final costs. We built cloro so that your team doesn't spend time finding workarounds and fallbacks to failing and incomplete requests. So the extra cost comes back to you in engineering time. Our customers and 4.7/5 on G2 speak for this quality."}},{"@type":"Question","name":"Do you offer a free or cheaper plan?","acceptedAnswer":{"@type":"Answer","text":"Yes. Every account starts on a free tier with 500 credits refreshed each month — enough to evaluate response quality and coverage across providers. For low, steady volume there's also the Lite plan at $30/mo for 37,500 credits. Larger plans bring the per-credit rate down as you scale."}},{"@type":"Question","name":"What is your refund policy?","acceptedAnswer":{"@type":"Answer","text":"We do not offer refunds. We offer some free credits precisely for the purpose of testing. For self-service plans, you may cancel at any time and your access will continue until the end of your current billing period. For full details, please review our Terms of Service."}}]}</script><div class="space-y-3"><details class="group border-border bg-card/50 rounded-xl border p-5 backdrop-blur-sm"><summary class="text-foreground flex cursor-pointer list-none items-center justify-between gap-4 text-lg font-semibold"><h3>How does pricing work?</h3><span aria-hidden="true" class="text-muted-foreground text-xl leading-none transition-transform group-open:rotate-45 after:content-[&#x27;+&#x27;]"></span></summary><p class="text-muted-foreground mt-4 text-base leading-relaxed">Every plan includes a monthly credit allowance, and each API request consumes credits based on the provider you query. One balance covers every provider, so you size one plan, not one per engine. A free tier includes 500 credits refreshed each month, and paid plans start at $30/mo (Lite, 37,500 credits). From Hobby ($100/mo, 250,000 credits) up, the price per 1,000 credits drops as you scale, from $0.40 on Hobby down to $0.31 on the largest self-serve Enterprise tier. See the <a href="/docs/guides/billing" class="underline hover:no-underline">billing guide</a> for full details.</p></details><details class="group border-border bg-card/50 rounded-xl border p-5 backdrop-blur-sm"><summary class="text-foreground flex cursor-pointer list-none items-center justify-between gap-4 text-lg font-semibold"><h3>How many credits does each request cost?</h3><span aria-hidden="true" class="text-muted-foreground text-xl leading-none transition-transform group-open:rotate-45 after:content-[&#x27;+&#x27;]"></span></summary><p class="text-muted-foreground mt-4 text-base leading-relaxed">Credit costs vary by provider: Google Search and Google News are 3 credits per request (+2 per extra page on Google), Gemini, AI Mode, and Perplexity are 4, ChatGPT (web search), Copilot, and AI Overview (incl. SERP) are 5, and ChatGPT (full response) is 7, because the full response adds query fan-out, ads, and shopping data. These rates apply to async/batch requests; sync requests add a +2 credit surcharge, so monthly spend tracks which engines you query, not just how many requests you send. See the <a href="/docs/guides/providers" class="underline hover:no-underline">providers guide</a> for the full breakdown.</p></details><details class="group border-border bg-card/50 rounded-xl border p-5 backdrop-blur-sm"><summary class="text-foreground flex cursor-pointer list-none items-center justify-between gap-4 text-lg font-semibold"><h3>When are credits deducted?</h3><span aria-hidden="true" class="text-muted-foreground text-xl leading-none transition-transform group-open:rotate-45 after:content-[&#x27;+&#x27;]"></span></summary><p class="text-muted-foreground mt-4 text-base leading-relaxed">Credits are deducted only when we successfully extract and deliver AI response data. Failed extractions or system errors do not consume your credits.</p></details><details class="group border-border bg-card/50 rounded-xl border p-5 backdrop-blur-sm"><summary class="text-foreground flex cursor-pointer list-none items-center justify-between gap-4 text-lg font-semibold"><h3>Are credits charged when shopping cards or ads come back empty?</h3><span aria-hidden="true" class="text-muted-foreground text-xl leading-none transition-transform group-open:rotate-45 after:content-[&#x27;+&#x27;]"></span></summary><p class="text-muted-foreground mt-4 text-base leading-relaxed">Yes. Credits are deducted whenever a response returns "success": true, regardless of whether optional fields like shopping cards, ads, or sources contain data. These fields are opportunity-based — cloro extracts them when the AI surface serves that content, so an empty result is a valid extraction, not a failure. Requests with "success": false are not charged.</p></details><details class="group border-border bg-card/50 rounded-xl border p-5 backdrop-blur-sm"><summary class="text-foreground flex cursor-pointer list-none items-center justify-between gap-4 text-lg font-semibold"><h3>Do credits roll over from month to month?</h3><span aria-hidden="true" class="text-muted-foreground text-xl leading-none transition-transform group-open:rotate-45 after:content-[&#x27;+&#x27;]"></span></summary><p class="text-muted-foreground mt-4 text-base leading-relaxed">No, credits do not roll over from month to month. Each billing cycle, you receive your allocated credits based on your subscription plan. Any unused credits expire at the end of the billing period.</p></details><details class="group border-border bg-card/50 rounded-xl border p-5 backdrop-blur-sm"><summary class="text-foreground flex cursor-pointer list-none items-center justify-between gap-4 text-lg font-semibold"><h3>What happens when I run out of credits?</h3><span aria-hidden="true" class="text-muted-foreground text-xl leading-none transition-transform group-open:rotate-45 after:content-[&#x27;+&#x27;]"></span></summary><p class="text-muted-foreground mt-4 text-base leading-relaxed">Once your balance reaches zero, API requests are rejected with a 403 Insufficient Credits error. To continue, you can upgrade to a higher-volume plan (takes effect immediately), wait for your next billing cycle, or move to an annual Enterprise contract — annual plans include overages, so service continues at your contracted rate instead of stopping at the cap. We email you when you hit 80% and 100% of your monthly allocation.</p></details><details class="group border-border bg-card/50 rounded-xl border p-5 backdrop-blur-sm"><summary class="text-foreground flex cursor-pointer list-none items-center justify-between gap-4 text-lg font-semibold"><h3>How can I check my current credit balance?</h3><span aria-hidden="true" class="text-muted-foreground text-xl leading-none transition-transform group-open:rotate-45 after:content-[&#x27;+&#x27;]"></span></summary><p class="text-muted-foreground mt-4 text-base leading-relaxed">Log into the dashboard to see your current credit balance, usage for the current billing cycle, projected spend based on current usage, and historical usage data. The projection tells you mid-cycle whether the plan is sized right. Programmatically, every monitor response includes X-Credits-Remaining and X-Credits-Charged headers, and batch requests report credit usage per task, so a running job can throttle itself.</p></details><details class="group border-border bg-card/50 rounded-xl border p-5 backdrop-blur-sm"><summary class="text-foreground flex cursor-pointer list-none items-center justify-between gap-4 text-lg font-semibold"><h3>Is there a pay-as-you-go option?</h3><span aria-hidden="true" class="text-muted-foreground text-xl leading-none transition-transform group-open:rotate-45 after:content-[&#x27;+&#x27;]"></span></summary><p class="text-muted-foreground mt-4 text-base leading-relaxed">No. cloro uses a credit-based subscription model, so there is no pay-as-you-go or per-request pricing. All plans include a fixed monthly credit allocation, and credits not used by the end of the cycle expire. The trade is predictability: the bill is the same every month, so you budget once.</p></details><details class="group border-border bg-card/50 rounded-xl border p-5 backdrop-blur-sm"><summary class="text-foreground flex cursor-pointer list-none items-center justify-between gap-4 text-lg font-semibold"><h3>How does concurrency work?</h3><span aria-hidden="true" class="text-muted-foreground text-xl leading-none transition-transform group-open:rotate-45 after:content-[&#x27;+&#x27;]"></span></summary><p class="text-muted-foreground mt-4 text-base leading-relaxed">Concurrency limits depend on your subscription plan. For example, business plans often start with higher concurrency limits (e.g., 100). If you exceed your limit, you will receive a 429 status code. We recommend implementing client-side queuing or using our async endpoint.</p></details><details class="group border-border bg-card/50 rounded-xl border p-5 backdrop-blur-sm"><summary class="text-foreground flex cursor-pointer list-none items-center justify-between gap-4 text-lg font-semibold"><h3>Can I increase my concurrency limits?</h3><span aria-hidden="true" class="text-muted-foreground text-xl leading-none transition-transform group-open:rotate-45 after:content-[&#x27;+&#x27;]"></span></summary><p class="text-muted-foreground mt-4 text-base leading-relaxed">You can increase your concurrency by subscribing to a higher-volume package. Since we dedicate resources exclusively to your organization, we want to ensure those resources are fully utilized and not just spiky traffic. However, if you are indeed limited by concurrency (constantly using your concurrency more than 70% of the time), you should contact us so we can adjust.</p></details><details class="group border-border bg-card/50 rounded-xl border p-5 backdrop-blur-sm"><summary class="text-foreground flex cursor-pointer list-none items-center justify-between gap-4 text-lg font-semibold"><h3>Are there rate limits in addition to concurrency limits?</h3><span aria-hidden="true" class="text-muted-foreground text-xl leading-none transition-transform group-open:rotate-45 after:content-[&#x27;+&#x27;]"></span></summary><p class="text-muted-foreground mt-4 text-base leading-relaxed">Yes. All endpoints are rate-limited to 1,000 requests per second, tracked via the X-RateLimit-Limit and X-RateLimit-Remaining response headers. Concurrency limits (how many requests run simultaneously) depend on your plan and apply on top of that; exceeding either returns a 429 error. See the <a href="/docs/guides/concurrency" class="underline hover:no-underline">rate &amp; concurrency limits guide</a> for details.</p></details><details class="group border-border bg-card/50 rounded-xl border p-5 backdrop-blur-sm"><summary class="text-foreground flex cursor-pointer list-none items-center justify-between gap-4 text-lg font-semibold"><h3>Can I upgrade or downgrade my plan?</h3><span aria-hidden="true" class="text-muted-foreground text-xl leading-none transition-transform group-open:rotate-45 after:content-[&#x27;+&#x27;]"></span></summary><p class="text-muted-foreground mt-4 text-base leading-relaxed">Yes, from the dashboard at any time. Upgrades take effect immediately — the price is prorated for the remaining days of the cycle and unused credits from your old plan are preserved, not reset. Downgrades take effect at the start of your next billing cycle, with no proration charge. If you cancel, service continues until the end of the current cycle. See the <a href="/docs/guides/billing" class="underline hover:no-underline">billing guide</a> for details.</p></details><details class="group border-border bg-card/50 rounded-xl border p-5 backdrop-blur-sm"><summary class="text-foreground flex cursor-pointer list-none items-center justify-between gap-4 text-lg font-semibold"><h3>What if I need more volume than the Business plan?</h3><span aria-hidden="true" class="text-muted-foreground text-xl leading-none transition-transform group-open:rotate-45 after:content-[&#x27;+&#x27;]"></span></summary><p class="text-muted-foreground mt-4 text-base leading-relaxed">Self-serve Enterprise tiers run from $2,000 to $5,000/mo (up to roughly 16.4 million credits and 255 concurrent jobs) and can be selected directly in the dashboard, so growing past Business is a plan change, not a sales call. Above $5,000/mo, Enterprise is available through annual contracts. See <a href="/docs/guides/billing#enterprise-plans" class="underline hover:no-underline">Enterprise plans</a> for details.</p></details><details class="group border-border bg-card/50 rounded-xl border p-5 backdrop-blur-sm"><summary class="text-foreground flex cursor-pointer list-none items-center justify-between gap-4 text-lg font-semibold"><h3>What&#x27;s the difference between monthly and annual Enterprise plans?</h3><span aria-hidden="true" class="text-muted-foreground text-xl leading-none transition-transform group-open:rotate-45 after:content-[&#x27;+&#x27;]"></span></summary><p class="text-muted-foreground mt-4 text-base leading-relaxed">Monthly plans (Standard and self-serve Enterprise) have a hard credit cap — service stops when you run out — and you can cancel anytime. Annual Enterprise contracts are 12-month commitments that include overages (service continues past your monthly allocation, billed at your contracted per-credit rate), 20% more credits per month at the same fee, 1.3× concurrency, a price lock for the term, and net 7-day payment by bank transfer or ACH. See <a href="/docs/guides/billing#enterprise-plans" class="underline hover:no-underline">Enterprise plans</a> for details.</p></details><details class="group border-border bg-card/50 rounded-xl border p-5 backdrop-blur-sm"><summary class="text-foreground flex cursor-pointer list-none items-center justify-between gap-4 text-lg font-semibold"><h3>Can I try cloro before subscribing?</h3><span aria-hidden="true" class="text-muted-foreground text-xl leading-none transition-transform group-open:rotate-45 after:content-[&#x27;+&#x27;]"></span></summary><p class="text-muted-foreground mt-4 text-base leading-relaxed">Yes. Every account starts on the free tier — 500 credits refreshed each month — so you can evaluate response quality, latency, and coverage across providers before picking a plan.</p></details><details class="group border-border bg-card/50 rounded-xl border p-5 backdrop-blur-sm"><summary class="text-foreground flex cursor-pointer list-none items-center justify-between gap-4 text-lg font-semibold"><h3>What payment methods do you accept?</h3><span aria-hidden="true" class="text-muted-foreground text-xl leading-none transition-transform group-open:rotate-45 after:content-[&#x27;+&#x27;]"></span></summary><p class="text-muted-foreground mt-4 text-base leading-relaxed">We accept all major credit cards for self-service plans. For Enterprise accounts, we work with bank transfers (ACH/Wire).</p></details><details class="group border-border bg-card/50 rounded-xl border p-5 backdrop-blur-sm"><summary class="text-foreground flex cursor-pointer list-none items-center justify-between gap-4 text-lg font-semibold"><h3>Do I need a VAT registration to sign up?</h3><span aria-hidden="true" class="text-muted-foreground text-xl leading-none transition-transform group-open:rotate-45 after:content-[&#x27;+&#x27;]"></span></summary><p class="text-muted-foreground mt-4 text-base leading-relaxed">No. You can start the free trial or subscribe to any plan without a VAT number — VAT is charged on the invoice where applicable. Once you have a VAT number, add it under Billing → Manage your subscription in the dashboard and it will appear on future invoices.</p></details><details class="group border-border bg-card/50 rounded-xl border p-5 backdrop-blur-sm"><summary class="text-foreground flex cursor-pointer list-none items-center justify-between gap-4 text-lg font-semibold"><h3>Why is cloro more expensive than some alternatives?</h3><span aria-hidden="true" class="text-muted-foreground text-xl leading-none transition-transform group-open:rotate-45 after:content-[&#x27;+&#x27;]"></span></summary><p class="text-muted-foreground mt-4 text-base leading-relaxed">We take our infrastructure very seriously. When building our platform, we decided to go for much better infrastructure than competitors, and that reflects in both our performance and final costs. We built cloro so that your team doesn't spend time finding workarounds and fallbacks to failing and incomplete requests. So the extra cost comes back to you in engineering time. Our customers and <a href="https://www.g2.com/products/cloro/reviews" class="underline hover:no-underline" target="_blank" rel="noopener">4.7/5 on G2</a> speak for this quality.</p></details><details class="group border-border bg-card/50 rounded-xl border p-5 backdrop-blur-sm"><summary class="text-foreground flex cursor-pointer list-none items-center justify-between gap-4 text-lg font-semibold"><h3>Do you offer a free or cheaper plan?</h3><span aria-hidden="true" class="text-muted-foreground text-xl leading-none transition-transform group-open:rotate-45 after:content-[&#x27;+&#x27;]"></span></summary><p class="text-muted-foreground mt-4 text-base leading-relaxed">Yes. Every account starts on a free tier with 500 credits refreshed each month — enough to evaluate response quality and coverage across providers. For low, steady volume there's also the Lite plan at $30/mo for 37,500 credits. Larger plans bring the per-credit rate down as you scale.</p></details><details class="group border-border bg-card/50 rounded-xl border p-5 backdrop-blur-sm"><summary class="text-foreground flex cursor-pointer list-none items-center justify-between gap-4 text-lg font-semibold"><h3>What is your refund policy?</h3><span aria-hidden="true" class="text-muted-foreground text-xl leading-none transition-transform group-open:rotate-45 after:content-[&#x27;+&#x27;]"></span></summary><p class="text-muted-foreground mt-4 text-base leading-relaxed">We do not offer refunds. We offer some free credits precisely for the purpose of testing. For self-service plans, you may cancel at any time and your access will continue until the end of your current billing period. For full details, please review our Terms of Service.</p></details></div></div></div></div><section class="bg-background relative overflow-hidden py-32"><div class="mx-auto max-w-screen-xl px-5"><div class="relative text-center"><h2 class="text-foreground mb-4 text-4xl font-bold md:text-5xl md:leading-[1.2]">Run <span class="text-foreground font-semibold">SEO</span> and <span class="text-foreground font-semibold">AI SEO</span> scrapes at scale</h2><p class="text-muted-foreground mx-auto mb-10 max-w-3xl leading-relaxed md:text-lg">Track your <span class="text-foreground font-semibold">brand</span> and your <span class="text-foreground font-semibold">competitors</span> across global SERPs, with low latency.</p><div class="flex flex-col items-center justify-center gap-2"><a href="https://dashboard.cloro.dev/sign-up" data-cta-id="footer_cta" target="_blank" rel="nofollow noopener" class="inline-flex items-center justify-center gap-2 whitespace-nowrap font-medium ring-offset-background transition-colors focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring focus-visible:ring-offset-2 disabled:pointer-events-none disabled:opacity-50 [&amp;_svg]:pointer-events-none [&amp;_svg]:size-4 [&amp;_svg]:shrink-0 bg-primary text-primary-foreground hover:bg-primary/90 h-11 rounded-md px-8 py-3">Try 500 credits for free</a></div></div></div></section><footer class="border-border/50 bg-muted relative border-t"><div class="relative"><div class="mx-auto max-w-screen-xl px-5"><div class="py-16"><div class="grid gap-8 sm:grid-cols-2 md:grid-cols-3 lg:grid-cols-7"><div class="sm:col-span-2 lg:col-span-2"><a href="/" class="group inline-flex items-center space-x-2"><img src="/logo.svg" alt="cloro" loading="lazy" decoding="async" width="24" height="24" class="h-6 w-auto invert"></a><p class="text-muted-foreground mt-6 max-w-xs text-sm leading-relaxed">Extract structured data from <span class="text-foreground font-semibold">ChatGPT</span>, <span class="text-foreground font-semibold">Perplexity</span>, <span class="text-foreground font-semibold">Gemini</span>, <span class="text-foreground font-semibold">Google Search</span>, <span class="text-foreground font-semibold">Google News</span>, <span class="text-foreground font-semibold">Copilot</span>, and <span class="text-foreground font-semibold">AI Overview</span> through one API, across all countries and states.</p><div class="mt-4 flex items-center gap-4"><a href="https://x.com/cloroai" target="_blank" rel="noopener" class="text-muted-foreground hover:text-foreground inline-flex items-center space-x-2 text-sm transition-colors duration-200" aria-label="X (Twitter)"><svg class="h-4 w-4" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path d="M18.901 1.153h3.68l-8.04 9.19L24 22.846h-7.406l-5.8-7.584-6.638 7.584H.474l8.6-9.83L0 1.154h7.594l5.243 6.932ZM17.61 20.644h2.039L6.486 3.24H4.298Z"/></svg></a><a href="https://github.com/cloro-dev/" target="_blank" rel="noopener" class="text-muted-foreground hover:text-foreground inline-flex items-center space-x-2 text-sm transition-colors duration-200" aria-label="GitHub Repository"><svg class="h-4 w-4" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path d="M12 0c-6.626 0-12 5.373-12 12 0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23.957-.266 1.983-.399 3.003-.404 1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576 4.765-1.589 8.199-6.086 8.199-11.386 0-6.627-5.373-12-12-12z"/></svg></a><a href="https://www.linkedin.com/company/cloro-dev/" target="_blank" rel="noopener" class="text-muted-foreground hover:text-foreground inline-flex items-center space-x-2 text-sm transition-colors duration-200" aria-label="LinkedIn"><svg class="h-4 w-4" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433c-1.144 0-2.063-.926-2.063-2.065 0-1.138.92-2.063 2.063-2.063 1.14 0 2.064.925 2.064 2.063 0 1.139-.925 2.065-2.064 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/></svg></a><a href="https://www.reddit.com/r/cloroapi/" target="_blank" rel="noopener" class="text-muted-foreground hover:text-foreground inline-flex items-center space-x-2 text-sm transition-colors duration-200" aria-label="Reddit community"><svg class="h-4 w-4" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path d="M12 0A12 12 0 0 0 0 12a12 12 0 0 0 12 12 12 12 0 0 0 12-12A12 12 0 0 0 12 0zm5.01 4.744c.688 0 1.25.561 1.25 1.249a1.25 1.25 0 0 1-2.498.056l-2.597-.547-.8 3.747c1.824.07 3.48.632 4.674 1.488.308-.309.73-.491 1.207-.491.968 0 1.754.786 1.754 1.754 0 .716-.435 1.333-1.01 1.614a3.111 3.111 0 0 1 .042.52c0 2.694-3.13 4.87-6.994 4.87-3.865 0-6.994-2.176-6.994-4.87 0-.183.015-.366.043-.534A1.748 1.748 0 0 1 4.028 12c0-.968.786-1.754 1.754-1.754.463 0 .898.196 1.207.49 1.207-.883 2.878-1.43 4.744-1.487l.885-4.182a.342.342 0 0 1 .14-.197.35.35 0 0 1 .238-.042l2.906.617a1.214 1.214 0 0 1 1.108-.701zM9.25 12c-.688 0-1.25.561-1.25 1.249 0 .687.562 1.248 1.25 1.248.687 0 1.248-.561 1.248-1.249 0-.688-.561-1.249-1.249-1.249zm5.5 0c-.687 0-1.248.561-1.248 1.25 0 .687.561 1.248 1.249 1.248.688 0 1.249-.561 1.249-1.249 0-.687-.562-1.249-1.25-1.249zm-5.466 3.99a.327.327 0 0 0-.231.094.33.33 0 0 0 0 .463c.842.842 2.484.913 2.961.913.477 0 2.105-.056 2.961-.913a.361.361 0 0 0 .029-.463.33.33 0 0 0-.464 0c-.547.533-1.684.73-2.512.73-.828 0-1.979-.196-2.512-.73a.326.326 0 0 0-.232-.095z"/></svg></a><a href="https://www.youtube.com/@cloro-dev" target="_blank" rel="noopener" class="text-muted-foreground hover:text-foreground inline-flex items-center space-x-2 text-sm transition-colors duration-200" aria-label="YouTube channel"><svg class="h-4 w-4" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path d="M23.498 6.186a3.016 3.016 0 0 0-2.122-2.136C19.505 3.545 12 3.545 12 3.545s-7.505 0-9.377.505A3.017 3.017 0 0 0 .502 6.186C0 8.07 0 12 0 12s0 3.93.502 5.814a3.016 3.016 0 0 0 2.122 2.136c1.871.505 9.376.505 9.376.505s7.505 0 9.377-.505a3.015 3.015 0 0 0 2.122-2.136C24 15.93 24 12 24 12s0-3.93-.502-5.814zM9.545 15.568V8.432L15.818 12l-6.273 3.568z"/></svg></a></div><div class="mt-3"><iframe title="cloro system status" data-src="https://status.cloro.dev/badge?theme=dark" width="250" height="30" loading="lazy" data-status-badge style="color-scheme: normal; border: none; overflow: hidden;"></iframe><noscript><a href="https://status.cloro.dev" target="_blank" rel="noopener" class="text-muted-foreground hover:text-foreground text-sm transition-colors duration-200">System status</a></noscript></div></div><div><h3 class="text-foreground mb-4 text-sm font-semibold">Company</h3><div class="flex flex-col space-y-3"><a href="/about/" class="text-muted-foreground hover:text-foreground inline-flex items-center gap-2 text-sm transition-colors duration-200">About</a><a href="/privacy/" class="text-muted-foreground hover:text-foreground inline-flex items-center gap-2 text-sm transition-colors duration-200">Privacy policy</a><a href="/terms/" class="text-muted-foreground hover:text-foreground inline-flex items-center gap-2 text-sm transition-colors duration-200">Terms of service</a><a href="/cookies/" class="text-muted-foreground hover:text-foreground inline-flex items-center gap-2 text-sm transition-colors duration-200">Cookie policy</a><button type="button" data-cookie-settings class="text-muted-foreground hover:text-foreground inline-flex cursor-pointer items-center gap-2 text-left text-sm transition-colors duration-200">Cookie settings</button><a href="/contact/" class="text-muted-foreground hover:text-foreground inline-flex items-center gap-2 text-sm transition-colors duration-200">Contact</a><a href="/blog/" class="text-muted-foreground hover:text-foreground inline-flex items-center gap-2 text-sm transition-colors duration-200">Blog</a><a href="/careers/" class="text-muted-foreground hover:text-foreground inline-flex items-center gap-2 text-sm transition-colors duration-200">Careers<span class="bg-primary/20 text-primary inline-flex h-5 min-w-5 items-center justify-center rounded-sm text-xs font-medium">1</span></a><a href="https://cloro.firstpromoter.com" target="_blank" rel="noopener" class="text-muted-foreground hover:text-foreground inline-flex items-center gap-2 text-sm transition-colors duration-200">Affiliates - earn 40%</a><a href="https://shop.cloro.dev" target="_blank" rel="noopener" class="text-muted-foreground hover:text-foreground inline-flex items-center gap-2 text-sm transition-colors duration-200">Merchandise</a></div></div><div><h3 class="text-foreground mb-4 text-sm font-semibold">Products</h3><div class="flex flex-col space-y-3"><a href="/chatgpt/" class="text-muted-foreground hover:text-foreground inline-flex items-center gap-2 text-sm transition-colors duration-200">ChatGPT</a><a href="/chatgpt-ads/" class="text-muted-foreground hover:text-foreground inline-flex items-center gap-2 text-sm transition-colors duration-200">ChatGPT Ads</a><a href="/perplexity/" class="text-muted-foreground hover:text-foreground inline-flex items-center gap-2 text-sm transition-colors duration-200">Perplexity AI</a><a href="/gemini/" class="text-muted-foreground hover:text-foreground inline-flex items-center gap-2 text-sm transition-colors duration-200">Gemini</a><a href="/serp-api/" class="text-muted-foreground hover:text-foreground inline-flex items-center gap-2 text-sm transition-colors duratio