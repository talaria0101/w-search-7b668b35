duration-200">Places</a></div></div></div></div></div></div><div class="border-border/50 border-t"><div class="mx-auto max-w-screen-xl px-5"><div class="py-6"><p class="text-muted-foreground text-center text-sm">© 2026 Cloro Incorporation Ltd. All rights reserved.</p></div></div></div></div></footer><script type="module">var e=document.querySelector(`[data-status-badge]`),t=e?.dataset.src;if(e&&t){if(`IntersectionObserver`in window){let n=new IntersectionObserver(r=>{r.some(e=>e.isIntersecting)&&(e.src=t,n.disconnect())},{rootMargin:`200px`});n.observe(e)}else e.src=t}document.addEventListener(`click`,e=>{e.target?.closest?.(`[data-cookie-settings]`)&&window.showCookiePreferences?.()});</script><div id="cc-container"></div><script type="module">function e(e){if(typeof window>`u`||!window.posthog)return e;let t=window.posthog.get_distinct_id?.();if(!t)return e;try{let n=new URL(e,window.location.href);return n.searchParams.set(`ph_did`,t),n.toString()}catch{return e}}document.addEventListener(`click`,t=>{let n=t.target?.closest?.(`a[data-cta-id]`);if(!n)return;let r=e(n.href);n.href=r,window.posthog?.capture(`cta_clicked`,{cta_id:n.dataset.ctaId,destination:r})});</script><script>(function(){const WEBMCP_PRICING = {"engines":[{"name":"ChatGPT (full response)","credits":7,"endpoint":"POST /v1/monitor/chatgpt"},{"name":"ChatGPT (web search)","credits":5,"endpoint":"POST /v1/monitor/chatgpt"},{"name":"Perplexity","credits":4,"endpoint":"POST /v1/monitor/perplexity"},{"name":"Copilot","credits":5,"endpoint":"POST /v1/monitor/copilot"},{"name":"Google AI Mode","credits":4,"endpoint":"POST /v1/monitor/aimode"},{"name":"Gemini","credits":4,"endpoint":"POST /v1/monitor/gemini"},{"name":"Google Search","credits":"3 + 2 per extra page (+2 if AI Overview)","endpoint":"POST /v1/monitor/google"},{"name":"Google News","credits":"3 + 2 per extra page","endpoint":"POST /v1/monitor/google/news"}],"aiEngines":{"ChatGPT (full response)":7,"ChatGPT (web search)":5,"Perplexity":4,"Copilot":5,"Google AI Mode":4,"Gemini":4,"Google News":"3 + 2 per extra page"},"unavailableEngines":[],"google":{"formula":"credits = 3 + (pages - 1) * 2 + (aioverview ? 2 : 0)","baseCredits":3,"extraPageCredits":2,"aiOverviewCredits":2,"examples":{"n=10 (1 page)":{"credits":3},"n=10 (1 page) + AI Overview":{"credits":5},"n=100 (10 pages) + AI Overview":{"credits":23}}},"plans":[{"name":"Free","tier":"free","monthlyPrice":0,"includedCredits":500,"pricePerThousandCredits":0,"maxConcurrency":1},{"name":"Lite","tier":"lite","monthlyPrice":30,"includedCredits":37500,"pricePerThousandCredits":0.8,"maxConcurrency":10},{"name":"Hobby","tier":"hobby","monthlyPrice":100,"includedCredits":250000,"pricePerThousandCredits":0.4,"maxConcurrency":20},{"name":"Starter","tier":"starter","monthlyPrice":250,"includedCredits":650000,"pricePerThousandCredits":0.385,"maxConcurrency":50},{"name":"Growth","tier":"growth","monthlyPrice":500,"includedCredits":1350000,"pricePerThousandCredits":0.37,"maxConcurrency":75},{"name":"Business","tier":"business","monthlyPrice":1000,"includedCredits":2800000,"pricePerThousandCredits":0.357,"maxConcurrency":100},{"name":"Enterprise 2,000","tier":"enterprise_2k","monthlyPrice":2000,"includedCredits":5871025,"pricePerThousandCredits":0.341,"maxConcurrency":135},{"name":"Enterprise 3,000","tier":"enterprise_3k","monthlyPrice":3000,"includedCredits":9306606,"pricePerThousandCredits":0.322,"maxConcurrency":175},{"name":"Enterprise 4,000","tier":"enterprise_4k","monthlyPrice":4000,"includedCredits":12756261,"pricePerThousandCredits":0.314,"maxConcurrency":215},{"name":"Enterprise 5,000","tier":"enterprise_5k","monthlyPrice":5000,"includedCredits":16391783,"pricePerThousandCredits":0.305,"maxConcurrency":255},{"name":"Enterprise","tier":"enterprise","monthlyPrice":null,"includedCredits":null,"pricePerThousandCredits":0.25,"maxConcurrency":null,"note":"Custom contract — $5,000+/mo, or $2,000+/mo with an annual contract"}]};

      // WebMCP -- expose a small set of read-only tools to in-browser agents.
      // Spec: https://webmachinelearning.github.io/webmcp/
      // Feature-detected; no-op in browsers without modelContext.
      // The API moved from navigator to document. navigator stays as the
      // fallback, but a read of it first prints a deprecation warning.
      (function () {
        const host =
          (typeof document !== "undefined" && "modelContext" in document && document) ||
          (typeof navigator !== "undefined" && "modelContext" in navigator && navigator) ||
          null;
        if (!host || typeof host.modelContext?.provideContext !== "function") {
          return;
        }
        // Cache the parsed llms.txt index across search_blog invocations so
        // repeated agent calls don't refetch on every query.
        let blogIndexPromise = null;
        function loadBlogIndex() {
          if (blogIndexPromise) return blogIndexPromise;
          blogIndexPromise = fetch("/llms.txt", { headers: { Accept: "text/plain" } })
            .then((res) => (res.ok ? res.text() : ""))
            .then((text) => {
              const entries = [];
              for (const line of text.split("\n")) {
                const m = line.match(/^- \[(.+?)\]\((.+?)\): (.+)$/);
                if (m) entries.push({ title: m[1], url: m[2], desc: m[3] });
              }
              return entries;
            })
            .catch(() => {
              blogIndexPromise = null;
              return [];
            });
          return blogIndexPromise;
        }

        try {
          host.modelContext.provideContext({
            tools: [
              {
                name: "open_api_docs",
                description:
                  "Return the URL to cloro's API documentation, which covers SERP scraping and AI model monitoring endpoints.",
                inputSchema: { type: "object", properties: {}, additionalProperties: false },
                execute: () => ({ url: "https://cloro.dev/docs" }),
              },
              {
                name: "search_blog",
                description:
                  "Search cloro's blog for posts matching a query. Returns a small list of {title, url}.",
                inputSchema: {
                  type: "object",
                  properties: { query: { type: "string", minLength: 1 } },
                  required: ["query"],
                  additionalProperties: false,
                },
                execute: async ({ query }) => {
                  if (typeof query !== "string" || query.trim() === "") {
                    return { error: "query must be a non-empty string" };
                  }
                  const q = query.toLowerCase();
                  const entries = await loadBlogIndex();
                  const results = [];
                  for (const entry of entries) {
                    const hay = (entry.title + " " + entry.desc).toLowerCase();
                    if (hay.includes(q)) results.push({ title: entry.title, url: entry.url });
                    if (results.length >= 10) break;
                  }
                  return { results };
                },
              },
              {
                name: "list_engines",
                description:
                  "List the AI engines and SERP sources cloro can query, with per-call credit cost and API endpoint.",
                inputSchema: { type: "object", properties: {}, additionalProperties: false },
                execute: () => ({
                  engines: WEBMCP_PRICING.engines,
                  baseUrl: "https://api.cloro.dev",
                  docs: "https://cloro.dev/docs",
                }),
              },
              {
                name: "compare_to_competitor",
                description:
                  "Return the cloro vs competitor comparison page URL for a known competitor slug (e.g. 'serpapi', 'dataforseo', 'brightdata'). Use when an agent is researching alternatives.",
                inputSchema: {
                  type: "object",
                  properties: { competitor: { type: "string", minLength: 1 } },
                  required: ["competitor"],
                  additionalProperties: false,
                },
                execute: ({ competitor }) => {
                  if (typeof competitor !== "string" || competitor.trim() === "") {
                    return { error: "competitor must be a non-empty string" };
                  }
                  const slug = competitor.trim().toLowerCase().replace(/[^a-z0-9]+/g, "-").replace(/^-|-$/g, "");
                  return { url: `https://cloro.dev/comparisons/${slug}/`, slug };
                },
              },
              {
                name: "get_pricing_summary",
                description:
                  "Return cloro's current pricing model: per-engine credit costs, the page-driven Google formula, and per-plan credit rates.",
                inputSchema: { type: "object", properties: {}, additionalProperties: false },
                execute: () => ({
                  model: "Per-call credits billed against a monthly plan allowance.",
                  google: WEBMCP_PRICING.google,
                  aiEngines: WEBMCP_PRICING.aiEngines,
                  unavailableEngines: WEBMCP_PRICING.unavailableEngines,
                  plans: WEBMCP_PRICING.plans,
                  url: "https://cloro.dev/pricing/",
                }),
              },
            ],
          });
        } catch (_e) {
          // WebMCP API surface is still in flux; never let it break page load.
        }
      })();
    })();</script><script>(function(){function c(){var b=a.contentDocument||(a.contentWindow&&a.contentWindow.document);if(b){var d=b.createElement('script');d.innerHTML="window.__CF$cv$params={r:'a4cd76339dac58b9',t:'MTc5MjM4ODU3MA=='};var a=document.createElement('script');a.src='/cdn-cgi/challenge-platform/scripts/jsd/main.js';document.getElementsByTagName('head')[0].appendChild(a);";b.getElementsByTagName('head')[0].appendChild(d)}}if(document.body){var a=document.createElement('iframe');a.height=1;a.width=1;a.style.position='absolute';a.style.top=0;a.style.left=0;a.style.border='none';a.style.visibility='hidden';document.body.appendChild(a);if('loading'!==document.readyState)c();else if(window.addEventListener)document.addEventListener('DOMContentLoaded',c);else{var e=document.onreadystatechange||function(){};document.onreadystatechange=function(b){e(b);'loading'!==document.readyState&&(document.onreadystatechange=e,c())}}}})();</script></body></html>