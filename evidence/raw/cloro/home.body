)return;navigator.clipboard.writeText(e).then(()=>{let e=t.textContent;e&&(t.textContent=`Copied!`,t.classList.add(`text-accent`),setTimeout(()=>{t.textContent=e,t.classList.remove(`text-accent`)},2e3))}).catch(e=>{console.error(`Failed to copy code:`,e)})}}})});</script><section id="pricing" class="bg-background relative py-16"><div class="relative mx-auto max-w-7xl px-4"><div class="mb-16 text-center"><h2 class="text-foreground mb-4 text-4xl font-bold md:text-5xl md:leading-[1.2]">Pricing that <span class="text-foreground font-semibold">scales</span> with you</h2><p class="text-muted-foreground mx-auto max-w-3xl text-lg">Start free. Price per credit drops as your volume grows — see every tier below.</p></div><div class="relative"><div class="relative"><div class="space-y-8"><div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-5"><div class="group relative"><div class="rounded-lg border text-card-foreground shadow-sm border-border bg-card/50 hover:border-border hover:bg-card/80 relative z-10 flex h-full flex-col backdrop-blur-sm transition-all"><div class="flex flex-col space-y-1.5 p-5 pb-3"><div class="tracking-tight text-foreground text-lg font-medium">Free</div><div class="space-y-1 pt-2"><div class="flex items-baseline"><span class="text-foreground text-3xl font-bold">$0</span><span class="text-muted-foreground ml-2">/mo</span></div><div class="text-muted-foreground text-sm">500 credits / month</div></div></div><div class="p-6 pt-0 flex-1 space-y-3 px-5 pb-4"><ul class="space-y-2"><li class="text-muted-foreground flex items-start text-sm"><svg class="mt-0.5 mr-2 h-4 w-4 flex-shrink-0 text-green-500" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg><span>Added monthly</span></li><li class="text-muted-foreground flex items-start text-sm"><svg class="mt-0.5 mr-2 h-4 w-4 flex-shrink-0 text-green-500" fill="none" viewBox="0 0 24 24" stroke="currentColor"