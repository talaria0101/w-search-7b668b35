console.log(response.result.text);">Copy</button></div><pre class="p-3 sm:p-4 text-[10px] sm:text-xs text-zinc-300 overflow-x-auto max-w-full h-[250px] lg:h-[325px]"><code class="break-words whitespace-pre-wrap">import { Cloro } from &quot;@cloro-dev/cloro&quot;;

