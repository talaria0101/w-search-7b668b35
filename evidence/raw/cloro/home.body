"in" style="--d:2.4s" x="361" y="248" text-anchor="middle" class="t-11 muted" data-astro-cid-ku3butf6="">One response shape</text><rect data-a="flash" style="--d:2.7s;--t:1s" x="20" y="26" width="36" height="36" rx="9" fill="none" stroke="#e4e4e7" stroke-width="1.5" data-astro-cid-ku3butf6=""/><path data-a="pulse" style="--d:2.7s;--t:0.55s" d="M56 44C106 44 100 144 146 144" pathLength="100" fill="none" stroke="#e4e4e7" stroke-width="2" stroke-linecap="round" data-astro-cid-ku3butf6=""/><path data-a="pulse" style="--d:3.2s;--t:0.3s" d="M222 144H258" pathLength="100" fill="none" stroke="#e4e4e7" stroke-width="2" stroke-linecap="round" data-astro-cid-ku3butf6=""/><text data-a="flash" style="--d:3.45s;--t:1.15s" x="272" y="84" class="mono t-11 muted" data-astro-cid-ku3butf6="">/v1/monitor/<tspan class="fg" data-astro-cid-ku3butf6="">chatgpt</tspan></text><rect data-a="flash" style="--d:3.85s;--t:1s" x="20" y="76" width="36" height="36" rx="9" fill="none" stroke="#e4e4e7" stroke-width="1.5" data-astro-cid-ku3butf6=""/><path data-a="pulse" style="--d:3.85s;--t:0.55s" d="M56 94C106 94 100 144 146 144" pathLength="100" fill="none" stroke="#e4e4e7" stroke-width="2" stroke-linecap="round" data-astro-cid-ku3butf6=""/><path data-a="pulse" style="--d:4.35s;--t:0.3s" d="M222 144H258" pathLength="100" fill="none" stroke="#e4e4e7" stroke-width="2" stroke-linecap="round" data-astro-cid-ku3butf6=""/><text data-a="flash" style="--d:4.6s;--t:1.15s" x="272" y="84" class="mono t-11 muted" data-astro-cid-ku3butf6="">/v1/monitor/<tspan class="fg" data-astro-cid-ku3butf6="">perplexity</tspan></text><rect data-a="flash" style="--d:5s;--t:1s" x="20" y="126" width="36" height="36" rx="9" fill="none" stroke="#e4e4e7" stroke-width="1.5" data-astro-cid-ku3butf6=""/><path data-a="pulse" style="--d:5s;--t:0.55s" d="M56 144C106 144 100 144 146 144" pathLength="100" fill="none" stroke="#e4e4e7" stroke-width="2" stroke-linecap="round" data-astro-cid-ku3butf6=""/><path data-a="pulse" style="--d:5.5s;--t:0.3s" d="M222 144H258" pathLength="100" fill="none" stroke="#e4e4e7" stroke-width="2" stroke-linecap="round" data-astro-cid-ku3butf6=""/><text data-a="flash" style="--d:5.75s;--t:1.15s" x="272" y="84" class="mono t-11 muted" data-astro-cid-ku3butf6="">/v1/monitor/<tspan class="fg" data-astro-cid-ku3butf6="">gemini</tspan></text><rect data-a="flash" style="--d:6.15s;--t:1s" x="20" y="176" width="36" height="36" rx="9" fill="none" stroke="#e4e4e7" stroke-width="1.5" data-astro-cid-ku3butf6=""/><path data-a="pulse" style="--d:6.15s;--t:0.55s" d="M56 194C106 194 100 144 146 144" pathLength="100" fill="none" stroke="#e4e4e7" stroke-width="2" stroke-linecap="round" data-astro-cid-ku3butf6=""/><path data-a="pulse" style="--d:6.65s;--t:0.3s" d="M222 144H258" pathLength="100" fill="none" stroke="#e4e4e7" stroke-width="2" stroke-linecap="round" data-astro-cid-ku3butf6=""/><text data-a="flash" style="--d:6.9s;--t:1.15s" x="272" y="84" class="mono t-11 muted" data-astro-cid-ku3butf6="">/v1/monitor/<tspan class="fg" data-astro-cid-ku3butf6="">copilot</tspan></text><rect data-a="flash" style="--d:7.3s;--t:1s" x="20" y="226" width="36" height="36" rx="9" fill="none" stroke="#e4e4e7" stroke-width="1.5" data-astro-cid-ku3butf6=""/><path data-a="pulse" style="--d:7.3s;--t:0.55s" d="M56 244C106 244 100 144 146 144" pathLength="100" fill="none" stroke="#e4e4e7" stroke-width="2" stroke-linecap="round" data-astro-cid-ku3butf6=""/><path data-a="pulse" style="--d:7.8s;--t:0.3s" d="M222 144H258" pathLength="100" fill="none" stroke="#e4e4e7" stroke-width="2" stroke-linecap="round" data-astro-cid-ku3butf6=""/><text data-a="in" style="--d:8.05s;--t:1.15s" x="272" y="84" class="mono t-11 muted" data-astro-cid-ku3butf6="">/v1/monitor/<tspan class="fg" data-astro-cid-ku3butf6="">google</tspan></text></g></svg></div></div></div></div><div class="mt-8"><h3 class="mt-2 text-xl font-medium lg:text-2xl"><span>Replace multiple integrations with one</span></h3><p class="mt-2 text-muted-foreground [text-wrap:balance]"><span class="!text-muted-foreground !text-sm">Each provider requires separate API integration, creating technical overhead. cloro puts every engine behind one API and one response shape, so a new engine is a config change.</span></p></div></div></div><div class="relative h-full"><div class="rounded-2xl bg-card p-8 shadow ring-1 ring-border transition-all hover:shadow-lg relative z-10 !bg-card/50 !border-border !text-foreground hover:!border-primary/50 hover:!bg-card/80 hover:scale-[1.02] transition-all duration-300 h-full"><div class="relative flex h-auto items-start justify-center overflow-hidden lg:h-72"><div class="surface-dark relative flex h-full w-full items-center justify-center overflow-hidden rounded-2xl"><div class="relative z-10 h-full w-full"><div class="ps mx-auto aspect-[5/3] w-full lg:h-full lg:w-auto" data-scene="costs" data-loop="7500" style="--loop:7500ms" data-astro-cid-ku3butf6><svg viewBox="0 0 480 288" role="img" aria-label="Know the cost up front" class="block w-full h-full" data-astro-cid-ku3butf6=""><g class="ps-root" aria-hidden="true" data-astro-cid-ku3butf6=""><text data-a="in" style="--d:0.1s" x="16" y="27" class="t-12 muted" data-astro-cid-ku3butf6="">1,000 prompts per engine</text><text data-a="in" style="--d:0.1s" x="464" y="27" text-anchor="end" class="t-12 muted" data-astro-cid-ku3butf6="">Credits</text><g data-a="in" style="--d:0.5s" data-astro-cid-ku3butf6=""><rect x="16" y="40" width="448" height="40" rx="10" fill="#262626" stroke="#3f3f46" data-astro-cid-ku3butf6=""/><svg x="30" y="50" width="20" height="20" color="#e4e4e7" data-astro-cid-ku3butf6=""><svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" class="w-full h-full"><path d="M22.2819 9.8211a5.9847 5.9847 0 0 0-.5157-4.9108 6.0462 6.0462 0 0 0-6.5098-2.9A6.0651 6.0651 0 0 0 4.9807 4.1818a5.9847 5.9847 0 0 0-3.9977 2.9 6.0462 6.0462 0 0 0 .7427 7.0966 5.98 5.98 0 0 0 .511 4.9107 6.051 6.051 0 0 0 6.5146 2.9001A5.9847 5.9847 0 0 0 13.2599 24a6.0557 6.0557 0 0 0 5.7718-4.2058 5.9894 5.9894 0 0 0 3.9977-2.9001 6.0557 6.0557 0 0 0-.7475-7.0729zm-9.022 12.6081a4.4755 4.4755 0 0 1-2.8764-1.0408l.1419-.0804 4.7783-2.7582a.7948.7948 0 0 0 .3927-.6813v-6.7369l2.02 1.1686a.071.071 0 0 1 .038.052v5.5826a4.504 4.504 0 0 1-4.4945 4.4944zm-9.6607-4.1254a4.4708 4.4708 0 0 1-.5346-3.0137l.142.0852 4.783 2.7582a.7712.7712 0 0 0 .7806 0l5.8428-3.3685v2.3324a.0804.0804 0 0 1-.0332.0615L9.74 19.9502a4.4992 4.4992 0 0 1-6.1408-1.6464zM2.3408 7.8956a4.485 4.485 0 0 1 2.3655-1.9728V11.6a.7664.7664 0 0 0 .3879.6765l5.8144 3.3543-2.0201 1.1685a.0757.0757 0 0 1-.071 0l-4.8303-2.7865A4.504 4.504 0 0 1 2.3408 7.872zm16.5963 3.8558L13.1038 8.364 15.1192 7.2a.0757.0757 0 0 1 .071 0l4.8303 2.7913a4.4944 4.4944 0 0 1-.6765 8.1042v-5.6772a.79.79 0 0 0-.407-.667zm2.0107-3.0231l-.142-.0852-4.7735-2.7818a.7759.7759 0 0 0-.7854 0L9.409 9.2297V6.8974a.0662.0662 0 0 1 .0284-.0615l4.8303-2.7866a4.4992 4.4992 0 0 1 6.6802 4.66zM8.3065 12.863l-2.02-1.1638a.0804.0804 0 0 1-.038-.0567V6.0742a4.4992 4.4992 0 0 1 7.3757-3.4537l-.142.0805L8.704 5.459a.7948.7948 0 0 0-.3927.6813zm1.0976-2.3654l2.602-1.4998 2.6069 1.4998v2.9994l-2.5974 1.4997-2.6067-1.4997Z" fill="currentColor"/></svg></svg><text x="62" y="65" class="t-13" data-astro-cid-ku3butf6="">ChatGPT (web search)</text></g><text data-a="in" style="--d:0.8s" x="374" y="64.5" text-anchor="end" class="mono t-11 muted" data-astro-cid-ku3butf6="">5 credits × 1,000</text><text data-a="in" style="--d:1.1s" x="450" y="65" text-anchor="end" class="mono t-13" data-astro-cid-ku3butf6="">5,000</text><g data-a="in" style="--d:1.8s" data-astro-cid-ku3butf6=""><rect x="16" y="90" width="448" height="40" rx="10" fill="#262626" stroke="#3f3f46" data-astro-cid-ku3butf6=""/><svg x="30" y="100" width="20" height="20" color="#e4e4e7" data-astro-cid-ku3butf6=""><svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 36 36" class="w-full h-full"><path d="M23.566,1.398l-9.495,9.504h9.495V1.398v2.602V1.398Zm-9.496,9.504L4.574,1.398v9.504h9.496Zm-.021-10.902v36m9.517-15.596l-9.495-9.504v13.625l9.495,9.504v-13.625Zm-18.991,0l9.496-9.504v13.625l-9.496,9.504v-13.625ZM.5,10.9v13.57h4.074v-4.066l9.496-9.504H.5Zm13.57,0l9.495,9.504v4.066h4.075v-13.57h-13.57Z" fill="none" stroke="#20808d" stroke-miterlimit="10"/></svg></svg><text x="62" y="115" class="t-13" data-astro-cid-ku3butf6="">Perplexity</text></g><text data-a="in" style="--d:2.1s" x="374" y="114.5" text-anchor="end" class="mono t-11 muted" data-astro-cid-ku3butf6="">4 credits × 1,000</text><text data-a="in" style="--d:2.4s" x="450" y="115" text-anchor="end" class="mono t-13" data-astro-cid-ku3butf6="">4,000</text><g data-a="in" style="--d:3.1s" data-astro-cid-ku3butf6=""><rect x="16" y="140" width="448" height="40" rx="10" fill="#262626" stroke="#3f3f46" data-astro-cid-ku3butf6=""/><svg x="30" y="150" width="20" height="20" color="#e4e4e7" data-astro-cid-ku3butf6=""><svg fill="none" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 16 16" class="w-full h-full"><path d="M16 8.016A8.522 8.522 0 008.016 16h-.032A8.521 8.521 0 000 8.016v-.032A8.521 8.521 0 007.984 0h.032A8.522 8.522 0 0016 7.984v.032z" fill="url(#gemini_gradient)"/><defs><radialGradient id="gemini_gradient" cx="0" cy="0" r="1" gradientUnits="userSpaceOnUse" gradientTransform="matrix(16.1326 5.4553 -43.70045 129.2322 1.588 6.503)"><stop offset=".067" stop-color="#9168C0"/><stop offset=".343" stop-color="#5684D1"/><stop offset=".672" stop-color="#1BA1E3"/></radialGradient></defs></svg></svg><text x="62" y="165" class="t-13" data-astro-cid-ku3butf6="">Gemini</text></g><text data-a="in" style="--d:3.4s" x="374" y="164.5" text-anchor="end" class="mono t-11 muted" data-astro-cid-ku3butf6="">4 credits × 1,000</text><text data-a="in" style="--d:3.7s" x="450" y="165" text-anchor="end" class="mono t-13" data-astro-cid-ku3butf6="">4,000</text><g data-a="in" style="--d:0.9s" data-astro-cid-ku3butf6=""><rect x="16" y="204" width="448" height="60" rx="12" fill="#e4e4e7" data-astro-cid-ku3butf6=""/><text x="32" y="230" class="t-13 dark" data-astro-cid-ku3butf6="">Cost of the run</text><text x="32" y="248" class="t-11 mid" data-astro-cid-ku3butf6="">Known before it starts</text></g><text data-a="flash" style="--d:1.3s;--t:1.3s" x="448" y="242" text-anchor="end" class="t-22 dark bold" data-astro-cid-ku3butf6="">5,000 credits</text><text data-a="flash" style="--d:2.6s;--t:1.3s" x="448" y="242" text-anchor="end" class="t-22 dark bold" data-astro-cid-ku3butf6="">9,000 credits</text><text data-a="in" style="--d:3.9000000000000004s;--t:1.3s" x="448" y="242" text-anchor="end" class="t-22 dark bold" data-astro-cid-ku3butf6="">13,000 credits</text></g></svg></div></div></div></div><div class="mt-8"><h3 class="mt-2 text-xl font-medium lg:text-2xl"><span>Know the cost up front</span></h3><p class="mt-2 text-muted-foreground [text-wrap:balance]"><span class="!text-muted-foreground !text-sm">Token-based pricing varies by model and provider, making costs unpredictable. cloro charges a published credit cost per request, so you can price a run in advance.</span></p></div></div></div></div></div></div></section><section id="generic-api-examples" class="bg-background py-20"><div class="mx-auto max-w-screen-xl px-5"><div class="text-center mb-16"><h2 class="text-4xl md:text-5xl font-bold text-foreground mb-4 md:leading-[1.2]">How the <span class="text-foreground font-semibold">cloro integration</span> works</h2><p class="text-lg text-muted-foreground max-w-3xl mx-auto">Choose your platform, send a query, get structured data back: <span class="text-foreground font-semibold">markdown</span>, <span class="text-foreground font-semibold">text</span>, or <span class="text-foreground font-semibold">HTML</span>, plus parsed <span class="text-foreground font-semibold">sources</span>, <span class="text-foreground font-semibold">citations</span>, <span class="text-foreground font-semibold">query fan-out</span>, and <span class="text-foreground font-semibold">shopping</span> blocks.</p></div><div class="mt-12 sm:mt-16 space-y-12 sm:space-y-16 max-w-full overflow-hidden"><div class="relative grid gap-6 lg:gap-12 lg:grid-cols-2  max-w-full items-start"><div class=" min-w-0"><div class="max-w-full"><h3 class="mb-4 text-lg font-semibold text-foreground">Request example</h3><div class="mb-2"><div class="flex space-x-1 rounded-lg bg-card p-1"><button class="tab-button flex-1 rounded-md px-2 py-2 text-xs sm:text-sm sm:px-3 sm:py-1 font-medium transition-colors bg-muted text-foreground" data-tab="homepage-example-1-python" data-example="homepage-example-1">Python</button><button class="tab-button flex-1 rounded-md px-2 py-2 text-xs sm:text-sm sm:px-3 sm:py-1 font-medium transition-colors text-muted-foreground hover:text-foreground" data-tab="homepage-example-1-typescript" data-example="homepage-example-1">TypeScript</button><button class="tab-button flex-1 rounded-md px-2 py-2 text-xs sm:text-sm sm:px-3 sm:py-1 font-medium transition-colors text-muted-foreground hover:text-foreground" data-tab="homepage-example-1-curl" data-example="homepage-example-1">cURL</button></div></div><div><div id="homepage-example-1-python" class="code-tab surface-dark rounded-lg border overflow-hidden"><div class="flex items-center justify-between px-4 py-3 border-b border-zinc-800 bg-zinc-900/40"><span class="text-sm text-zinc-400">python</span><button class="copy-button text-sm text-zinc-400 hover:text-zinc-100 transition-colors" data-code="from cloro import Cloro

client = Cloro(api_key=&quot;sk_live_your_api_key_here&quot;)

response = client.monitor.chatgpt(
    prompt=&quot;What do you know about Tesla's latest updates?&quot;,
    country=&quot;US&quot;,
    state=&quot;CA&quot;,
    include={&quot;markdown&quot;: True},
)

print(response[&quot;result&quot;][&quot;text&quot;])">Copy</button></div><pre class="p-3 sm:p-4 text-[10px] sm:text-xs text-zinc-300 overflow-x-auto max-w-full h-[250px] lg:h-[325px]"><code class="break-words whitespace-pre-wrap">from cloro import Cloro

client = Cloro(api_key=&quot;sk_live_your_api_key_here&quot;)

response = client.monitor.chatgpt(
    prompt=&quot;What do you know about Tesla&#39;s latest updates?&quot;,
    country=&quot;US&quot;,
    state=&quot;CA&quot;,
    include={&quot;markdown&quot;: True},
)

print(response[&quot;result&quot;][&quot;text&quot;])</code></pre></div><div id="homepage-example-1-typescript" class="code-tab surface-dark rounded-lg border overflow-hidden hidden"><div class="flex items-center justify-between px-4 py-3 border-b border-zinc-800 bg-zinc-900/40"><span class="text-sm text-zinc-400">typescript</span><button class="copy-button text-sm text-zinc-400 hover:text-zinc-100 transition-colors" data-code="import { Cloro } from &quot;@cloro-dev/cloro&quot;;

const client = new Cloro({ apiKey: &quot;sk_live_your_api_key_here&quot; });

const response = await client.monitor.chatgpt({
  prompt: &quot;What do you know about Tesla's latest updates?&quot;,
  country: &quot;US&quot;,
  state: &quot;CA&quot;,
