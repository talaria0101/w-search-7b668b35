client = LinkupClient(
    api_key=&quot;&lt;your-api-key&gt;&quot;, # Or set the LINKUP_API_KEY environment variable
)

# Perform a search query
search_response = client.search(
    query=&quot;What is Microsoft 2024 revenue?&quot;,
    depth=&quot;standard&quot;,
    output_type=&quot;searchResults&quot;,
)
print(search_response)</code></pre></div></div></div></div></div></div><a class="group rounded-none focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring disabled:pointer-events-none disabled:opacity-50 [&amp;_svg]:pointer-events-none [&amp;_svg]:size-4 [&amp;_svg]:shrink-0 bg-transparent h-auto flex w-full flex-col items-center justify-center gap-1 whitespace-nowrap border border-border px-3 py-6 text-base font-semibold leading-none tracking-[0.04em] text-signal-gray-2 transition-colors hover:bg-muted-foreground hover:text-background md:h-9 md:flex-row md:justify-between md:gap-0 md:py-0 mt-12 block" href="/contact"><div class="flex gap-3 items-center"><span aria-hidden="true" class="shrink-0 origin-center rounded-[0%] bg-current transition-[border-radius] duration-700 ease-[cubic-bezier(0.22,1,0.36,1)] group-hover:rounded-[50%] motion-safe:group-hover:animate-button-icon-size-pulse motion-reduce:group-hover:animate-none size-3"></span><span>Interested in our product beta?</span></div><span class="hidden md:flex gap-1 items-center">Reach out here <span class="inline-flex shrink-0 items-center justify-center size-4" aria-hidden="true"><svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" width="1em" height="1em" class="size-full" aria-hidden="true" focusable="false"><path fill="currentColor" fill-rule="evenodd" d="M3 14v-2h12v-2h2v2h2v2h-2v2h-2v-2zm10 4h2v-2h-2zm0 0h-2v2h2zm0-10h2v2h-2zm0 0h-2V6h2z" clip-rule="evenodd"></path></svg></span></span></a></div></section><section class="container relative isolate overflow-hidden py-12 text-foreground md:py-16"><div class=" relative z-10"><div dir="ltr" data-orientation="horizontal"><div data-state="active" data-orientation="horizontal" role="tabpanel" aria-labelledby="radix-_R_25fcnqdb_-trigger-simple_qa" id="radix-_R_25fcnqdb_-content-simple_qa" tabindex="0" class="mt-2 ring-offset-background focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring focus-visible:ring-off