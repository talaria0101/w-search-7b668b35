 web tools"},skills:$R[123]={title:"Agent Skill and CLI",description:"Teach a terminal agent when to search and when to read a page"},claudeCode:$R[124]={title:"Claude",description:"Connector and plugin with an Agent Skill"},codex:$R[125]={title:"ChatGPT & Codex",description:"One official plugin for live web search in ChatGPT and Codex"},cursor:$R[126]={title:"Cursor",description:"One-click install from the Directory, or mcp.json"},hermes:$R[127]={title:"Hermes",description:"Native plugin: hermes plugins install, then SEARCH1API_KEY"},openclaw:$R[128]={title:"OpenClaw",description:"Native tools via ClawHub: openclaw plugins install"},opencode:$R[129]={title:"OpenCode",description:"Native plugin: opencode plugin opencode-search1api"},langchain:$R[130]={title:"LangChain",description:"Official toolkit exposing search, news, and crawl as tools"},vercel:$R[131]={title:"Vercel",description:"AI SDK tools and runtime access through Vercel Connect"},n8n:$R[132]={title:"n8n",description:"Community node for search, news, page retrieval, and trends"},lobehub:$R[133]={title:"LobeHub",description:"Built-in search provider and crawler for self-hosted LobeHub"},deepseekHarness:$R[134]={title:"DeepSeek Harness",description:"Native dsh-s1 plugin registering web access as dsh tools"},python:$R[135]={title:"Python SDK",description:"Official search1api client with typed errors, retries, and async"},nodejs:$R[136]={title:"Node.js SDK",description:"Official @search1api/client, typed against the public API"}}},resources:$R[137]={title:"Resources",description:"Help you better use Search1API",items:$R[138]={blog:$R[139]={title:"Blog",description:"Read Search1API updates, guides, and ideas"},changelog:$R[140]={title:"Changelog",description:"Learn about latest features and improvements"},opensource:$R[141]={title:"Open Source",description:"Explore Search1API open-source projects"},status:$R[142]={title:"API Status",description:"Real-time API service status monitoring"}}}},components:$R[143]={a