,$R[27]={title:"Stack Overflow Scraper API",href:"/stackoverflow-scraper-api"},$R[28]={title:"Hugging Face Scraper API",href:"/huggingface-scraper-api"},$R[29]={title:"WeChat Scraper API",href:"/wechat-scraper-api"},$R[30]={title:"Hacker News Scraper API",href:"/hackernews-scraper-api"},$R[31]={title:"npm Scraper API",href:"/npm-scraper-api"},$R[32]={title:"PyPI Scraper API",href:"/pypi-scraper-api"},$R[33]={title:"Bilibili Scraper API",href:"/bilibili-scraper-api"},$R[34]={title:"CSDN Scraper API",href:"/csdn-scraper-api"}],privacy:$R[35]={country:"NP",region:"other",prompt:!1,globalPrivacyControl:!1},dictionary:$R[36]={web:$R[37]={redemptionOffer:$R[38]={meta:$R[39]={title:"A Codex Resets perk: Claim {credits} credits | Search1API",description:"Codex Resets users can claim {credits} Search1API credits for web search and crawling. Connect through API, CLI, Skills, or MCP and use them within {days} days of redemption."},campaign:$R[40]={partnerName:"Codex Resets",providerName:"Search1API"},hero:$R[41]={title:"Claim {credits} credits free",creditsUnit:"credits",equivalent:"≈ {credits} basic Search or single-page Crawl API calls",description:"Web access infrastructure for AI agents across search, crawling, extraction, and agent interfaces.",benefits:$R[42]=["Give Codex or Claude Code live web search with citable sources.","Turn any URL into clean, AI-ready Markdown.","Full support for API, MCP, CLI, and Skills."]},offer:$R[43]={validity:"Valid for {days} days after redemption · One claim per account",codeLabel:"Redemption code",codePlaceholder:"Enter your code",codeInvalid:"Enter a valid redemption code.",primaryCta:"Claim now"},coreApis:$R[44]={items:$R[45]=[$R[46]={title:"Search API: turn questions into citable web evidence",description:"Search multiple web and vertical search services through one endpoint, with titles, links, snippets, and source context.",endpoint:"POST /search",capabilities:$R[47]=[$R[48]={title:"Multiple engines, one endpoint",description:"Reach Google, Bing, GitHub, Reddit, YouTube, and more through one contract."},$R[49]={title:"Make results precise",description:"Filter by domain, excluded sites, time range, language, and other search controls."},$R[50]={title:"Read the full page when needed",description:"Deep Search can fetch the content behind result pages for richer context."}],useCasesLabel:"Best for",useCases:"AI answers, live research, monitoring, and RAG workflows that need fresh sources.",cta:"Explore Search API",proofTitle:"From a question to usable results",inputLabel:"Query",input:"“What is new in agent APIs?”",outputLabel:"Returns",outputs:$R[51]=["Results from multiple sources","Titles, links, and snippets","Optional page content and source context"]},$R[52]={title:"Crawl API: turn webpages into AI-ready content",description:"Submit one URL or a batch and get clean content plus structured results, without maintaining scrapers or an HTML cleanup pipeline.",endpoint:"POST /crawl",capabilities:$R[53]=[$R[54]={title:"Remove webpage noise",description:"Strip navigation, ads, and scripts to extract the main content and Markdown."},$R[55]={title:"Keep source context",description:"Return the title, URL, links, and page metadata alongside the content."},$R[56]={title:"Process URLs in batches",description:"Submit one URL or an array of URLs to normalize content from different sites."}],useCasesLabel:"Best for",useCases:"RAG ingestion, content aggregation, and agents that must read a specific page before acting.",cta:"Explore Crawl API",proofTitle:"From a webpage to clean context",inputLabel:"Webpage URL",input:"https://example.com/article",outputLabel:"Returns",outputs:$R[57]=["Clean content and Markdown","Title, URL, and page metadata","Context ready for RAG or agents"]}]},access:$R[58]={titleLead:"Use it from ",titleHighlight:"any agent stack",description:"Bring the same Search and Crawl capabilities into your app, or let agents such as Codex and Claude Code call them directly.",items:$R[59]=[$R[60]={title:"API",description:"Integrate directly through REST."},$R[61]={title:"CLI",description:"Run searches and crawls in your terminal."},$R[62]={title:"Skills",description:"Add live web access to your agent."},$R[63]={title:"MCP",description:"Connect through MCP servers."}]},otherApis:$R[64]={titleLead:"Need more inputs or outputs? ",titleHighlight:"Use the rest of the API suite",description:"Bring recent news, trends, site discovery, screenshots, full-site crawling, and structured extraction into the same workflow.",cta:"Learn more",items:$R[65]=[$R[66]={title:"News API",description:"Fetch recent news with language, time range, source service, and batch query controls."},$R[67]={title:"Screenshot API",description:"Capture a full page, viewport, or page element as PNG, JPEG, or WebP."},$R[68]={title:"Sitemap API",description:"Discover website URLs for crawl queues, SEO analysis, and knowledge-base planning."},$R[69]={title:"Trending API",description:"Fetch popular content from GitHub, Hacker News, and other supported platforms."},$R[70]={title:"DeepCrawl API",description:"Crawl an entire site asynchronously for RAG and knowledge-base corpora."},$R[71]={title:"Extract API",description:"Turn webpages into structured fields with natural-language prompts and JSON Schema."}]},finalCta:$R[72]={title:"Give your agent live web access",offerLine:"{credits} free credits · A Codex Resets exclusive",description:"Use Search, Crawl, and more APIs to retrieve live webpages and clean content through API, MCP, CLI, or Skills."}},freeSearchApi:$R[73]={meta:$R[74]={title:"Free Search API: 100 Free Credits, No Credit Card Required",description:"Free web search API with 100 starter credits. Query Google, Bing, Reddit, GitHub, YouTube & more. No credit card needed. Built for AI agents, RAG, and developers."},breadcrumb:$R[75]={home:"Search1API",current:"Free Search API"},hero:$R[76]={titleAccent:"100 free Search API credits",titleRest:"what they include",description:"Every new account receives a one-time starter balance. Here is how requests spend those 100 credits, which usage costs more, and what happens when the balance reaches zero.",primaryCta:"Claim 100 free credits",secondaryCta:"Read the credit rules",supporting:"No credit card · No expiration · One-time starter grant"},credits:$R[77]={title:"The starter balance at a glance",description:"The 100 credits belong to your account until you use them. They are not a recurring monthly allowance.",starterLabel:"credits granted to each new account",facts:$R[78]=["Granted once when you create an account","Up to 100 successful basic searches","No credit card","No expiration date"],limitsTitle:"How requests use the balance",limits:$R[79]=[$R[80]={title:"Basic Search",description:"A successful basic search costs 1 credit"},$R[81]={title:"Deep Search",description:"1 search credit + 1 per page crawled successfully"},$R[82]={title:"Failed requests",description:"A failed request costs 0 credits"},$R[83]={title:"Standard rate limit",description:"200 requests per minute per API key"}],limitsCta:"See all credits and limits"},examples:$R[84]={titleBeforeHighlight:"How far can ",titleHighlight:"100 credits",titleAfterHighlight:" go?",description:"The total number of requests depends on whether you ask Search1API to crawl full pages.",items:$R[85]=[$R[86]={value:"100",title:"basic searches",description:"A successful search without page crawling costs 1 credit, so the starter balance covers up to 100."},$R[87]={value:"25",title:"Deep Search requests in this example",description:"If each request searches once and successfully crawls 3 pages, it costs 4 credits: 1 + 3."},$R[88]={value:"0",title:"credits for a failed request",description:"Credits are deducted after success. A request that fails is not charged."}],note:"Deep Search charges only for pages that are crawled successfully, so its actual cost can vary by request."},faq:$R[89]={title:"Free Search API questions",items:$R[90]=[$R[91]={question:"Is the Search1API starter balance really free?",answer:"Yes. New accounts receive 100 credits without a credit card, and those starter credits do not expire."},$R[92]={question:"How many searches can I make with 100 credits?",answer:"A basic Search API request costs 1 credit, so the starter balance covers up to 100 basic searches. Deep Search costs 1 credit plus 1 for each page crawled successfully."},$R[93]={question:"Do I receive another 100 credits every month?",answer:"No. The 100-credit starter balance is granted once to each new account. It does not refill monthly."},$R[94]={question:"What happens when I use all 100 credits?",answer:"The API returns 402 Payment Required when the remaining balance cannot cover a successful request. You can top up credits or start a subscription from the dashboard."},$R[95]={question:"Can I use the free credits in production?",answer:"Yes. You can use the starter credits for a real workflow. The standard rate limit is 200 requests per minute per API key, and the 100-credit grant is not a recurring monthly allowance."}]},finalCta:$R[96]={title:"Use the 100 credits when you are ready",description:"Create an account without a credit card. Your starter balance stays available until you use it.",primary:"Claim 100 free credits",secondary:"Explore the Search API"}},header:$R[97]={tools:$R[98]={title:"Free Tools",items:$R[99]={urlToMarkdown:$R[100]={title:"URL to Markdown",description:"Paste a link, get clean Markdown for LLMs and notes"},sitemapExtractor:$R[101]={title:"Sitemap Extractor",description:"List every URL a site publishes in its sitemap"},overview:$R[102]={title:"All free tools",description:"Browser tools built on the same API you can integrate"},jevSearch:$R[103]={title:"Jev Search",description:"Plain-language live web search, open source"}}},home:"Home",proxies:"Proxies",proxyMenu:$R[104]={overview:$R[105]={title:"Proxy overview",description:"Compare Static ISP and Rotating Residential by IP behavior"},static:$R[106]={title:"Static IS