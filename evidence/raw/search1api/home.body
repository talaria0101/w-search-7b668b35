hi x4olc9o" data-direction="vertical" data-gap="3"><div class="astryx-stack x78zum5 x1q0g3np xewh9hi x4olc9o x6s0dn4" data-direction="horizontal" data-gap="3"><div class="flex h-10 w-10 shrink-0 items-center justify-center rounded-lg bg-[var(--color-background-red)] text-[var(--color-icon-red)]"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-calendar-x2 lucide-calendar-x-2 h-5 w-5" aria-hidden="true"><path d="M8 2v4"></path><path d="M16 2v4"></path><path d="M21 13V6a2 2 0 0 0-2-2H5a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h8"></path><path d="M3 10h18"></path><path d="m17 22 5-5"></path><path d="m17 17 5 5"></path></svg></div><h3 class="astryx-heading x1tgivj0 xii13ha xwjzt0u x1jcxfy8 x1lliihq" data-level="3" data-color="primary">Frozen in the past</h3></div><p class="astryx-text xv1l7n4 xjm74w1 xw6l6zx xxovm9e xt0psk2" data-type="body" data-color="secondary">LLMs only know their training cutoff. They can&#x27;t see today&#x27;s prices, news, or docs.</p></div></div><div class="astryx-card x2kkz0m x153u1i6 xeuugli x7giv3 x1p8z4y0 x1de1mus xw28qpl x9f619 x1vii845 xojybgt x1s81nki xgkj7vj xp8wdkl xbib2ws x1nzs0gl x6yxws5 x1tac27u x1rj5eim x1litavf x1y0btm7 x14i3s5s xs19ii7 x12frdag x1nex4ik xbv1mwh" data-variant="default" data-elevation="none"><div class="astryx-stack x78zum5 xdt5ytf xewh9hi x4olc9o" data-direction="vertical" data-gap="3"><div class="astryx-stack x78zum5 x1q0g3np xewh9hi x4olc9o x6s0dn4" data-direction="horizontal" data-gap="3"><div class="flex h-10 w-10 shrink-0 items-center justify-center rounded-lg bg-[var(--color-background-red)] text-[var(--color-icon-red)]"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-ban h-5 w-5" aria-hidden="true"><circle cx="12" cy="12" r="10"></circle><path d="M4.929 4.929 19.07 19.071"></path></svg></div><h3 class="astryx-heading x1tgivj0 xii13ha xwjzt0u x1jcxfy8 x1lliihq" data-level="3" data-color="primary">Blocked at the door</h3></div><p class="astryx-text xv1l7n4 xjm74w1 xw6l6zx xxovm9e xt0psk2" data-type="body" data-color="secondary">Roll your own scraper and you hit captchas, rate limits, and IP bans within minutes.</p></div></div><div class="astryx-card x2kkz0m x153u1i6 xeuugli x7giv3 x1p8z4y0 x1de1mus xw28qpl x9f619 x1vii845 xojybgt x1s81nki xgkj7vj xp8wdkl xbib2ws x1nzs0gl x6yxws5 x1tac27u x1rj5eim x1litavf x1y0btm7 x14i3s5s xs19ii7 x12frdag x1nex4ik xbv1mwh" data-variant="default" data-elevation="none"><div class="astryx-stack x78zum5 xdt5ytf xewh9hi x4olc9o" data-direction="vertical" data-gap="3"><div class="astryx-stack x78zum5 x1q0g3np xewh9hi x4olc9o x6s0dn4" data-direction="horizontal" data-gap="3"><div class="flex h-10 w-10 shrink-0 items-center justify-center rounded-lg bg-[var(--color-background-red)] text-[var(--color-icon-red)]"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-boxes h-5 w-5" aria-hidden="true"><path d="M2.97 12.92A2 2 0 0 0 2 14.63v3.24a2 2 0 0 0 .97 1.71l3 1.8a2 2 0 0 0 2.06 0L12 19v-5.5l-5-3-4.03 2.42Z"></path><path d="m7 16.5-4.74-2.85"></path><path d="m7 16.5 5-3"></path><path d="M7 16.5v5.17"></path><path d="M12 13.5V19l3.97 2.38a2 2 0 0 0 2.06 0l3-1.8a2 2 0 0 0 .97-1.71v-3.24a2 2 0 0 0-.97-1.71L17 10.5l-5 3Z"></path><path d="m17 16.5-5-3"></path><path d="m17 16.5 4.74-2.85"></path><path d="M17 16.5v5.17"></path><path d="M7.97 4.42A2 2 0 0 0 7 6.13v4.37l5 3 5-3V6.13a2 2 0 0 0-.97-1.71l-3-1.8a2 2 0 0 0-2.06 0l-3 1.8Z"></path><path d="M12 8 7.26 5.15"></path><path d="m12 8 4.74-2.85"></path><path d="M12 13.5V8"></path></svg></div><h3 class="astryx-heading x1tgivj0 xii13ha xwjzt0u x1jcxfy8 x1lliihq" data-level="3" data-color="primary">Glue-code sprawl</h3></div><p class="astryx-text xv1l7n4 xjm74w1 xw6l6zx xxovm9e xt0psk2" data-type="body" data-color="secondary">Stitching search engines, proxies, parsers, and anti-bot together is months of work.</p></div></div></div><div class="mx-auto max-w-2xl text-center"><p class="astryx-text x1tgivj0 x18juvz8 xf74fhv x1e4wzip xt0psk2 x2b8uid" data-type="large" data-color="primary">Search1API replaces the whole stack with<!-- --> <span class="text-[var(--color-text-accent)]">one API call</span></p></div></div></div></div></div><div class="xojxgvx x1fcf3bl xkibk3 xlayyun"><div class="astryx-section x5yr21d x9f619 x1vii845 xojybgt xswhm3q x1mzf5mb xj1bl4l xwuefyo x18gyask x1s0aq8i x1ydh6w3 x1l20ajd x1gu2k80 x91ghl5 x1i3qcxz xkunwnr x7mo41q x10xzikg" data-variant="section"><div class="astryx-stack x78zum5 xdt5ytf x1p37tyl x1xpicb7 x6s0dn4 x1rey3nv xnjyzlh xk6660b x2izi54 search1api-transport-section" data-direction="vertical" data-gap="10" style="width:100%"><header class="astryx-stack x78zum5 xdt5ytf xty4p9g xtx9w7w x6s0dn4" data-direction="vertical" data-gap="4" style="max-width:var(--container-3xl)"><h2 class="astryx-heading x1tgivj0 xlgnzhf x1ujwuaq x1on40hk x1lliihq x2b8uid" data-level="2" data-color="primary" data-type="display-3">Plug into any agent — your way</h2><p class="astryx-text xv1l7n4 x18juvz8 xf74fhv x149oux8 xt0psk2 x2b8uid" data-type="large" data-color="secondary">Choose the way you already use: API, MCP, CLI, or Skills.</p></header><div class="astryx-grid xrvj5dj xqketvx xsn7fz1 search1api-transport-list" data-gap="0" style="--x-gridTemplateColumns:repeat(auto-fit, minmax(min(100%, max(180px, calc((100% - 3 * var(--spacing-0)) / 4))), 1fr));width:100%;max-width:var(--container-6xl)"><a class="search1api-transport-item flex flex-col items-center gap-3 text-inherit no-underline" href="/search-api"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor