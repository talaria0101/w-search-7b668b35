9% uptime</span></div></div></div></section><!--/$--><footer class="search1api-footer-wash border-[var(--color-border)] border-t"><div class="xojxgvx x1fcf3bl xkibk3 xlayyun"><div class="astryx-section x5yr21d x9f619 x1vii845 xojybgt xswhm3q x1mzf5mb xj1bl4l xwuefyo x18gyask x1s0aq8i x1ydh6w3 x1l20ajd x1gu2k80 x91ghl5 x1i3qcxz xkunwnr x7mo41q x10xzikg" data-variant="section"><div class="container mx-auto px-4 py-16 md:py-20"><div class="astryx-grid xrvj5dj xqketvx x1qh66ti" data-gap="6" style="--x-gridTemplateColumns:repeat(auto-fill, minmax(min(100%, max(160px, calc((100% - 5 * var(--spacing-6)) / 6))), 1fr))"><div class="astryx-stack x78zum5 xdt5ytf xewh9hi x4olc9o" data-direction="vertical" data-gap="3"><h4 class="astryx-heading x1tgivj0 x8tkxat xqerer x2hcmsi x1lliihq" data-level="4" data-color="primary" style="font-size:var(--font-size-base);font-weight:var(--font-weight-semibold);line-height:var(--text-heading-6-leading)">APIs</h4><div class="astryx-stack x78zum5 xdt5ytf xak3so x1x7z4sm" data-direction="vertical" data-gap="2"><a class="text-[var(--color-text-secondary)] transition-colors hover:text-[var(--color-text-accent)]" style="font-size:var(--font-size-base)" href="/search-api">Search Query</a><a class="text-[var(--color-text-secondary)] transition-colors hover:text-[var(--color-text-accent)]" style="font-size:var(--font-size-base)" href="/ask-api">Agentic Search</a><a class="text-[var(--color-text-secondary)] transition-colors hover:text-[var(--color-text-accent)]" style="font-size:var(--font-size-base)" href="/news-api">News Hunt</a><a class="text-[var(--color-text-secondary)] transition-colors hover:text-[var(--color-text-accent)]" style="font-size:var(--font-size-base)" href="/crawl-api">Web Crawler</a><a class="text-[var(--color-text-secondary)] transition-colors hover:text-[var(--color-text-accent)]" style="font-size:var(--font-size-base)" href="/screenshot-api">Screenshot</a><a class="text-[var(--color-text-secondary)] transition-colors hover:text