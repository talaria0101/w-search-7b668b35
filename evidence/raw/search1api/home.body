  const allowedKeys = new Set(["utm_source","utm_medium","utm_campaign","utm_content","utm_term"]);
  globalThis.search1apiUmamiBeforeSend = (_type, payload) => {
    let disabled = false;
    try {
      const raw = document.cookie.split('; ').find(part => part.startsWith('search1api_basic_analytics='));
      disabled = raw ? JSON.parse(decodeURIComponent(raw.slice('search1api_basic_analytics='.length))) === 'off' : false;
      disabled ||= Boolean(globalThis.localStorage?.getItem('umami.disabled'));
    } catch {}
    const dnt = globalThis.navigator?.doNotTrack || globalThis.navigator?.msDoNotTrack;
    if (disabled || ['1', 'yes'].includes(dnt) || globalThis.navigator?.globalPrivacyControl === true || globalThis.__search1apiPrivacyPolicy?.globalPrivacyControl || _type === 'identify') return false;
    if (!payload || typeof payload !== 'object' || typeof payload.url !== 'string') {
      return payload;
    }
    try {
      const url = new URL(payload.url, 'https://search1api.invalid');
      for (const key of [...url.searchParams.keys()]) {
        if (!allowedKeys.has(key)) {
          url.searchParams.delete(key);
        }
      }
      const result = { ...payload, url: url.pathname + url.search };
      delete result.id;
      delete result.distinctId;
      delete result.distinct_id;
      if (typeof payload.referrer === 'string' && payload.referrer) {
        try {
          const base = globalThis.location?.origin || 'https://search1api.invalid';
          const referrer = new URL(payload.referrer, base);
          for (const key of [...referrer.searchParams.keys()]) if (!allowedKeys.has(key)) referrer.searchParams.delete(key);
          result.referrer = referrer.origin === base ? referrer.pathname + referrer.search : referrer.origin;
        } catch { result.referrer = ''; }
      }
      if (payload.data && typeof payload.data === 'object' && !Array.isArray(payload.data)) {
        const sensitive = /(?:gclid|gbraid|wbraid|fbclid|twclid|email|password|secret|token|api.?key|authorization|user.?id|distinct.?id|customer.?id|session.?id|request.?id|query|prompt|request.?body|response.?body|content|payload)/i;
        result.data = Object.fromEntries(Object.entries(payload.data).filter(([key, value]) => (allowedKeys.has(key) || !sensitive.test(key)) && ['string', 'number', 'boolean'].includes(typeof value)).map(([key, value]) => [key, typeof value === 'string' ? value.slice(0, 500) : value]));
      }
      return result;
    } catch {
      return false;
    }
  };
})();</script><script id="redemption-landing-deep-link">(// @ts-check

// Keep this module self-contained: its raw source also runs inline before analytics.
/**
 * @param {Pick<Window, 'history' | 'location' | 'sessionStorage'>} target
 * @param {string} storagePrefix
 * @param {number} maxLength
 * @returns {string | null}
 */
function captureRedemptionLandingCodeWithConfig(
  target,
  storagePrefix,
  maxLength
) {
  if (!/(?:^|\/)redeem\/[^/]+\/?$/.test(target.location.pathname)) {
    return null;
  }

  const hashParams = new URLSearchParams(target.location.hash.slice(1));
  const searchParams = new URLSearchParams(target.location.search);
  const linkedCode =
    hashParams.get('redeem') ??
    hashParams.get('credit-coupon') ??
    searchParams.get('redeem') ??
    searchParams.get('credit-coupon');
  if (!linkedCode) {
    return null;
  }

  searchParams.delete('redeem');
  searchParams.delete('credit-coupon');
  const remainingSearch = searchParams.toString();
  target.history.replaceState(
    target.history.state,
    '',
    target.location.pathname + (remainingSearch ? `?${remainingSearch}` : '')
  );

  const storageKey = storagePrefix + target.location.pathname;
  try {
    target.sessionStorage.removeItem(storageKey);
    const normalized = linkedCode.trim();
    if (normalized && normalized.length <= maxLength) {
      target.sessionStorage.setItem(storageKey, normalized);
      return normalized;
    }
  } catch {
    return null;
  }
  return null;
}
