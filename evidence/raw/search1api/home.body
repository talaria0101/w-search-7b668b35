o xwgcxoh x1iyjqo2"><span class="astryx-text x1tgivj0 x18juvz8 xf74fhv x2mo6ok xt0psk2" data-type="large" data-color="primary">Which search engines are supported?</span></span><span aria-hidden="true" class="astryx-icon xv9yike x3nfvp2 x6s0dn4 xl56j7k x2lah0s xta46cu x1seg80s x18juvz8 x11xpdln xuedmi6 xlr8y92 x7p49u4" data-size="sm" data-color="secondary"><svg xmlns="http://www.w3.org/2000/svg" width="1em" height="1em" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-chevron-down" aria-hidden="true"><path d="m6 9 6 6 6-6"></path></svg></span></button><div id="_R_llcqirq_" class="astryx-collapsible-content xfsso4q x9ynric xjm74w1 xxovm9e xw6l6zx x1tgivj0 x1s85apg"><div class="pt-4 pr-8"><p class="astryx-text xv1l7n4 xjm74w1 xw6l6zx xxovm9e xt0psk2" data-type="body" data-color="secondary">The Search endpoint covers general web, developer and community, media and reference, and Chinese-language sources, including Google, Bing, GitHub, Reddit, YouTube, and WeChat. Set search_service in the request to pick an engine; see the Search API documentation for the current supported list.</p></div></div></div></div></div><div class="astryx-card x2kkz0m x153u1i6 xeuugli x7giv3 x1p8z4y0 x1de1mus xw28qpl x9f619 x1vii845 xojybgt x1s81nki xgkj7vj xp8wdkl xbib2ws x1nzs0gl x6yxws5 x1tac27u x1rj5eim x1litavf x1y0btm7 x14i3s5s xs19ii7 x12frdag x1nex4ik xbv1mwh mb-3 last:mb-0" data-variant="default" data-elevation="none"><div><div class="astryx-collapsible xh8yej3"><button type="button" aria-expanded="false" aria-controls="_R_tlcqirq_" data-astryx-pressable="" class="astryx-collapsible-trigger x1k57tk5 x1vidyx5 x1t137rt x1jhp3zv xx47ajj x1wfwxd8 x1vwwbsn x9f619 x78zum5 x6s0dn4 x1qughib xh8yej3 x1ypdohk x16khyan x9ynric x18juvz8 x2mo6ok x1tgivj0 x1yc453h xt970qd x11z29ks xli5ek3 x14e4jsf x8s9nux xwkbtvz xziyay6 xz2mauf x1l7afqf x1anq1lc x1s5nr2v x13ugjdw xl8sb5e x7ngsy6 xubczrd" data-chevron-position="end"><span class="x1b2iylo xwgcxoh x1iyjqo2"><span class="astryx-text x1tgivj0 x18juvz8 xf74fhv x2mo6ok xt0psk2" data-type="large" data-color="primary">Why does some website crawling fail?</span></span><span aria-hidden="true" class="astryx-icon xv9yike x3nfvp2 x6s0dn4 xl56j7k x2lah0s xta46cu x1seg80s x18juvz8 x11xpdln xuedmi6 xlr8y92 x7p49u4" data-size="sm" data-color="secondary"><svg xmlns="http://www.w3.org/2000/svg" width="1em" height="1em" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-chevron-down" aria-hidden="true"><path d="m6 9 6 6 6-6"></path></svg></span></button><div id="_R_tlcqirq_" class="astryx-collapsible-content xfsso4q x9ynric xjm74w1 xxovm9e xw6l6zx x1tgivj0 x1s85apg"><div class="pt-4 pr-8"><p class="astryx-text xv1l7n4 xjm74w1 xw6l6zx xxovm9e xt0psk2" data-type="body" data-color="secondary">Website crawling is a complex process, and we cannot guarantee that all websites can be crawled at all times. However, we have adapted to crawl popular websites, including YouTube, Reddits, GitHub, Medium, and WeChat Official Accounts. If you are a corporate user, we can provide customized services to optimize crawling for your frequently used websites, while improving the success rate and presentation of crawled content.</p></div></div></div></div></div><div class="astryx-card x2kkz0m x153u1i6 xeuugli x7giv3 x1p8z4y0 x1de1mus xw28qpl x9f619 x1vii845 xojybgt x1s81nki xgkj7vj xp8wdkl xbib2ws x1nzs0gl x6yxws5 x1tac27u x1rj5eim x1litavf x1y0btm7 x14i3s5s xs19ii7 x12frdag x1nex4ik xbv1mwh mb-3 last:mb-0" data-variant="default" data-elevation="none"><div><div class="astryx-collapsible xh8yej3"><button type="button" aria-expanded="false" aria-controls="_R_15lcqirq_" data-astryx-pressable="" class="astryx-collapsible-trigger x1k57tk5 x1vidyx5 x1t137rt x1jhp3zv xx47ajj x1wfwxd8 x1vwwbsn x9f619 x78zum5 x6s0dn4 x1qughib xh8yej3 x1ypdohk x16khyan x9ynric x18juvz8 x2mo6ok x1tgivj0 x1yc453h xt970qd x11z29ks xli5ek3 x14e4jsf x8s9nux xwkbtvz xziyay6 xz2mauf x1l7afqf x1anq1lc x1s5nr2v x13ugjdw xl8sb5e x7ngsy6 xubczrd" data-chevron-position="end"><span class="x1b2iylo xwgcxoh x1iyjqo2"><span class="astryx-text x1tgivj0 x18juvz8 xf74fhv x2mo6ok xt0psk2" data-type="large" data-color="primary">How can I use this product?</span></span><span aria-hidden="true" class="astryx-icon xv9yike x3nfvp2 x6s0dn4 xl56j7k x2lah0s xta46cu x1seg80s x18juvz8 x11xpdln xuedmi6 xlr8y92 x7p49u4" data-size="sm" data-color="secondary"><svg xmlns="http://www.w3.org/2000/svg" width="1em" height="1em" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-chevron-down" aria-hidden="true"><path d="m6 9 6 6 6-6"></path></svg></span></button><div id="_R_15lcqirq_" class="astryx-collapsible-content xfsso4q x9ynric xjm74w1 xxovm9e xw6l6zx x1tgivj0 x1s85apg"><div class="pt-4 pr-8"><p class="astryx-text xv1l7n4 xjm74w1 xw6l6zx xxovm9e xt0psk2" data-type="body" data-color="secondary">Search1API gives AI agents one web access layer for search, crawl, extract, sitemap, and trending workflows. You can integrate it directly over HTTP or connect through MCP, CLI tooling, and reusable skills in agent environments such as Claude, Cursor, Windsurf, and custom apps.</p></div></div></div></div></div><div class="astryx-card x2kkz0m x153u1i6 xeuugli x7giv3 x1p8z4y0 x1de1mus xw28qpl x9f619 x1vii845 xojybgt x1s81nki xgkj7vj xp8wdkl xbib2ws x1nzs0gl x6yxws5 x1tac27u x1rj5eim x1litavf x1y0btm7 x14i3s5s xs19ii7 x12frdag x1nex4ik xbv1mwh mb-3 last:mb-0" data-variant="default" data-elevation="none"><div><div class="astryx-collapsible xh8yej3"><button type="button" aria-expanded="false" aria-controls="_R_1dlcqirq_" data-astryx-pressable="" class="astryx-collapsible-trigger x1k57tk5 x1vidyx5 x1t137rt x1jhp3zv xx47ajj x1wfwxd8 x1vwwbsn x9f619 x78zum5 x6s0dn4 x1qughib xh8yej3 x1ypdohk x16khyan x9ynric x18juvz8 x2mo6ok x1tgivj0 x1yc453h xt970qd x11z29ks xli5ek3 x14e4jsf x8s9nux xwkbtvz xziyay6 xz2mauf x1l7afqf x1anq1lc x1s5nr2v x13ugjdw xl8sb5e x7ngsy6 xubczrd" data-chevron-position="end"><span class="x1b2iylo xwgcxoh x1iyjqo2"><span class="astryx-text x1tgivj0 x18juvz8 xf74fhv x2mo6ok xt0psk2" data-type="large" data-color="primary">How can I contact you?</span></span><span aria-hidden="true" class="astryx-icon xv9yike x3nfvp2 x6s0dn4 xl56j7k x2lah0s xta46cu x1seg80s x18juvz8 x11xpdln xuedmi6 xlr8y92 x7p49u4" data-size="sm" data-color="secondary"><svg xmlns="http://www.w3.org/2000/svg" width="1em" height="1em" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-chevron-down" aria-hidden="true"><path d="m6 9 6 6 6-6"></path></svg></span></button><div id="_R_1dlcqirq_" class="astryx-collapsible-content xfsso4q x9ynric xjm74w1 xxovm9e xw6l6zx x1tgivj0 x1s85apg"><div class="pt-4 pr-8"><p class="astryx-text xv1l7n4 xjm74w1 xw6l6zx xxovm9e xt0psk2" data-type="body" data-color="secondary">You can contact us through the official email or join our Discord community.</p></div></div></div></div></div><div class="astryx-card x2kkz0m x153u1i6 xeuugli x7giv3 x1p8z4y0 x1de1mus xw28qpl x9f619 x1vii845 xojybgt x1s81nki xgkj7vj xp8wdkl xbib2ws x1nzs0gl x6yxws5 x1tac27u x1rj5eim x1litavf x1y0btm7 x14i3s5s xs19ii7 x12frdag x1nex4ik xbv1mwh mb-3 last:mb-0" data-variant="default" data-elevation="none"><div><div class="astryx-collapsible xh8yej3"><button type="button" aria-expanded="false" aria-controls="_R_1llcqirq_" data-astryx-pressable="" class="astryx-collapsible-trigger x1k57tk5 x1vidyx5 x1t137rt x1jhp3zv xx47ajj x1wfwxd8 x1vwwbsn x9f619 x78zum5 x6s0dn4 x1qughib xh8yej3 x1ypdohk x16khyan x9ynric x18juvz8 x2mo6ok x1tgivj0 x1yc453h xt970qd x11z29ks xli5ek3 x14e4jsf x8s9nux xwkbtvz xziyay6 xz2mauf x1l7afqf x1anq1lc x1s5nr2v x13ugjdw xl8sb5e x7ngsy6 xubczrd" data-chevron-position="end"><span class="x1b2iylo xwgcxoh x1iyjqo2"><span class="astryx-text x1tgivj0 x18juvz8 xf74fhv x2mo6ok xt0psk2" data-type="large" data-color="primary">How can I see the usage of my account?</span></span><span aria-hidden="true" class="astryx-icon xv9yike x3nfvp2 x6s0dn4 xl56j7k x2lah0s xta46cu x1seg80s x18juvz8 x11xpdln xuedmi6 xlr8y92 x7p49u4" data-size="sm" data-color="secondary"><svg xmlns="http://www.w3.org/2000/svg" width="1em" height="1em" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-chevron-down" aria-hidden="true"><path d="m6 9 6 6 6-6"></path></svg></span></button><div id="_R_1llcqirq_" class="astryx-collapsible-content xfsso4q x9ynric xjm74w1 xxovm9e xw6l6zx x1tgivj0 x1s85apg"><div class="pt-4 pr-8"><p class="astryx-text xv1l7n4 xjm74w1 xw6l6zx xxovm9e xt0psk2" data-type="body" data-color="secondary">You can see the usage of your account by logging in to your account and checking the usage statistics in the dashboard.</p></div></div></div></div></div><div class="astryx-card x2kkz0m x153u1i6 xeuugli x7giv3 x1p8z4y0 x1de1mus xw28qpl x9f619 x1vii845 xojybgt x1s81nki xgkj7vj xp8wdkl xbib2ws x1nzs0gl x6yxws5 x1tac27u x1rj5eim x1litavf x1y0btm7 x14i3s5s xs19ii7 x12frdag x1nex4ik xbv1mwh mb-3 last:mb-0" data-variant="default" data-elevation="none"><div><div class="astryx-collapsible xh8yej3"><button type="button" aria-expanded="false" aria-controls="_R_1tlcqirq_" data-astryx-pressable="" class="astryx-collapsible-trigger x1k57tk5 x1vidyx5 x1t137rt x1jhp3zv xx47ajj x1wfwxd8 x1vwwbsn x9f619 x78zum5 x6s0dn4 x1qughib xh8yej3 x1ypdohk x16khyan x9ynric x18juvz8 x2mo6ok x1tgivj0 x1yc453h xt970qd x11z29ks xli5ek3 x14e4jsf x8s9nux xwkbtvz xziyay6 xz2mauf x1l7afqf x1anq1lc x1s5nr2v x13ugjdw xl8sb5e x7ngsy6 xubczrd" data-chevron-position="end"><span class="x1b2iylo xwgcxoh x1iyjqo2"><span class="astryx-text x1tgivj0 x18juvz8 xf74fhv x2mo6ok xt0psk2" data-type="large" data-color="primary">Do you store the search results?</span></span><span aria-hidden="true" class="astryx-icon xv9yike x3nfvp2 x6s0dn4 xl56j7k x2lah0s xta46cu x1seg80s x18juvz8 x11xpdln xuedmi6 xlr8y92 x7p49u4" data-size="sm" data-color="secondary"><svg xmlns="http://www.w3.org/2000/svg" width="1em" height="1em" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-chevron-down" aria-hidden="true"><path d="m6 9 6 6 6-6"></path></svg></span></button><div id="_R_1tlcqirq_" class="astryx-collapsible-content xfsso4q x9ynric xjm74w1 xxovm9e xw6l6zx x1tgivj0 x1s85apg"><div class="pt-4 pr-8"><p class="astryx-text xv1l7n4 xjm74w1 xw6l6zx xxovm9e xt0psk2" data-type="body" data-color="secondary">No, we don&#x27;t store any search results. Each request is processed in real-time and the results are immediately returned to you.</p></div></div></div></div></div><div class="astryx-card x2kkz0m x153u1i6 xeuugli x7giv3 x1p8z4y0 x1de1mus xw28qpl x9f619 x1vii845 xojybgt x1s81nki xgkj7vj xp8wdkl xbib2ws x1nzs0gl x6yxws5 x1tac27u x1rj5eim x1litavf x1y0btm7 x14i3s5s xs19ii7 x12frdag x1nex4ik xbv1mwh mb-3 last:mb-0" data-variant="default" data-elevation="none"><div><div class="astryx-collapsible xh8yej3"><button type="button" aria-expanded="false" aria-controls="_R_25lcqirq_" data-astryx-pressable="" class="astryx-collapsible-trigger x1k57tk5 x1vidyx5 x1t137rt x1jhp3zv xx47ajj x1wfwxd8 x1vwwbsn x9f619 x78zum5 x6s0dn4 x1qughib xh8yej3 x1ypdohk x16khyan x9ynric x18juvz8 x2mo6ok x1tgivj0 x1yc453h xt970qd x11z29ks xli5ek3 x14e4jsf x8s9nux xwkbtvz xziyay6 xz2mauf x1l7afqf x1anq1lc x1s5nr2v x13ugjdw xl8sb5e x7ngsy6 xubczrd" data-chevron-position="end"><span class="x1b2iylo xwgcxoh x1iyjqo2"><span class="astryx-text x1tgivj0 x18juvz8 xf74fhv x2mo6ok xt0psk2" data-type="large" data-color="primary">How are credits charged for failed requests?</span></span><span aria-hidden="true" class="astryx-icon xv9yike x3nfvp2 x6s0dn4 xl56j7k x2lah0s xta46cu x1seg80s x18juvz8 x11xpdln xuedmi6 xlr8y92 x7p49u4" data-size="sm" data-color="secondary"><svg xmlns="http://www.w3.org/2000/svg" width="1em" height="1em" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-chevron-down" aria-hidden="true"><path d="m6 9 6 6 6-6"></path></svg></span></button><div id="_R_25lcqirq_" class="astryx-collapsible-content xfsso4q x9ynric xjm74w1 xxovm9e xw6l6zx x1tgivj0 x1s85apg"><div class="pt-4 pr-8"><p class="astryx-text xv1l7n4 xjm74w1 xw6l6zx xxovm9e xt0psk2" data-type="body" data-color="secondary">Failed requests should not deduct any credits from your account. If you notice any incorrect credit deductions, please contact us at sys@search1api.com for assistance.</p></div></div></div></div></div><div class="astryx-card x2kkz0m x153u1i6 xeuugli x7giv3 x1p8z4y0 x1de1mus xw28qpl x9f619 x1vii845 xojybgt x1s81nki xgkj7vj xp8wdkl xbib2ws x1nzs0gl x6yxws5 x1tac27u x1rj5eim x1litavf x1y0btm7 x14i3s5s xs19ii7 x12frdag x1nex4ik xbv1mwh mb-3 last:mb-0" data-variant="default" data-elevation="none"><div><div class="astryx-collapsible xh8yej3"><button type="button" aria-expanded="false" aria-controls="_R_2dlcqirq_" data-astryx-pressable="" class="astryx-collapsible-trigger x1k57tk5 x1vidyx5 x1t137rt x1jhp3zv xx47ajj x1wfwxd8 x1vwwbsn x9f619 x78zum5 x6s0dn4 x1qughib xh8yej3 x1ypdohk x16khyan x9ynric x18juvz8 x2mo6ok x1tgivj0 x1yc453h xt970qd x11z29ks xli5ek3 x14e4jsf x8s9nux xwkbtvz xziyay6 xz2mauf x1l7afqf x1anq1lc x1s5nr2v x13ugjdw xl8sb5e x7ngsy6 xubczrd" data-chevron-position="end"><span class="x1b2iylo xwgcxoh x1iyjqo2"><span class="astryx-text x1tgivj0 x18juvz8 xf74fhv x2mo6ok xt0psk2" data-type="large" data-color="primary">How does DeepSearch mode billing work?</span></span><span aria-hidden="true" class="astryx-icon xv9yike x3nfvp2 x6s0dn4 xl56j7k x2lah0s xta46cu x1seg80s x18juvz8 x11xpdln xuedmi6 xlr8y92 x7p49u4" data-size="sm" data-color="secondary"><svg xmlns="http://www.w3.org/2000/svg" width="1em" height="1em" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-chevron-down" aria-hidden="true"><path d="m6 9 6 6 6-6"></path></svg></span></button><div id="_R_2dlcqirq_" class="astryx-collapsible-content xfsso4q x9ynric xjm74w1 xxovm9e xw6l6zx x1tgivj0 x1s85apg"><div class="pt-4 pr-8"><p class="astryx-text xv1l7n4 xjm74w1 xw6l6zx xxovm9e xt0psk2" data-type="body" data-color="secondary">In DeepSearch mode, credits are charged based on the search query (1 credit) plus the number of successfully crawled pages. For example, if you set crawl_results=4 but only 3 pages are successfully crawled, you will be charged 1+3=4 credits instead of 1+4=5 credits.</p></div></div></div></div></div><div class="astryx-card x2kkz0m x153u1i6 xeuugli x7giv3 x1p8z4y0 x1de1mus xw28qpl x9f619 x1vii845 xojybgt x1s81nki xgkj7vj xp8wdkl xbib2ws x1nzs0gl x6yxws5 x1tac27u x1rj5eim x1litavf x1y0btm7 x14i3s5s xs19ii7 x12frdag x1nex4ik xbv1mwh mb-3 last:mb-0" data-variant="default" data-elevation="none"><div><div class="astryx-collapsible xh8yej3"><button type="button" aria-expanded="false" aria-controls="_R_2llcqirq_" data-astryx-pressable="" class="astryx-collapsible-trigger x1k57tk5 x1vidyx5 x1t137rt x1jhp3zv xx47ajj x1wfwxd8 x1vwwbsn x9f619 x78zum5 x6s0dn4 x1qughib xh8yej3 x1ypdohk x16khyan x9ynric x18juvz8 x2mo6ok x1tgivj0 x1yc453h xt970qd x11z29ks xli5ek3 x14e4jsf x8s9nux xwkbtvz xziyay6 xz2mauf x1l7afqf x1anq1lc x1s5nr2v x13ugjdw xl8sb5e x7ngsy6 xubczrd" data-chevron-position="end"><span class="x1b2iylo xwgcxoh x1iyjqo2"><span class="astryx-text x1tgivj0 x18juvz8 xf74fhv x2mo6ok xt0psk2" data-type="large" data-color="primary">What is your refund policy?</span></span><span aria-hidden="true" class="astryx-icon xv9yike x3nfvp2 x6s0dn4 xl56j7k x2lah0s xta46cu x1seg80s x18juvz8 x11xpdln xuedmi6 xlr8y92 x7p49u4" data-size="sm" data-color="secondary"><svg xmlns="http://www.w3.org/2000/svg" width="1em" height="1em" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-chevron-down" aria-hidden="true"><path d="m6 9 6 6 6-6"></path></svg></span></button><div id="_R_2llcqirq_" class="astryx-collapsible-content xfsso4q x9ynric xjm74w1 xxovm9e xw6l6zx x1tgivj0 x1s85apg"><div class="pt-4 pr-8"><p class="astryx-text xv1l7n4 xjm74w1 xw6l6zx xxovm9e xt0psk2" data-type="body" data-color="secondary">Purchases are non-refundable. You can cancel a subscription at any time from your dashboard — cancelling stops the next billing cycle, but the current period is not refunded. If the service doesn&#x27;t match what this site describes, email us at sys@search1api.com and we&#x27;ll issue a refund once we&#x27;ve confirmed it. The 3-day plan is excluded from that exception and is never refunded, including when it doesn&#x27;t match the site description or your expectations.</p></div></div></div></div></div></div></div></section><section class="container mx-auto px-4 py-20 md:py-24"><div class="relative mx-auto max-w-4xl overflow-hidden rounded-[var(--radius-container)] border border-[var(--color-border)] bg-[var(--color-background-card)] px-6 py-14 text-center sm:px-12 sm:py-16"><div class="relative"><div class="astryx-stack x78zum5 xdt5ytf x3qlgwd xczp1bk x6s0dn4" data-direction="vertical" data-gap="6"><h2 class="astryx-heading x1tgivj0 xlgnzhf x1ujwuaq x1on40hk x1lliihq x2b8uid" data-level="2" data-color="primary" data-type="display-3">Start with one API. Connect every agent</h2><div class="mx-auto max-w-2xl"><p class="astryx-text xv1l7n4 x18juvz8 xf74fhv x149oux8 xt0psk2 x2b8uid" data-type="large" data-color="secondary">Get your API key, test the core APIs, then connect through MCP, CLI, or reusable skills.</p></div><div class="astryx-stack x78zum5 x1q0g3np xewh9hi x4olc9o xl56j7k x1a02dak" data-direction="horizontal" data-gap="3" data-wrap="wrap"><span class="search1api-naviga