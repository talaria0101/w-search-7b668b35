class="xjp7ctv"><div role="main" class="astryx-layout-content x9f619 x5yr21d x98rzlu x2lwn1j x7giv3 x18gyask x1s0aq8i x1ydh6w3 x1l20ajd x1gu2k80 x91ghl5 x1i3qcxz xkunwnr x10xzikg x1uvtmcs" id="astryx-app-shell-main" tabindex="-1"><!--$--><script type="application/ld+json">{"@context":"https://schema.org","@type":"SoftwareApplication","@id":"https://s1.dev/#software","name":"Search1API","image":"https://s1.dev/og-home-v2.png","description":"Search1API is web access infrastructure for AI agents: one API for live web search, news, page reading, screenshots, sitemaps, trending topics, and structured extraction, reachable over REST, MCP, CLI, and Agent Skills.","url":"https://s1.dev","applicationCategory":"DeveloperApplication","applicationSubCategory":"Web Search API","operatingSystem":"Any","provider":{"@id":"https://s1.dev/#organization"},"softwareHelp":{"@type":"WebPage","name":"Search1API documentation","url":"https://s1.dev/docs"},"offers":{"@type":"AggregateOffer","priceCurrency":"USD","lowPrice":"0.00","highPrice":"499.00","offerCount":4,"offers":[{"@type":"Offer","name":"Basic","price":"19.00","priceCurrency":"USD","url":"https://s1.dev/pricing","availability":"https://schema.org/InStock"},{"@type":"Offer","name":"Professional","price":"99.00","priceCurrency":"USD","url":"https://s1.dev/pricing","availability":"https://schema.org/InStock"},{"@type":"Offer","name":"Enterprise","price":"499.00","priceCurrency":"USD","url":"https://s1.dev/pricing","availability":"https://schema.org/InStock"}],"url":"https://s1.dev/pricing"}}</script><script type="application/ld+json">{"@context":"https://schema.org","@type":"FAQPage","mainEntity":[{"@type":"Question","name":"How quickly will I receive search results?","acceptedAnswer":{"@type":"Answer","text":"Search results are typically delivered within 1-2 seconds. For most queries, you'll get instant responses that you can use in your applications."}},{"@type":"Question","name":"Which search engines are supported?","acceptedAnswer":{"@type":"Answer","text":"The Search endpoint covers general web, developer and community, media and reference, and Chinese-language sources, including Google, Bing, GitHub, Reddit, YouTube, and WeChat. Set search_service in the request to pick an engine; see the Search API documentation for the current supported list."}},{"@type":"Question","name":"Why does some website crawling fail?","acceptedAnswer":{"@type":"Answer","text":"Website crawling is a complex process, and we cannot guarantee that all websites can be crawled at all times. However, we have adapted to crawl popular websites, including YouTube, Reddits, GitHub, Medium, and WeChat Official Accounts. If you are a corporate user, we can provide customized services to optimize crawling for your frequently used websites, while improving the success rate and presentation of crawled content."}},{"@type":"Question","name":"How can I use this product?","acceptedAnswer":{"@type":"Answer","text":"Search1API gives AI agents one web access layer for search, crawl, extract, sitemap, and trending workflows. You can integrate it directly over HTTP or connect through MCP, CLI tooling, and reusable skills in agent environments such as Claude, Cursor, Windsurf, and custom apps."}},{"@type":"Question","name":"How can I contact you?","acceptedAnswer":{"@type":"Answer","text":"You can contact us through the official email or join our Discord community."}},{"@type":"Question","name":"How can I see the usage of my account?","acceptedAnswer":{"@type":"Answer","text":"You can see the usage of your account by logging in to your account and checking the usage statistics in the dashboard."}},{"@type":"Question","name":"Do you store the search results?","acceptedAnswer":{"@type":"Answer","text":"No, we don't store any search results. Each request is processed in real-time and the results are immediately returned to you."}},{"@type":"Question","name":"How are credits charged for failed requests?","acceptedAnswer":{"@type":"Answer","text":"Failed requests should not deduct any credits from your account. If you notice any incorrect credit deductions, please contact us at sys@search1api.com for assistance."}},{"@type":"Question","name":"How does DeepSearch mode billing work?","acceptedAnswer":{"@type":"Answer","text":"In DeepSearch mode, credits are charged based on the search query (1 credit) plus the number of successfully crawled pages. For example, if you set crawl_results=4 but only 3 pages are successfully crawled, you will be charged 1+3=4 credits instead of 1+4=5 credits."}},{"@type":"Question","name":"What is your refund policy?","acceptedAnswer":{"@type":"Answer","text":"Purchases are non-refundable. You can cancel a subscription at any time from your dashboard — cancelling stops the next billing cycle, but the current period is not refunded. If the service doesn't match what this site describes, email us at sys@search1api.com and we'll issue a refund once we've confirmed it. The 3-day plan is excluded from that exception and is never refunded, including when it doesn't match the site description or your expectations."}}]}</script><section class="search1api-mobile-hero-section overflow-hidden"><div class="container mx-auto px-4 py-16 md:py-24"><div class="astryx-stack x78zum5 xdt5ytf x1p37tyl x1xpicb7 x6s0dn4" data-direction="vertical" data-gap="10"><div class="astryx-stack x78zum5 xdt5ytf x3qlgwd xczp1bk x6s0dn4" data-direction="vertical" data-gap="6"><span class="astryx-badge x3nfvp2 x6s0dn4 xl56j7k xzye2dw x1grt7ep xt970qd xf314gf xjspbzw xjb2p0i x141an7d x1ltkj2j x1e4wzip xuxw1ft x193iq5w xeuugli x1o0wnni x1vvqiwl" data-variant="blue" title="Web access infrastructure for AI agents"><span class="xb3r6kr xlyipyv xeuugli">Web access infrastructure for AI agents</span></span><div class="max-w-3xl text-center"><h1 class="astryx-heading x1tgivj0 x1yego12 xh0iwvy x1y36c3f x1lliihq x2b8uid" data-level="1" data-color="primary" data-type="display-2">Give your AI agents<!-- --> <span class="text-[var(--color-text-accent)]">the live web</span></h1></div><div class="max-w-xl text-center"><p class="astryx-text xv1l7n4 x18juvz8 xf74fhv x149oux8 xt0psk2 x2b8uid" data-type="large" data-color="secondary">One API to search, crawl, and ingest the real-time web. Plug into any agent via API, MCP, CLI, or skills.</p></div><div class="astryx-stack x78zum5 x1q0g3np x1eqhezk x1iu6piu xl56j7k x1a02dak" data-direction="horizontal" data-gap="5" data-wrap="wrap"><div class="astryx-stack x78zum5 x1q0g3np x1thn6ci xhq53yo x6s0dn4" data-direction="horizontal" data-gap="1.5"><span aria-hidden="true" class="astryx-icon x3nfvp2 x6s0dn4 xl56j7k x2lah0s xqwr325 xwqq7k2 xmll18r x1603h9y" data-size="md" data-color="accent"><svg xmlns="http://www.w3.org/2000/svg" width="1em" height="1em" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-check" aria-hidden="true"><path d="M20 6 9 17l-5-5"></path></svg></span><span class="astryx-text x1tgivj0 x18juvz8 xf74fhv x1e4wzip xt0psk2" data-type="large" data-color="primary">From $0.42 / 1K requests</span></div><div class="astryx-stack x78zum5 x1q0g3np x1thn6ci xhq53yo x6s0dn4" data-direction="horizontal" data-gap="1.5"><span aria-hidden="true" class="astryx-icon x3nfvp2 x6s0dn4 xl56j7k x2lah0s xqwr325 xwqq7k2 xmll18r x1603h9y" data-size="md" data-color="accent"><svg xmlns="http://www.w3.org/2000/svg" width="1em" height="1em" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-check" aria-hidden="true"><path d="M20 6 9 17l-5-5"></path></svg></span><span class="astryx-text x1tgivj0 x18juvz8 xf74fhv x1e4wzip xt0psk2" data-type="large" data-color="primary">Top up from $5</span></div></div><div class="astryx-stack x78zum5 x1q0g3np xewh9hi x4olc9o xl56j7k x1a02dak search1api-mobile-button-stack" data-direction="horizontal" data-gap="3" data-wrap="wrap"><span class="search1ap