st for",useCases:"AI answers, live research, monitoring, and RAG workflows that need fresh sources.",cta:"Explore Search API",proofTitle:"From a question to usable results",inputLabel:"Query",input:"“What is new in agent APIs?”",outputLabel:"Returns",outputs:$R[51]=["Results from multiple sources","Titles, links, and snippets","Optional page content and source context"]},$R[52]={title:"Crawl API: turn webpages into AI-ready content",description:"Submit one URL or a batch and get clean content plus structured results, without maintaining scrapers or an HTML cleanup pipeline.",endpoint:"POST /crawl",capabilities:$R[53]=[$R[54]={title:"Remove webpage noise",description:"Strip navigation, ads, and scripts to extract the main content and Markdown."},$R[55]={title:"Keep source context",description:"Return the title, URL, links, and page metadata alongside the content."},$R[56]={title:"Process URLs in batches",description:"Submit one URL or an array of URLs to normalize content from different sites."}],useCasesLabel:"Best for",useCases:"RAG ingestion, content aggregation, and agents that must read a specific page before acting.",cta:"Explore Crawl API",proofTitle:"From a webpage to clean context",inputLabel:"Webpage URL",input:"https://example.com/article",outputLabel:"Returns",outputs:$R[57]=["Clean content and Markdown","Title, URL, and page metadata","Context ready for RAG or agents"]}]},access:$R[58]={titleLead:"Use it from ",titleHighlight:"any agent stack",description:"Bring the same Search and Crawl capabilities into your app, or let agents such as Codex and Claude Code call them directly.",items:$R[59]=[$R[60]={title:"API",description:"Integrate directly through REST."},$R[61]={title:"CLI",description:"Run searches and crawls in your terminal."},$R[62]={title:"Skills",description:"Add live web access to your agent."},$R[63]={title:"MCP",description:"Connect through MCP servers."}]},otherApis:$R[64]={titleLead:"Need more inputs or outputs? ",titleHighlight:"Use the rest of the API suite",description:"Bring recent news, trends, site discovery, screenshots, full-site crawling, and structured extraction into the same workflow.",cta:"Learn more",items:$R[65]=[$R[66]={title:"News API",description:"Fetch recent news with language, time range, source service, and batch query controls."},$R[67]={title:"Screenshot API",description:"Capture a full page, viewport, or page element as PNG, JPEG, or WebP."},$R[68]={title:"Sitemap API",description:"Discover website URLs for crawl queues, SEO analysis, and knowledge-base planning."},$R[69]={title:"Trending API",description:"Fetch popular content from GitHub, Hacker News, and other supported platforms."},$R[70]={title:"DeepCrawl API",description:"Crawl an entire site asynchronously for RAG and knowledge-base corpora."},$R[71]={title:"Extract API",description:"Turn webpages into structured fields with natural-language prompts and JSON Schema."}]},finalCta:$R[72]={title:"Give your agent live web access",offerLine:"{credits} free credits · A Codex Resets exclusive",description:"Use Search, Crawl, and more APIs to retrieve live webpages and clean content through API, MCP, CLI, or Skills."}},freeSearchApi:$R[73]={meta:$R[74]={title:"Free Search API: 100 Free Credits, No Credit Card Required",description:"Free web search API with 100 starter credits. Query Google, Bing, Reddit, GitHub, YouTube & more. No credit card needed. Built for AI agents, RAG, and developers."},breadcrumb:$R[75]={home:"Search1API",current:"Free Search API"},hero:$R[76]={titleAccent:"100 free Search API credits",titleRest:"what they include",description:"Every new account receives a one-time starter balance. Here is how requests spend those 100 credits, which usage costs more, and what happens when the balance reaches zero.",primaryCta:"Claim 100 free credits",secondaryCta:"Read the credit rules",supporting:"No credit card · No expiration · One-time starter grant"},credits:$R[77]={title:"The starter balance at a glance",description:"The 100 credits belong to your account until you use them. They are not a recurring monthly allowance.",starterLabel:"credits granted to each new account",facts:$R[78]=["Granted once when you create an account","Up to 100 successful basic searches","No credit card","No expiration date"],limitsTitle:"How requests use the balance",limits:$R[79]=[$R[80]={title:"Basic Search",description:"A successful basic search costs 1 credit"},$R[81]={title:"Deep Search",description:"1 search credit + 1 per page crawled successfully"},$R[82]={title:"Failed requests",description:"A failed request costs 0 credits"},$R[83]={title:"Standard rate limit",description:"200 requests per minute per API key"}],limitsCta:"See all credits and limits"},examples:$R[84]={titleBeforeHighlight:"How far can ",titleHighlight:"100 credits",titleAfterHighlight:" go?",description:"The total number of requests depends on whether you ask Search1API to crawl full pages.",items:$R[85]=[$R[86]={value:"100",title:"basic searches",description:"A successful search without page crawling costs 1 credit, so the starter balance covers up to 100."},$R[87]={value:"25",title:"Deep Search requests in this example",description:"If each request searches once and successfully crawls 3 pages, it costs 4 credits: 1 + 3."},$R[88]={value:"0",title:"credits for a failed request",description:"Credits are deducted after success. A request that fails is not charged."}],note:"Deep Search charges only for pages that are crawled successfully, so its actual cost can vary by request."},faq:$R[89]={title:"Free Search API questions",items:$R[90]=[$R[91]={question:"Is the Search1API starter balance really free?",answer:"Yes. New accounts receive 100 credits without a credit card, and those starter credits do not expire."},$R[92]={question:"How many searches can I make with 100 credits?",answer:"A basic Search API request costs 1 credit, so the starter balance covers up to 100 basic searches. Deep Search costs 1 credit plus 1 for each page crawled successfully."},$R[93]={question:"Do I receive another 100 credits every month?",answer:"No. The 100-credit starter balance is granted once to each new account. It does not refill monthly."},$R[94]={question:"What happens when I use all 100 credits?",answer:"The API returns 402 Payment Required when the remaining balance cannot cover a successful request. You can top up credits or start a subscription from the dashboard."},$R[95]={question:"Can I use the free credits in production?",answer:"Yes. You can use the starter credits for a real workflow. The standard rate limit is 200 requests per minute per API key, and the 100-credit grant is not a recurring monthly allowance."}]},finalCta:$R[96]={title:"Use the 100 credits when you are ready",description:"Create an account without a credit card. Your starter balance stays available until you use it.",primary:"Claim 100 free credits",secondary:"Explore the Search API"}},header:$R[97]={tools:$R[98]={title:"Free Tools",items:$R[99]={urlToMarkdown:$R[100]={title:"URL to Markdown",description:"Paste a link, get clean Markdown for LLMs and notes"},sitemapExtractor:$R[101]={title:"Sitemap Extractor",description:"List every URL a site publishes in its sitemap"},overview:$R[102]={title:"All free tools",description:"Browser tools built on the same API you can integrate"},jevSearch:$R[103]={title:"Jev Search",description:"Plain-language live web search, open source"}}},home:"Home",proxies:"Proxies",proxyMenu:$R[104]={overview:$R[105]={title:"Proxy overview",description:"Compare Static ISP and Rotating Residential by IP behavior"},static:$R[106]={title:"Static ISP",description:"A fixed carrier-registered IP for stable account access"},rotating:$R[107]={title:"Rotating Residential",description:"A global pool with fresh IPs, geo targeting, and sticky sessions"}},pricing:"Pricing",docs:"Docs",contact:"Contact",signIn:"Sign in",signUp:"Sign up free",logoAlt:"Search1API Logo",logoText:"Search1API",xAlt:"X (Twitter)",discordAlt:"Discord",dashboard:"Dashboard",menuTitle:"Menu",communityTitle:"Community",xLinkText:"X (Twitter)",discordLinkText:"Discord",features:$R[108]={title:"Features",description:"Explore Search1API powerful features",items:$R[109]={search:$R[110]={title:"Search Query",description:"Multi-engine search integration with smart result aggregation"},ask:$R[111]={title:"Agentic Search",description:"More relevant results and fewer wasted tokens, built for agent calls"},news:$R[112]={title:"News Hunt",description:"Real-time news search and aggregation from multiple sources"},crawl:$R[113]={title:"Web Crawler",description:"Intelligent webpage content extraction with anti-crawling handling"},screenshot:$R[114]={title:"Screenshot",description:"Capture full pages, responsive viewports, or a single element as an image"},sitemap:$R[115]={title:"Site Map",description:"Structured sitemap generation and content analysis"},trending:$R[116]={title:"Trending API",description:"Real-time trend analysis and popular content discovery"},deepcrawl:$R[117]={title:"DeepCrawl API",description:"Quickly turn websites into documents with our powerful deep crawling capabilities"},extract:$R[118]={title:"Extract API",description:"Use natural language prompts to extract specific structured data from any webpage"}}},integrations:$R[119]={title:"Integrations",description:"Connect Search1API to the tools you already use",items:$R[120]={overview:$R[121]={title:"All integrations",description:"Every native integration, grouped by agents, frameworks, and workflows"},mcp:$R[122]={title:"MCP server",description:"Hosted endpoint giving any MCP client seven web tools"},skills:$R[123]={title:"Agent Skill and CLI",description:"Teach a terminal agent when to search and when to read a page"},claudeCode:$R[124]={title:"Claude",description:"Connector and plugin with an Agent Skill"},codex:$R[125]={title:"ChatGPT & Codex",description:"One official plugin for live web search in ChatGPT and Codex"},cursor:$R[126]={title:"Cursor",description:"One-click install from the Directory, or mcp.json"},hermes:$R[127]={title:"Hermes",description:"Native plugin: hermes plugins install, then SEARCH1API_KEY"},openclaw:$R[128]={title:"OpenClaw",description:"Native tools via ClawHub: openclaw plugins install"},opencode:$R[129]={title:"OpenCode",description:"Native plugin: opencode plugin opencode-search1api"},langchain:$R[130]={title:"LangChain",description:"Official toolkit exposing search, news, and crawl as tools"},vercel:$R[131]={title:"Vercel",description:"AI SDK tools and runtime access through Vercel Connect"},n8n:$R[132]={title:"n8n",description:"Community node for search, news, page retrieval, and trends"},lobehub:$R[133]={title:"LobeHub",description:"Built-in search provider and crawler for self-hosted LobeHub"},deepseekHarness:$R[134]={title:"DeepSeek Harness",description:"Native dsh-s1 plugin registering web access as dsh tools"},python:$R[135]={title:"Python SDK",description:"Official search1api client with typed errors, retries, and async"},nodejs:$R[136]={title:"Node.js SDK",description:"Official @search1api/client, typed against the public API"}}},resources:$R[137]={title:"Resources",description:"Help you better use Search1API",items:$R[138]={blog:$R[139]={title:"Blog",description:"Read Search1API updates, guides, and ideas"},changelog:$R[140]={title:"Changelog",description:"Learn about latest features and improvements"},opensource:$R[141]={title:"Open Source",description:"Explore Search1API open-source projects"},status:$R[142]={title:"API Status",description:"Real-time API service status monitoring"}}}},components:$R[143]={announcementBanner:$R[144]={text:"Jev Search is live — TypeSafe Jev + Search1API, search the live web in plain language"},sidebar:$R[145]={published:"Published",readingTime:"Reading Time",tags:"Tags",sections:"Sections"}},footer:$R[146]={brandName:"Search1API",description:"Web access infrastructure for AI agents across search, crawling, extraction, and agent interfaces.",nav:$R[147]={compare:$R[148]={title:"Compare",overview:"All comparisons"},sites:$R[149]={title:"Site parsers"},proxy:$R[150]={title:"Proxy",overview:"Proxy overview",staticIsp:"Static ISP Proxy",rotating:"Rotating Residential Proxy"},resources:$R[151]={title:"Resources",about:"About",contact:"Contact",openSource:"Open Source",changelog:"Changelog",pricing:"Pricing",apiDocs:"API Docs"},apis:$R[152]={title:"APIs"},integrations:$R[153]={title:"Integrations"},legal:$R[154]={title:"Legal"}},copyright:"SuperAgents, LLC. All rights reserved.",madeWith:"Made with AI 🤖"},home:$R[155]={meta:$R[156]={title:"Real-Time Web Search & RAG API for AI Agents",description:"Real-time web search, RAG retrieval, crawling, and structured data extraction for AI agents and LLMs. 100 free credits via REST API, MCP server, and CLI."},redesign:$R[157]={hero:$R[158]={eyebrow:"Web access infrastructure for AI agents",headlineLead:"Give your AI agents",headlineHighlight:"the live web",subhead:"One API to search, crawl, and ingest the real-time web. Plug into any agent via API, MCP, CLI, or skills.",ctaPrimary:"Start for free",ctaSecondary:"Onboard your agent",onboardMenu:$R[159]={label:"More ways to connect",copyPrompt:"Copy setup prompt",copyPromptHint:"Paste into Claude Code, Codex, Cursor or any coding agent",api:"API",mcp:"MCP server",skills:"Agent Skills + CLI",integrations:"All integrations"},copied:"Copied",copiedNote:"Prompt copied. Paste it into Claude Code, Codex, Cursor or any coding agent.",trustLine:"No credit card required · 1–2s responses · 99.9% uptime",priceFrom:"From $0.42 / 1K requests",topUp:"Top up from $5",tryLabel:"Try the API",trySubmit:"Open in the Playground",tryModes:$R[160]={search:$R[161]={label:"Search",placeholder:"Search the web, e.g. latest AI funding rounds",examples:$R[162]=["latest AI funding rounds","best open-source vector databases"]},ask:$R[163]={label:"Ask",placeholder:"Ask in plain language, e.g. which MCP servers support OAuth",examples:$R[164]=["Which MCP clients support OAuth?","What's new in React 19?"]},news:$R[165]={label:"News",placeholder:"Search recent news, e.g. OpenAI",examples:$R[166]=["OpenAI","Nvidia earnings"]},crawl:$R[167]={label:"Crawl",placeholder:"https://… any page to clean Markdown",examples:$R[168]=["news.ycombinator.com","github.com/anthropics/claude-code"]},screenshot:$R[169]={label:"Screenshot",placeholder:"https://… capture a full page",examples:$R[170]=["stripe.com","linear.app"]},extract:$R[171]={label:"Extract",placeholder:"https://… pull structured JSON from a page",examples:$R[172]=["stripe.com/pricing","news.ycombinator.com"]},deepcrawl:$R[173]={label:"DeepCrawl",placeholder:"example.com — crawl a whole site to Markdown",examples:$R[174]=["vitejs.dev","docs.astro.build"]},sitemap:$R[175]={label:"Sitemap",placeholder:"example.com — list every URL",examples:$R[176]=["react.dev","docs.python.org"]},trending:$R[177]={label:"Trending",placeholder:"GitHub or Hacker News",examples:$R[178]=["GitHub","Hacker News"]}}},problem:$R[179]={heading:"Giving an agent live web access is harder than it looks",cards:$R[180]=[$R[181]={title:"Frozen in the past",body:"LLMs only know their training cutoff. They can't see today's prices, news, or docs."},$R[182]={title:"Blocked at the door",body:"Roll your own scraper and you hit captchas, rate limits, and IP bans within minutes."},$R[183]={title:"Glue-code sprawl",body:"Stitching search engines, proxies, parsers, and anti-bot together is months of work."}],pivotLead:"Search1API replaces the whole stack with",pivotHighlight:"one API call"},transports:$R[184]={eyebrow:"Connect",heading:"Plug into any agent — your way",subhead:"Choose the way you already use: API, MCP, CLI, or Skills.",worksWith:"View all integrations",cards:$R[185]=[$R[186]={title:"REST API",body:"OpenAPI-typed endpoints. Swap the base URL and key — you are live in minutes."},$R[187]={title:"MCP server",body:"One-click connect to Claude, Cursor, Windsurf, and any MCP-compatible client."},$R[188]={title:"CLI",body:"Search and crawl straight from your terminal or shell scripts."},$R[189]={title:"Agent Skills",body:"Drop-in reusable skills your agents discover and call on their own."}]},agentAccess:$R[190]={eyebrow:"Agent-native access · OAuth 2.1",heading:"Self-service agent access. No complex setup.",subhead:"OAuth-aware agents can register and request access on their own. You only approve the connection in your browser.",ctaDetails:"See the complete OAuth flow",steps:$R[191]=[$R[192]={title:"Agent registers",body:"The agent discovers the authorization server and registers itself."},$R[193]={title:"You approve",body:"The account owner signs in and approves access in the browser."},$R[194]={title:"Secure ongoing access",body:"Access and refresh tokens keep the agent connected securely."}]},proxyPillar:$R[195]={heading:"Choose the IP behavior your workflow needs",subhead:"Keep one carrier identity for account access, or rotate through a global residential pool for automation.",static:$R[196]={badge:"From $1.99 per month",title:"Static ISP",body:"One carrier-registered IP that stays fixed all month.",points:$R[197]=["Stable logins","Shared or dedicated","HTTP and SOCKS5"],cta:"Explore Static ISP"},rotating:$R[198]={badge:"New · From $1.10 per GB",title:"Rotating Residential",body:"Fresh residential IPs with country targeting and optional sticky sessions.",points:$R[199]=["220+ countries and regions","Rotate or keep up to 30 min","Usage-based plans"],cta:"Explore Rotating"}},comparison:$R[200]={eyebrow:"Compare",heading:"One platform where others do one thing",subhead:"Other tools cover a single slice — a search index, or a scraper. Search1API spans rich multi-engine search, site-adapted crawling, and trending topics — and separately offers proxy services on top.",columns:$R[201]={us:"All-in-one web access",exa:"Neural search",firecrawl:"Crawl & scrape",serpapi:"SERP scraping",tavily:"Agent search"},rows:$R[202]=["Rich multi-engine search","Site-adapted content extraction","Trending topics feed","Proxy services"],disclaimer:"Comparison reflects general product positioning as of June 2026 and may change. Product and company names are trademarks of their respective owners.",compareLink:"See all six head-to-head comparisons"}},hero:$R[203]={trustBadges:$R[204]={responseTime:"1-2s Response Time",paidUsers:"2K+ Paid Users",uptime:"99.9% Uptime"},valuePoints:$R[205]=["Search, crawl, and ingest the live web through one API","Use MCP, CLI, and skills to connect agents faster","Fast responses, predictable pricing, and production-ready uptime"],cta:$R[206]={getCredits:"Get 100 Free Credits",noCreditCard:"No Credit Card Required"},supportedServices:$R[207]={title:"Supported Services",google:"Google",bing:"Bing",duckduckgo:"DuckDuckGo",yahoo:"Yahoo",reddit:"Reddit",x:"X",youtube:"YouTube",github:"GitHub",arxiv:"ArXiv",wechat:"WeChat",baidu:"Baidu",bilibili:"Bilibili",imdb:"IMDB",wikipedia:"Wikipedia",comingSoon:"and more"},supportedTools:$R[208]={title:"Core API Capabilities",search:"Search",news:"News",crawl:"Crawl",screenshot:"Screenshot",sitemap:"Sitemap",trending:"Trending",deepcrawl:"DeepCrawl",extract:"Extract"}},features:$R[209]={title:"Core APIs for live web access",description:"Use one integration for search, news, crawl, screenshot, sitemap, trending, extract, and deepcrawl workflows.",tabs:$R[210]={python:"Python",nodejs:"Node.js",curl:"cURL"},tools:$R[211]={search:$R[212]={buttonText:"Search",title:"Multi-Engine Search API",description:"Integrate powerful search capabilities from multiple engines into your AI applications",features:$R[213]=[$R[214]={title:"Multiple Engines",description:"Access Google, Bing, YouTube, GitHub and more through a single endpoint. No need to integrate with each service separately."},$R[215]={title:"Precise Search",description:"Filter by domain, exclude sites, limit by time range, specify language, and more. Get exactly the results your AI needs."},$R[216]={title:"Deep Search",description:"Automatically crawl and return complete content from search results. Get comprehensive information in a single API call."},$R[217]={title:"Batch Processing",description:"Submit multiple search queries simultaneously as an array. Reduce response times and process large volumes efficiently."}]},ask:$R[218]={buttonText:"Agentic Search",title:"Agentic Search API",description:"Agentic search API: a decision model (TypeSafe Jev today) picks the engines and scores every result, dropping off-topic and duplicate results so your agent reads less and spends fewer tokens",features:$R[219]=[$R[220]={title:"AI Intent Detection",description:"The decision model reads the request and picks the keyword query and time window."},$R[221]={title:"Smart Engine Routing",description:"The model scores supported engines, including Google, Reddit, Hacker News, GitHub, arXiv, X, and YouTube, and searches up to five in parallel."},$R[222]={title:"AI Reranking",description:"The model scores every result for relevance. Results below 0.5 are dropped, duplicates are merged, and each result keeps its score."},$R[223]={title:"Flat 5 Credits, Model Included",description:"A completed request costs 5 credits however many engines it searches. If no engine completes, the request is not charged."}]},news:$R[224]={buttonText:"News",title:"News Search API",description:"Get the latest news from multiple engines with our powerful API",features:$R[225]=[$R[226]={title:"Trusted Sources",description:"Access news from reputable media outlets worldwide. Get reliable information from verified publishers for your AI applications."},$R[227]={title:"Time Sensitive",description:"Filter news by time range from last 24 hours to past month. Keep your AI updated with the most recent information."},$R[228]={title:"Rapid Response",description:"Get news results in 1-2 seconds. Ensure your applications deliver timely information without waiting for slow APIs."},$R[229]={title:"Bulk Queries",description:"Submit multiple news requests simultaneously. Efficiently gather information on different topics in a single API call."}]},crawl:$R[230]={buttonText:"Crawl",title:"Web Crawler API",description:"Extract content from any webpage with our intelligent crawler",features:$R[231]=[$R[232]={title:"Speedy Extraction",description:"Get results from simple web pages in about 3 seconds. Quick content retrieval keeps your AI applications responsive."},$R[233]={title:"Structured Content",description:"Receive clean, parsed content in Markdown format. Perfect for AI processing without messy HTML or formatting issues."},$R[234]={title:"Advanced Crawling",description:"Navigate around common access limitations with intelligent crawling rules. Access content from sites that block basic scrapers."},$R[235]={title:"Diverse Documents",description:"Extract content from PDFs and other document formats, not just HTML. Expand your AI's knowledge base to all content types."}]},screenshot:$R[236]={buttonText:"Screenshot",title:"Webpage Screenshot API",description:"Turn public webpages into PNG, JPEG, or WebP images",features:$R[237]=[$R[238]={title:"Full page or one element",description:"Capture the entire document or one visible element with a CSS selector."},$R[239]={title:"Responsive rendering",description:"Set viewport dimensions and a 1–2× device scale factor."},$R[240]={title:"Page readiness controls",description:"Wait for load, network idle, a visible selector, or an additional delay."},$R[241]={title:"Image output controls",description:"Choose PNG, JPEG, or WebP, quality, light or dark color scheme, background, and animation behavior."}]},sitemap:$R[242]={buttonText:"Sitemap",title:"Sitemap API",description:"Extract all URLs from a website with our powerful sitemap generator",features:$R[243]=[$R[244]={title:"Complete Discovery",description:"Detect all related pages and links within a website. Prepare for thorough content extraction with comprehensive site mapping."},$R[245]={title:"Rapid Mapping",description:"Generate site structure maps quickly and efficiently. Save time when planning your content extraction strategy."},$R[246]={title:"Organized Structure",description:"Receive site links in a structured, hierarchical format. Easily understand website organization and content relationships."},$R[247]={title:"Smart Filtering",description:"Automatically filter out irrelevant links and duplicate content. Focus only on valuable, unique pages worth extracting."}]},trending:$R[248]={buttonText:"Trending",title:"Trending Topics API",description:"Get the latest trending topics and stories from popular platforms",features:$R[249]=[$R[250]={title:"Live Trends",description:"Track platform trending lists in real-time. Keep your AI applications updated with what's currently popular and relevant."},$R[251]={title:"Structured Format",description:"Receive trending content in a consistent, structured format. Preserve original details while minimizing integration effort."},$R[252]={title:"Expanding Coverage",description:"Currently supporting GitHub and Hacker News, with more platforms coming soon. Future-proof your application with fresh data."},$R[253]={title:"Trend Analysis",description:"Identify patterns and emerging topics across platforms. Give your AI applications context about what matters right now."}]},deepcrawl:$R[254]={buttonText:"DeepCrawl",title:"Deep Crawl API",description:"Quickly turn websites into documents with our powerful deep crawling capabilities",features:$R[255]=[$R[256]={title:"Quickly Turn Websites into Documents",description:"Simply enter a link to quickly crawl all linked content within a site and save it locally."},$R[257]={title:"Markdown Output",description:"Output in clean Markdown file format, directly usable for LLM knowledge base retrieval."},$R[258]={title:"Asynchronous Processing",description:"Tasks run in the background, and you can check the status at any time."},$R[259]={title:"Recursive Link Following",description:"Freely choose between crawling based on a sitemap or crawling all linked content within the site."}]},extract:$R[260]={buttonText:"Extract",title:"Extract API",description:"Use natural language prompts to extract specific structured data from any webpage",features:$R[261]=[$R[262]={title:"Structured Extraction",description:"Use natural language prompts to extract specific structured data from any webpage."},$R[263]={title:"JSON Schema Output",description:"Define the exact output structure you need using JSON Schema for reliable, consistent results."},$R[264]={title:"LLM-Powered",description:"Leverages large language models to accurately understand content and extract information."},$R[265]={title:"Diverse Use Cases",description:"Ideal for scraping product details, news articles, sports scores, financial data, and more."}]}}},testimonials:$R[266]={title:"Loved by the Community",description:"Hear what our users have to say about their experience.",items:$R[267]=[$R[268]={name:"Arvin Xu",role:"Founder of LobeHub",image:"/images/testimonials/arvin.avif",quote:"I paid for Search1API because it helped me solve the stability problem of search services, which is the customer need for toB products. 20 dollars is not a big deal for us."},$R[269]={name:"Sophie",role:"Developer at an AI Startup",image:"/images/testimonials/sophie.avif",quote:"I think it has the most potential of all the products on the market atm."},$R[270]={name:"Krishna",role:"Developer for an Medical AI Startup",image:"/images/testimonials/krishna.avif",quote:"I had diffculity in crawling the sites and I found Search1API was cheap and powerful. I was able to reachout team for immediate support and I like tech a lot "},$R[271]={name:"Слава Украинцев",role:"Software Engineer",image:"/images/testimonials/slava.avif",quote:"Thank you for your product, it's truly a godsend for my project (and hopefully many future ones)."}]},faq:$R[272]={title:"Frequently Asked Questions",description:"Get quick answers about our APIs and agent interfaces",cta:"Contact us at sys@search1api.com",items:$R[273]=[$R[274]={question:"How quickly will I receive search results?",answer:"Search results are typically delivered within 1-2 seconds. For most queries, you'll get instant responses that you can use in your applications."},$R[275]={question:"Which search engines are supported?",answer:"The Search endpoint covers general web, developer and community, media and reference, and Chinese-language sources, including Google, Bing, GitHub, Reddit, YouTube, and WeChat. Set search_service in the request to pick an engine; see the Search API documentation for the current supported list."},$R[276]={question:"Why does some website crawling fail?",answer:"Website crawling is a complex process, and we cannot guarantee that all websites can be crawled at all times. However, we have adapted to crawl popular websites, including YouTube, Reddits, GitHub, Medium, and WeChat Official Accounts. If you are a corporate user, we can provide customized services to optimize crawling for your frequently used websites, while improving the success rate and presentation of crawled content."},$R[277]={question:"How can I use this product?",answer:"Search1API gives AI agents one web access layer for search, crawl, extract, sitemap, and trending workflows. You can integrate it directly over HTTP or connect through MCP, CLI tooling, and reusable skills in agent environments such as Claude, Cursor, Windsurf, and custom apps."},$R[278]={question:"How can I contact you?",answer:"You can contact us through the official email or join our Discord community."},$R[279]={question:"How can I see the usage of my account?",answer:"You can see the usage of your account by logging in to your account and checking the usage statistics in the dashboard."},$R[280]={question:"Do you store the search results?",answer:"No, we don't store any search results. Each request is processed in real-time and the results are immediately returned to you."},$R[281]={question:"How are credits charged for failed requests?",answer:"Failed requests should not deduct any credits from your account. If you notice any incorrect credit deductions, please contact us at sys@search1api.com for assistance."},$R[282]={question:"How does DeepSearch mode billing work?",answer:"In DeepSearch mode, credits are charged based on the search query (1 credit) plus the number of successfully crawled pages. For example, if you set crawl_results=4 but only 3 pages are successfully crawled, you will be charged 1+3=4 credits instead of 1+4=5 credits."},$R[283]={question:"What is your refund policy?",answer:"Purchases are non-refundable. You can cancel a subscription at any time from your dashboard — cancelling stops the next billing cycle, but the current period is not refunded. If the service doesn't match what this site describes, email us at sys@search1api.com and we'll issue a refund once we've confirmed it. The 3-day plan is excluded from that exception and is never refunded, including when it doesn't match the site description or your expectations."}]},cta:$R[284]={title:"Start with one API. Connect every agent",description:"Get your API key, test the core APIs, then connect through MCP, CLI, or reusable skills.",buttonText:"View pricing",docsButtonText:"Read the docs"},free:$R[285]={title:"Free Plan, Zero Barriers",description:"Sign up for a free API key and get 100 credits. No credit card, no expiration date.",labels:$R[286]={limits:"Limits:",access:"Access:"},tiers:$R[287]=[$R[288]={name:"Free",access:"Free API Key required"}],note:"Need more power? Check out our paid plans below."},opensource:$R[289]={title:"Open Source & Community",description:"We build in the open and actively contribute to the AI ecosystem",featured:$R[290]={featuredLabel:"Featured project",project:$R[291]={name:"Jev Search",description:"Search the live web in plain language. TypeSafe’s Jev chooses sources and ranks results from Search1API — links, snippets, and visible scores. No generated answers."},points:$R[292]=[$R[293]={title:"Plain language",description:"Type a question. Jev picks sources, a time window, and search terms."},$R[294]={title:"No generated answers",description:"Ranked links and snippets with relevance scores, not a written answer."},$R[295]={title:"12 sources",description:"Google, DuckDuckGo, Yandex, plus GitHub, HN, Reddit, X, and more."}],tryLabel:"Try it"},collaboration:$R[296]={featuredLabel:"Featured collaboration",project:$R[297]={name:"LobeHub",description:"🤯 LobeHub is your Chief Agent Operator, organizing your agents into 7×24 operations by hiring, scheduling, and reporting on your entire AI team."},labels:$R[298]={stars:"stars",forks:"forks"},pointsTitle:"Deep collaboration with popular open source LLMs projects",points:$R[299]=[$R[300]={title:"Popular Plugin",description:"Search1API is one of the most popular plugins in the LobeHub ecosystem, enabling powerful web search capabilities"},$R[301]={title:"Auto-Internet Connection",description:"Deep collaboration with LobeHub's auto-internet connection feature, enabling seamless web search capabilities"},$R[302]={title:"AI Provider",description:"Integrated as an AI service provider in the LobeHub platform, enhancing AI capabilities with search"}]},personal:$R[303]={title:"More Open Source Projects",projects:$R[304]=[$R[305]={name:"Siri Ultra",description:"An Apple Shortcut that extends Siri's capabilities with advanced web search and AI assistant features, bringing the power of large language models to your iOS devices."},$R[306]={name:"Search2AI",description:"A lightweight library that connects your LLMs with web search capabilities while maintaining OpenAI API compatibility, making it easy to add search to your existing AI applications."},$R[307]={name:"Search1API-MCP",description:"A Model Context Protocol (MCP) server that brings Search1API's powerful search capabilities to AI models, enabling seamless integration with various LLM platforms."},$R[308]={name:"Search4All",description:"A modern, user-friendly AI search interface with Search1API integration, providing a beautiful frontend for advanced search capabilities."}],card:$R[309]={viewProject:"View Project"},viewMore:"View more projects"}}},proxies:$R[310]={meta:$R[311]={productName:"Static ISP Proxies",title:"Static ISP Proxies — stable carrier IPs",description:"Static ISP IPs registered to real carriers, fixed all month. Monthly or annual billing, optional 0 fraud score matching, and fewer bans and captchas — from $1.99 per month."},hero:$R[312]={eyebrow:"Static ISP Proxies",headlineLead:"IPs that",headlineHighlight:"look consistent",subheadLead:"Static ISP IPs registered to real carriers and fixed all month. Give AI tools, sensitive accounts, and automation a more consistent carrier identity — from",subheadPrice:"$1.99 per month",ctaPrimary:"Get an ISP IP",ctaSecondary:"See plans",card:$R[313]={badge:"Carrier ISP",fixed:"Fixed all month",points:$R[314]=["Real carrier-registered IP","HTTP and SOCKS5 supported","Connect with plain user + password"],zeroScoreLabel:"0 fraud score screening",zeroScoreBody:"Filter for score 0 IPs across Scamalytics, IPQS, IPData, IP2Location, and other reputation providers."}},useCasesSection:$R[315]={heading:"One fixed ISP IP, many jobs"},useCases:$R[316]=[$R[317]={title:"Stay logged in on AI tools",body:"A stable ISP IP gives Claude, ChatGPT, and similar tools a more consistent connection identity."},$R[318]={title:"Steady long-term accounts",body:"Keep one IP for social media and e-commerce accounts that need stable, long-lived logins instead of bouncing through datacenter ranges."},$R[319]={title:"Scrape at scale",body:"Carrier-registered ISP IPs usually look less suspicious than datacenter ranges, so large crawls can run more steadily."},$R[320]={title:"Localized content checks",body:"See the pages, prices, search rankings, and ads a site shows in each country from a local carrier IP."}],included:$R[321]={heading:"What you get",subhead:"No proxy lists to rotate, no whitelists to configure. One stable identity you control.",items:$R[322]=["Real carrier-registered ISP IP, not a datacenter range","Static — the same IP stays with you all month","HTTP and SOCKS5 connection formats supported","Plain user + password auth, no whitelist setup","Optional 0 fraud score matching against independent IP risk providers","Provisioned in minutes, managed from your dashboard"]},plansSection:$R[323]={heading:"Simple proxy pricing",subhead:"Pick shared or dedicated. Pay monthly, or choose annual billing and save two months.",billingLabel:"Billing period",monthly:"Monthly",annual:"Annual",annualSavingsShort:"Save 2 months",perMonth:" per month",perYear:" per year",threeDay:"3 days",perThreeDays:" for 3 days",threeDayCheckoutNote:"The 3-day plan is a one-time payment. It doesn't renew and is non-refundable. You can switch it to monthly and keep the same IP.",featuredBadge:"Most popular",getCta:"Get {name}",checkoutNote:"Secure checkout via Stripe"},plans:$R[324]=[$R[325]={name:"Basic",price:"$1.99",tagline:"A static ISP IP for everyday use.",features:$R[326]=["Shared IP — up to 3 users per IP","80 GB / IP / month bandwidth","User + password access"]},$R[327]={name:"Pro",price:"$3.99",tagline:"Your own IP, with unlimited monthly bandwidth.",features:$R[328]=["Dedicated static ISP IP","Not shared with anyone else","Unlimited monthly bandwidth"]},$R[329]={name:"Premium",price:"$7.99",tagline:"Certified as an ISP line by a professional detection site — safer.",features:$R[330]=["IP2Location-verified ISP line","Dedicated IP, not shared","Unlimited monthly bandwidth"]}],compliance:$R[331]={label:"Please note:",body:"this service must not be used on mainland China networks. If you are unsure about your setup, email us before subscribing."},howismyip:$R[332]={eyebrow:"Open-source IP intelligence",heading:"See why IP checkers disagree",body:"Compare reputation, proxy, ASN, carrier, registry, and location signals across multiple sources. howismyip keeps every provider's result separate instead of combining them into one score.",disclosure:"howismyip is an open-source tool sponsored by Search1API.",cta:"Check an IP on howismyip",newTabLabel:"(opens in a new tab)"},faqSection:$R[333]={heading:"Frequently asked questions"},faq:$R[334]=[$R[335]={q:"What is a static ISP proxy?",a:"It is a fixed IP registered to a real internet service provider and delivered through hosted infrastructure. It is not a consumer home broadband or residential line; it is a stable ISP-registered proxy IP you connect to with a username and password."},$R[336]={q:"Why does a detection site say my static ISP proxy is not an ISP?",a:"Static ISP proxies are hosted in datacenters but use IP ranges registered to real ISP carriers. Because the hosting sits in a datacenter, some detection tools classify the IP as datacenter or hosting rather than ISP — providers simply weigh the signals differently. If you need IPs a third party confirms as an ISP line, our Premium plan ships only IPs independently verified by IP2Location as an ISP line."},$R[337]={q:"What does the Premium plan's \"IP2Location-verified ISP\" mean?",a:"IP2Location is a widely used IP geolocation and intelligence provider that classifies every IP range by usage type. For the Premium plan we ship only IPs whose IP2Location usage type is ISP — a fixed-line ISP network rather than a datacenter. Note: this is IP2Location's classification only. It does not guarantee a 0 fraud score — enable the 0 fraud score option separately if you need that — and it does not mean other detection sites will also classify the IP as an ISP."},$R[338]={q:"Will it stop me from getting banned?",a:"No proxy can guarantee that. Compared with datacenter IPs, a stable ISP IP can reduce some abnormal verification triggers, but results still depend on the target site, account behavior, and how you use it."},$R[339]={q:"Shared vs dedicated — which should I pick?",a:"Shared ($1.99 per month) means each IP can have up to 3 users and includes 80 GB / IP / month. Dedicated ($3.99 per month) gives you an IP assigned only to you, with no co-tenants and unlimited monthly bandwidth."},$R[340]={q:"Which websites and ports may be unavailable?",a:"Because of upstream network compliance rules, some categories of websites may not be reachable through static ISP proxies. Common examples are banking and payments, cryptocurrency exchanges and wallets, and some government websites. Email sending (SMTP / port 25) is not available, and some uncommon ports may also be restricted. The exact scope depends on the IP line you are assigned, and we cannot guarantee that every IP can reach every website. If your work depends on a specific website, ask us through the Help page in the dashboard before you buy. Proxies must not be used for spam, fraud, phishing, attacks, or other illegal or abusive activity. Violations lead to suspension without a refund."},$R[341]={q:"Does “unlimited monthly bandwidth” have any limits?",a:"Pro and Premium are not billed by traffic, and normal use has no monthly traffic cap. To keep lines stable for everyone, upstream networks apply fair-use rules to each IP. Once an IP passes about 100 GB in a month, it may be throttled until the end of the billing period. Keep concurrent connections per IP under 90; above 100, new connections may be rejected. For heavy workloads, reuse connections (keep-alive) or spread requests across multiple IPs. Basic (shared) still includes 80 GB per IP per month."},$R[342]={q:"Can I replace an IP that has problems?",a:"Yes. Each order includes one free IP replacement while it is active. If the order has several IPs, you can replace all the affected ones in that single request. Submit the request from the Help page in the dashboard, choose “Proxies” as the topic, list the order and the IPs to replace, and give a concrete reason. For example, the IP cannot reach your target website, its fraud score is clearly abnormal at the scoring provider you selected, or the target website has blocked it. After we verify the issue, we replace it with a new IP of the same tier, and the old IP stops working. Requests without a specific problem, such as simply wanting a different IP, are not accepted."},$R[343]={q:"What is a 0 fraud score IP?",a:"A fraud (or risk) score rates how abusive an IP looks to a given reputation provider — 0 means clean. Each provider scores independently, so the same IP can be 0 with one and high with another. When you enable this option we match an IP that currently scores 0 with the provider you choose. We can only guarantee score 0 for the provider you select — other detection sites may still score it differently."},$R[344]={q:"Do you support SOCKS5?",a:"Yes. Proxy connections support both HTTP and SOCKS5 formats, so you can use the protocol your browser, scraper, or automation tool expects."},$R[345]={q:"How does annual billing work?",a:"Annual billing charges 10 months upfront for a 12-month subscription, so you save two months compared with paying monthly. The same 30% 0-score fee applies if you choose that option."},$R[346]={q:"Can I use it inside mainland China?",a:"No. This service must not be used on mainland China networks. If you are unsure about your setup, email us before subscribing."}],finalCta:$R[347]={heading:"Get a static ISP IP in minutes",subhead:"From $1.99 per month. Cancel anytime.",cta:"Get started"}},proxyHub:$R[348]={meta:$R[349]={title:"Proxy API: Static ISP & Rotating Residential Proxies",description:"Proxy API for web scraping and automation. Choose fixed Static ISP IPs or a global rotating residential pool with geo targeting and sticky sessions."},hero:$R[350]={headlineLead:"The right IP behavior for",headlineHighlight:"every workflow",subhead:"Use one fixed ISP-registered IP for accounts and long-lived sessions, or rotate through a global residential pool for automation and location-specific access."},products:$R[351]={static:$R[352]={badge:"From $1.99 per month",title:"Static ISP",body:"A carrier-registered IP that stays fixed all month. Best when a website expects your connection identity to remain consistent.",points:$R[353]=["Shared or dedicated IP","Monthly or annual billing","HTTP and SOCKS5"],cta:"Explore Static ISP"},rotating:$R[354]={badge:"New · From $1.10 per GB",title:"Rotating Residential",body:"A global pool of residential IPs that can rotate on every request or remain sticky for a short task.",points:$R[355]=["220+ countries and regions","Sticky sessions up to 30 minutes","Pay by monthly bandwidth"],cta:"Explore Rotating Residential"}},compare:$R[356]={heading:"Static or rotating? Start with the job",subhead:"The two products solve different identity problems. Choose the connection behavior before choosing a plan.",columns:$R[357]={need:"What you need",static:"Static ISP",rotating:"Rotating Residential"},rows:$R[358]=[$R[359]={need:"IP behavior",static:"One fixed IP",rotating:"Fresh IP or short sticky session"},$R[360]={need:"Best for",static:"Logins, accounts, long sessions",rotating:"Scraping, testing, geo-targeted tasks"},$R[361]={need:"Billing",static:"Per IP",rotating:"Per GB"},$R[362]={need:"Location",static:"Selected when purchased",rotating:"Selected when credentials are generated"}]},jobs:$R[363]={heading:"Choose by workflow",items:$R[364]=[$R[365]={title:"Need one identity?",body:"Choose Static ISP for account access, long sessions, and tools that react badly to changing IPs."},$R[366]={title:"Need many locations?",body:"Choose Rotating Residential to target countries and regions from one global gateway."},$R[367]={title:"Need both?",body:"Use Static ISP for persistent accounts and Rotating Residential for data collection or temporary regional tasks."}]},faqHeading:"Frequently asked questions",faq:$R[368]=[$R[369]={q:"What is the main difference between Static ISP and Rotating Residential?",a:"Static ISP gives you one IP that remains fixed for the subscription period. Rotating Residential draws from a shared global pool and can use a fresh IP per request or hold one temporarily with a sticky session."},$R[370]={q:"Can I use both products in one account?",a:"Yes. They are separate subscriptions inside the same Search1API dashboard, so you can assign each workflow the connection type it needs."},$R[371]={q:"Do both products support HTTP and SOCKS5?",a:"Yes. Both product lines provide HTTP and SOCKS5 connection formats."}],finalCta:$R[372]={heading:"Choose the right proxy for every task",subhead:"Compare plans in the dashboard and start with the connection behavior your workflow needs.",cta:"View proxy plans"}},rotatingProxies:$R[373]={meta:$R[374]={productName:"Rotating Residential Proxies",title:"Rotating Residential Proxy API: IP Rotation, Geo Targeting & Sticky Sessions",description:"Rotating residential proxy API with automatic IP rotation from 220+ countries. Sticky sessions up to 30 min, HTTP/SOCKS5 support, zero IP bans for web scraping."},hero:$R[375]={eyebrow:"Rotating Residential Proxies",headlineLead:"Residential IPs that move with",headlineHighlight:"your workflow",subheadLead:"Rotate on every request, target a location, or keep one IP for up to 30 minutes. Residential traffic from",subheadPrice:"$1.10 per GB",ctaPrimary:"Get rotating proxies",ctaSecondary:"See plans",metrics:$R[376]={priceLabel:"Lowest unit price",priceUnit:" per GB",locationsLabel:"Countries and regions",locationsValue:"220+",stickyLabel:"Maximum sticky session",stickyValue:"30 minutes"},card:$R[377]={title:"Credential setup",badge:"Ready",fields:$R[378]=[$R[379]={label:"Country",value:"United States"},$R[380]={label:"Session",value:"Sticky"},$R[381]={label:"Keep for",value:"30 min"},$R[382]={label:"Protocol",value:"SOCKS5"}],points:$R[383]=["Copy-ready credentials","Change options without an API call","Usage metered in your dashboard"]}},useCasesHeading:"A residential pool for temporary, distributed work",useCases:$R[384]=[$R[385]={title:"Scrape resistant sites",body:"Spread requests across residential IPs instead of repeatedly presenting one address."},$R[386]={title:"Test regional experiences",body:"Choose a country or available region when you generate credentials."},$R[387]={title:"Run concurrent automation",body:"Create separate sticky sessions for short workflows that need a consistent IP."},$R[388]={title:"Protect your primary IP",body:"Keep automated traffic separate from your office or home connection."}],howItWorks:$R[389]={eyebrow:"How it works",heading:"One gateway, credentials shaped for the task",subhead:"The dashboard builds the connection string locally from the options you choose. You can copy it directly into your browser, script, or proxy client.",steps:$R[390]=[$R[391]={title:"Choose a location",body:"Use the global pool or select an available country and region."},$R[392]={title:"Choose rotation behavior",body:"Get a fresh IP per request or create a sticky session."},$R[393]={title:"Set a short session lifetime",body:"Sticky sessions can remain on one IP for up to 30 minutes. For longer fixed identity, use Static ISP."}]},plans:$R[394]={heading:"Pay for the bandwidth you need",subhead:"Every plan includes the same global pool, location targeting, sticky sessions, and HTTP or SOCKS5 access.",popular:"Most popular",perMonth:"per month",features:$R[395]=["Global residential pool","Country and region targeting","Sticky sessions up to 30 minutes"],cta:"Choose {size}"},faqHeading:"Frequently asked questions",faq:$R[396]=[$R[397]={q:"What is a rotating residential proxy?",a:"It routes traffic through a shared pool of residential IPs. The gateway can provide a fresh IP for each request or keep one temporarily for a sticky session."},$R[398]={q:"Why can sticky sessions last only 30 minutes?",a:"Rotating residential pools are designed for temporary tasks, not permanent identity. A 30-minute limit balances short workflow consistency with pool availability. Choose Static ISP if you need the same IP for days or months."},$R[399]={q:"How do country and region targeting work?",a:"Choose an available location in the dashboard. The selected values are added to the generated credentials, so the upstream pool knows which exit location to use."},$R[400]={q:"Does selecting a sticky session change my password?",a:"The dashboard appends location, session, and lifetime parameters to the credential string. Your base secret remains the same; the longer password-like value carries the session instructions."},$R[401]={q:"Do I need to call an API to generate credentials?",a:"No. The dashboard assembles the connection string locally from your selections. Copy it and connect directly through the provided gateway."},$R[402]={q:"How is bandwidth measured?",a:"Traffic is metered by Search1API's relay and shown against the monthly allowance in your dashboard."}],finalCta:$R[403]={heading:"Start with a fresh residential IP",subhead:"Choose a monthly bandwidth plan, then configure location and session behavior whenever you copy credentials.",cta:"Get started"}},blog:$R[404]={meta:$R[405]={title:"Blog",description:"Thoughts, ideas, and opinions."},post:$R[406]={backLink:"Go back",readingTimeSuffix:"min read"}},pricing:$R[407]={meta:$R[408]={title:"Pricing for AI Agent Web Access",description:"Compare Search1API plans for web search, crawling, extraction, and agent integrations."},header:$R[409]={title:"Pricing for production-ready agent access",description:"Use one plan for the core APIs, then connect through MCP, CLI, and skills as your usage grows.",priceSummary:"Top up from {topupStartingPrice}, or subscribe from {startingPrice}/month. The lowest effective rate is approximately {lowestRate} per 1,000 one-credit requests on the annual {plan} plan; higher-credit APIs and Deep Search cost more."},home:$R[410]={title:"Start free. Pay your way.",description:"Top up when you need to, or subscribe for regular usage.",freePrompt:"Try it first:",noCreditCard:"No credit card required.",topup:$R[411]={description:"For experiments and usage that changes from month to month.",billing:"One-time payment",credits:"{amount} gets you {credits} credits",benefits:$R[412]=["No subscription required","Credits never expire"],cta:"Start with {amount}",amountLabel:"Top up · earn bonus credits",bonus:"+{percent}%",noBonus:"No bonus"},subscription:$R[413]={title:"Subscription",description:"For apps with steady, ongoing usage.",benefits:$R[414]=["Credits refresh every month","Cancel renewal anytime"],monthlyCta:"View {plan} monthly",yearlyCta:"View {plan} annually",tierLabel:"Choose a plan",tiers:$R[415]={basic:"Basic",pro:"Pro",enterprise:"Enterprise"}},perThousand:"/ 1,000 requests"},tabs:$R[416]={free:"Free",subscription:"Subscription",onetime:"Top up"},subscription:$R[417]={title:"Subscription plans",description:"For ongoing usage, with a fresh credit allowance every month."},topup:$R[418]={title:"Pay as you go",sectionDescription:"For occasional or variable usage. Buy credits when you need them, and keep them until you use them.",description:"Choose any amount from $5 to $2,000. Bigger purchases earn a bonus on the whole amount.",amountLabel:"Choose an amount",receiveLabel:"You receive",chooseAmount:"Choose an amount to continue",continueWith:"Continue with {amount}",viewPricing:"View pay-as-you-go pricing",bonusBadge:"+{percent}% bonus",breakdown:"{base} base + {bonus} bonus",baseOnly:"{base} base credits",neverExpires:"Credits never expire",cta:"Top up",custom:$R[419]={title:"Custom amount",range:"Enter any amount from {min} to {max}",invalid:"Enter an amount between {min} and {max}",placeholder:"Enter amount in USD",rate:"$1 = {credits} credits, plus tier bonuses"},creditWorth:"1 credit = one basic search, news, or crawl request"},billingToggle:$R[420]={label:"Subscription billing period",monthly:"Monthly",yearly:"Annual",discount:"Save 2 months"},billingPeriod:$R[421]={monthly:"/ month",billedAnnually:"(Billed annually)",billedAnnuallyAmount:"{price} billed annually",billedMonthly:"Bille