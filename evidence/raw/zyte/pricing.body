null},\"features_list\":{\"id\":\"f_01kBD2E8H0eErW54q3vC2ZSh7h\",\"list\":[{\"sort\":0,\"text\":\"Large downloads::Download files up to 100MB with automatic retry and resume capabilities\"},{\"sort\":1,\"text\":\"Actions::Automate complex user interactions like clicks, form fills, and navigation\"},{\"sort\":2,\"text\":\"Low latency::Sub-100ms response times with global edge network optimization\"},{\"sort\":3,\"text\":\"Monthly report::Detailed analytics and usage insights delivered to your inbox\"},{\"sort\":4,\"text\":\"IP Rotation (all types)::Residential, datacenter, and mobile IPs with automatic rotation\"},{\"sort\":5,\"text\":\"Captcha::Automatic solving of reCAPTCHA, hCaptcha, and other challenge types\"},{\"sort\":6,\"text\":\"Session management::Maintain user sessions across requests with cookie persistence\"},{\"sort\":7,\"text\":\"JS rendering::Full JavaScript execution with headless browser automation\"},{\"sort\":8,\"text\":\"Instant Browsers::Pre-warmed browser instances for zero-cold-start performance\"},{\"sort\":9,\"text\":\"Geo Locations::Target specific countries and regions with location-based requests\"},{\"sort\":10,\"text\":\"Additional costs for some features::Some advanced features may incur additional usage-based costs. See the project cost calculator or API playground to explore pricing in depth.\"}],\"name\":\"features_list\",\"type\":\"list\",\"handle\":\"features_list\",\"help_text\":\"Enter a \\\"title::description\\\" list for the features.\"},\"features_title\":{\"id\":\"f_01KbD28zcCbeQ55S6fk4R8DKFY\",\"name\":\"features_title\",\"text\":\"Powerful Features\",\"type\":\"text\",\"handle\":\"features_title\",\"help_text\":null},\"features_subtitle\":{\"id\":\"f_01KBd2990q2A60PyHN71R3Ac94\",\"name\":\"features_subtitle\",\"text\":\"Every subscription level includes our full suite of advanced features. No feature restrictions, no hidden limitations.\",\"type\":\"text\",\"handle\":\"features_subtitle\",\"help_text\":null},\"trial_descri