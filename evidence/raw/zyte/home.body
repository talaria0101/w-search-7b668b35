ion-colors cursor-pointer focus-visible:outline-none py-1.5 text-base px-0 text-accent no-underline focus-visible:ring-2 focus-visible:ring-accent" href="/mcp/"><span class="relative after:absolute after:bottom-[-2px] after:left-0 after:h-px after:w-0 after:bg-current after:transition-[width] after:duration-300 after:ease-out group-hover:after:w-full">Explore MCP</span><span class="inline-flex translate-y-[2px] items-center transition-transform duration-300 ease-out group-hover:translate-x-[3px]"><svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-arrow-right" aria-hidden="true"><path d="M5 12h14"></path><path d="m12 5 7 7-7 7"></path></svg></span></a></div></div></section><section class="core-card !my-0 flex flex-col overflow-hidden rounded-2xl border border-ui-border bg-white" style="opacity:0;transform:translateY(44px)"><div class="flex flex-1 flex-col p-7"><div class="mb-4"><span class="flex items-center justify-center rounded-xl bg-web-primary-50 text-web-primary-500 size-10 rounded-lg"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-code-xml lucide-code-2 size-5" aria-hidden="true"><path d="m18 16 4-4-4-4"></path><path d="m6 8-4 4 4 4"></path><path d="m14.5 4-5 16"></path></svg></span></div><div class="flex flex-wrap items-baseline gap-x-2.5 gap-y-1"><span class="text-sm font-semibold uppercase tracking-widest text-web-primary-500">Scrapy</span><span class="text-[15px] font-medium text-text-300">Open source framework</span></div><h3 class="mt-2 flex-1 text-balance text-xl font-semibold leading-snug tracking-tight text-web-secondary-500">Build crawlers on the framework we maintain.</h3><div class="mt-7"><a class="group inline-flex items-center justify-center gap-2 font-semibold transition-colors cursor-pointer focus-visible:outline-none py-1.5 text-base px-0 text-accent no-underline focus-visible:ring-2 focus-visible:ring-accent" target="_blank" rel="noopener noreferrer" href="https://www.scrapy.org/"><span class="relative after:absolute after:bottom-[-2px] after:left-0 after:h-px after:w-0 after:bg-current after:transition-[width] after:duration-300 after:ease-out group-hover:after:w-full">Explore Scrapy</span><span class="inline-flex translate-y-[2px] items-center transition-transform duration-300 ease-out group-hover:translate-x-[3px]"><svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-arrow-right" aria-hidden="true"><path d="M5 12h14"></path><path d="m12 5 7 7-7 7"></path></svg></span></a></div></div></section></div></div></section><section class="w-full overflow-x-clip"><div class="relative max-w-6xl lg:max-w-7xl mx-auto px-4"><p class="text-sm font-semibold uppercase tracking-widest mb-6 text-brandAccentSecondaryCold-500">Data types</p><h2 class="flex flex-wrap items-center gap-x-3 gap-y-2 text-heading-md lg:text-heading-mdp font-semibold leading-[1.35] tracking-[-1.5px] text-brandAccentPrimary-500"><span class="leading-none --translatey-0.5">I want</span><div class="relative inline-flex items-center"><button type="button" aria-haspopup="listbox" aria-expanded="false" class="font-semibold inline-flex items-center gap-2 rounded-2xl border-2 border-brandAccentSecondaryCold-500/40 px-4 pt-1 pb-2 text-brandAccentSecondaryCold-500 transition-colors hover:bg-brandAccentSecondaryCold-500/[0.06]">E-commerce<span class="md:hidden">data</span><svg xmlns="http://www.w3.org/2000/svg" width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-chevron-down transition-transform duration-200 translate-y-1" aria-hidden="true"><path d="m6 9 6 6 6-6"></path></svg></button></div><span class="hidden md:block leading-none -translate-y-0.5">data</span></h2><div class="mt-14 grid grid-cols-1 gap-12 lg:gap-20 items-center lg:grid-cols-2"><div><p class="text-intro leading-[1.6] mb-8 text-pretty text-text-400">Product listings, prices, reviews, and inventory data from the retail websites that matter to you.</p><ul class="flex flex-col gap-5 mb-9"><li class="flex items-start gap-3.5"><span class="flex items-center justify-center w-8 h-8 rounded-lg bg-[#F5DEFA] shrink-0 mt-1"><svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-check text-brandAccentSecondaryCold-500" aria-hidden="true"><path d="M20 6 9 17l-5-5"></path></svg></span><p class="text-body leading-[1.55] text-balance text-text-400"><span class="font-semibold text-brandAccentPrimary-500">Price monitoring<!-- -->.</span> <!-- -->Track competitor pricing in real time across the retailers you track.</p></li><li class="flex items-start gap-3.5"><span class="flex items-center justify-center w-8 h-8 rounded-lg bg-[#F5DEFA] shrink-0 mt-1"><svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-check text-brandAccentSecondaryCold-500" aria-hidden="true"><path d="M20 6 9 17l-5-5"></path></svg></span><p class="text-body leading-[1.55] text-balance text-text-400"><span class="font-semibold text-brandAccentPrimary-500">Product catalog enrichment<!-- -->.</span> <!-- -->Augment your catalog with market data and structured attributes.</p></li><li class="flex items-start gap-3.5"><span class="flex items-center justify-center w-8 h-8 rounded-lg bg-[#F5DEFA] shrink-0 mt-1"><svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-check text-brandAccentSecondaryCold-500" aria-hidden="true"><path d="M20 6 9 17l-5-5"></path></svg></span><p class="text-body leading-[1.55] text-balance text-text-400"><span class="font-semibold text-brandAccentPrimary-500">Inventory intelligence<!-- -->.</span> <!-- -->Monitor stock levels and availability at scale.</p></li></ul><div class="flex flex-wrap items-center gap-x-6 gap-y-3"><a class="group inline-flex items-center justify-center gap-2 font-semibold transition-colors cursor-pointer focus-visible:outline-none py-1.5 text-base px-0 no-underline focus-visible:ring-2 focus-visible:ring-accent text-brandAccentSecondaryCold-500" href="/data-types/product-scraper/"><span class="relative after:absolute after:bottom-[-2px] after:left-0 after:h-px after:w-0 after:bg-current after:transition-[width] after:duration-300 after:ease-out group-hover:after:w-full">Explore <!-- -->e-commerce<!-- --> data</span><span class="inline-flex translate-y-[2px] items-center transition-transform duration-300 ease-out group-hover:translate-x-[3px]"><svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-arrow-right" aria-hidden="true"><path d="M5 12h14"></path><path d="m12 5 7 7-7 7"></path></svg></span></a></div><p class="mt-8 text-sm leading-relaxed text-pretty text-text-300">Don&#x27;t see your data type?<!-- --> <button type="button" class="font-semibold text-brandAccentSecondaryCold-500 no-underline hover:underline">Talk to us</button></p></div><div><div class="relative"><div aria-hidden="true" class="pointer-events-none absolute -inset-8 blur-3xl opacity-30" style="background:radial-gradient(circle at 60% 40%, rgba(176,44,206,0.28) 0%, rgba(176,44,206,0) 65%)"></div><div class="relative