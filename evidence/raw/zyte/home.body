    auth=(os.environ[&quot;ZYTE_API_KEY&quot;], &quot;&quot;),
    json={
        &quot;url&quot;: &quot;https://example.com/product/laptop-x1&quot;,
        &quot;httpResponseBody&quot;: True,
        &quot;product&quot;: True,
    },
)
data = resp.json()</code></pre></div><div class="flex flex-col min-w-0"><div class="flex items-center justify-between border-b border-white/10 px-5 py-3 shrink-0"><span class="text-xs font-semibold uppercase tracking-widest text-white/45">Response</span><span class="inline-flex items-center gap-1.5 text-xs text-success-500" style="font-family:&quot;Geist Mono&quot;, &quot;JetBrains Mono&quot;, &quot;Menlo&quot;, ui-monospace, monospace"><span class="w-1.5 h-1.5 rounded-full bg-success-500"></span>200 OK</span></div><div class="relative border-b border-white/10 shrink-0"><div role="tablist" class="flex flex-nowrap items-center gap-0.5 overflow-x-auto px-3 py-3 [scrollbar-width:none] [-ms-overflow-style:none] [&amp;::-webkit-scrollbar]:hidden"><button type="button" role="tab" aria-selected="true" tabindex="0" class="shrink-0 whitespace-nowrap rounded-md px-2.5 py-1.5 text-xs font-semibold transition-colors bg-black/30 text-white">JSON</button><button type="button" role="tab" aria-selected="false" tabindex="-1" class="shrink-0 whitespace-nowrap rounded-md px-2.5 py-1.5 text-xs font-semibold transition-colors text-white/55 hover:text-white">Raw HTML</button></div></div><pre class="flex-1 min-h-[280px] overflow-x-auto px-5 py-5 text-xs leading-loose text-white/90 whitespace-pre" style="font-family:&quot;Geist Mono&quot;, &quot;JetBrains Mono&quot;, &quot;Menlo&quot;, ui-monospace, monospace"><code>{
