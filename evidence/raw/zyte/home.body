rce\",\"Python\",\"Crawling framework\",\"Zyte API built in\",\"Extensible\"],\"description\":\"The most-used open-source web scraping framework, maintained by the team you're buying from. Build your way, with Zyte API built in when you need access handled.\",\"ctaPrimary\":{\"label\":\"View on GitHub\",\"href\":\"https://github.com/scrapy/scrapy\"},\"ctaSecondary\":{\"label\":\"Explore Scrapy\",\"href\":\"https://www.scrapy.org/\"},\"bg\":\"#EAF7EF\",\"bar\":\"#16A34A\"},{\"id\":\"scrapyCloud\",\"product\":\"Scrapy Cloud\",\"tagline\":\"Scalable cloud hosting\",\"heading\":\"Run and scale crawlers without owning servers.\",\"tags\":[\"Hosting\",\"Scheduling\",\"Monitoring\",\"Autoscaling\",\"Storage\"],\"description\":\"Hosting, scheduling, monitoring and scaling for your spiders. Deploy and watch every crawl in one place, with no infrastructure to manage and no servers to own.\",\"ctaPrimary\":{\"label\":\"Get started with Scrapy Cloud\",\"href\":\"https://app.zyte.com/account/signup/scrapycloud\"},\"ctaSecondary\":{\"label\":\"Explore Scrapy Cloud\",\"href\":\"/scrapy-cloud/\"},\"bg\":\"#E9F1FB\",\"bar\":\"#2563EB\"},{\"id\":\"agenticWebData\",\"product\":\"MCP Server\",\"tagline\":\"Zyte for any MCP client\",\"heading\":\"All of Zyte, inside your agent.\",\"tags\":[\"Any MCP client\",\"Fetch\",\"Extract\",\"Search\",\"Scrapy Cloud jobs\"],\"description\":\"Connect Claude Code, Codex, Copilot, VS Code or any MCP client to Zyte. Your agent fetches, extracts and searches the web, and runs Scrapy Cloud jobs.\",\"ctaPrimary\":{\"label\":\"Get started with MCP\",\"href\":\"/mcp/\"},\"ctaSecondary\":{\"label\":\"Explore MCP\",\"href\":\"/mcp/\"},\"bg\":\"#FCEFE3\",\"bar\":\"#EA580C\"},{\"id\":\"zyteData\",\"product\":\"Zyte Data\",\"tagline\":\"Managed web data service\",\"heading\":\"Hand it over. Get clean data delivered.\",\"tags\":[\"One accountable team\",\"Custom schema\",\"Validation\",\"Scheduled delivery\",\"SLA\"],\"description\":\"A managed web data service. Our team builds, runs and maintains the collection, delivering deduplicated, schema-ready data to your warehouse on the cadence you set. Nothing to build, nothing to maintain.\",\"ctaPrimary\":{\"label\":\"Talk to us\",\"modal\":\"hubSpotDataFeeds\"},\"ctaSecondary\":{\"label\":\"Explore Zyte Data\",\"href\":\"/data-extraction/\"},\"bg\":\"#F3EAFB\",\"bar\":\"#9333EA\"}]}]}]\n55:[\"$\",\"$L74\",null,{\"eyebrow\":\"Data types\",\"footnote\":{\"text\":\"Don't see your data type?\",\"link\":{\"label\":\"Talk to us\",\"modal\":\"hubSpotDataFeeds\"}},\"dataTypes\":[{\"id\":\"ecommerce\",\"label\":\"E-commerce\",\"description\":\"Product listings, prices, reviews, and inventory data from the retail websites that matter to you.\",\"href\":\"/data-types/product-scraper/\",\"useCases\":[{\"title\":\"Price monitoring\",\"body\":\"Track competitor pricing in real time across the retailers you track.\"},{\"title\":\"Product catalog enrichment\",\"body\":\"Augment your catalog with market data and structured attributes.\"},{\"title\":\"Inventory intelligence\",\"body\":\"Monitor stock levels and availability at scale.\"}],\"mock\":{\"url\":\"https://www.example.com/dp/B0851THH7N\",\"archetype\":\"product\",\"title\":\"WH-500 Wireless Headphones\",\"subtitle\":\"Over-Ear · Noise Cancelling\",\"callouts\":[{\"label\":\"Price\",\"value\":\"$$279.99\"},{\"label\":\"Rating\",\"value\":\"4.4 / 5\"},{\"label\":\"Reviews\",\"value\":\"41,823\"}]}},{\"id\":\"ai\",\"label\":\"AI training\",\"description\":\"Clean, structured web content for training and fine-tuning language models.\",\"href\":\"/data-types/web-data-for-ai/\",\"useCases\":[{\"title\":\"LLM pre-training\",\"body\":\"High-volume, deduplicated web text for foundation models.\"},{\"title\":\"Domain-specific fine-tuning\",\"body\":\"Curated data from niche websites to specialise your model.\"},{\"title\":\"RLHF datasets\",\"body\":\"Structured Q\u0026A and preference data extracted from forums and review websites.\"}],\"mock\":{\"url\":\"https://forum.example.com/item?id=40983213\",\"archetype\":\"article\",\"title\":\"Crawl the web with 1 API call\",\"subtitle\":\"Tech forum · 2,400 points · 312 comments\",\"callouts\":[{\"label\":\"Tokens\",\"value\":\"~1,200\"},{\"label\":\"Language\",\"value\":\"English\"},{\"label\":\"Quality\",\"value\":\"High\"}]}},{\"id\":\"jobs\",\"label\":\"Job listings\",\"description\":\"Job postings and labour market signals from thousands of sources.\",\"href\":\"/data-types/job-scraper/\",\"useCases\":[{\"title\":\"Talent market intelligence\",\"body\":\"Monitor hiring trends by skill, location, and company.\"},{\"title\":\"Compensation benchmarking\",\"body\":\"Aggregate salary data across industries and roles.\"},{\"title\":\"Workforce analytics\",\"body\":\"Detect headcount changes before they hit the news.\"}],\"mock\":{\"url\":\"https://www.example.com/jobs/view/3234567890\",\"archetype\":\"listing\",\"title\":\"Senior Data Engineer\",\"subtitle\":\"Example Corp · San Francisco, CA · Remote OK\",\"callouts\":[{\"label\":\"Salary\",\"value\":\"$$180-220k\"},{\"label\":\"Posted\",\"value\":\"2 days ago\"},{\"label\":\"Applicants\",\"value\":\"312\"}]}},{\"id\":\"realestate\",\"label\":\"Real estate\",\"description\":\"Property listings, valuations, and transaction data from major portals.\",\"href\":\"/data-types/real-estate-scraper/\",\"useCases\":[{\"title\":\"AVM enrichment\",\"body\":\"Feed automated valuation models with fresh listing data.\"},{\"title\":\"Market trend analysis\",\"body\":\"Track prices, days-on-market, and inventory by area.\"},{\"title\":\"Lead generation\",\"body\":\"Identify new listings and ownership changes in real time.\"}],\"mock\":{\"url\":\"https://www.example.com/homedetails/12345\",\"archetype\":\"product\",\"title\":\"3BR / 2BA in Austin\",\"subtitle\":\"2,150 sq ft · Listed 4 days ago\",\"callouts\":[{\"label\":\"Price\",\"value\":\"$$685,000\"},{\"label\":\"Price/sqft\",\"value\":\"$$319\"},{\"label\":\"Days on market\",\"value\":\"4\"}]}},{\"id\":\"news\",\"label\":\"News \u0026 articles\",\"description\":\"Full-text articles, metadata, and authorship data from thousands of publishers.\",\"href\":\"/data-types/news-articles-scraper/\",\"useCases\":[{\"title\":\"Media monitoring\",\"body\":\"Track brand and competitor mentions as they appear.\"},{\"title\":\"Sentiment analysis\",\"body\":\"Measure public sentiment from real editorial content.\"},{\"title\":\"Financial signals\",\"body\":\"Feed event-driven trading models with fresh news.\"}],\"mock\":{\"url\":\"https://news.example.com/content/abc123\",\"archetype\":\"article\",\"title\":\"Central banks signal pivot as inflation eases\",\"subtitle\":\"Example News · Markets\",\"callouts\":[{\"label\":\"Published\",\"value\":\"Jun 28, 2026\"},{\"label\":\"Author\",\"value\":\"Sarah White\"},{\"label\":\"Read time\",\"value\":\"5 min\"}]}},{\"id\":\"serp\",\"label\":\"SERP\",\"description\":\"Search engine results pages: rankings, ads, features, and structured snippets.\",\"href\":\"/data-types/search-engine-scraper/\",\"useCases\":[{\"title\":\"SEO rank tracking\",\"body\":\"Monitor your positions across thousands of keywords daily.\"},{\"title\":\"PPC competitive intelligence\",\"body\":\"Analyse competitor ads and landing page strategies.\"},{\"title\":\"SERP feature monitoring\",\"body\":\"Track featured snippets, knowledge panels, and local packs.\"}],\"mock\":{\"url\":\"https://www.example.com/search?q=best+web+scraping+api\",\"archetype\":\"feed\",\"title\":\"best web scraping api\",\"subtitle\":\"Web search · ~18,400 results\",\"callouts\":[{\"label\":\"Organic results\",\"value\":\"10\"},{\"label\":\"Ads\",\"value\":\"4\"},{\"label\":\"Featured snippet\",\"value\":\"Yes\"}]}},{\"id\":\"social\",\"label\":\"Social media\",\"description\":\"Profiles, posts, and engagement data from social networks at scale.\",\"href\":\"/data-types/social-media-scraper/\",\"useCases\":[{\"title\":\"Influencer discovery\",\"body\":\"Find an