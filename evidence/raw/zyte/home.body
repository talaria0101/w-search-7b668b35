tems-center md:justify-between\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"text-heading-md font-semibold lg:text-heading-mdp\",\"children\":\"Our thoughts on web data collection\"}],[\"$\",\"$L7f\",null,{\"href\":\"/blog/\",\"variant\":\"ghost\",\"icon\":[\"$\",\"$Lba\",null,{\"ref\":\"$undefined\",\"icon\":{\"name\":\"arrow-right\",\"size\":24,\"node\":[[\"path\",{\"d\":\"M5 12h14\",\"key\":\"1ays0h\"}],[\"path\",{\"d\":\"m12 5 7 7-7 7\",\"key\":\"xquz4c\"}]]},\"className\":\"$undefined\",\"size\":16}],\"children\":\"See all\"}]]}],\"$undefined\"]}],[\"$\",\"div\",null,{\"className\":\"grid grid-cols-1 gap-5 lg:grid-cols-3\",\"children\":[[\"$\",\"$Lbb\",\"how-to-convert-a-website-to-markdown-for-ai-7-methods-compared\",{\"card\":{\"id\":\"how-to-convert-a-website-to-markdown-for-ai-7-methods-compared\",\"title\":\"How to convert a website to Markdown for AI: 7 methods compared\",\"excerpt\":\"Seven realistic ways to turn web pages into clean Markdown for AI - what each method covers, where each breaks, and how to choose for training, RAG and agent pipelines.\",\"category\":\"Data gathering for AI\",\"author\":\"Robert Andrews\",\"readTime\":\"14 min read\",\"image\":{\"url\":\"https://extract.zyte.com/api/media/file/markdown-compared.png\",\"alt\":\"How to convert a website to Markdown for AI: 7 methods compared\"},\"href\":\"/blog/how-to-convert-a-website-to-markdown-for-ai-7-methods-compared/\"}}],[\"$\",\"$Lbb\",\"train-ai-on-industry-leading-markdown-with-zytes-new-extraction-mode\",{\"card\":{\"id\":\"train-ai-on-industry-leading-markdown-with-zytes-new-extraction-mode\",\"title\":\"Train AI on industry-leading Markdown with Zyte’s new extraction mode\",\"excerpt\":\"Zyte API can now extract a web page’s main content directly as clean, structured Markdown for AI systems, RAG pipelines and developer workflows.\",\"category\":\"Data gathering for AI\",\"author\":\"Valter Sciarrillo\",\"readTime\":\"8 min read\",\"image\":{\"url\":\"https://extract.zyte.com/api/media/file/html-to-markdown.png\",\"alt\":\"Train AI on industry-leading Markdown with Zyte’s new extraction mode\"},\"href\":\"/blog/train-ai-on-industry-leading-markdown-with-zytes-new-extraction-mode/\"}}],[\"$\",\"$Lbb\",\"web-data-for-business-insights\",{\"card\":{\"id\":\"web-data-for-business-insights\",\"title\":\"Web data for business insights in 2026: Elevate your BI function with quality data\",\"excerpt\":\"Discover how BI teams in 2026 use AI-powered web data to cut data wrangling, improve quality, and stay compliant. Insights from Zyte’s Web Scraping Industry Report.\",\"category\":\"Use case\",\"author\":\"Theresia Tanzil\",\"readTime\":\"5 min read\",\"image\":{\"url\":\"https://extract.zyte.com/api/media/file/scale-web-data-without-scaling-headcount-hero-1-1200x630-6bTJeHOCbKQdudMdgIqPlEt5GaRxtY.png\",\"alt\":\"Web data for business insights in 2026: Elevate your BI function with quality data\"},\"href\":\"/blog/web-data-for-business-insights/\"}}],[\"$\",\"$Lbb\",\"sowa-barrier-javascript\",{\"card\":{\"id\":\"sowa-barrier-javascript\",\"title\":\"JavaScript renders almost half of sites invisible\",\"excerpt\":\"JavaScript renders 40.6% of top sites unreadable to a plain HTTP request, not by design but as a side effect of how the modern web is built.\",\"category\":\"Access handling\",\"author\":\"Robert Andrews\",\"image\":{\"url\":\"https://extract.zyte.com/api/media/file/sowa-barrier-javascript.png\",\"alt\":\"JavaScript renders almost half of sites invisible\"},\"href\":\"/blog/sowa-barrier-javascript/\"}}],[\"$\",\"$Lbb\",\"ai-data-compliance-2026-regulations-provenance\",{\"card\":{\"id\":\"ai-data-compliance-2026-regulations-provenance\",\"title\":\"Legal clarity comes with compliance demands\",\"excerpt\":\"Explore how new regulations like the EU AI Act and California AB 2013 are reshaping AI data compliance in 2026. Learn why provenance, transparency, and lawful sourcing are now critical.\",\"category\":\"Web scraping APIs\",\"author\":\"Theresia Tanzil\",\"readTime\":\"5 min read\",\"image\":{\"url\":\"https://extract.zyte.com/api/media/file/ai-data-compliance-2026-regulations-provenance-her-b56ef43a.png\",\"alt\":\"Legal clarity comes with compliance demands\"},\"href\":\"/blog/ai-data-compliance-2026-regulations-provenance/\"}}],\"$Lbc\"]}]]}]}]\nb3:[\"$\",\"$Lb8\",null,{\"socialsData\":\"$ab:props:children:1:props:socialsData\",\"variant\":\"text\",\"className\":\"mt-4 sm:mt-6\"}]\nbc:[\"$\",\"$Lbb\",\"extract-austin-2026-takeaways\",{\"card\":{\"id\":\"extract-austin-2026-takeaways\",\"title\":\"Five takeaways from Extract Summit 2026 Austin\",\"excerpt\":\"AI is making web scraping faster - but dependable data takes more than working code. Quality, provenance, self-repair, access and responsibility are the new edge.\",\"category\":\"\",\"author\":\"Robert Andrews\",\"image\":{\"url\":\"https://extract.zyte.com/api/media/file/ejwtj81ugzaqhn-fh54oybpdiht1v0iklyoq5ywc2wlwwab2gppgeffaklfdb2d3zi-iaqvcqqvnuaas1shculmgiolwck8qru.jpg\",\"alt\":\"Five takeaways from Extract Summit 2026 Austin\"},\"href\":\"/blog/extract-austin-2026-takeaways/\"}}]\nb4:null\nb9:null\n90:[[\"$\",\"$1\",\"meta\",{\"children\":[[\"$\",\"title\",null,{\"children\":\"404 error\"}],[\"$\",\"link\",\".$canonical\",{\"rel\":\"canonical\",\"href\":\"https://www.zyte.com/\"}],[[\"$\",\"meta\",\".$meta_prop_0\",{\"name\":\"robots\",\"content\":\"noindex,nofollow\"}],[\"$\",\"meta\",\".$meta_prop_1\",{\"property\":\"og:image\",\"content\":\"https://assets.contento.io/assets/4PqjGl09zX/Snapshot.png\"}]]]}],null,[\"$Lbd\"],null]\na3:[[\"$\",\"$1\",\"meta\",{\"children\":[[\"$\",\"title\",null,{\"children\":\"404 error\"}],[\"$\",\"link\",\".$canonical\",{\"rel\":\"canonical\",\"href\":\"https://www.zyte.com/\"}],[[\"$\",\"meta\",\".$meta_prop_0\",{\"name\":\"robots\",\"content\":\"noindex,nofollow\"}],[\"$\",\"meta\",\".$meta_prop_1\",{\"property\":\"og:image\",\"content\":\"https://assets.contento.io/assets/4PqjGl09zX/Snapsh