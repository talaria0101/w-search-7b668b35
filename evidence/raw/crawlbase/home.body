<!DOCTYPE html><html lang="en" data-theme="light" data-theme-default="dark"><head><meta charset="utf-8" /><script>(function () { try { var valid = ["light", "dark", "system"]; var m = document.cookie.match(/(?:^|;\s*)cb-theme=([^;]+)/); var pref = m ? decodeURIComponent(m[1]) : null; if (!valid.includes(pref)) { var ls = null; try { ls = localStorage.getItem("cb-theme"); } catch (e) {} pref = valid.includes(ls) ? ls : null; } var t = pref === "light" || pref === "dark" ? pref : pref === "system" ? (window.matchMedia && window.matchMedia("(prefers-color-scheme: dark)").matches ? "dark" : "light") : 'dark'; document.documentElement.setAttribute("data-theme", t); } catch (e) {} })();</script><link rel="preload" as="font" type="font/woff2" crossorigin="" href="/assets/css/Sora/Sora-700-latin.woff2" /><link rel="preload" as="font" type="font/woff2" crossorigin="" href="/assets/css/Sora/Sora-800-latin.woff2" /><link rel="preload" as="font" type="font/woff2" crossorigin="" href="/assets/css/Inter/Inter-400-latin.woff2" /><link rel="preload" as="font" type="font/woff2" crossorigin="" href="/assets/css/JetBrainsMono/JetBrainsMono-400-latin.woff2" /><link rel="preload" as="font" type="font/woff2" crossorigin="" href="/assets/css/JetBrainsMono/JetBrainsMono-500-latin.woff2" /><style>/* Arial adjusted to Sora / Inter metrics (see the Source Serif 4 fallback in
 * webfonts.css for why): same-size pre-swap paint keeps LCP at first paint. */
@font-face {
  font-family: 'Sora-fallback';
  src: local('Arial');
  size-adjust: 115.8%;
  ascent-override: 83.8%;
  descent-override: 25%;
  line-gap-override: 0%;
}
@font-face {
  font-family: 'Inter-fallback';
  src: local('Arial');
  size-adjust: 107.5%;
  ascent-override: 90.1%;
  descent-override: 22.4%;
  line-gap-override: 0%;
}
