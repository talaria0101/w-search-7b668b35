}</script><script type="application/ld+json">{
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    { "@type": "Question", "name": "What counts as a request?", "acceptedAnswer": { "@type": "Answer", "text": "Only successful requests are billed. A request that fails or is blocked costs nothing, whatever the site or rendering mode." } },
    { "@type": "Question", "name": "How do I start free?", "acceptedAnswer": { "@type": "Answer", "text": "Every new account starts with 1,000 free credits and no card on file, and completing setup steps grows that to up to 5,000. The free credits work across every product." } },
    { "@type": "Question", "name": "Can I cap what I spend?", "acceptedAnswer": { "@type": "Answer", "text": "Yes. Set an optional hard spend cap in the dashboard and usage stops before the bill passes it. Raise, lower or remove it any time." } },
    { "@type": "Question", "name": "Do credits expire, and does the allowance reset?", "acceptedAnswer": { "@type": "Answer", "text": "Pay as you go bills in arrears for what you actually used, so there is nothing to expire. A subscription's credit block resets with each monthly cycle." } },
    { "@type": "Question", "name": "What happens past a subscription's included credits?", "acceptedAnswer": { "@type": "Answer", "text": "Usage continues as pay as you go on the same rate card, at the bracket your volume already reached. Prefer a hard stop? Turn pay as you go off and requests pause at the block instead." } },
    { "@type": "Question", "name": "How do storage and screenshots bill?", "acceptedAnswer": { "@type": "Answer", "text": "From the same balance. Storing a page costs 0.5 credits per month it is kept, and a screenshot capture costs 2 credits." } },
    { "@type": "Question", "name": "What about very high volume?", "acceptedAnswer": { "@type": "Answer", "text": "Enterprise adds custom volume, SLAs and invoicing. Talk to sales about a plan for your program." } }
  ]
}</script><script type="application/ld+json">{
