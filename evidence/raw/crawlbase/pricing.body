          "url": "https://crawlbase.com/smart-proxy",
          "description": "AI-powered proxy for scraping blocked websites, dynamically adapting to anti-bot defenses, intelligently rotating IPs, and maximizing request success rates for reliable data extraction at scale."
        }
      }
    },
    {
      "@type": "ListItem",
      "position": 3,
      "item": {
        "@type": "Offer",
        "itemOffered": {
          "@type": "Service",
          "name": "Enterprise Crawler",
          "url": "https://crawlbase.com/anonymous-crawler-asynchronous-scraping",
          "description": "Run asynchronous, large-scale crawling jobs across JavaScript-heavy pages with queueing and callbacks, ideal for high-volume continuous data collection and automation workflows."
        }
      }
