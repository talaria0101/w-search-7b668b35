      "contactType": "customer service",
      "email": "support@crawlbase.com",
      "availableLanguage": ["English", "German", "French", "Russian", "Chinese"]
    }
  ],
  "knowsAbout": ["Web Data Infrastructure", "Web Crawling", "Web Scraping", "Web Unblocking", "JavaScript Rendering", "Anti-bot Mitigation", "Proxy Networks", "Model Context Protocol (MCP)", "Retrieval-Augmented Generation (RAG)", "AI Workflows"],
  "hasOfferCatalog": {
    "@type": "OfferCatalog",
    "name": "Crawlbase Product Suite",
    "itemListElement": [
    {
