:1200,"height":630},"mainEntity":{"@id":"https://www.tinyfish.ai/#products"},"inLanguage":"en-US"},{"@type":"ItemList","@id":"https://www.tinyfish.ai/#products","name":"TinyFish products","numberOfItems":4,"itemListElement":[{"@type":"ListItem","position":1,"item":{"@type":"SoftwareApplication","@id":"https://www.tinyfish.ai/search#software","name":"TinyFish Search","url":"https://www.tinyfish.ai/search"}},{"@type":"ListItem","position":2,"item":{"@type":"SoftwareApplication","@id":"https://www.tinyfish.ai/fetch#software","name":"TinyFish Fetch","url":"https://www.tinyfish.ai/fetch"}},{"@type":"ListItem","position":3,"item":{"@type":"SoftwareApplication","@id":"https://www.tinyfish.ai/agent#software","name":"TinyFish Agent","url":"https://www.tinyfish.ai/agent"}},{"@type":"ListItem","position":4,"item":{"@type":"SoftwareApplication","@id":"https://www.tinyfish.ai/browser#software","name":"TinyFish Browser","url":"https://www.tinyfish.ai/browser"}}]},{"@type":"FAQPage","@id":"https://www.tinyfish.ai/#faq","mainEntity":[{"@type":"Question","name":"How is this different from other tools?","acceptedAnswer":{"@type":"Answer","text":"Most alternatives are point solutions. One does search, another does browsers, another does scraping. TinyFish is the only platform that puts TinySearch, TinyFetch, TinyBrowser, and TinyAgent behind one API key and one Wallet."}},{"@type":"Question","name":"Why would I use this instead of my LLM's built-in web search?","acceptedAnswer":{"@type":"Answer","text":"Reliability and structure. Our search hits Google's actual live index through a real browser, not a secondary index or cached results. You get typed JSON objects back, not markdown blobs your model has to parse."}},{"@type":"Question","name":"How accurate is TinyAgent?","acceptedAnswer":{"@type":"Answer","text":"89.9% overall on Mind2Web, the industry-standard benchmark for web agents. 81.9% on hard tasks, where Operator scores 43.2% and Claude scores 32.4%. All 300 runs are open-sourced and independently verifiable."}},{"@type":"Question","name":"Can agents authenticate into websites?","acceptedAnswer":{"@type":"Answer","text":"Yes. TinyVault lets agents log into portals, navigate authenticated dashboards, and extract from gated content without exposing credentials to the LLM."}}]}]}</script><style>
:root { --xm-ease: cubic-bezier(.16,1,.3,1); --xm-spring: cubic-bezier(.34,1.56,.64,1) }
.xm-line { display: block; overflow: hidden; padding-bottom: .12em; margin-bottom: -.12em }

@keyframes xm-rise { from { transform: translateY(105%) } to { transform: none } }
@keyframes xm-fade { from { opacity: 0; transform: translateY(14px) } to { opacity: 1; transform: none } }
@keyframes xm-pop { from { opacity: 0; transform: scale(.6) } to { opacity: 1; transform: none } }
.xm-load .xm-line > span { animation: xm-rise 750ms var(--xm-ease) var(--d, 0ms) both }
.xm-load .xm-fade { animation: xm-fade 550ms var(--xm-ease) var(--d, 0ms) both }
.xm-load .xm-pop { animation: xm-pop 450ms var(--xm-spring) var(--d, 0ms) both }

[data-reveal] .xm-line > span { transition: transform 750ms var(--xm-ease) var(--d, 0ms) }
[data-reveal] .xm-fade { transition: opacity 550ms var(--xm-ease) var(--d, 0ms), transform 550ms var(--xm-ease) var(--d, 0ms) }
[data-reveal] .xm-pop { transition: opacity 450ms var(--xm-spring) var(--d, 0ms), transform 450ms var(--xm-spring) var(--d, 0ms) }
[data-reveal='pending'] .xm-line > span { transform: translateY(105%) }
[data-reveal='pending'] .xm-fade { opacity: 0; transform: translateY(14px) }
[data-reveal='pending'] .xm-pop { opacity: 0; transform: scale(.6) }

/* In-product UI: fades like real UI does, never rises. */
@keyframes xm-appear { from { opacity: 0 } to { opacity: 1 } }
.xm-appear { animation: xm-appear 280ms ease-out both }
@keyframes xm-ripple { from { transform: scale(.3); opacity: .45 } to { transform: scale(2.6); opacity: 0 } }
@keyframes xm-draw { from { stroke-dashoffset: var(--len) } to { stroke-dashoffset: 0 } }
.xm-ripple { animation: xm-ripple 450ms var(--xm-ease) both }
@keyframes xm-roll-in { from { transform: translateY(110%) } to { transform: none } }
@keyframes xm-roll-out { from { transform: none } to { transform: translateY(-110%) } }
.xm-roll-in { animation: xm-roll-in 650ms var(--xm-ease) var(--d, 0ms) both }
.xm-roll-out { animation: xm-roll-out 650ms var(--xm-ease) var(--d, 0ms) both }
.xm-draw { stroke-dasharray: var(--len); animation: xm-draw 500ms var(--xm-ease) var(--d, 0ms) both }
@keyframes xm-marquee { from { transform: translateX(0) } to { transform: translateX(-50%) } }
.xm-marquee { animation: xm-marquee 28s linear infinite }
.xm-arrow { display: inline-block; transition: transform 200ms var(--xm-ease) }
a:hover .xm-arrow, button:hover .xm-arrow { transform: translateX(4px) }

@media (prefers-reduced-motion: reduce) {
  .xm-line > span, .xm-fade, .xm-pop {
    animation: none !important; transition: none !important; transform: none !important; opacity: 1 !important;
  }
  .xm-arrow { transition: none }
  .xm-marquee { animation: none }
  .xm-appear, .xm-ripple, .xm-draw, .xm-roll-in { animation: none }
  .xm-roll-out { display: none }
}
