e.',\n      },\n      callback: {\n        onPreferenceExpressedOrNotNeeded: function(pref) {\n          window.dispatchEvent(new CustomEvent(\"iubenda-consent\", { detail: pref }));\n        }\n      }\n    };\n\n    // Inject layout styles into iubenda's shadow DOM layers\n    (function() {\n      var _tfStyled = 0;\n      var MAX_RETRIES = 100;\n      function revealBanner(wrapper) {\n        if (++_tfStyled \u003e= 2) wrapper.classList.add('tf-styled');\n      }\n\n      function injectContentStyles(wrapper, attempts) {\n        attempts = attempts || 0;\n        var content = wrapper.shadowRoot.querySelector('tb-banner-content');\n        if (!content || !content.shadowRoot) {\n          if (attempts \u003c MAX_RETRIES) setTimeout(function() { injectContentStyles(wrapper, attempts + 1); }, 50);\n          return;\n        }\n        if (content.shadowRoot.querySelector('#tf-content-styles')) { revealBanner(wrapper); return; }\n        var s = document.createElement('style');\n        s.id = 'tf-content-styles';\n        s.textContent = ':host{--tb-banner-background-color:#ffffff!important;--tb-banner-text-color:#09090b!important}.tb-banner-container{padding:10px 20px 0!important}.tb-banner-body{font-size:15px!important}.tf-policy-link{color:#09090b!important;text-decoration:underline!important;text-underline-offset:2px!important;text-decoration-color:rgba(9,9,11,0.25)!important;transition:text-decoration-color .15s ease!important}.tf-policy-link:hover{text-decoration-color:rgba(9,9,11,0.6)!important}';\n        content.shadowRoot.appendChild(s);\n        revealBanner(wrapper);\n      }\n\n      function injectFooterStyles(wrapper, attempts) {\n        attempts = attempts || 0;\n        var footer = wrapper.shadowRoot.querySelector('tb-banner-footer');\n        if (!footer || !footer.shadowRoot) {\n          if (attempts \u003c MAX_RETRIES) setTimeout(function() { injectFooterStyles(wrapper, attempts + 1); }, 50);\n          return;\n        }\n        if (footer.shadowRoot.querySelector('#tf-footer-styles')) { revealBanner(wrapper); return; }\n\n        var s = document.createElement('style');\n        s.id = 'tf-footer-styles';\n        s.textContent =\n          ':host{--tb-banner-background-color:#ffffff!important;--tb-banner-footer-background-color:#ffffff!important}' +\n          '.tb-banner-footer{padding:0 10px 8px!important;display:flex!important;flex-direction:row!important;align-items:center!important;justify-content:space-between!important}' +\n          '.tb-footer-buttons-container{display:flex!important;align-items:center!important;width:auto!important;gap:8px!important;border-top:none!important;padding-block:8px!important}' +\n          '.tb-footer-button{width:auto!important;padding:0!important}' +\n          '#tf-customize-btn{background:#f4f4f5!important;border:1px solid transparent!important;border-radius:6px!important;cursor:pointer!important;color:#18181b!important;font-size:14px!important;font-family:inherit!important;font-weight:700!important;padding:8px 18px!important;box-sizing:border-box!important}';\n        footer.shadowRoot.appendChild(s);\n\n        var bannerFooter = footer.shadowRoot.querySelector('.tb-banner-footer');\n        if (bannerFooter \u0026\u0026 !footer.shadowRoot.querySelector('#tf-customize-btn')) {\n          var customizeWrapper = document.createElement('div');\n          var btn = document.createElement('button');\n          btn.id = 'tf-customize-btn';\n          btn.textContent = 'Customize';\n          btn.addEventListener('click', function() {\n            try {\n              var prefBtn = document.querySelector('tb-banner-wrapper').shadowRoot\n                .querySelector('tb-tabs-container').shadowRoot\n                .querySelector('tb-banner-tab[label=\"Preferences\"]').shadowRoot\n                .querySelector('button');\n              if (prefBtn) prefBtn.click();\n            } catch(e) {}\n          });\n          customizeWrapper.appendChild(btn);\n       