width="15" height="15" viewBox="0 0 16 16" aria-hidden="true"><rect x="3" y="7" width="10" height="7" rx="1.5" fill="none" stroke="rgb(0 0 0 / 0.7)" stroke-width="1.3" stroke-linecap="round" stroke-linejoin="round"></rect><path d="M5.5 7V5a2.5 2.5 0 0 1 5 0v2" fill="none" stroke="rgb(0 0 0 / 0.7)" stroke-width="1.3" stroke-linecap="round" stroke-linejoin="round"></path></svg></span><h3 class="text-[20px] font-medium tracking-[-0.03em]" style="font-family:var(--font-familjen);color:rgb(0 0 0 / 0.9)">TinyVault</h3></div><p class="max-w-[340px] pl-[38px] text-[15px] leading-[23px]" style="font-family:var(--font-inter);color:rgb(0 0 0 / 0.6)">Connect 1Password or Bitwarden. Each run gets only the logins you pick, and the model never sees them.</p></div><div class="xm-fade flex flex-col gap-2.5" style="--d:300ms"><div class="flex items-center gap-2.5"><span class="flex size-7 items-center justify-center rounded-lg" style="border:1px solid rgb(0 0 0 / 0.1)"><svg width="15" height="15" viewBox="0 0 16 16" aria-hidden="true"><circle cx="8" cy="5.5" r="2.7" fill="none" stroke="rgb(0 0 0 / 0.7)" stroke-width="1.3" stroke-linecap="round" stroke-linejoin="round"></circle><path d="M2.8 14c.6-2.7 2.7-4.2 5.2-4.2s4.6 1.5 5.2 4.2" fill="none" stroke="rgb(0 0 0 / 0.7)" stroke-width="1.3" stroke-linecap="round" stroke-linejoin="round"></path></svg></span><h3 class="text-[20px] font-medium tracking-[-0.03em]" style="font-family:var(--font-familjen);color:rgb(0 0 0 / 0.9)">TinyProfiles</h3></div><p class="max-w-[340px] pl-[38px] text-[15px] leading-[23px]" style="font-family:var(--font-inter);color:rgb(0 0 0 / 0.6)">Save a signed-in session once. Later runs start logged in, and sign back in from TinyVault when it expires.</p></div><div class="xm-fade flex flex-col gap-2.5" style="--d:380ms"><div class="flex items-center gap-2.5"><span class="flex size-7 items-center justify-center rounded-lg" style="border:1px solid rgb(0 0 0 / 0.1)"><svg width="15" height="15" viewBox="0 0 16 16" aria