tion":1,"name":"Home","item":"https://www.tinyfish.ai/"},{"@type":"ListItem","position":2,"name":"Pricing","item":"https://www.tinyfish.ai/pricing"}]},{"@type":"SoftwareApplication","@id":"https://www.tinyfish.ai/#platform","name":"TinyFish","applicationCategory":"DeveloperApplication","operatingSystem":"Web-based (REST API, SDKs, CLI, MCP)","url":"https://www.tinyfish.ai/","provider":{"@id":"https://www.tinyfish.ai/#organization"},"offers":[{"@type":"Offer","name":"TinyFish Search","url":"https://www.tinyfish.ai/pricing","price":0,"priceCurrency":"USD","priceSpecification":{"@type":"UnitPriceSpecification","price":0,"priceCurrency":"USD","unitText":"request","referenceQuantity":{"@type":"QuantitativeValue","value":1,"unitText":"request"}},"description":"Free. Limits: 30 requests / min, 500 requests / hour","itemOffered":{"@id":"https://www.tinyfish.ai/search#software"}},{"@type":"Offer","name":"TinyFish Fetch","url":"https://www.tinyfish.ai/pricing","price":0,"priceCurrency":"USD","priceSpecification":{"@type":"UnitPriceSpecification","price":0,"priceCurrency":"USD","unitText":"url","referenceQuantity":{"@type":"QuantitativeValue","value":1,"unitText":"url"}},"description":"Free. Limits: 150 urls / min, 1,000 urls / day","itemOffered":{"@id":"https://www.tinyfish.ai/fetch#software"}},{"@type":"Offer","name":"TinyFish Agent","url":"https://www.tinyfish.ai/pricing","price":0.016,"priceCurrency":"USD","priceSpecification":{"@type":"UnitPriceSpecification","price":0.016,"priceCurrency":"USD","unitText":"step","referenceQuantity":{"@type":"QuantitativeValue","value":1,"unitText":"step"}},"description":"Metered against Wallet. Limit: 2 concurrent runs","itemOffered":{"@id":"https://www.tinyfish.ai/agent#software"}},{"@type":"Offer","name":"TinyFish Browser","url":"https://www.tinyfish.ai/pricing","price":0.002,"priceCurrency":"USD","priceSpecification":{"@type":"UnitPriceSpecification","price":0.002,"priceCurrency":"USD","unitText":"minute","referenceQuantity":{"@type":"QuantitativeValue","value":1,"unitText":"minute"}},"description":"Metered against Wallet. Limit: 5 concurrent sessions","itemOffered":{"@id":"https://www.tinyfish.ai/browser#software"}}]},{"@type":"FAQPage","@id":"https://www.tinyfish.ai/pricing#faq","mainEntity":[{"@type":"Question","name":"What is the Wallet?","acceptedAnswer":{"@type":"Answer","text":"A prepaid balance on your account. Agent and Browser draw from it as they run; Search and Fetch never do. There is no subscription and no seats. You add funds and spend them on what you run."}},{"@type":"Question","name":"How do I add funds?","acceptedAnswer":{"@type":"Answer","text":"Add a card, then add funds to your Wallet — $10.00 minimum. After your first deposit you can turn on auto-reload so the balance refills itself. New accounts start with $8 in Wallet funds, so you can run Agent and Browser before you add a card."}},{"@type":"Question","name":"What happens when my Wallet reaches $0?","acceptedAnswer":{"@type":"Answer","text":"Nothing breaks. Search and Fetch keep running within their limits, since neither ever draws from the Wallet. An Agent run that is already under way will finish. Agent and Browser need funds to start, so make a deposit when you want to run them again."}},{"@type":"Question","name":"Is there a monthly plan?","acceptedAnswer":{"@type":"Answer","text":"No. There are no recurring Wallet plans. You fund the Wallet and pay for the Agent and Browser usage you actually run."}},{"@type":"Question","name":"Are Search and Fetch really free?","acceptedAnswer":{"@type":"Answer","text":"Yes, Search at 30 requests / min and 500 requests / hour, Fetch at 150 urls / min and 1,000 urls / day. No charge, no Wallet draw, and they keep working at a $0 balance."}},{"@type":"Question","name":"Can I raise concurrency or rate limits?","acceptedAnswer":{"@type":"Answer","text":"Yes. Accounts start at 2 concurrent runs on Agent and 5 concurrent sessions on Browser, and both go up. Talk to sales and we will set them to your workload. Limits live on your account rather than being bought with Wallet funds, so raising them is a conversation, not a purchase."}},{"@type":"Question","name":"I'm on a legacy credit plan. Where do I see my pricing?","acceptedAnswer":{"@type":"Answer","text":"Your credit rates and balance live in your account dashboard. Sign in and they are all there."}}]}]}</script><div class="h-10"></div><style>
