      }

      function injectContentStyles(wrapper, attempts) {
        attempts = attempts || 0;
        var content = wrapper.shadowRoot.querySelector('tb-banner-content');
        if (!content || !content.shadowRoot) {
          if (attempts < MAX_RETRIES) setTimeout(function() { injectContentStyles(wrapper, attempts + 1); }, 50);
          return;
        }
        if (content.shadowRoot.querySelector('#tf-content-styles')) { revealBanner(wrapper); return; }
        var s = document.createElement('style');
        s.id = 'tf-content-styles';
        s.textContent = ':host{--tb-banner-background-color:#ffffff!important;--tb-banner-text-color:#09090b!important}.tb-banner-container{padding:10px 20px 0!important}.tb-banner-body{font-size:15px!important}.tf-policy-link{color:#09090b!important;text-decoration:underline!important;text-underline-offset:2px!important;text-decoration-color:rgba(9,9,11,0.25)!important;transition:text-decoration-color .15s ease!important}.tf-policy-link:hover{text-decoration-color:rgba(9,9,11,0.6)!important}';
        content.shadowRoot.appendChild(s);
