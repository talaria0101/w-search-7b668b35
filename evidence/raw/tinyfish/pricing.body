henticate, extract data, and automate web workflows with a fully serverless architecture.\",\"founder\":[{\"@type\":\"Person\",\"name\":\"Sudheesh Nair\"},{\"@type\":\"Person\",\"name\":\"Shuhao Zhang\"},{\"@type\":\"Person\",\"name\":\"Keith Zhai\"}],\"address\":{\"@type\":\"PostalAddress\",\"addressLocality\":\"Palo Alto\",\"addressRegion\":\"CA\",\"addressCountry\":\"US\"},\"sameAs\":[\"https://x.com/Tiny_Fish\",\"https://www.linkedin.com/company/tinyfish-ai\",\"https://github.com/tinyfish-io\",\"https://discord.com/invite/tinyfish\"]},{\"@type\":\"WebSite\",\"@id\":\"https://www.tinyfish.ai/#website\",\"name\":\"TinyFish\",\"url\":\"https://www.tinyfish.ai/\",\"description\":\"TinyFish provides enterprise infrastructure for AI web agents. Run hundreds of websites simultaneously to navigate, authenticate, extract data, and automate web workflows with a fully serverless architecture.\",\"publisher\":{\"@id\":\"https://www.tinyfish.ai/#organization\"},\"inLanguage\":\"en-US\"}]}3:T1b2a,\n    var _iub = _iub || [];\n    _iub.csConfiguration = {\n      siteId: 1225576,\n      cookiePolicyId: 76667406,\n      lang: \"en\",\n      perPurposeConsent: true,\n      // iubenda is the single source of Google Consent Mode state — it sets the defaults and\n      // the updates. These two replace the gtag('set', ...) calls that used to sit next to our\n      // own consent default; routing them through iubenda keeps one owner for the whole signal.\n      googleAdsDataRedaction: true,\n      googleUrlPassthrough: true,\n      banner: {\n        position: \"float-bottom-right\",\n        acceptButtonDisplay: true,\n        rejectButtonDisplay: true,\n        customizeButtonDisplay: false,\n        closeButtonDisplay: false,\n        listPurposes: false,\n        content: 'We use cookies to improve your experience and analyze usage. See our \u003ca href=\"/privacy-policy\" class=\"tf-policy-link\"\u003ePrivacy Policy\u003c/a\u003e and \u003ca href=\"https://www.iubenda.com/privacy-policy/76667406/cookie-policy\" target=\"_blank\" rel=\"noopener noreferrer\" class=\"tf-policy-link\"\u003eCookie Policy\u003c/a\u003e.',\n      },\n      callback: {\n        onPreferenceExpressedOrNotNeeded: function(pref) {\n          window.dispatchEvent(new CustomEvent(\"iubenda-consent\", { detail: pref }));\n        }\n      }\n    };\n\n    // Inject layout styles into iubenda's shadow DOM layers\n    (function() {\n      var _tfStyled = 0;\n      var MAX_RETRIES = 100;\n      function revealBanner(wrapper) {\n        if (++_tfStyled \u003e= 2) wrapper.classList.add('tf-styled');\n      }\n\n      function injectContentStyles(wrapper, attempts) {\n        attempts = attempts || 0;\n        var content = wrapper.shadowRoot.querySelector('tb-banner-content');\n        if (!content || !content.shadowRoot) {\n          if (attempts \u003c MAX_RETRIES) setTimeout(function() { injectContentStyles(wrapper, attempts + 1); }, 50);\n          return;\n        }\n        if (content.shadowRoot.querySelector('#tf-content-styles')) { revealBanner(wrapper); return; }\n        var s = document.createElement('style');\n        s.id = 'tf-content-styles';\n        s.textContent = ':host{--tb-banner-background-color:#ffffff!important;--tb-banner-text-color:#09090b!important}.tb-banner-container{padding:10px 20px 0!important}.tb-banner-body{font-size:15px!important}.tf-policy-link{color:#09090b!important;text-decoration:underline!important;text-underline-offset:2px!important;text-decoration-color:rgba(9,9,11,0.25)!important;transition:text-decoration-color .15s ease!important}.tf-policy-link:hover{text-decoration-color:rgba(9,9,11,0.6)!important}';\n        content.shadowRoot.appendChild(s);\n        revealBanner(wrapper);\n      }\n\n      function injectFooterStyles(wrapper, attempts) {\n        attempts = attempts || 0;\n        var footer = wrapper.shadowRoot.querySelector('tb-banner-footer');\n        if (!footer || !footer.shadowRoot) {\n          if (attempts \u003c MAX_RETRIES) setTimeout(function() { injectFooterStyles(wrapper, attempts + 1); }, 50);\n          return;\n        }\n        if (footer.shadowRoot.querySelector('#tf-footer-styles')) { revealBanner(wrapper); return; }\n\n        var s = document.createElement('style');\n        s.id = 'tf-footer-styles';\n        s.textContent =\n          ':host{--tb-banner-background-color:#ffffff!important;--tb-banner-footer-background-color:#ffffff!important}' +\n          '.tb-banner-footer{padding:0 10px 8px!important;display:flex!important;flex-direction:row!important;align-items:center!important;justify-content:space-between!important}' +\n          '.tb-footer-buttons-container{display:flex!important;align-items:center!important;width:auto!important;gap:8px!important;border-top:none!important;padding-block:8px!important}' +\n          '.tb-footer-button{width:auto!important;padding:0!important}' +\n          '#tf-customize-btn{background:#f4f4f5!important;border:1px solid transparent!important;border-radius:6px!important;cursor:pointer!important;color:#18181b!important;font-size:14px!important;font-family:inherit!important;font-weight:700!important;padding:8px 18px!important;box-sizing:border-box!important}';\n        footer.shadowRoot.appendChild(s);\n\n        var bannerFooter = footer.shadowRoot.querySelector('.tb-banner-footer');\n        if (bannerFooter \u0026\u0026 !footer.shadowRoot.querySelector('#tf-customize-btn')) {\n          var customizeWrapper = document.createElement('div');\n          var btn = document.createElement('button');\n          btn.id = 'tf-customize-btn';\n          btn.textContent = 'Customize';\n          btn.addEventListener('click', function() {\n            try {\n              var prefBtn = document.querySelector('tb-banner-wrapper').shadowRoot\n                .querySelector('tb-tabs-container').shadowRoot\n                .querySelector('tb-banner-tab[label=\"Preferences\"]').shadowRoot\n                .querySelector('button');\n              if (prefBtn) prefBtn.click();\n            } catch(e) {}\n          });\n          customizeWrapper.appendChild(btn);\n          bannerFooter.appendChild(customizeWrapper);\n        }\n\n        footer.shadowRoot.querySelectorAll('.tb-footer-button').forEach(function(actionBtn) {\n          if (!actionBtn.shadowRoot) return;\n          var innerStyle = document.createElement('style');\n          innerStyle.textContent =\n            '.action-button{padding:8px 18px!important;box-sizing:border-box!important;border-radius:6px!important;font-size:14px!important}' +\n            '.accept-button{background:#d04400!important;color:#ffffff!important}' +\n            '.reject-button{background:#f4f4f5!important;color:#18181b!important}';\n          actionBtn.shadowRoot.appendChild(innerStyle);\n        });\n        revealBanner(wrapper);\n      }\n\n      function injectBannerStyles() {\n        var wrapper = document.querySelector('tb-banner-wrapper');\n        if (!wrapper || !wrapper.shadowRoot) return false;\n        if (wrapper.shadowRoot.querySelector('#tf-banner-styles')) return true;\n\n        var s = document.createElement('style');\n        s.id = 'tf-banner-styles';\n        s.textContent =\n          ':host{--tb-banner-background-color:#ffffff!important;--tb-banner-text-color:#09090b!important;--tb-banner-footer-background-color:#ffffff!important}' +\n          '.tb-banner-tabs-wrapper{display:none!important}' +\n          '.tb-banner-wrapper{min-height:0!important;height:fit-content!important;max-width:min(420px, calc(100vw - 32px))!important;align-self:flex-end!important}' +\n          '.tb-banner-top-stripe{height:4px!important}' +\n          '.tb-banner-footer-wrapper{border-top:none!important}';\n        wrapper.shadowRoot.appendChild(s);\n\n        injectContentStyles(wrapper);\n        injectFooterStyles(wrapper);\n        return true;\n      }\n\n      if (!injectBannerStyles()) {\n        var obs = new MutationObserver(function(_, o) {\n     