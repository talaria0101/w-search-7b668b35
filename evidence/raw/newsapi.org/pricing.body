  })();
</script>


<div class="mw7 mb3 mt5-ns pt5 tc w-90 center lh-copy">
  <h1 class="black-90 fw5 f2 mb2">Pricing</h1>
  <p class="fw3 f3 mt0 gs">Free for development, options if you're commercial</p>
</div>

<div class="w-90 mw8 mb2 center tr">
  <label class="fw3 f7 uppercase mr1 ttu">Billing yearly (20% discount)</label>
  <button id="billing-toggle" type="button" class="btn btn-sm btn-toggle" data-toggle="button" aria-pressed="true" autocomplete="off">
    <div class="handle"></div>
  </button>
  <script>
        var plans = {
            commercial: {
                monthly: 449.00,
                yearly: 359.00
            },
            performance: {
                monthly: 1749.00,
                yearly: 1399.00
            }
        }

        $(document).ready(function () {
            var billingPeriods = $('.billing-period');
            var commercialPrice = $('#commercial-price');
            var performancePrice = $('#performance-price');

            $('#billing-toggle').on('click', function () {
                var isYearly = !$(this).hasClass('active');

                if (isYearly) {
                    billingPeriods.text('yearly');
                    commercialPrice.text(plans.commercial.yearly);
                    performancePrice.text(plans.performance.yearly);
                } else {
                    billingPeriods.text('monthly');
                    commercialPrice.text(plans.commercial.monthly);
                    performancePrice.text(plans.performance.monthly);
                }
            })
        })
  </script>
</div>

