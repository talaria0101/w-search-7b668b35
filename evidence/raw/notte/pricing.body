  (function() {
    function updateTheme(theme) {
      var classList = document.documentElement.classList;
      classList.remove("light", "dark", "system");
      if (theme === 'dark') {
        classList.add('dark');
      } else if (theme === 'light') {
        classList.add('light');
      } else {
        classList.add('system');
      }
    }

    // Expose for programmatic use from other scripts
    if (!window._updateTheme) {
      window._updateTheme = updateTheme;
    }

    // The main page is always dark. Paint the background immediately —
    // before any CSS loads or React runs — so there is never a white frame.
    // We clear any stale localStorage value written by previous versions of
    // this script that forced 'light' on every load.
    try {
      localStorage.removeItem('currentTheme');
    } catch (_) {}

    updateTheme('dark');
    document.documentElement.style.backgroundColor = '#09090b';
    document.body && (document.body.style.backgroundColor = '#09090b');
  })();
</script><script type="application/ld+json">{"@context":"https://schema.org","@type":"WebSite","name":"Notte","url":"https://www.notte.cc"}</script><script type="application/ld+json">{"@context":"https://schema.org","@type":"Organization","name":"Notte","url":"https://www.notte.cc","logo":"https://www.notte.cc/images/og-image.png","sameAs":["https://github.com/nottelabs/notte","https://x.com/nottecore","https://linkedin.com/company/notte"]}</script><script type="application/ld+json">{"@context":"https://schema.org","@type":"SoftwareApplication","name":"Notte","applicationCategory":"DeveloperApplication","operatingSystem":"Web","url":"https://www.notte.cc","description":"Full-stack browser infrastructure for AI agents. Includes Browser Sessions, Browser Agents, and Browser Functions.","featureList":["Browser Sessions — Instant, stateless browser instances on a global edge network for zero-latency automation","Browser Agents — AI workers that handle complex navigation and extraction from a single prompt","Browser Functions — Serverless logic colocated with the browser, deployed to the edge"],"offers":{"@type":"Offer","price":"0","priceCurrency":"USD"}}</script><script src="/_next/static/immutable/chunks/0c0hxoamwjsbw.js" noModule=""></script></head><body class="_0z1v7q_variable syBX4W_variable wDcTQW_variable font-sans font-light h-full" style="background-color:#000"><div hidden=""><!--$--><!--/$--></div><a href="#main-content" class="sr-only focus:not-sr-only focus:absolute focus:z-100 focus:top-4 focus:left-4 focus:px-4 focus:py-2 focus:bg-white focus:text-black focus:rounded-md focus:text-sm focus:font-medium">Skip to main content</a><div class="min-h-screen flex flex-col bg-[#f5f5f4] font-sans selection:bg-brand-500 selection:text-black"><div class="hidden md:flex fixed bottom-8 left-1/2 -translate-x-1/2 z-59 items-center gap-2 px-4 py-2 rounded-full cursor-pointer transition-all duration-300 group bg-notte-900 border border-notte-800 shadow-[0_2px_20px_rgba(0,0,0