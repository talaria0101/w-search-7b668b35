),transparent_70%)] blur-2xl"></div><div class="absolute inset-0 shadow-[inset_-80px_-80px_200px_rgba(0,0,0,0.9)]"></div></div></div></div></div></section><div class="w-full bg-[#f0f7ff] border-y border-[#bfdbfe] relative"><div class="absolute inset-0 opacity-[0.25] pointer-events-none mix-blend-multiply" style="background-image:url(&quot;data:image/svg+xml,%3Csvg viewBox=&#x27;0 0 200 200&#x27; xmlns=&#x27;http://www.w3.org/2000/svg&#x27;%3E%3Cfilter id=&#x27;noiseFilter&#x27;%3E%3CfeTurbulence type=&#x27;fractalNoise&#x27; baseFrequency=&#x27;0.85&#x27; numOctaves=&#x27;3&#x27; stitchTiles=&#x27;stitch&#x27;/%3E%3C/filter%3E%3Crect width=&#x27;100%25&#x27; height=&#x27;100%25&#x27; filter=&#x27;url(%23noiseFilter)&#x27;/%3E%3C/svg%3E&quot;)"></div></div><div class="w-screen relative left-[50%] right-[50%] ml-[-50vw] mr-[-50vw] bg-[#f5f5f4] border-t border-[#d6d3d1] relative overflow-hidden"><div class="absolute inset-0 opacity-[0.4] pointer-events-none" style="filter:contrast(120%) brightness(100%);background-image:url(&quot;data:image/svg+xml,%3Csvg viewBox=&#x27;0 0 200 200&#x27; xmlns=&#x27;http://www.w3.org/2000/svg&#x27;%3E%3Cfilter id=&#x27;noiseFilter&#x27;%3E%3CfeTurbulence type=&#x27;fractalNoise&#x27; baseFrequency=&#x27;0.8&#x27; numOctaves=&#x27;3&#x27; stitchTiles=&#x27;stitch&#x27;/%3E%3C/filter%3E%3Crect width=&#x27;100%25&#x27; height=&#x27;100%25&#x27; filter=&#x27;url(%23noiseFilter)&#x27; opacity=&#x27;0.5&#x27;/%3E%3C/svg%3E&quot;)"></div><section class="relative z-10 py-16 md:py-24 px-4 md:px-6 w-full max-w-6xl mx-auto"><div class="mb-10 md:mb-16"><h2 class="text-[#09090b] text-3xl md:text-6xl/none font-light font-serif tracking-tight leading-[1.1] mb-3 md:mb-4">Built for developers</h2><p class="text-notte-600 text-sm md:text-lg font-light">The complete stack for developers to quickly automate the web.</p></div><div class="grid grid-cols-1 lg:grid-cols-12 gap-12 lg:gap-24"><div class="lg:col-span-5 relative flex flex-col gap-3"><button class="group relative w-full flex flex-col items-start text-left rounded-xl border cursor-pointer p-3.5 md:p-5 transition-[background-color,border-color,box-shadow] duration-200 ease-out bg-white border-[#d6d3d1] shadow-md"><span class="text-xs font-mono uppercase tracking-wider mb-1.5 transition-colors duration-200 text-[#059669]">0<!-- -->1<!-- --> — <!-- -->The Baseline</span><h3 class="text-lg font-medium transition-colors duration-200 text-[#09090b]">Browser Sessions</h3><div class="grid transition-[grid-template-rows,opacity] duration-300 ease-out" style="grid-template-rows:1fr;opacity:1;margin-top:12px;transition:grid-template-rows 300ms ease-out, opacity 200ms ease-out, margin-top 300ms ease-out"><div class="overflow-hidden"><p class="text-sm leading-relaxed text-notte-600">Instant, stateless browser instances. Built on a global edge network for zero-latency automation.</p></div></div></button><button class="group relative w-full flex flex-col items-start text-left rounded-xl border cursor-pointer p-3.5 md:p-5 transition-[background-color,border-color,box-shadow] duration-200 ease-out bg-[#f5f2ef] border-[#e0ddd9] hover:bg-[#f0ede9] shadow-xs"><span class="text-xs font-mono uppercase tracking-wider mb-1.5 transition-colors duration-200 text-[#a8a29e] group-hover:text-[#059669]/60">0<!-- -->2<!-- --> — <!-- -->The Intelligence</span><h3 class="text-lg font-medium transition-colors duration-200 text-[#78716c] group-hover:text-[#09090b]">Browser Agents</h3><div class="grid transition-[grid-template-rows,opacity] duration-300 ease-out" style="grid-template-rows:0fr;opacity:0;margin-top:0;transition:grid-template-rows 300ms ease-out, opacity 200ms ease-out, margin-top 300ms ease-out"><div class="overflow-hidden"><p class="text-sm leading-relaxed text-notte-600">State-of-the-art AI workers. Give them a goal, and they handle the complex navigation and extraction.</p></div></div></button><button class="group relative w-full flex flex-col items-start text-left rounded-xl border cursor-pointer p-3.5 md:p-5 transition-[background-color,border-color,box-shadow] duration-200 ease-out bg-[#f5f2ef] border-[#e0ddd9] hover:bg-[#f0ede9] shadow-xs"><span class="text-xs font-mono uppercase tracking-wider mb-1.5 transition-colors duration-200 text-[#a8a29e] group-hover:text-[#059669]/60">0<!-- -->3<!-- --> — <!-- -->The Runtime</span><h3 class="text-lg font-medium transition-colors duration-200 text-[#78716c] group-hover:text-[#09090b]">Browser Functions</h3><div class="grid transition-[grid-template-rows,opacity] duration-300 ease-out" style="grid-template-rows:0fr;opacity:0;margin-top:0;transition:grid-template-rows 300ms ease-out, opacity 200ms ease-out, margin-top 300ms ease-out"><div class="overflow-hidden"><p class="text-sm leading-relaxed text-notte-600">Serverless logic colocated with the browser. Deploy your scripts to the edge for maximum performance.</p></div></div></button></div><div class="lg:col-span-7 flex flex-col items-start"><div class="w-full relative rounded-lg overflow-hidden border border-[#d6d3d1] bg-white shadow-xs"><div class="bg-[#f0ede9]"><div class="flex items-center justify-between px-4 pt-2.5 pb-0"><div class="flex items-center gap-2 pb-2"><div class="w-2.5 h-2.5 rounded-full bg-[#d6d3d1]"></div><div class="w-2.5 h-2.5 rounded-full bg-[#d6d3d1]"></div><div class="w-2.5 h-2.5 rounded-full bg-[#d6d3d1]"></div></div><div class="flex items-end gap-0"><button class="text-[10px] md:text-[11px] font-mono px-2 md:px-4 py-1 md:py-1.5 transition-colors relative bg-white text-[#09090b] rounded-t-md border-t border-x border-[#d6d3d1]">cdp.py</button><button class="text-[10px] md:text-[11px] font-mono px-2 md:px-4 py-1 md:py-1.5 transition-colors relative text-[#78716c] hover:text-[#09090b]">controls.py</button></div></div><div class="h-px bg-[#d6d3d1]"></div></div><div class="relative min-h-[200px] md:min-h-[300px] overflow-x-auto [&amp;_pre]:text-[11px]! [&amp;_pre]:leading-relaxed! [&amp;_pre]:p-3! md:[&amp;_pre]:text-sm! md: