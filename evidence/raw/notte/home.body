roup-hover:text-brand-500 transition-colors" fill="currentColor" viewBox="0 0 24 24"><path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"></path></svg></div></a></div></div></div><div id="anything-api" class="min-h-screen py-12 px-4 md:py-24 md:px-6 bg-[#000080] relative flex justify-center items-center overflow-hidden"><div class="absolute inset-0 opacity-20" style="background-image:radial-gradient(#fff 1px, transparent 0);background-size:4px 4px"></div><div class="absolute inset-0" style="background:radial-gradient(ellipse 50% 60% at 50% 50%, #000080 0%, transparent 100%)"></div><div class="relative z-10 max-w-6xl mx-auto grid grid-cols-1 lg:grid-cols-2 gap-12 lg:gap-16 items-center"><div class="text-center lg:text-left space-y-6"><span class="bg-white text-[#000080] px-3 py-1.5 font-mono text-sm tracking-widest uppercase inline-block">SPINOFF : NEW SKILL UNLOCKED !</span><h3 class="text-white text-4xl md:text-6xl"><span class="font-serif italic">API</span> for<!-- --> <span class="font-serif italic">Anything.</span></h3><p class="text-white/80 font-mono text-base leading-relaxed">Describe the task. We engineer the skill. Your agent calls it.</p><div class="grid grid-cols-3 mt-6 max-lg:mb-0 divide-x divide-white/20 border border-white/20"><div class="px-4 py-5 space-y-2"><span class="text-white/40 font-mono text-xs block">01</span><p class="text-white font-mono text-sm">Describe the task</p><p class="text-white/60 font-mono text-xs leading-relaxed">Any workflow, any site.</p></div><div class="px-4 py-5 space-y-2"><span class="text-white/40 font-mono text-xs block">02</span><p class="text-white font-mono text-sm">We engineer it</p><p class="text-white/60 font-mono text-xs leading-relaxed">No agent improvising.</p></div><div class="px-4 py-5 space-y-2"><span class="text-white/40 font-mono text-xs block">03</span><p class="text-white font-mono text-sm">Your agent calls it</p><p class="text-white/60 font-mono text-xs leading-relaxed">One clean API endpoint.</p></div></div><div class="hidden lg:flex items-center gap-4 pt-4"><a href="https://anything.notte.cc" target="_blank" rel="noopener noreferrer" class="px-6 py-2.5 font-mono text-sm text-white/60 border border-white/20 hover:border-white/50 hover:text-white/80 transition-colors">Read More</a><a href="https://anything.notte.cc" target="_blank" rel="noopener noreferrer" class="px-6 py-2.5 font-mono text-sm text-[#000080] bg-white hover:bg-[#e0e0e0] transition-colors">Try Anything API</a></div></div><div class="w-full bg-white/10 backdrop-blur-xs border border-white/20 divide-y divide-white/15 overflow-hidden text-left font-mono text-sm"><div class="px-5 py-4"><p class="text-white/40 text-xs uppercase tracking-wider mb-2">Input</p><p class="text-white"><span class="text-white/50">$</span> <!-- -->&quot;Get listing details for any Airbnb URL&quot;</p></div><div class="px-5 py-4"><p class="text-white/40 text-xs uppercase tracking-wider mb-2">API Endpoint</p><p class="text-white"><span class="font-bold">POST</span> <!-- -->api.notte.cc/functions/run</p></div><div class="px-5 py-4"><p class="text-white/40 text-xs uppercase tracking-wider mb-2">Response</p><pre class="text-white text-xs leading-relaxed">{
