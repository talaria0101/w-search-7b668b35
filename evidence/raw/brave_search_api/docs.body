="currentColor" fill-rule="evenodd" d="M12.566 15.316a.8.8 0 0 1-1.132 0l-5.5-5.5a.8.8 0 1 1 1.132-1.132L12 13.62l4.934-4.935a.8.8 0 1 1 1.132 1.132z" clip-rule="evenodd"/><!----></svg><!----></button><!--]--></div> <div id="s1" class="actions-menu svelte-12zl4s3" popover=""><button type="button" class="action-item svelte-12zl4s3"><svg xmlns="http://www.w3.org/2000/svg" fill="none" class="icon" viewBox="0 0 24 24"><!----><path fill="currentColor" fill-rule="evenodd" d="M2.5 5.702A3.2 3.2 0 0 1 5.702 2.5h8.66a3.2 3.2 0 0 1 3.202 3.202v1.522h.734a3.2 3.2 0 0 1 3.202 3.201v7.873a3.2 3.2 0 0 1-3.202 3.202h-7.873a3.2 3.2 0 0 1-3.201-3.202v-.734H5.702A3.2 3.2 0 0 1 2.5 14.362zm4.724 10.182v-5.459a3.2 3.2 0 0 1 3.201-3.201h5.459V5.702c0-.841-.681-1.522-1.522-1.522h-8.66c-.841 0-1.522.681-1.522 1.522v8.66c0 .84.681 1.522 1.522 1.522zm3.201-6.98c-.84 0-1.522.68-1.522 1.521v7.873c0 .841.682 1.522 1.522 1.522h7.873c.841 0 1.522-.681 1.522-1.522v-7.873c0-.84-.681-1.522-1.522-1.522z" clip-rule="evenodd"/><!----></svg><!----> <div class="action-text svelte-12zl4s3"><span class="action-label desktop-small-semibold svelte-12zl4s3">Copy page</span> <span class="action-desc desktop-xsmall-regular svelte-12zl4s3">Copy page as Markdown for LLMs</span></div></button> <!--[--><!--[1--><button type="button" class="action-item svelte-12zl4s3"><!--[0--><!--[--><svg xmlns="http://www.w3.org/2000/svg" fill="none" class="icon" viewBox="0 0 24 24"><!----><path fill="currentColor" fill-rule="evenodd" d="M2.5 5.702A3.2 3.2 0 0 1 5.702 2.5h8.66a3.2 3.2 0 0 1 3.202 3.202v1.522h.734a3.2 3.2 0 0 1 3.202 3.201v7.873a3.2 3.2 0 0 1-3.202 3.202h-7.873a3.2 3.2 0 0 1-3.201-3.202v-.734H5.702A3.2 3.2 0 0 1 2.5 14.362zm4.724 10.182v-5.459a3.2 3.2 0 0 1 3.201-3.201h5.459V5.702c0-.841-.681-1.522-1.522-1.522h-8.66c-.841 0-1.522.681-1.522 1.522v8.66c0 .84.681 1.522 1.522 1.522zm3.201-6.98c-.84 0-1.522.68-1.522 1.521v7.873c0 .841.682 1.522 1.522 1.522h7.873c.841 0 1.522-.681 1.522-1.522v-7.873c0-.84-.681-1.522-1.522-1.522z" clip-rule="evenodd"/><!----></svg><!--]--><!--]--> <div class="action-text svelte-12zl4s3"><span class="action-label desktop-small-semibold svelte-12zl4s3">Copy markdown URL</span> <span class="action-desc desktop-xsmall-regular svelte-12zl4s3">Copy the markdown URL for this page</span></div></button><!--]--><!--]--> <!----></div></div><!--]--><!--]--><!----></div><!--]--></div> <!--[0--><hr class="header-area-divider svelte-a6y2az" aria-hidden="true"/><!--]--></div><!----> <main class="docs-content mt-3xl"><p class="desktop-large-regular t-secondary">The Brave Search API gives you access to the same powerful, independent search index
that powers Brave Search - the privacy-first search engine trusted by millions. Built
from the ground up without relying on Google or Bing, our API delivers unbiased,
high-quality search results for your applications.</p> <p class="desktop-large-regular t-secondary">With comprehensive coverage across web search, news, images, videos, and advanced AI
capabilities, the Brave Search API provides everything you need to build privacy-respecting
search experiences.</p> <!----><a href="/documentation/quickstart" class="info-card svelte-1082ajj horizontal"><!--[0--><div class="card-icon-container svelte-1082ajj"><!--[1--><div class="card-icon svelte-1082ajj"><!--[--><!--]--></div><!--]--><!----> <!--[-1--><!--]--></div><!--]--> <div class="card-content desktop-default-regular t-tertiary svelte-1082ajj"><h2 class="desktop-heading-h4 t-primary mb-0">Get started</h2> <p class="desktop-large-regular t-secondary">Get your API key and make your first request in minutes.</p><!----></div> <!--[0--><div class="card-icon-secondary svelte-1082ajj"><!--[0--><svg xmlns="http://www.w3.org/2000/svg" fill="none" class="icon" viewBox="0 0 24 24"><!----><path fill="currentColor" fill-rule="evenodd" d="M16.299 12.833H4.833a.833.833 0 0 1 0-1.666H16.3l-5.656-5.221a.833.833 0 1 1 1.13-1.225l6.78 6.258a1.39 1.39 0 0 1 0 2.042l-6.78 6.258a.833.833 0 1 1-1.13-1.225z" clip-rule="evenodd"/><!----></svg><!--]--></div><!--]--><!----></a><!----><!----><h2 class="desktop-heading-h2 t-secondary" id="which-search">Which search?</h2> <p class="desktop-large-regular t-secondary">Choose the right search API for your use case to access our comprehensive search index.</p> <h3 class="desktop-heading-h3 t-secondary" id="search-for-information">Search for information</h3> <p class="desktop-large-regular t-secondary">Classic web search in two flavors, for <em>agents</em> and <em>humans</em>.</p> <div class="columns mb-2xl svelte-ea35yd cols-2"><!----><a href="/documentation/services/llm-context" class="info-card svelte-1082ajj vertical"><!--[0--><div class="card-icon-container svelte-1082ajj"><!--[1--><div class="card-icon svelte-1082ajj"><!--[--><!--]--></div><!--]--><!----> <!--[0--><div class="card-icon-secondary svelte-1082ajj"><!--[0--><svg xmlns="http://www.w3.org/2000/svg" fill="none" class="icon" viewBox="0 0 24 24"><!----><path fill="currentColor" fill-rule="evenodd" d="M16.299 12.833H4.833a.833.833 0 0 1 0-1.666H16.3l-5.656-5.221a.833.833 0 1 1 1.13-1.225l6.78 6.258a1.39 1.39 0 0 1 0 2.042l-6.78 6.258a.833.833 0 1 1-1.13-1.225z" clip-rule="evenodd"/><!----></svg><!--]--></div><!--]--></div><!--]--> <div class="card-content desktop-default-regular t-tertiary svelte-1082ajj"><h2 class="desktop-heading-h4 t-primary mb-0">LLM Context</h2> <p class="desktop-large-regular t-secondary">Search for <em>AI agents</em>. Pre-extracted page content for your LLM — no scraping,
token-budgeted. This is the default for RAG, tools, and chatbots.</p><!----></div> <!--[-1--><!--]--><!----></a><!----><!----> <!----><a href="/documentation/services/web-search" class="info-card svelte-1082ajj vertical"><!--[0--><div class="card-icon-container svelte-1082ajj"><!--[1--><div class="card-icon svelte-1082ajj"><!--[--><!--]--></div><!--]--><!----> <!--[0--><div class="card-icon-secondary svelte-1082ajj"><!--[0--><svg xmlns="http://www.w3.org/2000/svg" fill="none" class="icon" viewBox="0 0 24 24"><!----><path fill="currentColor" fill-rule="evenodd" d="M16.299 12.833H4.833a.833.833 0 0 1 0-1.666H16.3l-5.656-5.221a.833.833 0 1 1 1.13-1.225l6.78 6.258a1.39 1.39 0 0 1 0 2.042l-6.78 6.258a.833.833 0 1 1-1.13-1.225z" clip-rule="evenodd"/><!----></svg><!--]--></div><!--]--></div><!--]--> <div class="card-content desktop-default-regular t-tertiary svelte-1082ajj"><h2 class="desktop-heading-h4 t-primary mb-0">Web Search</h2> <p class="desktop-large-regular t-secondary">Search for <em>humans</em>. Ranked titles, URLs, and short snippets for a results
page, plus local and rich enrichments.</p><!----></div> <!--[-1--><!--]--><!----></a><!----><!----><!----></div><!----><h3 class="desktop-heading-h3 t-secondary" id="search-for-specialized-content">Search for specialized content</h3> <p class="desktop-large-regular t-secondary">Use specialized APIs for dedicated content, like news, images, videos, and places.</p> <div class="columns mb-2xl svelte-ea35yd cols-2"><!----><a href="/documentation/services/news-search" class="info-card svelte-1082ajj vertical"><!--[0--><div class="card-icon-container svelte-1082ajj"><!--[1--><div class="card-icon svelte-1082ajj"><!--[--><!--]--></div><!--]--><!----> <!--[0--><div class="card-icon-secondary svelte-1082ajj"><!--[0--><svg xmlns="http://www.w3.org/2000/svg" fill="none" class="icon" viewBox="0 0 24 24"><!----><path fill="currentColor" fill-rule="evenodd" d="M16.299 12.833H4.833a.833.833 0 0 1 0-1.666H16.3l-5.656-5.221a.833.833 0 1 1 1.13-1.225l6.78 6.258a1.39 1.39 0 0 1 0 2.042l-6.78 6.258a.833.833 0 1 1-1.13-1.225z" clip-rule="evenodd"/><!----></svg><!--]--></div><!--]--></div><!--]--> <div class="card-content desktop-default-regular t-tertiary svelte-1082ajj"><h2 class="desktop-heading-h4 t-primary mb-0">News Search</h2> <p class="desktop-large-regular t-secondary">Get real-time news articles from thousands of trusted sources worldwide.</p><!----></div> <!--[-1--><!--]--><!----></a><!----><!----> <!----><a href="/documentation/services/image-search" class="info-card svelte-1082ajj vertical"><!--[0--><div class="card-icon-container svelte-1082ajj"><!--[1--><div class="card-icon svelte-1082ajj"><!--[--><!--]--></div><!--]--><!----> <!--[0--><div class="card-icon-secondary svelte-1082ajj"><!--[0--><svg xmlns="http://www.w3.org/2000/svg" fill="none" class="icon" viewBox="0 0 24 24"><!----><path fill="currentColor" fill-rule="evenodd" d="M16.299 12.833H4.833a.833.833 0 0 1 0-1.666H16.3l-5.656-5.221a.833.833 0 1 1 1.13-1.225l6.78 6.258a1.39 1.39 0 0 1 0 2.042l-6.78 6.258a.833.833 0 1 1-1.13-1.225z" clip-rule="evenodd"/><!----></svg><!--]--></div><!--]--></div><!--]--> <div class="card-content desktop-default-regular t-tertiary svelte-1082ajj"><h2 class="desktop-heading-h4 t-primary mb-0">Image Search</h2> <p class="desktop-large-regular t-secondary">Search through billions of images with advanced filtering and SafeSearch
options.</p><!----></div> <!--[-1--><!--]--><!----></a><!----><!----> <!----><a href="/documentation/services/video-search" class="info-card svelte-1082ajj vertical"><!--[0--><div class="card-icon-container svelte-1082ajj"><!--[1--><div class="card-icon svelte-1082ajj"><!--[--><!--]--></div><!--]--><!----> <!--[0--><div class="card-icon-secondary svelte-1082ajj"><!--[0--><svg xmlns="http://www.w3.org/2000/svg" fill="none" class="icon" viewBox="0 0 24 24"><!----><path fill="currentColor" fill-rule="evenodd" d="M16.299 12.833H4.833a.833.833 0 0 1 0-1.666H16.3l-5.656-5.221a.833.833 0 1 1 1.13-1.225l6.78 6.258a1.39 1.39 0 0 1 0 2.042l-6.78 6.258a.833.833 0 1 1-1.13-1.225z" clip-rule="evenodd"/><!----></svg><!--]--></div><!--]--></div><!--]--> <div class="card-content desktop-default-regular t-tertiary svelte-1082ajj"><h2 class="desktop-heading-h4 t-primary mb-0">Videos Search</h2> <p class="desktop-large-regular t-secondary">Find video content from across the web with metadata and thumbnails.</p><!----></div> <!--[-1--><!--]--><!----></a><!----><!----> <!----><a href="/documentation/services/place-search" class="info-card svelte-1082ajj vertical"><!--[0--><div class="card-icon-container svelte-1082ajj"><!--[1--><div class="card-icon svelte-1082ajj"><!--[--><!--]--></div><!--]--><!----> <!--[0--><div class="card-icon-secondary svelte-1082ajj"><!--[0--><svg xmlns="http://www.w3.org/2000/svg" fill="none" class="icon" viewBox="0 0 24 24"><!----><path fill="currentColor" fill-rule="evenodd" d="M16.299 12.833H4.833a.833.833 0 0 1 0-1.666H16.3l-5.656-5.221a.833.833 0 1 1 1.13-1.225l6.78 6.258a1.39 1.39 0 0 1 0 2.042l-6.78 6.258a.833.833 0 1 1-1.13-1.225z" clip-rule="evenodd"/><!----></svg><!--]--></div><!--]--></div><!--]--> <div class="card-content desktop-default-regular t-tertiary svelte-1082ajj"><h2 class="desktop-heading-h4 t-primary mb-0">Place Search</h2> <p class="desktop-large-regular t-secondary">Find geographic places — businesses, landmarks, POIs, cities, addresses, and more.</p><!----></div> <!--[-1--><!--]--><!----></a><!----><!----><!----></div><!----><h3 class="desktop-heading-h3 t-secondary" id="ai-powered-features">AI-Powered Features</h3> <p class="desktop-large-regular t-secondary">Enhance your applications with advanced AI capabilities.</p> <div class="columns mb-2xl svelte-ea35yd"><!----><a href="/documentation/services/answers" class="info-card svelte-1082ajj vertical"><!--[0--><div class="card-icon-container svelte-1082ajj"><!--[1--><div class="card-icon svelte-1082ajj"><!--[--><!--]--></div><!--]--><!----> <!--[0--><div class="card-icon-secondary svelte-1082ajj"><!--[0--><svg xmlns="http://www.w3.org/2000/svg" fill="none" class="icon" viewBox="0 0 24 24"><!----><path fill="currentColor" fill-rule="evenodd" d="M16.299 12.833H4.833a.833.833 0 0 1 0-1.666H16.3l-5.656-5.221a.833.833 0 1 1 1.13-1.225l6.78 6.258a1.39 1.39 0 0 1 0 2.042l-6.78 6.258a.833.833 0 1 1-1.13-1.225z" clip-rule="evenodd"/><!----></svg><!--]--></div><!--]--></div><!--]--> <div class="card-content desktop-default-regular t-tertiary svelte-1082ajj"><h2 class="desktop-heading-h4 t-primary mb-0">Answers</h2> <p class="desktop-large-regular t-secondary">AI-generated answers backed by real-time web search and verifiable sources.</p><!----></div> <!--[-1--><!--]--><!----></a><!----><!----></div><!----><h2 class="desktop-heading-h2 t-secondary" id="why-brave-search-api">Why Brave Search API?</h2> <div class="columns mb-2xl svelte-ea35yd cols-3"><!----><div class="info-card svelte-1082ajj vertical"><!--[1--><div class="card-icon-floating svelte-1082ajj"><!--[1--><div class="card-icon svelte-1082ajj"><!--[--><!--]--></div><!--]--><!----></div><!--]--> <div class="card-content desktop-default-regular t-tertiary svelte-1082ajj"><h2 class="desktop-heading-h4 t-primary mb-0">Independent Index</h2> <p class="desktop-large-regular t-secondary">Our own search index means no dependence on Big Tech and no hidden biases.</p><!----></div> <!--[-1--><!--]--><!----></div><!----><!----> <!----><div class="info-card svelte-1082ajj vertical"><!--[1--><div class="card-icon-floating svelte-1082ajj"><!--[1--><div class="card-icon svelte-1082ajj"><!--[--><!--]--></div><!--]--><!----></div><!--]--> <div class="card-content desktop-default-regular t-tertiary svelte-1082ajj"><h2 class="desktop-heading-h4 t-primary mb-0">Privacy-First</h2> <p class="desktop-large-regular t-secondary">Built with privacy at the core. No user tracking or profiling.</p><!----></div> <!--[-1--><!--]--><!----></div><!----><!----> <!----><div class="info-card svelte-1082ajj vertical"><!--[1--><div class="card-icon-floating svelte-1082ajj"><!--[1--><div class="card-icon svelte-1082ajj"><!--[--><!--]--></div><!--]--><!----></div><!--]--> <div class="card-content desktop-default-regular t-tertiary svelte-1082ajj"><h2 class="desktop-heading-h4 t-primary mb-0">High Quality</h2> <p class="desktop-large-regular t-secondary">Comprehensive coverage with billions of pages indexed and updated in
