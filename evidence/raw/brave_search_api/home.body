                <script type="application/ld+json">
[
  {
    "@context": "https://schema.org",
    "@type": ["Product", "WebAPI"],
    "name": "Brave Search API",
    "url": "https://brave.com/search/api/",
    "image": "https://brave.com/search/api/images/search-api-og.png",
    "description": "A privacy-preserving web search API for developers and AI applications. Access fresh, independent search results with no user tracking, SOC 2 compliance, and Zero Data Retention options.",
    "documentation": "https://api-dashboard.search.brave.com/app/documentation/web-search/get-started",
    "brand": {
      "@type": "Brand",
      "name": "Brave"
    },
    "offers": [
      {
        "@type": "Offer",
        "name": "Free Credits",
        "price": "0",
        "priceCurrency": "USD",
        "description": "Up to thousands of free queries per month, depending on plan",
        "availability": "https://schema.org/InStock",
        "itemCondition": "https://schema.org/NewCondition"
      },
      {
        "@type": "Offer",
        "name": "Search Plan",
        "priceCurrency": "USD",
        "description": "$5 per 1,000 requests. Up to 50 queries per second.",
        "availability": "https://schema.org/InStock",
        "itemCondition": "https://schema.org/NewCondition"
      },
      {
        "@type": "Offer",
        "name": "Answers Plan",
        "priceCurrency": "USD",
        "description": "$4 per 1,000 requests + $5 per million input/output tokens. Up to 2 queries per second.",
        "availability": "https://schema.org/InStock",
        "itemCondition": "https://schema.org/NewCondition"
      }
    ],
    "provider": {
      "@type": "Organization",
      "name": "Brave Software",
      "url": "https://brave.com"
    }
  },
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    "mainEntity": [
      {
        "@type": "Question",
        "name": "What is the Brave Search API?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "The Brave Search API is a developer tool for building applications with data from the Web. It is powered by Brave's independent Web index, the same index that powers Brave Search. It is commonly used in traditional search engine products, AI search engines, AI training, and agentic (autonomous AI) search."
        }
      },
      {
        "@type": "Question",
        "name": "Why is a credit card required when I only plan to use the free credits?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "The credit card requirement serves as an anti-fraud measure to protect Brave from bad actors who want to abuse the API. For users who only plan to use the free monthly credits, the card is only used to confirm your identity and will not be charged."
        }
      },
      {
        "@type": "Question",
        "name": "What other web search API options can the Brave Search API complement or replace?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "The Brave Search API can replace several competing options that may have smaller indexes (Tavily or Exa), higher latencies (SerpAPI or Serper), or more limited access (Google and Bing). It can also serve as a complement to localized API options like Baidu, Naver, Yahoo, and Yandex. The Brave Search API is powered by Brave Search, a completely independent index of the Web, which is tuned to reduce SEO spam and increase quality and recency of results."
        }
      },
      {
        "@type": "Question",
        "name": "Where does the data come from?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "Every search engine that has its own index necessarily has its own Web crawler. The Brave Search crawler does not advertise a differentiated user-agent because it must avoid discrimination from websites that allow only Google to crawl them. However, if a domain or page is not crawlable by any search engine (for example, because it has a noindex tag), or if it is not crawlable by Googlebot, then Brave Search's bot will not crawl it either. Brave Search is also built on more than just Web crawlers: its privacy-preserving Web Discovery Project (WDP) allows Brave browser users to opt in and contribute data about searches and webpage visits. This level of voluntary human contribution to an index is unique in the world of API search and training data. WDP uses several privacy safeguards to prevent Brave from knowing who is contributing what, and the code is open-source for auditing by anyone."
        }
      },
      {
        "@type": "Question",
        "name": "What are the key benefits of the Brave Search API?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "The Brave Search API offers world-class search engine capabilities at a significantly lower cost than other Search and AI Search APIs. The data is fresh, high-quality, and scales with small to large businesses. The Brave Search API is provisioned to manage thousands of requests per second (and growing) and offers customers the speed and reliability necessary for applications with millions of users around the world. Importantly, the Brave Search API is not a scraper that uses bots to query Google or Bing and repackage their results — it is an independent index of the Web with its own ranking models."
        }
      },
      {
        "@type": "Question",
        "name": "Does the Brave Search API surface recent events?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "Yes. Brave Search fetches millions of webpages every day, offering extensive coverage of recent events around the world."
        }
      },
      {
        "@type": "Question",
        "name": "Can I store results retrieved from the Brave Search API?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "If you would like to store the API results in part or whole (for example, to train or tune an LLM), you will need to subscribe to a plan that explicitly grants storage rights. Plans with storage rights grant special permissions which are not covered in the general Terms of Service."
        }
      },
      {
        "@type": "Question",
        "name": "What about copyright?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "Brave Search API offers a ranked list of webpages that are publicly available, including information to support why the webpage is relevant to the query (for instance, via query-dependent snippets based on the content of the webpage). The Brave Search API does not grant any rights to third-party content such as webpages. Customers who access URLs displayed in the Brave Search API must ensure their access to those webpages complies with the copyright terms of the page publishers."
        }
      },
      {
        "@type": "Question",
        "name": "Does the Brave Search API follow security and privacy best practices?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "Yes. The Brave Search API is SOC 2 Type II attested, with its strict security and privacy controls independently verified by a third-party auditor. It also offers Zero Data Retention (ZDR), meaning companies can meet growing compliance obligations. For full details, see the API privacy and security help page at api-dashboard.search.brave.com/documentation/resources/security."
        }
      }
    ]
  },
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [
      {
        "@type": "ListItem",
        "position": 1,
        "name": "Home",
        "item": "https://brave.com/"
      },
      {
        "@type": "ListItem",
        "position": 2,
        "name": "Search API",
        "item": "https://brave.com/search/api/"
      }
    ]
  },
  {
    "@context": "https://schema.org",
    "@type": "WebPage",
    "name": "Brave Search API — Privacy-First Web Search for Developers",
    "url": "https://brave.com/search/api/",
    "description": "Access Brave's independent web search index via API. Built for AI agents, RAG pipelines, and developers who need fresh, private, unbiased search results.",
    "breadcrumb": {
      "@type": "BreadcrumbList",
      "itemListElement": [
        {
          "@type": "ListItem",
          "position": 1,
          "name": "Home",
          "item": "https://brave.com/"
        },
        {
          "@type": "ListItem",
