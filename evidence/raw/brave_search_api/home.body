<section class="grid lg:grid-cols-2 lg:items-stretch gap-8 grid-cols-1 lg:gap-12">
  <div class="">
    <h2 class="max-lg:text-desktop-h4 md:max-lg:text-desktop-h3 lg:text-display-mobile-h2 xl:text-display-desktop-h4">One key. Every endpoint. The entire index.</h2><div class="pt-4 text-default md:text-desktop-default [&_p+p]:pt-4 [&_a]:text-text-interactive"><p>Get LLM Context for agent search. Human-readable web search. News, images, videos, and Places / POIs. And more.</p>
<p>All in a single API.</p>
</div><div class="flex flex-wrap items-center gap-x-4 gap-y-3 pt-6"><a
            href="https://api-dashboard.search.brave.com/register"
            class="leoButton isFilled isLarge w-fit no-underline" data-preserve-mtm-params
            
              data-track-event
              data-event-category="Search API redesign page CTAs"
              data-event-action="Get my API key button click"
              data-event-name="Get my API key button"
            
          >Get my API key</a><a
            href="https://api-dashboard.search.brave.com/documentation/services/llm-context"
            class="leoButton isOutline isLarge w-fit no-underline" data-preserve-mtm-params target="_blank" rel="noopener noreferrer"
            
              data-track-event
              data-event-category="Search API redesign page CTAs"
              data-event-action="Read the docs (hero) button click"
              data-event-name="Read the docs (hero) button"
            
          >Read the docs</a></div></div>
    <div class="min-w-0 md:flex md:flex-col [&_pre]:overflow-x-hidden [&_pre]:m-0 [&_code]:whitespace-pre [&_.line]:[clip-path:inset(0_0_0_-1.5rem)] md:[&_.highlight]:flex md:[&_.highlight]:min-w-0 md:[&_.highlight]:grow md:[&_.highlight]:flex-col md:[&_pre]:grow">
      <div class="highlight"><pre tabindex="0" class="chroma"><code class="language-bash" data-lang="bash"><span class="line"><span class="cl"><span class="c1"># Grounding in one call: ranked, extracted page text your model can answer from</span>
</span></span><span class="line"><span class="cl">curl -G <span class="s2">&#34;https://api.search.brave.com/res/v1/llm/context&#34;</span> <span class="se">\
</span></span></span><span class="line"><span class="cl"><span class="se"></span>  -H <span class="s2">&#34;X-Subscription-Token: </span><span class="nv">$BRAVE_API_KEY</span><span class="s2">&#34;</span> <span class="se">\
</span></span></span><span class="line"><span class="cl"><span class="se"></span>  --data-urlencode <span class="s2">&#34;q=EU AI Act enforcement timeline&#34;</span> <span class="se">\
</span></span></span><span class="line"><span class="cl"><span class="se"></span>  --data-urlencode <span class="s2">&#34;maximum_number_of_tokens=4096&#34;</span> <span class="se">\
</span></span></span><span class="line"><span class="cl"><span class="se"></span>  --data-urlencode <span class="s2">&#34;context_threshold_mode=strict&#34;</span></span></span></code></pre></div>
    </div></section>

    <section id="plans">
      <h2 class="text-text-primary text-display-desktop-h4 md:text-display-desktop-h3 sr-only">
        Plans
      </h2>
      <div class="grid grid-cols-1 gap-6 lg:grid-cols-2 grid-flow-row">
        
          <div class="card card__contents row-span-6 grid lg:grid-rows-subgrid gap-6" data-theme="light">
            <h3 class="text-desktop-h4 md:text-desktop-h3">
              Search
            </h3>
            <div class="[&_p]:text-desktop-default [&_p:not(:last-of-type)]:pb-4">
              <p>The real-time search data your chatbots &amp; agents need to generate answers.</p>
<p>Complete search results (URLs, text, news, images, and more), with additional LLM context optimized for AI.</p>

            </div>
            <div class="grid lg:grid-cols-[1fr_auto] lg:grid-rows-[auto_auto]">
              <p class="lg:col-start-1 lg:row-start-1">
                <span class="text-desktop-h3">$5</span> per 1,000 requests
              </p>
              
              <a href="https://api-dashboard.search.brave.com/app/plans"
                
                  data-preserve-mtm-params
                
                class="leoButton isFilled isJumbo lg:max-w-max max-lg:mt-5 max-lg:self-end lg:col-start-2 lg:row-start-1 lg:row-span-2"
                
                  data-track-event
                  data-event-category="Search API redesign page CTAs"
                  data-event-action="Get started (search plan) button click"
                  data-event-name="Get started (search plan) button"
                >
                Get started
              </a>
