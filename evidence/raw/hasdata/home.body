tify-center gap-1.5 max-md:items-center"><svg viewBox="0 0 100 20" class="aspect-[5/1] h-[16px] w-[80px]" xmlns=http://www.w3.org/2000/svg><defs><mask id=star-mask-100><rect height=20 width=100 fill=black></rect><rect height=20 width=100% fill=white></rect></mask></defs><text dominant-baseline=middle fill=lightgray font-size=20 x=0 y=12>★★★★★</text><text dominant-baseline=middle fill=#FFDA6E font-size=20 x=0 y=12 mask=url(#star-mask-100)>★★★★★</text></svg><p class="text-sm leading-none">Trusted by 1.3k+ customers</p></div><hr><a href=https://app.hasdata.com/sign-up class="button bg-primary text-primary-foreground grow" target=_blank rel="nofollow noindex">Get Started</a></div><p class="text-xs mt-4 text-center">Get started with 1,000 free API calls. No credit card required.</p></div><section class=section><div class="flex flex-col max-md:items-center container max-md:text-center"><div class="flex items-center gap-2 border font-medium mb-5 px-4 py-2 rounded-full text-xs w-fit bg-primary/5 border-primary/25 text-primary"><svg height=1em width=1em class="-my-[2px] size-[16px]" data-icon=heart><symbol id=ai:local:heart viewBox="0 0 24 24"><path d="M19 14c1.49-1.46 3-3.21 3-5.5A5.5 5.5 0 0 0 16.5 3c-1.76 0-3 .5-4.5 2-1.5-1.5-2.74-2-4.5-2A5.5 5.5 0 0 0 2 8.5c0 2.3 1.5 4.05 3 5.5l7 7Z" stroke=currentColor stroke-linecap=round stroke-linejoin=round stroke-width=2 fill=none /></symbol><use href=#ai:local:heart></use></svg> <span class=mt-px>Customer Reviews</span></div><h2 class="font-normal whitespace-pre-line mb-3 md:text-5xl text-3xl">Teams that deleted their scrapers</h2><div class="flex justify-between empty:hidden items-baseline max-md:flex-col max-md:items-center"><p class="text-sm md:text-base lg:max-w-[700px] max-md:text-center text-balance whitespace-pre-line">Real stories from customers who scrape smarter, not harder</p></div></div><div class=container><div class="flex flex-col gap-3 border-y py-4 sm:flex-row sm:gap-6 sm:items-center"><div class="flex items-center gap-4 sm:gap-6"><div class="flex items-center gap-2.5"><span class="leading-none font-bold text-2xl tracking-tight">4.8</span> <span class="text-sm text-[#F5A623] leading-none tracking-[2px]">★★★★★</span></div><div class="w-px bg-border h-5 max-sm:hidden"></div><span class="text-sm text-foreground/70">across 100+ reviews on 5 platforms</span></div><div class="flex items-center gap-2.5 sm:ml-auto"><a href=https://www.g2.com/products/hasdata/reviews class="transition-opacity hover:opacity-70" target=_blank rel="noopener noreferrer" aria-label="HasData reviews on G2"><img alt=G2 class=size-6 decoding=async height=48 loading=lazy src=/_astro/g2.PWDNU7k9_1myDoU.svg width=48> </a><a href=https://www.capterra.com/p/10025595/HasData class="transition-opacity hover:opacity-70" target=_blank rel="noopener noreferrer" aria-label="HasData reviews on Capterra"><img alt=Capterra class=size-6 decoding=async height=48 loading=lazy src=/_astro/capterra.DvxljTmK_1myDoU.svg width=48> </a><a href=https://www.trustpilot.com/review/hasdata.com class="transition-opacity hover:opacity-70" target=_blank rel="noopener noreferrer" aria-label="HasData reviews on Trustpilot"><img alt=Trustpilot class=size-6 decoding=async height=48 loading=lazy src=/_astro/trustpilot.C6mURJHV_1myDoU.svg width=48> </a><a href=https://clutch.co/profile/hasdata class="transition-opacity hover:opacity-70" target=_blank rel="noopener noreferrer" aria-label="HasData reviews on Clutch"><img alt=Clutch class=size-6 decoding=async height=48 loading=lazy src=/_astro/clutch.ChyssVRZ_1myDoU.svg width=48> </a><a href=https://sourceforge.net/software/product/HasData/ class="transition-opacity hover:opacity-70" target=_blank rel="noopener noreferrer" aria-label="HasData reviews on SourceForge"><img alt=SourceForge class=size-6 decoding=async height=48 loading=lazy src=/_astro/sourceforge.ZgmsbVeY_1myDoU.svg width=48></a></div></div><div class="grid gap-4 md:grid-cols-2 mt-8 xl:gap-5 xl:grid-cols-[1fr_1.08fr_1.08fr] xl:grid-rows-[1fr_1fr]"><div class="flex flex-col border p-6 rounded-2xl bg-accent border-[#E0E7F1] justify-between md:col-span-2 xl:col-span-1 xl:p-8 xl:row-span-2"><div><div class="flex items-center gap-2.5"><img alt=Trustpilot class=size-5 decoding=async height=48 loading=lazy src=/_astro/trustpilot.C6mURJHV_1myDoU.svg width=48> <a href=https://www.trustpilot.com/reviews/680b5a8b4f2e360c4423cbf9 class="text-sm font-semibold hover:opacity-70 text-foreground/80" target=_blank rel="noopener noreferrer">Trustpilot</a> <span class="text-xs ml-auto leading-none text-[#F5A623] tracking-[2px]">★★★★★<span class=text-border></span></span></div><p class="font-semibold leading-snug line-clamp-[8] mt-5 text-pretty text-xl xl:mt-6 xl:text-2xl">HasData delivers exactly what we need: speed and comprehensive search features. It&#39;s the fastest API we&#39;ve used in this space. Plus, their customer support is fantastic.</p></div><div class="flex items-center gap-3.5 mt-6"><img alt="Denver Sinclair" class="object-cover rounded-full size-11" decoding=async height=44 loading=lazy src=/_astro/avatar.CqsPmvug_1DaKYV.webp width=44 srcset="/_astro/avatar.CqsPmvug_1DaKYV.webp, /_astro/avatar.CqsPmvug_ZvDAMx.webp 2x"><div><div class="text-sm text-foreground/80">Denver Sinclair</div></div></div></div><div class="flex flex-col border p-6 bg-background gap-3 rounded-2xl"><div class="flex items-center gap-2"><img alt=Capterra class=size-5 decoding=async height=48 loading=lazy src=/_astro/capterra.DvxljTmK_1myDoU.svg width=48> <a href=https://www.capterra.com/p/10025595/HasData/#Capterra___6862065/ class="text-xs text-foreground/70 font-semibold hover:opacity-70" target=_blank rel="noopener noreferrer">Capterra</a> <span class="leading-none text-[#F5A623] ml-auto text-[11px] tracking-[1.5px]">★★★★★<span class=text-border></span></span></div><p class="text-pretty leading-normal line-clamp-4 text-base text-foreground/90">We rely on HasData for search performance data and broader scraping needs. Their APIs deliver highly structured data that integrates directly into our platforms.</p><div class="flex items-center mt-auto gap-2.5"><span class="flex items-center justify-center bg-[#E3EAF4] font-bold rounded-full shrink-0 size-8 text-foreground/70 text-xs">JN</span><div class="text-xs leading-tight text-foreground/60"><div class=text-foreground/80>Jacob N.</div></div></div></div><div class="flex flex-col border p-6 bg-background gap-3 rounded-2xl"><div class="flex items-center gap-2"><img alt=Trustpilot class=size-5 decoding=async height=48 loading=lazy src=/_astro/trustpilot.C6mURJHV_1myDoU.svg width=48> <a href=https://www.trustpilot.com/reviews/63ef7668b63e82d96b70dca5 class="text-xs text-foreground/70 font-semibold hover:opacity-70" target=_blank rel="noopener noreferrer">Trustpilot</a> <span class="leading-none text-[#F5A623] ml-auto text-[11px] tracking-[1.5px]">★★★★★<span class=text-border></span></span></div><p class="text-pretty leading-normal line-clamp-4 text-base text-foreground/90">Great web scraping API which is incredibly easy to use. It requires minimal effort to get up and running, and the documentation is very clear and helpful.</p><div class="flex items-center mt-auto gap-2.5"><img alt="Arnold Foster" class="object-cover rounded-full size-8" decoding=async height=32 loading=lazy src=/_astro/avatar.BwQ-oE-L_ZIicxW.webp width=32 srcset="/_astro/avatar.BwQ-oE-L_ZIicxW.webp, /_astro/avatar.BwQ-oE-L_ZuL6JN.webp 2x"><div class="text-xs leading-tight text-foreground/60"><div class=text-foreground/80>Arnold Foster</div></div></div></div><div class="flex flex-col border p-6 bg-background gap-3 rounded-2xl"><div class="flex items-center gap-2"><img alt=Trustpilot class=size-5 decoding=async height=48 loading=lazy src=/_astro/trustpilot.C6mURJHV_1myDoU.svg width=48> <a href=https://www.trustpilot.com/reviews/661e7565283b5b66aa3738e8 class="text-xs text-foreground/70 font-semibold hover:opacity-70" target=_blank rel="noopener noreferrer">Trustpilot</a> <span class="leading-none text-[#F5A623] ml-auto text-[11px] tracking-[1.5px]">★★★★★<span class=text-border></span></span></div><p class="text-pretty leading-normal line-clamp-4 text-base text-foreground/90">I needed to scrape some information they didn&#39;t already support, and they wrote the code for me right away, which was super nice of them.</p><div class="flex items-center mt-auto gap-2.5"><img alt="Hussein Ali" class="object-cover rounded-full size-8" decoding=async height=32 loading=lazy src=/_astro/avatar.CiQ7r0pB_z84z7.webp width=32 srcset="/_astro/avatar.CiQ7r0pB_z84z7.webp, /_astro/avatar.CiQ7r0pB_24jxwT.webp 2x"><div class="text-xs leading-tight text-foreground/60"><div class=text-foreground/80>Hussein Ali</div></div></div></div><div class="flex flex-col border p-6 bg-background gap-3 rounded-2xl"><div class="flex items-center gap-2"><img alt=Clutch class=size-5 decoding=async height=48 loading=lazy src=/_astro/clutch.ChyssVRZ_1myDoU.svg width=48> <a href=https://clutch.co/go-to-review/383709cf-1480-463c-9c10-acfc1f98c82a/398076 class="text-xs text-foreground/70 font-semibold hover:opacity-70" target=_blank rel="noopener noreferrer">Clutch</a> <span class="leading-none text-[#F5A623] ml-auto text-[11px] tracking-[1.5px]">★★★★★<span class=text-border></span></span></div><p class="text-pretty leading-normal line-clamp-4 text-base text-foreground/90">We were particularly impressed with how easily we could integrate HasData into our existing workflow.</p><div class="flex items-center mt-auto gap-2.5"><span class="flex items-center justify-center bg-[#E3EAF4] font-bold rounded-full shrink-0 size-8 text-foreground/70 text-xs">TB</span><div class="text-xs leading-tight text-foreground/60"><div class=text-foreground/80>Taras Bazyshyn</div><div class=text-foreground/70>CEO at BAZTDL Sp. z o.o</div></div></div></div></div></div></section><section class=section><div class=container><div class=relative><div class="flex -my-px -mx-3 bg-center md:-mx-6 min-h-[450px] overflow-hidden rounded-3xl sm:-mx-5" style=background-image:url(/_astro/uptime-bg.BmVbkBei_1hQabT.webp)><div class="absolute h-full -mx-3 bg-black/40 inset-0 md:-mx-6 rounded-3xl sm:-mx-5"></div><a href=/blog/hasdata-achieves-99-uptime class="flex flex-col group relative text-white backdrop-blur-xl bg-black/10 hover:bg-black/30 max-w-full md:max-w-[550px] mt-auto p-10 rounded-r-3xl transition-colors w-full"><h2 class="text-balance whitespace-pre-line font-normal mb-2 md:text-3xl text-xl transition-all">How HasData Scrapers Achieve 99.9% Uptime at Millions of Requests</h2><p class=text-[13px]>At HasData we keep APIs reliable with daily synthetic tests, real-time dashboards, and proxy checks on redundant infrastructure. That&#39;s how we hold 99.9% uptime.</p><span class="text-sm font-medium mt-8">Read Article -></span></a></div><div class="absolute hd-divide-x border-t inset-x-[-10vw] bottom-0"></div><div class="absolute hd-divide-x border-t inset-x-[-10vw] top-0"></div><div class="absolute border-r hd-divide-y -bottom-[10vh] -top-[10vh] -left-3 md:-left-6 sm:-left-5"></div><div class="absolute border-r hd-divide-y -bottom-[10vh] -top-[10vh] -right-3 md:-right-6 sm:-right-5"></div></div></div></section><section class=section><div class="flex flex-col items-center text-center container max-md:items-center max-md:text-center"><div class="flex items-center gap-2 border font-medium mb-5 px-4 py-2 rounded-full text-xs w-fit bg-primary/5 border-primary/25 text-primary"><svg height=1em width=1em class="-my-[2px] size-[16px]" data-icon=shield-check><symbol id=ai:local:shield-check viewBox="0 0 24 24"><g fill=none stroke=currentColor stroke-linecap=round stroke-linejoin=round stroke-width=2><path d="M20 13c0 5-3.5 7.5-7.66 8.95a1 1 0 0 1-.67-.01C7.5 20.5 4 18 4 13V6a1 1 0 0 1 1-1c2 0 4.5-1.2 6.24-2.72a1.17 1.17 0 0 1 1.52 0C14.51 3.81 17 5 19 5a1 1 0 0 1 1 1z"/><path d="m9 12 2 2 4-4"/></g></symbol><use href=#ai:local:shield-check></use></svg> <span class=mt-px>FAQ</span></div><h2 class="font-normal whitespace-pre-line mb-3 md:text-5xl text-3xl">Frequently Asked Questions</h2><div class="flex justify-between empty:hidden items-baseline max-md:flex-col max-md:items-center"><p class="text-sm md:text-base lg:max-w-[700px] max-md:text-center text-balance whitespace-pre-line">Everything you need to know about web scraping with HasData.</p></div></div><div class=container><div class=mx-auto><div class="mx-auto max-w-4xl"><dl class=mt-16 itemscope itemtype=https://schema.org/FAQPage><div class="border-t hd-divide-x -mx-4 px-4 py-4" itemprop=mainEntity itemscope itemtype=https://schema.org/Question><dt><button class="flex items-center justify-between faq-toggle hover:underline py-2 text-left w-full" type=button aria-controls=faq-0 aria-expanded=false><span class="text-sm font-medium leading-none md:text-base" itemprop=name>What is HasData?</span> <span class="flex items-center h-7 ml-6"><svg height=1em width=1em class="size-5 icon-open" data-icon=chevron-down><symbol id=ai:local:chevron-down viewBox="0 0 24 24"><path d="m6 9 6 6 6-6" stroke=currentColor stroke-linecap=round stroke-linejoin=round stroke-width=2 fill=none /></symbol><use href=#ai:local:chevron-down></use></svg> <svg height=1em width=1em class="hidden icon-close rotate-180 size-5" data-icon=chevron-down viewBox="0 0 24 24"><use href=#ai:local:chevron-down></use></svg></span></button></dt><dd class="hidden faq-answer mt-2 pr-12" id=faq-0 itemprop=acceptedAnswer itemscope itemtype=https://schema.org/Answer><p class=text-sm itemprop=text>HasData is a web scraping service for collecting structured JSON or Markdown from public websites. It offers 63 API endpoints and 21 available no-code scrapers, with prices starting at $0.08 per 1,000 requests. The cost depends on the endpoint and request settings.</p></dd></div><div class="border-t hd-divide-x -mx-4 px-4 py-4" itemprop=mainEntity itemscope itemtype=https://schema.org/Question><dt><button class="flex items-center justify-between faq-toggle hover:underline py-2 text-left w-full" type=button aria-controls=faq-1 aria-expanded=false><span class="text-sm font-medium leading-none md:text-base" itemprop=name>Can I use both no-code scrapers and APIs with one subscription?</span> <span class="flex items-center h-7 ml-6"><svg height=1em width=1em class="size-5 icon-open" data-icon=chevron-down viewBox="0 0 24 24"><use href=#ai:local:chevron-down></use></svg> <svg height=1em width=1em class="hidden icon-close rotate-180 size-5" data-icon=chevron-down viewBox="0 0 24 24"><use href=#ai:local:chevron-down></use></svg></span></button></dt><dd class="hidden faq-answer mt-2 pr-12" id=faq-1 itemprop=acceptedAnswer itemscope itemtype=https://schema.org/Answer><p class=text-sm itemprop=text>Yes, your subscription can be used flexibly across all our products. You can access no-code scrapers, scraping APIs, or a combination of both. No separate plans or subscriptions needed.</p></dd></div><div class="border-t hd-divide-x -mx-4 px-4 py-4" itemprop=mainEntity itemscope itemtype=https://schema.org/Question><dt><button class="flex items-center justify-between faq-toggle hover:underline py-2 text-left w-full" type=button aria-controls=faq-2 aria-expanded=false><span class="text-sm font-medium leading-none md:text-base" itemprop=name>Can I try HasData for free before subscribing?</span> <span class="flex items-center h-7 ml-6"><svg height=1em width=1em class="size-5 icon-open" data-icon=chevron-down viewBox="0 0 24 24"><use href=#ai:local:chevron-down></use></svg> <svg height=1em width=1em class="hidden icon-close rotate-180 size-5" data-icon=chevron-down viewBox="0 0 24 24"><use href=#ai:local:chevron-down></use></svg></span></button></dt><dd class="hidden faq-answer mt-2 pr-12" id=faq-2 itemprop=acceptedAnswer itemscope itemtype=https://schema.org/Answer><p class=text-sm itemprop=text>Yes, the free plan includes 1,000 credits every month. No credit card is required.</p></dd></div><div class="border-t hd-divide-x -mx-4 px-4 py-4" itemprop=mainEntity itemscope itemtype=https://schema.org/Question><dt><button class="flex items-center justify-between faq-toggle hover:underline py-2 text-left w-full" type=button aria-controls=faq-3 aria-expanded=false><span class="text-sm font-medium leading-none md:text-base" itemprop=name>Can I cancel or change my subscription at any time?</span> <span class="flex items-center h-7 ml-6"><svg height=1em width=1em class="size-5 icon-open" data-icon=chevron-down viewBox="0 0 24 24"><use href=#ai:local:chevron-down></use></svg> <svg height=1em width=1em class="hidden icon-close rotate-180 size-5" data-icon=chevron-down viewBox="0 0 24 24"><use href=#ai:local:chevron-down></use></svg></span></button></dt><dd class="hidden faq-answer mt-2 pr-12" id=faq-3 itemprop=acceptedAnswer itemscope itemtype=https://schema.org/Answer><p class=text-sm itemprop=text>Yes, you can upgrade, downgrade, or cancel your subscription at any time directly from your account dashboard. Changes take effect immediately.</p></dd></div><div class="border-t hd-divide-x -mx-4 px-4 py-4" itemprop=mainEntity itemscope itemtype=https://schema.org/Question><dt><button class="flex items-center justify-between faq-toggle hover:underline py-2 text-left w-full" type=button aria-controls=faq-4 aria-expanded=false><span class="text-sm font-medium leading-none md:text-base" itemprop=name>What is an API credit, and how are they used?</span> <span class="flex items-center h-7 ml-6"><svg height=1em width=1em class="size-5 icon-open" data-icon=chevron-down viewBox="0 0 24 24"><use href=#ai:local:chevron-down></use></svg> <svg height=1em width=1em class="hidden icon-close rotate-180 size-5" data-icon=chevron-down viewBox="0 0 24 24"><use href=#ai:local:chevron-down></use></svg></span></button></dt><dd class="hidden faq-answer mt-2 pr-12" id=faq-4 itemprop=acceptedAnswer itemscope itemtype=https://schema.org/Answer><p class=text-sm itemprop=text>An API credit is HasData&#39;s internal unit for measuring the computational cost of a scraping request. The number of credits used per row or request depends on the scraper, its settings, the complexity of the task, and the data source.</p></dd></div><div class="border-t hd-divide-x -mx-4 px-4 py-4" itemprop=mainEntity itemscope itemtype=https://schema.org/Question><dt><button class="flex items-center justify-between faq-toggle hover:underline py-2 text-left w-full" type=button aria-controls=faq-5 aria-expanded=false><span class="text-sm font-medium leading-none md:text-base" itemprop=name>What happens if my scraping request fails?</span> <span class="flex items-center h-7 ml-6"><svg height=1em width=1em class="size-5 icon-open" data-icon=chevron-down viewBox="0 0 24 24"><use href=#ai:local:chevron-down></use></svg> <svg height=1em width=1em class="hidden icon-close rotate-180 size-5" data-icon=chevron-down viewBox="0 0 24 24"><use href=#ai:local:chevron-down></use></svg></span></button></dt><dd class="hidden faq-answer mt-2 pr-12" id=faq-5 itemprop=acceptedAnswer itemscope itemtype=https://schema.org/Answer><p class=text-sm itemprop=text>If your scraping request fails, the credits used are automatically refunded. Some scraping APIs also include automatic retries, so the system can try again and complete the data extraction even if the first attempt runs into issues.</p></dd></div><div class="border-t hd-divide-x -mx-4 px-4 py-4" itemprop=mainEntity itemscope itemtype=https://schema.org/Question><dt><button class="flex items-center justify-between faq-toggle hover:underline py-2 text-left w-full" type=button aria-controls=faq-6 aria-expanded=false><span class="text-sm font-medium leading-none md:text-base" itemprop=name>What if I need more than my current subscription offers?</span> <span class="flex items-center h-7 ml-6"><svg height=1em width=1em class="size-5 icon-open" data-icon=chevron-down viewBox="0 0 24 24"><use href=#ai:local:chevron-down></use></svg> <svg height=1em width=1em class="hidden icon-close rotate-180 size-5" data-icon=chevron-down viewBox="0 0 24 24"><use href=#ai:local:chevron-down></use></svg></span></button></dt><dd class="hidden faq-answer mt-2 pr-12" id=faq-6 itemprop=acceptedAnswer itemscope itemtype=https://schema.org/Answer><p class=text-sm itemprop=text>If you need higher limits or a custom solution, contact our support team via live chat or email at info@hasdata.com. We&#39;ll work with you to find a flexible option that fits your needs.</p></dd></div><div class="border-t hd-divide-x -mx-4 px-4 py-4" itemprop=mainEntity itemscope itemtype=https://schema.org/Question><dt><button class="flex items-center justify-between faq-toggle hover:underline py-2 text-left w-full" type=button aria-controls=faq-7 aria-expanded=false><span class="text-sm font-medium leading-none md:text-base" itemprop=name>Do you provide custom scraping solutions?</span> <span class="flex items-center h-7 ml-6"><svg height=1em width=1em class="size-5 icon-open" data-icon=chevron-down viewBox="0 0 24 24"><use href=#ai:local:chevron-down></use></svg> <svg height=1em width=1em class="hidden icon-close rotate-180 size-5" data-icon=chevron-down viewBox="0 0 24 24"><use href=#ai:local:chevron-down></use></svg></span></button></dt><dd class="hidden faq-answer mt-2 pr-12" id=faq-7 itemprop=acceptedAnswer itemscope itemtype=https://schema.org/Answer><p class=text-sm itemprop=text>Yes, we will be happy to address your data collection requests, if you provide a specific website and the exact data points you need. We can&#39;t take on vague requests without clear sources and targets.</p></dd></div></dl></div></div></div></section><script type=module>function n(){document.querySelectorAll(".faq-toggle").forEach((e=>{e.addEventListener("click",(()=>{const t="true"===e.getAttribute("aria-expanded"),n=e?.closest("dt")?.nextElementSibling,i=e.querySelector(".icon-open"),o=e.querySelector(".icon-close");e.setAttribute("aria-expanded",String(!t)),n?.classList.toggle("hidden",t),i?.classList.toggle("hidden",!t),o?.classList.toggle("hidden",t)}))}))}n(),document.addEventListener("astro:after-swap",n)</script><section class=section><div class="relative overflow-hidden"><div class="border-t hd-divide-x"></div><div class="container gap-10 grid grid-cols-1 lg:gap-0 lg:grid-cols-2 py-[60px]"><div class="flex flex-col justify-center relative max-lg:items-center max-lg:text-center max-w-4xl mx-auto z-[2]"><h2 class="font-normal mb-3 text-5xl">Free to start, pay per success</h2><p class="text-balance mb-8">1,000 API calls included. No credit card required.</p><a href=https://app.hasdata.com/sign-up class="flex rounded-md font-medium justify-center text-sm py-2.5 bg-[#EEF3FB] hover:opacity-80 min-w-[200px] text-center w-fit" target=_blank rel="nofollow noindex">Try For Free</a></div><div class="relative min-h-[200px]"><a href=https://www.trustpilot.com/review/hasdata.com class="flex flex-col border shadow-sm py-4 absolute bg-background gap-0.5 h-[76px] hover:opacity-80 inset-0 m-auto px-6 rounded w-[160px] translate-x-[-55%] translate-y-[-70%]" target=_blank rel="nofollow noreferrer"><img alt=Trustpilot class="h-[18px] m-auto w-fit" decoding=async height=16 loading=lazy src=/_astro/trustpilot.xv4hpUMk_Z1AzB9p.svg width=64><div class="flex items-center gap-2"><svg viewBox="0 0 100 20" class="aspect-[5/1] h-[16px] w-fit" xmlns=http://www.w3.org/2000/svg><defs><mask id=star-mask-90><rect height=20 width=100 fill=black></rect><rect height=20 width=90% fill=white></rect></mask></defs><text dominant-baseline=middle fill=lightgray font-size=20 x=0 y=12>★★★★★</text><text dominant-baseline=middle fill=#00B67A font-size=20 x=0 y=12 mask=url(#star-mask-90)>★★★★★</text></svg> <span class="text-sm font-medium mt-0.5">4.5</span></div></a><a href=https://clutch.co/profile/hasdata class="flex flex-col border shadow-sm py-4 absolute bg-background gap-0.5 h-[76px] hover:opacity-80 inset-0 m-auto px-6 rounded w-[160px] translate-x-[55%] translate-y-[-55%]" target=_blank rel="nofollow noreferrer"><im