B8FF\"\u003eprint\u003c/span\u003e\u003cspan style=\"color:#24292E;--shiki-dark:#E1E4E8\"\u003e(response)\u003c/span\u003e\u003c/span\u003e\n\u003cspan class=\"line\"\u003e\u003c/span\u003e\u003c/code\u003e\u003c/pre\u003e51:[\"$\",\"$L5d\",null,{\"className\":\"mb-5\",\"outputs\":[{\"language\":\"bash\",\"codeWithoutSyntaxHighlighting\":\"curl https://api.x.ai/v1/responses \\\\\\n  -H \\\"Content-Type: application/json\\\" \\\\\\n  -H \\\"Authorization: Bearer $XAI_API_KEY\\\" \\\\\\n  -d '{\\n  \\\"model\\\": \\\"grok-4.7\\\",\\n  \\\"input\\\": [\\n    {\\n      \\\"role\\\": \\\"user\\\",\\n      \\\"content\\\": \\\"Show me images of Starship on the launch pad.\\\"\\n    }\\n  ],\\n  \\\"tools\\\": [\\n    {\\n      \\\"type\\\": \\\"web_search\\\",\\n      \\\"enable_image_search\\\": true\\n    }\\n  ]\\n}'\\n\",\"code\":\"$6a\"},{\"language\":\"pythonXAI\",\"codeWithoutSyntaxHighlighting\":\"import os\\n\\nfrom xai_sdk import Client\\nfrom xai_sdk.chat import user\\nfrom xai_sdk.tools import web_search\\n\\nclient = Client(api_key=os.getenv(\\\"XAI_API_KEY\\\"))\\nchat = client.chat.create(\\n    model=\\\"grok-4.7\\\",\\n    tools=[\\n        web_search(enable_image_search=True),\\n    ],\\n)\\n\\nchat.append(user(\\\"Show me images of Starship on the launch pad.\\\"))\\nresponse = chat.sample()\\nprint(response.content)\\nprint(response.server_side_tool_usage)\\n\",\"code\":\"$6b\"},{\"language\":\"pythonOpenAISDK\",\"codeWithoutSyntaxHighlighting\":\"response = client.responses.create(\\n    model=\\\"grok-4.7\\\",\\n    input=[\\n        {\\n            \\\"role\\\": \\\"user\\\",\\n            \\\"content\\\": \\\"Show me images of Starship on the launch pad.\\\",\\n        },\\n    ],\\n    tools=[\\n        {\\n            \\\"type\\\": \\\"web_search\\\",\\n            \\\"enable_image_search\\\": True,\\n        },\\n    ],\\n)\\n\\nprint(response)\\n\",\"code\":\"$6c\"}]}]\n47:[[\"$\",\"meta\",\"0\",{\"charSet\":\"utf-8\"}],[\"$\",\"meta\",\"1\",{\