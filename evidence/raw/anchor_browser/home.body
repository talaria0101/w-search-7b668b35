<script>
  document.addEventListener("DOMContentLoaded", () => {
    const openTrigger = document.querySelector('[customTrigger="home-demo-open"]');
    const closeTrigger = document.querySelector('[customTrigger="home-demo-close"]');
    const overlay = document.querySelector(".modal.video");

    if (!overlay) return;

    if (openTrigger) {
      openTrigger.addEventListener("click", () => {
        overlay.style.display = "flex";
      });
    }

    if (closeTrigger) {
      closeTrigger.addEventListener("click", () => {
        overlay.style.display = "none";
      });
    }

    // Close overlay when pressing ESC
    document.addEventListener("keydown", (event) => {
      if (event.key === "Escape") {
        overlay.style.display = "none";
      }
    });
  });
</script>

<!-- Plyr JS -->
<script src="https://cdn.jsdelivr.net/npm/plyr@3.7.8/dist/plyr.polyfilled.min.js"></script>


<script>
  document.addEventListener('DOMContentLoaded', function () {
    // Init Plyr
    const player = new Plyr('#player', {
      youtube: { rel: 0, modestbranding: 1 }
    });

    // Set volume to 75% when video starts playing
    player.on('play', () => {
      player.volume = 0.75; // 0.75 = 75%
    });

    // Elements
    const overlay = document.querySelector('.home-demo-overlay');
    const openEls = document.querySelectorAll('[customTrigger="home-demo-open"]');
    const closeEls = document.querySelectorAll('[customTrigger="home-demo-close"]');

    // Helpers
    function openOverlay() {
      if (overlay) overlay.style.display = 'flex';
      try { player.play(); } catch (e) {}
    }

    function closeOverlay() {
      if (overlay) overlay.style.display = 'none';
      try { player.pause(); } catch (e) {}
    }

    // Bind
    openEls.forEach(el => el.addEventListener('click', openOverlay));
    closeEls.forEach(el => el.addEventListener('click', closeOverlay));

    // ESC key to close overlay and pause video
    document.addEventListener('keydown', function (event) {
      if (event.key === 'Escape' || event.key === 'Esc') {
        closeOverlay();
      }
    });
  });
</script>


