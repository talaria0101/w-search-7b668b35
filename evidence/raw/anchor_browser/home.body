 class="marquee-css__item-asset"/></div><div class="marquee-css__item"><img src="https://cdn.prod.website-files.com/68e76a236cc487333075990b/68e76a236cc48733307599f2_logo1.svg" loading="lazy" alt="" class="marquee-css__item-asset"/></div><div class="marquee-css__item"><img src="https://cdn.prod.website-files.com/68e76a236cc487333075990b/68ecd5e86e373e33ce2a6b46_tinyfish-black.png" loading="lazy" sizes="100vw" srcset="https://cdn.prod.website-files.com/68e76a236cc487333075990b/68ecd5e86e373e33ce2a6b46_tinyfish-black-p-500.png 500w, https://cdn.prod.website-files.com/68e76a236cc487333075990b/68ecd5e86e373e33ce2a6b46_tinyfish-black-p-800.png 800w, https://cdn.prod.website-files.com/68e76a236cc487333075990b/68ecd5e86e373e33ce2a6b46_tinyfish-black-p-1080.png 1080w, https://cdn.prod.website-files.com/68e76a236cc487333075990b/68ecd5e86e373e33ce2a6b46_tinyfish-black-p-1600.png 1600w, https://cdn.prod.website-files.com/68e76a236cc487333075990b/68ecd5e86e373e33ce2a6b46_tinyfish-black-p-2000.png 2000w, https://cdn.prod.website-files.com/68e76a236cc487333075990b/68ecd5e86e373e33ce2a6b46_tinyfish-black-p-2600.png 2600w, https://cdn.prod.website-files.com/68e76a236cc487333075990b/68ecd5e86e373e33ce2a6b46_tinyfish-black.png 2880w" alt="Logo of Tinyfish with a small, smiling orange cartoon fish integrated into the letter &#x27;i&#x27;." class="marquee-css__item-asset"/></div><div class="marquee-css__item"><img src="https://cdn.prod.website-files.com/68e76a236cc487333075990b/68ecd3ecdfeb716fdbdfca6d_apm.svg" loading="lazy" alt="" class="marquee-css__item-asset"/></div><div class="marquee-css__item"><img src="https://cdn.prod.website-files.com/68e76a236cc487333075990b/68ecd5fb7b4f90a6018e7f4d_asteroid%201.svg" loading="lazy" alt="" class="marquee-css__item-asset"/></div><div class="marquee-css__item"><img src="https://cdn.prod.website-files.com/68e76a236cc487333075990b/68ee207d2645cb1b4015238c_aa0f0c326465f4e4d040ae70a4e44992_generated-html%20%281%29.svg" loading="lazy" alt="" class="marquee-css__item-asset"/></div><div class="marquee-css__item"><img src="https://cdn.prod.website-files.com/68e76a236cc487333075990b/68ecd3ec252f598ffaca37dc_groq.png" loading="lazy" sizes="100vw" srcset="https://cdn.prod.website-files.com/68e76a236cc487333075990b/68ecd3ec252f598ffaca37dc_groq-p-500.png 500w, https://cdn.prod.website-files.com/68e76a236cc487333075990b/68ecd3ec252f598ffaca37dc_groq-p-800.png 800w, https://cdn.prod.website-files.com/68e76a236cc487333075990b/68ecd3ec252f598ffaca37dc_groq.png 1200w" alt="Diagram illustrating Groq architecture with inputs feeding into Tensor Streaming Processor, hardware matrix multiply unit, and Outputs block, connected in a flow." class="marquee-css__item-asset"/></div></div><div class="marquee-gradient"></div><div class="hide w-embed w-script"><script>
  // Note: The Javascript is optional. Read the documentation below how to use the CSS Only version.

  function initCSSMarquee() {
    const pixelsPerSecond = 75; // Set the marquee speed (pixels per second)
    const marquees = document.querySelectorAll('[data-css-marquee]');

    // Duplicate each [data-css-marquee-list] element inside its container
    marquees.forEach(marquee => {
      marquee.querySelectorAll('[data-css-marquee-list]').forEach(list => {
        const duplicate = list.cloneNode(true);
        marquee.appendChild(duplicate);
      });
    });

    // Create an IntersectionObserver to check if the marquee container is in view
    const observer = new IntersectionObserver(entries => {
      entries.forEach(entry => {
        entry.target.querySelectorAll('[data-css-marquee-list]').forEach(list => 
                                                                         list.style.animationPlayState = entry.isIntersecting ? 'running' : 'paused'
                                                                        );
      });
    }, { threshold: 0 });

    // Calculate the width and set the animation duration accordingly
    marquees.forEach(marquee => {
      marquee.querySelectorAll('[data-css-marquee-list]').forEach(list => {
        list.style.animationDuration = (list.offsetWidth / pixelsPerSecond) + 's';
        list.style.animationPlayState = 'paused';
      });
      observer.observe(marquee);
    });
  }

  // Initialize CSS Marquee
  document.addEventListener('DOMContentLoaded', function() {
    initCSSMarquee();
  });
</script></div><div class="hide w-embed"><style>
  /* CSS Keyframe Animation */
  @keyframes translateX { 
    to {
      transform: translateX(-100%);
    }
  }

  [data-css-marquee-list] {
    animation: translateX 30s linear;
    animation-iteration-count: infinite;
    animation-play-state: paused;
  }
</style></div></div><a class="button-link w-inline-block" data-wf-component-context="%5B%7B%22componentId%22%3A%22a5021ff0-44da-8fee-5e76-b4cd2583b954%22%2C%22instanceId%22%3A%2260268082-c998-8193-63be-5f97f17fed1c%22%7D%5D" customTrigger="" data-wf-element-id="a5021ff0-44da-8fee-5e76-b4cd2583b954" href="/about" data-w-id="a5021ff0-44da-8fee-5e76-b4cd2583b954" data-wf-native-id-path="60268082-c998-8193-63be-5f97f17fed1c:a5021ff0-44da-8fee-5e76-b4cd2583b954" data-cal-link="" data-wf-ao-click-engagement-tracking="true"><div class="button-label button-link-label">Read more</div><div class="button-link-icon_wrapper"><img src="https://cdn.prod.website-files.com/68e76a236cc487333075990b/68e76a236cc4873330759974_button-link-icon.svg" loading="lazy" alt="" class="button-link-icon"/></div></a></div></div></section><section data-wf--s-testimonials--variant="base" class="section_testimonials"><div class="container"><div class="testimonials-wrapper"><div data-tabs-autoplay-duration="5000" data-tabs="wrapper" data-tabs-autoplay="true" class="tab-layout__wrap is-testimonials"><div class="tab-layout__col is-testimonials"><div aria-live="polite" role="region" class="tab-visual__wrap is-testimonials"><div id="tab2" data-tabs="visual-item" role="tabpanel" class="tab-visual__item is-testimonials active"><div class="tab-visual__inner is-testimonials"><img src="https://cdn.prod.website-files.com/68e76a236cc487333075990b/68ececc38c97c1b5d75ba9d0_1750015308907.jpeg" loading="lazy" alt="" sizes="100vw" srcset="https://cdn.prod.website-files.com/68e76a236cc487333075990b/68ececc38c97c1b5d75ba9d0_1750015308907-p-500.jpeg 500w, https://cdn.prod.website-files.com/68e76a236cc487333075990b/68ececc38c97c1b5d75ba9d0_1750015308907.jpeg 574w" class="testimonials-tab-asset"/><div class="testimonials-tab-content"><img src="https://cdn.prod.website-files.com/68e76a236cc487333075990b/68ecd3ecdfeb716fdbdfca6a_composio.webp" loading="lazy" alt="" sizes="100vw" srcset="https://cdn.prod.website-files.com/68e76a236cc487333075990b/68ecd3ecdfeb716fdbdfca6a_composio-p-500.webp 500w, https://cdn.prod.website-files.com/68e76a236cc487333075990b/68ecd3ecdfeb716fdbdfca6a_composio.webp 696w" class="testimonials-logo is-content composio"/><h2 class="custom-h2">&quot;Working with Anchor has been a really smooth experience. The developer experience stands out. Setup was quick, the APIs are well-designed, and their team is super responsive. It’s taken away a lot of the friction we used to face with browser automation and made it far easier to build reliable agent workflows on top of it!&quot;</h2><div class="testimonials-tab-content_p"><img src="https://cdn.prod.website-files.com/68e76a236cc487333075990b/68ececc38c97c1b5d75ba9d0_1750015308907.jpeg" loading="lazy" alt="" sizes="100vw" srcset="https://cdn.prod.website-files.com/68e76a236cc487333075990b/68ececc38c97c1b5d75ba9d0_1750015308907-p-500.jpeg 500w, https://cdn.prod.website-files.com/68e76a236cc487333075990b/68ececc38c97c1b5d75ba9d0_1750015308907.jpeg 574w" class="testimonials-tab-content_portrait"/><p class="text-body-m text-weight-medium">Samvit Jatia</p><p class="text-body-m text-weight-medium">,</p><div class="custom-padding-testimonial"><p class="text-body-m text-color-foreground_muted">Builder @ Composio</p></div></div></div></div></div><div id="tab3" data-tabs="visual-item" role="tabpanel" class="tab-visual__item is-testimonials"><div class="tab-visual__inner is-testimonials"><img src="https://cdn.prod.website-files.com/68e76a236cc487333075990b/68ececc0e2c3ed0bf34100a2_1742353380060.jpeg" loading="lazy" alt="" sizes="100vw" srcset="https://cdn.prod.website-files.com/68e76a236cc487333075990b/68ececc0e2c3ed0bf34100a2_1742353380060-p-500.jpeg 500w, https://cdn.prod.website-files.com/68e76a236cc487333075990b/68ececc0e2c3ed0bf34100a2_1742353380060.jpeg 800w" class="testimonials-tab-asset"/><div class="testimonials-tab-content"><img src="https://cdn.prod.website-files.com/68e76a236cc487333075990b/68ecd3ec252f598ffaca37dc_groq.png" loading="lazy" alt="Diagram illustrating Groq architecture with inputs feeding into Tensor Streaming Processor, hardware matrix multiply unit, and Outputs block, connected in a flow." sizes="100vw" srcset="https://cdn.prod.website-files.com/68e76a236cc487333075990b/68ecd3ec252f598ffaca37dc_groq-p-500.png 500w, https://cdn.prod.website-files.com/68e76a236cc487333075990b/68ecd3ec252f598ffaca37dc_groq-p-800.png 800w, https://cdn.prod.website-files.com/68e76a236cc487333075990b/68ecd3ec252f598ffaca37dc_groq.png 1200w" class="testimonials-logo is-content"/><h2 class="custom-h2">&quot;Anchor has one of the best developer experiences in the industry. The APIs are intuitive and documentation clear, such that we built our MVP in less than an hour.<br/>Anchor allows us to spin multiple browsers in parallel to power Compound, our research agent. It delivers an impressive experience that was one of the highlights of our launch.&quot;</h2><div class="testimonials-tab-content_p"><img src="https://cdn.prod.website-files.com/68e76a236cc487333075990b/68ececc0e2c3ed0bf34100a2_1742353380060.jpeg" loading="lazy" alt="" sizes="100vw" srcset="https://cdn.prod.website-files.com/68e76a236cc487333075990b/68ececc0e2c3ed0bf34100a2_1742353380060-p-500.jpeg 500w, https://cdn.prod.website-files.com/68e76a236cc487333075990b/68ececc0e2c3ed0bf34100a2_1742353380060.jpeg 800w" class="testimonials-tab-content_portrait"/><p class="text-body-m text-weight-medium">Benjamin Klieger</p><p class="text-body-m text-weight-medium">,</p><div class="custom-padding-testimonial"><p class="text-body-m text-color-foreground_muted">Builder @ Groq</p></div></div></div></div></div><div id="tab4" data-tabs="visual-item" role="tabpanel" class="tab-visual__item is-testimonials"><div class="tab-visual__inner is-testimonials"><img src="https://cdn.prod.website-files.com/68e76a236cc487333075990b/68ececbe512ef98e98702cd8_1706191521411.jpeg" loading="lazy" alt="" sizes="100vw" srcset="https://cdn.prod.website-files.com/68e76a236cc487333075990b/68ececbe512ef98e98702cd8_1706191521411-p-500.jpeg 500w, https://cdn.prod.website-files.com/68e76a236cc487333075990b/68ececbe512ef98e98702cd8_1706191521411.jpeg 722w" class="testimonials-tab-asset"/><div class="testimonials-tab-content"><img src="https://cdn.prod.website-files.com/68e76a236cc487333075990b/68eceb06e87c1ea19ee1c995_intrinsic-logo-3-17-25.svg" loading="lazy" alt="" class="testimonials-logo is-content"/><h2 class="custom-h2">&quot;Our team built a workflow using Anchor Browser and demoed it to a major customer - they were absolutely blown away. The product speaks for itself&quot;</h2><div class="testimonials-tab-content_p"><img src="https://cdn.prod.website-files.com/68e76a236cc487333075990b/68ececbe512ef98e98702cd8_1706191521411.jpeg" loading="lazy" alt="" sizes="100vw" srcset="https://cdn.prod.website-files.com/68e76a236cc487333075990b/68ececbe512ef98e98702cd8_1706191521411-p-500.jpeg 500w, https://cdn.prod.website-files.com/68e76a236cc487333075990b/68ececbe512ef98e98702cd8_1706191521411.jpeg 722w" class="testimonials-tab-content_portrait"/><p class="text-body-m text-weight-medium">Greg Miller</p><p class="text-body-m text-weight-medium">,</p><div class="custom-padding-testimonial"><p class="text-body-m text-color-foreground_muted">Builder @ Intrinsic Labs</p></div></div></div></div></div></div></div><div class="tab-layout__col is-testimonials logos"><div class="tab-content__wrap is-testimonials"><div class="tab-content__inner is-testimonials"><div role="tablist" class="tab-content__bottom is-testimonials"><a role="tab" data-tabs="content-item" data-wf-native-id-path="3744b895-58e7-5b5f-8521-62ee8c6c3e5c:e6651cfc-bf0c-f835-00bd-6a43dea3ca76" data-wf-ao-click-engagement-tracking="true" data-wf-element-id="e6651cfc-bf0c-f835-00bd-6a43dea3ca76" data-wf-component-context="%5B%7B%22componentId%22%3A%22e6651cfc-bf0c-f835-00bd-6a43dea3ca2c%22%2C%22instanceId%22%3A%223744b895-58e7-5b5f-8521-62ee8c6c3e5c%22%7D%5D" href="#" class="tab-content__item is-testimonials w-inline-block"><img src="https://cdn.prod.website-files.com/68e76a236cc487333075990b/68ecd3ecdfeb716fdbdfca6a_composio.webp" loading="lazy" alt="" sizes="100vw" srcset="https://cdn.prod.website-files.com/68e76a236cc487333075990b/68ecd3ecdfeb716fdbdfca6a_composio-p-500.webp 500w, https://cdn.prod.website-files.com/68e76a236cc487333075990b/68ecd3ecdfeb716fdbdfca6a_composio.webp 696w" class="testimonials-logo composio"/><div class="tab-content__item-bottom is-testimonials"><div data-tabs="item-progress" class="tab-progress"></div></div></a><a role="tab" data-tabs="content-item" data-wf-native-id-path="3744b895-58e7-5b5f-8521-62ee8c6c3e5c:e6651cfc-bf0c-f835-00bd-6a43dea3ca7a" data-wf-ao-click-engagement-tracking="true" data-wf-element-id="e6651cfc-bf0c-f835-00bd-6a43dea3ca7a" data-wf-component-context="%5B%7B%22componentId%22%3A%22e6651cfc-bf0c-f835-00bd-6a43dea3ca2c%22%2C%22instanceId%22%3A%223744b895-58e7-5b5f-8521-62ee8c6c3e5c%22%7D%5D" href="#" class="tab-content__item is-testimonials w-inline-block"><img src="https://cdn.prod.website-files.com/68e76a236cc487333075990b/68ecd3ec252f598ffaca37dc_groq.png" loading="lazy" alt="Diagram illustrating Groq architecture with inputs feeding into Tensor Streaming Processor, hardware matrix multiply unit, and Outputs block, connected in a flow." sizes="100vw" srcset="https://cdn.prod.website-files.com/68e76a236cc487333075990b/68ecd3ec252f598ffaca37dc_groq-p-500.png 500w, https://cdn.prod.website-files.com/68e76a236cc487333075990b/68ecd3ec252f598ffaca37dc_groq-p-800.png 800w, https://cdn.prod.website-files.com/68e76a236cc487333075990b/68ecd3ec252f598ffaca37dc_groq.png 1200w" class="testimonials-logo"/><div class="tab-content__item-bottom is-testimonials"><div data-tabs="item-progress" class="tab-progress"></div></div></a><a role="tab" data-tabs="content-item" data-wf-native-id-path="3744b895-58e7-5b5f-8521-62ee8c6c3e5c:e6651cfc-bf0c-f835-00bd-6a43dea3ca7e" data-wf-ao-click-engagement-tracking="true" data-wf-element-id="e6651cfc-bf0c-f835-00bd-6a43dea3ca7e" data-wf-component-context="%5B%7B%22componentId%22%3A%22e6651cfc-bf0c-f835-00bd-6a43dea3ca2c%22%2C%22instanceId%22%3A%223744b895-58e7-5b5f-8521-62ee8c6c3e5c%22%7D%5D" href="#" class="tab-content__item is-testimonials last w-inline-block"><img src="https://cdn.prod.website-files.com/68e76a236cc487333075990b/68eceb06e87c1ea19ee1c995_intrinsic-logo-3-17-25.svg" loading="lazy" alt="" class="testimonials-logo intrinsic"/><div class="tab-content__item-bottom is-testimonials"><div data-tabs="item-progress" class="tab-progress"></div></div></a></div></div></div></div></div></div><div class="testimonials-swiper-wrapper"><div class="testimonials-swiper"><div class="swiper-wrapper"><div swiperElement="slide1" class="swiper-slide"><img src="https://cdn.prod.website-files.com/68e76a236cc487333075990b/68ecd3ecdfeb716fdbdfca6a_composio.webp" loading="lazy" alt="" sizes="100vw" srcset="https://cdn.prod.website-files.com/68e76a236cc487333075990b/68ecd3ecdfeb716fdbdfca6a_composio-p-500.webp 500w, https://cdn.prod.website-files.com/68e76a236cc487333075990b/68ecd3ecdfeb716fdbdfca6a_composio.webp 696w" class="testimonials-logo is-content composio"/><div class="swiper-slide-h2"><h2 class="custom-h2">&quot;Working with Anchor has been a really smooth experience. The developer experience stands out. Setup was quick, the APIs are well-designed, and their team is super responsive. It’s taken away a lot of the friction we used to face with browser automation and made it far easier to build reliable agent workflows on top of it!&quot;</h2></div><div class="testimonials-tab-content_p"><img src="https://cdn.prod.website-files.com/68e76a236cc487333075990b/68ececc38c97c1b5d75ba9d0_1750015308907.jpeg" loading="lazy" alt="" sizes="100vw" srcset="https://cdn.prod.website-files.com/68e76a236cc487333075990b/68ececc38c97c1b5d75ba9d0_1750015308907-p-500.jpeg 500w, https://cdn.prod.website-files.com/68e76a236cc487333075990b/68ececc38c97c1b5d75ba9d0_1750015308907.jpeg 574w" class="testimonials-tab-content_portrait"/><p class="text-body-m text-weight-medium">Samvit Jatia</p><div class="custom-p"><p class="text-body-m text-weight-medium">,</p></div><div class="custom-padding-testimonial"><p class="text-body-m text-color-foreground_muted">Builder @ Composio</p></div></div></div><div swiperElement="slide2" class="swiper-slide"><img src="https://cdn.prod.website-files.com/68e76a236cc487333075990b/68ecd3ec252f598ffaca37dc_groq.png" loading="lazy" alt="Diagram illustrating Groq architecture with inputs feeding into Tensor Streaming Processor, hardware matrix multiply unit, and Outputs block, connected in a flow." sizes="100vw" srcset="https://cdn.prod.website-files.com/68e76a236cc487333075990b/68ecd3ec252f598ffaca37dc_groq-p-500.png 500w, https://cdn.prod.website-files.com/68e76a236cc487333075990b/68ecd3ec252f598ffaca37dc_groq-p-800.png 800w, https://cdn.prod.website-files.com/68e76a236cc487333075990b/68ecd3ec252f598ffaca37dc_groq.png 1200w" class="testimonials-logo is-content"/><div class="swiper-slide-h2"><h2 class="custom-h2">&quot;Anchor has one of the best developer experiences in the industry. The APIs are intuitive and documentation clear, such that we built our MVP in less than an hour.<br/>Anchor allows us to spin multiple browsers in parallel to power Compound, our research agent. It delivers an impressive experience that was one of the highlights of our launch.&quot;</h2></div><div class="testimonials-tab-content_p"><img src="https://cdn.prod.website-files.com/68e76a236cc487333075990b/68ececc0e2c3ed0bf34100a2_1742353380060.jpeg" loading="lazy" alt="" sizes="100vw" srcset="https://cdn.prod.website-files.com/68e76a236cc487333075990b/68ececc0e2c3ed0bf34100a2_1742353380060-p-500.jpeg 500w, https://cdn.prod.website-files.com/68e76a236cc487333075990b/68ececc0e2c3ed0bf34100a2_1742353380060.jpeg 800w" class="testimonials-tab-content_portrait"/><p class="text-body-m text-weight-medium">Benjamin Klieger</p><p class="text-body-m text-weight-medium">,</p><div class="custom-padding-testimonial"><p class="text-body-m text-color-foreground_muted">Builder @ Groq</p></div></div></div><div swiperElement="slide3" class="swiper-slide"><img src="https://cdn.prod.website-files.com/68e76a236cc487333075990b/68eceb06e87c1ea19ee1c995_intrinsic-logo-3-17-25.svg" loading="lazy" alt="" class="testimonials-logo is-content"/><div class="swiper-slide-h2"><h2 class="custom-h2">&quot;Our team built a workflow using Anchor Browser and demoed it to a major customer - they were absolutely blown away. The product speaks for itself&quot;</h2></div><div class="testimonials-tab-content_p"><img src="https://cdn.prod.website-files.com/68e76a236cc487333075990b/68ececbe512ef98e98702cd8_1706191521411.jpeg" loading="lazy" alt="" sizes="100vw" srcset="https://cdn.prod.website-files.com/68e76a236cc487333075990b/68ececbe512ef98e98702cd8_1706191521411-p-500.jpeg 500w, https://cdn.prod.website-files.com/68e76a236cc487333075990b/68ececbe512ef98e98702cd8_1706191521411.jpeg 722w" class="testimonials-tab-content_portrait"/><p class="text-body-m text-weight-medium">Greg Miller</p><p class="text-body-m text-weight-medium">,</p><div class="custom-padding-testimonial"><p class="text-body-m text-color-foreground_muted">Builder @ Intrinsic Labs</p></div></div></div></div><div role="tablist" class="tab-content__bottom is-testimonials is-swiper"><a swiperElement="tab1" data-wf-native-id-path="3744b895-58e7-5b5f-8521-62ee8c6c3e5c:2fbcace0-25a1-25d9-7dd5-7ce21402f836" data-wf-ao-click-engagement-tracking="true" data-wf-element-id="2fbcace0-25a1-25d9-7dd5-7ce21402f836" data-wf-component-context="%5B%7B%22componentId%22%3A%22e6651cfc-bf0c-f835-00bd-6a43dea3ca2c%22%2C%22instanceId%22%3A%223744b895-58e7-5b5f-8521-62ee8c6c3e5c%22%7D%5D" href="#" class="tab-content__item is-testimonials w-inline-block"><img src="https://cdn.prod.website-files.com/68e76a236cc487333075990b/68ecd3ecdfeb716fdbdfca6a_composio.webp" loading="lazy" alt="" sizes="100vw" srcset="https://cdn.prod.website-files.com/68e76a236cc487333075990b/68ecd3ecdfeb716fdbdfca6a_composio-p-500.webp 500w, https://cdn.prod.website-files.com/68e76a236cc487333075990b/68ecd3ecdfeb716fdbdfca6a_composio.webp 696w" class="testimonials-logo composio"/></a><a swiperElement="tab2" data-wf-native-id-path="3744b895-58e7-5b5f-8521-62ee8c6c3e5c:2fbcace0-25a1-25d9-7dd5-7ce21402f838" data-wf-ao-click-engagement-tracking="true" data-wf-element-id="2fbcace0-25a1-25d9-7dd5-7ce21402f838" data-wf-component-context="%5B%7B%22componentId%22%3A%22e6651cfc-bf0c-f835-00bd-6a43dea3ca2c%22%2C%22instanceId%22%3A%223744b895-58e7-5b5f-8521-62ee8c6c3e5c%22%7D%5D" href="#" class="tab-content__item is-testimonials w-inline-block"><img src="https://cdn.prod.website-files.com/68e76a236cc487333075990b/68ecd3ec252f598ffaca37dc_groq.png" loading="lazy" alt="Diagram illustrating Groq architecture with inputs feeding into Tensor Streaming Processor, hardware matrix multiply unit, and Outputs block, connected in a flow." sizes="100vw" srcset="https://cdn.prod.website-files.com/68e76a236cc487333075990b/68ecd3ec252f598ffaca37dc_groq-p-500.png 500w, https://cdn.prod.website-files.com/68e76a236cc487333075990b/68ecd3ec252f598ffaca37dc_groq-p-800.png 800w, https://cdn.prod.website-files.com/68e76a236cc487333075990b/68ecd3ec252f598ffaca37dc_groq.png 1200w" class="testimonials-logo"/></a><a swiperElement="tab3" data-wf-native-id-path="3744b895-58e7-5b5f-8521-62ee8c6c3e5c:2fbcace0-25a1-25d9-7dd5-7ce21402f83a" data-wf-ao-click-engagement-tracking="true" data-wf-element-id="2fbcace0-25a1-25d9-7dd5-7ce21402f83a" data-wf-component-context="%5B%7B%22componentId%22%3A%22e6651cfc-bf0c-f835-00bd-6a43dea3ca2c%22%2C%22instanceId%22%3A%223744b895-58e7-5b5f-8521-62ee8c6c3e5c%22%7D%5D" href="#" class="tab-content__item is-testimonials last w-inline-block"><img src="https://cdn.prod.website-files.com/68e76a236cc487333075990b/68eceb06e87c1ea19ee1c995_intrinsic-logo-3-17-25.svg" loading="lazy" alt="" class="testimonials-logo intrinsic"/></a></div><div class="hide w-embed w-script"><style>
  .testimonials-swiper {
    height: auto !important;
  }

  .testimonials-swiper .swiper-wrapper {
    height: auto !important;
    transition-property: transform, height !important;
  }

  .testimonials-swiper .swiper-slide {
    height: auto !important;
  }
</style>

<script src="https://unpkg.com/swiper@11/swiper-bundle.min.js"></script>

<script>
  document.addEventListener('DOMContentLoaded', function () {
    if (window.innerWidth > 786) return; // Run only on 786px and below

    const swiper = new Swiper('.testimonials-swiper', {
      speed: 750,
      autoHeight: true,
      loop: false,
      slidesPerView: 1,
      spaceBetween: 0
    });

    const tabs = document.querySelectorAll('.tab-content__item.is-testimonials[swiperElement^="tab"]');
    const slideIndexByKey = {};

    // Map slide keys to indexes
    swiper.slides.forEach((slide, idx) => {
      const key = slide.getAttribute('swiperElement');
      if (key) slideIndexByKey[key] = idx;
    });

    // Helper: update logo opacity
    function setActiveTabByKey(tabKey) {
      tabs.forEach((tab) => {
        const logo = tab.querySelector('.testimonials-logo');
        if (!logo) return;
        logo.style.transition = 'opacity 0.3s ease';
        logo.style.opacity = tab.getAttribute('swiperElement') === tabKey ? '1' : '0.24';
      });
    }

    // Handle tab clicks → change slide
    tabs.forEach((tab) => {
      tab.addEventListener('click', (e) => {
        if (tab.tagName === 'A') e.preventDefault();
        const tabKey = tab.getAttribute('swiperElement');
        const slideKey = tabKey.replace(/^tab/, 'slide');
        const targetIdx = slideIndexByKey[slideKey];
        if (typeof targetIdx === 'number') {
          swiper.slideTo(targetIdx);
          setActiveTabByKey(tabKey);
        }
      });
    });

    // Slide change → update tab logos
    swiper.on('slideChange', () => {
      const activeSlide = swiper.slides[swiper.activeIndex];
      const slideKey = activeSlide.getAttribute('swiperElement');
      if (slideKey) {
        const tabKey = slideKey.replace(/^slide/, 'tab');
        setActiveTabByKey(tabKey);
      }
    });

    // Initialize with first tab active
    setActiveTabByKey('tab1');
  });
</script></div></div></div></div></section><section id="pricing" class="section_pricing is--new"><div class="container"><div class="pricing-wrapper"><h2 class="text-align-center">Start free. <span class="text-color-foreground_highlight">Scale as you grow.</span></h2><div class="pricing-grid-swiper"><div class="w-layout-grid swiper-wrapper pricing-grid"><div id="w-node-deea1170-b771-381f-442d-1df7557d3934-557d392b" class="swiper-slide pricing-grid-item"><div class="pricing-grid-item_top"><h3 pricingRangeInfrastructure="TotalPrice">Free</h3><div pricingRangeInfrastructure="TotalPriceLabel" class="text-body-s text-color-foreground_muted">Perfect for getting started</div></div><div class="pricing-grid-item_bottom"><h2>Free</h2><div class="divider"></div><div class="pricing-grid-rc w-richtext"><ul role="list" class="w-list-unstyled"><li>5 credits per month</li><li>0.1 credits per completed task</li><li>Up to 5 concurrent browsers</li><li>Up to 500 browser sessions</li><li><a href="https://docs.anchorbrowser.io/agentic-browser-control/ai-task-completion" data-wf-native-id-path="deea1170-b771-381f-442d-1df7557d39c2:640d6e64-47bb-a6d1-933e-68c2b8e54a53" data-wf-ao-click-engagement-tracking="true" data-wf-element-id="640d6e64-47bb-a6d1-933e-68c2b8e54a53" data-wf-component-context="%5B%7B%22componentId%22%3A%22deea1170-b771-381f-442d-1df7557d392b%22%2C%22instanceId%22%3A%22deea1170-b771-381f-442d-1df7557d39c2%22%7D%5D">Embedded browser agent</a></li></ul></div></div><div class="pricing-grid-item_button"><a class="button w-inline-block" data-wf-component-context="%5B%7B%22componentId%22%3A%22deea1170-b771-381f-442d-1df7557d392b%22%2C%22instanceId%22%3A%22deea1170-b771-381f-442d-1df7557d39c2%22%7D%2C%7B%22componentId%22%3A%22c1347f73-850c-0994-0400-344ae74ca469%22%2C%22instanceId%22%3A%22deea1170-b771-381f-442d-1df7557d394b%22%7D%5D" customTrigger="" data-wf-element-id="c1347f73-850c-0994-0400-344ae74ca469" href="https://signin.anchorbrowser.io" data-wf--c-button-dark--variant=