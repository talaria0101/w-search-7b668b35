-79e8-e673-673b-1fc97325bf57" data-wf-component-context="%5B%7B%22componentId%22%3A%222b42ee42-14f8-5264-066a-c007ea84b97b%22%2C%22instanceId%22%3A%222b42ee42-14f8-5264-066a-c007ea84b9a2%22%7D%2C%7B%22componentId%22%3A%2278d64922-79e8-e673-673b-1fc97325bf56%22%2C%22instanceId%22%3A%222b42ee42-14f8-5264-066a-c007ea84b99e%22%7D%5D" href="#" class="home-logos-cell_item-link w-inline-block"><img src="https://cdn.prod.website-files.com/68e76a236cc487333075990b/69d104beb704558509037553_StubHub_Logo.svg.png" loading="lazy" alt="" sizes="100vw" srcset="https://cdn.prod.website-files.com/68e76a236cc487333075990b/69d104beb704558509037553_StubHub_Logo.svg-p-500.png 500w, https://cdn.prod.website-files.com/68e76a236cc487333075990b/69d104beb704558509037553_StubHub_Logo.svg-p-800.png 800w, https://cdn.prod.website-files.com/68e76a236cc487333075990b/69d104beb704558509037553_StubHub_Logo.svg-p-1080.png 1080w, https://cdn.prod.website-files.com/68e76a236cc487333075990b/69d104beb704558509037553_StubHub_Logo.svg.png 1280w" class="home-logos-cell_asset in-link"/><div class="home-logos-cell_item-p"><p class="text-body-s text-color-foreground_muted">learn more</p><img src="https://cdn.prod.website-files.com/68e76a236cc487333075990b/68e76a236cc487333075998e_dark_icon-arrow-up-right.svg" loading="lazy" alt="" class="navbar1_link-icon"/></div></a><img src="https://cdn.prod.website-files.com/68e76a236cc487333075990b/69d104beb704558509037553_StubHub_Logo.svg.png" loading="lazy" alt="" sizes="100vw" srcset="https://cdn.prod.website-files.com/68e76a236cc487333075990b/69d104beb704558509037553_StubHub_Logo.svg-p-500.png 500w, https://cdn.prod.website-files.com/68e76a236cc487333075990b/69d104beb704558509037553_StubHub_Logo.svg-p-800.png 800w, https://cdn.prod.website-files.com/68e76a236cc487333075990b/69d104beb704558509037553_StubHub_Logo.svg-p-1080.png 1080w, https://cdn.prod.website-files.com/68e76a236cc487333075990b/69d104beb704558509037553_StubHub_Logo.svg.png 1280w" class="home-logos-cell_asset"/></div></div></div></div><div class="w-embed w-script"><!-- GSAP -->
<script src="https://cdnjs.cloudflare.com/ajax/libs/gsap/3.12.5/gsap.min.js" integrity="sha512-tFGyLq2+JpQvQGk1z8y7Qkz1v1y0GjI8SgG+qv9g2F4j1JpJf0bX0jzj8c6h6r3l4gq1QxG0mJb1o8y9qk9lMw==" crossorigin="anonymous" referrerpolicy="no-referrer"></script>

<script>
document.addEventListener('DOMContentLoaded', () => {
  const STEP_REM      = 5.5;     // distance per move (y-axis)
  const MOVE_DURATION = 0.75;    // seconds
  const WAIT_BETWEEN  = 2;       // seconds pause between moves
  const START_DELAY   = 2;       // one-time initial delay before everything starts
  const LOOP_OFFSET_INVERTED = 0.1; // added at the start of every cycle for .inverted
  const LOOP_DELAY    = 1;       // seconds to wait before starting next loop
  const EASE          = 'power2.out';

  const lists = document.querySelectorAll('.home-logos-cell_list');
  const timelines = []; // store all timelines for global control

  lists.forEach((list) => {
    const itemsCount = list.querySelectorAll('.home-logos-cell_item').length;
    if (itemsCount <= 1) return;

    const perLoopLeadDelay = list.classList.contains('inverted') ? LOOP_OFFSET_INVERTED : 0;
    const tl = gsap.timeline({ repeat: -1, paused: true });

    // optional stagger offset at start of each cycle
    if (perLoopLeadDelay > 0) {
      tl.to({}, { duration: perLoopLeadDelay });
    }

    // move through all items except the last one
    for (let i = 0; i < itemsCount - 1; i++) {
      tl.to(list, { y: `-=${STEP_REM}rem`, duration: MOVE_DURATION, ease: EASE });
      if (i < itemsCount - 2) {
        tl.to({}, { duration: WAIT_BETWEEN });
      }
    }

    // once last item is visible, snap instantly back to 0
    tl.set(list, { y: 0 });

    // add delay before starting next loop
    tl.to({}, { duration: LOOP_DELAY });

    timelines.push(tl);
    gsap.delayedCall(START_DELAY, () => tl.play(0));
  });

  // Hover handlers — control ALL timelines
  const allLinks = document.querySelectorAll('.home-logos-cell_item-link');

  allLinks.forEach(link => {
    link.addEventListener('mouseenter', () => {
      timelines.forEach(tl => tl.pause());
    });

    link.addEventListener('mouseleave', () => {
      timelines.forEach(tl => tl.resume());
    });
  });
});
</script></div></div></div></section><section class="section_home-video"><div class="container"><div data-w-id="f7f2a2dc-feb8-745f-da2e-ef7d8c439530" class="home-video-wrapper"><div class="z-index-2"><a class="button w-variant-47acc4dd-1643-0350-5e12-572aa1c7ec3d w-inline-block" data-wf-component-context="%5B%7B%22componentId%22%3A%22c1347f73-850c-0994-0400-344ae74ca469%22%2C%22instanceId%22%3A%22614de664-5437-955f-0fda-295515362445%22%7D%5D" customTrigger="home-demo-open" data-wf-element-id="c1347f73-850c-0994-0400-344ae74ca469" href="#" data-wf--c-button-dark--variant="bigger" data-wf-native-id-path="614de664-5437-955f-0fda-295515362445:c1347f73-850c-0994-0400-344ae74ca469" data-cal-link="" data-wf-ao-click-engagement-tracking="true"><img src="https://cdn.prod.website-files.com/68e76a236cc487333075990b/68e76a236cc48733307599e2_light_icon-play.svg" loading="lazy" alt="" class="button-icon left"/><div class="button-label w-variant-47acc4dd-1643-0350-5e12-572aa1c7ec3d">Watch</div></a></div></div></div></section><section class="section_home-fleet"><div class="container"><div class="home-fleet-wrapper"><div class="home-fleet-top"><div class="home-fleet-h3"><h3>A cloud fleet of browser agents that just work, every time.</h3></div><div class="button-group"><a class="button w-inline-block" data-wf-component-context="%5B%7B%22componentId%22%3A%22c1347f73-850c-0994-0400-344ae74ca469%22%2C%22instanceId%22%3A%227287b0a2-079d-2e02-d61b-cd7e2ab6e9f5%22%7D%5D" customTrigger="" data-wf-element-id="c1347f73-850c-0994-0400-344ae74ca469" href="https://signin.anchorbrowser.io" data-wf--c-button-dark--variant="default" target="_blank" data-wf-native-id-path="7287b0a2-079d-2e02-d61b-cd7e2ab6e9f5:c1347f73-850c-0994-0400-344ae74ca469" data-cal-link="" data-wf-ao-click-engagement-tracking="true"><img src="https://cdn.prod.website-files.com/68e76a236cc487333075990b/68e76a236cc48733307599a9_icon-anchor.svg" loading="lazy" alt="" class="button-icon left"/><div class="button-label">Try live</div></a><a class="button light w-inline-block" data-wf-component-context="%5B%7B%22componentId%22%3A%229e5ea9d3-aebd-4cf9-fa3f-72d6f60ad8ee%22%2C%22instanceId%22%3A%227287b0a2-079d-2e02-d61b-cd7e2ab6e9f7%22%7D%5D" data-wf-element-id="9e5ea9d3-aebd-4cf9-fa3f-72d6f60ad8ee" href="https://meetings-eu1.hubspot.com/nmagnezi/anchor-browser-intro" data-wf--c-button-light--variant="default" target="_blank" data-text-copy="" data-wf-native-id-path="7287b0a2-079d-2e02-d61b-cd7e2ab6e9f7:9e5ea9d3-aebd-4cf9-fa3f-72d6f60ad8ee" data-wf-ao-click-engagement-tracking="true"><div class="button-label">Talk to an Expert</div></a></div></div><div class="w-layout-grid home-fleet-grid"><div class="home-fleet-grid_item"><div class="home-fleet-grid_item-top"><div class="text-body-m text-weight-medium">Cloud browsers</div><p class="text-body-m text-color-foreground_muted">Anchor delivers fully managed, humanized chromium instances that can assume any identity and access any website.</p></div><div class="home-fleet-grid_item-bottom"><div data-poster-url="https://cdn.prod.website-files.com/68e76a236cc487333075990b%2F68f0b471feaa590253a1ae48_anchor04-poster-00001.jpg" data-video-urls="https://cdn.prod.website-files.com/68e76a236cc487333075990b%2F68f0b471feaa590253a1ae48_anchor04-transcode.mp4,https://cdn.prod.website-files.com/68e76a236cc487333075990b%2F68f0b471feaa590253a1ae48_anchor04-transcode.webm" data-autoplay="true" data-loop="true" data-wf-ignore="true" class="home-fleet-grid_item-bottom-bg w-background-video w-background-video-atom"><video id="adf8eb90-0cb3-f7ca-ce97-3a1f2d77d346-video" autoplay="" loop="" style="background-image:url(&quot;https://cdn.prod.website-files.com/68e76a236cc487333075990b%2F68f0b471feaa590253a1ae48_anchor04-poster-00001.jpg&quot;)" muted="" playsinline="" data-wf-ignore="true" data-object-fit="cover"><source src="https://cdn.prod.website-files.com/68e76a236cc487333075990b%2F68f0b471feaa590253a1ae48_anchor04-transcode.mp4" data-wf-ignore="true"/><source src="https://cdn.prod.website-files.com/68e76a236cc487333075990b%2F68f0b471feaa590253a1ae48_anchor04-transcode.webm" data-wf-ignore="true"/></video></div><div class="home-fleet-grid_item-bottom-content"><p class="text-style-caption text-color-foreground_highlight"><span class="text-color-black">12X faster</span> compared to browser agents</p></div></div></div><div class="home-fleet-grid_item"><div class="home-fleet-grid_item-top"><div class="text-body-m text-weight-medium">Boringly completing tasks</div><p class="text-body-m text-color-foreground_muted">Instead of running unpredictable, browser agents, Anchor uses AI Agents to <strong>plan</strong> and deploy <strong>deterministic browser tasks</strong> - Only reverting to AI in runtime when it is actually required.</p></div><div class="home-fleet-grid_item-bottom"><div class="home-fleet-grid_item-bottom-bg" data-w-id="eb8aded7-e3ff-55a8-25f5-9c8f5b3c74d0" data-animation-type="lottie" data-src="https://cdn.prod.website-files.com/68e76a236cc487333075990b/68f7606cffc698d99eab967f_anchor05.json" data-loop="1" data-direction="1" data-autoplay="1" data-is-ix2-target="0" data-renderer="svg" data-default-duration="0" data-duration="3.3333333333333335" data-loading="eager"></div><div class="home-fleet-grid_item-bottom-content"><p class="text-style-caption text-color-foreground_highlight"><span class="text-color-black">80X less tokens</span> compared to runtime AI</p></div></div></div><div class="home-fleet-grid_item"><div class="home-fleet-grid_item-top"><div class="text-body-m text-weight-medium">While keeping you safe</div><p class="text-body-m text-color-foreground_muted">Anchor is built in a secure-by-design approach, letting you deploy production-grade automations for any use case and environment.</p></div><div class="home-fleet-grid_item-bottom"><div data-poster-url="https://cdn.prod.website-files.com/68e76a236cc487333075990b%2F68f0b48a9ebd05229be89767_anchor06-poster-00001.jpg" data-video-urls="https://cdn.prod.website-files.com/68e76a236cc487333075990b%2F68f0b48a9ebd05229be89767_anchor06-transcode.mp4,https://cdn.prod.website-files.com/68e76a236cc487333075990b%2F68f0b48a9ebd05229be89767_anchor06-transcode.webm" data-autoplay="true" data-loop="true" data-wf-ignore="true" class="home-fleet-grid_item-bottom-bg w-background-video w-background-video-atom"><video id="ab6d2192-dfc1-3156-5263-d888cd77e572-video" autoplay="" loop="" style="background-image:url(&quot;https://cdn.prod.website-files.com/68e76a236cc487333075990b%2F68f0b48a9ebd05229be89767_anchor06-poster-00001.jpg&quot;)" muted="" playsinline="" data-wf-ignore="true" data-object-fit="cover"><source src="https://cdn.prod.website-files.com/68e76a236cc487333075990b%2F68f0b48a9ebd05229be89767_anchor06-transcode.mp4" data-wf-ignore="true"/><source src="https://cdn.prod.website-files.com/68e76a236cc487333075990b%2F68f0b48a9ebd05229be89767_anchor06-transcode.webm" data-wf-ignore="true"/></video></div><div class="home-fleet-grid_item-bottom-content"><p class="text-style-caption text-color-foreground_highlight"><span class="text-color-black">23x less error prone</span> compared to the best performing browser agents.</p></div></div></div></div></div></div></section><section class="section_home-stages"><div class="container"><div class="w-layout-grid home-stages-grid"><div id="w-node-_374b2f45-93fb-74c9-d33d-0a76f3ad1a8f-307598e7" class="home-stages-nav"><a data-wf-native-id-path="c17f3ebb-faf8-0e91-563c-a97ac8372f27" data-wf-ao-click-engagement-tracking="true" data-wf-element-id="c17f3ebb-faf8-0e91-563c-a97ac8372f27" href="#Humanized" class="home-stages-link w-inline-block"><div data-wf--vector-4x4--variant="black" class="vector _4x4 w-variant-7b4c0327-32c3-33f3-e066-3edeea8e8995"></div><div class="button-label">Humanized</div></a><a data-wf-native-id-path="21cd4af8-714e-2b42-f39a-2fd64718891d" data-wf-ao-click-engagement-tracking="true" data-wf-element-id="21cd4af8-714e-2b42-f39a-2fd64718891d" href="#Authenticated" class="home-stages-link w-inline-block"><div data-wf--vector-4x4--variant="black" class="vector _4x4 w-variant-7b4c0327-32c3-33f3-e066-3edeea8e8995"></div><div class="button-label">Authenticated</div></a><a data-wf-native-id-path="959e18a1-2692-e420-92d7-6076c552ca4f" data-wf-ao-click-engagement-tracking="true" data-wf-element-id="959e18a1-2692-e420-92d7-6076c552ca4f" href="#Reliable" class="home-stages-link w-inline-block"><div data-wf--vector-4x4--variant="black" class="vector _4x4 w-variant-7b4c0327-32c3-33f3-e066-3edeea8e8995"></div><div class="button-label">Secure</div></a><div class="w-embed"><style>
