<!-- Start of HubSpot Meetings Embed Script -->
<script type="text/javascript" src="https://static.hsappstatic.net/MeetingsEmbed/ex/MeetingsEmbedCode.js"></script>
<!-- End of HubSpot Meetings Embed Script -->
<script>
/**
 * Anchor Browser — site-wide booking CTA override (v5, 2026-10-01)
 *
 * Every "Talk to an Expert" / booking trigger opens the HubSpot round-robin
 * calendar in the [data-modal-name="hubspot"] modal (falls back to .modal.cal),
 * or a new tab if the modal markup is missing.
 *
 * HubSpot's embedded page has a transparent background, so the card and the
 * iframe are transparent too: only HubSpot's own content box shows, with no
 * white around it, and the card keeps one size for the email step and the
 * calendar (nothing jumps). The iframe is offset/cropped to HubSpot's box:
 *   iframe W >= 632 -> box at x4 y16, up to 850 wide, calendar 670 tall
 *   iframe W <= 408 -> box at x4 y0, W-8 wide (max 400), calendar 667 tall
 * While HubSpot loads, a centered black spinner shows instead of HubSpot's own
 * loader (which sits at the top of its page and would be cut off).
 */
(function () {
  var BOOKING_URL =
    "https://meetings-eu1.hubspot.com/nathan-anchor-browser/home-page-round-robin";
  var EMBED_URL = BOOKING_URL + "?embed=true";
  var STYLE_ID = "ab-booking-modal-css";
  var OPEN_CLASS = "ab-booking-open";
  var READY_CLASS = "ab-booking-ready";
  // HubSpot renders its content ~0.7-0.9s after the iframe load event.
  var RENDER_DELAY = 1000;

  var LAYOUT = {
    wide: { maxW: 850, top: 16, h: 670 },
    narrow: { maxW: 400, top: 0, h: 667 }
  };

  function bookingModal() {
    return (
      document.querySelector('[data-modal-name="hubspot"]') ||
      document.querySelector(".modal.cal")
    );
  }

  function injectStyles() {
    if (document.getElementById(STYLE_ID)) return;
    var M = ".modal[data-modal-name='hubspot']";
    var C = ".modal.cal.ab-booking-open";
    function both(sel) { return M + sel + ", " + C + sel; }
    var X = " .home-demo-overlay_button";
    var css = [
      "html.ab-booking-modal-open, html.ab-booking-modal-open body { overflow: hidden !important; overscroll-behavior: none !important; }",
      "@keyframes ab-booking-spin { to { transform: rotate(360deg); } }",
      both("") + " { background: rgba(12,14,18,.6) !important; background-image: none !important; align-items: center !important; justify-content: center !important; padding: 12px !important; box-sizing: border-box !important; overflow: hidden !important; overscroll-behavior: none !important; z-index: 2147483000 !important; }",
      both(" .modal-cal") + " { position: relative !important; display: block !important; width: var(--ab-card-w, 850px) !important; max-width: 100% !important; min-width: 0 !important; height: var(--ab-card-h, 670px) !important; min-height: 0 !important; max-height: calc(100dvh - 24px) !important; aspect-ratio: auto !important; margin: 0 !important; padding: 0 !important; border: 0 !important; border-radius: 0 !important; background: transparent !important; box-shadow: none !important; overflow: hidden !important; zoom: 1 !important; transform: none !important; box-sizing: border-box !important; }",
      both(" .modal-cal-embed") + " { display: block !important; width: 100% !important; height: 100% !important; min-height: 0 !important; max-height: none !important; margin: 0 !important; padding: 0 !important; background: transparent !important; overflow-x: hidden !important; overflow-y: auto !important; -webkit-overflow-scrolling: touch; scrollbar-width: none !important; line-height: 0 !important; }",
      both(" .modal-cal-embed::-webkit-scrollbar") + " { display: none !important; }",
      both(" .meetings-iframe-container") + " { display: none !important; }",
      both(" iframe") + " { display: block !important; width: calc(100% + 8px) !important; max-width: none !important; height: var(--ab-frame-h, 686px) !important; min-height: 0 !important; max-height: none !important; margin: var(--ab-frame-top, -16px) 0 0 -4px !important; border: 0 !important; border-radius: 0 !important; background: transparent !important; color-scheme: normal !important; opacity: 0 !important; transition: opacity .25s ease !important; }",
      both("." + READY_CLASS + " iframe") + " { opacity: 1 !important; }",
      both(" .ab-booking-loader") + " { position: fixed !important; top: 50% !important; left: 50% !important; width: 40px !important; height: 40px !important; margin: -20px 0 0 -20px !important; border: 3px solid rgba(0,0,0,.15) !important; border-top-color: #000 !important; border-radius: 50% !important; box-shadow: 0 0 0 12px #fff !important; background: #fff !important; box-sizing: border-box !important; animation: ab-booking-spin .8s linear infinite !important; z-index: 6 !important; pointer-events: none !important; }",
      both("." + READY_CLASS + " .ab-booking-loader") + " { display: none !important; }",
      both(X) + " { position: absolute !important; top: 8px !important; right: 8px !important; left: auto !important; bottom: auto !important; z-index: 5 !important; width: 32px !important; height: 32px !important; }",
      both(X + " .button") + " { position: relative !important; display: block !important; width: 32px !important; height: 32px !important; min-height: 32px !important; padding: 0 !important; border: 0 !important; border-radius: 999px !important; background: #fff !important; box-shadow: 0 2px 10px rgba(0,0,0,.3) !important; cursor: pointer !important; }",
      both(X + " .button img") + " { display: none !important; }",
      both(X + " .button::before") + ", " + both(X + " .button::after") + " { content: '' !important; position: absolute !important; top: 50% !important; left: 50% !important; width: 14px !important; height: 2px !important; border-radius: 2px !important; background: #16202a !important; }",
      both(X + " .button::before") + " { transform: translate(-50%,-50%) rotate(45deg) !important; }",
      both(X + " .button::after") + " { transform: translate(-50%,-50%) rotate(-45deg) !important; }"
    ].join("\n");
    var style = document.createElement("style");
    style.id = STYLE_ID;
    style.appendChild(document.createTextNode(css));
    document.head.appendChild(style);
  }

  // Size the card to HubSpot's content box for the current viewport.
  function sizeCard() {
    var modal = bookingModal();
    var card = modal && modal.querySelector(".modal-cal");
    if (!card) return;
    var avail = window.innerWidth - 24;
    var L = avail >= 640 ? LAYOUT.wide : LAYOUT.narrow;
    var w = Math.min(L.maxW, avail);
    card.style.setProperty("--ab-card-w", w + "px");
    card.style.setProperty("--ab-card-h", L.h + "px");
    card.style.setProperty("--ab-frame-top", -L.top + "px");
    card.style.setProperty("--ab-frame-h", L.h + L.top + "px");
    if (!card.querySelector(".ab-booking-loader")) {
      var loader = document.createElement("div");
      loader.className = "ab-booking-loader";
      loader.setAttribute("role", "status");
      loader.setAttribute("aria-label", "Loading");
      card.appendChild(loader);
    }
  }

  function markReady(iframe) {
    var modal = iframe.closest(".modal");
    if (modal) modal.classList.add(READY_CLASS);
  }

  function layoutModal(modal) {
    var card = modal.querySelector(".modal-cal");
    var closeBtn = modal.querySelector(".home-demo-overlay_button");
    if (card && closeBtn && closeBtn.parentElement !== card) {
      card.insertBefore(closeBtn, card.firstChild);
    }
    var link = closeBtn && closeBtn.querySelector("a");
    if (link) {
      link.setAttribute("aria-label", "Close");
      link.setAttribute("role", "button");
    }
  }

  function ensureIframe() {
    var containers = document.querySelectorAll(
      '[data-modal-name="hubspot"] .modal-cal-embed, .modal.cal .modal-cal-embed'
    );
    containers.forEach(function (container) {
      // Keep HubSpot's embed script from injecting a second iframe.
      container.querySelectorAll("[data-src]").forEach(function (el) {
        el.removeAttribute("data-src");
      });
      var iframe = container.querySelector(":scope > iframe");
      if (!iframe) {
        iframe = document.createElement("iframe");
        iframe.title = "Book a meeting with Anchor Browser";
        iframe.setAttribute("allow", "camera; microphone; fullscreen; payment");
        container.appendChild(iframe);
      }
      iframe.setAttribute("allowtransparency", "true");
      if (!iframe.getAttribute("data-ab-wired")) {
        iframe.setAttribute("data-ab-wired", "1");
        iframe.addEventListener("load", function () {
          if (!iframe.getAttribute("src")) return;
          setTimeout(function () { markReady(iframe); }, RENDER_DELAY);
        });
      }
      if (iframe.getAttribute("src") !== EMBED_URL) {
        iframe.src = EMBED_URL;
      }
    });
  }

  function closeBooking() {
    var modal = bookingModal();
    if (modal) {
      modal.style.display = "none";
      modal.classList.remove(OPEN_CLASS);
    }
    document.documentElement.classList.remove("ab-booking-modal-open");
  }

  function openBooking(event) {
    if (event) {
      event.preventDefault();
      event.stopPropagation();
    }
    injectStyles();
    ensureIframe();
    var modal = bookingModal();
    if (modal) {
      layoutModal(modal);
      sizeCard();
      modal.classList.add(OPEN_CLASS);
      modal.style.display = "flex";
      document.documentElement.classList.add("ab-booking-modal-open");
      return;
    }
    window.open(BOOKING_URL, "_blank", "noopener,noreferrer");
  }

  function isCloseControl(el) {
    if (!el || !el.getAttribute) return false;
    var trig = (
      el.getAttribute("customtrigger") ||
      el.getAttribute("customTrigger") ||
      ""
    ).toLowerCase();
    return (
      trig.indexOf("close") !== -1 ||
      !!el.closest('[customtrigger$="-close"], [customTrigger$="-close"]')
    );
  }

  function isBookingControl(el) {
    if (!el || isCloseControl(el)) return false;
    var trig = (
      el.getAttribute("customtrigger") ||
      el.getAttribute("customTrigger") ||
      ""
    ).toLowerCase();
    var cal = el.getAttribute("data-cal-link") || "";
    var href = el.getAttribute("href") || "";
    var label = (el.textContent || "").replace(/\s+/g, " ").trim();

    if (trig === "modal-hubspot-open" || trig === "modal-cal-open") return true;
    if (cal && cal.trim()) return true;
    if (/talk to an expert/i.test(label)) return true;
    if (href.indexOf("nathan-anchor-browser") !== -1) return true;
    if (href.indexOf("nmagnezi/anchor-browser-intro") !== -1) return true;
    if (/cal\.com/i.test(href)) return true;
    return false;
  }

  document.addEventListener(
    "click",
    function (event) {
      var target = event.target.closest(
        "a, button, [customtrigger], [customTrigger], [data-cal-link]"
      );
      if (isCloseControl(target)) {
        closeBooking();
        return;
      }
      var modal = bookingModal();
      if (modal && modal.classList.contains(OPEN_CLASS) && event.target === modal) {
        event.preventDefault();
        closeBooking();
        return;
      }
      if (!isBookingControl(target)) return;
      openBooking(event);
    },
    true
  );

  document.addEventListener("keydown", function (event) {
    if (event.key === "Escape") closeBooking();
  });

  window.addEventListener("resize", sizeCard);

  document.addEventListener("DOMContentLoaded", function () {
    injectStyles();
    ensureIframe();
    sizeCard();
    if (window.location.hash === "#book") openBooking();
  });

  window.addEventListener("hashchange", function () {
    if (window.location.hash === "#book") openBooking();
  });
})();
</script>

