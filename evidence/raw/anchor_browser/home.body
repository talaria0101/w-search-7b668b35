{
  "@context": "https://schema.org",
  "@type": "SoftwareApplication",
  "name": "Anchor Browser",
  "description": "Anchor is the developer platform that turns browser automation from a fragile, costly nightmare into a reliable, enterprise-ready solution.",
  "applicationCategory": "DeveloperApplication",
  "operatingSystem": "Cloud-based",
  "offers": [
    {
      "@type": "Offer",
      "name": "Free Plan",
      "price": "0",
      "priceCurrency": "USD",
      "description": "$5 free credits per month, up to 25 concurrent browsers, up to 500 browser sessions",
      "availability": "https://schema.org/InStock"
    },
    {
      "@type": "Offer",
      "name": "Starter Plan",
      "price": "20.00",
      "priceCurrency": "USD",
      "description": "Cloudflare Verified Browser Agents, automated Captcha bypass, authenticated browsers",
      "availability": "https://schema.org/InStock"
    },
    {
      "@type": "Offer",
      "name": "Growth Plan",
      "price": "1500.00",
      "priceCurrency": "USD",
      "description": "SOC2 Type 2, ISO27001, HIPAA, GDPR compliant, bring your own cloud, on-premise options",
      "availability": "https://schema.org/InStock"
    }
  ],
  "featureList": [
    "Cloud-hosted browser automation",
    "AI-powered web agents",
    "Authenticated browser sessions",
    "SSO integration",
    "MFA handling",
    "Captcha solving",
    "Proxy support",
    "Cloudflare verified bot access",
    "Self-healing automation",
    "Enterprise security compliance"
  ],
  "aggregateRating": {
    "@type": "AggregateRating",
    "ratingValue": "5",
    "reviewCount": "3"
  },
  "review": [
    {
      "@type": "Review",
      "author": {
        "@type": "Person",
        "name": "Samvit Jatia",
        "affiliation": {
          "@type": "Organization",
          "name": "Composio"
        }
      },
      "reviewBody": "Working with Anchor has been a really smooth experience. The developer experience stands out. Setup was quick, the APIs are well-designed, and their team is super responsive. It's taken away a lot of the friction we used to face with browser automation and made it far easier to build reliable agent workflows on top of it!",
      "reviewRating": {
        "@type": "Rating",
        "ratingValue": "5"
      }
    },
    {
      "@type": "Review",
      "author": {
        "@type": "Person",
        "name": "Benjamin Klieger",
        "affiliation": {
          "@type": "Organization",
          "name": "Groq"
        }
      },
      "reviewBody": "Anchor has one of the best developer experiences in the industry. The APIs are intuitive and documentation clear, such that we built our MVP in less than an hour. Anchor allows us to spin multiple browsers in parallel to power Compound, our research agent. It delivers an impressive experience that was one of the highlights of our launch.",
      "reviewRating": {
        "@type": "Rating",
        "ratingValue": "5"
      }
    },
    {
      "@type": "Review",
      "author": {
        "@type": "Person",
        "name": "Greg Miller",
        "affiliation": {
          "@type": "Organization",
          "name": "Intrinsic Labs"
        }
      },
      "reviewBody": "Our team built a workflow using Anchor Browser and demoed it to a major customer - they were absolutely blown away. The product speaks for itself",
      "reviewRating": {
        "@type": "Rating",
        "ratingValue": "5"
      }
    }
  ],
