<script>
  document.addEventListener("DOMContentLoaded", () => {
    // Helper to set up modal open/close behavior
    function setupModal(modalSelector, openTrigger, closeTrigger) {
      const modal = document.querySelector(modalSelector);
      const openButtons = document.querySelectorAll(openTrigger);
      const closeButtons = document.querySelectorAll(closeTrigger);

      if (!modal) return;

      openButtons.forEach(btn => {
        btn.addEventListener("click", () => {
          modal.style.display = "flex";
        });
      });

      closeButtons.forEach(btn => {
        btn.addEventListener("click", () => {
          modal.style.display = "none";
        });
      });
    }

    // Initialize modals
    setupModal(
      ".modal.infrastructure",
      '[customtrigger="pricing-infrastructure-open"]',
      '[customtrigger="pricing-infrastructure-close"]'
    );

    setupModal(
      ".modal.growth",
      '[customtrigger="pricing-growth-open"]',
      '[customtrigger="pricing-growth-close"]'
    );

    setupModal(
      ".modal.cal",
      '[customtrigger="modal-cal-open"]',
      '[customtrigger="modal-cal-close"]'
    );

    setupModal(
      '[data-modal-name="hubspot"]',
      '[customtrigger="modal-hubspot-open"]',
      '[customtrigger="modal-hubspot-close"]'
    );

    // Close all modals on ESC key press
    document.addEventListener("keydown", (event) => {
      if (event.key === "Escape" || event.key === "Esc") {
        document.querySelectorAll(".modal").forEach(modal => {
          modal.style.display = "none";
        });
      }
    });
  });
</script>


<script>
  window.addEventListener('DOMContentLoaded', () => {
    // Check if URL contains #book
    if (window.location.hash === '#book') {
      const modal = document.querySelector('.modal.cal');
      if (modal) modal.style.display = 'flex';
    }

    // Optional: handle hash changes (e.g., when user removes or adds #book)
    window.addEventListener('hashchange', () => {
      const modal = document.querySelector('.modal.cal');
      if (!modal) return;
      modal.style.display = window.location.hash === '#book' ? 'flex' : 'none';
    });
  });
</script>

<script>
  // --- Tab System (runs per wrapper when visible) ---
  function initTabSystem(wrapper) {
    const contentItems = wrapper.querySelectorAll('[data-tabs="content-item"]');
    const visualItems = wrapper.querySelectorAll('[data-tabs="visual-item"]');

    const autoplay = wrapper.dataset.tabsAutoplay === "true";
    const autoplayDuration = parseInt(wrapper.dataset.tabsAutoplayDuration) || 5000;

    let activeContent = null;
    let activeVisual = null;
    let isAnimating = false;
    let progressBarTween = null;

    function startProgressBar(index) {
      if (progressBarTween) progressBarTween.kill?.();
      const bar = contentItems[index].querySelector('[data-tabs="item-progress"]');
      if (!bar || typeof gsap === "undefined") return;

      gsap.set(bar, { scaleX: 0, transformOrigin: "left center" });
      progressBarTween = gsap.to(bar, {
        scaleX: 1,
        duration: autoplayDuration / 1000,
        ease: "power1.inOut",
        onComplete: () => {
          if (!isAnimating) {
            const nextIndex = (index + 1) % contentItems.length;
            switchTab(nextIndex);
          }
        },
      });
    }

    function switchTab(index) {
      if (isAnimating || contentItems[index] === activeContent) return;

      isAnimating = true;
      if (progressBarTween) progressBarTween.kill?.();

      const outgoingContent = activeContent;
      const outgoingVisual = activeVisual;
      const outgoingBar = outgoingContent?.querySelector('[data-tabs="item-progress"]');

      const incomingContent = contentItems[index];
      const incomingVisual = visualItems[index];
      const incomingBar = incomingContent.querySelector('[data-tabs="item-progress"]');

      outgoingContent?.classList.remove("active");
      outgoingVisual?.classList.remove("active");
      incomingContent.classList.add("active");
      incomingVisual.classList.add("active");

      // If GSAP is missing, fall back to instant switch
      if (typeof gsap === "undefined") {
        activeContent = incomingContent;
        activeVisual = incomingVisual;
        isAnimating = false;
        if (autoplay) startProgressBar(index);
        return;
      }

      const tl = gsap.timeline({
        defaults: { duration: 0.65, ease: "power3" },
        onComplete: () => {
          activeContent = incomingContent;
          activeVisual = incomingVisual;
          isAnimating = false;
          if (autoplay) startProgressBar(index);
        },
      });

      if (outgoingContent) {
        outgoingContent.classList.remove("active");
        outgoingVisual?.classList.remove("active");
        tl.set(outgoingBar, { transformOrigin: "right center" })
          .to(outgoingBar, { scaleX: 0, duration: 0.3 }, 0)
          .to(outgoingVisual, { autoAlpha: 0, xPercent: 0 }, 0)
          .to(outgoingContent.querySelector('[data-tabs="item-details"]'), { height: 0 }, 0);
      }

      incomingContent.classList.add("active");
      incomingVisual.classList.add("active");
      tl.fromTo(
        incomingVisual,
        { autoAlpha: 0, xPercent: 0 },
        { autoAlpha: 1, xPercent: 0 },
        0.3
      )
        .fromTo(
          incomingContent.querySelector('[data-tabs="item-details"]'),
          { height: 0 },
          { height: "auto" },
          0
        )
        .set(incomingBar, { scaleX: 0, transformOrigin: "left center" }, 0);
    }

    // Initialize first tab
    switchTab(0);

    // Click to switch
    contentItems.forEach((item, i) => {
      item.addEventListener("click", () => {
        if (item === activeContent) return;
        switchTab(i);
      });
    });
  }

  // --- Observe wrappers and init when in view ---
  document.addEventListener("DOMContentLoaded", () => {
    const wrappers = document.querySelectorAll('[data-tabs="wrapper"]');
    const initialized = new WeakMap();

    if (!("IntersectionObserver" in window)) {
      // Fallback: initialize immediately
      wrappers.forEach((w) => {
        if (!initialized.get(w)) {
          initTabSystem(w);
          initialized.set(w, true);
        }
      });
      return;
    }

    const observer = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting && !initialized.get(entry.target)) {
            initTabSystem(entry.target);
            initialized.set(entry.target, true);
            // Only initialize once
            observer.unobserve(entry.target);
          }
        });
      },
      {
        root: null,
        threshold: 0.35, // 35% visible triggers init
      }
    );

    wrappers.forEach((w) => observer.observe(w));
  });
</script>

<script>
  gsap.registerPlugin(ScrollTrigger);

  // Only run script on screens 992px and above
  if (window.matchMedia("(min-width: 992px)").matches) {

    // Logo width change animation
    gsap.to(".navbar1_logo-link", {
      scrollTrigger: {
        trigger: ".navbar1_component",
        start: "top 16px", // Trigger after scrolling 16px on larger screens
        end: "top 16px", // End trigger condition (same as start to avoid animation reversing)
        scrub: true, // Smooth transition as the page scrolls
      },
      width: "1.5rem", // Change the width of the logo link
      ease: "ease", // Apply easing
      from: { width: "7.5rem" }, // Set the original width to 7.5rem
    });

    // Only run padding + border animations on larger screens
    gsap.to(".navbar1_container", {
      scrollTrigger: {
        trigger: ".navbar1_component",
        start: "top 16px",
        end: "top 16px",
        scrub: true,
      },
      paddingLeft: "1.875rem",
      paddingRight: "1.875rem",
      ease: "ease",
    });

    // Border color change animation
    gsap.to(".navbar1_container", {
      scrollTrigger: {
        trigger: ".navbar1_component",
        start: "top 16px",
        end: "top 16px",
        scrub: true,
      },
      borderLeftColor: "var(--semantic--c-stroke)",
      borderRightColor: "var(--semantic--c-stroke)",
      ease: "ease",
    });
  }
</script>

