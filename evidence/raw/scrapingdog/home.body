00","concurrency":"900","support":"dedicated"},{"name":"ULTRA STARTER","monthly":12000,"annual":10000,"credits":"360,000,000","concurrency":"1,000","support":"dedicated-am"},{"name":"ULTRA PLUS","monthly":14000,"annual":11666,"credits":"430,000,000","concurrency":"1,200","support":"dedicated-am"},{"name":"ULTRA PRO","monthly":16000,"annual":13333,"credits":"500,000,000","concurrency":"1,300","support":"dedicated-am"},{"name":"TITAN STARTER","monthly":18000,"annual":15000,"credits":"580,000,000","concurrency":"1,400","support":"dedicated-am"},{"name":"TITAN PLUS","monthly":20000,"annual":16666,"credits":"660,000,000","concurrency":"1,500","support":"dedicated-am"},{"name":"TITAN PRO","monthly":22000,"annual":18333,"credits":"740,000,000","concurrency":"1,700","support":"dedicated-am"},{"name":"TITAN ELITE","monthly":24000,"annual":20000,"credits":"830,000,000","concurrency":"1,800","support":"dedicated-am"},{"name":"NOVA STARTER","monthly":26000,"annual":21666,"credits":"920,000,000","concurrency":"1,900","support":"dedicated-am"},{"name":"NOVA PLUS","monthly":28000,"annual":23333,"credits":"1,010,000,000","concurrency":"2,000","support":"dedicated-am"},{"name":"NOVA PRO","monthly":30000,"annual":25000,"credits":"1,100,000,000","concurrency":"2,200","support":"dedicated-am"}]</script><script type="application/json" id="deferred-pricing-meta">{"trialHref":"https://api.scrapingdog.com/register","supportLabel":{"email":"Email Support","priority":"Priority Email Support","dedicated":"Dedicated Support","dedicated-am":"Dedicated Account Manager"},"accessAllApis":"Access To All APIs","geotargeting":"Geotargeting","teamSupport":"Team Support","noTeamSupport":"No Team Support","perMonth":"/month","startTrial":"Start Trial","popular":"Popular","requestsCreditsSuffix":" Requests Credits","concurrencySuffix":" Concurrency"}</script></div></div></section><script type="module" src="/_assets/Pricing.astro_astro_type_script_index_0_lang.DogN7Vjv.js"></script><script type="application/ld+json">{"@context":"https://schema.org","@type":"FAQPage","mainEntity":[{"@type":"Question","name":"What Is Scrapingdog?","acceptedAnswer":{"@type":"Answer","text":"Scrapingdog is a web scraping API that lets you scrape data from a source you desire. When you need data in bulk, you can use a web scraping API. We have multiple dedicated APIs built to extract data from different platforms, including Google Search, Profile Scraper & Amazon Product Data that give you output in parsed JSON format."}},{"@type":"Question","name":"What happens if my credits run out before my monthly billing cycle ends?","acceptedAnswer":{"@type":"Answer","text":"If you use up your credits before the end of your current subscription cycle, you have two options: Add one-time credits from your dashboard. These credits are valid only until your current subscription cycle ends. Upgrade to a higher plan if you need more recurring credits every month."}},{"@type":"Question","name":"Do you need multiple subscriptions for extracting data from different scraping APIs?","acceptedAnswer":{"@type":"Answer","text":"No, you only need a single account to use our dedicated scrapers. For example, if you want to use both the Google Scraper API and the LinkedIn Scraper API simultaneously, you can do so with one account. However, please note that Scrapingdog operates on a credit system, and each dedicated scraper has different credit usage per call request. For more information on the credit system, please refer to the documentation."}},{"@type":"Question","name":"What happens if a request fails?","acceptedAnswer":{"@type":"Answer","text":"We only charge for successful requests. If your request fails credits in your account remain intact."}},{"@type":"Question","name":"Can your API handle large volumes of concurrent requests without impacting performance or reliability?","acceptedAnswer":{"@type":"Answer","text":"Yes, our API is built to handle high volumes of concurrent requests while maintaining performance and reliability. We process millions of requests every month with stable uptime."}},{"@type":"Question","name":"What's the difference between credits and requests?","acceptedAnswer":{"@type":"Answer","text":"Each API request consumes a certain number of credits based on the dedicated API you're using. For example the Google Search API costs 5 credits per request. So, if you make one request to the Google Search API, it will deduct 5 credits from the available credits in your account. The number of credits required per request can vary depending on the specific API you're using. You can find more details about the credit usage for each API in the documentation."}}]}</script><section class="sm:px-6 2xl:max-w-[1728px] 2xl:px-[92px] lg:px-10 max-w-7xl md:px-8 mx-auto px-4 xl:max-w-[1440px] xl:px-[80px] 2xl:py-20 lg:py-16 md:py-14 py-10 sm:py-12 xl:py-16 overflow-x-clip"><div class="flex flex-col gap-8 sm:gap-10 xl:gap-12"><div class="flex flex-col"><h2 class="text-ink font-bold text-balance leading-[1.3] 2xl:text-5xl md:text-[40px] sm:text-4xl text-3xl">Frequently Asked <span class="relative inline-block whitespace-nowrap"><img alt class="absolute pointer-events-none left-1/2 max-w-none top-1/2" src="data:image/svg+xml,%3csvg%20xmlns='http://www.w3.org/2000/svg'%20width='166'%20height='40'%20fill='none'%20viewBox='0%200%20166%2040'%3e%3cpath%20fill='%233ea380'%20d='M104.296%2034.85c15.361-1.258%2027.08-2.523%2038.581-5.254%204.158-.966%208.193-2.415%2012.153-3.858%201.758-.664%203.393-1.813%204.796-3.01q3.583-3-.093-5.73c-1.557-1.197-3.401-2.225-5.232-3.113-4.843-2.228-10.056-3.571-15.256-4.773-12.881-2.947-26.071-4.376-39.338-5.018-15.092-.68-30.07-.165-45.07%201.697-11.027%201.34-21.995%203.312-32.744%205.972-6.08%201.503-12.152%203.077-18.23%204.58-.076.008-.151.015-.22.092-1.559.362-2.577.035-2.815-.864-.388-.883.31-1.517%201.931-2.027%2010.347-2.904%2020.769-5.816%2031.353-7.822%2011.405-2.156%2022.857-3.82%2034.472-4.578C88.266-.176%20107.835.5%20127.32%203.452c7.702%201.175%2015.287%202.716%2022.659%205.198%203.375%201.165%206.633%202.695%209.816%204.232%201.352.65%202.601%201.806%203.618%202.913%202.286%202.473%202.35%205.514.09%208.069-1.301%201.47-2.998%202.767-4.797%203.79-4.167%202.454-8.824%203.75-13.495%204.906-15.146%203.506-30.474%205.117-45.957%205.892-6.27.317-12.538.634-18.82.811-8.1.21-16.283.355-24.41.284-7.67-.045-15.284-.307-22.925-.85-4.279-.299-8.605-1.09-12.78-1.894-2.01-.374-3.99-1.247-5.752-2.212-3.859-2.252-4.427-5.811-1.647-9.266%201.623-2.069%203.847-3.415%206.235-4.636%205.28-2.703%2010.95-4.521%2016.722-6.066a109.7%20109.7%200%200%201%2024.3-3.817c2.036-.124%202.993.351%203.018%201.412.013.92-.85%201.427-2.723%201.678-4.874.608-9.763%201.077-14.617%201.896-8.287%201.432-16.343%203.692-23.895%207.25a26%2026%200%200%200-4.878%202.947c-3.381%202.733-3.009%205.036%201.008%206.564%201.893.74%203.915%201.255%206%201.622%206.416%201.227%2012.91%201.668%2019.444%201.75%2012.379.09%2024.833.172%2037.179-.09%209.023-.085%2018.143-.746%2023.584-.984'%20opacity='.3'/%3e%3c/svg%3e" aria-hidden="true" style="width:115%;transform:translate(-50%,-50%) rotate(-5.5deg)"><span class="relative font-normal font-script">Questions</span></span></h2></div><div class="flex flex-col gap-4 md:flex-row md:items-start"><ul class="flex flex-col gap-4 flex-1"><li><div class="group rounded-2xl bg-surface-card" data-collapse data-open="false"><button class="flex w-full gap-4 bg-transparent cursor-pointer focus-visible:outline-2 focus-visible:outline-current focus-visible:outline-offset-4 justify-between text-left items-start p-5 sm:p-6" type="button" aria-controls="faq-panel-1" aria-expanded="false" data-collapse-trigger><span class="text-ink text-base font-semibold leading-[1.5]">What Is Scrapingdog? </span><svg aria-hidden="true" class="text-brand-500 shrink-0 h-4 duration-200 ease-out-soft group-data-[open=true]:rotate-180 mt-1 transition-transform w-auto" fill="none" viewBox="0 0 15 17" height="17" width="15"><path d="M7.72559 15.75L7.72559 0.75" stroke="currentColor" stroke-linecap="round" stroke-width="1.5" stroke-linejoin="round"/><path d="M1.70124 9.70019L7.72524 15.7502L13.7502 9.7002" stroke="currentColor" stroke-linecap="round" stroke-width="1.5" stroke-linejoin="round"/></svg></button><div class="ease-out-soft duration-300 grid grid-rows-[0fr] group-data-[open=true]:grid-rows-[1fr] transition-[grid-template-rows]" id="faq-panel-1" data-collapse-panel inert><div class="overflow-hidden"><div class="text-sm sm:text-base leading-[1.7] text-ink-soft [&_a:hover]:underline [&_a]:font-semibold [&_a]:text-brand-text [&_p:last-child]:mb-0 [&_p]:mb-3 [&_strong]:font-semibold [&_ul]:list-disc [&_ul]:my-3 [&_ul]:pl-5 [&_ul_li:last-child]:mb-0 [&_ul_li]:mb-2 pb-5 px-5 sm:pb-6 sm:px-6"><p>Scrapingdog is a web scraping API that lets you scrape data from a source you desire. When you need data in bulk, you can use a web scraping API. We have multiple dedicated APIs built to extract data from different platforms, including Google Search, Profile Scraper &amp; Amazon Product Data that give you output in parsed JSON format.</p></div></div></div></div></li><li><div class="group rounded-2xl bg-surface-card" data-collapse data-open="false"><button class="flex w-full gap-4 bg-transparent cursor-pointer focus-visible:outline-2 focus-visible:outline-current focus-visible:outline-offset-4 justify-between text-left items-start p-5 sm:p-6" type="button" aria-controls="faq-panel-2" aria-expanded="false" data-collapse-trigger><span class="text-ink text-base font-semibold leading-[1.5]">What happens if my credits run out before my monthly billing cycle ends? </span><svg aria-hidden="true" class="text-brand-500 shrink-0 h-4 duration-200 ease-out-soft group-data-[open=true]:rotate-180 mt-1 transition-transform w-auto" fill="none" viewBox="0 0 15 17" height="17" width="15"><path d="M7.72559 15.75L7.72559 0.75" stroke="currentColor" stroke-linecap="round" stroke-width="1.5" stroke-linejoin="round"/><path d="M1.70124 9.70019L7.72524 15.7502L13.7502 9.7002" stroke="currentColor" stroke-linecap="round" stroke-width="1.5" stroke-linejoin="round"/></svg></button><div class="ease-out-soft duration-300 grid grid-rows-[0fr] group-data-[open=true]:grid-rows-[1fr] transition-[grid-template-rows]" id="faq-panel-2" data-collapse-panel inert><div class="overflow-hidden"><div class="text-sm sm:text-base leading-[1.7] text-ink-soft [&_a:hover]:underline [&_a]:font-semibold [&_a]:text-brand-text [&_p:last-child]:mb-0 [&_p]:mb-3 [&_strong]:font-semibold [&_ul]:list-disc [&_ul]:my-3 [&_ul]:pl-5 [&_ul_li:last-child]:mb-0 [&_ul_li]:mb-2 pb-5 px-5 sm:pb-6 sm:px-6"><p>If you use up your credits before the end of your current subscription cycle, you have two options:</p><ul><li><strong>Add one-time credits</strong> from your dashboard. These credits are valid only until your current subscription cycle ends.</li><li><strong>Upgrade to a higher plan</strong> if you need more recurring credits every month.</li></ul></div></div></div></div></li><li><div class="group rounded-2xl bg-surface-card" data-collapse data-open="false"><button class="flex w-full gap-4 bg-transparent cursor-pointer focus-visible:outline-2 focus-visible:outline-current focus-visible:outline-offset-4 justify-between text-left items-start p-5 sm:p-6" type="button" aria-controls="faq-panel-3" aria-expanded="false" data-collapse-trigger><span class="text-ink text-base font-semibold leading-[1.5]">Do you need multiple subscriptions for extracting data from different scraping APIs? </span><svg aria-hidden="true" class="text-brand-500 shrink-0 h-4 duration-200 ease-out-soft group-data-[open=true]:rotate-180 mt-1 transition-transform w-auto" fill="none" viewBox="0 0 15 17" height="17" width="15"><path d="M7.72559 15.75L7.72559 0.75" stroke="currentColor" stroke-linecap="round" stroke-width="1.5" stroke-linejoin="round"/><path d="M1.70124 9.70019L7.72524 15.7502L13.7502 9.7002" stroke="currentColor" stroke-linecap="round" stroke-width="1.5" stroke-linejoin="round"/></svg></button><div class="ease-out-soft duration-300 grid grid-rows-[0fr] group-data-[open=true]:grid-rows-[1fr] transition-[grid-template-rows]" id="faq-panel-3" data-collapse-panel inert><div class="overflow-hidden"><div class="text-sm sm:text-base leading-[1.7] text-ink-soft [&_a:hover]:underline [&_a]:font-semibold [&_a]:text-brand-text [&_p:last-child]:mb-0 [&_p]:mb-3 [&_strong]:font-semibold [&_ul]:list-disc [&_ul]:my-3 [&_ul]:pl-5 [&_ul_li:last-child]:mb-0 [&_ul_li]:mb-2 pb-5 px-5 sm:pb-6 sm:px-6"><p>No, you only need a single account to use our dedicated scrapers. For example, if you want to use both the Google Scraper API and the LinkedIn Scraper API simultaneously, you can do so with one account. However, please note that Scrapingdog operates on a credit system, and each dedicated scraper has different credit usage per call request. For more information on the credit system, please refer to the <a href="/documentation/"><strong>documentation</strong></a>.</p></div></div></div></div></li></ul><ul class="flex flex-col gap-4 flex-1"><li><div class="group rounded-2xl bg-surface-card" data-collapse data-open="false"><button class="flex w-full gap-4 bg-transparent cursor-pointer focus-visible:outline-2 focus-visible:outline-current focus-visible:outline-offset-4 justify-between text-left items-start p-5 sm:p-6" type="button" aria-controls="faq-panel-4" aria-expanded="false" data-collapse-trigger><span class="text-ink text-base font-semibold leading-[1.5]">What happens if a request fails? </span><svg aria-hidden="true" class="text-brand-500 shrink-0 h-4 duration-200 ease-out-soft group-data-[open=true]:rotate-180 mt-1 transition-transform w-auto" fill="none" viewBox="0 0 15 17" height="17" width="15"><path d="M7.72559 15.75L7.72559 0.75" stroke="currentColor" stroke-linecap="round" stroke-width="1.5" stroke-linejoin="round"/><path d="M1.70124 9.70019L7.72524 15.7502L13.7502 9.7002" stroke="currentColor" stroke-linecap="round" stroke-width="1.5" stroke-linejoin="round"/></svg></button><div class="ease-out-soft duration-300 grid grid-rows-[0fr] group-data-[open=true]:grid-rows-[1fr] transition-[grid-template-rows]" id="faq-panel-4" data-collapse-panel inert><div class="overflow-hidden"><div class="text-sm sm:text-base leading-[1.7] text-ink-soft [&_a:hover]:underline [&_a]:font-semibold [&_a]:text-brand-text [&_p:last-child]:mb-0 [&_p]:mb-3 [&_strong]:font-semibold [&_ul]:list-disc [&_ul]:my-3 [&_ul]:pl-5 [&_ul_li:last-child]:mb-0 [&_ul_li]:mb-2 pb-5 px-5 sm:pb-6 sm:px-6"><p>We only charge for successful requests. If your request fails credits in your account remain intact.</p></div></div></div></div></li><li><div class="group rounded-2xl bg-surface-card" data-collapse data-open="false"><button class="flex w-full gap-4 bg-transparent cursor-pointer focus-visible:outline-2 focus-visible:outline-current focus-visible:outline-offset-4 justify-between text-left items-start p-5 sm:p-6" type="button" aria-controls="faq-panel-5" aria-expanded="false" data-collapse-trigger><span class="text-ink text-base font-semibold leading-[1.5]">Can your API handle large volumes of concurrent requests without impacting performance or reliability? </span><svg aria-hidden="true" class="text-brand-500 shrink-0 h-4 duration-200 ease-out-soft group-data-[open=true]:rotate-180 mt-1 transition-transform w-auto" fill="none" viewBox="0 0 15 17" height="17" width="15"><path d="M7.72559 15.75L7.72559 0.75" stroke="currentColor" stroke-linecap="round" stroke-width="1.5" stroke-linejoin="round"/><path d="M1.70124 9.70019L7.72524 15.7502L13.7502 9.7002" stroke="currentColor" stroke-linecap="round" stroke-width="1.5" stroke-linejoin="round"/></svg></button><div class="ease-out-soft duration-300 grid grid-rows-[0fr] group-data-[open=true]:grid-rows-[1fr] transition-[grid-template-rows]" id="faq-panel-5" data-collapse-panel inert><div class="overflow-hidden"><div class="text-sm sm:text-base leading-[1.7] text-ink-soft [&_a:hover]:underline [&_a]:font-semibold [&_a]:text-brand-text [&_p:last-child]:mb-0 [&_p]:mb-3 [&_strong]:font-semibold [&_ul]:list-disc [&_ul]:my-3 [&_ul]:pl-5 [&_ul_li:last-child]:mb-0 [&_ul_li]:mb-2 pb-5 px-5 sm:pb-6 sm:px-6"><p>Yes, our API is built to handle high volumes of concurrent requests while maintaining performance and reliability. We process millions of requests every month with stable uptime.</p></div></div></div></div></li><li><div class="group rounded-2xl bg-surface-card" data-collapse data-open="false"><button class="flex w-full gap-4 bg-transparent cursor-pointer focus-visible:outline-2 focus-visible:outline-current focus-visible:outline-offset-4 justify-between text-left items-start p-5 sm:p-6" type="button" aria-controls="faq-panel-6" aria-expanded="false" data-collapse-trigger><span class="text-ink text-base font-semibold leading-[1.5]">What&#39;s the difference between credits and requests? </span><svg aria-hidden="true" class="text-brand-500 shrink-0 h-4 duration-200 ease-out-soft group-data-[open=true]:rotate-180 mt-1 transition-transform w-auto" fill="none" viewBox="0 0 15 17" height="17" width="15"><path d="M7.72559 15.75L7.72559 0.75" stroke="currentColor" stroke-linecap="round" stroke-width="1.5" stroke-linejoin="round"/><path d="M1.70124 9.70019L7.72524 15.7502L13.7502 9.7002" stroke="currentColor" stroke-linecap="round" stroke-width="1.5" stroke-linejoin="round"/></svg></button><div class="ease-out-soft duration-300 grid grid-rows-[0fr] group-data-[open=true]:grid-rows-[1fr] transition-[grid-template-rows]" id="faq-panel-6" data-collapse-panel inert><div class="overflow-hidden"><div class="text-sm sm:text-base leading-[1.7] text-ink-soft [&_a:hover]:underline [&_a]:font-semibold [&_a]:text-brand-text [&_p:last-child]:mb-0 [&_p]:mb-3 [&_strong]:font-semibold [&_ul]:list-disc [&_ul]:my-3 [&_ul]:pl-5 [&_ul_li:last-child]:mb-0 [&_ul_li]:mb-2 pb-5 px-5 sm:pb-6 sm:px-6"><p><strong>Each API request</strong> consumes a certain <strong>number of credits</strong> based on the dedicated API you're using.</p><p>For example the Google Search API costs <strong>5 credits per request</strong>. So, if you make one request to the Google Search API, it will deduct 5 credits from the available credits in your account. The number of credits required per request can vary depending on the specific API you're using.</p><p>You can find more details about the credit usage for each API in the <a href="/documentation/"><strong>documentation</strong></a>.</p></div></div></div></div></li></ul></div></div></section><section class="sm:px-6 2xl:max-w-[1728px] 2xl:px-[92px] lg:px-10 max-w-7xl md:px-8 mx-auto px-4 xl:max-w-[1440px] xl:px-[80px] 2xl:py-20 lg:py-16 md:py-14 py-10 sm:py-12 xl:py-16 overflow-x-clip"><div class="relative overflow-hidden bg-gradient-to-b from-brand-900 px-6 py-10 rounded-3xl sm:px-10 sm:py-12 to-brand-800 xl:px-16 xl:py-14 xl:rounded-[3rem]"><svg aria-hidden="true" class="absolute pointer-events-none -bottom-8 -right-4 h-64 w-40 xl:h-80 xl:w-44" fill="none" viewBox="0 0 160 320" xmlns="http://www.w3.org/2000/svg"><path d="M63.4395 338.973C98.4725 227.402 214.206 -48.9902 396.875 -261.988C625.211 -528.235 703.675 -728.76 704.439 -771.272" stroke="var(--color-brand-300)" stroke-linecap="round" opacity="0.1"/><path d="M50.4395 338.973C85.4725 227.402 201.206 -48.9902 383.875 -261.988C612.211 -528.235 690.675 -728.76 691.439 -771.272" stroke="var(--color-brand-300)" stroke-linecap="round" opacity="0.1"/><path d="M32.4395 338.973C67.4725 227.402 183.206 -48.9902 365.875 -261.988C594.211 -528.235 672.675 -728.76 673.439 -771.272" stroke="var(--color-brand-300)" stroke-linecap="round" opacity="0.1"/></svg> <svg aria-hidden="true" class="absolute pointer-events-none bottom-0 h-16 left-0 w-full" fill="none" viewBox="0 0 1282 71" xmlns="http://www.w3.org/2000/svg" preserveAspectRatio="none"><path d="M1289 40.0421C1173.88 65.4883 874.101 103.456 595.939 51.7592C248.236 -12.8622 33.5171 19.4485 -3.99995 40.0421" stroke="var(-