ap-1.5 inline-flex text-sm font-semibold mt-auto text-brand-text">Learn More <svg aria-hidden="true" class="duration-150 transition-transform group-hover:translate-x-0.5" fill="none" viewBox="0 0 16 16" height="16" width="16"><path d="M9.62 12.547a.55.55 0 0 1-.354-.147.493.493 0 0 1 0-.707L12.96 8 9.267 4.307a.5.5 0 0 1 .707-.707l4.046 4.046a.5.5 0 0 1 0 .707l-4.046 4.047a.55.55 0 0 1-.354.147Z" fill="currentColor"/><path d="M13.553 8.5H2.333a.5.5 0 0 1 0-1h11.22a.5.5 0 0 1 0 1Z" fill="currentColor"/></svg></span></a></li><li class="flex"><a href="/google-serp-api/" class="flex flex-col gap-4 sm:gap-5 h-full w-full border-l-[3px] border-transparent duration-150 group hover:border-brand-500 pl-5 sm:pl-6 transition-colors"><div class="[&>svg]:h-full [&>svg]:w-full shrink-0 h-10 w-10"><svg viewBox="0 0 40 41" fill="none" height="41" width="40" xmlns="http://www.w3.org/2000/svg"><g clip-path="url(#a)"><path d="M39.61 20.71c0-1.359-.11-2.726-.345-4.063H20.4v7.701h10.803a9.26 9.26 0 0 1-3.998 6.078v4.997h6.445c3.785-3.483 5.96-8.628 5.96-14.712" fill="#4285f4"/><path d="M20.4 40.251c5.394 0 9.943-1.77 13.257-4.828l-6.445-4.997c-1.793 1.22-4.108 1.91-6.805 1.91-5.217 0-9.641-3.52-11.229-8.252h-6.65v5.151A20 20 0 0 0 20.4 40.251" fill="#34a853"/><path d="M9.17 24.084a11.98 11.98 0 0 1 0-7.658v-5.151H2.529a20.02 20.02 0 0 0 0 17.96z" fill="#fbbc04"/><path d="M20.4 8.166a10.87 10.87 0 0 1 7.672 2.998l5.71-5.71A19.22 19.22 0 0 0 20.4.251 20 20 0 0 0 2.528 11.275l6.643 5.151c1.58-4.74 6.011-8.26 11.229-8.26" fill="#ea4335"/></g><defs><clipPath id="a"><path d="M0 .25h40v40H0z" fill="#fff"/></clipPath></defs></svg></div><h3 class="duration-150 transition-colors font-bold text-surface group-hover:text-brand-500 sm:text-2xl text-xl">Google SERP API</h3><p class="text-sm sm:text-base leading-[1.7] text-pretty text-surface/70">Collect organic results, ads, featured snippets, and People Also Ask data from Google SERPs at scale. Use for SEO monitoring, rank tracking, competitor research, and training LLMs with fresh web data.</p><span class="items-center gap-1.5 inline-flex text-sm font-semibold mt-auto text-brand-text">Learn More <svg aria-hidden="true" class="duration-150 transition-transform group-hover:translate-x-0.5" fill="none" viewBox="0 0 16 16" height="16" width="16"><path d="M9.62 12.547a.55.55 0 0 1-.354-.147.493.493 0 0 1 0-.707L12.96 8 9.267 4.307a.5.5 0 0 1 .707-.707l4.046 4.046a.5.5 0 0 1 0 .707l-4.046 4.047a.55.55 0 0 1-.354.147Z" fill="currentColor"/><path d="M13.553 8.5H2.333a.5.5 0 0 1 0-1h11.22a.5.5 0 0 1 0 1Z" fill="currentColor"/></svg></span></a></li><li class="flex"><a href="/walmart-scraper-api/" class="flex flex-col gap-4 sm:gap-5 h-full w-full border-l-[3px] border-transparent duration-150 group hover:border-brand-500 pl-5 sm:pl-6 transition-colors"><div class="[&>svg]:h-full [&>svg]:w-full shrink-0 h-10 w-10"><svg viewBox="0 0 40 40" fill="none" height="40" width="40" xmlns="http://www.w3.org/2000/svg"><path d="m13.722 21.887-7.96 3.695a2.033 2.033 0 0 0-.223 2.76c.64 1.091 1.76 1.613 2.5 1.176l7.198-5.018a1.43 1.43 0 0 0 .052-1.777 1.42 1.42 0 0 0-1.567-.836m12.587.001c-.5-.196-1.167.167-1.57.842a1.45 1.45 0 0 0 .043 1.767l7.192 5.03c.747.426 1.872-.092 2.512-1.185.64-1.094.515-2.334-.225-2.76zm-6.295 3.564a1.43 1.43 0 0 0-1.51.926l-.777 8.725c0 .864 1.01 1.564 2.287 1.564s2.285-.7 2.285-1.564l-.77-8.725a1.43 1.43 0 0 0-1.515-.926m4.725-8.174a1.47 1.47 0 0 0 1.57.849l7.96-3.702c.74-.437.85-1.658.225-2.757-.625-1.098-1.765-1.616-2.512-1.19L24.791 15.5a1.47 1.47 0 0 0-.044 1.783zM8.046 10.482c-.747-.437-1.867.083-2.5 1.183a2.033 2.033 0 0 0 .223 2.76l7.953 3.692a1.424 1.424 0 0 0 1.567-.834 1.43 1.43 0 0 0-.052-1.775zm11.968-7.149c-1.277 0-2.287.707-2.287 1.572l.787 8.723a1.43 1.43 0 0 0 1.5.927 1.43 1.43 0 0 0 1.515-.927l.77-8.723c.002-.865-1.015-1.572-2.285-1.572" fill="#f24822"/></svg></div><h3 class="duration-150 transition-colors font-bold text-surface group-hover:text-brand-500 sm:text-2xl text-xl">Walmart Scraper API</h3><p class="text-sm sm:text-base leading-[1.7] text-pretty text-surface/70">Retrieve product data including price, seller ID, seller name, stock status, and category from Walmart’s catalog. Perfect for retail analytics and marketplace monitoring pipelines.</p><span class="items-center gap-1.5 inline-flex text-sm font-semibold mt-auto text-brand-text">Learn More <svg aria-hidden="true" class="duration-150 transition-transform group-hover:translate-x-0.5" fill="none" viewBox="0 0 16 16" height="16" width="16"><path d="M9.62 12.547a.55.55 0 0 1-.354-.147.493.493 0 0 1 0-.707L12.96 8 9.267 4.307a.5.5 0 0 1 .707-.707l4.046 4.046a.5.5 0 0 1 0 .707l-4.046 4.047a.55.55 0 0 1-.354.147Z" fill="currentColor"/><path d="M13.553 8.5H2.333a.5.5 0 0 1 0-1h11.22a.5.5 0 0 1 0 1Z" fill="currentColor"/></svg></span></a></li><li class="flex"><a href="/profile-scraper-api/" class="flex flex-col gap-4 sm:gap-5 h-full w-full border-l-[3px] border-transparent duration-150 group hover:border-brand-500 pl-5 sm:pl-6 transition-colors"><div class="[&>svg]:h-full [&>svg]:w-full shrink-0 h-10 w-10"><svg viewBox="0 0 40 40" fill="none" height="40" width="40" xmlns="http://www.w3.org/2000/svg"><path d="M20 3.333a8.334 8.334 0 1 0 0 16.668 8.334 8.334 0 0 0 0-16.668m0 13.334a5 5 0 1 1 0-10 5 5 0 0 1 0 10M35 35v-1.667a11.667 11.667 0 0 0-11.667-11.666h-6.666A11.667 11.667 0 0 0 5 33.333V35h3.333v-1.667A8.333 8.333 0 0 1 16.667 25h6.666a8.333 8.333 0 0 1 8.334 8.333V35z" fill="#fff"/></svg></div><h3 class="duration-150 transition-colors font-bold text-surface group-hover:text-brand-500 sm:text-2xl text-xl">Profile Scraper API</h3><p class="text-sm sm:text-base leading-[1.7] text-pretty text-surface/70">Extract structured data from public profiles and company pages at scale: names, roles, experience, and organization details. Clean JSON, no parsing required. Ideal for recruiting, lead enrichment, and people analytics.</p><span class="items-center gap-1.5 inline-flex text-sm font-semibold mt-auto text-brand-text">Learn More <svg aria-hidden="true" class="duration-150 transition-transform group-hover:translate-x-0.5" fill="none" viewBox="0 0 16 16" height="16" width="16"><path d="M9.62 12.547a.55.55 0 0 1-.354-.147.493.493 0 0 1 0-.707L12.96 8 9.267 4.307a.5.5 0 0 1 .707-.707l4.046 4.046a.5.5 0 0 1 0 .707l-4.046 4.047a.55.55 0 0 1-.354.147Z" fill="currentColor"/><path d="M13.553 8.5H2.333a.5.5 0 0 1 0-1h11.22a.5.5 0 0 1 0 1Z" fill="currentColor"/></svg></span></a></li></ul></div></section><section class="sm:px-6 2xl:max-w-[1728px] 2xl:px-[92px] lg:px-10 max-w-7xl md:px-8 mx-auto px-4 xl:max-w-[1440px] xl:px-[80px] 2xl:py-20 lg:py-16 md:py-14 py-10 sm:py-12 xl:py-16 overflow-x-clip"><div class="flex flex-col gap-8 sm:gap-10 xl:gap-12"><div class="flex flex-col gap-3 items-center text-center max-w-4xl mx-auto"><h2 class="text-ink font-bold text-balance leading-[1.3] 2xl:text-5xl md:text-[40px] sm:text-4xl text-3xl">What Developers <span class="relative inline-block whitespace-nowrap"><img alt class="absolute pointer-events-none left-1/2 max-w-none top-1/2" src="data:image/svg+xml,%3csvg%20xmlns='http://www.w3.org/2000/svg'%20width='166'%20height='40'%20fill='none'%20viewBox='0%200%20166%2040'%3e%3cpath%20fill='%233ea380'%20d='M104.296%2034.85c15.361-1.258%2027.08-2.523%2038.581-5.254%204.158-.966%208.193-2.415%2012.153-3.858%201.758-.664%203.393-1.813%204.796-3.01q3.583-3-.093-5.73c-1.557-1.197-3.401-2.225-5.232-3.113-4.843-2.228-10.056-3.571-15.256-4.773-12.881-2.947-26.071-4.376-39.338-5.018-15.092-.68-30.07-.165-45.07%201.697-11.027%201.34-21.995%203.312-32.744%205.972-6.08%201.503-12.152%203.077-18.23%204.58-.076.008-.151.015-.22.092-1.559.362-2.577.035-2.815-.864-.388-.883.31-1.517%201.931-2.027%2010.347-2.904%2020.769-5.816%2031.353-7.822%2011.405-2.156%2022.857-3.82%2034.472-4.578C88.266-.176%20107.835.5%20127.32%203.452c7.702%201.175%2015.287%202.716%2022.659%205.198%203.375%201.165%206.633%202.695%209.816%204.232%201.352.65%202.601%201.806%203.618%2