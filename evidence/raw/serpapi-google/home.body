  <body data-turbolinks="false">
      <script>
    utils.getAccountData().then(function(data) {
      if (!data.impersonating) return;

      fetch("/impersonation").then(function(response) { return response.text(); }).then(function(html) {
        document.body.insertAdjacentHTML("beforeend", html);
        if (window.Intercom) Intercom("update", { hide_default_launcher: true });
      });
    });
  </script>


    



