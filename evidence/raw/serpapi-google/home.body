  <script>
    function renderRecaptcha() {
      utils.getAccountData().then((data) => {
        if (!data.api_key) RecaptchaSearchLoad();
        RecaptchaFormLoad();
      });
    }
  </script>


    <meta name="turbolinks-visit-control" content="reload">
