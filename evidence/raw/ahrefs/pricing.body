content="@ahrefs" /><meta name="twitter:site" content="@ahrefs" /><meta name="twitter:description" content="Ahrefs offers subscription packages for any budget. Pick pricing plan which fits for your needs best. Don&apos;t forget to save 20% on annual billing." /><meta name="twitter:title" content="Plans &amp; Pricing - Ahrefs" /><meta name="twitter:image" content="https://static.ahrefs.com/assets/img/og/ahrefs.png?v=2" /><script type="application/ld+json" nonce="Y2EyMDEyMzQyYzk1NmM0YzYyZWRmNzhhOTZiMTJkMzE">{
  "@context": "https://schema.org/",
