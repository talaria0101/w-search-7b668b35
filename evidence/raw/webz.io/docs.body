"div\",\"2\",{\"className\":\"p-5 rounded-md border border-[var(--notion-border)]\",\"children\":[\"$L5\",\"$L6\"]}],\"$L7\"]}]]}],[],[]],\"children\":\"$L8\"}],{\"children\":[\"$L9\",{},null,false,null]},null,false,null]},null,false,\"$@a\"]},null,false,null],\"$Lb\",false]],\"m\":\"$undefined\",\"G\":[\"$c\",[\"$Ld\",\"$Le\",\"$Lf\"]],\"S\":false,\"h\":null,\"s\":\"$undefined\",\"l\":\"$undefined\",\"p\":\"$undefined\",\"d\":\"$undefined\",\"b\":\"U77zRfvJt-nTOj0oJ0Jfp\"}\n"])</script><script>self.__next_f.push([1,"5:[\"$\",\"div\",null,{\"className\":\"h-5 w-1/2 bg-[var(--notion-bg-gray)] rounded mb-3\"}]\n6:[\"$\",\"div\",null,{\"className\":\"space-y-2\",\"children\":[[\"$\",\"div\",\"0\",{\"className\":\"h-4 bg-[var(--notion-bg-gray)] rounded\",\"style\":{\"width\":\"70.10467243086308%\"}}],[\"$\",\"div\",\"1\",{\"className\":\"h-4 bg-[var(--notion-bg-gray)] rounded\",\"style\":{\"width\":\"62.05464018686803%\"}}],[\"$\",\"div\",\"2\",{\"className\":\"h-4 bg-[var(--notion-bg-gray)] rounded\",\"style\":{\"width\":\"79.69584680589102%\"}}]]}]\n7:[\"$\",\"div\",\"3\",{\"className\":\"p-5 rounded-md border border-[var(--notion-border)]\",\"children\":[[\"$\",\"div\",null,{\"className\":\"h-5 w-1/2 bg-[var(--notion-bg-gray)] rounded mb-3\"}],[\"$\",\"div\",null,{\"className\":\"space-y-2\",\"children\":[[\"$\",\"div\",\"0\",{\"className\":\"h-4 bg-[var(--notion-bg-gray)] rounded\",\"style\":{\"width\":\"85.44935838353621%\"}}],[\"$\",\"div\",\"1\",{\"className\":\"h-4 bg-[var(--notion-bg-gray)] rounded\",\"style\":{\"width\":\"72.5860694754171%\"}}],[\"$\",\"div\",\"2\",{\"className\":\"h-4 bg-[var(--notion-bg-gray)] rounded\",\"style\":{\"width\":\"83.07313499037616%\"}}]]}]]}]\n8:[\"$\",\"$1\",\"c\",{\"children\":[[[\"$\",\"script\",\"script-0\",{\"src\":\"/_next/static/chunks/0jvyq93g7gim9.js\",\"async\":true,\"nonce\":\"$undefined\"}],[\"$\",\"script\",\"script-1\",{\"src\":\"/_next/static/chunks/0-6_q-w_-r4yl.js\",\"async\":true,\"nonce\":\"$undefined\"}],[\"$\",\"script\",\"script-2\",{\"src\":\"/_next/static/chunks/06qdd1i8exjlk.js\",\"async\":true,\"nonce\":\"$undefined\"}]],\"$L10\"]}]\n9:[\"$\",\"$1\",\"c\",{\"children\":[\"$L11\",null,[\"$\",\"$L12\",null,{\"children\":[\"$\",\"$13\",null,{\"name\":\"Next.MetadataOutlet\",\"children\":\"$@14\"}]}]]}]\n15:[]\na:\"$W15\"\nb:[\"$\",\"$1\",\"h\",{\"children\":[null,[\"$\",\"$L16\",null,{\"children\":\"$L17\"}],[\"$\",\"div\",null,{\"hidden\":true,\"children\":[\"$\",\"$L18\",null,{\"children\":[\"$\",\"$13\",null,{\"name\":\"Next.Metadata\",\"children\":\"$L19\"}]}]}],[\"$\",\"meta\",null,{\"name\":\"next-size-adjust\",\"content\":\"\"}]]}]\nd:[\"$\",\"link\",\"0\",{\"rel\":\"stylesheet\",\"href\":\"/_next/static/chunks/0r5x.m73ys0uf.css\",\"precedence\":\"next\",\"crossOrigin\":\"$undefined\",\"nonce\":\"$undefined\"}]\ne:[\"$\",\"link\",\"1\",{\"rel\":\"stylesheet\",\"href\":\"/_next/static/chunks/15ojtzbso0i...css\",\"precedence\":\"next\",\"crossOrigin\":\"$undefined\",\"nonce\":\"$undefined\"}]\nf:[\"$\",\"link\",\"2\",{\"rel\":\"stylesheet\",\"href\":\"/_next/static/chunks/16g6l12wjd_iz.css\",\"precedence\":\"next\",\"crossOrigin\":\"$undefined\",\"nonce\":\"$undefined\"}]\n1c:T581,"])</script><script>self.__next_f.push([1,"The [News](https://webz.io/products/news-api/), [Blogs](https://webz.io/products/blogs-api/), [Forums](https://webz.io/products/forums-api/) \u0026 Reviews APIs turn the open web into structured JSON:\n\n- **[News API](news-api)** - articles from news sites.\n- **[Blogs API](blogs-api)** - blog posts.\n- **[Forums API](forums-api)** - posts and replies from online forums.\n- **[Reviews API](reviews-api-what-is)** - customer reviews and ratings.\n\nNews, Blogs, and Forums share one query language, endpoint family, and response format - learn one and you know all three. The Reviews API shares the same query language but is its own product, with its own endpoint and response format - see the [Reviews API introduction](reviews-api-what-is).\n\nNew here? Read [What Are the News, Blogs \u0026 Forums APIs](news-blogs-forums-overview), then make your first request with your product's quickstart: [News](news-api-quickstart), [Blogs](blogs-api-quickstart), or [Forums](forums-api-quickstart).\n\nThe News, Blogs \u0026 Forums APIs replace the deprecated Web Content API. Same content, one endpoint per content type.\n\nEach API also runs as an MCP server, so Cursor, Claude or ChatGPT can query it for you: [News](news-api-mcp), [Blogs](blogs-api-mcp), [Forums](forums-api-mcp). The segmentation endpoints have their own: [News](news-api-segmentation-mcp), [Blogs](blogs-api-segmentation-mcp), [Forums](forums-api-segmentation-mcp).\n"])</script><script>self.__next_f.push([1,"1d:T443,Ready-made ways to call News Search from the framework or platform you already use. Apart from Apify, all of them take your Webz API token and spend the same credits as the REST API.\n\n## Libraries\n\n- [Python client](news-search-api-python) - `webzio-news-search`, calls the REST API directly.\n- [LangChain integration](news-search-api-langchain) - `langchain-webz`, for LangChain and LangGraph.\n- [LlamaIndex integration](news-search-api-llamaindex) - `llama-index-tools-webz`.\n- [CrewAI integration](news-search-api-crewai) - `crewai-webzio`.\n- [AG2 integration](news-search-api-ag2) - `ag2-webzio`.\n- [Vercel AI SDK integration](news-search-api-vercel-ai-sdk) - `@webz.io/ai-sdk`.\n- [Groq integration](news-search-api-groq) - nothing to install, Groq calls the MCP server itself.\n\n## Platforms\n\n- [n8n integration](news-search-api-n8n) - community node, or the built-in MCP Client Tool inside an AI Agent.\n- [Dify integration](news-search-api-dify) - Marketplace plugin.\n- [Apify integration](news-search-api-apify) - the `webzio/news-search` Actor. Billed by Apify, no Webz token needed.\n1e:T434,\u003e [!WARNING]\n\u003e The Web Content API is **deprecated**. Use the [News, Blogs \u0026 Forums APIs](news-blogs-forums-overview) instead - same content, one endpoint per content type, and where new features land.\n\nThe Web Content API gives programmatic access to Webz.io's open web coverage: news articles, blog posts, and online discussions (forums). Each result is a structured, enriched JSON document.\n\nOne endpoint, one boolean query, paginated JSON output.\n\n## Start here\n\n- [What Is the Web Content API](web-content-what-is)\n- [Use Cases](web-content-use-cases)\n- [Quickstart](web-content-quickstart)\n\n## Build a query\n\n- [Query Syntax](web-content-query-syntax)\n- [Filters](web-content-filters)\n- [Content Types](web-content-content-types)\n- [Time Range \u0026 News History](web-content-time-range)\n\n## API reference\n\n- [Endpoint \u0026 Authentication](web-content-endpoint)\n- [Request Parameters](web-content-parameters)\n- [Output Format](web-content-output)\n- [Post Data Fields](web-content-data-fields)\n- [Pagination](web-content-pagination)\n- [Rate Limits \u0026 Errors](web-content-limits)\n"])</script><script>self.__next_f.push([1,"10:[[\"$\",\"$L1a\",null,{\"code\":\"\u003c!-- Google Tag Manager --\u003e\\n\u003cscript\u003e(function(w,d,s,l,i){w[l]=w[l]||[];w[l].push({'gtm.start':\\nnew Date().getTime(),event:'gtm.js'});var f=d.getElementsByTagName(s)[0],\\nj=d.createElement(s),dl=l!='dataLayer'?'\u0026l='+l:'';j.async=true;j.src=\\n'https://www.googletagmanager.com/gtm.js?id='+i+dl;f.parentNode.insertBefore(j,f);\\n})(window,document,'script','dataLayer','GTM-KGMZGFP');\u003c/script\u003e\\n\u003c!-- End Google Tag Manager --\u003e\",\"environmentSlug\":\"webz\"}],[\"$\",\"$L1b\",null,{\"environment\":{\"id\":\"dRSUAaQdD5f8YULeNLxh\",\"isPublic\":true,\"order\":2,\"slug\":\"webz\",\"createdAt\":\"2026-06-01T06:58:11.000Z\",\"sso\":{\"playProUsers\":false,\"allowedOrigins\":[],\"playLoginRef\":\"docs\",\"authServerUrl\":\"\",\"playSessionCookieName\":\"PLAY_SESSION\",\"jwtSecret\":\"\",\"requiresAuth\":false,\"playUserInfoUrl\":\"http://localhost:2000/se/getUserInfo\",\"authMode\":\"cross_domain_sso\",\"playLoginUrl\":\"https://app.lunarcyber.com/login\"},\"navigation\":{\"defaultTreeExpanded\":false},\"theme\":{\"mode\":\"light\",\"primaryColor\":\"#2E3945\",\"linkColor\":\"#ff8d00\",\"headingColor\":\"#2E3945\",\"bodyTextColor\":\"#2b353b\",\"secondaryTextColor\":\"#3a4451\",\"backgroundColor\":\"#ffffff\",\"borderColor\":\"#EFEFEF\",\"codeBackgroundColor\":\"#f8f6f3\"},\"description\":\"Documentation for Webz.io\",\"seo\":{\"metaTitle\":\"\",\"metaDescription\":\"\",\"ogImage\":\"\",\"twitterHandle\":\"\",\"enableJsonLd\":true,\"enableBreadcrumbs\":true,\"enableSitemap\":true,\"customCanonicalBase\":\"\",\"noIndex\":false},\"name\":\"Webz.io\",\"faviconUrl\":\"https://storage.googleapis.com/lunar-dashboard-55a2c.firebasestorage.app/favicons/dRSUAaQdD5f8YULeNLxh/favicon.png\",\"logoUrl\":\"https://storage.googleapis.com/lunar-dashboard-55a2c.firebasestorage.app/logos/dRSUAaQdD5f8YULeNLxh/logo.png\",\"updatedAt\":\"2026-08-19T06:36:03.000Z\"},\"categories\":[{\"id\":\"BSNYUeAGptrkEFfksfHR\",\"environmentId\":\"dRSUAaQdD5f8YULeNLxh\",\"name\":\"Start Here\",\"slug\":\"start-here\",\"parentId\":null,\"status\":\"published\",\"createdAt\":\"2026-07-06T07:42:43.000Z\",\"order\":0,\"content\":\"Start here if you are new to [Webz.io](https://webz.io/) or need a plain-language orientation before choosing an API.\\n\\n- [About Webz.io](about-webz-io) explains what Webz.io provides, how machine-defined web data is delivered, and which product family to use for common jobs.\\n- [News, Blogs \u0026 Forums APIs](news-blogs-forums-overview) covers live open web content split by source type.\\n- [Reviews API](reviews-api-what-is) covers customer reviews and ratings.\\n- [Cyber API](cyber-api-what-is) covers deep and dark web content for threat intelligence.\\n- [Data Breaches API](data-breach-what-is) covers exposed credentials and breach records.\\n- [Archive](archive-what-is) covers historical datasets when live API windows are not enough.\",\"updatedAt\":\"2026-09-20T13:27:02.000Z\"},{\"id\":\"dwIdIKjVfzaaCUWyNDXP\",\"parentId\":\"WXFzdFSAfqEUABHfZI0I\",\"order\":0,\"status\":\"published\",\"environmentId\":\"dRSUAaQdD5f8YULeNLxh\",\"createdAt\":\"2026-06-01T07:07:37.000Z\",\"name\":\"Get Started\",\"slug\":\"archive-get-started\",\"content\":\"Start here. Learn what Archive is, what it covers, and get your first dataset in minutes.\\n\\n- [What Is Archive](archive-what-is) - the product, coverage, and how it compares to the live feed.\\n- [Use Cases](archive-use-cases) - what teams build with Archive.\\n- [Quickstart](archive-quickstart) - your first dataset with the Wizard or the API.\\n\",\"updatedAt\":\"2026-06-01T07:51:02.000Z\"},{\"id\":\"uykaHbuFnlNKdilOig7v\",\"parentId\":\"X6kS65HaSCs3dWoz7P46\",\"slug\":\"web-content-get-started\",\"environmentId\":\"dRSUAaQdD5f8YULeNLxh\",\"name\":\"Get Started\",\"status\":\"published\",\"order\":0,\"createdAt\":\"2026-06-01T09:37:54.000Z\",\"updatedAt\":\"2026-06-01T09:38:29.000Z\"},{\"id\":\"6s0OJgQWEgfyNgH4kjiU\",\"environmentId\":\"dRSUAaQdD5f8YULeNLxh\",\"slug\":\"news-blogs-forums\",\"parentId\":null,\"status\":\"published\",\"createdAt\":\"2026-07-05T13:57:25.000Z\",\"name\":\"News, Blogs, Forums \u0026 Reviews APIs\",\"order\":1,\"content\":\"$1c\",\"updatedAt\":\"2026-10-17T18:13:10.000Z\"},{\"id\":\"lk3R5oD5SmJSpfFRhoOQ\",\"environmentId\":\"dRSUAaQdD5f8YULeNLxh\",\"name\":\"News API\",\"slug\":\"news\",\"order\":1,\"parentId\":\"6s0OJgQWEgfyNgH4kjiU\",\"status\":\"published\",\"createdAt\":\"2026-07-28T06:21:05.000Z\",\"content\":\"Articles from news sites worldwide, with news-only enrichments like sentiment, named entities, and social metrics.\\n\\n- [Introduction](news-api) - what the News API offers.\\n- [Quickstart](news-api-quickstart) - your first request in minutes.\\n- [Filters](news-api-filters) - narrow by source, language, and more.\\n- [Post Data Fields](news-api-post-fields) - every field in a news post.\\n- [News MCP](news-api-mcp) - the News API as an MCP server, for Cursor, Claude, ChatGPT and n8n.\\n- [News Segmentation MCP](news-api-segmentation-mcp) - same for the segmentation endpoint: counts instead of articles.\\n\",\"updatedAt\":\"2026-10-17T18:13:07.000Z\"},{\"id\":\"qFtnTu6FFXb4ShF3g2p7\",\"slug\":\"web-content-build\",\"name\":\"Build a Query\",\"order\":1,\"status\":\"published\",\"parentId\":\"X6kS65HaSCs3dWoz7P46\",\"environmentId\":\"dRSUAaQdD5f8YULeNLxh\",\"createdAt\":\"2026-06-01T09:37:59.000Z\",\"updatedAt\":\"2026-06-01T09:38:33.000Z\"},{\"id\":\"qfvaCfHoMU4XxqH8BINk\",\"order\":1,\"slug\":\"archive-build\",\"parentId\":\"WXFzdFSAfqEUABHfZI0I\",\"status\":\"published\",\"content\":\"Everything you need to build a dataset: the Archive Wizard, the query language, and how credits are priced.\\n\\n- [Using the Archive Wizard](archive-wizard) - the no-code, 3-step console flow.\\n- [Building Queries](archive-query-filters) - the query language and filters.\\n- [Pricing \u0026 Credits](archive-pricing-credits) - how credits work and what an order costs.\\n\",\"name\":\"Build a Dataset\",\"environmentId\":\"dRSUAaQdD5f8YULeNLxh\",\"createdAt\":\"2026-06-01T07:22:57.000Z\",\"updatedAt\":\"2026-06-01T07:22:57.000Z\"},{\"id\":\"uiR2B0DNOTNklouevErP\",\"environmentId\":\"dRSUAaQdD5f8YULeNLxh\",\"name\":\"Legacy Firehose\",\"slug\":\"legacy-firehose\",\"order\":1,\"parentId\":\"xwBpDvyKFsE19yfBRloj\",\"content\":\"\",\"status\":\"published\",\"createdAt\":\"2026-08-06T14:46:15.000Z\",\"updatedAt\":\"2026-08-06T14:46:15.000Z\"},{\"id\":\"41yRCGM2qQ6csUmY8sni\",\"environmentId\":\"dRSUAaQdD5f8YULeNLxh\",\"name\":\"News Search API\",\"slug\":\"news-search\",\"status\":\"published\",\"createdAt\":\"2026-08-06T15:46:12.000Z\",\"parentId\":null,\"content\":\"Search global news with a natural-language query. News Search API returns matching articles, the most relevant text chunks, and metadata to help you review results.\\n\\n## Get started\\n\\n- [Introduction](news-search-api)\\n- [Quickstart](news-search-api-quickstart)\\n- [Filters](news-search-api-filters)\\n- [Response Format](news-search-api-response-format)\\n\\n\u003e [!NOTE]\\n\u003e News Search uses the same Webz API token and `api_news` permission as the News API.\\n\",\"updatedAt\":\"2026-08-09T08:38:41.000Z\",\"order\":2},{\"id\":\"7RfDVkDmtDgaYcfJqosj\",\"status\":\"published\",\"parentId\":\"WXFzdFSAfqEUABHfZI0I\",\"environmentId\":\"dRSUAaQdD5f8YULeNLxh\",\"createdAt\":\"2026-06-01T07:07:38.000Z\",\"name\":\"API Reference\",\"slug\":\"archive-api-reference\",\"order\":2,\"content\":\"Developer reference for Archive.\\n\\n- [Archive API](archive-api) - set the query, confirm, and download.\\n- [Output Format](archive-output-format) - how the dataset is packaged.\\n- [Data Fields](archive-data-fields) - the fields in each post.\\n- [Delivery](archive-delivery) - timing and download links.\\n- [Limits](archive-limits) - query minimum and field availability.\\n\\nYou need an API token, and credits on your account before ordering.\\n\",\"updatedAt\":\"2026-06-01T07:34:14.000Z\"},{\"id\":\"KRd47naNjmeE1yGeyO7m\",\"environmentId\":\"dRSUAaQdD5f8YULeNLxh\",\"name\":\"Blogs API\",\"slug\":\"blogs\",\"order\":2,\"parentId\":\"6s0OJgQWEgfyNgH4kjiU\",\"status\":\"published\",\"createdAt\":\"2026-07-28T06:21:05.000Z\",\"content\":\"Blog posts from across the open web.\\n\\n- [Introduction](blogs-api) - what the Blogs API offers.\\n- [Quickstart](blogs-api-quickstart) - your first request in minutes.\\n- [Filters](blogs-api-filters) - narrow by source, language, and more.\\n- [Post Data Fields](blogs-api-post-fields) - every field in a blog post.\\n- [Blogs MCP](blogs-api-mcp) - the Blogs API as an MCP server, for Cursor, Claude, ChatGPT and n8n.\\n- [Blogs Segmentation MCP](blogs-api-segmentation-mcp) - same for the segmentation endpoint: counts instead of posts.\\n\",\"updatedAt\":\"2026-10-17T18:13:08.000Z\"},{\"id\":\"Uy1QLlWwcM984L0MobQ9\",\"parentId\":\"X6kS65HaSCs3dWoz7P46\",\"status\":\"published\",\"environmentId\":\"dRSUAaQdD5f8YULeNLxh\",\"slug\":\"web-content-api-reference\",\"order\":2,\"name\":\"API Reference\",\"createdAt\":\"2026-06-01T09:38:06.000Z\",\"updatedAt\":\"2026-06-01T09:38:36.000Z\"},{\"id\":\"gbHvQI4ITwS1INJzVB5z\",\"environmentId\":\"dRSUAaQdD5f8YULeNLxh\",\"name\":\"Forums API\",\"slug\":\"forums\",\"order\":3,\"parentId\":\"6s0OJgQWEgfyNgH4kjiU\",\"status\":\"published\",\"createdAt\":\"2026-07-28T06:21:06.000Z\",\"content\":\"Forum posts and replies from discussion boards across the open web.\\n\\n- [Introduction](forums-api) - what the Forums API offers.\\n- [Quickstart](forums-api-quickstart) - your first request in minutes.\\n- [Filters](forums-api-filters) - narrow by source, language, and more.\\n- [Post Data Fields](forums-api-post-fields) - every field in a forum post.\\n- [Forums MCP](forums-api-mcp) - the Forums API as an MCP server, for Cursor, Claude, ChatGPT and n8n.\\n- [Forums Segmentation MCP](forums-api-segmentation-mcp) - same for the segmentation endpoint: counts instead of posts.\\n\",\"updatedAt\":\"2026-10-17T18:13:09.000Z\"},{\"id\":\"xwBpDvyKFsE19yfBRloj\",\"environmentId\":\"dRSUAaQdD5f8YULeNLxh\",\"name\":\"Firehose\",\"slug\":\"firehose\",\"parentId\":null,\"status\":\"published\",\"createdAt\":\"2026-08-06T14:46:13.000Z\",\"content\":\"Firehose delivers continuous Open Web data feeds for customers who need broad, timely coverage at scale.\\n\\n## Choose an integration\\n\\n### Curated Feed | FH API\\nUse the REST API for a preconfigured, continuously updated feed tailored to your use case. [Read the Curated Feed guide](fh-api-curated-feed).\\n\\n### Legacy Firehose\\nUse the legacy FTP delivery for XML data in ZIP files. [Read the Legacy Firehose overview](fh-legacy-overview).\\n\",\"updatedAt\":\"2026-08-06T15:52:42.000Z\",\"order\":3},{\"id\":\"5wnlWm0qo6zeLXcs3FUL\",\"environmentId\":\"dRSUAaQdD5f8YULeNLxh\",\"slug\":\"cyber-api-reference\",\"name\":\"API Reference\",\"parentId\":\"z8rUmVr9plgA4ztkGWw4\",\"status\":\"published\",\"createdAt\":\"2026-07-05T15:16:16.000Z\",\"order\":4,\"content\":\"Developer reference for the [Cyber API](https://webz.io/products/dark-web-api/).\\n\\n- [Query Syntax](cyber-api-query-syntax) - boolean operators and the fields free text searches.\\n- [Time Range](cyber-api-time-range) - the search window and the 2-year history cap.\\n- [Endpoints \u0026 Authentication](cyber-api-endpoints) - base URL, endpoints, tokens, and permissions.\\n- [Request Parameters](cyber-api-parameters) - every parameter with defaults.\\n- [Response Format](cyber-api-response-format) - the JSON envelope.\\n- [Pagination](cyber-api-pagination) - follow the next URL.\\n- [Segmentation API](cyber-api-segmentation) - aggregate counts instead of posts.\\n- [Dark Cache \u0026 Images](cyber-api-cache-images) - cached pages and collected images.\\n- [Errors, Rate Limits \u0026 Credits](cyber-api-errors-limits) - what can go wrong and what it costs.\",\"updatedAt\":\"2026-09-21T08:08:20.000Z\"},{\"id\":\"LJk7CTIm1xo87gSqpdpD\",\"environmentId\":\"dRSUAaQdD5f8YULeNLxh\",\"name\":\"API Reference\",\"parentId\":\"6s0OJgQWEgfyNgH4kjiU\",\"status\":\"published\",\"createdAt\":\"2026-07-05T13:57:39.000Z\",\"slug\":\"news-blogs-forums-api-reference\",\"content\":\"Shared developer reference for the News, Blogs \u0026 Forums APIs - one query language, endpoint family, and response format for all three products.\\n\\n- [Query Syntax](news-blogs-forums-query-syntax) - boolean operators, phrases, proximity, wildcards.\\n- [Time Range \u0026 History](news-blogs-forums-time-range) - the search window and credit costs.\\n- [Endpoints \u0026 Authentication](news-blogs-forums-endpoints) - base URL, endpoints, and tokens.\\n- [Request Parameters](news-blogs-forums-parameters) - every parameter with defaults.\\n- [Response Format](news-blogs-forums-response-format) - the JSON envelope.\\n- [Pagination](news-blogs-forums-pagination) - follow the next URL.\\n- [Segmentation API](news-blogs-forums-segmentation) - aggregate counts instead of posts.\\n- [Errors, Rate Limits \u0026 Credits](news-blogs-forums-errors-limits) - what can go wrong and what it costs.\",\"order\":4,\"updatedAt\":\"2026-07-28T06:21:07.000Z\"},{\"id\":\"V5dXXYzPeBWBFjIJipfd\",\"environmentId\":\"dRSUAaQdD5f8YULeNLxh\",\"slug\":\"reviews-api-reference\",\"name\":\"API Reference\",\"parentId\":\"KT3EjhljdVwhllcuimP4\",\"status\":\"published\",\"createdAt\":\"2026-07-05T15:15:54.000Z\",\"content\":\"Developer reference for the Reviews API.\\n\\n- [Query Syntax](reviews-api-query-syntax) - boolean operators, phrases, proximity, wildcards.\\n- [Time Range](reviews-api-time-range) - the search window and the 31-day publication cap.\\n- [Endpoints \u0026 Authentication](reviews-api-endpoints) - base URL, endpoints, and tokens.\\n- [Request Parameters](reviews-api-parameters) - every parameter with defaults.\\n- [Response Format](reviews-api-response-format) - the JSON envelope.\\n- [Pagination](reviews-api-pagination) - follow the next URL.\\n- [Segmentation API](reviews-api-segmentation) - aggregate counts instead of reviews.\\n- [Errors, Rate Limits \u0026 Credits](reviews-api-errors-limits) - what can go wrong and what it costs.\",\"order\":4,\"updatedAt\":\"2026-07-28T06:35:37.000Z\"},{\"id\":\"yMfGq0Fe4OvTdyIUzRqW\",\"environmentId\":\"dRSUAaQdD5f8YULeNLxh\",\"name\":\"API Reference\",\"slug\":\"news-search-api-reference\",\"order\":4,\"parentId\":\"41yRCGM2qQ6csUmY8sni\",\"content\":\"Technical reference for the News Search API.\\n\\n- [Endpoints \u0026 Authentication](news-search-api-endpoints)\\n- [Request Parameters](news-search-api-parameters)\\n- [Errors, Rate Limits \u0026 Credits](news-search-api-errors-limits)\\n\",\"status\":\"published\",\"createdAt\":\"2026-08-09T08:38:42.000Z\",\"updatedAt\":\"2026-08-09T08:38:42.000Z\"},{\"id\":\"z8rUmVr9plgA4ztkGWw4\",\"environmentId\":\"dRSUAaQdD5f8YULeNLxh\",\"slug\":\"cyber-api\",\"name\":\"Cyber API\",\"parentId\":null,\"status\":\"published\",\"createdAt\":\"2026-07-05T15:16:05.000Z\",\"order\":4,\"content\":\"The Cyber ([Dark Web](https://webz.io/products/dark-web-api/)) API turns deep and dark web content into structured JSON - posts from Tor sites, hacking forums, marketplaces, and chat platforms, enriched with entities and cyber risk scores.\\n\\n- [Introduction](cyber-api-what-is) - coverage, networks, and enrichment.\\n- [Quickstart](cyber-api-quickstart) - your first request in 4 steps.\\n- [Filters](cyber-api-filters) - narrow by site, network, entities, and risk.\\n- [Post Data Fields](cyber-api-data-fields) - every field in a cyber post.\\n\\nThe Cyber API requires its own permission on your account - contact sales@webz.io for access.\",\"updatedAt\":\"2026-09-21T08:07:13.000Z\"},{\"id\":\"3isOXMTAcyAahOEc4XlW\",\"environmentId\":\"dRSUAaQdD5f8YULeNLxh\",\"name\":\"API Reference\",\"slug\":\"nhi-reference\",\"order\":5,\"parentId\":\"enBrsKrIf0WIRSQZhd02\",\"content\":\"The complete API reference: the endpoint, every parameter, the response shape, and paging.\\n\\n- [Endpoint \u0026 Authentication](nhi-endpoints) - the endpoint and how to authenticate.\\n- [Request Parameters](nhi-parameters) - every query parameter and its rules.\\n- [Response Format](nhi-response-format) - root fields, paging, and `domainStatus`.\\n- [Pagination](nhi-pagination) - page through a result set.\\n- [Errors, Rate Limits \u0026 Credits](nhi-errors-limits) - status codes, limits, and access.\",\"status\":\"published\",\"createdAt\":\"2026-09-06T09:45:57.000Z\",\"description\":\"Non-Human Identities (NHI) API reference: endpoint, parameters, response, paging, errors.\",\"updatedAt\":\"2026-09-06T09:46:25.000Z\"},{\"id\":\"HyeKqPXFSBj5lPE8fcRz\",\"environmentId\":\"dRSUAaQdD5f8YULeNLxh\",\"name\":\"Data Breaches API\",\"slug\":\"data-breach-api\",\"status\":\"published\",\"parentId\":null,\"createdAt\":\"2026-07-05T15:34:16.000Z\",\"order\":5,\"content\":\"The [Data Breaches API](https://webz.io/products/data-breach-detection-api/) returns compromised credentials as structured JSON - emails, usernames, and passwords exposed in data breaches, combo lists, and infostealer logs, enriched with breach, device, and service context.\\n\\n- [Introduction](data-breach-what-is) - coverage, sources, and enrichment.\\n- [Quickstart](data-breach-quickstart) - your first request in 4 steps.\\n- [Search Scope](data-breach-scope) - the domain and email filters every query needs.\\n- [Filters](data-breach-filters) - narrow by data type, password, service, and breach.\\n- [Record Data Fields](data-breach-data-fields) - every field inside a record.\\n\\nThe Data Breaches API requires its own permission and authorized domains on your account - contact sales@webz.io for access.\",\"updatedAt\":\"2026-09-21T08:08:58.000Z\"},{\"id\":\"KT3EjhljdVwhllcuimP4\",\"environmentId\":\"dRSUAaQdD5f8YULeNLxh\",\"slug\":\"reviews-api\",\"name\":\"Reviews API\",\"status\":\"published\",\"createdAt\":\"2026-07-05T15:15:43.000Z\",\"parentId\":\"6s0OJgQWEgfyNgH4kjiU\",\"order\":5,\"content\":\"The Reviews API turns customer reviews from across the open web into structured JSON - every review with its rating, author, language, and the item being reviewed.\\n\\n- [Introduction](reviews-api-what-is) - the product and what counts as a review.\\n- [Quickstart](reviews-api-quickstart) - your first request in 4 steps.\\n- [Filters](reviews-api-filters) - narrow by rating, language, site, and item.\\n- [Review Data Fields](reviews-api-data-fields) - every field in a review.\\n\\n\u003e [!NOTE]\\n\u003e Reviews are their own product - the [News, Blogs \u0026 Forums APIs](news-blogs-forums-overview) exclude review content. Both share the same query language.\",\"updatedAt\":\"2026-07-28T06:35:36.000Z\"},{\"id\":\"aCKuX9FglTbUQ4CAejVy\",\"environmentId\":\"dRSUAaQdD5f8YULeNLxh\",\"name\":\"API Reference\",\"slug\":\"data-breach-reference\",\"status\":\"published\",\"parentId\":\"HyeKqPXFSBj5lPE8fcRz\",\"createdAt\":\"2026-07-05T15:34:27.000Z\",\"content\":\"The complete API reference: endpoints, every parameter, the response shape, and paging.\\n\\n- [Time Range](data-breach-time-range) - the default window and how to reach older data.\\n- [Endpoints \u0026 Authentication](data-breach-endpoints) - the two endpoints and how to authenticate.\\n- [Request Parameters](data-breach-parameters) - every query parameter and its rules.\\n- [Response Format](data-breach-response-format) - root fields and paging.\\n- [Pagination](data-breach-pagination) - page through a result set.\\n- [Breach Catalog](data-breach-catalog) - look up known breaches and their UUIDs.\\n- [Errors, Rate Limits \u0026 Credits](data-breach-errors-limits) - status codes, limits, and access.\",\"order\":5,\"updatedAt\":\"2026-07-28T06:51:33.000Z\"},{\"id\":\"hE1TD8jk1rPT4UAxstNu\",\"environmentId\":\"dRSUAaQdD5f8YULeNLxh\",\"name\":\"Framework SDKs\",\"slug\":\"news-search-api-framework-sdks\",\"order\":5,\"parentId\":\"41yRCGM2qQ6csUmY8sni\",\"status\":\"published\",\"createdAt\":\"2026-09-03T11:59:55.000Z\",\"content\":\"$1d\",\"updatedAt\":\"2026-10-17T18:13:06.000Z\"},{\"id\":\"jdDrOuW8QexRmYMalJBF\",\"environmentId\":\"dRSUAaQdD5f8YULeNLxh\",\"name\":\"API Reference\",\"slug\":\"leaked-cookies-reference\",\"order\":5,\"parentId\":\"XeQHrbdSi16OT7Io4fdr\",\"content\":\"The complete API reference: the endpoint, every parameter, the response shape, and paging.\\n\\n- [Endpoint \u0026 Authentication](leaked-cookies-endpoints) - the endpoint and how to authenticate.\\n- [Request Parameters](leaked-cookies-parameters) - every query parameter and its rules.\\n- [Response Format](leaked-cookies-response-format) - root fields, paging, and `domainStatus`.\\n- [Pagination](leaked-cookies-pagination) - page through a result set.\\n- [Errors, Rate Limits \u0026 Credits](leaked-cookies-errors-limits) - status codes, limits, and access.\",\"status\":\"published\",\"createdAt\":\"2026-09-06T09:45:49.000Z\",\"description\":\"Leaked Cookies API reference: endpoint, parameters, response, paging, errors.\",\"updatedAt\":\"2026-09-06T09:46:09.000Z\"},{\"id\":\"XeQHrbdSi16OT7Io4fdr\",\"environmentId\":\"dRSUAaQdD5f8YULeNLxh\",\"name\":\"Leaked Cookies API\",\"slug\":\"leaked-cookies-api\",\"order\":5.3,\"parentId\":null,\"content\":\"The Leaked Cookies API returns browser cookies stolen from employee devices by infostealer malware, matched to your domain and enriched with device and source context. A leaked session cookie lets an attacker skip the login page entirely - even with a strong password and MFA.\\n\\n- [Introduction](leaked-cookies-what-is) - coverage, sources, and enrichment.\\n- [Quickstart](leaked-cookies-quickstart) - your first request in 4 steps.\\n- [Filters](leaked-cookies-filters) - narrow by `cookie_type`, `browser`, `service_host`, `expiration_status`.\\n- [Record Data Fields](leaked-cookies-data-fields) - every field inside a record.\\n\\n\u003e [!NOTE]\\n\u003e The Leaked Cookies API requires its own permission and credits on your account - contact sales@webz.io for access.\",\"status\":\"published\",\"createdAt\":\"2026-09-06T09:45:49.000Z\",\"description\":\"Leaked Cookies API: browser cookies stolen from infected employee devices and matched to your domain.\",\"updatedAt\":\"2026-09-06T09:46:08.000Z\"},{\"id\":\"enBrsKrIf0WIRSQZhd02\",\"environmentId\":\"dRSUAaQdD5f8YULeNLxh\",\"name\":\"Non-Human Identities (NHI) API\",\"slug\":\"nhi-api\",\"order\":5.6,\"parentId\":null,\"content\":\"The Non-Human Identities (NHI) API returns API keys, OAuth tokens, private keys, and other machine credentials that leaked from your employees' devices through infostealer malware, matched to your domain and enriched with device and source context.\\n\\n- [Introduction](nhi-what-is) - coverage, sources, and enrichment.\\n- [Quickstart](nhi-quickstart) - your first request in 4 steps.\\n- [Filters](nhi-filters) - narrow by `token_type`, `service_type`, `verification_status`.\\n- [Record Data Fields](nhi-data-fields) - every field inside a record.\\n\\n\u003e [!NOTE]\\n\u003e The Non-Human Identities (NHI) API requires its own permission and credits on your account - contact sales@webz.io for access.\",\"status\":\"published\",\"createdAt\":\"2026-09-06T09:45:57.000Z\",\"description\":\"Non-Human Identities (NHI) API: API keys, tokens, and other machine credentials leaked from infected employee devices and matched to your domain.\",\"updatedAt\":\"2026-09-06T09:46:24.000Z\"},{\"id\":\"jAwfFZJPOa9iGo1mnk1L\",\"environmentId\":\"dRSUAaQdD5f8YULeNLxh\",\"name\":\"Domain Exposure API\",\"slug\":\"domain-exposure-api\",\"parentId\":null,\"createdAt\":\"2026-08-27T06:33:15.000Z\",\"order\":6,\"content\":\"The Lunar Domain Exposure API returns a structured security exposure report for any domain, based on compromised credentials found in data breaches, combo lists, and infostealer logs.\\n\\nIt is designed for domain-level risk assessment rather than retrieving individual compromised records.\\n\\n- **Introduction** — what the report measures and how exposure is classified.\\n- **Quickstart** — make your first request.\\n- **Response Fields** — understand the returned report.\\n- **API Reference** — endpoint and parameters.\",\"updatedAt\":\"2026-08-27T06:34:24.000Z\"},{\"id\":\"WXFzdFSAfqEUABHfZI0I\",\"parentId\":null,\"environmentId\":\"dRSUAaQdD5f8YULeNLxh\",\"status\":\"published\",\"slug\":\"archive\",\"createdAt\":\"2026-06-01T07:07:36.000Z\",\"name\":\"News, Blogs, Forums \u0026 Reviews Archive\",\"content\":\"Archive is Webz.io's historical web data service. Define a query, choose a date range, and get a ready-made dataset of past open web content.\\n\\nThere are two ways to use it:\\n\\n- **Archive Wizard** - a no-code flow in the console. Best for one-off datasets and exploring.\\n- **Archive API** - three endpoints to order datasets programmatically.\\n\\nNew to Archive? Read [What Is Archive](archive-what-is), then follow the [Quickstart](archive-quickstart).\\n\\n\u003e [!NOTE]\\n\u003e Live feeds cover the last 31 days. Archive covers the last 5 years of news, blogs, discussions, and reviews.\\n\\nNeed older data? [Data Dumps (since 2008)](archive-data-dumps) reach further back - news to 2008, blogs and discussions to December 2014.\\n\",\"updatedAt\":\"2026-08-06T15:52:42.000Z\",\"order\":7},{\"id\":\"X6kS65HaSCs3dWoz7P46\",\"slug\":\"web-content\",\"parentId\":null,\"environmentId\":\"dRSUAaQdD5f8YULeNLxh\",\"status\":\"published\",\"createdAt\":\"2026-06-01T09:37:53.000Z\",\"name\":\"Web Content API (Deprecated)\",\"content\":\"$1e\",\"updatedAt\":\"2026-08-06T15:52:41.000Z\",\"order\":8},{\"id\":\"gu1OCHNpPCz94uVYLE0C\",\"environmentId\":\"dRSUAaQdD5f8YULeNLxh\",\"name\":\"Fact Check API\",\"slug\":\"fact-check-api\",\"order\":24,\"createdAt\":\"2026-08-19T14:11:27.000Z\",\"parentId\":\"lk3R5oD5SmJSpfFRhoOQ\",\"updatedAt\":\"2026-08-19T14:40:33.000Z\"}],\"pages\":[{\"id\":\"13m5rcUPi4a4Iuf8zieS\",\"environmentId\":\"dRSUAaQdD5f8YULeNLxh\",\"parentPageId\":null,\"title\":\"What Are the News, Blogs \u0026 Forums APIs\",\"status\":\"published\",\"order\":0,\"createdAt\":\"2026-07-05T13:57:27.000Z\",\"slug\":\"news-blogs-forums-overview\",\"categoryId\":\"6s0OJgQWEgfyNgH4kjiU\",\"version\":11,\"updatedAt\":\"2026-09-21T08:04:02.000Z\"},{\"id\":\"2OtXTVBnDvC0ENIFSjvy\",\"environmentId\":\"dRSUAaQdD5f8YULeNLxh\",\"categoryId\":\"enBrsKrIf0WIRSQZhd02\",\"parentPageId\":null,\"title\":\"Introduction\",\"slug\":\"nhi-what-is\",\"status\":\"published\",\"version\":1,\"order\":0,\"createdAt\":\"2026-09-06T09:45:58.000Z\",\"updatedAt\":\"2026-09-06T09:46:26.000Z\"},{\"id\":\"7PvvsRR8CqVsBYRYuuZ5\",\"environmentId\":\"dRSUAaQdD5f8YULeNLxh\",\"categoryId\":\"BSNYUeAGptrkEFfksfHR\",\"title\":\"About Webz.io\",\"slug\":\"about-webz-io\",\"status\":\"published\",\"order\":0,\"createdAt\":\"2026-07-06T07:42:45.000Z\",\"version\":12,\"updatedAt\":\"2026-09-21T08:06:23.000Z\"},{\"id\":\"CI8oZYRVK75gZ3RKD9YC\",\"envir