5c2de2d4c3bfab35d2c75731be207348b-3840x790-png\",\"_type\":\"reference\"}},\"link\":null},{\"_key\":\"a26269273935\",\"alt\":\"IBM\",\"image\":{\"_type\":\"image\",\"asset\":{\"_ref\":\"image-1198f02ebfa2ea912b7fb62ba1502cf312a4f96b-95x35-svg\",\"_type\":\"reference\"}},\"link\":{\"internalLink\":{\"page\":{\"_type\":\"customer\",\"slug\":{\"_type\":\"slug\",\"current\":\"bell-cyber\"}}},\"linkType\":\"internal\"}},{\"_key\":\"9c30266bb412\",\"alt\":\"Ironclad\",\"image\":{\"_type\":\"image\",\"asset\":{\"_ref\":\"image-5d0f82653aecbc78852d0ff5d59a46e8c3c37fa6-186x35-svg\",\"_type\":\"reference\"}},\"link\":null},{\"_key\":\"d63a6fae379f\",\"alt\":\"Troutman Pepper Locke\",\"image\":{\"_type\":\"image\",\"asset\":{\"_ref\":\"image-12f2d53f068e3408c96b2cdb3cf36916a351fcef-1500x499-png\",\"_type\":\"reference\"}},\"link\":null},{\"_key\":\"af23bbeccc2a\",\"alt\":\"BMO\",\"image\":{\"_type\":\"image\",\"asset\":{\"_ref\":\"image-8bca732842bd4396f7991237d7d4ac09ecde1bba-207x72-svg\",\"_type\":\"reference\"}},\"link\":{\"internalLink\":{\"page\":{\"_type\":\"customer\",\"slug\":{\"_type\":\"slug\",\"current\":\"BMO-AML\"}}},\"linkType\":\"internal\"}},{\"_key\":\"49713dd64d41\",\"alt\":\"Extend\",\"image\":{\"_type\":\"image\",\"asset\":{\"_ref\":\"image-09cf2dc9be4ca8a21232a08ccdfc86b4dfa2f049-1500x653-png\",\"_type\":\"reference\"}},\"link\":null},{\"_key\":\"704697b9b93e\",\"alt\":\"Peerbound\",\"image\":{\"_type\":\"image\",\"asset\":{\"_ref\":\"image-f7f525b6a44e0765e42f1f12259daa83ab74bbf8-1024x192-png\",\"_type\":\"reference\"}},\"link\":{\"internalLink\":{\"page\":{\"_type\":\"customer\",\"slug\":{\"_type\":\"slug\",\"current\":\"peerbound\"}}},\"linkType\":\"internal\"}}]},{\"_key\":\"0c97e894c589\",\"_type\":\"module.users\",\"eyebrow\":\"/the web access layer for agents\",\"heading\":\"Loved by developers, built for enterprises\",\"userTypes\":[{\"description\":\"Retrieve live web data, extract relevant content, and return it structured and chunked for models, so agents reason over facts without hallucinating.\",\"featurePreview\":\"fresh-web-context\",\"title\":\"Ground models with fresh web context\"},{\"description\":\"A production-grade retrieval stack with real-time search, intelligent caching, and indexing keeps latency predictable as traffic grows.\",\"featurePreview\":\"query-throughput\",\"title\":\"Handle thousands of web queries in seconds\"},{\"description\":\"Requests pass through security, privacy, and content validation layers that block PII leakage, prompt injection, and malicious sources.\",\"featurePreview\":\"built-in-safeguards\",\"title\":\"Ship to production with built-in safeguards\"}]},{\"_key\":\"942d71d808dc\",\"_type\":\"module.securitySection\",\"badges\":[{\"_key\":\"b70b7e4a275e\",\"dimensions\":{\"height\":58,\"width\":58},\"label\":\"SOC 2\",\"url\":\"https://cdn.sanity.io/images/5tlb0lxv/production/36b511f0b167d31a3d615f08f6b846e57d6c8035-58x58.svg\"},{\"_key\":\"489683e2a067\",\"dimensions\":{\"height\":56,\"width\":38},\"label\":\"ZDR\",\"url\":\"https://cdn.sanity.io/images/5tlb0lxv/production/095ba4bd0869ff34be7ebc664e1311f20472cc60-38x56.svg\"},{\"_key\":\"cc5cedf9787f\",\"dimensions\":{\"height\":62,\"width\":65},\"label\":\"GDPR\",\"url\":\"https://cdn.sanity.io/images/5tlb0lxv/production/643869df56ef620be654292e8932ea895d978a66-65x62.svg\"},{\"_key\":\"1aafb6248d8a\",\"dimensions\":{\"height\":53,\"width\":41},\"label\":\"ISO 27001\",\"url\":\"https://cdn.sanity.io/images/5tlb0lxv/production/81d4ad571d6427f9fc54cbb2142f969e11c4c9d2-41x53.svg\"}],\"badgesSide\":null,\"eyebrow\":\"/security\",\"subtitle\":null,\"title\":\"Enterprise-grade security, built in.\"},{\"_key\":\"d8152f331c67\",\"_type\":\"module.customerHighlight\",\"ctaButton\":{\"externalLink\":{\"newWindow\":true,\"url\":\"/customer-stories\"},\"internalLink\":null,\"linkType\":\"external\",\"modalContent\":null,\"showModal\":false,\"text\":\"View all stories\"},\"description\":null,\"eyebrow\":\"/customers\",\"heading\":\"Teams ship on Tavily\",\"kpi\":{\"customer\":{\"href\":\"/customer-stories/peerbound\",\"kpis\":[{\"_key\":\"pb1\",\"label\":\"description accuracy, up from 20%\",\"value\":\"100%\"},{\"_key\":\"pb2\",\"label\":\"to integrate Tavily end to end\",\"value\":\"5 minutes\"},{\"_key\":\"pb3\",\"label\":\"company records enriched\",\"value\":\"100,000s\"}],\"logo\":{\"_type\":\"image\",\"alt\":\"Peerbound\",\"asset\":{\"_ref\":\"image-f7f525b6a44e0765e42f1f12259daa83ab74bbf8-1024x192-png\",\"_type\":\"reference\"}},\"logoAlt\":\"Peerbound\",\"name\":\"Peerbound\",\"previewVideoUrl\":null,\"quote\":\"The results were concise, not information overload — but also all relevant. The information was prioritized, concise, and better than a top-level Google search. I was able to get exactly what I wanted.\",\"quoteAuthor\":{\"company\":\"Peerbound\",\"fullName\":\"Sunny Manivannan\",\"headshot\":{\"_type\":\"image\",\"asset\":{\"_ref\":\"image-116663ca6bfb2337193cdb8454c4c37dd2af8e0b-200x200-jpg\",\"_type\":\"reference\"}},\"role\":\"Founder \u0026 CEO\"},\"storyTitle\":\"Peerbound's 5x Data Accuracy Leap with Tavily's AI Search API\",\"videoThumbnail\":null,\"videoUrl\":null},\"kpiKey\":\"pb1\"},\"quote\":{\"href\":\"/customer-stories/jetbrains\",\"kpis\":[{\"_key\":\"jb1\",\"label\":\"saved per avoided wrong-API debug cycle\",\"value\":\"10–20 min\"},{\"_key\":\"jb2\",\"label\":\"cited — every suggestion traceable to live docs\",\"value\":\"100%\"},{\"_key\":\"jb3\",\"label\":\"hallucinated APIs on recent and niche libraries\",\"value\":\"Zero\"}],\"logo\":{\"_type\":\"image\",\"alt\":\"Jet Brains\",\"asset\":{\"_ref\":\"image-60c8291d2fb74a43f2565d450b86c7a368898c56-164x35-svg\",\"_type\":\"reference\"}},\"logoAlt\":\"Jet Brains\",\"name\":\"JetBrains\",\"previewVideoUrl\":null,\"quote\":\"Before web search, the model would hallucinate library methods it didn't know. I ran into this myself building a Telegram integration; it was confidently wrong. Grounding it with real-time web search fixed that immediately.\",\"quoteAuthor\":{\"company\":\"JetBrains\",\"fullName\":\"Nick Frolov\",\"headshot\":{\"_type\":\"image\",\"asset\":{\"_ref\":\"image-7c5e5155321fcd0f5e1e24e1d198d5212bd4e43a-538x538-jpg\",\"_type\":\"reference\"}},\"role\":\"Head of Product\"},\"storyTitle\":\"How JetBrains Coding Agent, Junie, Keeps Developers in Flow\",\"videoThumbnail\":null,\"videoUrl\":null},\"spacing\":{\"_type\":\"moduleSpacing\",\"removeBottomSpacing\":false,\"removeTopSpacing\":false},\"video\":{\"href\":\"/customer-stories/rox\",\"kpis\":[{\"_key\":\"rox1\",\"label\":\"to migrate the entire production workload to Tavily\",\"value\":\"2 weeks\"},{\"_key\":\"rox2\",\"label\":\"requests a day, answered in milliseconds\",\"value\":\"Millions\"},{\"_key\":\"rox3\",\"label\":\"won on freshness, accuracy and price\",\"value\":\"All three\"}],\"logo\":{\"_type\":\"image\",\"alt\":\"Rox\",\"asset\":{\"_ref\":\"image-fe7603bb2c1a2f3b9fd40b93648600d8f3c61d7e-55x20-svg\",\"_type\":\"reference\"}},\"logoAlt\":\"Rox\",\"name\":\"Rox\",\"previewVideoUrl\":\"https://cdn.sanity.io/files/5tlb0lxv/production/89d4617d50702c92e446486cf01a80a5202c9f59.webm\",\"quote\":\"If you want your agents to have fast, cost effective and accurate web research at scale, go with Tavily.\",\"quoteAuthor\":{\"company\":\"Rox\",\"fullName\":\"Shriram Sridharan\",\"headshot\":{\"_type\":\"image\",\"asset\":{\"_ref\":\"image-9a21a0213635247a8ed28eac04e0b3869c8e7af2-800x800-png\",\"_type\":\"reference\"}},\"role\":\"Co-founder \u0026 CTO\"},\"storyTitle\":\"How Rox Cut Account Research from a Week to Seconds with Tavily\",\"videoThumbnail\":{\"_type\":\"image\",\"asset\":{\"_ref\":\"image-1ae1f01cc13add0362125721f25b9a18c380893d-1920x1080-jpg\",\"_type\":\"reference\"}},\"videoUrl\":\"https://cdn.sanity.io/files/5tlb0lxv/production/7a063cc38144357352173a3fbb6e8d7376fdca67.webm\"}},{\"_key\":\"db03707242e9\",\"_type\":\"module.statsGrid\",\"eyebrow\":\"/proof is in the numbers\",\"heading\"