<div id="search-results" class="relative bg-gray-50 pt-16 sm:pt-24">
  <div class="mx-auto max-w-md px-4 text-center sm:px-6 sm:max-w-3xl lg:px-8 lg:max-w-7xl">
    <div>
      <h2 class="text-base font-semibold tracking-wider text-primary-600 uppercase">Extensive search results</h2>
      <p class="mt-2 text-3xl font-extrabold text-gray-900 tracking-tight sm:text-4xl">Get JSON results in seconds</p>
    </div>

      <div class="mt-8">
        <div
  id="live-preview"
   data-controller="live-preview"
  class="flex flex-col gap-6">
  <form class="w-full mx-auto max-w-lg lg:col-span-5" data-action="submit-&gt;live-preview#submit" action="/playground/live_preview" accept-charset="UTF-8" method="post"><input type="hidden" name="authenticity_token" value="rrrX4sNJJrJsX9gQNaPIUcGhdf48Eq-zh_WSmzDj5J8H_chbHoTSrb4hJPcXUicv9L1E-uatDXNVfDss5iJn7A" />
    <div class="flex gap-x-4">
      <input value="google" type="hidden" name="engine" id="engine" />
      <label class="sr-only" for="q">Search query</label>
      <input class="min-w-0 flex-auto rounded-md border-0 px-3.5 py-2 text-gray-900 shadow-xs ring-1 ring-inset ring-gray-300 placeholder:text-gray-400 focus:ring-2 focus:ring-inset focus:ring-primary-600 sm:text-sm sm:leading-6" required="required" placeholder="Search query" type="text" name="q" id="q" />
      <button
        data-live-preview-target="submitButton"
        type="submit"
        class="flex-none rounded-md bg-primary-600 px-3.5 py-2.5 text-sm font-semibold text-white shadow-xs hover:bg-primary-500 disabled:bg-primary-300 disabled:pointer-events-none focus-visible:outline-solid focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary-600">
          Test Search
      </button>
    </div>
    <div class="mt-3 flex justify-center">
      <div id="recaptcha">
        <script src="https://www.recaptcha.net/recaptcha/api.js?onload=executeRecaptchaForLivePreviewSubmit&render=6LfExlsoAAAAAEpM_WJd25DtaRb9x_El48aHFKY1"   ></script>
        <script>
          function executeRecaptchaForLivePreviewSubmit() {
            grecaptcha.ready(function() {
              grecaptcha.execute('6LfExlsoAAAAAEpM_WJd25DtaRb9x_El48aHFKY1', {action: 'live_preview_submit'}).then(function(token) {
                setInputWithRecaptchaResponseTokenForLivePreviewSubmit('g-recaptcha-response-data-live-preview-submit', token)
              });
            });
          };
                  var setInputWithRecaptchaResponseTokenForLivePreviewSubmit = function(id, token) {
          var element = document.getElementById(id);
          if (element !== null) element.value = token;
        }

        </script>
<input type="hidden" name="g-recaptcha-response-data[live_preview_submit]" id="g-recaptcha-response-data-live-preview-submit" data-sitekey="6LfExlsoAAAAAEpM_WJd25DtaRb9x_El48aHFKY1" class="g-recaptcha g-recaptcha-response "/>

      </div>
    </div>
</form>
  <div class="relative">
    <div
      data-live-preview-target="loader"
