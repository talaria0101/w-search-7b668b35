      <div class="card" style="padding: 2rem; background: var(--text-dark); color: white;">
        <h3 style="color: white; margin-bottom: 1rem;">Python Example</h3>
        <pre style="background: transparent; color: #a5d6ff; font-size: 0.875rem; overflow-x: auto; margin: 0;"><code>import requests

API_KEY = "your-api-key"
URL = "https://api.currentsapi.services/v1/latest-news"

response = requests.get(
    URL,
    headers={"Authorization": API_KEY},
    params={"language": "en", "country": "US"}
)

data = response.json()
for article in data["news"]:
    print(article["title"])</code></pre>
      </div>

      <div class="card" style="padding: 2rem; background: var(--text-dark); color: white;">
        <h3 style="color: white; margin-bottom: 1rem;">JavaScript Example</h3>
        <pre style="background: transparent; color: #a5d6ff; font-size: 0.875rem; overflow-x: auto; margin: 0;"><code>const API_KEY = 'your-api-key';
const URL = 'https://api.currentsapi.services/v1/search';

fetch(`${URL}?keywords=technology&language=en`, {
  headers: { 'Authorization': API_KEY }
})
  .then(res => res.json())
  .then(data => {
    data.news.forEach(article => {
      console.log(article.title);
    });
  });</code></pre>
