    <script data-cfasync="false" src="/cdn-cgi/scripts/5c5dd728/cloudflare-static/email-decode.min.js"></script><script>
      (function() {
        const storageKey = 'currents_theme';
        const root = document.documentElement;
        const isComfort = () => root.getAttribute('data-theme') === 'comfort';

        function applyTheme(theme) {
          const mode = theme === 'classic' ? 'classic' : 'comfort';
          if (mode === 'classic') {
            root.removeAttribute('data-theme');
          } else {
            root.setAttribute('data-theme', 'comfort');
          }

          const comfortEnabled = isComfort();
          const label = comfortEnabled ? 'Comfort on' : 'Comfort off';
          document.querySelectorAll('[data-theme-toggle]').forEach((btn) => {
            btn.setAttribute('aria-pressed', comfortEnabled ? 'true' : 'false');
          });
          document.querySelectorAll('[data-theme-toggle-label]').forEach((textNode) => {
            textNode.textContent = label;
          });
        }

        function initTheme() {
          try {
            const storedTheme = localStorage.getItem(storageKey);
            applyTheme(storedTheme || 'comfort');
          } catch (e) {
            applyTheme('comfort');
          }
        }

        function handleThemeToggle(event) {
          const toggleButton = event.target.closest('[data-theme-toggle]');
          if (!toggleButton) return;

          const nextTheme = isComfort() ? 'classic' : 'comfort';
          applyTheme(nextTheme);
          try {
            localStorage.setItem(storageKey, nextTheme);
          } catch (e) {
            // Ignore storage write failures and keep in-memory theme state.
          }
        }

        initTheme();
        document.addEventListener('click', handleThemeToggle);
      })();
    </script>

    
    <script src="/en/js/webmcp-tools.js"></script>
