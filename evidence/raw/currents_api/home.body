      visibility: visible;
    }
    
    /* Ensure there's a small bridge so the menu doesn't close when moving mouse down */
    .nav-dropdown::before {
      content: '';
      position: absolute;
      top: -10px;
      left: 0;
      width: 100%;
      height: 10px;
    }
  }

  /* Chevron animation */
  .dropdown-trigger svg {
    transition: transform 0.2s ease;
  }
  .nav-dropdown-wrapper:hover .dropdown-trigger svg {
