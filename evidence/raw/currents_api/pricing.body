  }

  #pricing-section .badge-green {
    background: rgba(37, 99, 235, 0.12);
    color: var(--primary-blue-dark);
    border-color: rgba(37, 99, 235, 0.2);
  }

  #pricing-section .badge-blue {
    background: var(--primary-blue);
