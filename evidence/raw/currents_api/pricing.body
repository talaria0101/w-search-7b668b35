  }

  #pricing-section .price-card.feature-card .badge-blue {
    background: rgba(255, 255, 255, 0.15);
    border-color: rgba(147, 197, 253, 0.5);
  }

  #pricing-section .price-card.feature-card .price-text,
  #pricing-section .price-card.feature-card .price-period,
  #pricing-section .price-card.feature-card .feature-text {
    color: rgba(255, 255, 255, 0.9);
  }

  #pricing-section .price-card.feature-card .price-text {
    color: white;
  }

  #pricing-section .price-card.feature-card .price-line {
    background: rgba(147, 197, 253, 0.45);
  }

  #pricing-section .price-card.feature-card .feature-wrap svg {
    color: white;
  }

  #pricing-section .price-card.feature-card .btn-primary {
    background: white;
    color: var(--primary-blue-dark);
  }

  #pricing-section .price-card.feature-card .btn-primary:hover {
    background: #f8fafc;
    color: var(--primary-blue-dark);
  }

  #pricing-section .price-card.feature-card .btn-secondary {
    background: rgba(255, 255, 255, 0.12);
    color: white;
    border-color: rgba(147, 197, 253, 0.6);
  }

  @media (max-width: 768px) {
    #pricing-section .price-grid {
      grid-template-columns: 1fr;
    }

    #pricing-section .pricing-tab-menu {
      width: 100%;
