<style>
  /* Desktop Hover Logic */
  @media (min-width: 769px) {
    .nav-dropdown-wrapper:hover .nav-dropdown {
      display: block !important;
      opacity: 1;
      visibility: visible;
    }
    
    /* Ensure there's a small bridge so the menu doesn't close when moving mouse down */
    .nav-dropdown::before {
      content: '';
      position: absolute;
      top: -10px;
      left: 0;
      width: 100%;
      height: 10px;
    }
  }

  /* Chevron animation */
  .dropdown-trigger svg {
    transition: transform 0.2s ease;
  }
  .nav-dropdown-wrapper:hover .dropdown-trigger svg {
    transform: rotate(180deg);
  }
</style>

