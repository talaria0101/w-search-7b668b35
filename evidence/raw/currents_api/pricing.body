      <!-- Mobile Menu Toggle -->
      <button class="nav-mobile-toggle" id="navMobileToggle" aria-label="Toggle navigation">
        <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <path d="M3 12h18M3 6h18M3 18h18"/>
        </svg>
