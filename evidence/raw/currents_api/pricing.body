    <script data-cfasync="false" src="/cdn-cgi/scripts/5c5dd728/cloudflare-static/email-decode.min.js"></script><script>
      (function() {
        const storageKey = 'currents_theme';
        const root = document.documentElement;
        const isComfort = () => root.getAttribute('data-theme') === 'comfort';

        function applyTheme(theme) {
          const mode = theme === 'classic' ? 'classic' : 'comfort';
          if (mode === 'classic') {
            root.removeAttribute('data-theme');
          } else {
            root.setAttribute('data-theme', 'comfort');
          }

          const comfortEnabled = isComfort();
          const label = comfortEnabled ? 'Comfort on' : 'Comfort off';
          document.querySelectorAll('[data-theme-toggle]').forEach((btn) => {
            btn.setAttribute('aria-pressed', comfortEnabled ? 'true' : 'false');
          });
          document.querySelectorAll('[data-theme-toggle-label]').forEach((textNode) => {
            textNode.textContent = label;
          });
        }

        function initTheme() {
          try {
            const storedTheme = localStorage.getItem(storageKey);
            applyTheme(storedTheme || 'comfort');
          } catch (e) {
            applyTheme('comfort');
          }
        }

        function handleThemeToggle(event) {
          const toggleButton = event.target.closest('[data-theme-toggle]');
          if (!toggleButton) return;

          const nextTheme = isComfort() ? 'classic' : 'comfort';
          applyTheme(nextTheme);
          try {
            localStorage.setItem(storageKey, nextTheme);
          } catch (e) {
            // Ignore storage write failures and keep in-memory theme state.
          }
        }

        initTheme();
        document.addEventListener('click', handleThemeToggle);
      })();
    </script>

    
<script>
  document.addEventListener('DOMContentLoaded', function() {
    const tabs = Array.from(document.querySelectorAll('[data-pricing-tab]'));
    const panels = Array.from(document.querySelectorAll('[data-pricing-panel]'));

    if (tabs.length && panels.length) {
      const activate = function(tabName) {
        tabs.forEach((tab) => {
          const isActive = tab.dataset.pricingTab === tabName;
          tab.classList.toggle('is-active', isActive);
          tab.setAttribute('aria-selected', isActive ? 'true' : 'false');
        });

        panels.forEach((panel) => {
          const isActive = panel.dataset.pricingPanel === tabName;
          panel.classList.toggle('is-active', isActive);
          panel.hidden = !isActive;
        });
      };

      tabs.forEach((tab) => {
        tab.addEventListener('click', function() {
          activate(tab.dataset.pricingTab);
        });
      });
    }

    const modal = document.getElementById('cancel-subscription-modal');
    const cancelForms = Array.from(document.querySelectorAll('[data-cancel-subscription]'));
    if (!modal || !cancelForms.length) {
      return;
    }

    const overlay = modal.querySelector('[data-modal-overlay]');
    const cancelButton = modal.querySelector('[data-modal-cancel]');
    const confirmButton = modal.querySelector('[data-modal-confirm]');
    let activeForm = null;
    let lastActive = null;

    const openModal = (form) => {
      activeForm = form;
      lastActive = document.activeElement;
      modal.classList.add('is-open');
      modal.setAttribute('aria-hidden', 'false');
      document.body.classList.add('cancel-modal-open');
      if (confirmButton) {
        confirmButton.focus();
      }
    };

    const closeModal = () => {
      modal.classList.remove('is-open');
      modal.setAttribute('aria-hidden', 'true');
      document.body.classList.remove('cancel-modal-open');
      if (lastActive && typeof lastActive.focus === 'function') {
        lastActive.focus();
      }
      activeForm = null;
    };

    cancelForms.forEach((form) => {
      form.addEventListener('submit', (event) => {
        event.preventDefault();
        openModal(form);
      });
    });

    if (overlay) {
      overlay.addEventListener('click', closeModal);
    }

    if (cancelButton) {
      cancelButton.addEventListener('click', closeModal);
    }

    if (confirmButton) {
      confirmButton.addEventListener('click', () => {
        if (activeForm) {
          activeForm.submit();
        }
      });
    }

    document.addEventListener('keydown', (event) => {
      if (event.key === 'Escape' && modal.classList.contains('is-open')) {
        event.preventDefault();
        closeModal();
      }
    });
  });
</script>

