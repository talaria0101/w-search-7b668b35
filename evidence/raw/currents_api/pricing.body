  }

  #pricing-section .grid-pricing-feature {
    display: grid;
    gap: 0.85rem;
    margin-bottom: 2rem;
  }

  #pricing-section .feature-wrap {
    display: flex;
    align-items: center;
    gap: 0.75rem;
  }

  #pricing-section .feature-wrap svg {
    width: 20px;
    height: 20px;
    color: var(--primary-blue);
    flex-shrink: 0;
  }

  #pricing-section .feature-text {
    color: var(--text-gray);
    font-size: 0.95rem;
  }

  #pricing-section .price-card .btn {
    width: 100%;
    justify-content: center;
