    }

    #pricing-section .discount-badge {
      position: static;
      margin-left: 0.4rem;
    }

    #pricing-section .price-card {
      padding: 2rem;
    }
  }

  @media (max-width: 640px) {
    #pricing-section .price-text {
      font-size: 3rem;
    }
  }
</style>

