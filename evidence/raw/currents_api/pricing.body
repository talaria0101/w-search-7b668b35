    <!-- Preload Critical Resources -->
    <link rel="preload" href="/img/Cover-Image.jpg?q=1772090198" as="image">

    <!-- Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Source+Serif+4:opsz,wght@8..60,600;8..60,700&family=Source+Sans+3:wght@400;600&family=Spline+Sans+Mono:wght@400;500&display=swap" rel="stylesheet">

    <script>
      (function() {
        try {
          const storedTheme = localStorage.getItem('currents_theme');
          if (storedTheme === 'classic') {
            document.documentElement.removeAttribute('data-theme');
            return;
          }
          document.documentElement.setAttribute('data-theme', 'comfort');
        } catch (e) {
          document.documentElement.setAttribute('data-theme', 'comfort');
        }
      })();
    </script>

    <!-- Custom CSS -->
    <style>
      :root {
        /* Base palette */
        --primary-blue: #1162B9;
        --primary-blue-dark: #034393;
        --primary-blue-light: #B7D4F2;
        --bg-white: #FFFFFF;
        --bg-light: #F8FAFC;
        --bg-lighter: #F1F5F9;
        --surface-elevated: #FFFFFF;
        --surface-muted: #F7FAFC;
        --text-dark: #0F172A;
        --text-gray: #64748B;
        --text-light: #64748B;
        --border-color: #E2E8F0;
        --body-accent: rgba(17, 98, 185, 0.05);
        --shadow-sm: 0 1px 2px 0 rgba(0, 0, 0, 0.05);
        --shadow-md: 0 4px 6px -1px rgba(0, 0, 0, 0.1);
        --shadow-lg: 0 10px 15px -3px rgba(0, 0, 0, 0.1);
        --radius-sm: 8px;
        --radius-md: 12px;
        --radius-lg: 16px;
        /* Typography */
        --font-display: 'Source Serif 4', Georgia, 'Times New Roman', serif;
        --font-body: 'Source Sans 3', -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;
        --font-mono: 'Spline Sans Mono', ui-monospace, SFMono-Regular, Menlo, monospace;
        /* Accent and semantic */
        --accent: #D8953D;
        --accent-deep: #A0600B;
        --accent-tint: rgba(216, 149, 61, 0.14);
        --success: #33854A;
        --warning: #CD9130;
        --error: #B6322D;
      }

      html[data-theme="comfort"] {
        --primary-blue: #1162B9;
        --primary-blue-dark: #034393;
        --primary-blue-light: #B7D4F2;
        --bg-white: #FBF9F3;
        --bg-light: #F7F3EA;
        --bg-lighter: #EEE9DC;
        --surface-elevated: #FEFDFB;
        --surface-muted: #FAF8F4;
        --text-dark: #2C2822;
        --text-gray: #46423A;
        --text-light: #686359;
        --border-color: #E0D8C8;
        --body-accent: rgba(17, 98, 185, 0.07);
        --shadow-sm: 0 1px 2px 0 rgba(44, 40, 34, 0.06);
        --shadow-md: 0 8px 16px -8px rgba(44, 40, 34, 0.16);
        --shadow-lg: 0 18px 28px -16px rgba(44, 40, 34, 0.2);
      }

      * {
        margin: 0;
        padding: 0;
        box-sizing: border-box;
      }

      body {
        font-family: var(--font-body);
        background:
          radial-gradient(1200px 450px at 90% -10%, var(--body-accent), transparent 70%),
          linear-gradient(180deg, var(--bg-light) 0%, var(--bg-white) 28%, var(--bg-white) 100%);
        color: var(--text-dark);
        line-height: 1.65;
        font-size: 1.0625rem;
        -webkit-font-smoothing: antialiased;
        -moz-osx-font-smoothing: grayscale;
        min-height: 100vh;
      }

      main {
        width: 100%;
      }

      /* Typography */
      h1, h2, h3, h4, h5, h6 {
        color: var(--text-dark);
        font-weight: 600;
        line-height: 1.15;
      }

      h1, h2 {
        font-family: var(--font-display);
      }

      h1 { font-size: clamp(2.75rem, 4.5vw + 1rem, 4.25rem); line-height: 1.08; letter-spacing: -0.015em; }
      h2 { font-size: clamp(1.875rem, 2.5vw + 0.75rem, 2.625rem); letter-spacing: -0.01em; }
      h3 { font-size: 1.5rem; }
      h4 { font-size: 1.1875rem; }

      p {
        color: var(--text-gray);
        line-height: 1.65;
        margin-bottom: 1rem;
      }

      .lead-text {
        font-size: 1.25rem;
        margin-bottom: 2rem;
      }

      .section-lead {
        font-size: 1.25rem;
      }

      .cta-title {
        font-size: clamp(2.25rem, 3vw, 2.75rem);
        margin-bottom: 1.5rem;
      }

      .cta-lead {
        font-size: 1.25rem;
        color: var(--text-gray);
        margin-bottom: 2.5rem;
      }

      /* Links */
      a {
        color: var(--primary-blue);
        text-decoration: none;
        transition: color 0.2s ease;
      }

      a:hover {
        color: var(--primary-blue-dark);
      }

      /* Container */
      .container {
        max-width: 1360px;
        margin: 0 auto;
        padding: 0 1.5rem;
      }

      .container-fluid {
        width: 100%;
        padding: 0 1.5rem;
      }

      /* Buttons */
      .btn {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        padding: 0.75rem 1.5rem;
        font-size: 0.9375rem;
        font-weight: 500;
        border-radius: var(--radius-sm);
        border: none;
        cursor: pointer;
        transition: all 0.2s ease;
        text-decoration: none;
      }

      .btn-primary {
        background: var(--primary-blue);
        color: white;
      }

      .btn-primary:hover {
        background: var(--primary-blue-dark);
        transform: translateY(-1px);
        box-shadow: var(--shadow-md);
      }

      .btn-outline {
        background: transparent;
        color: var(--primary-blue);
        border: 2px solid var(--primary-blue);
      }

      .btn-outline:hover {
        background: var(--primary-blue);
        color: white;
      }

      .btn-secondary {
        background: var(--surface-elevated);
        color: var(--text-dark);
        border: 2px solid var(--border-color);
      }

      .btn-secondary:hover {
        background: var(--bg-lighter);
        border-color: var(--text-gray);
      }

      .btn-lg {
        padding: 1rem 2rem;
        font-size: 1.125rem;
        border-radius: var(--radius-md);
      }

      .btn-block {
        width: 100%;
      }

      .cta-buttons {
        display: flex;
        gap: 1rem;
        justify-content: center;
        flex-wrap: wrap;
      }

      /* Forms */
      .form-group {
        margin-bottom: 1.5rem;
      }

      .form-label {
        display: block;
        font-weight: 500;
        color: var(--text-dark);
        margin-bottom: 0.5rem;
        font-size: 0.9375rem;
      }

      .form-control {
        width: 100%;
        padding: 0.875rem 1rem;
        font-size: 1rem;
        color: var(--text-dark);
        background: var(--surface-elevated);
        border: 2px solid var(--border-color);
        border-radius: var(--radius-sm);
        transition: all 0.2s ease;
        font-family: inherit;
      }

      .form-control:focus {
        outline: none;
        border-color: var(--primary-blue);
        box-shadow: 0 0 0 3px rgba(17, 98, 185, 0.15);
      }

      .form-control::placeholder {
        color: var(--text-light);
      }

      /* Cards */
      .card {
        background: var(--surface-elevated);
        border: 1px solid var(--border-color);
        border-radius: var(--radius-lg);
        box-shadow: var(--shadow-sm);
        transition: all 0.3s ease;
      }

      .card:hover {
        box-shadow: var(--shadow-md);
        transform: translateY(-2px);
      }

      /* Utilities */
      .text-center { text-align: center; }
      .text-left { text-align: left; }
      .text-right { text-align: right; }

      .mb-1 { margin-bottom: 0.5rem; }
      .mb-2 { margin-bottom: 1rem; }
      .mb-3 { margin-bottom: 1.5rem; }
      .mb-4 { margin-bottom: 2rem; }
      .mb-5 { margin-bottom: 3rem; }

      .mt-1 { margin-top: 0.5rem; }
      .mt-2 { margin-top: 1rem; }
      .mt-3 { margin-top: 1.5rem; }
      .mt-4 { margin-top: 2rem; }
      .mt-5 { margin-top: 3rem; }

      .py-5 { padding-top: 3rem; padding-bottom: 3rem; }
      .py-10 { padding-top: 6rem; padding-bottom: 6rem; }

      .bg-light { background: var(--bg-light); }
      .bg-white { background: var(--bg-white); }

      .kicker {
        font-family: var(--font-body);
        font-size: 0.8125rem;
        font-weight: 600;
        letter-spacing: 0.08em;
        text-transform: uppercase;
        color: var(--accent-deep);
      }

      .measure { max-width: 68ch; }

      .font-display { font-family: var(--font-display); }

      /* Badge */
      .badge {
        display: inline-block;
        padding: 0.25rem 0.75rem;
        font-size: 0.75rem;
        font-weight: 600;
        border-radius: 9999px;
      }

      .badge-primary {
        background: var(--primary-blue-light);
        color: white;
      }

      /* Alert */
      .alert {
        padding: 1rem;
        border-radius: var(--radius-sm);
        margin-bottom: 1rem;
        border-left: 4px solid;
      }

      .alert-info {
        background: var(--bg-lighter);
        border-color: var(--primary-blue);
        color: var(--primary-blue-dark);
      }

      .alert-error {
        background: #FEF2F2;
        border-color: #EF4444;
        color: #B91C1C;
      }

      .alert-success {
        background: #ECFDF5;
        border-color: #10B981;
        color: #047857;
      }

      /* Navigation Styles */
      .nav {
        background: var(--surface-elevated);
        background: color-mix(in srgb, var(--surface-elevated) 94%, transparent);
        border-bottom: 1px solid var(--border-color);
        position: sticky;
        top: 0;
        z-index: 1000;
        backdrop-filter: blur(6px);
      }

      .nav-container {
        display: flex;
        align-items: center;
        justify-content: space-between;
        padding: 1rem 1.5rem;
        max-width: 1200px;
        margin: 0 auto;
      }

      .nav-brand {
        display: flex;
        align-items: center;
        gap: 0.75rem;
        color: var(--text-dark);
        text-decoration: none;
        font-weight: 600;
        font-size: 1.25rem;
        flex-shrink: 0;
      }

      .nav-brand img {
        height: 2.5rem;
        width: auto;
      }

      .nav-links {
        display: flex;
        align-items: center;
        gap: 1.25rem;
      }

      .nav-dropdown-wrapper {
        position: relative;
      }

      .nav-link {
        color: var(--text-gray);
        text-decoration: none;
        font-weight: 500;
        font-size: 0.9375rem;
        transition: color 0.2s ease;
        white-space: nowrap;
      }

      .nav-link:hover,
      .nav-link.active {
        color: var(--primary-blue);
      }

      .nav-dropdown {
        position: absolute;
        top: 100%;
        left: 0;
        background: var(--surface-elevated);
        border: 1px solid var(--border-color);
        border-radius: var(--radius-sm);
        box-shadow: var(--shadow-lg);
        min-width: 200px;
        display: none;
        z-index: 100;
      }

      .nav-dropdown-link {
        display: block;
        padding: 0.75rem 1rem;
        color: var(--text-gray);
        text-decoration: none;
        border-radius: var(--radius-sm);
        transition: background 0.2s ease, color 0.2s ease;
      }

      .nav-dropdown-link:hover {
        background: var(--bg-light);
        color: var(--text-dark);
      }

      @media (max-width: 1100px) {
        .nav-dropdown-link {
          padding: 0.75rem 1.5rem;
          border-radius: 0;
        }

        .nav-dropdown-link:hover {
          background: transparent;
          color: var(--primary-blue);
        }
      }

      .nav-buttons {
        display: flex;
        align-items: center;
        gap: 0.75rem;
        flex-shrink: 0;
      }

      .theme-toggle {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 0.4rem;
        padding: 0.45rem 0.7rem;
        border: 1px solid var(--border-color);
        border-radius: 999px;
        background: var(--surface-elevated);
        color: var(--text-gray);
        font-size: 0.8125rem;
        font-weight: 600;
        cursor: pointer;
        transition: all 0.2s ease;
      }

      .theme-toggle:hover {
        border-color: var(--primary-blue-light);
        color: var(--primary-blue);
      }

      .theme-toggle[aria-pressed="true"] {
        background: var(--surface-muted);
        border-color: var(--primary-blue-light);
        color: var(--primary-blue-dark);
      }

      .theme-toggle-icon {
        font-size: 0.9rem;
        line-height: 1;
      }

      .theme-toggle-label {
        line-height: 1;
      }

      .theme-toggle-desktop {
        width: 2.3rem;
        height: 2.3rem;
        padding: 0.45rem;
        gap: 0;
      }

      .theme-toggle-desktop .theme-toggle-label {
        position: absolute;
        width: 1px;
        height: 1px;
        margin: -1px;
        padding: 0;
        overflow: hidden;
        clip: rect(0, 0, 0, 0);
        border: 0;
        white-space: nowrap;
        clip-path: inset(50%);
      }

      .theme-toggle-desktop .theme-toggle-icon {
        font-size: 1rem;
      }

      .theme-toggle-mobile {
        width: 100%;
        justify-content: flex-start;
      }

      @media (min-width: 1101px) {
        .theme-toggle-mobile {
          display: none;
        }
      }

      .nav-mobile-actions {
        display: none;
        flex-direction: column;
        gap: 0.75rem;
        padding-top: 0.75rem;
        margin-top: 0.75rem;
        border-top: 1px solid var(--border-color);
        width: 100%;
      }

      /* Mobile Menu */
      .nav-mobile-toggle {
        display: none;
        background: none;
        border: none;
        padding: 0.5rem;
        cursor: pointer;
      }

      @media (max-width: 1100px) {
        .nav-container {
          padding: 0.75rem 1rem;
        }

        .nav-brand img {
          height: 2rem;
          max-width: 170px;
        }

        .nav-links {
          display: none;
          position: absolute;
          top: 100%;
          left: 0;
          right: 0;
          background: var(--surface-elevated);
          flex-direction: column;
          padding: 1.5rem;
          gap: 0.75rem;
          border-bottom: 1px solid var(--border-color);
          box-shadow: var(--shadow-lg);
          align-items: flex-start;
        }

        .nav-links.show {
          display: flex;
        }

        .nav-links .nav-link {
          width: 100%;
          font-size: 1rem;
          display: block;
          padding: 0.4rem 0;
        }

        .nav-dropdown-wrapper {
          width: 100%;
        }

        .nav-dropdown {
          position: static;
          width: 100%;
          min-width: 100%;
          box-shadow: none;
          margin-top: 0.5rem;
          background: transparent;
          border: none;
          border-radius: 0;
        }

        .nav-mobile-actions {
          display: flex;
        }

        .nav-mobile-toggle {
          display: block;
        }

        .nav-buttons {
          gap: 0;
        }

        .nav-buttons .btn {
          display: none;
        }

        .theme-toggle-desktop {
          display: none;
        }
      }

      /* Footer */
      .footer {
        background: var(--text-dark);
        color: var(--text-light);
        padding: 4rem 0 2rem;
      }

      .footer-content {
        max-width: 1200px;
        margin: 0 auto;
        padding: 0 1.5rem;
      }

      .footer-section {
        margin-bottom: 2rem;
      }

      .footer-section h4 {
        color: white;
        margin-bottom: 1rem;
      }

      .footer-links {
        list-style: none;
      }

      .footer-links li {
        margin-bottom: 0.5rem;
      }

      .footer-links a {
        color: var(--text-light);
        transition: color 0.2s ease;
      }

      .footer-links a:hover {
        color: white;
      }

      .footer-bottom {
        border-top: 1px solid rgba(255, 255, 255, 0.1);
        padding-top: 2rem;
        margin-top: 2rem;
        text-align: center;
      }

      /* Grid */
      .grid {
        display: grid;
        gap: 2rem;
      }

      .grid-2 {
        grid-template-columns: repeat(2, 1fr);
      }

      .grid-3 {
        grid-template-columns: repeat(3, 1fr);
      }

      .grid-4 {
        grid-template-columns: repeat(4, 1fr);
      }

      @media (max-width: 768px) {
        .grid-2,
        .grid-3,
        .grid-4 {
          grid-template-columns: 1fr;
        }

        .grid {
          gap: 1.5rem;
        }

        .cta-buttons {
          flex-direction: column;
          align-items: stretch;
        }

        .cta-buttons .btn {
          width: 100%;
        }

        body {
          font-size: 15.5px;
        }

        .lead-text,
        .section-lead,
        .cta-lead {
          font-size: 1rem;
        }

        .cta-title {
          font-size: 1.9rem;
        }

        h1 { font-size: 1.9rem; }
        h2 { font-size: 1.6rem; }
      }

      /* Stats */
      .stat-card {
        text-align: center;
        padding: 2.5rem;
        background: var(--surface-elevated);
        border-radius: var(--radius-lg);
        border: 1px solid var(--border-color);
      }

      .stat-number {
        font-size: 3.5rem;
        font-weight: 700;
        color: var(--primary-blue);
        margin-bottom: 0.5rem;
      }

      .stat-label {
        color: var(--text-gray);
        font-size: 1.125rem;
      }

      /* Feature */
      .feature-icon {
        width: 3rem;
        height: 3rem;
        background: var(--surface-muted);
        border-radius: var(--radius-sm);
        display: flex;
        align-items: center;
        justify-content: center;
        margin-bottom: 1rem;
        color: var(--primary-blue);
      }

      @media (max-width: 768px) {
        .feature-icon {
          margin: 0 auto 1rem auto;
        }
      }

      /* Hero */
      .hero {
        min-height: 80vh;
        display: flex;
        align-items: center;
      }

      .hero-content {
        max-width: 800px;
      }

      .hero-form {
        display: flex;
        gap: 1rem;
        max-width: 600px;
      }

      .hero-form input {
        flex: 1;
      }

      @media (max-width: 768px) {
        .hero {
          min-height: auto;
          padding: 3.5rem 0;
        }

        .hero-content {
          max-width: 100%;
        }

        .hero-form {
          flex-direction: column;
        }

        .hero-form .btn {
          width: 100%;
        }

        .stat-card {
          padding: 1.75rem;
        }

        .stat-number {
          font-size: 2.75rem;
        }
      }

      /* Section */
      .section {
        padding: 5rem 0;
      }

      .section-light {
        background: var(--surface-muted);
      }

      @media (max-width: 768px) {
        .section {
          padding: 3.5rem 0;
        }
      }

      /* Responsive */
      @media (max-width: 480px) {
        .container { padding: 0 1rem; }
        .py-5 { padding-top: 2rem; padding-bottom: 2rem; }
        .py-10 { padding-top: 4rem; padding-bottom: 4rem; }
        .footer-content { padding: 0 1rem; }
        h1 { font-size: 1.7rem; }
        h2 { font-size: 1.45rem; }
      }

      /* Visually hidden */
      .visually-hidden {
        position: absolute;
        width: 1px;
        height: 1px;
        margin: -1px;
        padding: 0;
        overflow: hidden;
        clip: rect(0, 0, 0, 0);
        border: 0;
        white-space: nowrap;
        clip-path: inset(50%);
      }
    </style>
    
<style>
  #pricing-section {
    background: var(--surface-muted);
  }

  #pricing-section .tabs-wrapper {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 2.5rem;
    width: 100%;
  }

  .wall-upgrade-banner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 1rem;
    padding: 1.25rem 1.5rem;
    border: 1px solid rgba(37, 99, 235, 0.35);
    border-radius: var(--radius-md);
    background: rgba(37, 99, 235, 0.08);
  }

  .wall-upgrade-banner__text {
    margin: 0;
    font-weight: 600;
    color: var(--text-dark);
  }

  #pricing-section .pricing-tab-menu {
    display: inline-flex;
    gap: 0.25rem;
    padding: 0.35rem;
    border: 1px solid var(--border-color);
    border-radius: 999px;
    background: var(--bg-white);
    box-shadow: var(--shadow-sm);
  }

  #pricing-section .price-tab-link {
    border: 0;
    background: transparent;
    color: var(--text-gray);
    padding: 0.75rem 1.75rem;
    font-size: 0.95rem;
    font-weight: 600;
    border-radius: 999px;
    cursor: pointer;
    position: relative;
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    transition: all 0.2s ease;
  }

  #pricing-section .price-tab-link:hover {
    color: var(--text-dark);
  }

  #pricing-section .price-tab-link.is-active {
    background: var(--text-dark);
    color: white;
    box-shadow: var(--shadow-sm);
  }

  #pricing-section .discount-badge {
    position: absolute;
    top: -12px;
    right: -10px;
    background: var(--primary-blue);
    color: white;
    padding: 0.2rem 0.55rem;
    border-radius: 999px;
    font-size: 0.65rem;
    font-weight: 600;
    letter-spacing: 0.04em;
  }

  #pricing-section .tabs-content {
    width: 100%;
  }

  #pricing-section .pricing-panel {
    display: none;
  }

  #pricing-section .pricing-panel.is-active {
    display: block;
  }

  #pricing-section .price-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 270px), 1fr));
    gap: clamp(1.25rem, 1.6vw, 2.5rem);
    width: 100%;
  }

  .cancel-modal {
    position: fixed;
    inset: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.2s ease;
    z-index: 2000;
  }

  .cancel-modal.is-open {
    opacity: 1;
    pointer-events: all;
  }

  .cancel-modal__backdrop {
    position: absolute;
    inset: 0;
    background: rgba(15, 23, 42, 0.55);
  }

  .cancel-modal__panel {
    position: relative;
    width: min(92vw, 480px);
    background: var(--bg-white);
    border-radius: var(--radius-md);
    border: 1px solid var(--border-color);
    box-shadow: var(--shadow-lg);
    padding: 1.75rem;
    transform: translateY(8px);
    transition: transform 0.2s ease;
  }

  .cancel-modal.is-open .cancel-modal__panel {
    transform: translateY(0);
  }

  .cancel-modal__header {
    display: flex;
    gap: 0.75rem;
    align-items: flex-start;
    margin-bottom: 1rem;
  }

  .cancel-modal__icon {
    width: 40px;
    height: 40px;
    border-radius: 999px;
    background: rgba(220, 38, 38, 0.12);
    color: #dc2626;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }

  .cancel-modal__title {
    font-size: 1.2rem;
    margin: 0 0 0.35rem;
  }

  .cancel-modal__desc {
    margin: 0;
    color: var(--text-gray);
    font-size: 0.95rem;
  }

  .cancel-modal__note {
    margin-bottom: 1.25rem;
    padding: 0.75rem 1rem;
    border-radius: var(--radius-sm);
    border: 1px solid var(--border-color);
    background: var(--bg-light);
    color: var(--text-gray);
    font-size: 0.9rem;
  }

  .cancel-modal__actions {
    display: flex;
    gap: 0.75rem;
    justify-content: flex-end;
    flex-wrap: wrap;
  }

  .cancel-modal__actions .btn {
    min-width: 150px;
  }

  .cancel-modal .btn-danger {
    background: #dc2626;
    color: #fff;
  }

  .cancel-modal .btn-danger:hover {
    background: #b91c1c;
    transform: translateY(-1px);
    box-shadow: var(--shadow-md);
  }

  .cancel-modal-open {
    overflow: hidden;
  }

  @media (max-width: 480px) {
    .cancel-modal__actions {
      flex-direction: column;
    }

    .cancel-modal__actions .btn {
      width: 100%;
    }
  }

  #pricing-section .price-card {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    padding: 2.5rem;
    border: 1px solid var(--border-color);
    border-radius: var(--radius-lg);
    background: var(--surface-elevated);
    transition: all 0.3s ease;
    min-width: 0;
  }

  #pricing-section .price-card:hover {
    background: var(--bg-white);
    box-shadow: var(--shadow-lg);
