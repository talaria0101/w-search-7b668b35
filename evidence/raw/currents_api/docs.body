              Latest News
            </a>
          </li>
          <li class="docs-nav-item">
            <a href="/en/docs/search" class="docs-nav-link">
              Search
            </a>
          </li>

          <div class="docs-nav-header">SDK</div>
          <li class="docs-nav-item">
            <a href="/en/docs/official" class="docs-nav-link">
              Official SDKs
            </a>
          </li>

          <div class="docs-nav-header">AI Agents</div>
          <li class="docs-nav-item">
            <a href="/en/docs/agent_skills" class="docs-nav-link">
              Agent Skills
            </a>
