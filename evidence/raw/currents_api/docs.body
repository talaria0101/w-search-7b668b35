        <th style="text-align: left; padding: 0.5rem; border-bottom: 1px solid var(--border-color);">V1</th>
        <th style="text-align: left; padding: 0.5rem; border-bottom: 1px solid var(--border-color);">V2</th>
      </tr>
    </thead>
    <tbody>
      <tr>
        <td style="padding: 0.5rem; border-bottom: 1px solid var(--border-color);">Latest News</td>
        <td style="padding: 0.5rem; border-bottom: 1px solid var(--border-color);"><code>/v1/latest-news</code></td>
        <td style="padding: 0.5rem; border-bottom: 1px solid var(--border-color);"><code>/v2/latest-news</code></td>
      </tr>
      <tr>
        <td style="padding: 0.5rem; border-bottom: 1px solid var(--border-color);">Search</td>
        <td style="padding: 0.5rem; border-bottom: 1px solid var(--border-color);"><code>/v1/search</code> (offset pagination)</td>
        <td style="padding: 0.5rem; border-bottom: 1px solid var(--border-color);"><code>/v2/search</code> (offset + cursor pagination)</td>
      </tr>
      <tr>
        <td style="padding: 0.5rem; border-bottom: 1px solid var(--border-color);">Auth Check</td>
        <td style="padding: 0.5rem; border-bottom: 1px solid var(--border-color);"><code>/v1/auth</code></td>
        <td style="padding: 0.5rem; border-bottom: 1px solid var(--border-color);">Not available on <code>/v2</code></td>
      </tr>
      <tr>
        <td style="padding: 0.5rem;">Available Filters</td>
        <td style="padding: 0.5rem;"><code>/v1/available/*</code></td>
        <td style="padding: 0.5rem;"><code>/v2/available/*</code></td>
      </tr>
      <tr>
        <td style="padding: 0.5rem; border-top: 1px solid var(--border-color);">Category Source of Truth</td>
        <td style="padding: 0.5rem; border-top: 1px solid var(--border-color);">Legacy compatibility path</td>
        <td style="padding: 0.5rem; border-top: 1px solid var(--border-color);">Canonical category taxonomy</td>
      </tr>
    </tbody>
  </table>
</div>

