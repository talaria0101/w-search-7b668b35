    <link rel="shortcut icon" href="/favicon.ico" type="image/png">

    <!-- Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Source+Serif+4:opsz,wght@8..60,600;8..60,700&family=Source+Sans+3:wght@400;600&family=Spline+Sans+Mono:wght@400;500&display=swap" rel="stylesheet">

    <script>
      (function() {
        try {
          const storedTheme = localStorage.getItem('currents_theme');
          if (storedTheme === 'classic') {
            document.documentElement.removeAttribute('data-theme');
            return;
          }
          document.documentElement.setAttribute('data-theme', 'comfort');
        } catch (e) {
          document.documentElement.setAttribute('data-theme', 'comfort');
        }
      })();
    </script>

    <style>
      :root {
        --primary-blue: #1162B9;
        --primary-blue-dark: #034393;
        --primary-blue-light: #B7D4F2;
        --bg-white: #FFFFFF;
        --bg-light: #F8FAFC;
        --bg-lighter: #F1F5F9;
        --surface-elevated: #FFFFFF;
        --surface-muted: #F7FAFC;
        --text-dark: #0F172A;
        --text-gray: #64748B;
        --text-light: #64748B;
        --border-color: #E2E8F0;
        --body-accent: rgba(17, 98, 185, 0.05);
        --shadow-sm: 0 1px 2px 0 rgba(0, 0, 0, 0.05);
        --shadow-md: 0 4px 6px -1px rgba(0, 0, 0, 0.1);
        --shadow-lg: 0 10px 15px -3px rgba(0, 0, 0, 0.1);
        --radius-sm: 8px;
        --radius-md: 12px;
        --radius-lg: 16px;
        /* Typography */
        --font-display: 'Source Serif 4', Georgia, 'Times New Roman', serif;
        --font-body: 'Source Sans 3', -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;
        --font-mono: 'Spline Sans Mono', ui-monospace, SFMono-Regular, Menlo, monospace;
        /* Accent and semantic */
        --accent: #D8953D;
        --accent-deep: #A0600B;
        --accent-tint: rgba(216, 149, 61, 0.14);
        --success: #33854A;
        --warning: #CD9130;
        --error: #B6322D;
      }

      html[data-theme="comfort"] {
        --primary-blue: #1162B9;
        --primary-blue-dark: #034393;
        --primary-blue-light: #B7D4F2;
        --bg-white: #FBF9F3;
        --bg-light: #F7F3EA;
        --bg-lighter: #EEE9DC;
        --surface-elevated: #FEFDFB;
        --surface-muted: #FAF8F4;
        --text-dark: #2C2822;
        --text-gray: #46423A;
        --text-light: #686359;
        --border-color: #E0D8C8;
        --body-accent: rgba(17, 98, 185, 0.07);
        --shadow-sm: 0 1px 2px 0 rgba(44, 40, 34, 0.06);
        --shadow-md: 0 8px 16px -8px rgba(44, 40, 34, 0.16);
        --shadow-lg: 0 18px 28px -16px rgba(44, 40, 34, 0.2);
      }

      * {
        margin: 0;
        padding: 0;
        box-sizing: border-box;
      }

      html {
        background-color: var(--bg-light) !important;
        width: 100%;
        overflow-x: hidden;
      }
      body {
        font-family: var(--font-body);
        background:
          radial-gradient(1200px 450px at 90% -10%, var(--body-accent), transparent 70%),
          linear-gradient(180deg, var(--bg-light) 0%, var(--bg-white) 32%, var(--bg-white) 100%);
        color: var(--text-dark);
        line-height: 1.65;
        font-size: 1.0625rem;
        -webkit-font-smoothing: antialiased;
        -moz-osx-font-smoothing: grayscale;
        width: 100%;
        overflow-x: hidden;
      }

      h1, h2, h3, h4, h5, h6 {
        color: var(--text-dark);
        font-weight: 600;
        line-height: 1.15;
        margin-bottom: 1rem;
      }

      h1, h2 {
        font-family: var(--font-display);
      }

      h1 { font-size: clamp(2.25rem, 3vw + 0.75rem, 3.25rem); line-height: 1.12; letter-spacing: -0.015em; margin-bottom: 2rem; }
      h2 { font-size: clamp(1.625rem, 2vw + 0.5rem, 2.125rem); letter-spacing: -0.01em; margin-bottom: 1.5rem; }
      h3 { font-size: 1.5rem; margin-bottom: 1rem; }
      h4 { font-size: 1.1875rem; margin-bottom: 0.75rem; }
      h5 { font-size: 1.125rem; margin-bottom: 0.5rem; }
      h6 { font-size: 1rem; margin-bottom: 0.5rem; }

      p {
        color: var(--text-gray);
        line-height: 1.65;
        margin-bottom: 1rem;
      }

      img,
      svg {
        max-width: 100%;
        height: auto;
      }

      a {
        color: var(--primary-blue);
        text-decoration: none;
        transition: color 0.2s ease;
      }

      a:hover {
        color: var(--primary-blue-dark);
      }

      /* Container */
      .container {
        max-width: 1400px;
        margin: 0 auto;
        padding: 0 1.5rem;
      }

      /* Documentation Layout */
      .docs-layout {
        display: grid;
        grid-template-columns: 280px 1fr;
        min-height: calc(100vh - 5rem);
        width: 100%;
        max-width: 100%;
      }

      @media (max-width: 1024px) {
        .docs-layout {
          grid-template-columns: 1fr;
        }

        .docs-sidebar {
          display: none;
        }

        .docs-sidebar.show {
          display: block;
        }
      }

      /* Sidebar */
      .docs-sidebar {
        background: var(--surface-muted);
        border-right: 1px solid var(--border-color);
        padding: 2rem 0 0 0;
        position: sticky;
        top: 5rem;
        height: calc(100vh - 5rem);
        overflow-y: auto;
      }

      .docs-sidebar-logo {
        padding: 0 1.5rem 2rem 1.5rem;
        border-bottom: 1px solid var(--border-color);
        margin-bottom: 1rem;
      }

      .docs-sidebar-logo img {
        max-height: 2rem;
        width: auto;
      }

      .docs-sidebar-logo a {
        display: block;
      }

      .docs-nav {
        list-style: none;
      }

      .docs-nav-item {
        margin-bottom: 0.25rem;
      }

      .docs-nav-link {
        display: block;
        padding: 0.75rem 1.5rem;
        color: var(--text-gray);
        text-decoration: none;
        font-size: 0.9375rem;
        transition: all 0.2s ease;
        border-left: 3px solid transparent;
      }

      .docs-nav-link:hover,
      .docs-nav-link.active {
        color: var(--primary-blue);
        background: var(--surface-elevated);
        border-left-color: var(--primary-blue);
      }

      .docs-nav-header {
        padding: 0.75rem 1.5rem;
        font-weight: 600;
        color: var(--text-dark);
        font-size: 0.875rem;
        text-transform: uppercase;
        letter-spacing: 0.05em;
        margin-top: 1.5rem;
      }

      /* Content */
      .docs-content {
        padding: 3rem;
        max-width: 900px;
        width: 100%;
        overflow-wrap: anywhere;
        min-width: 0;
      }

      .docs-content > * {
        max-width: 100%;
      }

      @media (max-width: 768px) {
        .docs-content {
          padding: 1.5rem;
        }

        body { font-size: 15.5px; }
        h1 { font-size: 1.75rem; }
        h2 { font-size: 1.5rem; }

        table {
          display: block;
          overflow-x: auto;
        }
      }

      /* Code Blocks */
      code {
        font-family: var(--font-mono);
        background: var(--surface-muted);
        padding: 0.2rem 0.4rem;
        border-radius: var(--radius-sm);
        font-size: 0.875rem;
        color: var(--text-dark);
        overflow-wrap: anywhere;
      }

      pre {
        background: var(--surface-muted);
        border: 1px solid var(--border-color);
        border-radius: var(--radius-md);
        padding: 1.5rem;
        margin-bottom: 2rem;
        overflow-x: auto;
        max-width: 100%;
      }

      pre code {
        background: none;
        padding: 0;
        border: none;
        font-size: 0.875rem;
        line-height: 1.7;
      }

      /* Tables */
      table {
        width: 100%;
        border-collapse: collapse;
        margin-bottom: 2rem;
        table-layout: fixed;
      }

      th, td {
        padding: 1rem;
        text-align: left;
        border-bottom: 1px solid var(--border-color);
        word-break: break-word;
      }

      th {
        font-weight: 600;
        color: var(--text-dark);
        background: var(--bg-light);
      }

      tr:hover td {
        background: var(--bg-light);
      }

      /* Alerts */
      .alert {
        padding: 1rem 1.5rem;
        border-radius: var(--radius-sm);
        margin-bottom: 1.5rem;
        border-left: 4px solid;
      }

      .alert-info {
        background: var(--bg-lighter);
        border-color: var(--primary-blue);
        color: var(--primary-blue-dark);
      }

      .alert-success {
        background: #ECFDF5;
        border-color: #10B981;
        color: #047857;
      }

      .alert-warning {
        background: #FEF3C7;
        border-color: #F59E0B;
        color: #92400E;
      }

      /* API Endpoint Card */
      .endpoint-card {
        background: var(--surface-elevated);
        border: 1px solid var(--border-color);
        border-radius: var(--radius-md);
        padding: 2rem;
        margin-bottom: 2rem;
      }

      .endpoint-method {
        display: inline-block;
        padding: 0.5rem 1rem;
        border-radius: var(--radius-sm);
        font-weight: 600;
        font-size: 0.875rem;
        text-transform: uppercase;
        margin-bottom: 1rem;
      }

      .endpoint-method.get { background: #DBEAFE; color: #1E40AF; }
      .endpoint-method.post { background: #D1FAE5; color: #047857; }
      .endpoint-method.put { background: #FEF3C7; color: #92400E; }
      .endpoint-method.delete { background: #FEE2E2; color: #B91C1C; }

      .endpoint-url {
        font-family: var(--font-mono);
        font-size: 1rem;
        color: var(--text-dark);
        margin-bottom: 1rem;
        word-break: break-word;
        overflow-wrap: anywhere;
      }

      /* Mobile Menu Toggle */
      .docs-mobile-toggle {
        display: none;
        position: fixed;
        bottom: 2rem;
        right: 2rem;
        width: 3.5rem;
        height: 3.5rem;
        background: var(--primary-blue);
        color: white;
        border: none;
        border-radius: 50%;
        box-shadow: var(--shadow-lg);
        cursor: pointer;
        z-index: 1000;
        transition: all 0.2s ease;
      }

      .docs-mobile-toggle:hover {
        transform: scale(1.1);
        background: var(--primary-blue-dark);
      }

      @media (max-width: 1024px) {
        .docs-mobile-toggle {
          display: flex;
          align-items: center;
          justify-content: center;
        }
      }

      /* Navigation */
      .nav {
        background: var(--surface-elevated);
        background: color-mix(in srgb, var(--surface-elevated) 94%, transparent);
        border-bottom: 1px solid var(--border-color);
        position: sticky;
        top: 0;
        z-index: 100;
        backdrop-filter: blur(6px);
      }

      .nav-container {
        display: flex;
        align-items: center;
        justify-content: space-between;
        width: 100%;
        padding: 1rem 1.5rem 1rem 0;
        margin: 0;
      }

      .nav-brand {
        display: flex;
        align-items: center;
        gap: 0.75rem;
        color: var(--text-dark);
        text-decoration: none;
        font-weight: 600;
        font-size: 1.25rem;
        flex-shrink: 0;
        width: 280px;
        padding-left: 1.5rem;
      }

      .nav-brand img {
        height: 2.5rem;
        width: auto;
      }

      .theme-toggle {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 0.4rem;
        padding: 0.4rem 0.7rem;
        border: 1px solid var(--border-color);
        border-radius: 999px;
        background: var(--surface-elevated);
        color: var(--text-gray);
        font-size: 0.8125rem;
        font-weight: 600;
        cursor: pointer;
        transition: all 0.2s ease;
      }

      .theme-toggle:hover {
        border-color: var(--primary-blue-light);
        color: var(--primary-blue);
      }

      .theme-toggle[aria-pressed="true"] {
        background: var(--surface-muted);
        border-color: var(--primary-blue-light);
        color: var(--primary-blue-dark);
      }

      .theme-toggle-icon {
        font-size: 0.9rem;
        line-height: 1;
      }

      .theme-toggle-label {
        line-height: 1;
        white-space: nowrap;
      }

      .docs-nav-actions {
        display: flex;
        align-items: center;
        gap: 1rem;
        margin-left: auto;
        flex-wrap: nowrap;
      }

      .docs-auth-link {
        color: var(--text-gray);
        text-decoration: none;
        font-weight: 500;
        white-space: nowrap;
      }

      .docs-auth-link:hover {
        color: var(--primary-blue);
      }

      .docs-auth-btn {
        padding: 0.5rem 1rem;
        font-size: 0.875rem;
        line-height: 1.2;
        white-space: nowrap;
      }

      @media (max-width: 768px) {
        .nav-container {
          padding: 0.75rem 1rem;
        }

        .nav-brand img {
          height: 2rem;
          max-width: 160px;
        }

        .docs-nav-actions {
          gap: 0.55rem;
        }

        .theme-toggle {
          padding: 0.35rem 0.55rem;
          font-size: 0.75rem;
        }

        .docs-auth-btn {
          padding: 0.42rem 0.75rem;
          font-size: 0.8125rem;
        }
      }

      @media (max-width: 1024px) {
        .nav-brand {
          width: auto;
          padding-left: 0;
        }
      }

      @media (max-width: 520px) {
        .theme-toggle {
          width: 2rem;
          height: 2rem;
          padding: 0.35rem;
          gap: 0;
        }

        .theme-toggle-label {
          position: absolute;
          width: 1px;
          height: 1px;
          margin: -1px;
          padding: 0;
          overflow: hidden;
          clip: rect(0, 0, 0, 0);
          border: 0;
          white-space: nowrap;
          clip-path: inset(50%);
        }

        .docs-nav-actions {
          gap: 0.45rem;
        }

        .docs-auth-link {
          font-size: 0.92rem;
        }

        .docs-auth-btn {
          padding: 0.4rem 0.62rem;
          font-size: 0.8rem;
        }
      }

      /* Footer */
      .footer {
        background: var(--text-dark);
        color: var(--text-light);
        padding: 3rem 1.5rem 2rem;
        text-align: center;
      }

      .footer a {
        color: var(--text-light);
      }

      /* Utilities */
      .mb-1 { margin-bottom: 0.5rem; }
      .mb-2 { margin-bottom: 1rem; }
      .mb-3 { margin-bottom: 1.5rem; }
      .mb-4 { margin-bottom: 2rem; }

      .mt-1 { margin-top: 0.5rem; }
      .mt-2 { margin-top: 1rem; }
      .mt-3 { margin-top: 1.5rem; }
      .mt-4 { margin-top: 2rem; }

      /* Visually Hidden */
      .visually-hidden {
        position: absolute;
        width: 1px;
        height: 1px;
        margin: -1px;
        padding: 0;
        overflow: hidden;
        clip: rect(0, 0, 0, 0);
        border: 0;
      }

      /* Scrollbar */
      ::-webkit-scrollbar {
        width: 8px;
      }

      ::-webkit-scrollbar-track {
        background: var(--bg-light);
      }

      ::-webkit-scrollbar-thumb {
        background: var(--border-color);
        border-radius: var(--radius-sm);
      }

      ::-webkit-scrollbar-thumb:hover {
        background: var(--text-light);
      }
    </style>

    
<title>News API Quick Start: Get Your API Key in Minutes | Currents</title>
<meta name="description" content="Start with the Currents News API: create a free account, get your API key, make your first JSON request to /v1/latest-news or /v1/search. No card required.">

  </head>
  <body>
    <!-- Navigation -->
    <nav class="nav">
      <div class="nav-container">
        <a href="/en" class="nav-brand" aria-label="Currents home">
          <img src="/en/img/logo-banner.svg" alt="Currents">
        </a>

        <div class="docs-nav-actions">
          <button class="theme-toggle" type="button" data-theme-toggle aria-pressed="false">
            <span class="theme-toggle-icon" aria-hidden="true">◐</span>
            <span class="theme-toggle-label" data-theme-toggle-label>Comfort off</span>
          </button>

          
            <a href="/en/login" class="docs-auth-link">Login</a>
            <a href="/en/register" class="btn btn-primary docs-auth-btn">Sign Up</a>
          
        </div>
      </div>
    </nav>

    <!-- Documentation Layout -->
    <div class="docs-layout">
      <!-- Sidebar -->
      <aside class="docs-sidebar" id="docsSidebar">
        <ul class="docs-nav">
          <li class="docs-nav-item">
            <a href="/en/docs/introduction" class="docs-nav-link">
              Introduction
            </a>
          </li>
          <li class="docs-nav-item">
            <a href="/en/docs/" class="docs-nav-link">
              Getting Started
            </a>
          </li>
          <li class="docs-nav-item">
            <a href="/en/docs/authentication" class="docs-nav-link">
              Authentication
            </a>
          </li>
          <li class="docs-nav-item">
            <a href="/en/docs/ratelimit" class="docs-nav-link">
              Rate Limit
            </a>
          </li>
          <li class="docs-nav-item">
            <a href="/en/docs/errors" class="docs-nav-link">
              Error Responses
            </a>
          </li>

          <div class="docs-nav-header">API Endpoints</div>
          <li class="docs-nav-item">
