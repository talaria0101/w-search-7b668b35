    <script>
      // Mobile Sidebar Toggle
      (function() {
        const toggle = document.getElementById('docsMobileToggle');
        const sidebar = document.getElementById('docsSidebar');

        if (!toggle) return;

        toggle.addEventListener('click', () => {
          sidebar.classList.toggle('show');
        });

        // Close sidebar on content click
        const content = document.querySelector('.docs-content');
        content.addEventListener('click', () => {
          sidebar.classList.remove('show');
        });
      })();

      // Active Link Highlighting
      (function() {
        const currentPath = window.location.pathname;
        const links = document.querySelectorAll('.docs-nav-link');

        links.forEach(link => {
          if (link.getAttribute('href') === currentPath) {
            link.classList.add('active');
          }
        });
      })();

      (function() {
        const storageKey = 'currents_theme';
        const root = document.documentElement;
        const isComfort = () => root.getAttribute('data-theme') === 'comfort';

        function applyTheme(theme) {
          const mode = theme === 'classic' ? 'classic' : 'comfort';
          if (mode === 'classic') {
            root.removeAttribute('data-theme');
          } else {
            root.setAttribute('data-theme', 'comfort');
          }

          const comfortEnabled = isComfort();
          const label = comfortEnabled ? 'Comfort on' : 'Comfort off';
          document.querySelectorAll('[data-theme-toggle]').forEach((btn) => {
            btn.setAttribute('aria-pressed', comfortEnabled ? 'true' : 'false');
          });
          document.querySelectorAll('[data-theme-toggle-label]').forEach((textNode) => {
            textNode.textContent = label;
          });
        }

        function initTheme() {
          try {
            const storedTheme = localStorage.getItem(storageKey);
            applyTheme(storedTheme || 'comfort');
          } catch (e) {
            applyTheme('comfort');
          }
        }

        function handleThemeToggle(event) {
          const toggleButton = event.target.closest('[data-theme-toggle]');
          if (!toggleButton) return;

          const nextTheme = isComfort() ? 'classic' : 'comfort';
          applyTheme(nextTheme);
          try {
            localStorage.setItem(storageKey, nextTheme);
          } catch (e) {
            // Ignore storage write failures and keep in-memory theme state.
          }
        }

        initTheme();
        document.addEventListener('click', handleThemeToggle);
      })();
    </script>
    <script src="/en/js/webmcp-tools.js"></script>
