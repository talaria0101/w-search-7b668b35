    <!-- TechArticle Schema (JSON-LD) -->
    <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": "TechArticle",
      "headline": "Currents News API Documentation",
      "description": "Complete documentation for the Currents News API: authentication, endpoints, rate limits, and error handling for real-time news data in JSON.",
      "url": "https://currentsapi.services/en/docs/",
      "inLanguage": "en",
      "publisher": {"@type": "Organization", "name": "Currents News API", "url": "https://currentsapi.services"}
