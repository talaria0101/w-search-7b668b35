  <script>
  /* WebMCP, inline on the home: agent-readiness scanners read the homepage's
     inline scripts but only a sample of its bundles, and nav.js (which registers
     the same tools on every other page) fell outside that sample. Keep the two
     copies in step: same tools, same documents.
     The site's agent documents as in-page tools a browser agent can call
     (document.modelContext, with navigator.modelContext as the trailing fallback).
     Read-only by design: every tool returns a document we already publish for
     agents, fetched live, so nothing here can drift from it or act for the user.
     A no-op in any browser without the API. */
  (function () {
    var mc = (document.modelContext && document.modelContext.registerTool && document.modelContext) ||
      (navigator.modelContext && navigator.modelContext.registerTool && navigator.modelContext);
    if (!mc) return;
    window.__zrWebMCP = true;
    function text(url) {
      return fetch(url, { credentials: "omit" }).then(function (r) {
        if (!r.ok) throw new Error(url + " returned " + r.status);
        return r.text();
      }).then(function (t) { return { content: [{ type: "text", text: t }] }; });
    }
    var none = { type: "object", properties: {}, additionalProperties: false };
    var tools = [
      { name: "zenrows_overview", url: "/llms.txt",
        description: "What Zenrows is and where everything lives: the products (Fetch, Extract, Crawl, Batch, Browser), docs, API, CLI, MCP server and how an agent gets access. Returns llms.txt." },
      { name: "zenrows_pricing", url: "/pricing.md",
        description: "Zenrows plans, prices, the free tier and the credit cost per request type. Returns pricing.md." },
      { name: "zenrows_agent_setup", url: "/SKILL.md",
        description: "How to set Zenrows up inside an AI agent: install, the commands it gets and when to use each. Returns SKILL.md." },
      { name: "zenrows_agent_auth", url: "/auth.md",
        description: "How an agent gets a Zenrows API key, including self-serve signup with no human present, and how to authenticate requests. Returns auth.md." },
    ];
    tools.forEach(function (t) {
      try {
        mc.registerTool({
          name: t.name,
          description: t.description,
          inputSchema: none,
          annotations: { readOnlyHint: true },
          execute: function () { return text(t.url); },
        });
      } catch (e) { /* an older preview of the API: leave the page as it is */ }
    });
    try {
      mc.registerTool({
        name: "zenrows_api_operations",
        description: "The Zenrows HTTP API as a list of operations (method, path, operationId, summary). The full OpenAPI description is at /openapi.json.",
        inputSchema: none,
        annotations: { readOnlyHint: true },
        execute: function () {
          return fetch("/openapi.json", { credentials: "omit" }).then(function (r) { return r.json(); }).then(function (spec) {
            var lines = [];
            Object.keys(spec.paths || {}).forEach(function (p) {
              Object.keys(spec.paths[p]).forEach(function (m) {
                var o = spec.paths[p][m];
                if (o && o.operationId) lines.push(m.toUpperCase() + " " + p + "  " + o.operationId + ": " + (o.summary || ""));
              });
            });
            return { content: [{ type: "text", text: lines.join("\n") + "\n\nFull spec: https://www.zenrows.com/openapi.json" }] };
          });
        },
      });
    } catch (e) { /* as above */ }
  })();
  </script>
  <script>
  /* ZeroClick badge, requested once the page has loaded. As a plain async tag
     it still held the window load event until cdn.zeroclick.io answered, and
     when that CDN hangs it held everything waiting on load (Intercom, the
     topbar's band re-check). Same script, same URL, just after load. */
  (function () {
    function zc() {
      var s = document.createElement("script");
      s.async = true;
      s.src = "https://cdn.zeroclick.io/scripts/badge.js?seller=sel_pr7my1Sfya1dfxY1fMW1k";
      document.head.appendChild(s);
    }
    if (document.readyState === "complete") zc();
    else window.addEventListener("load", zc);
  })();
  </script>
