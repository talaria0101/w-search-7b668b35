    <!-- ── Live demo — Fetch to agent, full-bleed cinematic embed ─────────
         Oversized, borderless iframe of the live product (playground Fetch,
         then MCP, then the agentic terminal). The hero is a static build of the
         ZP prototype vendored into this site under /demo/, so it is served
         same-origin (no cross-origin, no Cloudflare Access, no framing block). -->
    <section class="home-demo-band" aria-labelledby="home-demo-h">
      <div class="home-demo-head">
        <h2 class="home-demo-h2" id="home-demo-h">See it for yourself.</h2>
      </div>
      <!-- The hero renders at a FIXED 1600x1000 desktop viewport and is scaled
           to the band width by home.js (--home-demo-scale). This keeps the app
           on its desktop layout at every screen size, so nothing reflows into a
           narrow/mobile breakpoint (which overflowed controls) inside the frame. -->
      <div class="home-demo-stage">
        <!-- The iframe pulls a ~1.5MB-gzipped live app; it must NOT load on first
             paint. `src` is set by home.js via IntersectionObserver only when the
             band nears the viewport, so a visitor who never scrolls here pays
             nothing. (native loading="lazy" fires far too eagerly for this.) -->
        <iframe
          class="home-demo-frame"
          data-src="/demo/index.html?probe=fetch&amp;hero=1"
          title="Zenrows live demo: fetch a page, then hand it to an agent"
          referrerpolicy="no-referrer"
          scrolling="no"
          tabindex="-1"></iframe>
      </div>
    </section>

    <!-- ── Act 5: Agent Onboarding — teal band ────────────────────────── -->
    <section class="hv2-agent" data-act="agent" id="hv2-agent-band" aria-labelledby="hv2-agent-h">
      <div class="hv2-agent-inner">
        <div class="hv2-agent-left">
          <h2 class="hv2-agent-h2" id="hv2-agent-h">Connect your agent to the live web.</h2>
          <p class="hv2-agent-body">Your agent asks in plain language. Zenrows fetches the page, protected or dynamic, and hands back clean data. No scraping stack to babysit.</p>
          <a class="link-cta link-cta--on-teal" href="/agents">Explore the Agent Toolkit <span aria-hidden="true">&rarr;</span></a>
        </div>

        <div class="hv2-agent-right">
          <div class="mc-convo" aria-hidden="true">
            <header class="mc-convo-bar">
              <span class="mc-convo-mesh" aria-hidden="true">
                <span class="mc-convo-bubble" data-bubble="1"></span>
                <span class="mc-convo-bubble" data-bubble="2"></span>
                <span class="mc-convo-bubble" data-bubble="3"></span>
                <span class="mc-convo-bubble" data-bubble="4"></span>
              </span>
              <span class="mc-convo-dot"></span>
              <span class="mc-convo-dot"></span>
              <span class="mc-convo-dot"></span>
              <span class="mc-convo-name"><img decoding="async" class="mc-convo-ico" src="/_assets/brands/favicons/claude.com.png" alt="" width="15" height="15" aria-hidden="true" /><span>Claude Code</span> <span class="mc-convo-arrow">&#8596;</span> zenrows.mcp</span>
              <span class="mc-convo-status" data-status>idle</span>
            </header>
            <ol class="mc-convo-feed" data-feed></ol>
          </div>
        </div>
      </div>
    </section>

    <!-- ── Act 6: When the web fights back (unified pains + proof terminal) ── -->
        <section class="hv2-painpoints" data-act="painpoints" aria-labelledby="hv2-pp-h">
      <div class="hv2-pp-inner">
        <header class="hv2-pp-head">
          <h2 class="hv2-pp-h2" id="hv2-pp-h">When the web fights back, Zenrows keeps going.</h2>
          <div class="pp-run-row">
            <button class="pp-run" type="button" data-pp-run aria-label="Run Zenrows to handle every failure">
              <span class="pp-run-glyph" aria-hidden="true">&#9656;</span>
              <span class="pp-run-cmd">Run Zenrows</span>
              <span class="pp-run-caret" aria-hidden="true"></span>
              <span class="pp-run-done" aria-hidden="true">all handled</span>
            </button>
          </div>
        </header>
        <ol class="pp-seq" data-pp-seq role="list">
          <li class="pp-beat" data-pp-beat>
            <p class="pp-beat-line">Cloudflare blocked your request.</p>
            <p class="pp-fix">
              <span class="pp-fix-before">403 Forbidden</span>
              <span class="pp-fix-arrow" aria-hidden="true">&rarr;</span>
              <span class="pp-fix-after">200 OK</span>
            </p>
          </li>
          <li class="pp-beat" data-pp-beat>
            <p class="pp-beat-line">The page renders only after JavaScript.</p>
            <p class="pp-fix">
              <span class="pp-fix-before">&lt;div/&gt; empty</span>
              <span class="pp-fix-arrow" aria-hidden="true">&rarr;</span>
              <span class="pp-fix-after">DOM rendered</span>
            </p>
          </li>
          <li class="pp-beat" data-pp-beat>
            <p class="pp-beat-line">Your scraper broke when the site changed.</p>
            <p class="pp-fix">
              <span class="pp-fix-before">selector: null</span>
              <span class="pp-fix-arrow" aria-hidden="true">&rarr;</span>
              <span class="pp-fix-after">auto-adapted</span>
            </p>
          </li>
          <li class="pp-beat" data-pp-beat>
            <p class="pp-beat-line">50,000 URLs, and they are due tomorrow.</p>
            <p class="pp-fix">
              <span class="pp-fix-before">queued: 50,000</span>
              <span class="pp-fix-arrow" aria-hidden="true">&rarr;</span>
              <span class="pp-fix-after">done in 12 min</span>
            </p>
          </li>
        </ol>
      </div>
    </section>

