      <div class="hv2-closer-inner">
        <h2 class="hv2-closer-h2" id="hv2-closer-h">Get reliable web data in minutes.</h2>
        <p class="hv2-closer-sub">Free plan, 5,000 credits every month, no credit card required.</p>

        <div class="cta-stack cta-stack--center hv2-closer-cta">
          <a class="btn-marketing" href="https://app.zenrows.com/register">Start building free</a>
          <a class="link-cta link-cta--center" href="/contact/sales">Or talk to us about enterprise <span aria-hidden="true">&rarr;</span></a>
        </div>

        <!-- What is on screen IS the payload: the line below is a prompt to paste
             into an agent, not prose wrapped around a URL. It used to copy only the
             URL (a data-closer-value override), which left the reader holding a link
             and no instruction. The clipboard now gets the whole line. -->
        <figure class="hv2-closer-prompt" data-closer-copy role="button" tabindex="0" aria-label="Copy the setup prompt to your clipboard">
          <figcaption>
            <span data-closer-cap>Or copy this prompt into your agent</span>
            <svg class="hv2-closer-copy-ico" width="14" height="14" viewBox="0 0 16 16" fill="none" aria-hidden="true"><rect x="5" y="5" width="9" height="9" rx="2" stroke="currentColor" stroke-width="1.5"/><path d="M11 5V3a2 2 0 0 0-2-2H3a2 2 0 0 0-2 2v6a2 2 0 0 0 2 2h2" stroke="currentColor" stroke-width="1.5"/></svg>
          </figcaption>
          <pre><code data-closer-code>Read https://zenrows.com/SKILL.md to set up Zenrows.</code></pre>
        </figure>
      </div>

    </section>

