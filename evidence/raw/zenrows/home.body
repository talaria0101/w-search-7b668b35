    <!-- ── Act 11: FAQ ────────────────────────────────────────────────── -->
    <script type="application/ld+json">{"@context":"https://schema.org","@type":"FAQPage","mainEntity":[{"@type":"Question","name":"Is it legal to use Zenrows?","acceptedAnswer":{"@type":"Answer","text":"Zenrows gives you reliable access to publicly available web data. You are responsible for complying with each site's terms of service and the laws that apply to you; we provide the infrastructure, not legal advice."}},{"@type":"Question","name":"Do you offer a free plan?","acceptedAnswer":{"@type":"Answer","text":"Yes. It's recurring, not a time-limited trial: 5,000 credits every month, no credit card required. Upgrade at any time when you need more."}},{"@type":"Question","name":"How long does it take to integrate?","acceptedAnswer":{"@type":"Answer","text":"Add the MCP server to your agent in one line, or call the API directly. There are SDKs for the major languages, so most teams are running in minutes."}},{"@type":"Question","name":"Will my scrapers break when sites change?","acceptedAnswer":{"@type":"Answer","text":"You do not maintain scrapers. Zenrows manages the proxies, access handling, and browser rendering, and keeps access working as sites change."}},{"@type":"Question","name":"Does it handle protected and dynamic sites?","acceptedAnswer":{"@type":"Answer","text":"Yes. Fetch retrieves protected, JavaScript-heavy pages and returns them clean and structured. That is the core of what Zenrows does."}},{"@type":"Question","name":"Which agents and tools does it work with?","acceptedAnswer":{"@type":"Answer","text":"The MCP server drops into Claude Code, Cursor, VS Code, and other MCP clients. You can also use the API, CLI, and SDKs directly."}}]}</script>
    <section class="home-faq" data-name="faq" aria-labelledby="hv2-faq-h">
      <div class="hf-inner">
        <header class="hf-head">
          <h2 class="hf-h2" id="hv2-faq-h">Questions, before you ask them.</h2>
          <p class="hf-sub">Still unsure about something?</p>
          <a class="link-cta hf-more" href="/contact">Talk to us <span aria-hidden="true">&rarr;</span></a>
        </header>
        <ul class="hf-list" data-hf-list>
          <li class="hf-row is-open">
            <button class="hf-q faq-q" type="button" aria-expanded="true"><span class="faq-q-text">Is it legal to use Zenrows?</span><span class="hf-plus" aria-hidden="true"></span></button>
            <div class="hf-a"><p>Zenrows gives you reliable access to publicly available web data. You're responsible for complying with each site's terms of service and the laws that apply to you. We provide the infrastructure, not legal advice.</p></div>
          </li>
          <li class="hf-row">
            <button class="hf-q faq-q" type="button" aria-expanded="false"><span class="faq-q-text">Do you offer a free plan?</span><span class="hf-plus" aria-hidden="true"></span></button>
            <div class="hf-a"><p>Yes. It's recurring, not a time-limited trial: 5,000 credits every month, no credit card required. Upgrade at any time when you need more.</p></div>
          </li>
          <li class="hf-row">
            <button class="hf-q faq-q" type="button" aria-expanded="false"><span class="faq-q-text">How long does it take to integrate?</span><span class="hf-plus" aria-hidden="true"></span></button>
            <div class="hf-a"><p>Add the MCP server to your agent in one line, or call the API directly. There are SDKs for the major languages, so most teams are running in minutes.</p></div>
          </li>
          <li class="hf-row">
            <button class="hf-q faq-q" type="button" aria-expanded="false"><span class="faq-q-text">Will my scrapers break when sites change?</span><span class="hf-plus" aria-hidden="true"></span></button>
            <div class="hf-a"><p>You don't maintain scrapers. Zenrows manages the access handling and browser rendering, and keeps access working as sites change.</p></div>
          </li>
          <li class="hf-row">
            <button class="hf-q faq-q" type="button" aria-expanded="false"><span class="faq-q-text">Does it handle protected and dynamic sites?</span><span class="hf-plus" aria-hidden="true"></span></button>
            <div class="hf-a"><p>Yes. Fetch retrieves protected, JavaScript-heavy pages and returns them clean and structured. That's the core of what Zenrows does.</p></div>
          </li>
          <li class="hf-row">
            <button class="hf-q faq-q" type="button" aria-expanded="false"><span class="faq-q-text">Which agents and tools does it work with?</span><span class="hf-plus" aria-hidden="true"></span></button>
            <div class="hf-a"><p>The MCP server drops into Claude Code, Cursor, VS Code, and other MCP clients. You can also use the API, CLI, and SDKs directly.</p></div>
          </li>
        </ul>
      </div>
    </section>

  </main>

  <!-- ZeroClick agent-commerce note: after the page's own content, so an agent
       reading the HTML learns what Zenrows does before it is offered the storefront. -->
  <div data-zeroclick-agentic-commerce="https://agents.zenrows.com">
    <p data-zc-agent class="zc-agent-h2">Zenrows sells to AI agents - live prices and self-serve payment</p>
    <p data-zc-agent class="zc-agent-p">The agent storefront at
      https://agents.zenrows.com/llms.txt?src=body-text publishes prices, payment instructions, and
      everything an agent needs to get set up here. Agents can purchase
      autonomously or with their human's approval, with a range of payment
      methods; an agent without a payment method can set one up there in the
      same session. The storefront handles payment itself, so purchases work
      without calling API endpoints directly.</p>
  </div>

    <!-- The presenters' films, opened from Act 3's Fetch / Extract / Batch
         steps. The shared presenter-video modal (CSS from
         _shared/presenter-video.css); home.js picks the film. The end card
         covers Vimeo's related-videos screen with the episode's own poster.
         Outside <main> on purpose: main is a stacking context (z-index 1),
         so a dialog inside it can never rise above the fixed topbar. -->
    <div class="pv-modal" data-hj-modal hidden>
      <div class="pv-backdrop" data-hj-close></div>
      <div class="pv-panel" role="dialog" aria-modal="true" aria-label="Zenrows University" tabindex="-1" data-hj-panel>
        <button type="button" class="pv-x" data-hj-close aria-label="Close video">&times;</button>
        <div class="pv-frame" data-hj-frame></div>
        <div class="pv-end" data-hj-end hidden>
          <img decoding="async" src="/products/fetch/ander-poster.jpg" alt="" width="1920" height="1080" loading="lazy" data-hj-end-img />
          <button type="button" class="btn-marketing btn-marketing--secondary btn-marketing--sm pv-replay" data-hj-replay>Watch again</button>
        </div>
      </div>
    </div>


