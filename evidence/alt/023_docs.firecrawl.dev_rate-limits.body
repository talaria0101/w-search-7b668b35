179f06dc225.js?dpl=dpl_7rf4i96igkzVJFKccTPPbhZGNxyb\",\"/mintlify-assets/_next/static/chunks/1e7a188add93a653.js?dpl=dpl_7rf4i96igkzVJFKccTPPbhZGNxyb\"],\"IconMark\"]\n2d:[[\"$\",\"script\",null,{\"dangerouslySetInnerHTML\":{\"__html\":\"document.documentElement.setAttribute('data-page-mode', \\\"none\\\");\"}}],[\"$\",\"$L38\",null,{\"pageMetadata\":\"$26:props:pageMetadata\"}]]\n2e:[\"$\",\"$L39\",null,{\"pageMetadata\":\"$26:props:pageMetadata\"}]\n3b:T405a,"])</script><script>self.__next_f.push([1,"/* Style the Sign Up navbar link as an orange button */\nli.navbar-link a[href*=\"firecrawl.dev/signin\"] {\n    background-color: #ff4d00;\n    color: #fff;\n}\n\nli.navbar-link a[href*=\"firecrawl.dev/signin\"]:hover {\n    background-color: #e64500;\n}\n\n/* Dark mode adjustments */\n.dark li.navbar-link a[href*=\"firecrawl.dev/signin\"] {\n    background-color: #ff4d00;\n    color: #fff;\n}\n\n.dark li.navbar-link a[href*=\"firecrawl.dev/signin\"]:hover {\n    background-color: #e64500;\n}\n\n/* Move Sign Up button to the right */\nli.navbar-link:has(a[href*=\"firecrawl.dev/signin\"]) {\n    order: 99;\n}\n\n/* Move GitHub button to the left (before Status/Support) */\nnav ul li:has(a[href=\"https://github.com/firecrawl/firecrawl\"])\n{\n    order: -1;\n}\n\n/* Ready to Build CTA Widget Styles */\n#firecrawl-cta-widget {\n    margin-top: 24px;\n}\n\n.firecrawl-cta-box {\n    background: linear-gradient(180deg, rgba(255, 77, 0, 0.04) 0%, rgba(255, 77, 0, 0.02) 100%);\n    border: 1px solid rgba(255, 77, 0, 0.15);\n    border-radius: 12px;\n    padding: 20px;\n}\n\n.firecrawl-cta-logo {\n    height: 20px;\n    width: auto;\n    object-fit: contain;\n    margin-bottom: 12px;\n}\n\n.firecrawl-cta-logo-dark {\n    display: none;\n}\n\n.dark .firecrawl-cta-logo-light {\n    display: none;\n}\n\n.dark .firecrawl-cta-logo-dark {\n    display: block;\n}\n\n.firecrawl-cta-title {\n    font-size: 18px;\n    font-weight: 600;\n    color: #111;\n    margin: 0 0 8px 0;\n    line-height: 1.3;\n}\n\n.firecrawl-cta-description {\n    font-size: 13px;\n    line-height: 1.5;\n    color: #666;\n    margin: 0 0 16px 0;\n}\n\n.firecrawl-cta-description strong {\n    color: #333;\n}\n\n.firecrawl-cta-buttons {\n    display: flex;\n    flex-direction: column;\n    gap: 8px;\n}\n\n.firecrawl-cta-btn-primary {\n    display: block;\n    text-align: center;\n    background-color: #ff4d00;\n    color: #fff !important;\n    font-size: 14px;\n    font-weight: 500;\n    line-height: 1.5;\n    padding: 10px 16px;\n    border-radius: 16px;\n    /* Reset prose anchor styling (border-bottom shows as a stray underline\n       when the button is rendered inside MDX content) */\n    border: none !important;\n    box-shadow: none !important;\n    text-decoration: none !important;\n    transition: background-color 0.2s ease;\n}\n\n.firecrawl-cta-btn-primary:hover {\n    background-color: #e64500;\n    text-decoration: none !important;\n}\n\n/* Auto-width variant so a CTA button hugs its label instead of filling the box */\n.firecrawl-cta-btn-inline {\n    display: inline-block;\n}\n\n.firecrawl-cta-btn-secondary {\n    display: block;\n    text-align: center;\n    background-color: #fff;\n    color: #333 !important;\n    font-size: 14px;\n    font-weight: 500;\n    padding: 10px 16px;\n    border-radius: 16px;\n    border: 1px solid #e5e7eb;\n    text-decoration: none !important;\n    transition: border-color 0.2s ease, background-color 0.2s ease;\n}\n\n.firecrawl-cta-btn-secondary:hover {\n    background-color: #f9fafb;\n    border-color: #d1d5db;\n    text-decoration: none !important;\n}\n\n/* Dark mode styles for CTA */\n.dark .firecrawl-cta-box {\n    background: linear-gradient(180deg, rgba(255, 77, 0, 0.08) 0%, rgba(255, 77, 0, 0.04) 100%);\n    border-color: rgba(255, 77, 0, 0.2);\n}\n\n.dark .firecrawl-cta-title {\n    color: #fff;\n}\n\n.dark .firecrawl-cta-description {\n    color: #aaa;\n}\n\n.dark .firecrawl-cta-description strong {\n    color: #ddd;\n}\n\n.dark .firecrawl-cta-btn-primary {\n    background-color: #ff4d00;\n    color: #fff !important;\n}\n\n.dark .firecrawl-cta-btn-primary:hover {\n    background-color: #e64500;\n}\n\n.dark .firecrawl-cta-btn-secondary {\n    background-color: rgba(255, 255, 255, 0.05);\n    border-color: rgba(255, 255, 255, 0.1);\n    color: #ddd !important;\n}\n\n.dark .firecrawl-cta-btn-secondary:hover {\n    background-color: rgba(255, 255, 255, 0.1);\n    border-color: rgba(255, 255, 255, 0.2);\n}\n\n/* Hide CTA on mobile (right sidebar is typically hidden) */\n@media (max-width: 1024px) {\n    #firecrawl-cta-widget {\n        display: none;\n    }\n}\n\n/* \"For AI agents\" footer links: Mintlify caps each link at max-w-36 and\n   truncates on desktop (md:truncate), clipping labels like\n   \"Agent onboarding (SKILL.md)\". Show the full labels and let the row wrap. */\n#footer a.max-w-36 {\n    max-width: none;\n    overflow: visible;\n    text-overflow: clip;\n    white-space: nowrap;\n}\n\n#footer div:has(\u003e a.max-w-36) {\n    flex-wrap: wrap;\n}\n\n/* footer.socials has no chat key, so the community link uses `website` and\n   ships a globe. Footer social glyphs are mask-image only, so re-masking\n   swaps in the same comment-dots icon the sidebar Community entry uses. */\n#footer a[href*=\"community.firecrawl.dev\"] \u003e svg {\n    -webkit-mask-image: url(\"https://d3gk2c5xim1je2.cloudfront.net/fontawesome/v7.2.0/solid/comment-dots.svg\") !important;\n    mask-image: url(\"https://d3gk2c5xim1je2.cloudfront.net/fontawesome/v7.2.0/solid/comment-dots.svg\") !important;\n}\n\n/* Agent-first introduction components. Tokens mirror firecrawl-web. */\n.fc-agent-first,\n.fc-agent-prompt {\n    --fc-heat: #fa5d19;\n    --fc-heat-soft: rgba(250, 93, 25, 0.04);\n    --fc-text: #262626;\n    --fc-text-muted: rgba(38, 38, 38, 0.56);\n    --fc-surface: #fff;\n    --fc-subtle: rgba(0, 0, 0, 0.02);\n    --fc-subtle-hover: rgba(0, 0, 0, 0.06);\n    --fc-border: #ededed;\n    color: var(--fc-text);\n    font-family: inherit;\n}\n\n.dark .fc-agent-first,\n.dark .fc-agent-prompt {\n    --fc-heat-soft: rgba(250, 93, 25, 0.08);\n    --fc-text: #f5f5f5;\n    --fc-text-muted: rgba(255, 255, 255, 0.56);\n    --fc-surface: #171717;\n    --fc-subtle: rgba(255, 255, 255, 0.02);\n    --fc-subtle-hover: rgba(255, 255, 255, 0.08);\n    --fc-border: #2a2a2a;\n}\n\n.fc-agent-first {\n    position: relative;\n    margin: 20px 0 32px;\n    border: 1px solid var(--fc-border);\n    background: var(--fc-surface);\n}\n\n.fc-agent-first-header {\n    display: flex;\n    align-items: flex-start;\n    justify-content: space-between;\n    gap: 24px;\n    padding: 24px;\n}\n\n.fc-agent-first-header h3,\n.fc-client-panel h4 {\n    margin: 0;\n    color: var(--fc-text);\n    font-weight: 600;\n}\n\n.fc-agent-first-header h3 {\n    font-size: 20px;\n    line-height: 28px;\n}\n\n.fc-agent-first-header p,\n.fc-agent-first-header [data-as=\"p\"] {\n    display: block;\n    max-width: 600px;\n    margin: 6px 0 0;\n    color: var(--fc-text-muted);\n    font-size: 14px;\n    line-height: 20px;\n}\n\n.fc-all-options-link {\n    display: inline-flex;\n    flex: none;\n    align-items: center;\n    gap: 6px;\n    margin-top: 3px;\n    color: var(--fc-text-muted) !important;\n    font-size: 13px;\n    font-weight: 500;\n    text-decoration: none !important;\n    transition: color 160ms ease;\n}\n\n.fc-all-options-link:hover {\n    color: var(--fc-heat) !important;\n}\n\n.fc-client-tabs {\n    display: grid;\n    /* One row regardless of client count; equal-width columns. */\n    grid-auto-flow: column;\n    grid-auto-columns: minmax(0, 1fr);\n    overflow-x: auto;\n    border-top: 1px solid var(--fc-border);\n    border-bottom: 1px solid var(--fc-border);\n    scrollbar-width: thin;\n}\n\n.fc-client-tab {\n    position: relative;\n    display: flex;\n    min-width: 0;\n    overflow: hidden;\n    flex-direction: column;\n    align-items: center;\n    gap: 8px;\n    padding: 14px 10px;\n    border: 0;\n    border-right: 1px solid var(--fc-border);\n    background: transparent;\n    color: var(--fc-text);\n    cursor: pointer;\n    text-align: center;\n    transition: background-color 160ms ease;\n}\n\n.fc-client-tab:last-child {\n    border-right: 0;\n}\n\n.fc-client-tab:hover {\n    background: var(--fc-subtle);\n}\n\n.fc-client-tab.is-active {\n    background: var(--fc-heat-soft);\n    box-shadow: inset 0 2px 0 var(--fc-heat);\n}\n\n.fc-client-tab:focus-visible,\n.fc-copy-button:focus-visible,\n.fc-install-button:focus-visible,\n.fc-agent-prompt-button:focus-visible,\n.fc-all-options-link:focus-visible {\n    outline: 2px solid var(--fc-heat);\n    outline-offset: -2px;\n}\n\n.fc-client-icon {\n    display: block;\n    width: 26px;\n    height: 26px;\n    flex: none;\n    object-fit: contain;\n}\n\n.dark .fc-client-icon-mono {\n    filter: invert(1) brightness(1.6);\n}\n\n/* Keep monochrome marks legible outside the client selector in dark mode. */\n.dark img[src*=\"agent-clients/chatgpt.svg\"],\n.dark img[src*=\"agent-clients/cursor.svg\"] {\n    filter: invert(1) brightness(1.6);\n}\n\n.fc-client-tab-copy {\n    display: flex;\n    min-width: 0;\n    max-width: 100%;\n    flex-direction: column;\n    gap: 2px;\n}\n\n.fc-client-tab-copy strong {\n    overflow: hidden;\n    color: var(--fc-text);\n    font-size: 14px;\n    line-height: 20px;\n    text-overflow: ellipsis;\n    white-space: nowrap;\n}\n\n.fc-client-tab-copy \u003e span {\n    overflow: hidden;\n    color: var(--fc-text-muted);\n    font-size: 13px;\n    line-height: 18px;\n    text-overflow: ellipsis;\n    white-space: nowrap;\n}\n\n.fc-client-panel {\n    display: flex;\n    flex-direction: column;\n    gap: 14px;\n    padding: 20px 24px 24px;\n}\n\n.fc-client-panel[hidden] {\n    display: none;\n}\n\n.fc-client-description,\n.fc-client-description[data-as=\"p\"],\n.fc-client-hint,\n.fc-client-hint[data-as=\"p\"] {\n    display: block;\n    margin: 0;\n    color: var(--fc-text-muted);\n    font-size: 14px;\n    line-height: 21px;\n}\n\n.fc-client-hint,\n.fc-client-hint[data-as=\"p\"] {\n    font-size: 13px;\n    line-height: 20px;\n}\n\n.fc-client-description code,\n.fc-client-description[data-as=\"p\"] code,\n.fc-client-hint code,\n.fc-client-hint[data-as=\"p\"] code {\n    border-radius: 4px;\n    background: var(--fc-subtle-hover);\n    padding: 2px 5px;\n    color: var(--fc-text);\n    font-size: 0.92em;\n}\n\n.fc-code-block {\n    overflow: hidden;\n    border: 1px solid var(--fc-border);\n    border-radius: 6px;\n    background: var(--fc-subtle);\n}\n\n.fc-code-header {\n    display: flex;\n    min-height: 38px;\n    align-items: center;\n    justify-content: space-between;\n    gap: 12px;\n    padding: 5px 8px 5px 14px;\n    border-bottom: 1px solid var(--fc-border);\n    color: var(--fc-text-muted);\n    font-size: 12px;\n    font-weight: 500;\n}\n\n.fc-code-block pre {\n    margin: 0;\n    padding: 14px 16px;\n    overflow-x: auto;\n    background: transparent;\n    color: var(--fc-text);\n    font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;\n    font-size: 12.5px;\n    line-height: 20px;\n    white-space: pre-wrap;\n    overflow-wrap: anywhere;\n    word-break: break-word;\n}\n\n.fc-code-block pre code {\n    display: block;\n    white-space: inherit;\n    overflow-wrap: inherit;\n    word-break: inherit;\n}\n\n/* One-line command field: command scrolls under an edge fade, copy stays at the right */\n.fc-command-row {\n    display: flex;\n    align-items: center;\n    gap: 4px;\n    padding: 4px;\n    border: 1px solid var(--fc-border);\n    border-radius: 8px;\n    background: var(--fc-subtle);\n}\n\n.fc-command-scroll {\n    display: flex;\n    min-width: 0;\n    flex: 1;\n    align-items: center;\n    gap: 10px;\n    padding: 7px 6px 7px 12px;\n    overflow-x: auto;\n    scrollbar-width: none;\n    -webkit-mask-image: linear-gradient(90deg, #000 calc(100% - 24px), transparent);\n    mask-image: linear-gradient(90deg, #000 calc(100% - 24px), transparent);\n}\n\n.fc-command-scroll::-webkit-scrollbar {\n    display: none;\n}\n\n.fc-command-prompt {\n    flex: none;\n    color: var(--fc-text-muted);\n    font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;\n    font-size: 13px;\n    line-height: 20px;\n    user-select: none;\n}\n\n.fc-command-scroll code {\n    padding: 0 20px 0 0;\n    border: 0;\n    border-radius: 0;\n    background: transparent;\n    color: var(--fc-text);\n    font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;\n    font-size: 13px;\n    line-height: 20px;\n    white-space: nowrap;\n}\n\n.fc-copy-button {\n    display: inline-flex;\n    min-width: 78px;\n    height: 28px;\n    align-items: center;\n    justify-content: center;\n    gap: 6px;\n    padding: 0 9px;\n    border: 0;\n    border-radius: 6px;\n    background: transparent;\n    color: var(--fc-text-muted);\n    cursor: pointer;\n    font-size: 12px;\n    font-weight: 500;\n    transition: background-color 160ms ease, color 160ms ease;\n}\n\n.fc-copy-button:hover {\n    background: var(--fc-subtle-hover);\n    color: var(--fc-text);\n}\n\n.fc-copy-button.is-copied {\n    background: var(--fc-heat-soft);\n    color: var(--fc-heat);\n}\n\n.fc-install-button {\n    display: inline-flex;\n    width: fit-content;\n    min-height: 34px;\n    align-items: center;\n    justify-content: center;\n    gap: 7px;\n    padding: 0 12px;\n    border-radius: 6px;\n    background: var(--fc-subtle-hover);\n    color: var(--fc-text) !important;\n    font-size: 13px;\n    font-weight: 600;\n    text-decoration: none !important;\n    transition: background-color 160ms ease, transform 160ms ease;\n}\n\n.fc-install-button:hover {\n    background: var(--fc-heat-soft);\n}\n\n.fc-install-button:active,\n.fc-agent-prompt-button:active {\n    transform: scale(0.98);\n}\n\n.fc-agent-prompt {\n    margin: 14px 0 28px;\n}\n\n.fc-openai-install-actions {\n    display: flex;\n    flex-wrap: wrap;\n    gap: 12px;\n}\n\n.fc-openai-install-actions a {\n    text-decoration: none !important;\n    color: var(--fc-text) !important;\n}\n\n.fc-openai-install-actions img {\n    flex: none;\n    object-fit: contain;\n}\n\n.fc-openai-install-hint {\n    margin: 12px 0 0;\n    color: var(--fc-text-muted);\n    font-size: 13px;\n    line-height: 1.6;\n}\n\n.fc-agent-prompt-button {\n    display: inline-flex;\n    min-height: 44px;\n    align-items: center;\n    justify-content: center;\n    gap: 8px;\n    padding: 0 18px;\n    border: 0;\n    border-radius: 10px;\n    background: var(--fc-subtle-hover);\n    color: var(--fc-text);\n    cursor: pointer;\n    font-size: 14px;\n    font-weight: 600;\n    box-shadow: inset 0 0.75px 0.75px 0 rgba(0, 0, 0, 0.02),\n        inset 0 0.25px 0.25px 0 rgba(0, 0, 0, 0.04);\n    transition: background-color 160ms ease, color 160ms ease, transform 160ms ease;\n}\n\n.fc-agent-prompt-button:hover {\n    background: rgba(0, 0, 0, 0.08);\n}\n\n.dark .fc-agent-prompt-button:hover {\n    background: rgba(255, 255, 255, 0.1);\n}\n\n.fc-agent-prompt-button.is-copied {\n    background: var(--fc-heat-soft);\n    color: var(--fc-heat);\n    box-shadow: none;\n}\n\n.fc-agent-first-footer {\n    display: flex;\n    flex-direction: column;\n    gap: 10px;\n    padding: 16px 24px 20px;\n    border-top: 1px solid var(--fc-border);\n    background: var(--fc-subtle);\n}\n\n/* Pin Card cta rows to the card bottom so CTAs align across a CardGroup.\n   The card body wrapper is position: relative, so the cta anchors to it\n   absolutely, with bottom padding reserving its space in the flow. */\ndiv:has(\u003e a \u003e div.w-full \u003e div.mt-8) {\n    height: 100%;\n    padding-bottom: 60px;\n}\n\na \u003e div.w-full \u003e div.mt-8 {\n    position: absolute;\n    right: 24px;\n    bottom: 20px;\n    left: 24px;\n    margin-top: 0;\n}\n\n.fc-footer-lead,\n.fc-footer-lead[data-as=\"p\"] {\n    display: block;\n    margin: 0;\n    color: var(--fc-text);\n    font-size: 13px;\n    font-weight: 500;\n    line-height: 20px;\n}\n\n.fc-curvy-corners,\n.fc-curve {\n    pointer-events: none;\n}\n\n.fc-curve {\n    position: absolute;\n    z-index: 3;\n    width: 11px;\n    height: 11px;\n    fill: var(--fc-border);\n}\n\n.fc-curve-tl { top: 0; left: 0; transform: rotate(-90deg); }\n.fc-curve-tr { top: 0; right: 0; }\n.fc-curve-bl { bottom: 0; left: 0; transform: rotate(180deg); }\n.fc-curve-br { right: 0; bottom: 0; transform: rotate(90deg); }\n\n.fc-sr-only {\n    position: absolute;\n    width: 1px;\n    height: 1px;\n    overflow: hidden;\n    margin: -1px;\n    padding: 0;\n    border: 0;\n    clip: rect(0, 0, 0, 0);\n    white-space: nowrap;\n}\n\n@media (max-width: 700px) {\n    .fc-agent-first-header {\n        flex-direction: column;\n        gap: 12px;\n        padding: 20px;\n    }\n\n    .fc-client-tabs {\n        grid-auto-flow: row;\n        grid-template-columns: repeat(2, minmax(0, 1fr));\n    }\n\n    .fc-client-tab:nth-child(2n) {\n        border-right: 0;\n    }\n\n    .fc-client-tab {\n        border-bottom: 1px solid var(--fc-border);\n    }\n\n    .fc-client-tab:nth-last-child(-n + 2):nth-child(odd),\n    .fc-client-tab:last-child {\n        border-bottom: 0;\n    }\n\n    .fc-client-panel {\n        padding: 16px 20px 20px;\n    }\n\n    .fc-command-scroll code,\n    .fc-command-prompt {\n        font-size: 12px;\n    }\n\n    .fc-agent-first-footer {\n        padding: 14px 20px 18px;\n    }\n\n    .fc-install-button,\n    .fc-agent-prompt-button {\n        width: 100%;\n    }\n}\n\n@media (prefers-reduced-motion: reduce) {\n    .fc-agent-first *,\n    .fc-agent-prompt * {\n        scroll-behavior: auto !important;\n        transition-duration: 0.01ms !important;\n    }\n}\n"])</script><script>self.__next_f.push([1,"2f:[\"$\",\"$L3a\",null,{\"cssFiles\":[{\"_id\":\"692622ad4726034eb20d8ca1\",\"filePath\":\"style.css\",\"subdomain\":\"firecrawl\",\"__v\":0,\"content\":\"$3b\"}]}]\n3d:T937,"])</script><script>self.__next_f.push([1,"(function() {\n  // Wait for the DOM to be fully loaded\n  function injectCTA() {\n    // Find the table of contents content container (inside the right sidebar)\n    const tocContent = document.getElementById('table-of-contents-content');\n\n    // Check if CTA already exists to avoid duplicates\n    if (document.getElementById('firecrawl-cta-widget')) {\n      return;\n    }\n\n    if (tocContent) {\n      // Create the CTA container\n      const ctaWidget = document.createElement('div');\n      ctaWidget.id = 'firecrawl-cta-widget';\n      ctaWidget.innerHTML = `\n        \u003cdiv class=\"firecrawl-cta-box\"\u003e\n          \u003cimg src=\"/logo/light.svg\" alt=\"Firecrawl\" class=\"firecrawl-cta-logo firecrawl-cta-logo-light\" /\u003e\u003cimg src=\"/logo/dark.svg\" alt=\"Firecrawl\" class=\"firecrawl-cta-logo firecrawl-cta-logo-dark\" /\u003e\n          \u003ch3 class=\"firecrawl-cta-title\"\u003eReady to build?\u003c/h3\u003e\n          \u003cp class=\"firecrawl-cta-description\"\u003e\n            Start getting web data for free and scale seamlessly as your project expands. \u003cstrong\u003eNo credit card needed.\u003c/strong\u003e\n          \u003c/p\u003e\n          \u003cdiv class=\"firecrawl-cta-buttons\"\u003e\n            \u003ca href=\"https://www.firecrawl.dev/signin?utm_source=firecrawl_docs\u0026utm_medium=docs_card\u0026utm_content=start_for_free\" class=\"firecrawl-cta-btn-primary\"\u003eStart for free\u003c/a\u003e\n            \u003ca href=\"https://www.firecrawl.dev/pricing?utm_source=firecrawl_docs\u0026utm_medium=docs_card\u0026utm_content=see_our_plans\" class=\"firecrawl-cta-btn-secondary\"\u003eSee our plans\u003c/a\u003e\n          \u003c/div\u003e\n        \u003c/div\u003e\n      `;\n\n      // Append to the TOC content (at the bottom of \"On this page\")\n      tocContent.appendChild(ctaWidget);\n    }\n  }\n\n  // Run on initial load\n  if (document.readyState === 'loading') {\n    document.addEventListener('DOMContentLoaded', injectCTA);\n  } else {\n    injectCTA();\n  }\n\n  // Also run on navigation changes (for SPA behavior)\n  const observer = new MutationObserver(function() {\n    // Debounce the injection\n    clearTimeout(window.firecrawlCtaTimeout);\n    window.firecrawlCtaTimeout = setTimeout(injectCTA, 100);\n  });\n\n  // Start observing once DOM is ready\n  function startObserver() {\n    observer.observe(document.body, {\n      childList: true,\n      subtree: true\n    });\n  }\n\n  if (document.readyState === 'loading') {\n    document.addEventListener('DOMContentLoaded', startObserver);\n  } else {\n    startObserver();\n  }\n})();\n"])</script><script>self.__next_f.push([1,"30:[\"$\",\"$L3c\",null,{\"customJsDisabled\":false,\"jsFiles\":[{\"_id\":\"6984ecf0f9e80a68c43316de\",\"filePath\":\"ready-to-build-cta.js\",\"subdomain\":\"firecrawl\",\"__v\":0,\"content\":\"$3d\"},{\"_id\":\"6a6b9a09edaef26ce06d1c25\",\"subdomain\":\"firecrawl\",\"filePath\":\"chatbase-widget.js\",\"__v\":0,\"content\":\"(function(){if(!window.chatbase||window.chatbase(\\\"getState\\\")!==\\\"initialized\\\"){window.chatbase=(...arguments)=\u003e{if(!window.chatbase.q){window.chatbase.q=[]}window.chatbase.q.push(arguments)};window.chatbase=new Proxy(window.chatbase,{get(target,prop){if(prop===\\\"q\\\"){return target.q}return(...args)=\u003etarget(prop,...args)}})}const onLoad=function(){const script=document.createElement(\\\"script\\\");script.src=\\\"https://www.chatbase.co/embed.min.js\\\";script.id=\\\"vVaPFIXBBXF3EJYUdhgGF\\\";script.domain=\\\"www.chatbase.co\\\";document.body.appendChild(script)};if(document.readyState===\\\"complete\\\"){onLoad()}else{window.addEventListener(\\\"load\\\",onLoad)}})();\\n\"}]}]\n"])</script><script>self.__next_f.push([1,"40:T2f89,"])</script><script>self.__next_f.push([1,"\"use strict\";const{Fragment:_Fragment,jsx:_jsx,jsxs:_jsxs}=arguments[0];const{useMDXComponents:_provideComponents}=arguments[0];function _createMdxContent(props){const _components={a:`a`,code:`code`,li:`li`,p:`p`,strong:`strong`,ul:`ul`,..._provideComponents(),...props.components},{Heading}=_components;if(!Heading)_missingMdxReference(`Heading`,true);return _jsxs(_Fragment,{children:[_jsxs(_components.p,{children:[`Rate limits cap how many requests your team can make per minute, while concurrency limits cap how many jobs can run in parallel. Both are set by your plan; exceeding either returns a `,_jsx(_components.code,{children:`429`}),` response. See `,_jsx(_components.a,{href:`/api-reference/errors`,children:`Errors`}),` for the full error catalog and a retry-with-backoff snippet.`]}),`\n`,_jsx(Heading,{level:`2`,id:`concurrent-browser-limits`,children:`Concurrent Browser Limits`}),`\n`,_jsx(_components.p,{children:`Concurrent browsers control how many pages Firecrawl can process for you in parallel. Your plan sets the ceiling; any jobs beyond it wait in a queue until a browser frees up.`}),`\n`,_jsxs(_components.p,{children:[`Time spent in the queue counts against the request’s `,_jsx(_components.a,{href:`/advanced-scraping-guide#timing-and-cache`,children:_jsx(_components.code,{children:`timeout`})}),` parameter, so you can set a lower timeout to fail fast instead of waiting. To see current availability before sending work, call the `,_jsx(_components.a,{href:`/api-reference/endpoint/queue-status`,children:`Queue Status`}),` endpoint. Jobs that are waiting in your concurrency queue will time out after a maximum of 48 hours.`]}),`\n`,_jsx(Heading,{level:`3`,id:`current-plans`,children:`Current Plans`}),`\n`,_jsx(`div`,{style:{overflowX:`auto`,maxWidth:`100%`},children:_jsxs(`table`,{style:{width:`100%`,borderCollapse:`collapse`},children:[_jsx(`thead`,{children:_jsxs(`tr`,{children:[_jsx(`th`,{style:{padding:`8px 12px`,textAlign:`left`},children:`Plan`}),_jsx(`th`,{style:{padding:`8px 12px`},children:`Concurrent Browsers`}),_jsx(`th`,{style:{padding:`8px 12px`},children:`Max Queued Jobs`})]})}),_jsxs(`tbody`,{children:[_jsxs(`tr`,{children:[_jsx(`td`,{style:{padding:`8px 12px`},children:`Free`}),_jsx(`td`,{style:{padding:`8px 12px`},children:`2`}),_jsx(`td`,{style:{padding:`8px 12px`},children:`50,000`})]}),_jsxs(`tr`,{children:[_jsx(`td`,{style:{padding:`8px 12px`},children:`Hobby`}),_jsx(`td`,{style:{padding:`8px 12px`},children:`5`}),_jsx(`td`,{style:{padding:`8px 12px`},children:`50,000`})]}),_jsxs(`tr`,{children:[_jsx(`td`,{style:{padding:`8px 12px`},children:`Standard`}),_jsx(`td`,{style:{padding:`8px 12px`},children:`25`}),_jsx(`td`,{style:{padding:`8px 12px`},children:`50,000`})]}),_jsxs(`tr`,{children:[_jsx(`td`,{style:{padding:`8px 12px`},children:`Growth`}),_jsx(`td`,{style:{padding:`8px 12px`},children:`50`}),_jsx(`td`,{style:{padding:`8px 12px`},children:`100,000`})]}),_jsxs(`tr`,{children:[_jsx(`td`,{style:{padding:`8px 12px`},children:`Scale / Enterprise`}),_jsx(`td`,{style:{padding:`8px 12px`},children:`100+`}),_jsx(`td`,{style:{padding:`8px 12px`},children:`200,000+`})]})]})]})}),`\n`,_jsxs(_components.p,{children:[`Each team has a maximum number of jobs that can be waiting in the concurrency queue. If you exceed this limit, new jobs will be rejected with a `,_jsx(_components.code,{children:`429`}),` status code until existing jobs complete. For larger plans with custom concurrency limits, the max queued jobs is 2,000 times your concurrency limit, capped at 2,000,000.`]}),`\n`,_jsxs(_components.p,{children:[`If you require higher concurrency limits, `,_jsx(_components.a,{href:`https://firecrawl.dev/enterprise`,children:`contact us about enterprise plans`}),`.`]}),`\n`,_jsx(Heading,{level:`2`,id:`api-rate-limits`,children:`API Rate Limits`}),`\n`,_jsx(_components.p,{children:`Rate limits are measured in requests per minute and are primarily in place to prevent abuse. When configured correctly, your real bottleneck will be concurrent browsers. Rate limits are applied per team, so all API keys on the same team share the same rate limit counters.`}),`\n`,_jsx(Heading,{level:`3`,id:`keyless-no-api-key`,children:`Keyless (no API key)`}),`\n`,_jsxs(_components.p,{children:[`The hosted Firecrawl MCP keyless endpoint exposes exactly `,_jsx(_components.strong,{children:`Search, Scrape, and Parse`}),` without an API key. Other hosted MCP tools require an account connection or an API key.`]}),`\n`,_jsxs(_components.p,{children:[`For official Firecrawl clients, the CLI, SDKs, and REST API, keyless access also includes `,_jsx(_components.strong,{children:`Interact`}),`. On Firecrawl Cloud, research, developer, and government search endpoints can also be used without an API key. No other endpoints (crawl, extract, map, batch scrape, etc.) are available without a key.`]}),`\n`,_jsxs(_components.p,{children:[`Keyless usage is free and capped per IP address per day by `,_jsx(_components.strong,{children:`two limits`}),`, and exceeding either returns a `,_jsx(_components.code,{children:`429`}),`:`]}),`\n`,_jsxs(_components.ul,{children:[`\n`,_jsxs(_components.li,{children:[`A maximum number of `,_jsx(_components.strong,{children:`requests`}),` per day.`]}),`\n`,_jsxs(_components.li,{children:[`A maximum number of `,_jsx(_components.strong,{children:`credits`}),` per day. Operations cost different amounts of credits (for example, Interact and JSON extraction cost more than a basic scrape), so heavier usage reaches the credit cap sooner.`]}),`\n`]}),`\n`,_jsxs(_components.p,{children:[_jsx(_components.a,{href:`https://firecrawl.dev`,children:`Sign up for a free API key`}),` to get 1,000 credits and higher rate limits at no cost — official clients automatically use your key once it’s configured.`]}),`\n`,_jsx(Heading,{level:`3`,id:`current-plans-2`,children:`Current Plans`}),`\n`,_jsx(`div`,{style:{overflowX:`auto`,maxWidth:`100%`},children:_jsxs(`table`,{style:{width:`100%`,borderCollapse:`collapse`},children:[_jsx(`thead`,{children:_jsxs(`tr`,{children:[_jsx(`th`,{style:{padding:`8px 12px`,textAlign:`left`},childre