/script><span class="fixed inset-0 bg-background-light dark:bg-background-dark -z-10 pointer-events-none" id="background-color"></span><style data-custom-css-index="0" data-custom-css-path="style.css">/* Style the Sign Up navbar link as an orange button */
li.navbar-link a[href*="firecrawl.dev/signin"] {
    background-color: #ff4d00;
    color: #fff;
}

li.navbar-link a[href*="firecrawl.dev/signin"]:hover {
    background-color: #e64500;
}

/* Dark mode adjustments */
.dark li.navbar-link a[href*="firecrawl.dev/signin"] {
    background-color: #ff4d00;
    color: #fff;
}

.dark li.navbar-link a[href*="firecrawl.dev/signin"]:hover {
    background-color: #e64500;
}

/* Move Sign Up button to the right */
li.navbar-link:has(a[href*="firecrawl.dev/signin"]) {
    order: 99;
}

/* Move GitHub button to the left (before Status/Support) */
nav ul li:has(a[href="https://github.com/firecrawl/firecrawl"])
{
    order: -1;
}

/* Ready to Build CTA Widget Styles */
#firecrawl-cta-widget {
    margin-top: 24px;
}

.firecrawl-cta-box {
    background: linear-gradient(180deg, rgba(255, 77, 0, 0.04) 0%, rgba(255, 77, 0, 0.02) 100%);
    border: 1px solid rgba(255, 77, 0, 0.15);
    border-radius: 12px;
    padding: 20px;
}

.firecrawl-cta-logo {
    height: 20px;
    width: auto;
    object-fit: contain;
    margin-bottom: 12px;
}

.firecrawl-cta-logo-dark {
    display: none;
}

.dark .firecrawl-cta-logo-light {
    display: none;
}

.dark .firecrawl-cta-logo-dark {
    display: block;
}

.firecrawl-cta-title {
    font-size: 18px;
    font-weight: 600;
    color: #111;
    margin: 0 0 8px 0;
    line-height: 1.3;
}

.firecrawl-cta-description {
    font-size: 13px;
    line-height: 1.5;
    color: #666;
    margin: 0 0 16px 0;
}

.firecrawl-cta-description strong {
    color: #333;
}

.firecrawl-cta-buttons {
    display: flex;
    flex-direction: column;
    gap: 8px;
}

.firecrawl-cta-btn-primary {
    display: block;
    text-align: center;
    background-color: #ff4d00;
    color: #fff !important;
    font-size: 14px;
    font-weight: 500;
    line-height: 1.5;
    padding: 10px 16px;
    border-radius: 16px;
    /* Reset prose anchor styling (border-bottom shows as a stray underline
       when the button is rendered inside MDX content) */
    border: none !important;
    box-shadow: none !important;
    text-decoration: none !important;
    transition: background-color 0.2s ease;
}

.firecrawl-cta-btn-primary:hover {
    background-color: #e64500;
    text-decoration: none !important;
}

/* Auto-width variant so a CTA button hugs its label instead of filling the box */
.firecrawl-cta-btn-inline {
    display: inline-block;
}

.firecrawl-cta-btn-secondary {
    display: block;
    text-align: center;
    background-color: #fff;
    color: #333 !important;
    font-size: 14px;
    font-weight: 500;
    padding: 10px 16px;
    border-radius: 16px;
    border: 1px solid #e5e7eb;
    text-decoration: none !important;
    transition: border-color 0.2s ease, background-color 0.2s ease;
}

.firecrawl-cta-btn-secondary:hover {
    background-color: #f9fafb;
    border-color: #d1d5db;
    text-decoration: none !important;
}

/* Dark mode styles for CTA */
.dark .firecrawl-cta-box {
    background: linear-gradient(180deg, rgba(255, 77, 0, 0.08) 0%, rgba(255, 77, 0, 0.04) 100%);
    border-color: rgba(255, 77, 0, 0.2);
}

.dark .firecrawl-cta-title {
    color: #fff;
}

.dark .firecrawl-cta-description {
    color: #aaa;
}

.dark .firecrawl-cta-description strong {
    color: #ddd;
}

.dark .firecrawl-cta-btn-primary {
    background-color: #ff4d00;
    color: #fff !important;
}

.dark .firecrawl-cta-btn-primary:hover {
    background-color: #e64500;
}

.dark .firecrawl-cta-btn-secondary {
    background-color: rgba(255, 255, 255, 0.05);
    border-color: rgba(255, 255, 255, 0.1);
    color: #ddd !important;
}

.dark .firecrawl-cta-btn-secondary:hover {
    background-color: rgba(255, 255, 255, 0.1);
    border-color: rgba(255, 255, 255, 0.2);
}

/* Hide CTA on mobile (right sidebar is typically hidden) */
@media (max-width: 1024px) {
    #firecrawl-cta-widget {
        display: none;
    }
}

/* "For AI agents" footer links: Mintlify caps each link at max-w-36 and
   truncates on desktop (md:truncate), clipping labels like
   "Agent onboarding (SKILL.md)". Show the full labels and let the row wrap. */
#footer a.max-w-36 {
    max-width: none;
    overflow: visible;
    text-overflow: clip;
    white-space: nowrap;
}

#footer div:has(> a.max-w-36) {
    flex-wrap: wrap;
}

/* footer.socials has no chat key, so the community link uses `website` and
   ships a globe. Footer social glyphs are mask-image only, so re-masking
   swaps in the same comment-dots icon the sidebar Community entry uses. */
#footer a[href*="community.firecrawl.dev"] > svg {
    -webkit-mask-image: url("https://d3gk2c5xim1je2.cloudfront.net/fontawesome/v7.2.0/solid/comment-dots.svg") !important;
    mask-image: url("https://d3gk2c5xim1je2.cloudfront.net/fontawesome/v7.2.0/solid/comment-dots.svg") !important;
}

/* Agent-first introduction components. Tokens mirror firecrawl-web. */
.fc-agent-first,
.fc-agent-prompt {
    --fc-heat: #fa5d19;
    --fc-heat-soft: rgba(250, 93, 25, 0.04);
    --fc-text: #262626;
    --fc-text-muted: rgba(38, 38, 38, 0.56);
    --fc-surface: #fff;
    --fc-subtle: rgba(0, 0, 0, 0.02);
    --fc-subtle-hover: rgba(0, 0, 0, 0.06);
    --fc-border: #ededed;
    color: var(--fc-text);
    font-family: inherit;
}

.dark .fc-agent-first,
.dark .fc-agent-prompt {
    --fc-heat-soft: rgba(250, 93, 25, 0.08);
    --fc-text: #f5f5f5;
    --fc-text-muted: rgba(255, 255, 255, 0.56);
    --fc-surface: #171717;
    --fc-subtle: rgba(255, 255, 255, 0.02);
    --fc-subtle-hover: rgba(255, 255, 255, 0.08);
    --fc-border: #2a2a2a;
}

.fc-agent-first {
    position: relative;
    margin: 20px 0 32px;
    border: 1px solid var(--fc-border);
    background: var(--fc-surface);
}

.fc-agent-first-header {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 24px;
    padding: 24px;
}

.fc-agent-first-header h3,
.fc-client-panel h4 {
    margin: 0;
    color: var(--fc-text);
    font-weight: 600;
}

.fc-agent-first-header h3 {
    font-size: 20px;
    line-height: 28px;
}

.fc-agent-first-header p,
.fc-agent-first-header [data-as="p"] {
    display: block;
    max-width: 600px;
    margin: 6px 0 0;
    color: var(--fc-text-muted);
    font-size: 14px;
    line-height: 20px;
}

.fc-all-options-link {
    display: inline-flex;
    flex: none;
    align-items: center;
    gap: 6px;
    margin-top: 3px;
    color: var(--fc-text-muted) !important;
    font-size: 13px;
    font-weight: 500;
    text-decoration: none !important;
    transition: color 160ms ease;
}

.fc-all-options-link:hover {
    color: var(--fc-heat) !important;
}

.fc-client-tabs {
    display: grid;
    /* One row regardless of client count; equal-width columns. */
    grid-auto-flow: column;
    grid-auto-columns: minmax(0, 1fr);
    overflow-x: auto;
    border-top: 1px solid var(--fc-border);
    border-bottom: 1px solid var(--fc-border);
    scrollbar-width: thin;
}

.fc-client-tab {
    position: relative;
    display: flex;
    min-width: 0;
    overflow: hidden;
    flex-direction: column;
    align-items: center;
    gap: 8px;
    padding: 14px 10px;
    border: 0;
    border-right: 1px solid var(--fc-border);
    background: transparent;
    color: var(--fc-text);
    cursor: pointer;
    text-align: center;
    transition: background-color 160ms ease;
}

.fc-client-tab:last-child {
    border-right: 0;
}

.fc-client-tab:hover {
    background: var(--fc-subtle);
}

.fc-client-tab.is-active {
    background: var(--fc-heat-soft);
    box-shadow: inset 0 2px 0 var(--fc-heat);
}

.fc-client-tab:focus-visible,
.fc-copy-button:focus-visible,
.fc-install-button:focus-visible,
.fc-agent-prompt-button:focus-visible,
.fc-all-options-link:focus-visible {
    outline: 2px solid var(--fc-heat);
    outline-offset: -2px;
}

.fc-client-icon {
    display: block;
    width: 26px;
    height: 26px;
    flex: none;
    object-fit: contain;
}

.dark .fc-client-icon-mono {
    filter: invert(1) brightness(1.6);
}

/* Keep monochrome marks legible outside the client selector in dark mode. */
.dark img[src*="agent-clients/chatgpt.svg"],
.dark img[src*="agent-clients/cursor.svg"] {
    filter: invert(1) brightness(1.6);
}

.fc-client-tab-copy {
    display: flex;
    min-width: 0;
    max-width: 100%;
    flex-direction: column;
    gap: 2px;
}

.fc-client-tab-copy strong {
    overflow: hidden;
    color: var(--fc-text);
    font-size: 14px;
    line-height: 20px;
    text-overflow: ellipsis;
    white-space: nowrap;
}

.fc-client-tab-copy > span {
    overflow: hidden;
    color: var(--fc-text-muted);
    font-size: 13px;
    line-height: 18px;
    text-overflow: ellipsis;
    white-space: nowrap;
}

.fc-client-panel {
    display: flex;
    flex-direction: column;
    gap: 14px;
    padding: 20px 24px 24px;
}

.fc-client-panel[hidden] {
    display: none;
}

.fc-client-description,
.fc-client-description[data-as="p"],
.fc-client-hint,
.fc-client-hint[data-as="p"] {
    display: block;
    margin: 0;
    color: var(--fc-text-muted);
    font-size: 14px;
    line-height: 21px;
}

.fc-client-hint,
.fc-client-hint[data-as="p"] {
    font-size: 13px;
    line-height: 20px;
}

.fc-client-description code,
.fc-client-description[data-as="p"] code,
.fc-client-hint code,
.fc-client-hint[data-as="p"] code {
    border-radius: 4px;
    background: var(--fc-subtle-hover);
    padding: 2px 5px;
    color: var(--fc-text);
    font-size: 0.92em;
}

.fc-code-block {
    overflow: hidden;
    border: 1px solid var(--fc-border);
    border-radius: 6px;
    background: var(--fc-subtle);
}

.fc-code-header {
    display: flex;
    min-height: 38px;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    padding: 5px 8px 5px 14px;
    border-bottom: 1px solid var(--fc-border);
    color: var(--fc-text-muted);
    font-size: 12px;
    font-weight: 500;
}

.fc-code-block pre {
    margin: 0;
    padding: 14px 16px;
    overflow-x: auto;
    background: transparent;
    color: var(--fc-text);
    font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
    font-size: 12.5px;
    line-height: 20px;
    white-space: pre-wrap;
    overflow-wrap: anywhere;
    word-break: break-word;
}

.fc-code-block pre code {
    display: block;
    white-space: inherit;
    overflow-wrap: inherit;
    word-break: inherit;
}

/* One-line command field: command scrolls under an edge fade, copy stays at the right */
.fc-command-row {
    display: flex;
    align-items: center;
    gap: 4px;
    padding: 4px;
    border: 1px solid var(--fc-border);
    border-radius: 8px;
    background: var(--fc-subtle);
}

.fc-command-scroll {
    display: flex;
    min-width: 0;
    flex: 1;
    align-items: center;
    gap: 10px;
    padding: 7px 6px 7px 12px;
    overflow-x: auto;
    scrollbar-width: none;
    -webkit-mask-image: linear-gradient(90deg, #000 calc(100% - 24px), transparent);
    mask-image: linear-gradient(90deg, #000 calc(100% - 24px), transparent);
}

.fc-command-scroll::-webkit-scrollbar {
    display: none;
}

.fc-command-prompt {
    flex: none;
    color: var(--fc-text-muted);
    font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
    font-size: 13px;
    line-height: 20px;
    user-select: none;
}

.fc-command-scroll code {
    padding: 0 20px 0 0;
    border: 0;
    border-radius: 0;
    background: transparent;
    color: var(--fc-text);
    font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
    font-size: 13px;
    line-height: 20px;
    white-space: nowrap;
}

.fc-copy-button {
    display: inline-flex;
    min-width: 78px;
    height: 28px;
    align-items: center;
    justify-content: center;
    gap: 6px;
    padding: 0 9px;
    border: 0;
    border-radius: 6px;
    background: transparent;
    color: var(--fc-text-muted);
    cursor: pointer;
    font-size: 12px;
    font-weight: 500;
    transition: background-color 160ms ease, color 160ms ease;
}

.fc-copy-button:hover {
    background: var(--fc-subtle-hover);
    color: var(--fc-text);
}

.fc-copy-button.is-copied {
    background: var(--fc-heat-soft);
    color: var(--fc-heat);
}

.fc-install-button {
    display: inline-flex;
    width: fit-content;
    min-height: 34px;
    align-items: center;
    justify-content: center;
    gap: 7px;
    padding: 0 12px;
    border-radius: 6px;
    background: var(--fc-subtle-hover);
    color: var(--fc-text) !important;
    font-size: 13px;
    font-weight: 600;
    text-decoration: none !important;
    transition: background-color 160ms ease, transform 160ms ease;
}

.fc-install-button:hover {
    background: var(--fc-heat-soft);
}

.fc-install-button:active,
.fc-agent-prompt-button:active {
    transform: scale(0.98);
}

.fc-agent-prompt {
    margin: 14px 0 28px;
}

.fc-openai-install-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
}

.fc-openai-install-actions a {
    text-decoration: none !important;
    color: var(--fc-text) !important;
}

.fc-openai-install-actions img {
    flex: none;
    object-fit: contain;
}

.fc-openai-install-hint {
    margin: 12px 0 0;
    color: var(--fc-text-muted);
    font-size: 13px;
    line-height: 1.6;
}

.fc-agent-prompt-button {
    display: inline-flex;
    min-height: 44px;
    align-items: center;
    justify-content: center;
    gap: 8px;
    padding: 0 18px;
    border: 0;
    border-radius: 10px;
    background: var(--fc-subtle-hover);
    color: var(--fc-text);
    cursor: pointer;
    font-size: 14px;
    font-weight: 600;
    box-shadow: inset 0 0.75px 0.75px 0 rgba(0, 0, 0, 0.02),
        inset 0 0.25px 0.25px 0 rgba(0, 0, 0, 0.04);
    transition: background-color 160ms ease, color 160ms ease, transform 160ms ease;
}

.fc-agent-prompt-button:hover {
    background: rgba(0, 0, 0, 0.08);
}

.dark .fc-agent-prompt-button:hover {
    background: rgba(255, 255, 255, 0.1);
}

.fc-agent-prompt-button.is-copied {
    background: var(--fc-heat-soft);
    color: var(--fc-heat);
    box-shadow: none;
}

.fc-agent-first-footer {
    display: flex;
    flex-direction: column;
    gap: 10px;
    padding: 16px 24px 20px;
    border-top: 1px solid var(--fc-border);
    background: var(--fc-subtle);
}

/* Pin Card cta rows to the card bottom so CTAs align across a CardGroup.
   The card body wrapper is position: relative, so the cta anchors to it
   absolutely, with bottom padding reserving its space in the flow. */
div:has(> a > div.w-full > div.mt-8) {
    height: 100%;
    padding-bottom: 60px;
}

a > div.w-full > div.mt-8 {
    position: absolute;
    right: 24px;
    bottom: 20px;
    left: 24px;
    margin-top: 0;
}

.fc-footer-lead,
.fc-footer-lead[data-as="p"] {
    display: block;
    margin: 0;
    color: var(--fc-text);
    font-size: 13px;
    font-weight: 500;
    line-height: 20px;
}

.fc-curvy-corners,
.fc-curve {
    pointer-events: none;
}

.fc-curve {
    position: absolute;
    z-index: 3;
    width: 11px;
    height: 11px;
    fill: var(--fc-border);
}

.fc-curve-tl { top: 0; left: 0; transform: rotate(-90deg); }
.fc-curve-tr { top: 0; right: 0; }
.fc-curve-bl { bottom: 0; left: 0; transform: rotate(180deg); }
.fc-curve-br { right: 0; bottom: 0; transform: rotate(90deg); }

.fc-sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    margin: -1px;
    padding: 0;
    border: 0;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
}

@media (max-width: 700px) {
    .fc-agent-first-header {
        flex-direction: column;
        gap: 12px;
        padding: 20px;
    }

    .fc-client-tabs {
        grid-auto-flow: row;
        grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .fc-client-tab:nth-child(2n) {
        border-right: 0;
    }

    .fc-client-tab {
        border-bottom: 1px solid var(--fc-border);
    }

    .fc-client-tab:nth-last-child(-n + 2):nth-child(odd),
    .fc-client-tab:last-child {
        border-bottom: 0;
    }

    .fc-client-panel {
        padding: 16px 20px 20px;
    }

    .fc-command-scroll code,
    .fc-command-prompt {
        font-size: 12px;
    }

    .fc-agent-first-footer {
        padding: 14px 20px 18px;
    }

    .fc-install-button,
    .fc-agent-prompt-button {
        width: 100%;
    }
}

@media (prefers-reduced-motion: reduce) {
    .fc-agent-first *,
    .fc-agent-prompt * {
        scroll-behavior: auto !important;
        transition-duration: 0.01ms !important;
    }
}
</style><!--$--><!--/$--><div class="w-full"><main class="px-5 lg:pr-10 lg:pl-[5.5rem] lg:pt-10 mx-auto max-w-6xl flex flex-row-reverse gap-x-12 w-full pt-36 [[data-banner-state=visible]_&amp;]:pt-[calc(10rem+var(--banner-height,2.5rem))] [[data-banner-state=visible]_&amp;]:lg:pt-10" id="content-container"><div class="hidden xl:flex self-start sticky xl:flex-col max-w-[28rem] z-21 h-[calc(100vh-9.5rem)] top-[9.5rem] [[data-banner-state=visible]_&amp;]:h-[calc(100vh-15rem)] [[data-banner-state=visible]_&amp;]:top-[12rem]" id="content-side-layout"><div class="z-10 hidden xl:flex box-border max-h-full pl-10 w-[19rem]" id="table-of-contents-layout"><div role="presentation" style="position:relative;--scroll-area-corner-height:0px;--scroll-area-corner-width:0px" data-component-part="scroll-area" id="table-of-contents" class="min-w-0 text-gray-600 text-sm leading-6 w-[16.5rem] -mt-10"><div data-id="base-ui-_R_2mqqnpfb39p7b9snpfiutb_-viewport" tabindex="-1" class="size-full rounded-[inherit] [--scroll-area-fade-size:32px] pt-10 pb-4 base-ui-disable-scrollbar" style="overflow:scroll" data-component-part="scroll-area-viewport"><div role="presentation" style="min-width:fit-content" data-component-part="scroll-area-content" class="min-w-0! w-full space-y-2"><nav aria-labelledby="_R_mqqnpfb39p7b9snpfiutb_"><h2 id="_R_mqqnpfb39p7b9snpfiutb_" class="m-0 font-normal"><button type="button" class="text-gray-700 dark:text-gray-300 font-medium flex items-center space-x-2 hover:text-gray-900 dark:hover:text-gray-100 transition-colors cursor-pointer"><svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 18 18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" class="size-3 shrink-0"><path d="M2.75 14.25H15.25" stroke="currentColor" width="1.5" linecap="round" linejoin="round"></path><path d="M2.75 3.75H15.25" stroke="currentColor" width="1.5" linecap="round" linejoin="round"></path><path d="M2.75 9H8.25" stroke="currentColor" width="1.5" linecap="round" linejoin="round"></path></svg><span>On this page</span></button></h2><div><ul id="table-of-contents-content" class="toc"><li class="toc-item relative" data-depth="0"><a style="--toc-padding-left:1rem" href="#concurrent-browser-limits" class="break-words py-1 block pl-[calc(var(--toc-padding-left)+var(--toc-focus-padding,0rem))] focus-visible:[--toc-focus-padding:0.25rem] focus-visible:-ml-1 focus-visible:-outline-offset-2 font-medium border-l border-gray-950/5 dark:border-white/10 hover:border-gray-950/20 dark:hover:border-white/20 [[data-active]&gt;&amp;]:border-primary dark:[[data-active]&gt;&amp;]:border-primary-light [[data-active]&gt;&amp;:hover]:border-primary dark:[[data-active]&gt;&amp;:hover]:border-primary-light dark:text-gray-400 [li:not([data-active])&gt;&amp;:hover]:text-gray-900 dark:[li:not([data-active])&gt;&amp;:hover]:text-gray-300 [[data-active]&gt;&amp;]:text-primary dark:[[data-active]&gt;&amp;]:text-primary-light [[data-active]&gt;&amp;]:[text-shadow:-0.15px_0_0_currentColor,0.15px_0_0_currentColor]">Concurrent Browser Limits</a><ul class=""><li class="toc-item relative border-l pl-4 border-gray-950/5 dark:border-white/10 hover:border-gray-950/20 dark:hover:border-white/20 data-active:border-primary data-active:hover:border-primary dark:data-active:border-primary-light" data-depth="1"><a style="--toc-padding-left:1rem" href="#current-plans" class="group flex items-start break-words py-1 pl-[calc(var(--toc-padding-left)+var(--toc-focus-padding,0rem))] whitespace-pre-wrap focus-visible:[--toc-focus-padding:0.25rem] focus-visible:-ml-1 focus-visible:-outline-offset-2 text-gray-500 [li:not([data-active])&gt;&amp;:hover]:text-gray-900 dark:text-gray-400 dark:[li:not([data-active])&gt;&amp;:hover]:text-gray-300 [[data-active]&gt;&amp;]:text-primary dark:[[data-active]&gt;&amp;]:text-primary-light">Current Plans</a></li></ul></li><li class="toc-item relative" data-depth="0"><a style="--toc-padding