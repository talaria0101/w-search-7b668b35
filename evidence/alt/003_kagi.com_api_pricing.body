        <div class="onb_plan_price_box">
          <div class="onb_plan_price">
            <span class="onb_plan_price_monthly">$4</span>
            <span class="onb_plan_price_month">/1k pages</span>
          </div>

          <div class="onb_plan_desc">
            <ul class="onb_plan_features_list">
              <li>Pay only for what you use</li>
              <li>Extract up to 10 URLs per request</li>
              <li>Returns clean Markdown - ready for LLMs</li>
              <li>Configurable timeout</li>
              <li>JSON or Markdown response format</li>
            </ul>
          </div>
        </div>

