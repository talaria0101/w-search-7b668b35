nts.pre,{className:`shiki shiki-themes github-light-default dark-plus`,style:{backgroundColor:`#ffffff`,\"--shiki-dark-bg\":`#0B0C0E`,color:`#1f2328`,\"--shiki-dark\":`#D4D4D4`},language:`text`,children:_jsxs(_components.code,{language:`text`,numberOfLines:`3`,children:[_jsx(_components.span,{className:`line`,children:_jsx(_components.span,{children:`Name: Parallel Search MCP`})}),`\n`,_jsx(_components.span,{className:`line`,children:_jsx(_components.span,{children:`URL: https://search.parallel.ai/mcp`})}),`\n`,_jsx(_components.span,{className:`line`,children:_jsx(_components.span,{})})]})})}),`\n`,_jsxs(_components.p,{children:[`This URL connects anonymously. If you’d rather sign in with OAuth (so Claude manages the token for you), use `,_jsx(_components.code,{children:`https://search.parallel.ai/mcp-oauth`}),` instead — it triggers Claude’s OAuth sign-in flow.`]}),`\n`,_jsx(_components.p,{children:`If you are part of an organization, you may not have access to custom connectors. Contact your organization administrator for assistance.`}),`\n`,_jsxs(Tip,{children:[_jsxs(_components.p,{children:[_jsx(_components.strong,{children:`Org admins (Team / Enterprise plans):`}),` to route Claude’s web queries through the Parallel Search MCP instead of Claude’s built-in web search, disable the native web search tool at `,_jsx(_components.a,{href:`https://claude.ai/admin-settings/capabilities`,children:_jsx(_components.strong,{children:`Admin settings → Capabilities`})}),`. Once off at the workspace level, members cannot re-enable it individually. See the `,_jsx(_components.a,{href:`https://support.claude.com/en/articles/10684626-enabling-and-using-web-search`,children:`Claude web search docs`}),`.`]}),_jsxs(_components.p,{children:[`For the org-wide deployment, also point the connector at the `,_jsxs(_components.a,{href:`#installation`,children:[_jsx(_components.code,{children:`/mcp-oauth`}),` endpoint`]}),` (not `,_jsx(_components.code,{children:`/mcp`}),`) so every request requires a Parallel API key or OAuth — useful when you need every call attributed to the organization.`]})]}),`\n`,_jsxs(_components.p,{children:[`If you are not an admin, go to Settings → Developer → Edit Config and use the following JSON. If your config already has an `,_jsx(_components.code,{children:`mcpServers`}),` object, add the `,_jsx(_components.code,{children:`Parallel Search MCP`}),` entry inside it without replacing your other servers.`]}),`\n`,_jsx(CodeBlock,{filename:``,numberOfLines:`12`,language:`json`,children:_jsx(_components.pre,{className:`shiki shiki-themes github-light-default dark-plus`,style:{backgroundColor:`#ffffff`,\"--shiki-dark-bg\":`#0B0C0E`,color:`#1f2328`,\"--shiki-dark\":`#D4D4D4`},language:`json`,children:_jsxs(_components.code,{language:`json`,numberOfLines:`12`,children:[_jsx(_components.span,{className:`line`,children:_jsx(_components.span,{style:{color:`#1F2328`,\"--shiki-dark\":`#D4D4D4`},children:`{`})}),`\n`,_jsxs(_components.span,{className:`line`,children:[_jsx(_components.span,{style:{color:`#116329`,\"--shiki-dark\":`#9CDCFE`},children:`  \"mcpServers\"`}),_jsx(_components.span,{style:{color:`#1F2328`,\"--shiki-dark\":`#D4D4D4`},children:`: {`})]}),`\n`,_jsxs(_components.span,{className:`line`,children:[_jsx(_components.span,{style:{color:`#116329`,\"--shiki-dark\":`#9CDCFE`},children:`    \"Parallel Search MCP\"`}),_jsx(_components.span,{style:{color:`#1F2328`,\"--shiki-dark\":`#D4D4D4`},children:`: {`})]}),`\n`,_jsxs(_components.span,{className:`line`,children:[_jsx(_components.span,{style:{color:`#116329`,\"--shiki-dark\":`#9CDCFE`},children:`      \"command\"`}),_jsx(_components.span,{style:{color:`#1F2328`,\"--shiki-dark\":`#D4D4D4`},children:`: `}),_jsx(_components.span,{style:{color:`#0A3069`,\"--shiki-dark\":`#CE9178`},children:`\"npx\"`}),_jsx(_components.span,{style:{color:`#1F2328`,\"--shiki-dark\":`#D4D4D4`},children:`,`})]}),`\n`,_jsxs(_components.span,{className:`line`,children:[_jsx(_components.span,{style: