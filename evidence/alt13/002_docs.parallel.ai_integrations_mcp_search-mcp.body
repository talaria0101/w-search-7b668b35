ing installs and inits, or re-enables capture if torn down earlier\n   * this session. Revoking opts out then purges identity storage. If PostHog\n   * was never installed, this writes nothing at all.\n   */\n  function applyAnalytics(allowed, win, doc) {\n    var ph = win.posthog;\n    if (allowed) {\n      // Present as either a loaded instance or a queued stub: both accept\n      // these calls, the stub replaying them once array.js lands. Restore\n      // persistence in case a revoke earlier this session pinned it to memory.\n      if (ph) {\n        if (ph.opt_in_capturing) ph.opt_in_capturing();\n        if (ph.set_config) ph.set_config({ persistence: PERSISTENCE });\n        return;\n      }\n      installPostHogStub(doc, win);\n      // Mintlify is an SPA, so pageviews come from history events.\n      win.posthog.init(POSTHOG_KEY, {\n        api_host: POSTHOG_HOST,\n        defaults: \"2026-05-30\",\n        capture_pageview: \"history_change\",\n        capture_pageleave: true,\n        disable_session_recording: true,\n        persistence: PERSISTENCE,\n        autocapture: {\n          dom_event_allowlist: [\"click\", \"submit\"],\n          url_ignorelist: [],\n          element_allowlist: [\"button\", \"form\", \"input\"],\n          css_selector_allowlist: [\"[ph-autocapture]\", \"[data-attr]\"],\n          element_attribute_ignorelist: ['data-attr-pii=\"email\"'],\n        },\n      });\n      // A refusal from an earlier session persists in PostHog's own\n      // __ph_opt_in_out_\u003ckey\u003e marker, which the purge spares by design and\n      // which therefore survives a reload. init() alone would come up opted\n      // OUT even though consent was just granted, leaving analytics silently\n      // dead while pp_consent said yes. Opt in explicitly to clear it.\n      win.posthog.opt_in_capturing();\n      return;\n    }\n    if (!ph) return;\n    // Note this does NOT require __loaded. The snippet queues init and injects\n    // array.js asynchronously; a visitor who rejects in that window would\n    // otherwise be ignored, and the pending init would bring PostHog up with\n    // capture on despite the refusal. Both calls below queue on the stub and\n    // are replayed once array.js lands.\n    //\n    // Deliberately NOT posthog.reset(). Two traps:\n    //   1. the opt-out flag lives in persistence, and reset() clears\n    //      persistence, so opt_out then reset wipes the flag it just set.\n    //   2. reset() regenerates a device_id, leaving NEW identity storage\n    //      behind rather than clearing it.\n    // Instead: record the durable refusal, pin persistence to memory so a\n    // pending init cannot write cookies at all, then purge what exists.\n    if (ph.opt_out_capturing) ph.opt_out_capturing();\n    if (ph.set_config) ph.set_config({ persistence: \"memory\" });\n    purgePostHogStorage(win, doc);\n  }\n\n  /**\n   * Capture only under the current shared consent decision. Do not initialize\n   * another client or retain events from before consent. The existing SDK stub\n   * queues allowed calls while loading; missing/blocked analytics is a no-op.\n   */\n  function capture(event, properties, win, doc) {\n    try {\n      win = win || window;\n      doc = doc || document;\n      var allowed = decideSinks(readRegionFrom(doc.cookie), readConsentFrom(doc.cookie)).analytics;\n      if (!allowed || !win.posthog || typeof win.posthog.capture !== \"function\") return false;\n      win.posthog.capture(event, properties);\n      return true;\n    } catch (e) {\n      // Analytics must never interrupt a docs interaction.\n      return false;\n    }\n  }\n\n  // Layer 3b: banner UI. Not portable; parallel.ai keeps its React banner.\n  // The Marketing hint says \"across parallel.ai\" because docs fires no\n  // marketing tags itself and the toggle governs the shared cookie.\n\n  var PRIVACY_POLICY_URL = \"https://parallel.ai/privacy-policy\";\n\n  function el(doc, tag, className, text) {\n    var node = doc.createElement(tag);\n    if (className) node.className = className;\n    if (text) node.textContent = text;\n    return node;\n  }\n\n  function buildToggle(doc, label, checked) {\n    var btn = el(doc, \"button\", \"pw-consent__toggle\");\n    btn.type = \"button\";\n    btn.setAttribute(\"role\", \"switch\");\n    btn.setAttribute(\"aria-checked\", checked ? \"true\" : \"false\");\n    btn.setAttribute(\"aria-label\", label);\n    btn.appendChild(el(doc, \"span\", \"pw-consent__knob\"));\n    btn.addEventListener(\"click\", function () {\n      var next = btn.getAttribute(\"aria-checked\") !== \"true\";\n      btn.setAttribute(\"aria-checked\", next ? \"true\" : \"false\");\n    });\n    return btn;\n  }\n\n  function buildRow(doc, label, hint, toggle) {\n    var row = el(doc, \"div\", \"pw-consent__row\");\n    var left = el(doc, \"div\");\n    var name = el(doc, \"span\", \"pw-consent__label\", label);\n    name.appendChild(el(doc, \"span\", \"pw-consent__hint\", hint));\n    left.appendChild(name);\n    row.appendChild(left);\n    row.appendChild(toggle);\n    return row;\n  }\n\n  /** Presentational only: choices go out through handlers, state comes back\n   * through handlers.getEffective(), so toggles cannot drift from reality. */\n  function createBanner(doc, handlers) {\n    var root = el(doc, \"section\", \"pw-consent\");\n    root.setAttribute(\"role\", \"region\");\n    root.setAttribute(\"aria-label\", \"Cookie consent\");\n    root.setAttribute(\"data-visible\", \"false\");\n    root.style.display = \"none\";\n\n    var stack = el(doc, \"div\", \"pw-consent__stack\");\n    stack.appendChild(el(doc, \"h2\", \"pw-consent__title\", \"Your Privacy Choices\"));\n    stack.appendChild(el(doc, \"p\", \"pw-consent__body\",\n      \"We use cookies and similar technologies to run this site and, with \" +\n      \"your consent, to understand how it is used. Necessary cookies are \" +\n      \"always on. You can accept all, reject non-essential, or manage your \" +\n      \"choices. You can change your decision at any time.\"));\n\n    var links = el(doc, \"p\", \"pw-consent__body\");\n    var policy = el(doc, \"a\", null, \"Privacy Policy\");\n    policy.href = PRIVACY_POLICY_URL;\n    policy.rel = \"noopener\";\n    var manage = el(doc, \"button\", \"pw-consent__linkbtn\", \"Manage Preferences\");\n    manage.type = \"button\";\n    manage.setAttribute(\"aria-expanded\", \"false\");\n    links.appendChild(policy);\n    links.appendChild(doc.createTextNode(\" | \"));\n    links.appendChild(manage);\n    stack.appendChild(links);\n\n    var panel = el(doc, \"div\", \"pw-consent__panel\");\n    panel.setAttribute(\"data-expanded\", \"false\");\n\n    var essential = el(doc, \"span\", \"pw-consent__always\", \"Always on\");\n    panel.appendChild(buildRow(doc, \"Essential\",\n      \"Required for the site to function.\", essential));\n\n    var analyticsToggle = buildToggle(doc, \"Analytics\", false);\n    panel.appendChild(buildRow(doc, \"Analytics\",\n      \"Helps us understand how the site is used.\",\n      analyticsToggle));\n\n    var marketingToggle = buildToggle(doc, \"Marketing\", false);\n    panel.appendChild(buildRow(doc, \"Marketing\",\n      \"Used to measure and personalize advertising across parallel.ai.\",\n      marketingToggle));\n\n    var saveBtn = el(doc, \"button\", \"pw-consent__btn pw-consent__btn--save\", \"Save choices\");\n    saveBtn.type = \"button\";\n    saveBtn.addEventListener(\"click\", function () {\n      handlers.onSave({\n        analytics: analyticsToggle.getAttribute(\"aria-checked\") === \"true\",\n        marketing: marketingToggle.getAttribute(\"aria-checked\") === \"true\",\n      });\n    });\n    panel.appendChild(saveBtn);\n    stack.appendChild(panel);\n\n    manage.addEventListener(\"click\", function () {\n      var next = panel.getAttribute(\"data-expanded\") !== \"true\";\n      panel.setAttribute(\"data-expanded\", next ? \"true\" : \"false\");\n      manage.setAttribute(\"aria-expanded\", next ? \"true\" : \"false\");\n    });\n\n    var actions = el(doc, \"div\", \"pw-consent__actions\");\n    var acceptBtn = el(doc, \"button\", \"pw-consent__btn\", \"Accept all\");\n    acceptBtn.type = \"button\";\n    acceptBtn.addEventListener(\"click\", handlers.onAcceptAll);\n    var rejectBtn = el(doc, \"button\", \"pw-consent__btn\", \"Reject all\");\n    rejectBtn.type = \"button\";\n    rejectBtn.addEventListener(\"click\", handlers.onRejectAll);\n    actions.appendChild(acceptBtn);\n    actions.appendChild(rejectBtn);\n    stack.appendChild(actions);\n\n    root.appendChild(stack);\n\n    /**\n     * Reflect what is ACTUALLY running, not what was stored. They differ for\n     * an unregulated visitor who never chose: pp_consent is empty but both\n     * categories are live by default, so reading stored consent would show\n     * both toggles off while PostHog runs.\n     */\n    function syncToggles() {\n      var effective = handlers.getEffective();\n      analyticsToggle.setAttribute(\"aria-checked\",\n        effective \u0026\u0026 effective.analytics ? \"true\" : \"false\");\n      marketingToggle.setAttribute(\"aria-checked\",\n        effective \u0026\u0026 effective.marketing ? \"true\" : \"false\");\n    }\n\n    return {\n      element: root,\n      // Re-read committed state into the toggles. Used when consent changed\n      // outside this page; open() already syncs when coming into view.\n      refresh: syncToggles,\n      // `expanded` is optional. Passing it sets the panel state; omitting it\n      // leaves the panel as the visitor left it, which is how parallel.ai's\n      // banner behaves -- its openPreferences() only shows the banner and\n      // never touches the expanded flag.\n      open: function (expanded) {\n        // Re-sync only when coming INTO view: re-syncing an already-open\n        // panel would silently revert an in-progress toggle change.\n        if (root.getAttribute(\"data-visible\") !== \"true\") syncToggles();\n        if (expanded !== undefined) {\n          panel.setAttribute(\"data-expanded\", expanded ? \"true\" : \"false\");\n          manage.setAttribute(\"aria-expanded\", expanded ? \"true\" : \"false\");\n        }\n        root.style.display = \"\";\n        // Force a reflow so the transition runs from the hidden state.\n        void root.offsetHeight;\n        root.setAttribute(\"data-visible\", \"true\");\n      },\n      close: function () {\n        root.setAttribute(\"data-visible\", \"false\");\n        root.style.display = \"none\";\n      },\n    };\n  }\n\n  // Layer 3c: controller. Wires cookies -\u003e decision -\u003e sinks -\u003e UI.\n\n  var PREFERENCES_HASH = \"#cookie-preferences\";\n\n  function start(win, doc) {\n    // pp_region is READ-ONLY here. Docs has no server-side geo, and writing a\n    // guessed region would corrupt the decision on parallel.ai too.\n    var region = readRegionFrom(doc.cookie);\n    var banner = null;\n\n    // Read consent fresh every time rather than capturing it at startup. The\n    // cookie is shared with parallel.ai and with other tabs, so a value cached\n    // here goes stale the moment consent is revoked anywhere else, and this\n    // page would keep capturing until it happened to reload.\n    function plan() {\n      return decideSinks(region, readConsentFrom(doc.cookie));\n    }\n\n    /** Stable snapshot of the stored decision, for change detection. */\n    function consentSnapshot() {\n      var current = readConsentFrom(doc.cookie);\n      return current === null ? \"none\" : serializeConsent(current);\n    }\n\n    var lastSeen = consentSnapshot();\n\n    function applyPlan() {\n      applyAnalytics(plan().analytics, win, doc);\n    }\n\n    function commit(analytics, marketing) {\n      var state = {\n        analytics: analytics,\n        marketing: marketing,\n        v: CONSENT_VERSION,\n        ts: new Date().getTime(),\n      };\n      var secure = win.location.protocol === \"https:\";\n      var cookies = buildConsentCookies(state, win.location.hostname, secure);\n      for (var i = 0; i \u003c cookies.length; i++) doc.cookie = cookies[i];\n      // plan() re-reads the cookie, so a failed write (cookies disabled) simply\n      // reads back as no decision and the banner asks again next load.\n      lastSeen = consentSnapshot();\n      applyPlan();\n      if (banner) banner.close();\n      clearPreferencesHash();\n    }\n\n    banner = createBanner(doc, {\n      onAcceptAll: function () { commit(true, true); },\n      onRejectAll: function () { commit(false, false); },\n      onSave: function (choice) { commit(choice.analytics, choice.marketing); },\n      getEffective: function () { return plan(); },\n    });\n    doc.body.appendChild(banner.element);\n\n    applyPlan();\n    if (plan().showBanner) banner.open(false);\n\n    function openPreferences() {\n      // Show the banner without forcing the panel open, matching parallel.ai:\n      // the visitor clicks \"Manage Preferences\" to reveal the toggles. On a\n      // fresh load that means collapsed; if they expanded it earlier in the\n      // session it stays expanded.\n      banner.open();\n    }\n\n    /**\n     * Drop the fragment once the panel closes. Clicking a link to the\n     * fragment you are already on fires no hashchange, so leaving it set\n     * makes the next click a no-op; it also stops a URL copied afterwards\n     * from reopening the panel for whoever it is shared with.\n     */\n    function clearPreferencesHash() {\n      if (win.location.hash !== PREFERENCES_HASH) return;\n      if (!win.history || !win.history.replaceState) return;\n      win.history.replaceState(null, \"\", win.location.pathname + win.location.search);\n    }\n\n    // The footer link is declared in docs.json, so the trigger is the link\n    // and the fragment rather than a Mintlify DOM node -- nothing here breaks\n    // when their markup changes. Both bindings are needed: the hash alone does\n    // not survive repeat use (see clearPreferencesHash), and the click alone\n    // would miss someone arriving on /#cookie-preferences or via back/forward.\n    doc.addEventListener(\"click\", function (event) {\n      var target = event.target;\n      if (!target || !target.closest) return;\n      if (target.closest('a[href=\"' + PREFERENCES_HASH + '\"]')) openPreferences();\n    });\n\n    if (win.location.hash === PREFERENCES_HASH) openPreferences();\n    win.addEventListener(\"hashchange\", function () {\n      if (win.location.hash === PREFERENCES_HASH) openPreferences();\n    });\n\n    // Consent can change in another tab or on parallel.ai. Re-apply when this\n    // tab comes back to the foreground so a revocation takes effect without\n    // waiting for a navigation. The banner is never opened from here:\n    // appearing over what someone is reading would be worse than waiting for\n    // the next page load to prompt them.\n    //\n    // Only act on an ACTUAL change. Refreshing unconditionally would revert a\n    // toggle the visitor had flipped but not yet saved, every time they tabbed\n    // away and back. Refreshing on a real change is required though: stale\n    // toggles mean \"Save choices\" writes the values this page happened to be\n    // showing, silently overwriting the newer decision from the other tab.\n    doc.addEventListener(\"visibilitychange\", function () {\n      if (doc.hidden) return;\n      var current = consentSnapshot();\n      if (current === lastSeen) return;\n      lastSeen = current;\n      applyPlan();\n      banner.refresh();\n    });\n\n    return { openPreferences: openPreferences };\n  }\n\n  function autoInit() {\n    if (typeof document === \"undefined\" || typeof window === \"undefined\") return;\n    if (globalThis.__PARALLEL_CONSENT_NO_AUTOINIT) return;\n    try {\n      // Injected after the page is interactive, but guard in case that changes.\n      if (document.body) {\n        start(window, document);\n      } else {\n        document.addEventListener(\"DOMContentLoaded\", function () {\n          start(window, document);\n        });\n      }\n    } catch (e) {\n      // Never break Mintlify's SPA. Failing closed = no banner, no PostHog.\n      if (typeof console !== \"undefined\") console.warn(\"[consent] init failed\", e);\n    }\n  }\n\n  autoInit();\n\n  return {\n    CONSENT_VERSION: CONSENT_VERSION,\n    CONSENT_COOKIE: CONSENT_COOKIE,\n    REGION_COOKIE: REGION_COOKIE,\n    classifyRegion: classifyRegion,\n    parseConsent: parseConsent,\n    serializeConsent: serializeConsent,\n    decideSinks: decideSinks,\n    cookieDomainFor: cookieDomainFor,\n    readCookieFrom: readCookieFrom,\n    readConsentFrom: readConsentFrom,\n    readRegionFrom: readRegionFrom,\n    buildConsentCookies: buildConsentCookies,\n    applyAnalytics: applyAnalytics,\n    capture: capture,\n    createBanner: createBanner,\n    start: start,\n  };\n});\n"])</script><script>self.__next_f.push([1,"56:[\"$\",\"$L5c\",null,{\"customJsDisabled\":false,\"jsFiles\":[{\"_id\":\"6a8deb11b98f9ef4395bca7a\",\"filePath\":\"consent.js\",\"subdomain\":\"parallel-6fabab31-mtje7p526we\",\"__v\":0,\"content\":\"$5d\"}]}]\n60:T1d94f,"])</script><script>self.__next_f.push([1,"\"use strict\";const{Fragment:_Fragment,jsx:_jsx,jsxs:_jsxs}=arguments[0];const{useMDXComponents:_provideComponents}=arguments[0];function _createMdxContent(props){const _components={a:`a`,code:`code`,hr:`hr`,li:`li`,ol:`ol`,p:`p`,pre:`pre`,span:`span`,strong:`strong`,tbody:`tbody`,td:`td`,th:`th`,thead:`thead`,tr:`tr`,ul:`ul`,..._provideComponents(),...props.components},{Accordion,AccordionGroup,Card,CardGroup,CodeBlock,CodeGroup,Heading,Note,Table,Tip,Warning}=_components;if(!Accordion)_missingMdxReference(`Accordion`,true);if(!AccordionGroup)_missingMdxReference(`AccordionGroup`,true);if(!Card)_missingMdxReference(`Card`,true);if(!CardGroup)_missingMdxReference(`CardGroup`,true);if(!CodeBlock)_missingMdxReference(`CodeBlock`,true);if(!CodeGroup)_missingMdxReference(`CodeGroup`,true);if(!Heading)_missingMdxReference(`Heading`,true);if(!Note)_missingMdxReference(`Note`,true);if(!Table)_missingMdxReference(`Table`,true);if(!Tip)_missingMdxReference(`Tip`,true);if(!Warning)_missingMdxReference(`Warning`,true);return _jsxs(_Fragment,{children:[_jsxs(`div`,{className:`mint-sr-only`,\"aria-hidden\":`false`,children:[_jsxs(_components.p,{children:[`For AI agents: a documentation index is available at `,_jsx(_components.a,{href:`https://docs.parallel.ai/llms.txt`,children:`https://docs.parallel.ai/llms.txt`}),`. The full text of all docs is at `,_jsx(_components.a,{href:`https://docs.parallel.ai/llms-full.txt`,children:`https://docs.parallel.ai/llms-full.txt`}),`. You may also fetch any page as Markdown by appending `,_jsx(_components.code,{children:`.md`}),` to its URL or sending `,_jsx(_components.code,{children:`Accept: text/markdown`}),`.`]}),_jsxs(_components.p,{children:[`For Search and Extract, use `,_jsx(_components.code,{children:`/v1/search`}),` and `,_jsx(_components.code,{children:`/v1/extract`}),` for all new integrations and agent tool calls. Use `,_jsx(_components.code,{children:`/v1beta/search`}),` and `,_jsx(_components.code,{children:`/v1beta/extract`}),` only when maintaining an existing integration that already uses them. The request bodies changed too: on `,_jsx(_components.code,{children:`/v1/extract`}),`, `,_jsx(_components.code,{children:`full_content`}),`, `,_jsx(_components.code,{children:`fetch_policy`}),` and `,_jsx(_components.code,{children:`excerpt_settings`}),` go inside `,_jsx(_components.code,{children:`advanced_settings`}),`, and sending the v1beta top-level `,_jsx(_components.code,{children:`excerpts`}),`, `,_jsx(_components.code,{children:`full_content`}),` and `,_jsx(_components.code,{children:`fetch_policy`}),` to `,_jsx(_components.code,{children:`/v1/extract`}),` returns a 422. Do not substitute `,_jsx(_components.code,{children:`/v1`}),` for the documented FindAll or Ingest endpoint paths.`]})]}),`\n`,_jsxs(_components.p,{children:[`The Parallel Search MCP Server provides drop-in web search and content extraction capabilities for any MCP-aware model. The tools invoke the `,_jsx(_components.a,{href:`/search/search-quickstart`,children:`Search API`}),` and `,_jsx(_components.a,{href:`/extract/extract-quickstart`,children:`Extract API`}),` endpoints but present a simpler interface to ensure effective use by agents. Anonymous free-tier searches run in `,_jsxs(_components.a,{href:`/search/modes`,children:[_jsx(_components.code,{children:`fast`}),` mode`]}),` by default, providing high-quality, sub-second search for agent loops. Total excerpts per tool call are capped to roughly 25,000 characters to stay within typical MCP client output limits. Authenticated clients can `,_jsx(_components.a,{href:`#configure-search-behavior`,children:`configure the search behavior`}),`.`]}),`\n`,_jsx(Tip,{children:_jsxs(_components.p,{children:[_jsx(_components.strong,{children:`The Search MCP is free to use`}),` — no API key required, great for exploration and light use. For production use cases or higher rate limits, `,_jsx(_components.a,{href:`https://platform.parallel.ai`,children:`create a Parallel account`}),` and pass your API key as a Bearer token in the `,_jsx(_components.code,{children:`Authorization`}),` header.`]})}),`\n`,_jsx(_components.p,{children:`The Search MCP comprises two tools:`}),`\n`,_jsxs(_components.ul,{children:[`\n`,_jsxs(_components.li,{children:[_jsx(_components.strong,{children:_jsx(_components.code,{children:`web_search`})}),` — General-purpose web search inside an agent’s reasoning loop. Use when the agent needs current information or diverse sources across multiple angles.`]}),`\n`,_jsxs(_components.li,{children:[_jsx(_components.strong,{children:_jsx(_components.code,{children:`web_fetch`})}),` — Pulls token-efficient markdown from specific URLs. Use after `,_jsx(_components.code,{children:`web_search`}),` narrows down candidates, or when the agent already has a URL it needs to read in depth.`]}),`\n`]}),`\n`,_jsx(Heading,{level:`2`,id:`install`,children:`Install`}),`\n`,_jsx(_components.p,{children:`Add the Search MCP to Claude Code or Codex with one command:`}),`\n`,_jsxs(CodeGroup,{children:[_jsx(CodeBlock,{filename:`Claude Code`,numberOfLines:`1`,language:`shellscript`,children:_jsx(_components.pre,{className:`shiki shiki-themes github-light-default dark-plus`,style:{backgroundColor:`#ffffff`,\"--shiki-dark-bg\":`#0B0C0E`,color:`#1f2328`,\"--shiki-dark\":`#D4D4D4`},language:`shellscript`,children:_jsxs(_components.code,{language:`shellscript`,numberOfLines:`1`,children:[_jsxs(_components.span,{className:`line`,children:[_jsx(_components.span,{style:{color:`#953800`,\"--shiki-dark\":`#DCDCAA`},children:`claude`}),_jsx(_components.span,{style:{color:`#0A3069`,\"--shiki-dark\":`#CE9178`},children:` mcp`}),_jsx(_components.span,{style:{color:`#0A3069`,\"--shiki-dark\":`#CE9178`},children:` add`}),_jsx(_components.span,{style:{color:`#0550AE`,\"--shiki-dark\":`#569CD6`},children:` --transport`}),_jsx(_components.span,{style:{color:`#0A3069`,\"--shiki-dark\":`#CE9178`},children:` http`}),_jsx(_components.span,{style:{color:`#0A3069`,\"--shiki-dark\":`#CE9178`},children:` \"Parallel-Search-MCP\"`}),_jsx(_components.span,{style:{color:`#0A3069`,\"--shiki-dark\":`#CE9178`},children:` https://search.parallel.ai/mcp`})]}),`\n`]})})}),_jsx(CodeBlock,{filename:`Codex`,numberOfLines:`1`,language:`shellscript`,children:_jsx(_components.pre,{className:`shiki shiki-themes github-light-default dark-plus`,style:{backgroundColor:`#ffffff`,\"--shiki-dark-bg\":`#0B0C0E`,color:`#1f2328`,\"--shiki-dark\":`#D4D4D4`},language:`shellscript`,children:_jsxs(_components.code,{language:`shellscript`,numberOfLines:`1`,children:[_jsxs(_components.span,{className:`line`,children:[_jsx(_components.span,{style:{color:`#953800`,\"--shiki-dark\":`#DCDCAA`},children:`codex`}),_jsx(_components.span,{style:{color:`#0A3069`,\"--shiki-dark\":`#CE9178`},children:` mcp`}),_jsx(_components.span,{style:{color:`#0A3069`,\"--shiki-dark\":`#CE9178`},children:` add`}),_jsx(_components.span,{style:{color:`#0A3069`,\"--shiki-dark\":`#CE9178`},children:` parallel-search`}),_jsx(_components.span,{style:{color:`#0550AE`,\"--shiki-dark\":`#569CD6`},children:` --url`}),_jsx(_components.span,{style:{color:`#0A3069`,\"--shiki-dark\":`#CE9178`},children:` https://search.parallel.ai/mcp`})]}),`\n`]})})})]}),`\n`,_jsx(_components.p,{children:`Or add it in one click:`}),`\n`,_jsxs(CardGroup,{cols:2,children:[_jsx(Card,{title:`Add to Claude`,icon:`message`,href:`https://claude.com/marketplace/connectors/parallel-search`,children:_jsx(_components.p,{children:`Claude.ai and Claude Desktop connector.`})}),_jsx(Card,{title:`Add to ChatGPT`,icon:`comments`,href:`https://chatgpt.com/plugins/plugin_asdk_app_69fb9378663481919a68e8a2109644e5`,children:_jsx(_components.p,{children:`ChatGPT app.`})}),_jsx(Card,{title:`Add to Cursor`,icon:`arrow-pointer`,href:`https://cursor.com/en/install-mcp?name=Parallel%20Search%20MCP\u0026config=eyJ1cmwiOiJodHRwczovL3NlYXJjaC5wYXJhbGxlbC5haS9tY3AifQ==`,children:_jsx(_components.p,{children:`One-click install for Cursor.`})}),_jsx(Card,{title:`Add to VS Code`,icon:`code`,href:`https://insiders.vscode.dev/redirect/mcp/install?name=Parallel%20Search%20MCP\u0026config=%7B%22type%22%3A%22http%22%2C%22url%22%3A%22https%3A%2F%2Fsearch.parallel.ai%2Fmcp%22%7D`,children:_jsx(_components.p,{children:`One-click install for VS Code.`})})]}),`\n`,_jsxs(_components.p,{children:[`For API keys, OAuth, and other clients such as Gemini CLI, Windsurf, and Zed, see `,_jsx(_components.a,{href:`#installation`,children:`Installation`}),`.`]}),`\n`,_jsx(Heading,{level:`2`,id:`use-cases`,children:`Use Cases`}),`\n`,_jsx(_components.p,{children:`The Search MCP is suited for any application where real-world information is needed as part of an AI agent’s reasoning loop. Common use cases include:`}),`\n`,_jsxs(_components.ul,{children:[`\n`,_jsx(_components.li,{children:`Real-time fact checking and verification during conversations`}),`\n`,_jsx(_components.li,{children:`Gathering current information to answer user questions`}),`\n`,_jsx(_components.li,{children:`Researching topics that require recent or live data`}),`\n`,_jsx(_components.li,{children:`Retrieving content from specific URLs to analyze or summarize`}),`\n`,_jsx(_components.li,{children:`Competitive intelligence and market research`}),`\n`]}),`\n`,_jsx(Heading,{level:`2`,id:`configure-search-behavior`,children:`Configure search behavior`}),`\n`,_jsxs(_components.p,{children:[`The Search MCP has two configuration layers: model-visible arguments selected for each tool call, and authenticated connection-level overrides that apply to every `,_jsx(_components.code,{children:`web_search`}),` call.`]}),`\n`,_jsx(Heading,{level:`3`,id:`per-call-tool-parameters`,children:`Per-call tool parameters`}),`\n`,_jsxs(_components.p,{children:[`These arguments are returned by the server’s `,_jsx(_components.code,{children:`tools/list`}),` response and supplied on individual tool calls.`]}),`\n`,_jsx(Heading,{level:`4`,id:`web_search`,children:_jsx(_components.code,{children:`web_search`})}),`\n`,_jsxs(Table,{children:[_jsx(_components.thead,{children:_jsxs(_components.tr,{children:[_jsx(_components.th,{children:`Parameter`}),_jsx(_components.th,{children:`Type`}),_jsx(_components.th,{children:`Required`}),_jsx(_components.th,{children:`Description`})]})}),_jsxs(_components.tbody,{children:[_jsxs(_components.tr,{children:[_jsx(_components.td,{children:_jsx(_components.code,{children:`objective`})}),_jsx(_components.td,{children:`string`}),_jsx(_components.td,{children:`Yes`}),_jsx(_components.td,{children:`A natural-language description of the information to find. Keep it focused on one goal; it can include preferred sources or freshness requirements.`})]}),_jsxs(_components.tr,{children:[_jsx(_components.td,{children:_jsx(_components.code,{children:`search_queries`})}),_jsx(_components.td,{children:`string[]`}),_jsx(_components.td,{children:`Yes`}),_jsx(_components.td,{children:`Concise, related keyword queries of 3–6 words each. At least one is required; 2–3 diverse queries are recommended. Search operators are supported.`})]}),_jsxs(_components.tr,{children:[_jsx(_components.td,{children:_jsx(_components.code,{children:`session_id`})}),_jsx(_components.td,{children:`string`}),_jsx(_components.td,{children:`No`}),_jsxs(_components.td,{children:[`A stable identifier for the current conversation, up to 100 characters. Generate a UUID or 32+ character hex string once and reuse it across related `,_jsx(_components.code,{children:`web_search`}),` and `,_jsx(_components.code,{children:`web_fetch`}),` calls. It is used for free-tier rate limiting and log correlation, and is ignored for rate limiting on paid-tier keys.`]})]}),_jsxs(_components.tr,{children:[_jsx(_components.td,{children:_jsx(_components.code,{children:`model_name`})}),_jsx(_components.td,{children:`string`}),_jsx(_components.td,{children:`No`}),_jsx(_components.td,{children:`The exact model identifier, up to 100 characters, read from trusted runtime or client configuration. It is used only for product analytics and does not affect search behavior.`})]})]})]}),`\n`,_jsx(Heading,{level:`4`,id:`web_fetch`,children:_jsx(_components.code,{children:`web_fetch`})}),`\n`,_jsxs(Table,{children:[_jsx(_components.thead,{children:_jsxs(_components.tr,{children:[_jsx(_components.th,{children:`Parameter`}),_jsx(_components.th,{children:`Type`}),_jsx(_components.th,{children:`Required`}),_jsx(_components.th,{children:`Default`}),_jsx(_components.th,{children:`Description`})]})}),_jsxs(_components.tbody,{children:[_jsxs(_components.tr,{children:[_jsx(_components.td,{children:_jsx(_components.code,{children:`urls`})}),_jsx(_components.td,{children:`string[]`}),_jsx(_components.td,{children:`Yes`}),_jsx(_components.td,{children:`—`}),_jsx(_components.td,{children:`Valid HTTP or HTTPS URLs to extract, up to 20 per request.`})]}),_jsxs(_components.tr,{children:[_jsx(_components.td,{children:_jsx(_components.code,{children:`objective`})}),_jsx(_components.td,{children:`string`}),_jsx(_components.td,{children:`No`}),_jsx(_components.td,{children:_jsx(_components.code,{children:`null`})}),_jsx(_components.td,{children:`A natural-language description of the information to find in the pages, limited to 200 characters.`})]}),_jsxs(_components.tr,{children:[_jsx(_components.td,{children:_jsx(_components.code,{children:`search_queries`})}),_jsx(_components.td,{children:`string[]`}),_jsx(_components.td,{children:`No`}),_jsx(_components.td,{children:_jsx(_components.code,{children:`null`})}),_jsxs(_components.td,{children:[`Keyword queries of 3–6 words each that help focus the excerpts. When fetching results from `,_jsx(_components.code,{children:`web_search`}),`, pass the queries used to find those URLs.`]})]}),_jsxs(_components.tr,{children:[_jsx(_components.td,{children:_jsx(_components.code,{children:`full_content`})}),_jsx(_components.td,{children:`boolean`}),_jsx(_components.td,{children:`No`}),_jsx(_components.td,{children:_jsx(_components.code,{children:`false`})}),_jsx(_components.td,{children:`Return complete page markdown in addition to excerpts. Prefer excerpt mode unless the complete document is required; full content can be tens of thousands of tokens and may exceed the MCP client’s output limit.`})]}),_jsxs(_components.tr,{children:[_jsx(_components.td,{children:_jsx(_components.code,{children:`session_id`})}),_jsx(_components.td,{children:`string`}),_jsx(_components.td,{children:`No`}),_jsx(_components.td,{children:`—`}),_jsxs(_components.td,{children:[`A stable identifier for the current conversation, up to 100 characters. Reuse the same value across related `,_jsx(_components.code,{children:`web_search`}),` and `,_jsx(_components.code,{children:`web_fetch`}),` calls. It is used for free-tier rate limiting and log correlation, and is ignored for rate limiting on paid-tier keys.`]})]}),_jsxs(_components.tr,{children:[_jsx(_components.td,{children:_jsx(_components.code,{children:`model_name`})}),_jsx(_components.td,{children:`string`}),_jsx(_components.td,{children:`No`}),_jsx(_components.td,{children:`—`}),_jsx(_components.td,{children:`The exact model identifier, up to 100 characters, read from trusted runtime or client configuration. It is used only for product analytics and does not affect extraction behavior.`})]})]})]}),`\n`,_jsx(Note,{children:_jsxs(_components.p,{children:[`Use a new `,_jsx(_components.code,{children:`session_id`}),` for each conversation. Within a conversation, changing it between calls can split free-tier rate-limit accounting and trace correlation.`]})}),`\n`,_jsx(Heading,{level:`3`,id:`connection-level-search-overrides`,children:`Connection-level search overrides`}),`\n`,_jsxs(_components.p,{children:[`Anonymous free-tier requests use `,_jsx(_components.code,{children:`fast`}),` mode with server-managed search settings. When your MCP request is authenticated with a Parallel API key or OAuth, you can pin Search API settings, including the mode, for every `,_jsx(_components.code,{children:`web_search`}),` call made through that MCP connection.`]}),`\n`,_jsx(Warning,{children:_jsxs(_components.p,{children:[`Search overrides are ignored for anonymous free-tier requests. Authenticate the `,_jsx(_components.code,{children:`/mcp`}),` endpoint with a Bearer API key, or use `,_jsx(_components.code,{children:`/mcp-oauth`}),`, before adding overrides.`]})}),`\n`,_jsxs(_components.p,{children:[`The `,_jsx(_components.code,{children:`objective`}),` and `,_jsx(_components.code,{children:`search_queries`}),` remain arguments selected by the model for each tool call. Overrides configure how those searches run; they cannot replace what the model searches for. They also do not affect `,_jsx(_components.code,{children:`web_fetch`}),`.`]}),`\n`,_jsx(Heading,{level:`4`,id:`url-query-parameters`,children:`URL query parameters`}),`\n`,_jsx(_components.p,{children:`Append fields to the MCP server URL. Use the full dotted path for nested fields:`}),`\n`,_jsx(CodeBlock,{filename:``,numberOfLines:`2`,language:`text`,children:_jsx(_components.pre,{className:`shiki shiki-themes github-light-default dark-plus`,style:{backgroundColor:`#ffffff`,\"--shiki-dark-bg\":`#0B0C0E`,color:`#1f2328`,\"--shiki-dark\":`#D4D4D4`},language:`text`,children:_jsxs(_components.code,{language:`text`,numberOfLines:`2`,children:[_jsx(_components.span,{className:`line`,children:_jsx(_components.span,{children:`https://search.parallel.ai/mcp?mode=fast\u0026advanced_settings.location=gb\u0026advanced_settings.source_policy.include_domains=wikipedia.org,.gov`})}),`\n`,_jsx(_components.span,{className:`line`,children:_jsx(_components.span,{})})]})})}),`\n`,_jsxs(_components.p,{children:[`For list fields such as `,_jsx(_components.code,{children:`include_domains`}),` and `,_jsx(_components.code,{children:`exclude_domains`}),`, use comma-separated values, repeat the parameter, or combine both forms. For example:`]}),`\n`,_jsx(CodeBlock,{filename:``,numberOfLines:`2`,language:`text`,children:_jsx(_components.pre,{className:`shiki shiki-themes github-light-default dark-plus`,style:{backgroundColor:`#ffffff`,\"--shiki-dark-bg\":`#0B0C0E`,color:`#1f2328`,\"--shiki-dark\":`#D4D4D4`},language:`text`,children:_jsxs(_components.code,{language:`text`,numberOfLines:`2`,children:[_jsx(_components.span,{className:`line`,children:_jsx(_components.span,{children:`?advanced_settings.source_policy.include_domains=wikipedia.org,.gov\u0026advanced_settings.source_policy.include_domains=usa.gov`})}),`\n`,_jsx(_components.span,{className:`line`,children:_jsx(_components.span,{})})]})})}),`\n`,_jsx(Heading,{level:`4`,id:`configuration-header`,children:`Configuration header`}),`\n`,_jsx(_components.p,{children:`If your MCP client supports custom headers, send the settings as a JSON object matching the Search API request shape:`}),`\n`,_jsx(CodeBlock,{filename:``,numberOfLines:`2`,language:`http`,children:_jsx(_components.pre,{className:`shiki shiki-themes github-light-default dark-plus`,style:{backgroundColor:`#ffffff`,\"--shiki-dark-bg\":`#0B0C0E`,color:`#1f2328`,\"--shiki-dark\":`#D4D4D4`},language:`http`,children:_jsxs(_components.code,{language:`http`,numberOfLines:`2`,children:[_jsxs(_components.span,{className:`line`,children:[_jsx(_components.span,{style:{color:`#116329`,\"--shiki-dark\":`#569CD6`},children:`Authorization`}),_jsx(_components.span,{style:{color:`#CF222E`,\"--shiki-dark\":`#569CD6`},children:`:`}),_jsx(_components.span,{style:{color:`#0A3069`,\"--shiki-dark\":`#CE9178`},children:` Bearer \u003cPARALLEL_API_KEY\u003e`})]}),`\n`,_jsxs(_components.span,{className:`line`,children:[_jsx(_components.span,{style:{color:`#116329`,\"--shiki-dark\":`#569CD6`},children:`x-parallel-search-config`}),_jsx(_components.span,{style:{color:`#CF222E`,\"--shiki-dark\":`#569CD6`},children:`:`}),_jsx(_components.span,{style:{color:`#0A3069`,\"--shiki-dark\":`#CE9178`},children:` {\"mode\":\"fast\",\"advanced_settings\":{\"location\":\"gb\",\"max_results\":5}}`})]}),`\n`]})})}),`\n`,_jsxs(_components.p,{children:[`Use query parameters for short, easily shareable configurations and the header for larger nested configurations. If both set the same field, the URL query parameter wins. Unrelated header fields are preserved. For example, if the header sets `,_jsx(_components.code,{children:`{\"mode\":\"turbo\",\"advanced_settings\":{\"max_results\":5}}`}),` and the URL contains `,_jsx(_components.code,{children:`?mode=fast\u0026advanced_settings.location=gb`}),`, the effective settings use `,_jsx(_components.code,{children:`fast`}),` mode, return up to five results, and target Great Britain.`]}),`\n`,_jsx(Heading,{level:`4`,id:`supported-override-settings`,children:`Supported override settings`}),`\n`,_jsxs(_components.p,{children:[`The Search MCP supports the same configurable parameters as the v1 `,_jsx(_components.a,{href:`/search/search-quickstart`,children:`Search API`}),`, except `,_jsx(_components.code,{children:`objective`}),` and `,_jsx(_components.code,{children:`search_queries`}),`, which remain per-call tool inputs. See `,_jsx(_components.a,{href:`/search/modes`,children:`Search modes`}),`, `,_jsx(_components.a,{href:`/resources/source-policy`,children:`Source policy`}),`, and `,_jsx(_components.a,{href:`/search/advanced-search-settings`,children:`Advanced Search Settings`}),` for the available fields and constraints.`]}),`\n`,_jsxs(_components.p,{children:[`Domain/path prefixes in `,_jsx(_components.code,{children:`include_domains`}),` and `,_jsx(_components.code,{children:`exclude_domains`}),` require `,_jsx(_components.code,{children:`fast`}),`, `,_jsx(_components.code,{children:`basic`}),`, or\n`,_jsx(_components.code,{children:`advanced`}),` mode; they are not supported in `,_jsx(_components.code,{children:`turbo`}),` mode.`]}),`\n`,_jsxs(_components.p,{children:[`The MCP validates these settings against the Search API request schema when the client connects. Unknown fields, invalid values, malformed header JSON, attempts to pin `,_jsx(_components.code,{children:`objective`}),` or `,_jsx(_components.code,{children:`search_queries`}),`, and unsupported mode values return an HTTP `,_jsx(_components.code,{children:`400`}),` error during the MCP handshake. Blank query-parameter values are ignored.`]}),`\n`,_jsx(Heading,{level:`2`,id:`installation`,children:`Installation`}),`\n`,_jsx(_components.p,{children:`The Search MCP can be installed in any MCP client. Two endpoints are available:`}),`\n`,_jsxs(_components.ul,{children:[`\n`,_jsxs(_components.li,{children:[_jsx(_components.strong,{children:_jsx(_components.code,{children:`https://search.parallel.ai/mcp`})}),` — default. Free to use anonymously at lower rate limits. Pass a Parallel API key as a Bearer token (`,_jsx(_components.code,{children:`Authorization: Bearer \u003ckey\u003e`}),`) to unlock higher limits. `,_jsx(_components.strong,{children:`OAuth is not advertised on this endpoint`}),`, so clients that support OAuth sign-in (Claude Desktop, Claude.ai custom connectors, Codex, etc.) will not prompt you to log in here — use `,_jsx(_components.code,{children:`/mcp-oauth`}),` below if you prefer OAuth.`]}),`\n`,_jsxs(_components.li,{children:[_jsx(_components.strong,{children:_jsx(_components.code,{children:`https://search.parallel.ai/mcp-oauth`})}),` — the OAuth-capable endpoint. Requires authentication: Bearer API key OR the OAuth flow. Anonymous requests return `,_jsx(_components.code,{children:`401`}),`. Use this when you want OAuth instead of managing a Bearer key, or when you need to guarantee every request is attributed to a Parallel account — for example, organization-wide deployments, Zero Data Retention (ZDR) setups, or any context where unauthenticated traffic is not acceptable.`]}),`\n`]}),`\n`,_jsxs(_components.p,{children:[`Swap `,_jsx(_components.code,{children:`/mcp`}),` for `,_jsx(_components.code,{children:`/mcp-oauth`}),` in any of the config snippets below if you want OAuth or enforced authentication. The Search MCP can also be `,_jsx(_components.a,{href:`/integrations/mcp/programmatic-use`,children:`used programmatically`}),` by providing your Parallel API key in the Authorization header as a Bearer token.`]}),`\n`,_jsx(Heading,{level:`3`,id:`claude-code`,children:`Claude Code`}),`\n`,_jsx(_components.p,{children:`Run this command in your terminal:`}),`\n`,_jsx(CodeBlock,{filename:``,numberOfLines:`1`,language:`shellscript`,children:_jsx(_components.pre,{className:`shiki shiki-themes github-light-default dark-plus`,style:{backgroundColor:`#ffffff`,\"--shiki-dark-bg\":`#0B0C0E`,color:`#1f2328`,\"--shiki-dark\":`#D4D4D4`},language:`shellscript`,children:_jsxs(_components.code,{language:`shellscript`,numberOfLines:`1`,children:[_jsxs(_components.span,{className:`line`,children:[_jsx(_components.span,{style:{color:`#953800`,\"--shiki-dark\":`#DCDCAA`},children:`claude`}),_jsx(_components.span,{style:{color:`#0A3069`,\"--shiki-dark\":`#CE9178`},children:` mcp`}),_jsx(_components.span,{style:{color:`#0A3069`,\"--shiki-dark\":`#CE9178`},children:` add`}),_jsx(_components.span,{style:{color:`#0550AE`,\"--shiki-dark\":`#569CD6`},children:` --transport`}),_jsx(_components.span,{style:{color:`#0A3069`,\"--shiki-dark\":`#CE9178`},children:` http`}),_jsx(_components.span,{style:{color:`#0A3069`,\"--shiki-dark\":`#CE9178`},children:` \"Parallel-Search-MCP\"`}),_jsx(_components.span,{style:{color:`#0A3069`,\"--shiki-dark\":`#CE9178`},children:` https://search.parallel.ai/mcp`})]}),`\n`]})})}),`\n`,_jsxs(_components.p,{children:[`This connects anonymously. No sign-in is needed. In Claude Code, run `,_jsx(_components.code,{children:`/mcp`}),` to confirm the server is connected.`]}),`\n`,_jsx(_components.p,{children:`To sign in with OAuth for higher rate limits, add the OAuth endpoint instead:`}),`\n`,_jsx(CodeBlock,{filename:``,numberOfLines:`1`,language:`shellscript`,children:_jsx(_components.pre,{className:`shiki shiki-themes github-light-default dark-plus`,style:{backgroundColor:`#ffffff`,\"--shiki-dark-bg\":`#0B0C0E`,color:`#1f2328`,\"--shiki-dark\":`#D4D4D4`},language:`shellscript`,children:_jsxs(_components.code,{language:`shellscript`,numberOfLines:`1`,children:[_jsxs(_components.span,{className:`line`,children:[_jsx(_components.span,{style:{color:`#953800`,\"--shiki-dark\":`#DCDCAA`},children:`claude`}),_jsx(_components.span,{style:{color:`#0A3069`,\"--shiki-dark\":`#CE9178`},children:` mcp`}),_jsx(_components.span,{style:{color:`#0A3069`,\"--shiki-dark\":`#CE9178`},children:` add`}),_jsx(_components.span,{style:{color:`#0550AE`,\"--shiki-dark\":`#569CD6`},children:` --transport`}),_jsx(_components.span,{style:{color:`#0A3069`,\"--shiki-dark\":`#CE9178`},children:` http`}),_jsx(_components.span,{style:{color:`#0A3069`,\"--shiki-dark\":`#CE9178`},children:` \"Parallel-Search-MCP\"`}),_jsx(_components.span,{style:{color:`#0A3069`,\"--shiki-dark\":`#CE9178`},children:` https://search.parallel.ai/mcp-oauth`})]}),`\n`]})})}),`\n`,_jsxs(_components.p,{children:[`Then run `,_jsx(_components.code,{children:`/mcp`}),` in Claude Code, select the server, and follow the steps in your browser to log in.`]}),`\n`,_jsxs(_components.p,{children:[`For more details, see the `,_jsx(_components.a,{href:`https://code.claude.com/docs/en/mcp#authenticate-with-remote-mcp-servers`,children:`Claude Code MCP documentation`}),`.`]}),`\n`,_jsx(_components.hr,{}),`\n`,_jsx(Heading,{level:`3`,id:`codex-cli`,children:`Codex CLI`}),`\n`,_jsx(_components.p,{children:`Run one of the following, depending on how you want to authenticate:`}),`\n`,_jsx(CodeBlock,{filename:`Free, anonymous`,numberOfLines:`1`,language:`shellscript`,children:_jsx(_components.pre,{className:`shiki shiki-themes github-light-default dark-plus`,style:{backgroundColor:`#ffffff`,\"--shiki-dark-bg\":`#0B0C0E`,color:`#1f2328`,\"--shiki-dark\":`#D4D4D4`},language:`shellscript`,children:_jsxs(_components.code,{language:`shellscript`,numberOfLines:`1`,children:[_jsxs(_components.span,{className:`line`,children:[_jsx(_components.span,{style:{color:`#953800`,\"--shiki-dark\":`#DCDCAA`},children:`codex`}),_jsx(_components.span,{style:{color:`#0A3069`,\"--shiki-dark\":`#CE9178`},children:` mcp`}),_jsx(_components.span,{style:{color:`#0A3069`,\"--shiki-dark\":`#CE9178`},children:` add`}),_jsx(_components.span,{style:{color:`#0A3069`,\"--shiki-dark\":`#CE9178`},children:` parallel-search`}),_jsx(_components.span,{style:{color:`#0550AE`,\"--shiki-dark\":`#569CD6`},children:` --url`}),_jsx(_components.span,{style:{color:`#0A3069`,\"--shiki-dark\":`#CE9178`},children:` https://search.parallel.ai/mcp`})]}),`\n`]})})}),`\n`,_jsx(CodeBlock,{filename:`Higher rate limits via API key`,numberOfLines:`3`,language:`shellscript`,children:_jsx(_components.pre,{className:`shiki shiki-themes github-light-default dark-plus`,style:{backgroundColor:`#ffffff`,\"--shiki-dark-bg\":`#0B0C0E`,color:`#1f2328`,\"--shiki-dark\":`#D4D4D4`},language:`shellscript`,children:_jsxs(_components.code,{language:`shellscript`,numberOfLines:`3`,children:[_jsx(_components.span,{className:`line`,children:_jsx(_components.span,{style:{color:`#6E7781`,\"--shiki-dark\":`#6A9955`},children:`# set PARALLEL_API_KEY in your environment first (key from platform.parallel.ai)`})}),`\n`,_jsxs(_components.span,{className:`line`,children:[_jsx(_components.span,{style:{color:`#953800`,\"--shiki-dark\":`#DCDCAA`},children:`codex`}),_jsx(_components.span,{style:{color:`#0A3069`,\"--shiki-dark\":`#CE9178`},children:` mcp`}),_jsx(_components.span,{style:{color:`#0A3069`,\"--shiki-dark\":`#CE9178`},children:` add`}),_jsx(_components.span,{style:{color:`#0A3069`,\"--shiki-dark\":`#CE9178`},children:` parallel-search`}),_jsx(_components.span,{style:{color:`#0550AE`,\"--shiki-dark\":`#569CD6`},children:` --url`}),_jsx(_components.span,{style:{color:`#0A3069`,\"--shiki-dark\":`#CE9178`},children:` https://search.parallel.ai/mcp`}),_jsx(_components.span,{style:{color:`#CF222E`,\"--shiki-dark\":`#D7BA7D`},children:` \\\\`})]}),`\n`,_jsxs(_components.span,{className:`line`,children:[_jsx(_components.span,{style:{color:`#0550AE`,\"--shiki-dark\":`#569CD6`},children:`  --bearer-token-env-var`}),_jsx(_components.span,{style:{color:`#0A3069`,\"--shiki-dark\":`#CE9178`},children:` PARALLEL_API_KEY`})]}),`\n`]})})}),`\n`,_jsx(CodeBlock,{filename:`Higher rate limits via OAuth`,numberOfLines:`2`,language:`shellscript`,children:_jsx(_components.pre,{className:`shiki shiki-themes github-light-default dark-plus`,style:{backgroundColor:`#ffffff`,\"--shiki-dark-bg\":`#0B0C0E`,color:`#1f2328`,\"--shiki-dark\":`#D4D4D4`},language:`shellscript`,children:_jsxs(_components.code,{language:`shellscript`,numberOfLines:`2`,children:[_jsxs(_components.span,{className:`line`,children:[_jsx(_component