rallel\"},\"coAuthors\":null,\"coverImage\":{\"_type\":\"image\",\"asset\":{\"_ref\":\"image-b0db460df672f3032ae2b76e974b159f4bbc7535-6021x3375-jpg\",\"_type\":\"reference\"}},\"hideAuthorImage\":true,\"intro\":null,\"publishedAt\":null,\"slug\":\"series-b\",\"tags\":[{\"_key\":\"company\",\"_type\":\"tag\",\"label\":\"Company\",\"value\":\"company\"}],\"title\":\"Parallel Raises at $2 Billion Valuation to Scale Web Infrastructure for Agents\"}}]}]\n87:[\"$\",\"$L24\",\"free-CLI-agent\",{\"cols\":3,\"className\""])</script><script>self.__next_f.push([1,":\"lg:col-start-auto lg:-ml-[1px]\",\"children\":[\"$\",\"$L68\",\"free-CLI-agent\",{\"post\":{\"_createdAt\":\"2026-04-24T16:18:26Z\",\"_id\":\"b82793ec-db05-4c22-8ec0-48d7dfba533c\",\"_type\":\"blogArticle\",\"_updatedAt\":\"2026-08-11T17:36:29Z\",\"author\":{\"avatar\":{\"_type\":\"image\",\"asset\":{\"_ref\":\"image-9388d736333ea8244cfcf68b0cc3810af02f6d17-929x929-jpg\",\"_type\":\"reference\"}},\"name\":\"Matt Harris\"},\"coAuthors\":null,\"coverImage\":{\"_type\":\"image\",\"alt\":\"Fully Free CLI with Pi, Ollama, Gemma 4, Parallel\",\"asset\":{\"_ref\":\"image-bf4ea7d23795fc2fa4e85b3617fb5d9cde24de76-5396x3240-jpg\",\"_type\":\"reference\"}},\"hideAuthorImage\":true,\"intro\":null,\"publishedAt\":null,\"slug\":\"free-CLI-agent\",\"tags\":[{\"_key\":\"developers\",\"_type\":\"tag\",\"label\":\"Developers\",\"value\":\"developers\"}],\"title\":\"Building a free CLI agent with Pi, Ollama, Gemma 4, and Parallel\"}}]}]\n88:[\"$\",\"$L24\",\"free-web-search-mcp\",{\"cols\":3,\"className\":\"lg:col-start-auto lg:-ml-[1px]\",\"children\":[\"$\",\"$L68\",\"free-web-search-mcp\",{\"post\":{\"_createdAt\":\"2026-04-23T18:35:42Z\",\"_id\":\"5729f993-9d5d-4bc2-b124-0554564a8b5b\",\"_type\":\"blogArticle\",\"_updatedAt\":\"2026-08-11T17:36:51Z\",\"author\":{\"avatar\":{\"_type\":\"image\",\"asset\":{\"_ref\":\"image-2f4085c390d6c65a71d1a551b22c62aceadcb513-384x384-png\",\"_type\":\"reference\"}},\"name\":\"Parallel\"},\"coAuthors\":null,\"coverImage\":{\"_type\":\"image\",\"alt\":\"Parallel Search is now free via MCP\",\"asset\":{\"_ref\":\"image-04129d3d068eb961bde24d8a637f7b96c843013c-5396x3240-jpg\",\"_type\":\"reference\"}},\"hideAuthorImage\":true,\"intro\":null,\"publishedAt\":null,\"slug\":\"free-web-search-mcp\",\"tags\":[{\"_key\":\"product\",\"_type\":\"tag\",\"label\":\"Product\",\"value\":\"product\"}],\"title\":\"Parallel Search is now free for agents via MCP\"}}]}]\n89:[\"$\",\"$L24\",\"parallel-search-api\",{\"cols\":3,\"className\":\"lg:col-start-auto\",\"children\":[\"$\",\"$L68\",\"parallel-search-api\",{\"post\":{\"_createdAt\":\"2026-04-21T17:54:52Z\",\"_id\":\"57a4d3f1-38ed-4909-b9c7-2841092b1678\",\"_type\":\"blogArticle\",\"_updatedAt\":\"2026-08-11T17:36:51Z\",\"author\":{\"avatar\":{\"_type\":\"image\",\"asset\":{\"_ref\":\"image-2f4085c390d6c65a71d1a551b22c62aceadcb513-384x384-png\",\"_type\":\"reference\"}},\"name\":\"Parallel\"},\"coAuthors\":null,\"coverImage\":{\"_type\":\"image\",\"alt\":\"Search \u0026 Extract Benchmarks\",\"asset\":{\"_ref\":\"image-59503001c1b7400d9a48a96fb63931b3565f3f51-5396x3240-jpg\",\"_type\":\"reference\"}},\"hideAuthorImage\":true,\"intro\":null,\"publishedAt\":null,\"slug\":\"parallel-search-api\",\"tags\":[{\"_key\":\"benchmarks\",\"_type\":\"tag\",\"label\":\"Benchmarks\",\"value\":\"benchmarks\"}],\"title\":\"Upgrades to the Parallel Search \u0026 Extract APIs\"}}]}]\n8a:[\"$\",\"$L24\",\"case-study-finch\",{\"cols\":3,\"className\":\"lg:col-start-auto lg:-ml-[1px]\",\"children\":[\"$\",\"$L68\",\"case-study-finch\",{\"post\":{\"_createdAt\":\"2026-04-20T16:49:36Z\",\"_id\":\"6b6a9de9-64be-4e36-af7e-52093d6e6871\",\"_type\":\"blogArticle\",\"_updatedAt\":\"2026-08-11T17:36:29Z\",\"author\":{\"avatar\":{\"_type\":\"image\",\"asset\":{\"_ref\":\"image-2f4085c390d6c65a71d1a551b22c62aceadcb513-384x384-png\",\"_type\":\"reference\"}},\"name\":\"Parallel\"},\"coAuthors\":null,\"coverImage\":{\"_type\":\"image\",\"asset\":{\"_ref\":\"image-fab7555a64dd1351fb12e59dc03ab659936a1726-3600x2025-jpg\",\"_type\":\"reference\"}},\"hideAuthorImage\":true,\"intro\":\"Finch replaced a three-step search-extract-validate pipeline with a single Parallel Task API call, cutting per-query costs by 96% and eliminating the defensive engineering overhead that came with an unreliable vendor.\",\"publishedAt\":null,\"slug\":\"case-study-finch\",\"tags\":[{\"_key\":\"customers\",\"_type\":\"tag\",\"label\":\"Customers\",\"value\":\"customers\"}],\"title\":\"How Finch is scaling plaintiff law with AI agents that research like associates\"}}]}]\n8b:[\"$\",\"$L24\",\"genpact-parallel-partnership\",{\"cols\":3,\"className\":\"lg:col-start-auto lg:-ml-[1px]\",\"children\":[\"$\",\"$L68\",\"genpact-parallel-partnership\",{\"post\":{\"_createdAt\":\"2026-04-07T18:16:34Z\",\"_id\":\"6449a30d-a845-4c1d-af05-a89997a3ab83\",\"_type\":\"blogArticle\",\"_updatedAt\":\"2026-08-11T17:36:51Z\",\"author\":{\"avatar\":{\"_type\":\"image\",\"asset\":{\"_ref\":\"image-2f4085c390d6c65a71d1a551b22c62aceadcb513-384x384-png\",\"_type\":\"reference\"}},\"name\":\"Parallel\"},\"coAuthors\":null,\"coverImage\":{\"_type\":\"image\",\"asset\""])</script><script>self.__next_f.push([1,":{\"_ref\":\"image-9846feb6605aedb36a4821953b95485befe9423d-5396x3240-jpg\",\"_type\":\"reference\"}},\"hideAuthorImage\":true,\"intro\":null,\"publishedAt\":\"2026-04-08T15:09:00.000Z\",\"slug\":\"genpact-parallel-partnership\",\"tags\":[{\"_key\":\"company\",\"_type\":\"tag\",\"label\":\"Company\",\"value\":\"company\"}],\"title\":\"Genpact and Parallel Web Systems Partner to Drive Tangible Efficiency from AI Systems\"}}]}]\n8c:[\"$\",\"$L24\",\"case-study-genpact\",{\"cols\":3,\"className\":\"lg:col-start-auto lg:-ml-[1px]\",\"children\":[\"$\",\"$L68\",\"case-study-genpact\",{\"post\":{\"_createdAt\":\"2026-04-06T20:55:21Z\",\"_id\":\"71269c12-4f02-429f-aa47-b7bfad8d9dfb\",\"_type\":\"blogArticle\",\"_updatedAt\":\"2026-08-11T17:36:29Z\",\"author\":{\"avatar\":{\"_type\":\"image\",\"asset\":{\"_ref\":\"image-2f4085c390d6c65a71d1a551b22c62aceadcb513-384x384-png\",\"_type\":\"reference\"}},\"name\":\"Parallel\"},\"coAuthors\":null,\"coverImage\":{\"_type\":\"image\",\"alt\":\"Genpact \u0026 Parallel\",\"asset\":{\"_ref\":\"image-d12ed5a7f0555484081c4a59246556e8fc3c13a9-3600x2025-jpg\",\"_type\":\"reference\"}},\"hideAuthorImage\":true,\"intro\":\"By integrating Parallel's Task API, Genpact (NYSE: G), a public company that offers agentic and advanced technology solutions to global enterprises, transformed manual price intelligence for insurance claims into a scalable, rule-based AI system that’s active in production with two of the top 10 US P\u0026C insurers.\",\"publishedAt\":\"2026-04-08T15:09:00.000Z\",\"slug\":\"case-study-genpact\",\"tags\":[{\"_key\":\"customers\",\"_type\":\"tag\",\"label\":\"Customers\",\"value\":\"customers\"}],\"title\":\"How Genpact helps top US insurers cut contents claims processing times in half with Parallel \"}}]}]\n8d:[\"$\",\"$L24\",\"deep-research\",{\"cols\":3,\"className\":\"lg:col-start-auto\",\"children\":[\"$\",\"$L68\",\"deep-research\",{\"post\":{\"_createdAt\":\"2026-04-07T14:11:06Z\",\"_id\":\"892ba36e-ae5a-4ce8-a7b9-f1cac24bb065\",\"_type\":\"blogArticle\",\"_updatedAt\":\"2026-09-30T22:16:47Z\",\"author\":{\"avatar\":{\"_type\":\"image\",\"asset\":{\"_ref\":\"image-2f4085c390d6c65a71d1a551b22c62aceadcb513-384x384-png\",\"_type\":\"reference\"}},\"name\":\"Parallel\"},\"coAuthors\":null,\"coverImage\":{\"_type\":\"image\",\"alt\":\"DeepSearchQA: Parallel Task API benchmarks deepresearch\",\"asset\":{\"_ref\":\"image-5df30b314e3c586e5ed75c5b3b69c7142ced7e33-4800x2700-jpg\",\"_type\":\"reference\"}},\"hideAuthorImage\":true,\"intro\":null,\"publishedAt\":null,\"slug\":\"deep-research\",\"tags\":[{\"_key\":\"benchmarks\",\"_type\":\"tag\",\"label\":\"Benchmarks\",\"value\":\"benchmarks\"}],\"title\":\"A new deep research frontier on DeepSearchQA with the Task API Harness\"}}]}]\n8e:[\"$\",\"$L24\",\"case-study-modal\",{\"cols\":3,\"className\":\"lg:col-start-auto lg:-ml-[1px]\",\"children\":[\"$\",\"$L68\",\"case-study-modal\",{\"post\":{\"_createdAt\":\"2026-03-30T20:42:08Z\",\"_id\":\"221bce2e-a4bd-4458-a659-8f9f67877ea9\",\"_type\":\"blogArticle\",\"_updatedAt\":\"2026-08-11T17:36:29Z\",\"author\":{\"avatar\":{\"_type\":\"image\",\"asset\":{\"_ref\":\"image-2f4085c390d6c65a71d1a551b22c62aceadcb513-384x384-png\",\"_type\":\"reference\"}},\"name\":\"Parallel\"},\"coAuthors\":null,\"coverImage\":{\"_type\":\"image\",\"asset\":{\"_ref\":\"image-f0d9e9f69601834b628c7f801e14298bc74a7135-3600x2025-jpg\",\"_type\":\"reference\"}},\"hideAuthorImage\":true,\"intro\":\"Modal creates custom, code-first GTM pipelines using Parallel's Task and Monitor APIs to automate account research, segmentation, and enrichment at a fraction of the cost of traditional providers.\",\"publishedAt\":null,\"slug\":\"case-study-modal\",\"tags\":[{\"_key\":\"customers\",\"_type\":\"tag\",\"label\":\"Customers\",\"value\":\"customers\"}],\"title\":\"How Modal saves tens of thousands annually by building in-house GTM pipelines with Parallel\"}}]}]\n8f:[\"$\",\"$L24\",\"case-study-opendoor\",{\"cols\":3,\"className\":\"lg:col-start-auto lg:-ml-[1px]\",\"children\":[\"$\",\"$L68\",\"case-study-opendoor\",{\"post\":{\"_createdAt\":\"2026-03-25T16:34:26Z\",\"_id\":\"6628b290-bdbe-471b-abb9-63cc26b57c20\",\"_type\":\"blogArticle\",\"_updatedAt\":\"2026-08-11T17:36:29Z\",\"author\":{\"avatar\":{\"_type\":\"image\",\"asset\":{\"_ref\":\"image-2f4085c390d6c65a71d1a551b22c62aceadcb513-384x384-png\",\"_type\":\"reference\"}},\"name\":\"Parallel\"},\"coAuthors\":null,\"coverImage\":{\"_type\":\"image\",\"alt\":\"Opendoor and Parallel Case Study\",\"asset\":{\"_ref\":\"image-f50882f54b5"])</script><script>self.__next_f.push([1,"8321e6a77171742060a938e0176a6-3600x2025-jpg\",\"_type\":\"reference\"}},\"hideAuthorImage\":true,\"intro\":\"Opendoor (NASDAQ: OPEN), the leading digital platform for residential real estate, uses Parallel's web research APIs to automate accuracy-critical investigations across its core operations. Starting with an HOA research workflow, Parallel transforms a 10-minute manual process into a two-minute verification step, ensuring every transaction is backed by production grade web data.\",\"publishedAt\":null,\"slug\":\"case-study-opendoor\",\"tags\":[{\"_key\":\"customers\",\"_type\":\"tag\",\"label\":\"Customers\",\"value\":\"customers\"}],\"title\":\"How Opendoor uses Parallel as the enterprise grade web research layer powering its AI-native real estate operations\"}}]}]\n90:[\"$\",\"$L24\",\"task-api-interactions\",{\"cols\":3,\"className\":\"lg:col-start-auto lg:-ml-[1px]\",\"children\":[\"$\",\"$L68\",\"task-api-interactions\",{\"post\":{\"_createdAt\":\"2026-03-19T11:56:18Z\",\"_id\":\"b498c740-0364-41de-8ec2-73fe12889090\",\"_type\":\"blogArticle\",\"_updatedAt\":\"2026-09-30T22:16:47Z\",\"author\":{\"avatar\":{\"_type\":\"image\",\"asset\":{\"_ref\":\"image-2f4085c390d6c65a71d1a551b22c62aceadcb513-384x384-png\",\"_type\":\"reference\"}},\"name\":\"Parallel\"},\"coAuthors\":null,\"coverImage\":{\"_type\":\"image\",\"alt\":\"Introducing stateful web research agents with multi-turn conversations\",\"asset\":{\"_ref\":\"image-b180e095e7b4c475a06f8f4903884dc432d2bf1b-5396x3240-jpg\",\"_type\":\"reference\"}},\"hideAuthorImage\":true,\"intro\":\"The Parallel Task API now supports the ability to chain together context between sequential API calls.\",\"publishedAt\":null,\"slug\":\"task-api-interactions\",\"tags\":[{\"_key\":\"product\",\"_type\":\"tag\",\"label\":\"Product\",\"value\":\"product\"}],\"title\":\"Introducing stateful web research agents with multi-turn conversations\"}}]}]\n91:[\"$\",\"$L24\",\"tempo-stripe-mpp\",{\"cols\":3,\"className\":\"lg:col-start-auto\",\"children\":[\"$\",\"$L68\",\"tempo-stripe-mpp\",{\"post\":{\"_createdAt\":\"2026-03-18T09:46:21Z\",\"_id\":\"ef91341f-7fef-4faa-985c-111792dead15\",\"_type\":\"blogArticle\",\"_updatedAt\":\"2026-08-11T17:37:09Z\",\"author\":{\"avatar\":{\"_type\":\"image\",\"asset\":{\"_ref\":\"image-2f4085c390d6c65a71d1a551b22c62aceadcb513-384x384-png\",\"_type\":\"reference\"}},\"name\":\"Parallel\"},\"coAuthors\":null,\"coverImage\":{\"_type\":\"image\",\"alt\":\"Parallel is now live on Tempo via the Machine Payments Protocol (MPP)\",\"asset\":{\"_ref\":\"image-b4015d1d9ae01aef327b12d418dbb8b1e576e635-3597x2160-jpg\",\"_type\":\"reference\"}},\"hideAuthorImage\":true,\"intro\":\"Today, Parallel joins Stripe and Tempo in announcing the Machine Payments Protocol (MPP), launching alongside Tempo mainnet. Parallel's APIs are live on MPP from day one, enabling agents to discover and pay per use for web search, extraction, and multi-hop research with no account setup or human in the loop. With Parallel on MPP, agents get truly programmatic access to the open web.\",\"publishedAt\":null,\"slug\":\"tempo-stripe-mpp\",\"tags\":[{\"_key\":\"company\",\"_type\":\"tag\",\"label\":\"Company\",\"value\":\"company\"}],\"title\":\"Parallel is live on Tempo, now available natively to agents with the Machine Payments Protocol\"}}]}]\n92:[\"$\",\"$L24\",\"case-study-kepler\",{\"cols\":3,\"className\":\"lg:col-start-auto lg:-ml-[1px]\",\"children\":[\"$\",\"$L68\",\"case-study-kepler\",{\"post\":{\"_createdAt\":\"2026-03-17T20:22:15Z\",\"_id\":\"eed7bd2c-557d-40e3-be02-f67fc4c17dce\",\"_type\":\"blogArticle\",\"_updatedAt\":\"2026-08-11T17:36:29Z\",\"author\":{\"avatar\":{\"_type\":\"image\",\"asset\":{\"_ref\":\"image-2f4085c390d6c65a71d1a551b22c62aceadcb513-384x384-png\",\"_type\":\"reference\"}},\"name\":\"Parallel\"},\"coAuthors\":null,\"coverImage\":{\"_type\":\"image\",\"alt\":\"Kepler | Parallel Case Study\",\"asset\":{\"_ref\":\"image-a3459b4fe908a7c88a4ba22b7c6d1a52ad1fc9ba-3600x2025-jpg\",\"_type\":\"reference\"}},\"hideAuthorImage\":true,\"intro\":null,\"publishedAt\":null,\"slug\":\"case-study-kepler\",\"tags\":[{\"_key\":\"customers\",\"_type\":\"tag\",\"label\":\"Customers\",\"value\":\"customers\"}],\"title\":\"How Parallel helped Kepler build AI that finance professionals can actually trust\"}}]}]\n93:[\"$\",\"$L24\",\"parallel-cli\",{\"cols\":3,\"className\":\"lg:col-start-auto lg:-ml-[1px]\",\"children\":[\"$\",\"$L68\",\"parallel-cli\",{\"post\":{\"_createdAt\":\"2026-"])</script><script>self.__next_f.push([1,"03-10T19:18:57Z\",\"_id\":\"f11ffe10-e64f-4e72-bcaf-7eb6417aa7ff\",\"_type\":\"blogArticle\",\"_updatedAt\":\"2026-08-11T17:36:51Z\",\"author\":{\"avatar\":{\"_type\":\"image\",\"asset\":{\"_ref\":\"image-2f4085c390d6c65a71d1a551b22c62aceadcb513-384x384-png\",\"_type\":\"reference\"}},\"name\":\"Parallel\"},\"coAuthors\":null,\"coverImage\":{\"_type\":\"image\",\"alt\":\"Introducing the Parallel CLI\",\"asset\":{\"_ref\":\"image-fad4fa00d45a13f2b2cf59dc097c13270478df34-5396x3240-jpg\",\"_type\":\"reference\"}},\"hideAuthorImage\":true,\"intro\":\"Today we're releasing Parallel CLI, a standalone command-line tool that gives any terminal-based agent direct access to Parallel's web intelligence stack. One install, one login, and your agent can search the web, pull clean content from any URL, run multi-source deep research, and enrich structured datasets, all from the command line.\",\"publishedAt\":null,\"slug\":\"parallel-cli\",\"tags\":[{\"_key\":\"product\",\"_type\":\"tag\",\"label\":\"Product\",\"value\":\"product\"}],\"title\":\"Introducing the Parallel CLI\"}}]}]\n94:[\"$\",\"$L24\",\"case-study-profound\",{\"cols\":3,\"className\":\"lg:col-start-auto lg:-ml-[1px]\",\"children\":[\"$\",\"$L68\",\"case-study-profound\",{\"post\":{\"_createdAt\":\"2026-03-04T17:48:21Z\",\"_id\":\"4dab54da-f495-4091-9f01-a7aeb491af65\",\"_type\":\"blogArticle\",\"_updatedAt\":\"2026-08-11T17:36:29Z\",\"author\":{\"avatar\":{\"_type\":\"image\",\"asset\":{\"_ref\":\"image-2f4085c390d6c65a71d1a551b22c62aceadcb513-384x384-png\",\"_type\":\"reference\"}},\"name\":\"Parallel\"},\"coAuthors\":null,\"coverImage\":{\"_type\":\"image\",\"alt\":\"Profound + Parallel Web Systems\",\"asset\":{\"_ref\":\"image-512a3d65c25de1e58559e657d854e5141eedd08a-3600x2025-jpg\",\"_type\":\"reference\"}},\"hideAuthorImage\":true,\"intro\":\"By integrating Parallel's Search and Deep Research APIs, Profound, the marketing platform for the AI era, enables marketing teams to create factually grounded, high-quality content that earns citations from AI answer engines like ChatGPT, Perplexity, Claude, and Gemini. Profound powers brands including MongoDB, Ramp, Docusign, Gamma, Zapier, Indeed, and more. \",\"publishedAt\":null,\"slug\":\"case-study-profound\",\"tags\":[{\"_key\":\"customers\",\"_type\":\"tag\",\"label\":\"Customers\",\"value\":\"customers\"}],\"title\":\"How Profound helps brands win AI Search with high-quality web research and content creation powered by Parallel\"}}]}]\n95:[\"$\",\"$L24\",\"case-study-harvey\",{\"cols\":3,\"className\":\"lg:col-start-auto\",\"children\":[\"$\",\"$L68\",\"case-study-harvey\",{\"post\":{\"_createdAt\":\"2026-03-02T23:13:14Z\",\"_id\":\"01441f5a-71b6-40d3-97e1-034353c3242b\",\"_type\":\"blogArticle\",\"_updatedAt\":\"2026-08-11T17:36:29Z\",\"author\":{\"avatar\":{\"_type\":\"image\",\"asset\":{\"_ref\":\"image-2f4085c390d6c65a71d1a551b22c62aceadcb513-384x384-png\",\"_type\":\"reference\"}},\"name\":\"Parallel\"},\"coAuthors\":null,\"coverImage\":{\"_type\":\"image\",\"asset\":{\"_ref\":\"image-43f263b6a1fe9cb7d31e2c54c8cf58463fba306c-3600x2025-jpg\",\"_type\":\"reference\"}},\"hideAuthorImage\":true,\"intro\":\"Harvey is the leading AI platform for legal and professional services. As they expand beyond common-law jurisdictions into civil-law countries across Latin America, Europe, and Asia-Pacific, they're partnering with Parallel to power web search across their platform and solve a fundamental data access problem: the specialized legal knowledge their AI needs often doesn't exist in any searchable index.\",\"publishedAt\":null,\"slug\":\"case-study-harvey\",\"tags\":[{\"_key\":\"customers\",\"_type\":\"tag\",\"label\":\"Customers\",\"value\":\"customers\"}],\"title\":\"How Harvey is expanding legal AI internationally with Parallel\"}}]}]\n96:[\"$\",\"$L24\",\"case-study-tabstack\",{\"cols\":3,\"className\":\"lg:col-start-auto lg:-ml-[1px]\",\"children\":[\"$\",\"$L68\",\"case-study-tabstack\",{\"post\":{\"_createdAt\":\"2026-02-23T15:43:56Z\",\"_id\":\"90beedd7-782c-4041-8a8a-68763276aed7\",\"_type\":\"blogArticle\",\"_updatedAt\":\"2026-08-11T17:36:29Z\",\"author\":{\"avatar\":{\"_type\":\"image\",\"asset\":{\"_ref\":\"image-2f4085c390d6c65a71d1a551b22c62aceadcb513-384x384-png\",\"_type\":\"reference\"}},\"name\":\"Parallel\"},\"coAuthors\":null,\"coverImage\":{\"_type\":\"image\",\"alt\":\"Tabstack + Parallel Case Study\",\"asset\":{\"_ref\":\"image-4372de068d026777a6c45371f9b886177f1cb2eb-3600x2025-jpg\",\"_t"])</script><script>self.__next_f.push([1,"ype\":\"reference\"}},\"hideAuthorImage\":true,\"intro\":\"Tabstack, Mozilla's browsing infrastructure for AI agents, integrated Parallel's Search API to give its /automate and /research endpoints the ability to discover the right pages before navigating them,  combining Parallel's search accuracy with Tabstack's browser execution at scale.\",\"publishedAt\":null,\"slug\":\"case-study-tabstack\",\"tags\":[{\"_key\":\"customers\",\"_type\":\"tag\",\"label\":\"Customers\",\"value\":\"customers\"}],\"title\":\"How Tabstack by Mozilla enables agents to navigate the web with Parallel’s best-in-class web search\"}}]}]\n97:[\"$\",\"$L24\",\"vercel\",{\"cols\":3,\"className\":\"lg:col-start-auto lg:-ml-[1px]\",\"children\":[\"$\",\"$L68\",\"vercel\",{\"post\":{\"_createdAt\":\"2026-02-04T15:08:42Z\",\"_id\":\"82de4728-b9f5-4b67-9b2e-b72d22ebd055\",\"_type\":\"blogArticle\",\"_updatedAt\":\"2026-08-11T17:37:09Z\",\"author\":{\"avatar\":{\"_type\":\"image\",\"asset\":{\"_ref\":\"image-2f4085c390d6c65a71d1a551b22c62aceadcb513-384x384-png\",\"_type\":\"reference\"}},\"name\":\"Parallel\"},\"coAuthors\":null,\"coverImage\":{\"_type\":\"image\",\"alt\":\"Parallel | Vercel\",\"asset\":{\"_ref\":\"image-1e9cc3a3cdc2e4de39d06f502e13a4ad3dcc0679-1798x1079-jpg\",\"_type\":\"reference\"}},\"hideAuthorImage\":true,\"intro\":null,\"publishedAt\":null,\"slug\":\"vercel\",\"tags\":[{\"_key\":\"product\",\"_type\":\"tag\",\"label\":\"Product\",\"value\":\"product\"}],\"title\":\"Parallel Web Tools and Agents now available across Vercel AI Gateway, AI SDK, and Marketplace\"}}]}]\n98:[\"$\",\"$L24\",\"authenticated-page-access\",{\"cols\":3,\"className\":\"lg:col-start-auto lg:-ml-[1px]\",\"children\":[\"$\",\"$L68\",\"authenticated-page-access\",{\"post\":{\"_createdAt\":\"2026-01-28T15:57:28Z\",\"_id\":\"bf9942e2-5f15-4545-9f95-de9b341ddf34\",\"_type\":\"blogArticle\",\"_updatedAt\":\"2026-08-11T17:36:29Z\",\"author\":{\"avatar\":{\"_type\":\"image\",\"asset\":{\"_ref\":\"image-2f4085c390d6c65a71d1a551b22c62aceadcb513-384x384-png\",\"_type\":\"reference\"}},\"name\":\"Parallel\"},\"coAuthors\":null,\"coverImage\":{\"_type\":\"image\",\"alt\":\"Product release: Authenticated page access for the Parallel Task API\",\"asset\":{\"_ref\":\"image-9ccd396dea0f0e75087b99f9466c08b354318408-5396x3240-jpg\",\"_type\":\"reference\"}},\"hideAuthorImage\":true,\"intro\":null,\"publishedAt\":null,\"slug\":\"authenticated-page-access\",\"tags\":[{\"_key\":\"product\",\"_type\":\"tag\",\"label\":\"Product\",\"value\":\"product\"}],\"title\":\"Authenticated page access for the Parallel Task API\"}}]}]\n99:[\"$\",\"$L24\",\"structured-outputs-monitor\",{\"cols\":3,\"className\":\"lg:col-start-auto\",\"children\":[\"$\",\"$L68\",\"structured-outputs-monitor\",{\"post\":{\"_createdAt\":\"2026-01-21T21:12:21Z\",\"_id\":\"a887fb41-a682-4ee0-ba45-805841c4b7b6\",\"_type\":\"blogArticle\",\"_updatedAt\":\"2026-08-11T17:37:09Z\",\"author\":{\"avatar\":{\"_type\":\"image\",\"asset\":{\"_ref\":\"image-2f4085c390d6c65a71d1a551b22c62aceadcb513-384x384-png\",\"_type\":\"reference\"}},\"name\":\"Parallel\"},\"coAuthors\":null,\"coverImage\":{\"_type\":\"image\",\"asset\":{\"_ref\":\"image-f42277a241ef67150f48c5e585210eafd49adbbd-3597x2160-jpg\",\"_type\":\"reference\"}},\"hideAuthorImage\":true,\"intro\":null,\"publishedAt\":null,\"slug\":\"structured-outputs-monitor\",\"tags\":[{\"_key\":\"product\",\"_type\":\"tag\",\"label\":\"Product\",\"value\":\"product\"}],\"title\":\"Introducing structured outputs for the Monitor API\"}}]}]\n9a:[\"$\",\"$L24\",\"research-models-chat\",{\"cols\":3,\"className\":\"lg:col-start-auto lg:-ml-[1px]\",\"children\":[\"$\",\"$L68\",\"research-models-chat\",{\"post\":{\"_createdAt\":\"2026-01-15T17:50:27Z\",\"_id\":\"444b166c-563d-4a12-8328-fb09dc8b6bb3\",\"_type\":\"blogArticle\",\"_updatedAt\":\"2026-07-04T03:30:40Z\",\"author\":{\"avatar\":{\"_type\":\"image\",\"asset\":{\"_ref\":\"image-2f4085c390d6c65a71d1a551b22c62aceadcb513-384x384-png\",\"_type\":\"reference\"}},\"name\":\"Parallel\"},\"coAuthors\":null,\"coverImage\":{\"_type\":\"image\",\"alt\":\"Product release: Research Models with Basis for the Parallel Chat API\",\"asset\":{\"_ref\":\"image-53a15276df722f97fac56143f044ff5c86546c01-3597x2160-jpg\",\"_type\":\"reference\"}},\"hideAuthorImage\":true,\"intro\":null,\"publishedAt\":null,\"slug\":\"research-models-chat\",\"tags\":[{\"_key\":\"product\",\"_type\":\"tag\",\"label\":\"Product\",\"value\":\"product\"}],\"title\":\"Introducing research models with Basis for the Parallel Chat API\"}}]}]\n9b:[\"$\",\"$L24\",\"cerebr"])</script><script>self.__next_f.push([1,"as-fact-checker\",{\"cols\":3,\"className\":\"lg:col-start-auto lg:-ml-[1px]\",\"children\":[\"$\",\"$L68\",\"cerebras-fact-checker\",{\"post\":{\"_createdAt\":\"2026-01-08T18:40:01Z\",\"_id\":\"9f7f2073-6228-4fc0-a783-b18fe952661a\",\"_type\":\"blogArticle\",\"_updatedAt\":\"2026-08-03T19:23:00Z\",\"author\":{\"avatar\":{\"_type\":\"image\",\"asset\":{\"_ref\":\"image-2f4085c390d6c65a71d1a551b22c62aceadcb513-384x384-png\",\"_type\":\"reference\"}},\"name\":\"Parallel\"},\"coAuthors\":null,\"coverImage\":{\"_type\":\"image\",\"alt\":\"Parallel + Cerebras\",\"asset\":{\"_ref\":\"image-bb2635ba9a15cba21fe6e79d7c55cce9624fde35-3597x2160-jpg\",\"_type\":\"reference\"}},\"hideAuthorImage\":true,\"intro\":\"This guide demonstrates how to build a complete fact-checking application that extracts verifiable claims from any text or URL and validates them against live web sources. By the end, you'll have a streaming fact checker with a polished UI that highlights claims directly in the content as they're verified in real-time. \",\"publishedAt\":null,\"slug\":\"cerebras-fact-checker\",\"tags\":[{\"_key\":\"developers\",\"_type\":\"tag\",\"label\":\"Developers\",\"value\":\"developers\"}],\"title\":\"Build a real-time fact checker with Parallel and Cerebras\"}}]}]\n9c:[\"$\",\"$L24\",\"deepsearch-qa\",{\"cols\":3,\"className\":\"lg:col-start-auto lg:-ml-[1px]\",\"children\":[\"$\",\"$L68\",\"deepsearch-qa\",{\"post\":{\"_createdAt\":\"2025-12-17T19:11:15Z\",\"_id\":\"afcac918-d311-46e0-be0c-b3272b09c793\",\"_type\":\"blogArticle\",\"_updatedAt\":\"2026-08-11T17:36:29Z\",\"author\":{\"avatar\":{\"_type\":\"image\",\"asset\":{\"_ref\":\"image-2f4085c390d6c65a71d1a551b22c62aceadcb513-384x384-png\",\"_type\":\"reference\"}},\"name\":\"Parallel\"},\"coAuthors\":null,\"coverImage\":{\"_type\":\"image\",\"alt\":\"DeepSearch QA: Task API\",\"asset\":{\"_ref\":\"image-486b4d559f79eae0da197b9fbdd9c1770f6740ce-1799x1080-jpg\",\"_type\":\"reference\"}},\"hideAuthorImage\":true,\"intro\":\"The Parallel Task API achieves industry-leading accuracy of 72.6% on the new DeepSearchQA benchmark from Google, surpassing their own Gemini Deep Research and OpenAI o1 Pro at up to 6x lower cost.\",\"publishedAt\":null,\"slug\":\"deepsearch-qa\",\"tags\":[{\"_key\":\"benchmarks\",\"_type\":\"tag\",\"label\":\"Benchmarks\",\"value\":\"benchmarks\"}],\"title\":\"Parallel Task API achieves state-of-the-art accuracy on DeepSearchQA\"}}]}]\n9d:[\"$\",\"$L24\",\"granular-basis-task-api\",{\"cols\":3,\"className\":\"lg:col-start-auto\",\"children\":[\"$\",\"$L68\",\"granular-basis-task-api\",{\"post\":{\"_createdAt\":\"2025-12-16T17:49:36Z\",\"_id\":\"805014b6-c9bd-4f04-a71d-71d8b73a2be2\",\"_type\":\"blogArticle\",\"_updatedAt\":\"2026-08-11T17:36:51Z\",\"author\":{\"avatar\":{\"_type\":\"image\",\"asset\":{\"_ref\":\"image-2f4085c390d6c65a71d1a551b22c62aceadcb513-384x384-png\",\"_type\":\"reference\"}},\"name\":\"Parallel\"},\"coAuthors\":null,\"coverImage\":{\"_type\":\"image\",\"alt\":\"Product release: Granular Basis\",\"asset\":{\"_ref\":\"image-1e060165e85cdfb026d2af714a9960a721b2616f-3597x2160-jpg\",\"_type\":\"reference\"}},\"hideAuthorImage\":true,\"intro\":\"Granular Basis offers greater depth for the Basis framework in situations where outputs contain multiple entities. \",\"publishedAt\":null,\"slug\":\"granular-basis-task-api\",\"tags\":[{\"_key\":\"product\",\"_type\":\"tag\",\"label\":\"Product\",\"value\":\"product\"}],\"title\":\"Introducing Granular Basis for the Task API\"}}]}]\n9e:[\"$\",\"$L24\",\"case-study-amp\",{\"cols\":3,\"className\":\"lg:col-start-auto lg:-ml-[1px]\",\"children\":[\"$\",\"$L68\",\"case-study-amp\",{\"post\":{\"_createdAt\":\"2025-12-11T21:39:57Z\",\"_id\":\"bfdd8561-51e7-4cbe-be60-162f7fd660d1\",\"_type\":\"blogArticle\",\"_updatedAt\":\"2026-08-11T17:36:29Z\",\"author\":{\"avatar\":{\"_type\":\"image\",\"asset\":{\"_ref\":\"image-2f4085c390d6c65a71d1a551b22c62aceadcb513-384x384-png\",\"_type\":\"reference\"}},\"name\":\"Parallel\"},\"coAuthors\":null,\"coverImage\":{\"_type\":\"image\",\"asset\":{\"_ref\":\"image-ab5ad3b1fef31090b2f059b06ad9874363f8c1dc-1200x675-png\",\"_type\":\"reference\"}},\"hideAuthorImage\":true,\"intro\":\"Amp is a frontier coding agent designed for the future of software development.\",\"publishedAt\":null,\"slug\":\"case-study-amp\",\"tags\":[{\"_key\":\"customers\",\"_type\":\"tag\",\"label\":\"Customers\",\"value\":\"customers\"}],\"title\":\"How Amp’s coding agents build better software with Parallel Search\"}}]}]\n9f:[\"$\",\"$L24\",\"task-api"])</script><script>self.__next_f.push([1,"-latency\",{\"cols\":3,\"className\":\"lg:col-start-auto lg:-ml-[1px]\",\"children\":[\"$\",\"$L68\",\"task-api-latency\",{\"post\":{\"_createdAt\":\"2025-12-10T16:30:47Z\",\"_id\":\"7ee3d5db-d706-47ea-b9f5-5e6840158a41\",\"_type\":\"blogArticle\",\"_updatedAt\":\"2026-10-05T05:08:49Z\",\"author\":{\"avatar\":{\"_type\":\"image\",\"asset\":{\"_ref\":\"image-2f4085c390d6c65a71d1a551b22c62aceadcb513-384x384-png\",\"_type\":\"reference\"}},\"name\":\"Parallel\"},\"coAuthors\":null,\"coverImage\":{\"_type\":\"image\",\"asset\":{\"_ref\":\"image-f42277a241ef67150f48c5e585210eafd49adbbd-3597x2160-jpg\",\"_type\":\"reference\"}},\"hideAuthorImage\":true,\"intro\":null,\"publishedAt\":null,\"slug\":\"task-api-latency\",\"tags\":[{\"_key\":\"product\",\"_type\":\"tag\",\"label\":\"Product\",\"value\":\"product\"}],\"title\":\"Latency improvements on the Parallel Task API \"}}]}]\na0:[\"$\",\"$L24\",\"introducing-parallel-extract\",{\"cols\":3,\"className\":\"lg:col-start-auto lg:-ml-[1px]\",\"children\":[\"$\",\"$L68\",\"introducing-parallel-extract\",{\"post\":{\"_createdAt\":\"2025-11-20T15:38:28Z\",\"_id\":\"f236faee-b34d-4c31-a74b-b5429fe6ff43\",\"_type\":\"blogArticle\",\"_updatedAt\":\"2026-08-11T17:36:51Z\",\"author\":{\"avatar\":{\"_type\":\"image\",\"asset\":{\"_ref\":\"image-2f4085c390d6c65a71d1a551b22c62aceadcb513-384x384-png\",\"_type\":\"reference\"}},\"name\":\"Parallel\"},\"coAuthors\":null,\"coverImage\":{\"_type\":\"image\",\"alt\":\"Product release: Extract \",\"asset\":{\"_ref\":\"image-c9316fa288789c992e59eb406569520998fdb079-3597x2160-jpg\",\"_type\":\"reference\"}},\"hideAuthorImage\":true,\"intro\":null,\"publishedAt\":null,\"slug\":\"introducing-parallel-extract\",\"tags\":[{\"_key\":\"product\",\"_type\":\"tag\",\"label\":\"Product\",\"value\":\"product\"}],\"title\":\"Introducing Parallel Extract\"}}]}]\na1:[\"$\",\"$L24\",\"introducing-findall-api\",{\"cols\":3,\"className\":\"lg:col-start-auto\",\"children\":[\"$\",\"$L68\",\"introducing-findall-api\",{\"post\":{\"_createdAt\":\"2025-11-18T16:34:12Z\",\"_id\":\"78bfe996-4f33-433a-b7ab-77acb21f4572\",\"_type\":\"blogArticle\",\"_updatedAt\":\"2026-08-11T17:36:51Z\",\"author\":{\"avatar\":{\"_type\":\"image\",\"asset\":{\"_ref\":\"image-2f4085c390d6c65a71d1a551b22c62aceadcb513-384x384-png\",\"_type\":\"reference\"}},\"name\":\"Parallel\"},\"coAuthors\":null,\"coverImage\":{\"_type\":\"image\",\"alt\":\"FindAll API - Product Release\",\"asset\":{\"_ref\":\"image-1cc2b7bce6eaaa70a05ee25e23588f0c5b2a7d82-3597x2160-jpg\",\"_type\":\"reference\"}},\"hideAuthorImage\":true,\"intro\":\"Parallel's new FindAll API turns natural language queries into custom datasets from the web. It finds entities like companies, people, or locations based on your criteria, then enriches them with structured data—all with citations. FindAll Pro achieves 61% recall, 3x better than competitors.\",\"publishedAt\":null,\"slug\":\"introducing-findall-api\",\"tags\":[{\"_key\":\"product\",\"_type\":\"tag\",\"label\":\"Product\",\"value\":\"product\"},{\"_key\":\"benchmarks\",\"_type\":\"tag\",\"label\":\"Benchmarks\",\"value\":\"benchmarks\"}],\"title\":\"Introducing Parallel FindAll\"}}]}]\na2:[\"$\",\"$L24\",\"monitor-api-beta\",{\"cols\":3,\"className\":\"lg:col-start-auto lg:-ml-[1px]\",\"children\":[\"$\",\"$L68\",\"monitor-api-beta\",{\"post\":{\"_createdAt\":\"2025-11-13T16:42:17Z\",\"_id\":\"757d5cf2-4164-4d06-9881-d5e4a070b37b\",\"_type\":\"blogArticle\",\"_updatedAt\":\"2026-09-11T15:49:39Z\",\"author\":{\"avatar\":{\"_type\":\"image\",\"asset\":{\"_ref\":\"image-2f4085c390d6c65a71d1a551b22c62aceadcb513-384x384-png\",\"_type\":\"reference\"}},\"name\":\"Parallel\"},\"coAuthors\":null,\"coverImage\":{\"_type\":\"image\",\"alt\":\"Product release: Monitor API\",\"asset\":{\"_ref\":\"image-c75d20968ae273a031449d2d0214d30f55b30934-3597x2160-jpg\",\"_type\":\"reference\"}},\"hideAuthorImage\":true,\"intro\":null,\"publishedAt\":null,\"slug\":\"monitor-api-beta\",\"tags\":[{\"_key\":\"product\",\"_type\":\"tag\",\"label\":\"Product\",\"value\":\"product\"}],\"title\":\"Introducing Parallel Monitor\"}}]}]\na3:[\"$\",\"$L24\",\"series-a\",{\"cols\":3,\"className\":\"lg:col-start-auto lg:-ml-[1px]\",\"children\":[\"$\",\"$L68\",\"series-a\",{\"post\":{\"_createdAt\":\"2025-11-12T15:49:03Z\",\"_id\":\"432168b0-d668-478b-b15e-33d39b548f34\",\"_type\":\"blogArticle\",\"_updatedAt\":\"2026-09-11T15:49:39Z\",\"author\":{\"avatar\":{\"_type\":\"image\",\"asset\":{\"_ref\":\"image-2f4085c390d6c65a71d1a551b22c62aceadcb513-384x384-png\",\"_type\":\"reference\"}},\"name\":\"Parallel\"},\"coAuthors\":null,\"coverIma"])</script><script>self.__next_f.push([1,"ge\":{\"_type\":\"image\",\"asset\":{\"_ref\":\"image-a1c1693832181430c09e27d357f17aa54c914c58-6021x3375-jpg\",\"_type\":\"reference\"}},\"hideAuthorImage\":true,\"intro\":null,\"publishedAt\":null,\"slug\":\"series-a\",\"tags\":[{\"_key\":\"company\",\"_type\":\"tag\",\"label\":\"Company\",\"value\":\"company\"}],\"title\":\"Parallel raises $100M Series A to build web infrastructure for agents\"}}]}]\na4:[\"$\",\"$L24\",\"case-study-macroscope\",{\"cols\":3,\"className\":\"lg:col-start-auto lg:-ml-[1px]\",\"children\":[\"$\",\"$L68\",\"case-study-macroscope\",{\"post\":{\"_createdAt\":\"2025-11-11T16:10:24Z\",\"_id\":\"85f350ed-a90d-4022-9b2d-b33e37bebb68\",\"_type\":\"blogArticle\",\"_updatedAt\":\"2026-08-11T17:36:29Z\",\"author\":{\"avatar\":{\"_type\":\"image\",\"asset\":{\"_ref\":\"image-2f4085c390d6c65a71d1a551b22c62aceadcb513-384x384-png\",\"_type\":\"reference\"}},\"name\":\"Parallel\"},\"coAuthors\":null,\"coverImage\":{\"_type\":\"image\",\"asset\":{\"_ref\":\"image-2aafcf7a774023a3d7ffbeedf84d0461fe854427-1200x675-png\",\"_type\":\"reference\"}},\"hideAuthorImage\":true,\"intro\":\"Macroscope, an AI-powered code review platform, faced a critical problem: LLMs reviewing code against third-party libraries were working from outdated knowledge, causing false positives and missed issues. By integrating Parallel's Search and Task APIs directly into their review pipeline, Macroscope can now query current documentation in real-time during reviews. The result: a 55% reduction in review comments related to third-party libraries.\",\"publishedAt\":null,\"slug\":\"case-study-macroscope\",\"tags\":[{\"_key\":\"customers\",\"_type\":\"tag\",\"label\":\"Customers\",\"value\":\"customers\"}],\"title\":\"How Macroscope reduced code review false positives with Parallel\"}}]}]\na5:[\"$\",\"$L24\",\"parallel-search-api-beta\",{\"cols\":3,\"className\":\"lg:col-start-auto\",\"children\":[\"$\",\"$L68\",\"parallel-search-api-beta\",{\"post\":{\"_createdAt\":\"2025-11-06T08:29:04Z\",\"_id\":\"4db12ead-600f-45f7-ac17-4797739cdfeb\",\"_type\":\"blogArticle\",\"_updatedAt\":\"2026-09-18T21:12:15Z\",\"author\":{\"avatar\":{\"_type\":\"image\",\"asset\":{\"_ref\":\"image-2f4085c390d6c65a71d1a551b22c62aceadcb513-384x384-png\",\"_type\":\"reference\"}},\"name\":\"Parallel\"},\"coAuthors\":null,\"coverImage\":{\"_type\":\"image\",\"alt\":\"Product release - Parallel Search API\",\"asset\":{\"_ref\":\"image-655fc918b19a2a2816c2f463c7e673360fadaf17-5396x3240-jpg\",\"_type\":\"reference\"}},\"hideAuthorImage\":true,\"intro\":\"The highest accuracy web search API engineered for AI.\",\"publishedAt\":null,\"slug\":\"parallel-search-api-beta\",\"tags\":[{\"_key\":\"4424fde9654c\",\"_type\":\"tag\",\"label\":\"Benchmarks\",\"value\":\"benchmarks\"}],\"title\":\"Introducing Parallel Search\"}}]}]\na6:[\"$\",\"$L24\",\"benchmarks-task-api-sealqa\",{\"cols\":3,\"className\":\"lg:col-start-auto lg:-ml-[1px]\",\"children\":[\"$\",\"$L68\",\"benchmarks-task-api-sealqa\",{\"post\":{\"_createdAt\":\"2025-11-03T21:40:30Z\",\"_id\":\"12ed2f4e-ac96-4d1b-85ee-55a75d52c960\",\"_type\":\"blogArticle\",\"_updatedAt\":\"2026-08-11T17:36:29Z\",\"author\":{\"avatar\":{\"_type\":\"image\",\"asset\":{\"_ref\":\"image-2f4085c390d6c65a71d1a551b22c62aceadcb513-384x384-png\",\"_type\":\"reference\"}},\"name\":\"Parallel\"},\"coAuthors\":null,\"coverImage\":{\"_type\":\"image\",\"alt\":\"Benchmarks: SealQA: Task API\",\"asset\":{\"_ref\":\"image-18d60f9402d18d1b27fb91fbb44dd9905bfa596c-1799x1080-jpg\",\"_type\":\"reference\"}},\"hideAuthorImage\":true,\"intro\":\"Parallel scores state-of-the-art on SEAL-0 and SEAL-HARD benchmarks, designed to challenge search-augmented LLMs on real-world research queries.\",\"publishedAt\":null,\"slug\":\"benchmarks-task-api-sealqa\",\"tags\":[{\"_key\":\"benchmarks\",\"_type\":\"tag\",\"label\":\"Benchmarks\",\"value\":\"benchmarks\"}],\"title\":\"Parallel processors set new price-performance standard on SealQA benchmark\"}}]}]\na7:[\"$\",\"$L24\",\"LLMTEXT-for-llmstxt\",{\"cols\":3,\"className\":\"lg:col-start-auto lg:-ml-[1px]\",\"children\":[\"$\",\"$L68\",\"LLMTEXT-for-llmstxt\",{\"post\":{\"_createdAt\":\"2025-10-30T15:48:18Z\",\"_id\":\"8c3c197e-11b8-40c2-89a9-cd0d4a53c74c\",\"_type\":\"blogArticle\",\"_updatedAt\":\"2026-10-18T19:16:20Z\",\"author\":{\"avatar\":{\"_type\":\"image\",\"asset\":{\"_ref\":\"image-2f4085c390d6c65a71d1a551b22c62aceadcb513-384x384-png\",\"_type\":\"reference\"}},\"name\":\"Parallel\"},\"coAuthors\":null,\"coverImage\":{\"_type\":\"image\",\"asset\":{\"_ref\":\"i"])</script><script>self.__next_f.push([1,"mage-d2d98ed5cc2efe757968b65f982681e0e0f19e7a-2142x1260-jpg\",\"_type\":\"reference\"}},\"hideAuthorImage\":true,\"intro\":\"TL;DR: We're launching LLMTEXT, an open source toolkit that helps developers create, validate, and use llms.txt files—making any website instantly accessible to AI agents through standardized markdown documentation and MCP servers.\",\"publishedAt\":null,\"slug\":\"LLMTEXT-for-llmstxt\",\"tags\":[{\"_key\":\"product\",\"_type\":\"tag\",\"label\":\"Product\",\"value\":\"product\"}],\"title\":\"Introducing LLMTEXT, an open source toolkit for the llms.txt standard\"}}]}]\na8:[\"$\",\"$L24\",\"case-study-starbridge\",{\"cols\":3,\"className\":\"lg:col-start-auto lg:-ml-[1px]\",\"children\":[\"$\",\"$L68\",\"case-study-starbridge\",{\"post\":{\"_createdAt\":\"2025-10-23T15:42:29Z\",\"_id\":\"682e9eaf-35db-4620-b4ef-90f9291d22d2\",\"_type\":\"blogArticle\",\"_updatedAt\":\"2026-07-13T14:58:13Z\",\"author\":{\"avatar\":{\"_type\":\"image\",\"asset\":{\"_ref\":\"image-2f4085c390d6c65a71d1a551b22c62aceadcb513-384x384-png\",\"_type\":\"reference\"}},\"name\":\"Parallel\"},\"coAuthors\":null,\"coverImage\":{\"_type\":\"image\",\"alt\":\"Starbridge + Parallel\",\"asset\":{\"_ref\":\"image-ab0e4460ae9420af31c5425a4a33091973aa5c1e-2400x1350-png\",\"_type\":\"reference\"}},\"hideAuthorImage\":true,\"intro\":\"By using the Parallel Task API, Starbridge helps companies scale public sector sales with efficiency and accuracy.\",\"publishedAt\":null,\"slug\":\"case-study-starbridge\",\"tags\":[{\"_key\":\"customers\",\"_type\":\"tag\",\"label\":\"Customers\",\"value\":\"customers\"}],\"title\":\"How Starbridge powers public sector GTM with state-of-the-art web research\"}}]}]\na9:[\"$\",\"$L24\",\"cookbook-market-research-platform-with-parallel\",{\"cols\":3,\"className\":\"lg:col-start-auto\",\"children\":[\"$\",\"$L68\",\"cookbook-market-research-platform-with-parallel\",{\"post\":{\"_createdAt\":\"2025-10-22T16:58:17Z\",\"_id\":\"210640bd-6e35-4365-9e32-01905b671d1f\",\"_type\":\"blogArticle\",\"_updatedAt\":\"2026-08-03T19:53:30Z\",\"author\":{\"avatar\":{\"_type\":\"image\",\"asset\":{\"_ref\":\"image-2f4085c390d6c65a71d1a551b22c62aceadcb513-384x384-png\",\"_type\":\"reference\"}},\"name\":\"Parallel\"},\"coAuthors\":null,\"coverImage\":{\"_type\":\"image\",\"asset\":{\"_ref\":\"image-7bb9b4a6de8eefb829ecb4a31975b62bd423b217-1409x908-jpg\",\"_type\":\"reference\"}},\"hideAuthorImage\":true,\"intro\":\"This guide walks through building a comprehensive market research platform that generates detailed industry reports using Parallel's Deep Research product. The application demonstrates how to create a production-ready system that handles real-time streaming, intelligent input validation, email notifications, and robust error handling for AI-powered research tasks.\",\"publishedAt\":null,\"slug\":\"cookbook-market-research-platform-with-parallel\",\"tags\":[{\"_key\":\"developers\",\"_type\":\"tag\",\"label\":\"Developers\",\"value\":\"developers\"}],\"title\":\"Building a market research platform with Parallel Deep Research\"}}]}]\naa:[\"$\",\"$L24\",\"case-study-lindy\",{\"cols\":3,\"className\":\"lg:col-start-auto lg:-ml-[1px]\",\"children\":[\"$\",\"$L68\",\"case-study-lindy\",{\"post\":{\"_createdAt\":\"2025-10-17T17:09:03Z\",\"_id\":\"c272edce-31c0-42bb-a2c4-b0eb3b6885af\",\"_type\":\"blogArticle\",\"_updatedAt\":\"2026-08-11T17:36:29Z\",\"author\":{\"avatar\":{\"_type\":\"image\",\"asset\":{\"_ref\":\"image-2f4085c390d6c65a71d1a551b22c62aceadcb513-384x384-png\",\"_type\":\"reference\"}},\"name\":\"Parallel\"},\"coAuthors\":null,\"coverImage\":{\"_type\":\"image\",\"asset\":{\"_ref\":\"image-8862203d013fa5e48e4e53154f4d4f1a26df8c77-1200x675-png\",\"_type\":\"reference\"}},\"hideAuthorImage\":true,\"intro\":\"Lindy is a no-code AI automation platform that transforms how teams build intelligent workflows. By integrating Parallel's Task API, Lindy enables users to build automations that pull live data from the web, reason across multiple sources, and deliver structured intelligence—all without writing code.\",\"publishedAt\":null,\"slug\":\"case-study-lindy\",\"tags\":[{\"_key\":\"customers\",\"_type\":\"tag\",\"label\":\"Customers\",\"value\":\"customers\"}],\"title\":\"How Lindy brings state-of-the-art web research to automation flows\"}}]}]\nab:[\"$\",\"$L24\",\"parallel-task-mcp-server\",{\"cols\":3,\"className\":\"lg:col-start-auto lg:-ml-[1px]\",\"children\":[\"$\",\"$L68\",\"parallel-task-mcp-serv"])</script><script>self.__next_f.push([1,"er\",{\"post\":{\"_createdAt\":\"2025-10-16T14:12:33Z\",\"_id\":\"a959dcea-e555-4e58-94b0-4dee7d5dd01b\",\"_type\":\"blogArticle\",\"_updatedAt\":\"2026-07-04T03:30:40Z\",\"author\":{\"avatar\":{\"_type\":\"image\",\"asset\":{\"_ref\":\"image-2f4085c390d6c65a71d1a551b22c62aceadcb513-384x384-png\",\"_type\":\"reference\"}},\"name\":\"Parallel\"},\"coAuthors\":null,\"coverImage\":{\"_type\":\"image\",\"asset\":{\"_ref\":\"image-fea8be5b5586b18fa7cbab2d3129f66dd3d41ba2-1200x675-jpg\",\"_type\":\"reference\"}},\"hideAuthorImage\":true,\"intro\":\"The Parallel Task MCP Server is a first-of-its-kind tool for AIs to perform complex knowledge tasks over data from the open web. It introduces a new concept to the MCP standard: asynchronous tasks, which enables users to continue working in their MCP client while Parallel’s web search tasks run in the background.\",\"publishedAt\":null,\"slug\":\"parallel-task-mcp-server\",\"tags\":[{\"_key\":\"product\",\"_type\":\"tag\",\"label\":\"Product\",\"value\":\"product\"}],\"title\":\"Introducing the Parallel Task MCP Server\"}}]}]\nac:[\"$\",\"$L24\",\"core2x-processor\",{\"cols\":3,\"className\":\"lg:col-start-auto lg:-ml-[1px]\",\"children\":[\"$\",\"$L68\",\"core2x-processor\",{\"post\":{\"_createdAt\":\"2025-10-09T15:46:56Z\",\"_id\":\"999c1b5e-d5bd-4a42-a882-891c36e955cc\",\"_type\":\"blogArticle\",\"_updatedAt\":\"2026-09-18T23:20:16Z\",\"author\":{\"avatar\":{\"_type\":\"image\",\"asset\":{\"_ref\":\"image-2f4085c390d6c65a71d1a551b22c62aceadcb513-384x384-png\",\"_type\":\"reference\"}},\"name\":\"Parallel\"},\"coAuthors\":null,\"coverImage\":{\"_type\":\"image\",\"asset\":{\"_ref\":\"image-bf1a848f15ec882fd849b26529605170de7c631f-1130x675-png\",\"_type\":\"reference\"}},\"hideAuthorImage\":true,\"intro\":\"Starting today, a new Processor, Core2x, is available in the Parallel Task API to offer developers finer control over the compute budget they wish to allocate for a given web research task. \",\"publishedAt\":null,\"slug\":\"core2x-processor\",\"tags\":[{\"_key\":\"product\",\"_type\":\"tag\",\"label\":\"Product\",\"value\":\"product\"}],\"title\":\"Introducing the Core2x Processor for improved compute control on the Task API\"}}]}]\nad:[\"$\",\"$L24\",\"case-study-day-ai\",{\"cols\":3,\"className\":\"lg:col-start-auto\",\"children\":[\"$\",\"$L68\",\"case-study-day-ai\",{\"post\":{\"_createdAt\":\"2025-10-08T18:41:57Z\",\"_id\":\"c7e42870-265f-4d6e-befd-1f0d82a9c362\",\"_type\":\"blogArticle\",\"_updatedAt\":\"2026-07-04T03:30:40Z\",\"author\":{\"avatar\":{\"_type\":\"image\",\"asset\":{\"_ref\":\"image-2f4085c390d6c65a71d1a551b22c62aceadcb513-384x384-png\",\"_type\":\"reference\"}},\"name\":\"Parallel\"},\"coAuthors\":null,\"coverImage\":{\"_type\":\"image\",\"asset\":{\"_ref\":\"image-5b93638fe38fdec380eee982f3c8e621e3df7f40-1200x675-png\",\"_type\":\"reference\"}},\"hideAuthorImage\":true,\"intro\":\"Day AI is an AI-native CRM that you can talk to. Their platform combines data from leading SaaS tools like Slack and email, with public data gathered and structured via Parallel’s Task API to help their customers sell better. With Parallel’s web search technology backing it, Day can provide superior visibility of insights across private and public data for a more holistic view of sales opportunities.\",\"publishedAt\":null,\"slug\":\"case-study-day-ai\",\"tags\":[{\"_key\":\"customers\",\"_type\":\"tag\",\"label\":\"Customers\",\"value\":\"customers\"}],\"title\":\"How Day AI merges private and public data for business intelligence\"}}]}]\nae:[\"$\",\"$L24\",\"full-basis-framework-for-task-api\",{\"cols\":3,\"className\":\"lg:col-start-auto lg:-ml-[1px]\",\"children\":[\"$\",\"$L68\",\"full-basis-framework-for-task-api\",{\"post\":{\"_createdAt\":\"2025-10-07T18:06:41Z\",\"_id\":\"74b1321f-1b4c-4cd5-a3d2-20e62e6d639c\",\"_type\":\"blogArticle\",\"_updatedAt\":\"2026-07-04T03:30:40Z\",\"author\":{\"avatar\":{\"_type\":\"image\",\"asset\":{\"_ref\":\"image-2f4085c390d6c65a71d1a551b22c62aceadcb513-384x384-png\",\"_type\":\"reference\"}},\"name\":\"Parallel\"},\"coAuthors\":null,\"coverImage\":{\"_type\":\"image\",\"asset\":{\"_ref\":\"image-6052afb7860f8109024c16cc7804023d3cda853b-1273x853-png\",\"_type\":\"reference\"}},\"hideAuthorImage\":true,\"intro\":\"Starting today, Lite and Base Task API processors include the complete Basis framework—citations, reasoning, excerpts, and calibrated confidence scores.\",\"publishedAt\":null,\"slug\":\"full-basis-framework-for-task-api\""])</script><script>self.__next_f.push([1,",\"tags\":[{\"_key\":\"product\",\"_type\":\"tag\",\"label\":\"Product\",\"value\":\"product\"}],\"title\":\"Full Basis framework for all Task API Processors\"}}]}]\naf:[\"$\",\"$L24\",\"cookbook-sse-task-manager-with-parallel\",{\"cols\":3,\"className\":\"lg:col-start-auto lg:-ml-[1px]\",\"children\":[\"$\",\"$L68\",\"cookbook-sse-task-manager-with-parallel\",{\"post\":{\"_createdAt\":\"2025-10-06T18:25:04Z\",\"_id\":\"d74539b9-4ab5-4e05-9e3c-6f31df130bde\",\"_type\":\"blogArticle\",\"_updatedAt\":\"2026-08-12T20:02:33Z\",\"author\":{\"avatar\":{\"_type\":\"image\",\"asset\":{\"_ref\":\"image-2f4085c390d6c65a71d1a551b22c62aceadcb513-384x384-png\",\"_type\":\"reference\"}},\"name\":\"Parallel\"},\"coAuthors\":null,\"coverImage\":{\"_type\":\"image\",\"asset\":{\"_ref\":\"image-f1ddb30b2f45506fc931810ff8a6e3b1b7616577-1440x920-jpg\",\"_type\":\"reference\"}},\"hideAuthorImage\":true,\"intro\":\"Build a task streaming playground that showcases Parallel's Task API with real-time Server-Sent Events (SSE).\",\"publishedAt\":null,\"slug\":\"cookbook-sse-task-manager-with-parallel\",\"tags\":[{\"_key\":\"developers\",\"_type\":\"tag\",\"label\":\"Developers\",\"value\":\"developers\"}],\"title\":\"Building a real-time streaming task manager with Parallel\"}}]}]\nb0:[\"$\",\"$L24\",\"case-study-gumloop\",{\"cols\":3,\"className\":\"lg:col-start-auto lg:-ml-[1px]\",\"children\":[\"$\",\"$L68\",\"case-study-gumloop\",{\"post\":{\"_createdAt\":\"2025-09-30T18:59:26Z\",\"_id\":\"ec6b848d-fb94-4c47-9cda-c8866d7c4d9c\",\"_type\":\"blogArticle\",\"_updatedAt\":\"2026-07-04T03:30:40Z\",\"author\":{\"avatar\":{\"_type\":\"image\",\"asset\":{\"_ref\":\"image-2f4085c390d6c65a71d1a551b22c62aceadcb513-384x384-png\",\"_type\":\"reference\"}},\"name\":\"Parallel\"},\"coAuthors\":null,\"coverImage\":{\"_type\":\"image\",\"asset\":{\"_ref\":\"image-ee4b4a1ae1ee3abc405a5f3fce93436ce7c044d8-4800x2700-png\",\"_type\":\"reference\"}},\"hideAuthorImage\":true,\"intro\":\"By integrating Parallel's Task API as a core component, Gumloop enables businesses to build AI automation workflows that are grounded in real-time web data.\",\"publishedAt\":null,\"slug\":\"case-study-gumloop\",\"tags\":[{\"_key\":\"customers\",\"_type\":\"tag\",\"label\":\"Customers\",\"value\":\"customers\"}],\"title\":\"How Gumloop built a new AI automation framework with web intelligence as a core node\"}}]}]\nb1:[\"$\",\"$L24\",\"typescript-sdk\",{\"cols\":3,\"className\":\"lg:col-start-auto\",\"children\":[\"$\",\"$L68\",\"typescript-sdk\",{\"post\":{\"_createdAt\":\"2025-09-16T20:00:49Z\",\"_id\":\"641c5f5d-de95-41ec-a0ba-4371d04f46cb\",\"_type\":\"blogArticle\",\"_updatedAt\":\"2026-09-18T23:20:16Z\",\"author\":{\"avatar\":{\"_type\":\"image\",\"asset\":{\"_ref\":\"image-2f4085c390d6c65a71d1a551b22c62aceadcb513-384x384-png\",\"_type\":\"reference\"}},\"name\":\"Parallel\"},\"coAuthors\":null,\"coverImage\":{\"_type\":\"image\",\"asset\":{\"_ref\":\"image-8ab362aa9a611786155d6fb73ece060357268c04-1600x896-png\",\"_type\":\"reference\"}},\"hideAuthorImage\":true,\"intro\":\"The Parallel TypeScript SDK is generally available - bringing strongly typed interfaces to all Parallel APIs.\",\"publishedAt\":null,\"slug\":\"typescript-sdk\",\"tags\":[{\"_key\":\"product\",\"_type\":\"tag\",\"label\":\"Product\",\"value\":\"product\"}],\"title\":\"Introducing the TypeScript SDK\"}}]}]\nb2:[\"$\",\"$L24\",\"cookbook-competitor-research-with-reddit-mcp\",{\"cols\":3,\"className\":